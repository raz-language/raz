enum Result<T, E> {
    Ok(T),
    Error(E),
}

enum Option<T> {
    None,
    Some(T),
}

fn produce_result(bool fail) -> Result<i64, i64> {
    if (fail) {
        return Result<i64, i64>::Error(7);
    }
    return Result<i64, i64>::Ok(42);
}

fn widen_result(bool fail) -> Result<bool, i64> {
    i64 value = produce_result(fail)?;

    return Result<bool, i64>::Ok(value == 42);
}

fn produce_option(bool none) -> Option<i64> {
    if (none) {
        return Option<i64>::None;
    }
    return Option<i64>::Some(9);
}

fn widen_option(bool none) -> Option<bool> {
    i64 value = produce_option(none)?;

    return Option<bool>::Some(value == 9);
}

fn main() -> i64 {
    Result<bool, i64> result = widen_result(false);
    Option<bool> option = widen_option(false);

    result;
    option;
    return 0;
}
