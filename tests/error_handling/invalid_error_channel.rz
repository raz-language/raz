enum Result<T, E> {
    Ok(T),
    Error(E),
}

fn source() -> Result<i64, i64> {
    return Result<i64, i64>::Error(7);
}

fn invalid() -> Result<bool, bool> {
    i64 value = source()?;

    return Result<bool, bool>::Ok(value != 0);
}

fn main() -> i64 {
    return 0;
}
