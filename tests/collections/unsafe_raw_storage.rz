fn raw_value(usize address) -> i64& {
    unsafe {
        return & *(address as i64*const);
    }
}

fn raw_store(usize address, i64 value) {
    unsafe {
        *(address as i64*mut) = value;
    }
}

fn main() -> i64 {
    return 42;
}
