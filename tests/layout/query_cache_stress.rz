struct Leaf {
    i64 a;
    i32 b;
    i16 c;
}

struct Pair {
    Leaf left;
    Leaf right;
    i64 tail;
}

@align(32)struct Wide {
    Pair pair;
    i64 values[4];
}

fn main() -> i64 {
    i64 total = 0;

    total += size_of<Wide>()as i64;
    total += size_of<Wide>()as i64;
    total += size_of<Pair>()as i64;
    total += size_of<Pair>()as i64;
    total += align_of<Wide>()as i64;
    total += align_of<Wide>()as i64;
    total += field_offset<Pair>("tail")as i64;
    total += field_offset<Pair>("tail")as i64;
    if (total != 400) {
        return 1;
    }
    return 0;
}
