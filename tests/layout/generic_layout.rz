struct Wide {
    i64 a;
    i64 b;
    i64 c;
}

@align(32)struct AlignedWide {
    i64 a;
    i64 b;
    i64 c;
}

fn generic_size<T>() -> usize {
    return size_of<T>();
}

fn generic_align<T>() -> usize {
    return align_of<T>();
}

fn main() -> i64 {
    if (generic_size<Wide>() != 24) {
        return 1;
    }
    if (generic_align<Wide>() != 8) {
        return 2;
    }
    if (generic_size<AlignedWide>() != 32) {
        return 3;
    }
    if (generic_align<AlignedWide>() != 32) {
        return 4;
    }
    return 0;
}
