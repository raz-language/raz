fn complete_future(usize raw, i64 value) -> i64 {
    unsafe {
        if (std::thread::future::future_complete_i64(raw as i8*mut, value)) { return 1; }
    }
    return 0;
}

fn wait_future(usize raw) -> i64 {
    unsafe {
        return std::thread::future::future_wait_millis(raw as i8*mut, 5000);
    }
}

fn main() -> i64 {
    auto future = std::thread::future::future_create();
    usize raw = 0;
    unsafe { raw = future as usize; }
    if (raw == 0) { return 1; }

    JoinHandleI64 w0 = std::thread::spawn_callable(move fn() -> i64 { return wait_future(raw); });
    JoinHandleI64 w1 = std::thread::spawn_callable(move fn() -> i64 { return wait_future(raw); });
    JoinHandleI64 w2 = std::thread::spawn_callable(move fn() -> i64 { return wait_future(raw); });
    JoinHandleI64 w3 = std::thread::spawn_callable(move fn() -> i64 { return wait_future(raw); });

    JoinHandleI64 c0 = std::thread::spawn_callable(move fn() -> i64 { return complete_future(raw, 100); });
    JoinHandleI64 c1 = std::thread::spawn_callable(move fn() -> i64 { return complete_future(raw, 101); });
    JoinHandleI64 c2 = std::thread::spawn_callable(move fn() -> i64 { return complete_future(raw, 102); });
    JoinHandleI64 c3 = std::thread::spawn_callable(move fn() -> i64 { return complete_future(raw, 103); });

    i64 winners = std::thread::join(&mut c0) + std::thread::join(&mut c1) + std::thread::join(&mut c2) + std::thread::join(&mut c3);
    if (winners != 1) { return 2; }
    if (std::thread::join(&mut w0) != 1 || std::thread::join(&mut w1) != 1 ||
        std::thread::join(&mut w2) != 1 || std::thread::join(&mut w3) != 1) { return 3; }

    usize output = allocate_zeroed(8);
    if (output == 0) { return 4; }
    i64 status = 0;
    unsafe { status = std::thread::future::future_result_i64(future, output as i64*mut); }
    if (status != 1) { return 5; }
    i64 value = 0;
    unsafe { value = *(output as i64*const); }
    if (value < 100 || value > 103) { return 6; }
    deallocate(output);
    std::thread::future::future_destroy(future);
    return 0;
}
