fn main() -> i64 {
    if (alloc::box::allocate_zeroed(0) != 0 || alloc::box::allocate_zeroed(-1) != 0) { return 1; }
    if (allocate_array<i64>(0) != 0 || allocate_array<i64>(-1) != 0) { return 2; }
    if (allocate_array<i64>(9223372036854775807) != 0) { return 3; }
    if (allocate_zeroed_array<i64>(9223372036854775807) != 0) { return 4; }

    FixedPool overflow = alloc::pool::create_aligned(4096, 9223372036854775807, 4096);
    if (alloc::pool::valid(&overflow)) { return 5; }
    FixedPool invalid_alignment = alloc::pool::create_aligned(16, 8, 3);
    if (alloc::pool::valid(&invalid_alignment)) { return 6; }

    BumpArena invalid_arena = alloc::arena::create_aligned(128, 3);
    if (alloc::arena::valid(&invalid_arena)) { return 7; }
    BumpArena arena = alloc::arena::create_aligned(64, 64);
    if (!alloc::arena::valid(&arena)) { return 8; }
    if (alloc::arena::allocate(&mut arena, 65, 1) != 0 || alloc::arena::used(&arena) != 0) { return 9; }
    usize exact = alloc::arena::allocate(&mut arena, 64, 64);
    if (exact == 0 || alloc::arena::remaining(&arena) != 0) { return 10; }
    if (alloc::arena::allocate(&mut arena, 1, 1) != 0 || alloc::arena::used(&arena) != 64) { return 11; }
    alloc::arena::destroy(&mut arena);
    return 0;
}
