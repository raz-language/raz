fn main() -> i64 {
    FixedPool pool = alloc::pool::create_aligned(24, 4, 16);
    if (!alloc::pool::valid(&pool) || alloc::pool::capacity(&pool) != 4 || alloc::pool::available(&pool) != 4) { return 1; }
    usize a = alloc::pool::allocate(&mut pool);
    usize b = alloc::pool::allocate_zeroed(&mut pool);
    if (a == 0 || b == 0 || a == b || !alloc::pool::owns(&pool, a) || alloc::pool::available(&pool) != 2) { return 2; }
    unsafe {
        *(a as i64*mut) = 99;
        if (*(b as i64*const) != 0) { return 3; }
    }
    if (!alloc::pool::release(&mut pool, a) || alloc::pool::available(&pool) != 3) { return 4; }
    usize reused = alloc::pool::allocate(&mut pool);
    if (reused != a) { return 5; }
    alloc::pool::reset(&mut pool);
    if (alloc::pool::available(&pool) != 4 || alloc::pool::allocated(&pool) != 0) { return 6; }
    return 0;
}
