fn main() -> i64 {
    String message = alloc::string::with_capacity(8);

    if (!alloc::string::push_byte(&mut message, 82)) {
        return 1;
    }
    if (!alloc::string::push_byte(&mut message, 97)) {
        return 2;
    }
    if (!alloc::string::push_byte(&mut message, 122)) {
        return 3;
    }
    if (!println_string(&message)) {
        return 4;
    }
    if (!println_i64(-42) || !println_u64(42) || !println_bool(true)) {
        return 5;
    }
    return 0;
}
