extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);

fn main() -> i64 {
    usize left_data = raz_rt_alloc(4);
    usize right_data = raz_rt_alloc(8);
    usize joined_data = raz_rt_alloc(32);

    raz_rt_store_u8(left_data + 0, 102);
    raz_rt_store_u8(left_data + 1, 111);
    raz_rt_store_u8(left_data + 2, 111);
    raz_rt_store_u8(left_data + 3, 47);

    i64 tail[8] = [47, 98, 97, 114, 46, 116, 120, 116];
    i64 i = 0;

    while (i < 8) {
        raz_rt_store_u8(right_data + i, tail[i]);
        i += 1;
    }
    PathView left = PathView {
        data: left_data,
        length: 4
    };
    PathView right = PathView {
        data: right_data,
        length: 8
    };

    i64 count = join_into(left, right, joined_data, 32);

    PathView joined = PathView {
        data: joined_data,
        length: count
    };

    i64 result = 0;

    if (count != 11) {
        result = 1;
    }
    if (filename_start(joined) != 4 || filename_length(joined) != 7) {
        result = 2;
    }
    if (extension_start(joined) != 7 || extension_length(joined) != 3) {
        result = 3;
    }
    if (parent_length(joined) != 3) {
        result = 4;
    }
    if (raz_rt_load_u8(joined_data + 3) != 47 || raz_rt_load_u8(joined_data + 4) != 98) {
        result = 5;
    }
    raz_rt_dealloc(left_data);
    raz_rt_dealloc(right_data);
    raz_rt_dealloc(joined_data);
    return result;
}
