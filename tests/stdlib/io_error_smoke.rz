fn main() -> i64 {
    IoError missing = error_with_code(IoOperation::Open, 2);
    IoErrorKind category = kind(&missing);
    // POSIX ENOENT is used by this native smoke. Platform-specific codes remain
    // tested by runtime unit tests on their native CI hosts.
    match category {
        IoErrorKind::NotFound => { return 0; }
        _ => { return 1; }
    }
}
