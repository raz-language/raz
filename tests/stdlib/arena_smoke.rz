fn main() -> i64 {
    BumpArena arena = create(1024);
    if (!valid(&arena) || capacity(&arena) != 1024 || used(&arena) != 0) { return 1; }

    usize a = allocate(&mut arena, 3, 1);
    usize b = allocate(&mut arena, 16, 16);
    if (a == 0 || b == 0 || (b & 15) != 0 || !contains(&arena, b)) { return 2; }

    unsafe {
        *(b as i64*mut) = 123456;
        if (*(b as i64*const) != 123456) { return 3; }
    }

    i64 checkpoint = mark(&arena);
    usize zeroed = allocate_zeroed(&mut arena, 32, 8);
    if (zeroed == 0) { return 4; }
    unsafe {
        if (*(zeroed as i64*const) != 0 || *((zeroed + 24)as i64*const) != 0) { return 5; }
    }
    if (!rewind(&mut arena, checkpoint) || used(&arena) != checkpoint) { return 6; }
    usize reused = allocate(&mut arena, 32, 8);
    if (reused != zeroed) { return 7; }

    reset(&mut arena);
    if (used(&arena) != 0 || remaining(&arena) != 1024) { return 8; }
    destroy(&mut arena);
    return 0;
}
