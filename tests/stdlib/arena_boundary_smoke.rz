fn main() -> i64 {
    BumpArena invalid_align = create_aligned(128, 3);
    if (valid(&invalid_align)) { return 1; }
    BumpArena arena = create_aligned(256, 64);
    if (!valid(&arena)) { return 2; }
    if (allocate(&mut arena, -1, 8) != 0) { return 3; }
    if (allocate(&mut arena, 8, 3) != 0) { return 4; }
    if (allocate(&mut arena, 8, 128) != 0) { return 5; }
    usize first = allocate(&mut arena, 255, 1);
    if (first == 0 || remaining(&arena) != 1) { return 6; }
    if (allocate(&mut arena, 2, 1) != 0 || used(&arena) != 255) { return 7; }
    if (!rewind(&mut arena, 0) || used(&arena) != 0) { return 8; }
    usize aligned = allocate(&mut arena, 64, 64);
    if (aligned == 0 || (aligned & 63) != 0) { return 9; }
    if (rewind(&mut arena, 65)) { return 10; }
    destroy(&mut arena);
    return 0;
}
