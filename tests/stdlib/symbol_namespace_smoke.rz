global mut i64 errno = 1;
static i64 stdin = 2;

fn close(i64 value) -> i64 {
    return value + 1;
}

fn read(i64 value) -> i64 {
    return value + 1;
}

fn write(i64 value) -> i64 {
    return value + 1;
}

fn main() -> i64 {
    return close(read(write(36))) + errno + stdin - 42;
}
