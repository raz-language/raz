fn main() -> i64 {
    usize source = raz_rt_alloc(8);

    raz_rt_store_u8(source + 0, 100);
    raz_rt_store_u8(source + 1, 97);
    raz_rt_store_u8(source + 2, 115);
    raz_rt_store_u8(source + 3, 104);

    String value = from_bytes(source, 4);

    if (!push_byte(&mut value, 33)) {
        raz_rt_dealloc(source);
        return 1;
    }
    if (len(&value) != 5 || capacity(&value) < 5) {
        raz_rt_dealloc(source);
        return 2;
    }
    if (byte_at(&value, 4) != 33 || find_byte(&value, 115) != 2) {
        raz_rt_dealloc(source);
        return 3;
    }

    String copied = clone_string(&value);

    if (!equals_bytes(&copied, value.data, value.length)) {
        raz_rt_dealloc(source);
        return 4;
    }
    if (!truncate(&mut copied, 4) || byte_at(&copied, 3) != 104) {
        raz_rt_dealloc(source);
        return 5;
    }

    String prefix = from_bytes(source, 2);
    String suffix = from_bytes(source + 2, 2);

    if (!starts_with(&copied, &prefix) || !ends_with(&copied, &suffix) || !contains(&copied, &suffix)) {
        raz_rt_dealloc(source);
        return 6;
    }
    if (find(&copied, &suffix) != 2 || rfind(&copied, &prefix) != 0) {
        raz_rt_dealloc(source);
        return 7;
    }
    if (!insert_string(&mut copied, 2, &prefix) || len(&copied) != 6) {
        raz_rt_dealloc(source);
        return 8;
    }
    // Alias-safe replacement: replacement bytes point inside the same String.

    usize aliased = data_ptr(&copied) + 2;

    if (!replace_range_bytes(&mut copied, 0, 2, aliased, 2) || len(&copied) != 6) {
        raz_rt_dealloc(source);
        return 9;
    }
    if (byte_at(&copied, 0) != 100 || byte_at(&copied, 1) != 97) {
        raz_rt_dealloc(source);
        return 10;
    }
    raz_rt_dealloc(source);
    return 0;
}
