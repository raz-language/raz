fn main() -> i64 {
    if (expect(true) != 0) {
        return 1;
    }
    if (expect_i64_eq(-42, -42) != 0) {
        return 2;
    }
    if (expect_u64_eq(42, 42) != 0) {
        return 3;
    }
    if (expect_bool_eq(true, true) != 0) {
        return 4;
    }
    return 0;
}
