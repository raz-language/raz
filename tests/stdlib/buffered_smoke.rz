extern fn raz_rt_file_open(usize path, i64 length, i64 flags) -> usize;
extern fn raz_rt_file_seek(usize handle, i64 offset, i64 origin) -> i64;
extern fn raz_rt_file_close(usize handle);
extern fn raz_rt_remove_one(usize path, i64 length) -> i64;
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;
extern fn raz_rt_load_u8(usize address) -> i64;

fn main() -> i64 {
    usize path = raz_rt_alloc(19);
    i64 path_bytes[19] = [47, 116, 109, 112, 47, 114, 97, 122, 45, 98, 117, 102, 46, 98, 105, 110, 48, 49];
    i64 i = 0;

    while (i < 19) {
        raz_rt_store_u8(path + i, path_bytes[i]);
        i += 1;
    }

    usize data = raz_rt_alloc(6);
    usize output = raz_rt_alloc(6);

    i = 0;
    while (i < 6) {
        raz_rt_store_u8(data + i, 40 + i);
        i += 1;
    }

    usize handle = raz_rt_file_open(path, 19, 1 | 2 | 8 | 16);

    if (handle == 0) {
        return 1;
    }

    BufWriter buffered_writer = writer_with_capacity(handle, 3);

    if (
        !writer_write(&mut buffered_writer, data, 2) ||
        !writer_write(&mut buffered_writer, data + 2, 4) ||
        !writer_flush(&mut buffered_writer)
    ) {
        return 2;
    }
    writer_destroy(&mut buffered_writer);
    if (raz_rt_file_seek(handle, 0, 0) != 1) {
        return 3;
    }

    BufReader buffered_reader = reader_with_capacity(handle, 2);

    if (!reader_read_exact(&mut buffered_reader, output, 6)) {
        return 4;
    }
    if (raz_rt_load_u8(output) != 40 || raz_rt_load_u8(output + 5) != 45) {
        return 5;
    }
    reader_destroy(&mut buffered_reader);
    raz_rt_file_close(handle);
    raz_rt_remove_one(path, 19);
    raz_rt_dealloc(path);
    raz_rt_dealloc(data);
    raz_rt_dealloc(output);
    return 0;
}
