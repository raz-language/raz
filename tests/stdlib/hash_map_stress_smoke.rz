extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_volatile_load_i64(usize address) -> i64;
extern fn raz_rt_volatile_store_i64(usize address, i64 value);

fn key_for(i64 index) -> i64 { return (index * 7919) & 2047; }

fn main() -> i64 {
    RawHashMap map = raw_hash_map_create(8, 1);
    usize source = raz_rt_alloc(8);
    usize output = raz_rt_alloc(8);
    if (source == 0 || output == 0) { return 1; }

    i64 round = 0;
    while (round < 48) {
        i64 i = 0;
        while (i < 1024) {
            raz_rt_volatile_store_i64(source, round * 4096 + i);
            if (!raw_hash_map_insert_raw(&mut map, key_for(i), source)) { return 2; }
            i += 1;
        }
        if (raw_hash_map_len(&map) != 1024) { return 3; }

        i = 0;
        while (i < 1024) {
            if (!raw_hash_map_get_raw(&map, key_for(i), output)) { return 4; }
            if (raz_rt_volatile_load_i64(output) != round * 4096 + i) { return 5; }
            i += 7;
        }

        i = 0;
        while (i < 1024) {
            if (!raw_hash_map_remove(&mut map, key_for(i), output)) { return 6; }
            i += 2;
        }
        if (raw_hash_map_len(&map) != 512) { return 7; }

        i = 0;
        while (i < 1024) {
            if ((i & 1) == 0) {
                raz_rt_volatile_store_i64(source, 1000000 + round * 4096 + i);
                if (!raw_hash_map_insert_raw(&mut map, key_for(i), source)) { return 8; }
            }
            i += 1;
        }
        if (raw_hash_map_len(&map) != 1024) { return 9; }
        raw_hash_map_clear(&mut map);
        round += 1;
    }
    raw_hash_map_destroy(&mut map);
    raz_rt_dealloc(output);
    raz_rt_dealloc(source);
    return 0;
}
