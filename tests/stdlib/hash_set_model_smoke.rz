fn next_random(i64 value) -> i64 { return (value * 48271) % 2147483647; }

fn main() -> i64 {
    RawHashSet set = raw_hash_set_create(4);
    bool present[256];
    i64 i = 0;
    while (i < 256) { present[i] = false; i += 1; }

    i64 expected_len = 0;
    i64 random = 7;
    i64 step = 0;
    while (step < 75000) {
        random = next_random(random);
        i64 key = random % 256;
        random = next_random(random);
        i64 operation = random % 3;
        if (operation == 0) {
            bool inserted = raw_hash_set_insert(&mut set, key);
            if (inserted != !present[key]) { return 1; }
            if (inserted) { present[key] = true; expected_len += 1; }
        } else if (operation == 1) {
            bool removed = raw_hash_set_remove(&mut set, key);
            if (removed != present[key]) { return 2; }
            if (removed) { present[key] = false; expected_len -= 1; }
        } else {
            if (raw_hash_set_contains(&set, key) != present[key]) { return 3; }
        }
        if (raw_hash_set_len(&set) != expected_len) { return 4; }

        if ((step % 257) == 0) {
            i = 0;
            while (i < 256) {
                if (raw_hash_set_contains(&set, i) != present[i]) { return 5; }
                i += 1;
            }
        }
        step += 1;
    }
    raw_hash_set_destroy(&mut set);
    return 0;
}
