extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_volatile_load_i64(usize address) -> i64;
extern fn raz_rt_volatile_store_i64(usize address, i64 value);

fn main() -> i64 {
    RawHashMap map = raw_hash_map_create(8, 2);
    usize source = raz_rt_alloc(8);
    usize output = raz_rt_alloc(8);

    raz_rt_volatile_store_i64(source, 41);
    if (!raw_hash_map_insert_raw(&mut map, 7, source)) {
        return 1;
    }
    raz_rt_volatile_store_i64(source, 42);
    if (!raw_hash_map_insert_raw(&mut map, 8, source)) {
        return 2;
    }
    if (!raw_hash_map_get_raw(&map, 8, output) || raz_rt_volatile_load_i64(output) != 42) {
        return 3;
    }
    raz_rt_volatile_store_i64(source, 99);
    if (!raw_hash_map_insert_raw(&mut map, 8, source)) {
        return 4;
    }
    if (!raw_hash_map_get_raw(&map, 8, output) || raz_rt_volatile_load_i64(output) != 99) {
        return 5;
    }
    if (!raw_hash_map_remove(&mut map, 7, output) || raw_hash_map_contains_key(&map, 7)) {
        return 6;
    }
    raz_rt_dealloc(source);
    raz_rt_dealloc(output);
    return raw_hash_map_len(&map) - 1;
}
