extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;
extern fn raz_rt_load_u8(usize address) -> i64;
extern fn raz_rt_remove_one(usize path, i64 length) -> i64;

fn main() -> i64 {
    usize path = raz_rt_alloc(19);
    i64 path_bytes[19] = [47, 116, 109, 112, 47, 114, 97, 122, 45, 101, 45, 102, 105, 108, 101, 46, 98, 105, 110];
    i64 i = 0;

    while (i < 19) {
        raz_rt_store_u8(path + i, path_bytes[i]);
        i += 1;
    }

    usize data = raz_rt_alloc(4);
    usize output = raz_rt_alloc(4);

    raz_rt_store_u8(data + 0, 10);
    raz_rt_store_u8(data + 1, 20);
    raz_rt_store_u8(data + 2, 30);
    raz_rt_store_u8(data + 3, 40);

    File file = open_with_flags(path, 19, read_flag | write_flag | create_flag | truncate_flag);

    if (!valid(&file) || !write_all(&mut file, data, 4)) {
        return 1;
    }
    if (position(&file) != 4 || !seek_start(&mut file, 0)) {
        return 2;
    }
    if (read(&mut file, output, 4) != 4 || raz_rt_load_u8(output + 2) != 30) {
        return 3;
    }
    close(&mut file);
    raz_rt_remove_one(path, 19);
    raz_rt_dealloc(path);
    raz_rt_dealloc(data);
    raz_rt_dealloc(output);
    return 0;
}
