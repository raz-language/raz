fn main() -> i64 {
    SpscI64 invalid_zero = create(0);
    if (valid(&invalid_zero)) { return 1; }
    SpscI64 invalid_huge = create(576460752303423488);
    if (valid(&invalid_huge)) { return 2; }

    SpscI64 queue = create(7);
    if (!valid(&queue) || capacity(&queue) != 8) { return 3; }

    i64 cycle = 0;
    i64 next = 0;
    while (cycle < 20000) {
        i64 fill = 0;
        while (fill < 8) {
            if (!try_send(&queue, next)) { return 4; }
            next += 1;
            fill += 1;
        }
        if (try_send(&queue, -1) || len(&queue) != 8) { return 5; }

        i64 drain = 0;
        while (drain < 8) {
            SpscReceiveI64 item = try_receive(&queue);
            i64 expected = cycle * 8 + drain;
            if (!item.received || item.value != expected) { return 6; }
            drain += 1;
        }
        if (!is_empty(&queue) || try_receive(&queue).received) { return 7; }
        cycle += 1;
    }
    destroy(&mut queue);
    return 0;
}
