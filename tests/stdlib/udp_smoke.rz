extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;
extern fn raz_rt_load_u8(usize address) -> i64;

fn main() -> i64 {
    usize host = raz_rt_alloc(9);
    i64 host_bytes[9] = [49, 50, 55, 46, 48, 46, 48, 46, 49];
    i64 i = 0;

    while (i < 9) {
        raz_rt_store_u8(host + i, host_bytes[i]);
        i += 1;
    }

    UdpSocket receiver = udp_socket_bind(0);
    UdpSocket sender = udp_socket_bind(0);

    if (!udp_socket_valid(&receiver) || !udp_socket_valid(&sender)) {
        return 1;
    }

    i64 port = local_port(receiver.socket);

    if (!set_timeout_millis(receiver.socket, 1000, 1000)) {
        return 2;
    }

    usize data = raz_rt_alloc(3);
    usize output = raz_rt_alloc(8);

    raz_rt_store_u8(data + 0, 4);
    raz_rt_store_u8(data + 1, 2);
    raz_rt_store_u8(data + 2, 7);
    if (udp_socket_send_to(&sender, host, 9, port, data, 3) != 3) {
        return 3;
    }
    if (udp_socket_receive(&receiver, output, 8) != 3) {
        return 4;
    }
    if (raz_rt_load_u8(output + 1) != 2) {
        return 5;
    }
    raz_rt_dealloc(host);
    raz_rt_dealloc(data);
    raz_rt_dealloc(output);
    return 0;
}
