fn main() -> i64 {
    if (i64_abs(-17) != 17 || gcd(84, 30) != 6 || lcm(21, 6) != 42) {
        return 1;
    }
    if (floor(3.75) != 3.0 || ceil(3.25) != 4.0 || round(2.6) != 3.0) {
        return 2;
    }
    if (sqrt(81.0) != 9.0 || pow(2.0, 10.0) != 1024.0) {
        return 3;
    }
    if (!is_finite(1.0) || is_nan(1.0) || is_infinite(1.0)) {
        return 4;
    }
    return 0;
}
