fn main() -> i64 {
    usize memory = allocate(4096);
    if (memory == 0) { return 1; }
    if (!protect_read_write(memory, 4096)) {
        free(memory, 4096);
        return 2;
    }
    if (!free(memory, 4096)) { return 3; }
    return 0;
}
