fn key_for(i64 index) -> i64 { return (index * 7919) & 2047; }

fn main() -> i64 {
    RawHashSet set = raw_hash_set_create(1);
    i64 round = 0;
    while (round < 64) {
        i64 i = 0;
        while (i < 1024) {
            if (!raw_hash_set_insert(&mut set, key_for(i))) { return 1; }
            i += 1;
        }
        if (raw_hash_set_len(&set) != 1024) { return 2; }
        i = 0;
        while (i < 1024) {
            if (!raw_hash_set_contains(&set, key_for(i))) { return 3; }
            i += 3;
        }
        i = 0;
        while (i < 1024) {
            if (!raw_hash_set_remove(&mut set, key_for(i))) { return 4; }
            i += 2;
        }
        if (raw_hash_set_len(&set) != 512) { return 5; }
        i = 0;
        while (i < 1024) {
            if ((i & 1) == 0) {
                if (raw_hash_set_contains(&set, key_for(i))) { return 6; }
                if (!raw_hash_set_insert(&mut set, key_for(i))) { return 7; }
            }
            i += 1;
        }
        if (raw_hash_set_len(&set) != 1024) { return 8; }
        raw_hash_set_clear(&mut set);
        if (!raw_hash_set_is_empty(&set)) { return 9; }
        round += 1;
    }
    raw_hash_set_destroy(&mut set);
    return 0;
}
