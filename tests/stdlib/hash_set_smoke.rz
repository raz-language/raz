fn main() -> i64 {
    RawHashSet set = raw_hash_set_create(2);

    if (!raw_hash_set_insert(&mut set, 41)) {
        return 1;
    }
    if (!raw_hash_set_insert(&mut set, 42)) {
        return 2;
    }
    if (raw_hash_set_insert(&mut set, 42)) {
        return 3;
    }
    if (!raw_hash_set_contains(&set, 41) || !raw_hash_set_contains(&set, 42)) {
        return 4;
    }
    if (!raw_hash_set_remove(&mut set, 41) || raw_hash_set_contains(&set, 41)) {
        return 5;
    }
    if (!raw_hash_set_insert(&mut set, 99) || raw_hash_set_len(&set) != 2) {
        return 6;
    }
    return 0;
}
