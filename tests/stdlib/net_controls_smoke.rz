extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;

fn main() -> i64 {
    i64 socket = udp_bind(0);
    if (socket < 0) { return 1; }
    if (!set_reuse_address(socket, true)) { close(socket); return 2; }
    if (!set_broadcast(socket, true)) { close(socket); return 3; }

    // Invalid multicast text must be rejected without touching membership state.
    usize bad = raz_rt_alloc(3);
    raz_rt_store_u8(bad + 0, 98);
    raz_rt_store_u8(bad + 1, 97);
    raz_rt_store_u8(bad + 2, 100);
    if (join_multicast_ipv4(socket, bad, 3, 0, 0)) {
        close(socket); return 4;
    }
    raz_rt_dealloc(bad);
    close(socket);
    return 0;
}
