extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;
extern fn raz_rt_load_u8(usize address) -> i64;

fn main() -> i64 {
    RawDeque deque = raw_deque_create(1, 0);
    usize source = raz_rt_alloc(1);
    usize output = raz_rt_alloc(1);

    raz_rt_store_u8(source, 41);
    if (!raw_deque_push_back_raw(&mut deque, source)) {
        return 1;
    }
    raz_rt_store_u8(source, 40);
    if (!raw_deque_push_front_raw(&mut deque, source)) {
        return 2;
    }
    raz_rt_store_u8(source, 42);
    if (!raw_deque_push_back_raw(&mut deque, source)) {
        return 3;
    }
    if (raw_deque_len(&deque) != 3 || raz_rt_load_u8(raw_deque_element_address(&deque, 1)) != 41) {
        return 4;
    }
    if (!raw_deque_pop_front_raw(&mut deque, output) || raz_rt_load_u8(output) != 40) {
        return 5;
    }
    if (!raw_deque_pop_back_raw(&mut deque, output) || raz_rt_load_u8(output) != 42) {
        return 6;
    }
    raz_rt_dealloc(source);
    raz_rt_dealloc(output);
    return raw_deque_len(&deque) - 1;
}
