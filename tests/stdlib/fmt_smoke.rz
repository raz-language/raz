fn main() -> i64 {
    String signed = format_i64(-42);
    String truth = format_bool(true);
    String binary = format_binary_u64(10);
    String octal = format_octal_u64(64);

    if (alloc::string::len(&signed) != 3 || alloc::string::byte_at(&signed, 0) != 45) {
        return 1;
    }
    if (alloc::string::len(&truth) != 4 || alloc::string::byte_at(&truth, 0) != 116) {
        return 2;
    }
    if (
        alloc::string::len(&binary) != 4 ||
        alloc::string::byte_at(&binary, 0) != 49 ||
        alloc::string::byte_at(&binary, 3) != 48
    ) {
        return 3;
    }
    if (alloc::string::len(&octal) != 3 || alloc::string::byte_at(&octal, 0) != 49) {
        return 4;
    }
    return 0;
}
