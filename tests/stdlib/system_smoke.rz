fn main() -> i64 {
    if (logical_cpu_count() < 1) { return 1; }
    i64 page = page_size();
    if (page < 512 || (page & (page - 1)) != 0) { return 2; }
    // Affinity is capability/policy dependent (containers can restrict CPU 0),
    // so the smoke validates the API rejects invalid indices deterministically.
    if (set_current_thread_affinity(-1)) { return 3; }
    return 0;
}
