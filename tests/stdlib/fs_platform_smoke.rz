extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;
extern fn raz_rt_remove_one(usize path, i64 length) -> i64;

fn main() -> i64 {
    usize prefix = raz_rt_alloc(5);
    i64 bytes[5] = [114, 97, 122, 51, 57];
    i64 i = 0;
    while (i < 5) { raz_rt_store_u8(prefix + i, bytes[i]); i += 1; }

    usize path = raz_rt_alloc(512);
    Result<i64, IoError> created = create_temp_file(prefix, 5, path, 512);
    i64 path_length = -1;
    match created {
        Result<i64, IoError>::Error(error) => { return 1; }
        Result<i64, IoError>::Ok(value) => { path_length = value; }
    }
    if (path_length <= 0) { return 2; }

    Result<i64, IoError> mode = permissions(path, path_length);
    match mode {
        Result<i64, IoError>::Error(error) => { return 3; }
        Result<i64, IoError>::Ok(value) => {
            if (value < 0 || value > 511) { return 4; }
        }
    }

    usize canonical_output = raz_rt_alloc(1024);
    Result<i64, IoError> resolved = canonical(path, path_length, canonical_output, 1024);
    match resolved {
        Result<i64, IoError>::Error(error) => { return 5; }
        Result<i64, IoError>::Ok(value) => {
            if (value <= 0) { return 6; }
        }
    }

    if (raz_rt_remove_one(path, path_length) < 0) { return 7; }
    raz_rt_dealloc(prefix);
    raz_rt_dealloc(path);
    raz_rt_dealloc(canonical_output);
    return 0;
}
