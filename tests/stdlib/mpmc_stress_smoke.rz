fn main() -> i64 {
    MpmcI64 invalid = create(576460752303423480);
    if (valid(&invalid)) { return 1; }

    MpmcI64 queue = create(7);
    if (!valid(&queue) || capacity(&queue) != 8) { return 2; }

    i64 cycle = 0;
    while (cycle < 20000) {
        i64 fill = 0;
        while (fill < 8) {
            i64 value = cycle * 8 + fill;
            if (!try_send(&queue, value)) { return 3; }
            fill += 1;
        }
        if (try_send(&queue, -1) || len(&queue) != 8) { return 4; }

        i64 drain = 0;
        while (drain < 8) {
            MpmcReceiveI64 item = try_receive(&queue);
            i64 expected = cycle * 8 + drain;
            if (!item.received || item.value != expected) { return 5; }
            drain += 1;
        }
        if (!is_empty(&queue) || try_receive(&queue).received) { return 6; }
        cycle += 1;
    }
    destroy(&mut queue);
    return 0;
}
