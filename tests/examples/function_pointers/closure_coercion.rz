fn apply(fn(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn make_incrementer() -> fn(i64) -> i64 {
    return fn(i64 value) -> i64 {
        return value + 1;
    };
}

fn main() -> i64 {
    fn(i64) -> i64 double_value = fn(i64 value) -> i64 {
        return value * 2;
    };
    fn(i64) -> i64 increment = make_incrementer();
    return apply(double_value, increment(20));
}
