struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

fn make_consumer(Resource resource) -> FnOnce() -> i64 {
    return move fn() -> i64 {
        return resource.handle;
    };
}

fn apply(FnOnce() -> i64 operation) -> i64 {
    return operation();
}

fn main() -> i64 {
    Resource resource = Resource {
        handle: 42
    };
    return apply(make_consumer(resource));
}
