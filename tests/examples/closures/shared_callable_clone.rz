fn invoke_shared(Fn(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn main() -> i64 {
    i64 amount = 20;

    auto first = fn(i64 value) -> i64 {
        return value + amount;
    };
    return first(1) + invoke_shared(clone(first), 1);
}
