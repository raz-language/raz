struct Pair {
    i64 left;
    i64 right;
}

impl Copy for Pair {}

fn make_sum(Pair pair) -> Fn() -> i64 {
    return fn() -> i64 {
        return pair.left + pair.right;
    };
}

fn apply(Fn() -> i64 operation) -> i64 {
    return operation();
}

fn main() -> i64 {
    Pair pair = Pair {
        left: 20,
        right: 22
    };
    return apply(make_sum(pair));
}
