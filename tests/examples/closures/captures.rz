fn stored_capture() -> i64 {
    i64 factor = 3;

    auto scale = fn(i64 value) -> i64 {
        return value * factor;
    };
    factor = 9;
    return scale(14);
}

fn immediate_capture() -> i64 {
    i64 offset = 5;

    return fn(i64 value) -> i64 {
        return value + offset;
    }
    (37);
}
