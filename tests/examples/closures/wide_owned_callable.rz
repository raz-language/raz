fn invoke(FnOnce(i64, i64, i64, i64, i64, i64, i64, i64) -> i64 operation) -> i64 {
    return operation(9, 10, 11, 12, 13, 14, 15, 16);
}

fn main() -> i64 {
    i64 a = 1;
    i64 b = 2;
    i64 c = 3;
    i64 d = 4;
    i64 e = 5;
    i64 f = 6;
    i64 g = 7;
    i64 h = 8;

    return invoke(move fn(i64 i, i64 j, i64 k, i64 l, i64 m, i64 n, i64 o, i64 p) -> i64 {
        return a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p;
    }
    );
}
