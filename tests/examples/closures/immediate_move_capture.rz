struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

fn run() -> i64 {
    Resource resource = Resource {
        handle: 40
    };
    return move fn() -> i64 {
        return resource.handle + 2;
    }
    ();
}
