fn make_adder(i64 amount) -> FnOnce(i64) -> i64 {
    return move fn(i64 value) -> i64 {
        return value + amount;
    };
}

fn apply_once(FnOnce(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn main() -> i64 {
    auto adder = make_adder(40);

    return apply_once(adder, 2);
}
