struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

fn run() -> i64 {
    Resource resource = Resource {
        handle: 41
    };
    auto consume = move fn() -> i64 {
        return resource.handle + 1;
    };
    return consume();
}
