fn invoke_shared(Fn(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn main() -> i64 {
    i64 factor = 2;

    return invoke_shared(move fn(i64 value) -> i64 {
        return value * factor;
    }, 21);
}
