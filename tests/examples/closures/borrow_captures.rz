fn shared_capture() -> i64 {
    i64 value = 40;

    auto read = ref fn() -> i64 {
        return *value;
    };
    return read() + read();
}

fn mutable_capture() -> i64 {
    i64 value = 1;

    auto increment = mut fn() -> i64 {
        *value += 1;
        return *value;
    };
    increment();
    increment();
    return value;
}
