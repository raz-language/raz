struct Pair {
    i64 left;
    i64 right;
}

impl Copy for Pair {}

fn main() -> i64 {
    Pair pair = Pair {
        left: 10,
        right: 20
    };
    auto sum = fn() -> i64 {
        return pair.left + pair.right;
    };
    pair.left = 100;
    return sum();
}
