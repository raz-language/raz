trait Provider {
    fn get(Self& self) -> i64;
}

struct Box<T> {
    T value;
}

impl<T: Copy> Provider for Box<T> {
    fn get(Box<T>& self) -> i64 {
        return 1;
    }
    fn extra(Box<T>& self) -> i64 {
        return 2;
    }
}

fn main() -> i64 {
    return 0;
}
