trait Same {
    fn equal(Self& self) -> bool;
}

struct Pair<A, B> {
    A first;
    B second;
}

impl<T: Copy> Same for Pair<T, T> {
    fn equal(Pair<T, T>& self) -> bool {
        return true;
    }
}

fn main() -> bool {
    Pair<i64, string> mixed;

    return mixed.equal();
}
