trait Render {
    fn render(Self& self) -> i64;
    fn scaled(Self& self, i64 factor) -> i64;
}

struct Metric {
    i64 value;
}

impl Render for Metric {
    fn render(Metric& self) -> i64 {
        return self.value;
    }
    fn scaled(Metric& self, i64 factor) -> i64 {
        return self.value * factor;
    }
}

fn use_render(dyn Render object) -> i64 {
    return object.render() + object.scaled(2);
}

fn main() -> i64 {
    Metric metric = Metric {
        value: 14
    };
    dyn Render object = &metric;
    dyn Render second = clone(object);
    return use_render(object) + use_render(second) - 84;
}
