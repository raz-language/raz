trait Reader {
    fn read(Self&mut self, i64&mut output) -> i64;
}

struct Counter {
    i64 value;
}

impl Reader for Counter {
    fn read(Counter&mut self, i64&mut output) -> i64 {
        *output = self.value;
        return 0;
    }
}

fn read_value(dyn Reader reader, i64&mut output) -> i64 {
    return reader.read(output);
}

fn main() -> i64 {
    Counter counter = Counter { value: 42 };
    i64 output = 0;
    dyn Reader reader = &mut counter;
    if (read_value(reader, &mut output) != 0) {
        return 1;
    }
    return output - 42;
}
