trait WireTag {}

@derive(WireTag)enum Message {
    Ping = 0,
    Data(i64) = 1,
}

fn identify<T: WireTag>(T value) -> T {
    return value;
}

fn main() {
    Message message = Message::Data(9);
    Message result = identify<Message>(message);
}
