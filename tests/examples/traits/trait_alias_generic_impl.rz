trait Safe = Copy + Clone;

struct Metric {
    i64 value;
}

impl Copy for Metric {}

impl Clone for Metric {
    fn clone(Metric& self) -> Metric {
        return *self;
    }
}

struct Box<T> {
    T value;
}

impl<T: Copy> Copy for Box<T> {}

impl<T: Clone> Clone for Box<T> {}

fn preserve<T: Safe>(T value) -> T {
    return value;
}

fn main() -> i64 {
    Metric metric = Metric {
        value: 7
    };

    Metric preserved = preserve<Metric>(metric);
    Box<i64> first;
    Box<i64> second = move first;

    first;
    second;
    return preserved.value;
}
