trait Measurable {
    fn measure(Self& self) -> i64;
}

struct Plain {
    i64 value;
}

fn preserve<T: Measurable>(T value) -> T {
    return value;
}

fn main() -> i64 {
    Plain plain = Plain {
        value: 1
    };

    Plain copy = preserve<Plain>(plain);

    return copy.value;
}
