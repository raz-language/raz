trait IteratorInfo {
    type Item;

    fn current(Self& self) -> i64;
}

struct Counter {
    i64 value;
}

impl IteratorInfo for Counter {
    type Item = i64;

    fn current(Counter& self) -> i64 {
        return self.value;
    }
}

impl Counter {
    fn bump(Counter& self) -> i64 {
        return self.value + 1;
    }
}

fn projected<T: IteratorInfo>(T::IteratorInfo::Item value) -> T::IteratorInfo::Item {
    return value;
}

fn main() -> i64 {
    Counter counter = Counter {
        value: 41
    };

    i64 a = counter.bump();
    i64 b = counter.bump();
    i64 c = projected<Counter>(42);
    i64 d = projected<Counter>(c);

    if (a == 42 && b == 42 && c == 42 && d == 42) {
        return 0;
    }
    return 1;
}
