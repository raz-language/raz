trait Serializable {}

trait StableLayout {}

@derive(Serializable, StableLayout)struct Packet {
    i64 sequence;
    u32 flags;
}

fn accept<T: Serializable + StableLayout>(T value) -> T {
    return value;
}

fn main() {
    Packet packet = Packet {
        sequence: 7,
        flags: 3
    };

    Packet accepted = accept<Packet>(packet);
}
