trait IteratorInfo {
    type Item;

    const SIZE: usize;
    fn current(Self& self) -> i64;
}

struct Counter {
    i64 value;
}

impl IteratorInfo for Counter {
    type Item = i64;

    const SIZE: usize = 8;
    fn current(Counter& self) -> i64 {
        return self.value;
    }
}

fn read(Counter& counter) -> i64 {
    return counter.current();
}
