trait Measurable: Copy {
    fn measure(Self& self) -> i64;
    fn doubled(Self& self) -> i64 {
        return self.measure() * 2;
    }
}

struct Metric {
    i64 value;
}

impl Copy for Metric {}

impl Measurable for Metric {
    fn measure(Metric& self) -> i64 {
        return self.value;
    }
}

fn main() -> i64 {
    Metric metric = Metric {
        value: 21
    };
    return metric.doubled();
}
