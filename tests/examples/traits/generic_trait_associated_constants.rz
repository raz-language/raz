trait Capacity {
    const WIDTH: usize;
    fn width(Self& self) -> usize;
}

struct Buffer<T, const usize N> {
    T values[N];
}

impl<T: Copy, const usize N> Capacity for Buffer<T, N> {
    const WIDTH: usize = N * 2;
    fn width(Buffer<T, N>& self) -> usize {
        return WIDTH;
    }
}

fn main() -> i64 {
    Buffer<i64, 4> buffer;

    return buffer.width() - 8;
}
