trait Select {
    fn select(Self& self) -> i64;
}

struct Pair<A, B> {
    A first;
    B second;
}

struct Wrapper<T> {
    T value;
}

struct Buffer<T, const usize N> {
    T values[N];
}

impl<T: Copy> Select for Pair<T, i64> {
    fn select(Pair<T, i64>& self) -> i64 {
        return self.second;
    }
}

impl<T: Copy> Select for Wrapper<Pair<T, i64> > {
    fn select(Wrapper<Pair<T, i64> >& self) -> i64 {
        return self.value.second;
    }
}

impl<T: Copy> Select for Buffer<T, 4> {
    fn select(Buffer<T, 4>& self) -> i64 {
        return 4;
    }
}

fn main() -> i64 {
    Pair<i64, i64> pair;

    pair.first = 3;
    pair.second = 7;

    Wrapper<Pair<i64, i64> > wrapped;

    wrapped.value = pair;

    Buffer<i64, 4> buffer;

    return pair.select() + wrapped.select() + buffer.select() - 18;
}
