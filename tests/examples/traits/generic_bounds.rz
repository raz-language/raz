trait Measurable {
    fn measure(Self& self) -> i64;
}

struct Metric {
    i64 value;
}

impl Measurable for Metric {
    fn measure(Metric& self) -> i64 {
        return self.value;
    }
}

fn preserve<T: Measurable + Clone>(T value) -> T {
    return value;
}

impl Clone for Metric {
    fn clone(Metric& self) -> Metric {
        self;
        return Metric {
            value: 99
        };
    }
}

fn main() -> i64 {
    Metric metric = Metric {
        value: 42
    };

    Metric copy = preserve<Metric>(metric);

    return copy.value;
}
