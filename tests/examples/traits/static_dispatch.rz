trait Measurable {
    fn measure(Self& self) -> i64;
    fn scaled(Self& self, i64 factor) -> i64;
}

struct Metric {
    i64 value;
}

impl Measurable for Metric {
    fn measure(Metric& self) -> i64 {
        return self.value;
    }
    fn scaled(Metric& self, i64 factor) -> i64 {
        return self.value * factor;
    }
}

fn generic_measure<T: Measurable>(T& value) -> i64 {
    return value.measure();
}

fn main() -> i64 {
    Metric metric = Metric {
        value: 21
    };
    return metric.scaled(2) + generic_measure<Metric>(& metric);
}
