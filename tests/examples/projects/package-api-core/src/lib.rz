namespace core::api;


public struct PublicToken {
    i64 value;
}

struct PackageToken {
    i64 value;
}

private struct SecretToken {
    i64 value;
}

public fn answer() -> i64 {
    return 42;
}

fn package_answer() -> i64 {
    return 41;
}

private fn secret_answer() -> i64 {
    return 40;
}
