public trait PackageMarker {}

public trait PackageValue {
    fn value(Self& self) -> i64;
}

public struct Token {
    i64 value;
}

impl PackageMarker for Token {}

impl PackageValue for Token {
    fn value(Token& self) -> i64 {
        return self.value;
    }
}

trait PackageInternal {}

private trait ModuleSecret {}
