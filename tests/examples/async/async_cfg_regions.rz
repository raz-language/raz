async fn compute(i64 value) -> i64 {
    return value + 1;
}

async fn branch_loop(i64 input) -> i64 {
    i64 value = input;

    while (value < 3) {
        i64 child = spawn compute(value);
        i64 ready = await child;

        if (ready > value) {
            value = ready;
        }
    }
    return value;
}

fn main() -> i64 {
    return 0;
}
