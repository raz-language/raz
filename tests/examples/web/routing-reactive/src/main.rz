import web::ui;

fn main() -> Component {
    Component page = component(Tag::Main);
    page.class_name("app");
    if (route_match("/blog/:slug")) {
        String slug = route_param("/blog/:slug", "slug");
        page.h1("Blog");
        page.text(Tag::P, slug.as_str());
    } else if (route_match("/docs/*path")) {
        String path = route_splat("/docs/*path", "path");
        page.h1("Docs");
        page.text(Tag::P, path.as_str());
    } else if (route_is("/")) {
        page.h1("Home");
        page.nav_link("/blog/hello", "Blog");
        page.nav_link("/docs/guides/install", "Install guide");
    } else {
        page.h1("Not found");
    }
    return move page;
}
