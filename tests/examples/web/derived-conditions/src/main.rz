import web::ui;

fn threshold_panel() -> Component {
    Component panel = section_component();
    panel.h2("Threshold reached");
    panel.p("This subtree is owned by the derived comparison dependency.");
    return move panel;
}

fn equality_panel() -> Component {
    Component panel = section_component();
    panel.h2("Values match");
    return move panel;
}

fn main() -> Component {
    Component page = component_scoped(Tag::Main, "derived-conditions-app");
    StateI64 count = page.state_i64("count", 1);
    StateI64 target = page.state_i64("target", 3);
    DerivedBool reached = derived_gte_const(&mut count, 3);
    DerivedBool equal = derived_eq(&mut count, &mut target);

    page.h1("Derived conditions");
    page.text_i64_state(Tag::P, "Count: ", &mut count);
    page.text_i64_state(Tag::P, "Target: ", &mut target);
    page.button_increment("", "Increment count", "+1", &mut count);
    page.button_increment("", "Increment target", "Target +1", &mut target);

    Component threshold = threshold_panel();
    page.child_when_derived_keyed(&mut reached, "threshold", &mut threshold);
    Component matching = equality_panel();
    page.child_when_derived(&mut equal, &mut matching);
    return move page;
}
