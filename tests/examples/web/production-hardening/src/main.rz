import web::ui;
import web::std::fetch;
import web::std::storage;

fn dashboard() -> Component {
    Component panel = component_scoped(Tag::Section, "production-dashboard");
    StateI64 count = panel.state_i64("count", 0);
    web::ui::HttpRequest status_request = web::std::fetch::get("/api/status");

    if (panel.first_render()) {
        web::std::storage::set("production-mounted", "1");
    }
    if (panel.effect_i64(&mut count)) {
        web::std::storage::set("production-count-changed", "1");
    }
    if (panel.effect_request(&status_request)) {
        web::std::storage::set("production-request-changed", "1");
    }

    panel.h2("Dashboard");
    panel.text_i64_state(Tag::P, "Count: ", &mut count);
    panel.text_i64(Tag::P, "HTTP: ", web::std::fetch::status(&status_request));
    panel.button_increment("increment", "Increment", "+1", &mut count);
    return move panel;
}

fn main() -> Component {
    Component page = component(Tag::Main);
    page.class_name("production-app");
    if (route_is("/")) {
        page.h1("Production hardening");
        page.nav_link("/dashboard", "Dashboard");
    } else if (route_is("/dashboard")) {
        page.h1("Dashboard route");
        page.nav_link("/", "Home");
        Component child = dashboard();
        page.child(&mut child);
    } else {
        page.h1("Not found");
        page.nav_link("/", "Home");
    }
    return move page;
}
