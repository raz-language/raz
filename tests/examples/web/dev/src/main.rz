namespace web_dev_fixture;
import web;
fn main() -> i64 {
    if (!web::prepare_dist()) { return 1; }
    Page page = Page::new("Raz Dev Fixture");
    page.css(".page", "color: #123456;");
    page.main("page");
    page.h1("Raz dev");
    page.p("generation one");
    page.end_main();
    if (!page.write_route("/")) { return 1; }
    return 0;
}
