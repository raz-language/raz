import web::ui;
import web::std::fetch;
import web::std::encoding;

fn main() -> Component {
    Component page = main_component();
    web::ui::HttpRequest users = web::std::fetch::get("/api/users");
    web::ui::HttpRequest create = web::std::fetch::post_text("/api/users", "{\"name\":\"Raz\"}");
    web::ui::HttpRequest replace = web::std::fetch::put_text("/api/users/1", "{\"name\":\"Raz Web\"}");
    web::ui::HttpRequest update = web::std::fetch::patch_text("/api/users/1", "{\"active\":true}");
    web::ui::HttpRequest remove = web::std::fetch::delete("/api/users/2");

    page.h1("Fetch standard library");
    page.text_i64(Tag::P, "GET ", web::std::fetch::status(&users));
    page.text_i64(Tag::P, "POST ", web::std::fetch::status(&create));
    page.text_i64(Tag::P, "PUT ", web::std::fetch::status(&replace));
    page.text_i64(Tag::P, "PATCH ", web::std::fetch::status(&update));
    page.text_i64(Tag::P, "DELETE ", web::std::fetch::status(&remove));
    page.text_i64(Tag::P, "UTF-8 bytes ", web::std::encoding::utf8_length("Raz Web"));
    return move page;
}
