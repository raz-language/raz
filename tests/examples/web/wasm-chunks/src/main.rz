import web;
import web::std::events;

fn editor_value(i64 value) -> i64 { return value + 1; }
fn analytics_value(i64 value) -> i64 { return value * 2; }

fn open_editor() { web::set_text_i64("status", editor_value(40)); }
fn close_editor() { web::set_text_i64("status", editor_value(8)); }
fn run_report() { web::set_text_i64("status", analytics_value(21)); }

fn main() -> i64 {
    if (!web::prepare_dist()) { return 1; }
    Page page = Page::new("Raz WASM chunks");
    page.button_id("open", "Open editor");
    page.button_id("close", "Close editor");
    page.button_id("report", "Run report");
    page.p_id("status", "ready");
    if (!page.lazy_wasm_on_click("open", "editor", "open_editor")) { return 2; }
    if (!page.lazy_wasm_on_click("close", "editor", "close_editor")) { return 3; }
    if (!page.lazy_wasm_on_click("report", "analytics", "run_report")) { return 4; }
    if (!page.write_route("/")) { return 5; }
    return 0;
}
