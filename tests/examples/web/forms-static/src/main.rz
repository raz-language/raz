namespace raz_web_forms_static;

import web;

fn main() -> i64 {
    if (!web::prepare_dist()) { return 1; }
    Page page = Page::new("Contact");
    page.main("contact");
    page.h1("Contact");
    page.form_post("/contact", "contact-form");
    page.input_hidden("csrf", "a&b");
    page.label_for("email", "Email");
    page.input_id("email", "email", "email", "you@example.com");
    page.label_for("plan", "Plan");
    page.select_name("plan", "plan-select");
    page.option("free", "Free");
    page.option_selected("pro", "Pro");
    page.end_select();
    page.input_checkbox("terms", "yes", true);
    page.input_radio("tier", "basic", false);
    page.input_radio("tier", "pro", true);
    page.input_range("experience", "0", "10", "1");
    page.input_datetime_local("appointment");
    page.input_color("accent");
    page.textarea("message", "Message", "Hello <Raz>");
    page.field_error("email-error", "Please enter a valid email.");
    page.input_submit("Send");
    page.end_form();
    page.form_multipart("/upload", "upload-form");
    page.input_file("attachment", ".txt,image/*");
    page.input_submit("Upload");
    page.end_form();
    page.end_main();
    if (!page.write_route("/")) { return 2; }
    return 0;
}
