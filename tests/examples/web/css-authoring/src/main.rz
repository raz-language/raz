import web;
import web::ui;

fn main() -> i64 {
    Component page = main_component();
    page.class_name("app");
    page.h1("Raz CSS");
    page.p("Structured CSS remains compile-time only.");

    page.css_variable("brand", "#6d28d9");
    page.css_class("app", "container-type: inline-size; color: var(--brand); padding: 2rem;");
    page.css_pseudo(".app a", "hover", "text-decoration-thickness: 0.2em;");
    page.css_pseudo_element(".app h1", "after", "content: ' - native CSS';");
    page.css_media("(max-width: 48rem)", ".app", "padding: 1rem;");
    page.css_container("(max-width: 32rem)", ".app h1", "font-size: 1.5rem;");
    page.css_keyframes("pulse", "0% { opacity: .6; } 100% { opacity: 1; }");
    page.css_class("pulse", "animation: pulse 1s ease-in-out infinite alternate;");

    // Structured rules are deterministic and deduplicated.
    page.css_class("pulse", "animation: pulse 1s ease-in-out infinite alternate;");
    page.css_media("(max-width: 48rem)", ".app", "padding: 1rem;");

    if (!web::write_component_route("/", "Raz CSS", &mut page)) { return 1; }
    return 0;
}
