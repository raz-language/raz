import web;

fn main() -> i64 {
    if (!web::prepare_dist()) { return 1; }

    Page page = Page::new_lang("Raz Web Authoring", "en-US");
    page.description("Static HTML authored in ordinary Raz.");
    page.author("Raz");
    page.theme_color("#111111");
    page.canonical("https://example.test/docs");
    page.robots("index,follow");
    page.keywords("raz,web,html");
    page.meta_property("og:title", "Raz Web Authoring");
    page.alternate("/es/docs", "es");
    page.preload("/fonts/raz.woff2", "font");
    page.manifest("/site.webmanifest");
    page.stylesheet("/site.css");
    page.css(":root", "color-scheme: light dark;");
    page.css_class("article", "max-width: 70ch; margin: 0 auto;");
    page.css_class("article", "max-width: 70ch; margin: 0 auto;"); // exact duplicate is emitted once
    page.css_id("email", "min-width: 18rem;");
    page.scoped_style("docs", "p", "line-height: 1.6;");
    page.raw_css("@media (max-width: 640px) { .article { padding: 1rem; } }");

    page.header("site-header");
    page.nav("nav");
    page.a("/", "Home");
    page.a_class("/docs", "active", "Docs");
    page.a_external("https://example.test", "External");
    page.end_nav();
    page.end_header();

    page.main("page");
    page.article("article");
    page.h1("Raz <Web> & HTML");
    page.h4("Semantic headings work");
    page.p("Text is escaped by default: <>&\"");
    page.em("No template language required.");
    page.blockquote("Ordinary Raz, ordinary HTML output.");
    page.time("2026-08-26", "August 26, 2026");
    page.abbr("WebAssembly", "Wasm");
    page.q("https://example.test/spec", "Safe markup should stay easy.");
    page.element_attr("p", "data-kind", "example", "Safe custom attributes");
    page.element_attr2("p", "data-kind", "multi", "aria-label", "Two attributes", "Multiple safe attributes");
    page.element_attr3("span", "data-a", "1", "data-b", "2", "data-c", "3", "Three attributes");
    page.open_attr("section", "data-raz-scope", "docs");
    page.small("ARIA/data attributes are ordinary escaped HTML attributes.");
    page.close("section");

    page.landmark("aside", "toc", "toc", "complementary", "On this page");
    page.p("Accessible landmark helper.");
    page.close("aside");

    page.dl("terms");
    page.dt("Static-first");
    page.dd("No browser runtime unless behavior needs it.");
    page.end_dl();

    page.svg("0 0 24 24", "icon");
    page.svg_path("M4 12h16");
    page.end_svg();

    page.image_lazy("/hero.png", "Raz web output");
    page.iframe("/embed.html", "Embedded Raz example");

    page.details("details");
    page.summary("More information");
    page.p("Details are native semantic HTML.");
    page.end_details();

    page.form("/submit", "post", "contact");
    page.label_for("email", "Email");
    page.input_id("email", "email", "email", "you@example.test");
    page.textarea("message", "Message", "Hello");
    page.select("choice");
    page.option("one", "One");
    page.option("two", "Two");
    page.end_select();
    page.end_form();

    page.table("data");
    page.thead("");
    page.tr("");
    page.th("Feature");
    page.th("Output");
    page.end_tr();
    page.end_thead();
    page.tbody("");
    page.tr("");
    page.td("Static page");
    page.td("HTML only");
    page.end_tr();
    page.end_tbody();
    page.tfoot("");
    page.tr("");
    page.td("Total");
    page.td("1");
    page.end_tr();
    page.end_tfoot();
    page.end_table();

    page.end_article();
    page.end_main();

    if (!page.write_route("/")) { return 1; }
    return 0;
}
