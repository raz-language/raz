namespace raz_web_routing_static;

import web;
import web::ui;

fn home() -> bool {
    Page page = Page::new("Home");
    page.layout("site", "site-layout");
    page.main("page");
    page.h1("Home");
    page.a("/docs/guides/install", "Install guide");
    page.a("/blog/2026/hello", "Blog");
    page.end_main();
    page.end_layout();
    return page.write_route("/");
}

fn blog() -> bool {
    String path = web::route_path("/blog/:year/:slug");
    if (!web::route_bind(&mut path, "year", "2026")) { return false; }
    if (!web::route_bind(&mut path, "slug", "hello")) { return false; }
    Component content = article_component();
    content.h1("Hello");
    content.p("Prerendered from the same dynamic route syntax used by the browser router.");
    return web::write_component_route_path(&mut path, "Hello", &mut content);
}

fn docs() -> bool {
    String path = web::route_path("/docs/*path");
    if (!web::route_bind_splat(&mut path, "path", "guides/install")) { return false; }
    Page page = Page::new("Install");
    page.main("page");
    page.h1("Install");
    page.end_main();
    return page.write_route_path(&mut path);
}

fn missing() -> bool {
    Page page = Page::new("Not found");
    page.main("page");
    page.h1("404");
    page.end_main();
    return page.write_not_found();
}

fn main() -> i64 {
    if (!web::prepare_dist()) { return 1; }
    if (!home() || !blog() || !docs() || !missing()) { return 1; }
    if (!web::write_redirect("/old-docs", "/docs/guides/install")) { return 1; }

    String unsafe_path = web::route_path("/docs/*path");
    if (web::route_bind_splat(&mut unsafe_path, "path", "../escape")) { return 2; }
    String unresolved = web::route_path("/users/:id");
    Page invalid = Page::new("Invalid");
    if (invalid.write_route_path(&mut unresolved)) { return 3; }
    if (invalid.write_route("/../escape")) { return 4; }
    if (invalid.write_route("/bad?query")) { return 5; }
    if (invalid.write_route("/bad#hash")) { return 6; }
    return 0;
}
