import web::ui;

fn main() -> Component {
    Component page = component(Tag::Main);
    Element form = web::ui::form();
    form.action("/profile");
    form.method("post");
    form.enctype("multipart/form-data");

    Element email = input();
    email.input_type(InputType::Email);
    email.name("email");
    email.placeholder("you@example.com");
    email.required();
    email.pattern(".+@.+");
    email.input_mode("email");
    form.child(&mut email);

    Element age = input();
    age.input_type(InputType::Range);
    age.name("age");
    age.min("18");
    age.max("99");
    age.step("1");
    form.child(&mut age);

    Element appointment = input();
    appointment.input_type(InputType::DateTimeLocal);
    appointment.name("appointment");
    form.child(&mut appointment);

    Element file = input();
    file.input_type(InputType::File);
    file.name("avatar");
    file.accept("image/*");
    form.child(&mut file);

    Element tags = select();
    tags.name("tags");
    tags.multiple();
    tags.required();
    Element option_a = option();
    option_a.value("raz");
    option_a.selected();
    option_a.text("Raz");
    tags.child(&mut option_a);
    form.child(&mut tags);

    page.root.child(&mut form);
    return move page;
}
