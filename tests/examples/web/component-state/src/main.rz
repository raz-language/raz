import web::ui;

fn counter(string key, string label) -> Component {
    Component card = component_scoped(Tag::Section, key);
    card.class_name("counter");

    StateI64 count = card.state_i64("count", 0);
    StateBool enabled = card.state_bool("enabled", true);
    StateString name = card.state_string("name", "Raz");

    card.h2(label);
    card.text_i64_state(Tag::P, "Count: ", &mut count);
    card.text_state(Tag::P, "Name: ", &mut name);
    card.input_text("counter-name", "Name", &mut name);
    card.checkbox("counter-enabled", &mut enabled);
    card.button_add("counter-add", "Increment", "+1", &mut count, 1);
    card.button_toggle("counter-toggle", "Toggle", "Toggle", &mut enabled);
    return move card;
}

fn main() -> Component {
    Component page = component(Tag::Main);
    page.h1("Scoped component state");
    Component left = counter("counter-left", "Left");
    Component right = counter("counter-right", "Right");
    page.child(&mut left);
    page.child(&mut right);
    return move page;
}
