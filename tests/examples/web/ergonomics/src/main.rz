import web::ui;

fn main() -> Component {
    StateI64 count = state_i64("count", 1);
    StateBool enabled = state_bool("enabled", true);
    StateString search = state_string("search", "Raz");
    StateString url = state_string("url", "https://raz.dev");
    StateString date = state_string("date", "2026-08-25");

    Component page = component(Tag::Main);
    page.class_name("app");
    page.css_class("app", "font-family: system-ui; max-width: 64rem; margin: 3rem auto; padding: 2rem;");
    page.css_class("toolbar", "display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;");
    page.css_id("title", "font-size: 2rem; margin-bottom: 1rem;");

    page.h1("Raz Web");
    page.strong("The web UI is still ordinary Raz.");
    page.p("Semantic elements, forms, routes, state, and CSS all stay in the same language.");

    Component article = component(Tag::Article);
    article.class_name("toolbar");
    article.h2("Interactive controls");
    article.input_search("search", "Search", &search);
    article.input_url("url", "Website", &url);
    article.input_date("date", &date);
    article.button_add("", "Increase", "+1", &count, 1);
    article.button_set_i64("", "Reset", "Reset", &count, 1);
    article.button_toggle("", "Toggle", "Enabled", &enabled);
    page.child(&mut article);

    page.text(Tag::P, "Count: ");
    page.text_i64_state(Tag::Span, "", &count);
    page.text_state(Tag::P, "Search: ", &search);

    if (page.route_prefix("/settings")) {
        page.p("You are in the settings area.");
    }
    else {
        page.p("You are on the main application route.");
    }

    Component details = component(Tag::Details);
    details.p("Native details/summary elements are available too.");
    page.child(&mut details);

    page.css_raw("@media (max-width: 48rem) { .app { margin: 1rem; padding: 1rem; } }");
    return move page;
}
