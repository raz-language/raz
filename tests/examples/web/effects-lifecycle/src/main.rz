import web::ui;
import web::std::storage;

fn main() -> Component {
    Component page = component_scoped(Tag::Main, "effects-app");
    StateI64 count = page.state_i64("count", 0);
    StateString name = page.state_string("name", "Raz");

    if (page.first_render()) {
        web::std::storage::set("raz-mounted", "1");
    }
    if (page.effect_i64(&mut count)) {
        web::std::storage::set("raz-count-version", "changed");
    }
    if (page.effect_string(&mut name)) {
        web::std::storage::set("raz-name-version", "changed");
    }

    page.h1("Effects and lifecycle");
    page.text_i64_state(Tag::P, "Count: ", &mut count);
    page.button_increment("", "Increment", "+1", &mut count);
    page.input_text("", "Name", &mut name);
    return move page;
}
