import web;
import web::ui;

// Ordinary typed Raz function parameters are component props. No special
// framework syntax or runtime property bag is required.
fn feature(string title, string copy) -> Component {
    Component card = article_component();
    card.class_name("feature");
    card.h2(title);
    card.p(copy);
    return move card;
}

fn features() -> Component {
    Component group = fragment();
    Component first = feature("Static first", "No JavaScript or Wasm unless behavior requires it.");
    Component second = feature("Ordinary Raz", "Components use normal typed function arguments.");
    group.child(&mut first);
    group.child(&mut second);
    return move group;
}

fn main() -> i64 {
    Component page = main_component();
    page.id("content");
    page.role("main");
    page.aria_label("Raz Web features");
    page.h1("Raz Web");
    Component list = features();
    page.child(&mut list);
    page.css_class("feature", "padding: 1rem; border: 1px solid #ddd;");
    if (!web::write_component_route("/", "Raz Web", &mut page)) { return 1; }
    return 0;
}
