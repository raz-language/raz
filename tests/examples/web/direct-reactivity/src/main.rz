import web::ui;

fn item(string key, string label) -> Component {
    Component row = component(Tag::Li);
    row.text(Tag::Span, label);
    row.key(key);
    return move row;
}

fn main() -> Component {
    Component page = component_scoped(Tag::Main, "direct-reactivity-app");
    StateI64 left = page.state_i64("left", 1);
    StateI64 right = page.state_i64("right", 2);
    StateBool expanded = page.state_bool("expanded", true);
    DerivedI64 total = derived_add(&mut left, &mut right);

    page.h1("Direct Raz reactivity");
    page.text_i64_state(Tag::P, "Left: ", &mut left);
    page.text_derived_i64(Tag::P, "Total: ", &mut total);
    page.button_increment("", "Increment left", "+1", &mut left);
    page.button_toggle("", "Toggle details", "Toggle", &mut expanded);

    if (page.when(&mut expanded)) {
        Component first = item("alpha", "Alpha");
        Component second = item("beta", "Beta");
        page.child_keyed("alpha", &mut first);
        page.child_keyed("beta", &mut second);
    }
    return move page;
}
