import web::ui;
import web::std::dom;
import web::std::location;
import web::std::storage;
import web::std::timers;
import web::std::url;

fn main() -> Component {
    Component page = main_component();

    String path = web::std::location::pathname();
    String query = web::std::url::query("q");
    String encoded = web::std::url::encode_component("Raz Web");
    web::std::storage::session_set("last-path", path.as_str());

    page.h1("Browser standard library");
    page.text(Tag::P, path.as_str());
    page.text(Tag::P, query.as_str());
    page.text(Tag::P, encoded.as_str());

    // Read-side DOM and interval APIs are ordinary browser imports. The calls
    // remain explicit and are only present in an interactive browser module.
    web::std::dom::exists("browser-stdlib-root");
    web::std::dom::text("browser-stdlib-root");
    web::std::timers::set_interval("browser_tick", 1000);
    return move page;
}
