import web::ui;

fn details_panel() -> Component {
    Component panel = section_component();
    panel.key("details");
    panel.h2("Details");
    panel.p("Only this scoped structure depends on the toggle state.");
    return move panel;
}

fn main() -> Component {
    Component page = component_scoped(Tag::Main, "conditions-app");
    StateBool visible = page.state_bool("details-visible", true);
    page.h1("Conditional composition");
    page.button_toggle("", "Toggle details", "Toggle", &mut visible);
    Component details = details_panel();
    page.child_when_keyed(&mut visible, "details", &mut details);
    return move page;
}
