import web::ui;

fn main() -> Component {
    Component page = component(Tag::Main);
    page.class_name("hello");
    page.h1("Hello from Raz");
    page.p("This page is rendered by ordinary Raz.");
    page.raw_html("<strong>Raw HTML works too.</strong>");
    page.raw_css(".hello { font-family: system-ui; max-width: 48rem; margin: 4rem auto; padding: 2rem; }");
    page.raw_js("console.log('Raz web is running');");
    return move page;
}
