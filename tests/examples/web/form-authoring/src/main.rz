import web;
import web::ui;

fn main() -> i64 {
    Component page = main_component();
    page.id("content");
    page.aria_label("Account registration");
    page.data("page", "signup");
    page.h1("Create account");

    Component form_view = form_component();
    form_view.attr("method", "post");
    form_view.aria("labelledby", "signup-heading");

    web::ui::Element email_label = web::ui::label_for("email", "Email address");
    form_view.element(&mut email_label);

    web::ui::Element email = web::ui::email_input();
    email.id("email");
    email.name("email");
    email.autocomplete("email");
    email.placeholder("you@example.com");
    email.required();
    email.aria_describedby("email-help");
    form_view.element(&mut email);

    web::ui::Element help = web::ui::small();
    help.id("email-help");
    help.text("We use this only for account access.");
    form_view.element(&mut help);

    web::ui::Element bio = web::ui::textarea();
    bio.name("bio");
    bio.rows(5);
    bio.cols(40);
    bio.placeholder("Tell us about yourself");
    form_view.element(&mut bio);

    web::ui::Element plan = web::ui::select();
    plan.name("plan");
    web::ui::Element starter = web::ui::option_value("starter", "Starter");
    starter.selected();
    web::ui::Element pro = web::ui::option_value("pro", "Pro");
    plan.child(&mut starter);
    plan.child(&mut pro);
    form_view.element(&mut plan);

    web::ui::Element submit = web::ui::submit_input();
    submit.value("Create account");
    form_view.element(&mut submit);

    page.child(&mut form_view);
    if (!web::write_component_route("/", "Create account", &mut page)) { return 1; }
    return 0;
}
