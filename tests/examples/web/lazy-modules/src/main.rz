namespace raz_web_lazy_modules;

import web;

fn main() -> i64 {
    if (!web::prepare_dist()) { return 1; }
    Page page = Page::new("Lazy modules");
    page.h1("Lazy modules");
    page.button_id("open-editor", "Open editor");
    if (!page.lazy_module_on_click("open-editor", "/assets/chunks/editor.mjs")) { return 2; }
    if (!page.write_route("/")) { return 3; }
    return 0;
}
