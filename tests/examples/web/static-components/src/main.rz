import web;
import web::ui;

fn hero() -> Component {
    Component section = component(Tag::Section);
    section.class_name("hero");
    section.h1("Static components in Raz");
    section.p("Reusable component trees compile to plain HTML when they have no browser behavior.");
    section.css_class("hero", "max-width: 64rem; margin: 3rem auto; padding: 2rem;");
    return move section;
}

fn main() -> i64 {
    Component home = hero();
    if (!web::write_component_route("/", "Raz Static Components", &mut home)) { return 1; }

    Component about = component(Tag::Main);
    about.h2("About");
    about.p("The same Component model can be reused by static pages and interactive applications.");
    if (!web::write_component_route_lang("/about", "About", "en-US", &mut about)) { return 1; }
    return 0;
}
