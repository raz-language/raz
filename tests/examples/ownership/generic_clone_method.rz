struct Token {
    i64 value;
}

impl Clone for Token {
    fn clone(Token& self) -> Token {
        return Token {
            value: self.value
        };
    }
}

struct Box<T> {
    T value;
}

impl<T: Clone> Clone for Box<T> {
    fn clone(Box<T>& self) -> Box<T> {
        return Box<T> {
            value: clone(self.value)
        };
    }
}

fn clone_box(Box<Token> source) -> Box<Token> {
    return clone(source);
}
