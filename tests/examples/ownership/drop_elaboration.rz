struct Resource {
    i64 handle;
}

fn normal_scope() -> i64 {
    Resource first = Resource {
        handle: 1
    };
    {
        Resource second = Resource {
            handle: 2
        };
    }
    return first.handle;
}

fn moved_value() -> i64 {
    Resource first = Resource {
        handle: 7
    };

    Resource second = move first;

    return second.handle;
}

fn reinitialized_value() -> i64 {
    Resource first = Resource {
        handle: 3
    };

    Resource second = move first;

    first = Resource {
        handle: 4
    };
    return first.handle + second.handle;
}
