struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

fn conditional(bool take) -> i64 {
    Resource value = Resource {
        handle: 7
    };
    if (take) {
        Resource moved = move value;

        moved;
    }
    return 0;
}
