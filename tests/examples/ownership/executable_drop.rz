struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

struct Wrapper {
    Resource first;
    Resource second;
}

fn main() -> i64 {
    Wrapper wrapper = Wrapper {
        first: Resource {
            handle: 1
        },
        second: Resource {
            handle: 2
        }
    };
    return wrapper.first.handle + wrapper.second.handle;
}
