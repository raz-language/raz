struct Pair {
    i64 left;
    i64 right;
}

fn invalid() {
    Pair pair = Pair {
        left: 1,
        right: 2
    };

    i64&mut first = &mut pair.left;
    i64&mut second = &mut pair.left;

    *first += *second;
}
