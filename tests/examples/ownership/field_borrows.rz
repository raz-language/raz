struct Pair {
    i64 left;
    i64 right;
}

fn update_fields() -> i64 {
    Pair pair = Pair {
        left: 1,
        right: 2
    };

    i64&mut left = &mut pair.left;
    i64&mut right = &mut pair.right;

    *left += 10;
    *right += 20;
    return pair.left + pair.right;
}

fn update_elements() -> i64 {
    i64 values[2] = [1, 2];
    i64&mut first = &mut values[0];
    i64&mut second = &mut values[1];

    *first += 10;
    *second += 20;
    return values[0] + values[1];
}
