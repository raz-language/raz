struct Token {
    i64 value;
}

impl Clone for Token {
    fn clone(Token& self) -> Token {
        return Token {
            value: self.value + 1
        };
    }
}

@derive(Clone)struct Inner {
    Token token;
}

@derive(Clone)struct Outer {
    Inner inner;

    Token[2]pair;
}

fn main() -> i64 {
    Token first = Token {
        value: 10
    };
    Token second = Token {
        value: 20
    };
    Token third = Token {
        value: 30
    };

    Inner inner;

    inner.token = move first;

    Outer original;

    original.inner = move inner;
    original.pair[0] = move second;
    original.pair[1] = move third;

    Outer copied = clone(original);

    return copied.inner.token.value + copied.pair[0].value + copied.pair[1].value;
}
