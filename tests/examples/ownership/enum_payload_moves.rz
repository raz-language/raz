struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

enum Packet {
    Empty,
    One(Resource),
    Pair(Resource, Resource),
}

fn inspect(Packet packet) -> i64 {
    match packet {
        Packet::Empty => {
            return 0;
        },
        Packet::One(value) => {
            return value.handle;
        },
        Packet::Pair(left, _) => {
            return left.handle;
        },
    }
}
