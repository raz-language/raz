fn increment(i64&mut value) -> i64 {
    *value += 1;
    return *value;
}

fn shared_read(i64& value) -> i64 {
    return *value;
}

fn main() -> i64 {
    i64 value = 40;

    {
        i64&mut edit = &mut value;

        *edit += 1;
    }

    i64& view = &value;

    return shared_read(view);
}
