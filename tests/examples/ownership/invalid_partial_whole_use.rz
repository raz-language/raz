struct Resource {
    i64 handle;
}

struct Pair {
    Resource left;
    Resource right;
}

fn invalid() -> i64 {
    Pair pair = Pair {
        left: Resource {
            handle: 1
        },
        right: Resource {
            handle: 2
        }
    };

    Resource left = move pair.left;
    Pair copy = pair;

    return left.handle + copy.right.handle;
}
