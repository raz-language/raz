struct Box {
    i64 value;
}

fn restored(bool choose_first) -> i64 {
    Box value = Box {
        value: 1
    };

    Box consumed = move value;

    if (choose_first) {
        value = Box {
            value: 2
        };
    } else {
        value = Box {
            value: 3
        };
    }
    return value.value + consumed.value;
}
