struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

struct Bundle {
    Resource first;
    Resource second;
}

async fn child() -> i64 {
    return 1;
}

async fn pipeline() -> i64 {
    Bundle bundle = Bundle {
        first: Resource {
            handle: 20
        },
        second: Resource {
            handle: 22
        }
    };

    Resource first = move bundle.first;
    i64 task = spawn child();
    i64 ready = await task;

    return first.handle + bundle.second.handle + ready;
}

fn main() -> i64 {
    return 0;
}
