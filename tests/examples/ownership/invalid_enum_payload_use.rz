struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

enum Packet {
    Empty,
    One(Resource),
}

fn invalid(Packet packet) -> i64 {
    match packet {
        Packet::Empty => {},
        Packet::One(value) => {
            value.handle;
        },
    }

    Packet copy = packet;

    return 0;
}
