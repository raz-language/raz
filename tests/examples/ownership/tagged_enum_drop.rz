struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

enum MaybeResource {
    None,
    Some(Resource),
}

fn consume(bool present) -> i64 {
    MaybeResource value = MaybeResource::None;

    if (present) {
        value = MaybeResource::Some(Resource {
            handle: 7
        }
        );
    }
    return 1;
}
