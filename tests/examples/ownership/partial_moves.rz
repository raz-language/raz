struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

struct Pair {
    Resource left;
    Resource right;
}

fn consume_left() -> i64 {
    Pair pair = Pair {
        left: Resource {
            handle: 7
        },
        right: Resource {
            handle: 9
        }
    };

    Resource left = move pair.left;
    i64 result = left.handle + pair.right.handle;

    return result;
}

fn reinitialize() -> i64 {
    Pair pair = Pair {
        left: Resource {
            handle: 1
        },
        right: Resource {
            handle: 2
        }
    };

    Resource first = move pair.left;

    pair.left = Resource {
        handle: 3
    };
    return first.handle + pair.left.handle + pair.right.handle;
}
