public struct AggregateValueInner {
  i64 value;
}

public struct AggregateValueOuter {
  AggregateValueInner inner;
}

fn aggregate_value_projection_copy() -> i64 {
  AggregateValueInner initial;
  initial.value = 17;

  AggregateValueOuter source;
  source.inner = initial;

  AggregateValueInner copy = source.inner;
  copy.value = 99;

  if (source.inner.value != 17) {
    return 41;
  }
  if (copy.value != 99) {
    return 42;
  }
  return 0;
}
