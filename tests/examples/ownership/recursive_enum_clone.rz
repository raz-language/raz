struct Token {
    i64 value;
}

impl Clone for Token {
    fn clone(Token& self) -> Token {
        return Token {
            value: self.value + 1
        };
    }
}

@derive(Clone)enum MaybeToken {
    None,
    Some(Token),
}

fn main() -> i64 {
    Token token = Token {
        value: 9
    };

    MaybeToken value = MaybeToken::Some(move token);
    MaybeToken copied = clone(value);

    match copied {
        MaybeToken::Some(item) => {
            return item.value;
        }
        MaybeToken::None => {
            return 0;
        }
    }
}
