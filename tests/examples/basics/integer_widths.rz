fn widen8(u8 value) -> u16 {
    return value;
}

fn narrow16(u16 value) -> u8 {
    return value;
}

public fn main() -> i64 {
    u8 left = 250;
    u16 right = 300;
    u8 mixed = left + right;
    u8 initialized = right;

    initialized = right;

    u16 widened = widen8(left);
    u8 narrowed = narrow16(right);

    if (mixed == 38 && initialized == 44 && widened == 250 && narrowed == 44) {
        return 42;
    }
    return 1;
}
