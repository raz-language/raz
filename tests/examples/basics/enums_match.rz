enum Status {
    Ready,
    Running = 4,
    Stopped,
}

fn code(Status status) -> i64 {
    match status {
        Status::Ready => {
            return 10;
        },
        Status::Running => {
            return 20;
        },
        Status::Stopped => {
            return 30;
        },
    }
}

fn main() -> i64 {
    Status status = Status::Running;

    return code(status);
}
