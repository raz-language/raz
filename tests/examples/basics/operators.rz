fn is_nonzero(i64 value) -> bool {
    return value != 0;
}

fn transform(i64 value, i64 shift) -> i64 {
    i64 result = value;

    result %= 17;
    result <<= shift;
    result ^= 5;
    result |= 2;
    result &= 255;
    result >>= 1;
    return ~(-result);
}

fn choose(i64 left, i64 right) -> bool {
    return is_nonzero(left) && (is_nonzero(right) || left < right);
}
