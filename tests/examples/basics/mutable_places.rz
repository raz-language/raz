fn accumulate(i64 count) -> i64 {
    i64 total = 0;
    i64 index = 0;

    while (index < count) {
        total += index;
        index += 1;
    }
    if (total > 10) {
        total = total - 1;
    }
    return total;
}

fn main() -> i64 {
    return accumulate(6);
}
