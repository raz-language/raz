fn widen(i64 value) -> f64 {
    return value as f64;
}

public fn main() -> i64 {
    f64 value = widen(40);

    value += 2.75;

    i64 truncated = value as i64;
    u32 unsigned_value = truncated as u32;
    f64 unsigned_float = unsigned_value as f64;
    u32 unsigned_roundtrip = unsigned_float as u32;
    i64 widened = unsigned_roundtrip as i64;
    f32 single = widened as f32;
    f64 double = single as f64;
    f32 narrowed = double as f32;
    f64 restored = narrowed as f64;

    return restored as i64;
}
