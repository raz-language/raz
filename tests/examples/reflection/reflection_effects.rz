struct Pair {
    i64 left;
    i64 right;
}

enum Mode {
    A,
    B,
    C,
}

const usize PAIR_SIZE = size_of<Pair>();
const usize PAIR_ALIGN = align_of<Pair>();
const usize PAIR_FIELDS = field_count<Pair>();
const usize MODE_VARIANTS = variant_count<Mode>();
comptime {
    assert(PAIR_SIZE == 16);
    assert(PAIR_ALIGN == 8);
    assert(PAIR_FIELDS == 2);
    assert(MODE_VARIANTS == 3);
}

@pure@no_alloc@deterministic fn add(i64 left, i64 right) -> i64 {
    return left + right;
}
