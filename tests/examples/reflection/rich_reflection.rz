@repr(C)struct Header {
    u8 kind;
    u32 length;
}

@derive(Copy, Clone)struct Pair {
    i64 left;
    i64 right;
}

enum Message {
    None,
    Number(i64),
}

comptime {
    assert(field_offset<Header>("kind") == 0);
    assert(field_offset<Header>("length") == 4);
    assert(field_size<Header>("length") == 4);
    assert(field_align<Header>("length") == 4);
    assert(has_attribute<Header>("repr"));
    assert(variant_discriminant<Message>("Number") == 1);
    assert(payload_offset<Message>() == 8);
    assert(is_copy<i64>());
    assert(is_clone<i64>());
    assert(!needs_drop<i64>());
}

fn main() -> i64 {
    return 0;
}
