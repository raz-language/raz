struct Value {
    i64 raw;
}

impl Value {
    @pure fn get(Value& self) -> i64 {
        return self.raw;
    }
    fn set(Value&mut self, i64 next) {
        self.raw = next;
    }
}

comptime {
    assert(method_count<Value>() == 2);
    assert(method_name<Value>(0) == "get");
    assert(method_return_type_name<Value>(0) == "i64");
    assert(method_parameter_count<Value>(1) == 2);
    assert(method_parameter_type_name<Value>(1, 1) == "i64");
    assert(method_has_attribute<Value>(0, "pure"));
}

fn main() -> i64 {
    return 0;
}
