const fn sum_until(i64 stop) -> i64 {
    i64 total = 0;
    i64 index = 0;

    while (index < stop) {
        index += 1;
        if (index == 3) {
            continue;
        }
        total += index;
        if (index == 6) {
            break;
        }
    }
    for extra in 1..=2 {
        total += extra;
    }
    return total;
}

const i64 VALUE = sum_until(10);
comptime {
    assert(VALUE == 21);
}

fn main() -> i64 {
    return VALUE;
}
