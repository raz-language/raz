struct Pair {
    i64 left;
    i64 right;
}

comptime {
    i64 values[3] = [1, 2, 3];

    values[1] += 40;
    assert(values[1] == 42);
    Pair pair = Pair {
        left: 10,
        right: 20
    };
    pair.right = values[1];
    pair.left += 5;
    assert(pair.left == 15);
    assert(pair.right == 42);
    (Pair, i64[2])nested = (pair, [7, 8]);
    nested.0.left *= 2;
    nested.1[0] += nested.0.left;
    assert(nested.0.left == 30);
    assert(nested.1[0] == 37);
}

fn main() -> i64 {
    return 0;
}
