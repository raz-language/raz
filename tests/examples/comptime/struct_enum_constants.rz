struct Point {
    i64 x;
    i64 y;
}

enum Message {
    Empty,
    Number(i64),
    Pair(i64, bool),
}

const fn point_sum(Point point) -> i64 {
    return point.x + point.y;
}

const i64 POINT_TOTAL = point_sum(Point {
    x: 20,
    y: 22
}

);
comptime {
    const Point origin = Point {
        x: 0,
        y: 0
    };
    const Point also_origin = Point {
        x: 0,
        y: 0
    };
    const Message number = Message::Number(41);
    const Message pair = Message::Pair(7, true);
    const(Point, Message)nested = (Point {
        x: 3,
        y: 4
    }, Message::Number(9));
    assert(origin.x == 0);
    assert(origin.y == 0);
    assert(origin == also_origin);
    assert(number.variant == "Number");
    assert(number.discriminant == 1);
    assert(number.0 == 41);
    assert(pair.0 == 7);
    assert(pair.1);
    assert(nested.0.x == 3);
    assert((nested.1).0 == 9);
    assert(POINT_TOTAL == 42);
}

fn result() -> i64 {
    return POINT_TOTAL;
}
