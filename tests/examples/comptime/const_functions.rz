const fn factorial(i64 value) -> i64 {
    if (value <= 1) {
        return 1;
    }
    return value * factorial(value - 1);
}

const fn select(bool first, i64 left, i64 right) -> i64 {
    if (first) {
        return left;
    }
    return right;
}

const i64 FACTORIAL_6 = factorial(6);
const i64 SELECTED = select(false, 10, 20);
comptime {
    assert(FACTORIAL_6 == 720);
    assert(SELECTED == 20);
}

fn result() -> i64 {
    return FACTORIAL_6 + SELECTED;
}
