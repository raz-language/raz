trait Storage {
    type Key;

    const CAPACITY: usize;
    @pure fn get(Self& self, i64 index) -> i64;
    fn set(Self&mut self, i64 index, i64 value);
}

comptime {
    assert(trait_method_count<Storage>() == 2);
    assert(trait_method_name<Storage>(0) == "get");
    assert(trait_method_return_type_name<Storage>(0) == "i64");
    assert(trait_method_parameter_count<Storage>(1) == 3);
    assert(trait_method_parameter_type_name<Storage>(1, 2) == "i64");
    assert(trait_method_has_attribute<Storage>(0, "pure"));
    assert(associated_type_count<Storage>() == 1);
    assert(associated_type_name<Storage>(0) == "Key");
    assert(associated_const_count<Storage>() == 1);
    assert(associated_const_name<Storage>(0) == "CAPACITY");
    assert(associated_const_type_name<Storage>(0) == "usize");
}

fn main() -> i64 {
    return 0;
}
