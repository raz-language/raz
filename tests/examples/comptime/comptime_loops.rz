comptime {
    i64 total = 0;
    i64 index = 0;

    while (index < 10) {
        index += 1;
        if (index == 3) {
            continue;
        }
        total += index;
        if (index == 6) {
            break;
        }
    }
    assert(total == 18);

    i64 range_total = 0;

    for value in 1..=5 {
        range_total += value;
    }
    assert(range_total == 15);
}

fn main() -> i64 {
    return 0;
}
