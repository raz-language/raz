unsafe fn load(i64*const pointer) -> i64 {
    return *pointer;
}

unsafe fn store(i64*mut pointer, i64 value) {
    *pointer = value;
}

fn guarded(i64*const pointer) -> i64 {
    unsafe {
        return load(pointer);
    }
}
