@pure@no_panic@no_alloc@deterministic fn leaf(i64 value) -> i64 {
    return value + 1;
}

@pure@no_panic@no_alloc@deterministic fn middle(i64 value) -> i64 {
    return leaf(value) * 2;
}

@pure@no_panic@no_alloc@deterministic fn main() -> i64 {
    return middle(20);
}
