trait Iterator {
    type Item;

    fn next(Self&mut self) -> bool;
    fn current(Self& self) -> Item;
}

struct Item {
    i64 value;
}

impl Drop for Item {
    fn drop(Item&mut self) {
        self;
    }
}

struct ItemIter {
    i64 index;
}

impl Drop for ItemIter {
    fn drop(ItemIter&mut self) {
        self;
    }
}

impl Iterator for ItemIter {
    type Item = Item;

    fn next(ItemIter&mut self) -> bool {
        if (self.index < 2) {
            self.index += 1;
            return true;
        }
        return false;
    }
    fn current(ItemIter& self) -> Item {
        return Item {
            value: self.index
        };
    }
}

fn consume() -> i64 {
    ItemIter iterator = ItemIter {
        index: 0
    };

    i64 total = 0;

    for item in iterator {
        total += item.value;
    }
    return total;
}
