trait Iterator {
    type Item;

    fn next(Self&mut self) -> bool;
    fn current(Self& self) -> Item;
}

trait IntoIterator {
    type Item;
    type IntoIter;

    fn into_iter(Self&mut self) -> IntoIter;
}

struct Counter {
    i64 value;
}

impl Iterator for Counter {
    type Item = i64;

    fn next(Counter&mut self) -> bool {
        return false;
    }
    fn current(Counter& self) -> i64 {
        return self.value;
    }
}

struct Broken {
    i64 value;
}

impl IntoIterator for Broken {
    type Item = bool;
    type IntoIter = Counter;

    fn into_iter(Broken&mut self) -> Counter {
        return Counter {
            value: self.value
        };
    }
}

fn main() {
    Broken broken = Broken {
        value: 1
    };
    for value in broken {
        value;
    }
}
