fn sum() -> i64 {
    i64 values[4] = [1, 2, 3, 4];
    i64 total = 0;

    for value in values {
        total += value;
    }
    return total;
}

fn first_even() -> i64 {
    i64 values[4] = [1, 3, 4, 8];

    for value in values {
        if (value % 2 == 0) {
            return value;
        }
    }
    return 0;
}
