trait Iterator {
    type Item;

    fn next(Self&mut self) -> bool;
    fn current(Self& self) -> Item;
}

trait IntoIterator {
    type Item;
    type IntoIter;

    fn into_iter(Self&mut self) -> IntoIter;
}

struct Counter {
    i64 current_value;
    i64 end;
}

impl Drop for Counter {
    fn drop(Counter&mut self) {
        self;
    }
}

impl Iterator for Counter {
    type Item = i64;

    fn next(Counter&mut self) -> bool {
        if (self.current_value < self.end) {
            self.current_value += 1;
            return true;
        }
        return false;
    }
    fn current(Counter& self) -> i64 {
        return self.current_value - 1;
    }
}

struct Numbers {
    i64 end;
}

impl Drop for Numbers {
    fn drop(Numbers&mut self) {
        self;
    }
}

impl IntoIterator for Numbers {
    type Item = i64;
    type IntoIter = Counter;

    fn into_iter(Numbers&mut self) -> Counter {
        return Counter {
            current_value: 0,
            end: self.end
        };
    }
}

fn sum_temporary_iterator() -> i64 {
    i64 total = 0;

    for value in Counter {
        current_value: 0,
        end: 4
    } {
        total += value;
    }
    return total;
}

fn sum_temporary_iterable() -> i64 {
    i64 total = 0;

    for value in Numbers {
        end: 4
    } {
        total += value;
    }
    return total;
}
