fn exclusive_sum(i64 limit) -> i64 {
    i64 total = 0;

    for value in 0..limit {
        total += value;
    }
    return total;
}

fn inclusive_sum() -> i64 {
    i64 total = 0;

    for value in 1..=4 {
        total += value;
    }
    return total;
}
