fn swap((i64, bool)input) -> (bool, i64) {
    return (input.1, input.0);
}

fn main() -> i64 {
    (i64, bool)pair = (7, true);
    (bool, i64)reversed = swap(pair);
    if (reversed.0) {
        return reversed.1;
    }
    return 0;
}
