struct Pair {
    i64 left;
    i64 right;
}

fn read_at(i64 index) -> i64 {
    i64 values[4] = [10, 20, 30, 40];

    return values[index];
}

fn copy_pair() -> i64 {
    Pair first = Pair {
        left: 7,
        right: 9
    };

    Pair second = first;

    second.left = 11;
    first = second;
    return first.left + first.right;
}

fn copy_array() -> i64 {
    i64 source[4] = [1, 2, 3, 4];
    i64 destination[4] = source;

    destination[2] += 10;
    source = destination;
    return source[2];
}
