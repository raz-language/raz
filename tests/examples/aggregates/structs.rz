struct Point {
    i64 x;
    i64 y;
}

fn sum(Point point) -> i64 {
    return point.x + point.y;
}

fn main() -> i64 {
    Point point = Point {
        x: 10,
        y: 20
    };
    point.x += 5;
    return point.x + point.y;
}
