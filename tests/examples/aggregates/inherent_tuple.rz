struct Point {
    i64 x;
    i64 y;
}

impl Point {
    fn origin() -> Point {
        return Point {
            x: 0,
            y: 0
        };
    }
    fn sum(Point& self) -> i64 {
        return self.x + self.y;
    }
    fn shifted(Point& self, i64 amount) -> i64 {
        return self.x + self.y + amount;
    }
}

struct Pair {
    i64 first;
    bool second;
}

struct Marker {}

fn main() -> i64 {
    Point point = Point::origin();

    Pair pair = Pair {
        first: 7,
        second: true
    };

    Marker marker = Marker {};

    marker;
    if (pair.second) {
        return point.shifted(pair.first) + point.sum();
    }
    return 0;
}
