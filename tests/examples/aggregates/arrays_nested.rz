struct Point {
    i64 x;
    i64 y;
}

struct Scene {
    Point origin;
    i64 samples[4];
}

fn evaluate(i64 index) -> i64 {
    Scene scene;

    scene.origin.x = 10;
    scene.origin.y = 20;
    scene.samples[0] = scene.origin.x;
    scene.samples[1] = scene.origin.y;
    scene.samples[index] = scene.samples[0] + scene.samples[1];
    return scene.samples[index];
}
