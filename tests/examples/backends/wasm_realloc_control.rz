extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_realloc(usize pointer, i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);

fn main() -> i64 {
    usize pointer = raz_rt_realloc(0, 32);
    if (pointer == 0) { return 1; }
    raz_rt_dealloc(pointer);
    return 0;
}
