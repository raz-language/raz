struct Point {
    i64 x;
    i64 y;
}

fn score(Point point, i64 values[4]) -> i64 {
    values[2] = point.x + point.y;
    return values[0] + values[2];
}

fn main() -> i64 {
    Point point = Point {
        x: 7,
        y: 5
    };

    i64 values[4] = [3, 4, 0, 8];

    return score(point, values);
}
