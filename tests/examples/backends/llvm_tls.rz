// TLS is represented in shared HIR/MIR. LLVM emits native thread_local storage;
// Forge currently rejects TLS rather than silently changing its semantics.
thread_local global mut i64 request_count = 0;

fn main() -> i64 {
    request_count += 1;
    return request_count;
}
