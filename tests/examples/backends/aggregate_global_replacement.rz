struct Resource {
    i64 id;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self.id;
    }
}

global mut Resource active = Resource {
    id: 1
};
global mut i64 values[3] = [10, 20, 30];

fn main() -> i64 {
    active = Resource {
        id: 7
    };
    values = [4, 5, 6];
    return active.id + values[2];
}
