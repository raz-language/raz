struct Pair {
    i64 left;
    i64 right;
}

global mut Pair pair = Pair {
    left: 1,
    right: 2
};
global mut i64 values[3] = [3, 4, 5];

fn main() -> i64 {
    pair = Pair {
        left: 8,
        right: 9
    };
    values = [10, 11, 12];
    return pair.left + pair.right + values[2];
}
