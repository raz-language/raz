extern fn raz_rt_cstr_len(string value) -> i64;
extern fn raz_rt_cstr_ptr(string value) -> usize;
extern fn raz_rt_stdio_write(i64 stream, usize data, i64 size) -> i64;

fn main() -> i64 {
    string text = "alpha\nbeta\tend";
    i64 length = raz_rt_cstr_len(text);

    if (length != 14) {
        return 1;
    }
    if (raz_rt_stdio_write(1, raz_rt_cstr_ptr(text), length) != length) {
        return 2;
    }
    return 0;
}
