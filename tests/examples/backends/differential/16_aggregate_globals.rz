struct Pair {
    i64 left;
    i64 right;
}

global mut i64 values[3] = [4, 8, 12];
global Pair pair = Pair {
    left: 2,
    right: 5
};

fn main() -> i64 {
    values[1] += pair.left;
    return values[1] + pair.right;
}
