fn add_one(i64 value) -> i64 {
    return value + 1;
}

fn apply(fn(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn make_incrementer() -> fn(i64) -> i64 {
    return fn(i64 value) -> i64 {
        return value + 1;
    };
}

fn captured_local() -> i64 {
    i64 factor = 2;

    auto scale = fn(i64 value) -> i64 {
        return value * factor;
    };
    return scale(20);
}

fn main() -> i64 {
    fn(i64) -> i64 increment = make_incrementer();

    i64 direct = apply(add_one, 19);
    i64 indirect = increment(20);

    return direct + indirect + captured_local() - 19;
}
