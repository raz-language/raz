async fn add_later(i64 left, i64 right) -> i64 {
    i64 value = left + right;

    return value;
}

async fn chained(i64 input) -> i64 {
    i64 first_future = spawn add_later(input, 2);
    i64 first = await first_future;
    i64 second_future = spawn add_later(first, 3);
    i64 second = await second_future;

    return second;
}

fn main() -> i64 {
    // Async launchers return completion-future handles. Runtime/executor code
    // may await this from another async context.

    i64 future = chained(10);

    return 0;
}
