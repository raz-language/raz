struct Quad {
    i64 a;
    i64 b;
    i64 c;
    i64 d;
}

fn main() -> i64 {
    Quad source = Quad { a: 1, b: 2, c: 3, d: 4 };
    Quad destination = source;
    return destination.a + destination.b + destination.c + destination.d;
}
