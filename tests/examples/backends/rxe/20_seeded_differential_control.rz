fn reference_control(i64 a, i64 b) -> i64 {
    i64 out = 0;
    i64 i = 0;
    while (i < 8) {
        if (((a + i) & 1) == 0) {
            out += b + i;
        } else {
            out -= a - i;
        }
        i += 1;
    }
    return out;
}

fn main() -> i64 {
    return reference_control(5, 9);
}
