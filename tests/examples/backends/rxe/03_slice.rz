fn sum(i64[] values) -> i64 {
    i64 total = 0;
    i64 i = 0;
    while (i < values.length) {
        total = total + values[i];
        i = i + 1;
    }
    return total;
}

fn main() -> i64 {
    i64 values[4] = [1, 2, 3, 4];
    return sum(values[0..4]);
}
