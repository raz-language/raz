struct Pair {
    i64 left;
    i64 right;
}

struct Config {
    Pair pair;
    i64 bias;
}

global mut i64 values[4] = [10, 20, 30, 40];
global Config config = Config {
    pair: Pair {
        left: 2,
        right: 3
    },
    bias: 5
};

fn main() -> i64 {
    values[2] += config.pair.left;
    return values[2] + config.bias;
}
