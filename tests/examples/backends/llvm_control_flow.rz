fn clamp_and_scale(i64 value, f64 scale) -> i64 {
    i64 adjusted = value;

    if (adjusted < 0) {
        adjusted = 0;
    } else if (adjusted > 100) {
        adjusted = 100;
    }

    f64 scaled = (adjusted as f64) * scale;

    return scaled as i64;
}

fn main() -> i64 {
    i64 total = 0;
    i64 i = 0;

    while (i < 4) {
        total += clamp_and_scale(i * 10, 1.5);
        i += 1;
    }
    return total;
}
