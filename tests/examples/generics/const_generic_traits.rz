struct Buffer<T, const usize N> {
    T values[N];
}

impl<T: Copy, const usize N> Copy for Buffer<T, N> {}

impl<T: Clone, const usize N> Clone for Buffer<T, N> {}

enum Packet<const usize N> {
    Empty,
    Data(i64[N]),
}

impl<const usize N> Clone for Packet<N> {}

fn copy_buffer() -> i64 {
    Buffer<i64, 4> first;
    Buffer<i64, 4> second = move first;

    second;
    return 4;
}

fn clone_packet(Packet<4> packet) -> Packet<4> {
    return clone(packet);
}
