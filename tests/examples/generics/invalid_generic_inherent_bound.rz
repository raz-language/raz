struct Resource {
    i64 id;
}

struct Box<T> {
    T value;
}

impl<T: Clone> Box<T> {
    fn marker(Box<T>& self) -> i64 {
        return 1;
    }
}

fn main() -> i64 {
    Box<Resource> box;

    box.value = Resource {
        id: 1
    };
    return box.marker();
}
