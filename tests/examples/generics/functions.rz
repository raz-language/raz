fn identity<T>(T value) -> T {
    return value;
}

fn choose<T>(T left, T right, bool first) -> T {
    if (first) {
        return left;
    }
    return right;
}

fn main() -> i64 {
    i64 answer = identity<i64>(42);

    return choose<i64>(answer, 7, true);
}
