struct Buffer<T, const usize N> {
    T values[N];
}

fn first<const usize N>(i64[N]values) -> i64 {
    return values[0];
}

fn main() -> i64 {
    Buffer<i64, 4> buffer;
    i64 values[4] = [1, 2, 3, 4];

    buffer.values = values;
    return first<4>(buffer.values);
}
