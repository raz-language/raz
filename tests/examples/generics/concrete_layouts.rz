struct Pair<T, U> {
    T first;
    U second;
}

enum Option<T> {
    None,
    Some(T),
}

enum Result<T, E> {
    Ok(T),
    Error(E),
}

fn main() {
    Pair<i64, bool> pair;
    Option<i64> optional;
    Result<i64, string> result;
}
