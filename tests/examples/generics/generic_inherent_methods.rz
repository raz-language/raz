struct Box<T> {
    T value;
}

impl<T> Box<T> {
    fn get(Box<T>& self) -> T {
        return self.value;
    }
    fn make(T value) -> Box<T> {
        Box<T> result;

        result.value = value;
        return result;
    }
}

fn main() -> i64 {
    Box<i64> box;

    box.value = 42;

    i64 a = box.get();
    Box<i64> other = Box<i64>::make(7);

    return a + other.value;
}
