struct Buffer<T, const usize N> {
    T[N]values;
}

impl<T, const usize N> Buffer<T, N> {
    fn width() -> usize {
        return N;
    }
}

fn main() -> i64 {
    usize width = Buffer<i64, 4>::width();

    return width as i64;
}
