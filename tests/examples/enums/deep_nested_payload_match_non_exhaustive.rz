enum Inner { Empty, Number(i64), }
enum Middle { Stop, Next(Inner), }
enum Outer { None, Some(Middle), }
fn evaluate(Outer value) -> i64 {
    match value {
        Outer::Some(Middle::Stop) => { return 1; }
        Outer::Some(Middle::Next(Inner::Number(number))) => { return number; }
        Outer::None => { return 0; }
    }
}
fn main() -> i64 { return evaluate(Outer::None); }
