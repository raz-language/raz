struct Header {
    i64 kind;
}

enum Packet {
    Message(Header),
}

fn main() -> i64 {
    Packet packet = Packet::Message(Header { kind: 42 });
    match packet {
        Packet::Message(ref header) => { }
    }
    match packet {
        Packet::Message(Header { kind }) => { return kind; }
    }
}
