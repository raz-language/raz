enum Inner {
    Empty,
    Number(i64),
}

enum Outer {
    Some(Inner),
}

fn main() -> i64 {
    Outer value = Outer::Some(Inner::Number(42));

    match value {
        Outer::Some(inner) => {
            return 1;
        }
        Outer::Some(Inner::Number(number)) => {
            return number;
        }
    }
}
