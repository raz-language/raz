struct Pair {
    i64 left;
    i64 right;
}

enum MaybePair {
    None,
    Some(Pair),
}

fn make_pair() -> MaybePair {
    return MaybePair::Some(Pair {
        left: 7,
        right: 9,
    });
}

fn main() -> i64 {
    MaybePair value = make_pair();
    match value {
        MaybePair::Some(pair) => {
            return pair.left + pair.right;
        }
        MaybePair::None => {
            return 1;
        }
    }
}
