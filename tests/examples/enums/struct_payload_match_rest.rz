struct Header {
    i64 kind;
    i64 length;
    i64 flags;
}

enum Packet {
    Message(Header),
}

fn main() -> i64 {
    Packet packet = Packet::Message(Header { kind: 42, length: 9, flags: 3 });
    match packet {
        Packet::Message(Header { kind, .. }) => { return kind; }
    }
}
