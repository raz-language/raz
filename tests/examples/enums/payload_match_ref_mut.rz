enum Value {
    None,
    Number(i64),
}

fn main() -> i64 {
    Value value = Value::Number(7);
    match value {
        Value::Number(ref mut number) => {
            *number = 42;
        }
        Value::None => { return 0; }
    }
    match value {
        Value::Number(number) => { return number; }
        Value::None => { return 0; }
    }
}
