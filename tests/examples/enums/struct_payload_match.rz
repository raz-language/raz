struct Header {
    i64 kind;
    i64 length;
}

enum Packet {
    Empty,
    Message(Header, i64),
}

fn evaluate(Packet packet) -> i64 {
    match packet {
        Packet::Empty => { return 0; }
        Packet::Message(Header { kind, length }, body) => {
            return kind + length + body;
        }
    }
}

fn main() -> i64 {
    Header header = Header { kind: 7, length: 30 };
    return evaluate(Packet::Message(header, 5));
}
