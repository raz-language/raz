enum Inner {
    Empty,
    Number(i64),
    Flag(bool),
}

enum Outer {
    None,
    Some(Inner),
}

fn evaluate(Outer value) -> i64 {
    match value {
        Outer::Some(Inner::Number(number)) => {
            return number;
        }
        Outer::Some(Inner::Flag(enabled)) => {
            if (enabled) {
                return 7;
            }
            return 3;
        }
        Outer::Some(Inner::Empty) => {
            return 1;
        }
        Outer::None => {
            return 0;
        }
        _ => {
            return -1;
        }
    }
}

fn main() -> i64 {
    Outer number = Outer::Some(Inner::Number(42));
    Outer flag = Outer::Some(Inner::Flag(true));
    return evaluate(number) + evaluate(flag);
}
