struct Header {
    i64 kind;
    i64 length;
}

enum Packet {
    Message(Header),
}

fn main() -> i64 {
    Packet packet = Packet::Message(Header { kind: 40, length: 2 });
    match packet {
        Packet::Message(Header { ref kind, ref length }) => {
            return *kind + *length;
        }
    }
}
