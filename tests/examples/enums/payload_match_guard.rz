enum Value {
    None,
    Number(i64),
}

fn evaluate(Value value) -> i64 {
    match value {
        Value::Number(number) if number > 40 => { return number; }
        Value::Number(number) => { return number + 100; }
        Value::None => { return 0; }
    }
}

fn main() -> i64 {
    return evaluate(Value::Number(42));
}
