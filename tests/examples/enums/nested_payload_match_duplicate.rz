enum Inner {
    Number(i64),
}

enum Outer {
    Some(Inner),
}

fn main() -> i64 {
    Outer value = Outer::Some(Inner::Number(42));
    match value {
        Outer::Some(Inner::Number(first)) => {
            return first;
        }
        Outer::Some(Inner::Number(second)) => {
            return second;
        }
        _ => {
            return 0;
        }
    }
}
