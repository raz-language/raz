enum Message {
    Quit,
    Number(i64),
    Pair(i64, bool),
}

fn evaluate(Message message) -> i64 {
    match message {
        Message::Quit => {
            return 0;
        },
        Message::Number(value) => {
            return value;
        },
        Message::Pair(left, enabled) => {
            if (enabled) {
                return left;
            }
            return 0;
        },
    }
}

fn main() -> i64 {
    Message message = Message::Number(42);
    Message copied = message;

    return evaluate(copied);
}
