enum Pairish {
    Empty,
    Triple(i64, i64, i64),
}

fn evaluate(Pairish value) -> i64 {
    match value {
        Pairish::Triple(first, ..) => { return first; }
        Pairish::Empty => { return 0; }
    }
}

fn main() -> i64 {
    return evaluate(Pairish::Triple(42, 7, 9));
}
