enum Value {
    None,
    Number(i64),
}

fn main() -> i64 {
    Value value = Value::Number(42);
    match value {
        Value::Number(ref number) if *number == 42 => { return *number; }
        Value::Number(ref number) => { return *number + 1; }
        Value::None => { return 0; }
    }
}
