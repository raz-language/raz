struct Header {
    i64 kind;
    i64 length;
}

enum Packet {
    Message(Header),
}

fn main() -> i64 {
    Packet packet = Packet::Message(Header { kind: 7, length: 9 });
    match packet {
        Packet::Message(Header { kind: ref mut kind, .. }) => {
            *kind = 42;
        }
    }
    match packet {
        Packet::Message(Header { kind, .. }) => { return kind; }
    }
}
