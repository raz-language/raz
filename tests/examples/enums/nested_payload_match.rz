enum Inner {
    Empty,
    Number(i64),
}

enum Outer {
    None,
    Some(Inner),
}

fn main() -> i64 {
    Outer value = Outer::Some(Inner::Number(42));
    match value {
        Outer::Some(Inner::Number(number)) => {
            return number;
        }
        _ => {
            return 0;
        }
    }
}
