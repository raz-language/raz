enum Value {
    A(i64),
    B(i64),
}

fn main() -> i64 {
    Value value = Value::B(42);
    match value {
        _ if false => { return 1; }
        Value::A(number) => { return number + 1; }
        Value::B(number) => { return number; }
    }
}
