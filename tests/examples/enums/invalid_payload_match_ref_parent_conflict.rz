enum Pair {
    Both(i64, i64),
}

fn main() -> i64 {
    Pair pair = Pair::Both(1, 2);
    match pair {
        Pair::Both(ref mut left, _) => {
            pair = Pair::Both(20, 22);
            return *left;
        }
    }
}
