enum Mode {
    A(i64),
    B(i64),
}

struct Header {
    Mode mode;
    i64 length;
}

enum Packet {
    Message(Header),
}

fn evaluate(Packet packet) -> i64 {
    match packet {
        Packet::Message(Header { mode: Mode::A(value), .. }) => { return value; }
        Packet::Message(Header { mode: Mode::B(value), .. }) => { return value + 1; }
    }
}

fn main() -> i64 {
    Header header = Header { mode: Mode::B(41), length: 7 };
    return evaluate(Packet::Message(header));
}
