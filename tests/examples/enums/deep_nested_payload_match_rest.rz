enum Inner {
    Empty,
    Triple(i64, i64, i64),
}

enum Middle {
    Stop,
    Next(Inner),
}

enum Outer {
    None,
    Some(Middle),
}

fn evaluate(Outer value) -> i64 {
    match value {
        Outer::Some(Middle::Stop) => { return 1; }
        Outer::Some(Middle::Next(Inner::Empty)) => { return 2; }
        Outer::Some(Middle::Next(Inner::Triple(first, ..))) => { return first; }
        Outer::None => { return 0; }
    }
}

fn main() -> i64 {
    return evaluate(Outer::Some(Middle::Next(Inner::Triple(42, 7, 9))));
}
