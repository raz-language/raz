enum Inner {
    Empty,
    Number(i64),
}

enum Outer {
    None,
    Some(Inner),
}

fn evaluate(Outer value) -> i64 {
    match value {
        Outer::Some(Inner::Empty) => {
            return 1;
        }
        Outer::Some(Inner::Number(number)) => {
            return number;
        }
        Outer::None => {
            return 0;
        }
    }
}

fn main() -> i64 {
    return evaluate(Outer::Some(Inner::Number(42)));
}
