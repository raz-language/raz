enum Pair {
    Both(i64, i64),
}

fn main() -> i64 {
    Pair pair = Pair::Both(1, 2);
    match pair {
        Pair::Both(ref mut left, ref mut right) => {
            *left = 20;
            *right = 22;
        }
    }
    match pair {
        Pair::Both(left, right) => { return left + right; }
    }
}
