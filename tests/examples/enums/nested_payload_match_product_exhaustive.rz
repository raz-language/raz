enum Left {
    A,
    B,
}

enum Right {
    X,
    Y,
}

enum Pair {
    Values(Left, Right),
}

fn evaluate(Pair value) -> i64 {
    match value {
        Pair::Values(Left::A, Right::X) => {
            return 1;
        }
        Pair::Values(Left::A, Right::Y) => {
            return 2;
        }
        Pair::Values(Left::B, Right::X) => {
            return 3;
        }
        Pair::Values(Left::B, Right::Y) => {
            return 4;
        }
    }
}

fn main() -> i64 {
    return evaluate(Pair::Values(Left::B, Right::Y));
}
