fn add_one(i64 value) -> i64 {
    return value + 1;
}

fn main() -> i64 {
    i64 total = 0;

    total += add_one(1);
    total += add_one(2);
    total += add_one(3);
    total += add_one(4);
    total += add_one(5);
    total += add_one(6);
    total += add_one(7);
    total += add_one(8);
    if (total != 44) {
        return 1;
    }
    return 0;
}
