trait Stepper {
    fn step(Self& self) -> i64;
}

struct Counter {
    i64 value;
}

impl Stepper for Counter {
    fn step(Counter& self) -> i64 {
        return self.value + 1;
    }
}

fn main() -> i64 {
    Counter c = Counter {
        value: 41
    };

    i64 total = 0;

    total += c.step();
    total += c.step();
    total += c.step();
    total += c.step();
    total += c.step();
    total += c.step();
    total += c.step();
    total += c.step();
    return total - 294;
}
