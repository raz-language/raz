trait IteratorInfo {
    type Item;
}

struct Counter {
    i64 value;
}

impl IteratorInfo for Counter {
    type Item = i64;
}

struct Wrap<T> {
    T value;
}

fn unwrap<T: IteratorInfo>(Wrap<T::IteratorInfo::Item> value) -> T::IteratorInfo::Item {
    return value.value;
}

fn main() -> i64 {
    Wrap<i64> value = Wrap<i64> {
        value: 42,
    };
    return unwrap<Counter>(value);
}
