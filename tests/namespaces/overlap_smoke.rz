namespace alpha::storage {
    fn answer() -> i64 {
        return 41;
    }
}

namespace beta::storage {
    fn answer() -> i64 {
        return 99;
    }
}

namespace application {
    import alpha::storage;
    fn compute() -> i64 {
        return answer() + 1;
    }
}

fn main() -> i64 {
    return application::compute() - 42;
}
