fn first_address(u8& value) -> usize {
    return value as usize;
}

fn array_address() -> usize {
    u8 bytes[4];
    return &bytes[0]as usize;
}

fn main() -> i64 {
    u8 value = 7;
    usize a = first_address(&value);
    usize b = array_address();
    if (a == 0 || b == 0) {
        return 1;
    }
    return 0;
}
