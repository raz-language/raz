namespace early_return_move_join;

struct Owned {
    i64 value;
}

fn consume(Owned value) -> i64 {
    return value.value;
}

fn touch(Owned&mut value) {
    value.value += 1;
}

fn choose(bool fail) -> Owned {
    Owned value = Owned { value: 41 };
    if (fail) {
        Owned fallback = Owned { value: 0 };
        return move fallback;
    }
    touch(&mut value);
    return move value;
}

fn main() -> i64 {
    Owned value = choose(false);
    return consume(move value);
}
