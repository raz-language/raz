root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,in}]
indent_style = space
indent_size = 4

[*.{cmake,json,yml,yaml,md,fir}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
