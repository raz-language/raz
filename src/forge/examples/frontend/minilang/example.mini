// MiniLang is intentionally tiny: every value is a signed 64-bit integer.
// This example demonstrates functions, calls, locals, precedence, and branches.

fn square(value) {
    return value * value;
}

fn classify(value) {
    if value < 10 {
        let adjusted = square(value) + 1;
        return adjusted;
    } else {
        let doubled = value * 2;
        return doubled + 3;
    }
}

fn main() {
    let input = 7;
    return classify(input);
}
