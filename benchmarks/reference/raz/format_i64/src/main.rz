import alloc::string;
import std::fmt;
import std::io::stdio;
import std::time;

fn main() -> i64 {
    String scratch = alloc::string::with_capacity(64);
    i64 n = 500000;
    i64 start = std::time::monotonic_nanos();
    i64 i = 0;
    i64 checksum = 0;
    while (i < n) {
        alloc::string::clear(&mut scratch);
        if (!std::fmt::append_i64(&mut scratch, i * 1000003 - 17)) { return 1; }
        checksum += alloc::string::len(&scratch);
        i += 1;
    }
    i64 elapsed = std::time::monotonic_nanos() - start;
    String out = alloc::string::with_capacity(64);
    if (!std::fmt::append_i64(&mut out, elapsed)) { return 2; }
    if (!alloc::string::push_byte(&mut out, 32)) { return 2; }
    if (!std::fmt::append_i64(&mut out, checksum)) { return 2; }
    if (!alloc::string::push_byte(&mut out, 10)) { return 2; }
    if (!std::io::stdio::write_stdout(alloc::string::data_ptr(&out), alloc::string::len(&out))) { return 3; }
    return 0;
}
