import alloc::string;
import core::bytes;
import std::encoding::checksum;
import std::fmt;
import std::io::stdio;
import std::time;
fn main() -> i64 {
    i64 size = 67108864;
    String storage = alloc::string::with_capacity(size);
    usize p = alloc::string::data_ptr(&storage);
    if (p == 0) { return 1; }
    core::bytes::zero(p, size);
    i64 start = std::time::monotonic_nanos();
    u32 value = 0 as u32;
    i64 i = 0;
    while (i < 1) { value = std::encoding::checksum::crc32(p, size); i += 1; }
    i64 elapsed = std::time::monotonic_nanos() - start;
    String out = alloc::string::with_capacity(64);
    if (!std::fmt::append_i64(&mut out, elapsed)) { return 2; }
    if (!alloc::string::push_byte(&mut out, 32)) { return 2; }
    if (!std::fmt::append_i64(&mut out, value as i64)) { return 2; }
    if (!alloc::string::push_byte(&mut out, 10)) { return 2; }
    if (!std::io::stdio::write_stdout(alloc::string::data_ptr(&out), alloc::string::len(&out))) { return 3; }
    return 0;
}
