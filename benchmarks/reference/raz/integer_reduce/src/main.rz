import alloc::string;
import std::fmt;
import std::io::stdio;
import std::time;

fn main() -> i64 {
    i64 n = 20000000;
    i64 start = std::time::monotonic_nanos();
    i64 i = 0;
    i64 sum = 0;
    while (i < n) {
        sum += (i * 17 + 3) % 1009;
        i += 1;
    }
    i64 elapsed = std::time::monotonic_nanos() - start;
    String out = alloc::string::with_capacity(64);
    if (!std::fmt::append_i64(&mut out, elapsed)) { return 1; }
    if (!alloc::string::push_byte(&mut out, 32)) { return 1; }
    if (!std::fmt::append_i64(&mut out, sum)) { return 1; }
    if (!alloc::string::push_byte(&mut out, 10)) { return 1; }
    if (!std::io::stdio::write_stdout(alloc::string::data_ptr(&out), alloc::string::len(&out))) { return 2; }
    return 0;
}
