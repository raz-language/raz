namespace alloc::box;

extern fn raz_rt_alloc(i64 size) -> usize;
extern fn raz_rt_dealloc(usize pointer);
extern fn raz_rt_alloc_aligned(i64 size, i64 alignment) -> usize;
extern fn raz_rt_dealloc_aligned(usize pointer, i64 alignment);
extern fn raz_rt_fill(usize destination, i64 value, i64 size);

public fn allocate(i64 size) -> usize {
    return raz_rt_alloc(size);
}

public fn deallocate(usize pointer) {
    raz_rt_dealloc(pointer);
}

public fn allocate_aligned(i64 size, i64 alignment) -> usize {
    return raz_rt_alloc_aligned(size, alignment);
}

public fn deallocate_aligned(usize pointer, i64 alignment) {
    raz_rt_dealloc_aligned(pointer, alignment);
}

/// Allocate byte storage and initialize every byte to zero.
public fn allocate_zeroed(i64 size) -> usize {
    if (size <= 0) {
        return 0;
    }
    usize pointer = raz_rt_alloc(size);

    if (pointer != 0) {
        raz_rt_fill(pointer, 0, size);
    }
    return pointer;
}

/// Allocate aligned byte storage and initialize every byte to zero.
public fn allocate_zeroed_aligned(i64 size, i64 alignment) -> usize {
    if (size <= 0) {
        return 0;
    }
    usize pointer = raz_rt_alloc_aligned(size, alignment);

    if (pointer != 0) {
        raz_rt_fill(pointer, 0, size);
    }
    return pointer;
}

/// Allocate one inline object using the compiler-specialized layout of T.
public fn allocate_type<T>() -> usize {
    return raz_rt_alloc_aligned(size_of<T>()as i64, align_of<T>()as i64);
}

/// Allocate contiguous inline storage for count T values. Returns zero for an
/// invalid count or if the byte count cannot be represented by i64.
public fn allocate_array<T>(i64 count) -> usize {
    i64 size = size_of<T>()as i64;

    if (count <= 0 || size <= 0 || size > 9223372036854775807 / count) {
        return 0;
    }
    return raz_rt_alloc_aligned(size * count, align_of<T>()as i64);
}

public fn deallocate_type<T>(usize pointer) {
    raz_rt_dealloc_aligned(pointer, align_of<T>()as i64);
}

/// Allocate zero-initialized contiguous inline storage for count T values.
public fn allocate_zeroed_array<T>(i64 count) -> usize {
    i64 size = size_of<T>()as i64;

    if (count <= 0 || size <= 0 || size > 9223372036854775807 / count) {
        return 0;
    }
    i64 bytes = size * count;
    usize pointer = raz_rt_alloc_aligned(bytes, align_of<T>()as i64);

    if (pointer != 0) {
        raz_rt_fill(pointer, 0, bytes);
    }
    return pointer;
}
