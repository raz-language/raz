namespace alloc::string::hash;
import core::hash;
import alloc::string;

impl Hash for String {
    fn hash(String& self) -> i64 {
        u64 hash = ((-3750763034362895579)as u64);
        i64 index = 0;

        while (index < self.length) {
            unsafe {
                u8 byte = *((self.data + index)as u8*const);

                hash ^= byte as u64;
            }
            hash *= 1099511628211;
            index += 1;
        }
        hash ^= hash >> 33;
        hash *= ((-4417276706812531889)as u64);
        hash ^= hash >> 29;
        return (hash & 9223372036854775807)as i64;
    }
}

impl Eq for String {
    fn equals(String& self, String& other) -> bool {
        if (self.length != other.length) {
            return false;
        }
        return raz_rt_bytes_equal(self.data, other.data, self.length) == 1;
    }
}
