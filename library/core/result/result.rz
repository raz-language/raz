namespace core::result;

extern fn raz_rt_abort();


/// Recoverable result with success and error payloads.
public enum Result<T, E> {
    Ok(T),
    Error(E),
}

impl<T, E> Result<T, E> {
    fn is_ok(Result<T, E>& self) -> bool {
        match*self {
            Result<T, E>::Ok(_) => {
                return true;
            }
            Result<T, E>::Error(_) => {
                return false;
            }
        }
    }
    fn is_error(Result<T, E>& self) -> bool {
        return !self.is_ok();
    }
    /// Consumes the value and returns its contained payload.
    /// A missing/error payload is a programmer error and traps deterministically.
    fn unwrap(Result<T, E> self) -> T {
        match self {
            Result<T, E>::Ok(value) => {
                return value;
            }
            Result<T, E>::Error(_) => {
                raz_rt_abort();
            }
        }
    }
    /// Consumes the result and returns its success payload or the supplied fallback.
    fn unwrap_or(Result<T, E> self, T fallback) -> T {
        match self {
            Result<T, E>::Ok(value) => {
                return value;
            }
            Result<T, E>::Error(_) => {
                return fallback;
            }
        }
    }
    /// Keeps this success value or returns the supplied alternate result.
    fn or(Result<T, E> self, Result<T, E> fallback) -> Result<T, E> {
        match self {
            Result<T, E>::Ok(value) => {
                return Result<T, E>::Ok(move value);
            }
            Result<T, E>::Error(_) => {
                return fallback;
            }
        }
    }
}
