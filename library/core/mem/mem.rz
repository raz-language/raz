namespace core::mem;
// Small, allocation-free memory helpers. Bulk operations map directly to the
// platform runtime so callers do not pay for byte-at-a-time loops in Raz code.
extern fn raz_rt_copy(usize destination, usize source, i64 size);
extern fn raz_rt_move(usize destination, usize source, i64 size);
extern fn raz_rt_fill(usize destination, i64 value, i64 size);

public fn min_i64(i64 left, i64 right) -> i64 {
    if (left < right) {
        return left;
    }
    return right;
}

public fn max_i64(i64 left, i64 right) -> i64 {
    if (left > right) {
        return left;
    }
    return right;
}

public fn clamp_i64(i64 value, i64 low, i64 high) -> i64 {
    return min_i64(max_i64(value, low), high);
}

public fn copy_bytes(usize destination, usize source, i64 size) {
    if (size > 0) {
        raz_rt_copy(destination, source, size);
    }
}

public fn move_bytes(usize destination, usize source, i64 size) {
    if (size > 0) {
        raz_rt_move(destination, source, size);
    }
}

public fn fill_bytes(usize destination, i64 value, i64 size) {
    if (size > 0) {
        raz_rt_fill(destination, value, size);
    }
}

/// Runtime layout descriptor backed by the compiler's concrete generic layout.
/// `layout_of<T>()` is specialized with the same size/alignment information
/// used by aggregate lowering and the typed collection allocation layer.
public struct Layout {
    i64 size;
    i64 alignment;
}

public fn layout_of<T>() -> Layout {
    return Layout {
        size: size_of<T>()as i64,
        alignment: align_of<T>()as i64
    };
}

public fn layout_is_valid(Layout& layout) -> bool {
    if (layout.size <= 0 || layout.alignment <= 0 || layout.alignment > 4096) {
        return false;
    }
    return (layout.alignment & (layout.alignment - 1)) == 0;
}

public fn layout_array_bytes(Layout& layout, i64 count) -> i64 {
    if (!layout_is_valid(layout) || count < 0) {
        return -1;
    }
    if (count != 0 && layout.size > 9223372036854775807 / count) {
        return -1;
    }
    return layout.size * count;
}
