namespace core::simd;


// Portable fixed-width SIMD operation boundary. The runtime dispatches to the
// best host implementation; vectors remain ordinary fixed arrays in Raz.
extern fn raz_rt_i64x4_add(i64*const lhs, i64*const rhs, i64*mut output);
extern fn raz_rt_i64x4_sub(i64*const lhs, i64*const rhs, i64*mut output);
extern fn raz_rt_i64x4_mul(i64*const lhs, i64*const rhs, i64*mut output);
extern fn raz_rt_f64x2_add(f64*const lhs, f64*const rhs, f64*mut output);
extern fn raz_rt_f64x2_mul(f64*const lhs, f64*const rhs, f64*mut output);
extern fn raz_rt_i64x4_min(i64*const lhs, i64*const rhs, i64*mut output);
extern fn raz_rt_i64x4_max(i64*const lhs, i64*const rhs, i64*mut output);
extern fn raz_rt_i64x4_equal(i64*const lhs, i64*const rhs, i64*mut output);
extern fn raz_rt_i64x4_reduce_add(i64*const value) -> i64;
extern fn raz_rt_f64x2_sub(f64*const lhs, f64*const rhs, f64*mut output);
extern fn raz_rt_f64x2_div(f64*const lhs, f64*const rhs, f64*mut output);
extern fn raz_rt_f64x2_min(f64*const lhs, f64*const rhs, f64*mut output);
extern fn raz_rt_f64x2_max(f64*const lhs, f64*const rhs, f64*mut output);
extern fn raz_rt_f64x2_reduce_add(f64*const value) -> f64;

// Four-lane 32-bit integer vectors. Mask-producing operations write -1 for true
// and 0 for false in each lane, matching the existing i64x4 mask convention.
extern fn raz_rt_i32x4_add(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_sub(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_mul(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_min(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_max(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_equal(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_splat(i32 value, i32*mut output);
extern fn raz_rt_i32x4_neg(i32*const value, i32*mut output);
extern fn raz_rt_i32x4_reduce_add(i32*const value) -> i32;
extern fn raz_rt_i32x4_all_true(i32*const value) -> i32;
extern fn raz_rt_i32x4_bitmask(i32*const value) -> i32;

// Four-lane IEEE-754 single-precision vectors.
extern fn raz_rt_f32x4_add(f32*const lhs, f32*const rhs, f32*mut output);
extern fn raz_rt_f32x4_sub(f32*const lhs, f32*const rhs, f32*mut output);
extern fn raz_rt_f32x4_mul(f32*const lhs, f32*const rhs, f32*mut output);
extern fn raz_rt_f32x4_div(f32*const lhs, f32*const rhs, f32*mut output);
extern fn raz_rt_f32x4_min(f32*const lhs, f32*const rhs, f32*mut output);
extern fn raz_rt_f32x4_max(f32*const lhs, f32*const rhs, f32*mut output);
extern fn raz_rt_f32x4_equal(f32*const lhs, f32*const rhs, i32*mut output);
extern fn raz_rt_f32x4_splat(f32 value, f32*mut output);
extern fn raz_rt_f32x4_abs(f32*const value, f32*mut output);
extern fn raz_rt_f32x4_neg(f32*const value, f32*mut output);
extern fn raz_rt_f32x4_sqrt(f32*const value, f32*mut output);
extern fn raz_rt_f32x4_reduce_add(f32*const value) -> f32;

// Comparison and bitwise primitives useful for vector masks and branchless code.
extern fn raz_rt_i32x4_less(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_greater(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_and(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_or(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_xor(i32*const lhs, i32*const rhs, i32*mut output);
extern fn raz_rt_i32x4_not(i32*const value, i32*mut output);
extern fn raz_rt_f32x4_less(f32*const lhs, f32*const rhs, i32*mut output);
extern fn raz_rt_f32x4_greater(f32*const lhs, f32*const rhs, i32*mut output);
extern fn raz_rt_f32x4_ceil(f32*const value, f32*mut output);
extern fn raz_rt_f32x4_floor(f32*const value, f32*mut output);
extern fn raz_rt_f32x4_trunc(f32*const value, f32*mut output);
extern fn raz_rt_f32x4_nearest(f32*const value, f32*mut output);
extern fn raz_rt_f32x4_from_i32x4(i32*const value, f32*mut output);
extern fn raz_rt_i32x4_from_f32x4_sat(f32*const value, i32*mut output);

// Byte vectors expose the operations that are especially useful for parsers,
// scanners, hashing and compact mask construction.
extern fn raz_rt_i8x16_swizzle(u8*const value, u8*const indices, u8*mut output);
extern fn raz_rt_i8x16_splat(u8 value, u8*mut output);
extern fn raz_rt_i8x16_bitmask(u8*const value) -> i32;
extern fn raz_rt_i8x16_any_true(u8*const value) -> i32;

// Signed 8-bit and 16-bit vector arithmetic. Shift counts are scalar and use
// WebAssembly-style masked lane shifts on WASM; native runtime parity follows
// the same effective lane-width masking.
extern fn raz_rt_i8x16_add(i8*const lhs, i8*const rhs, i8*mut output);
extern fn raz_rt_i8x16_sub(i8*const lhs, i8*const rhs, i8*mut output);
extern fn raz_rt_i8x16_min(i8*const lhs, i8*const rhs, i8*mut output);
extern fn raz_rt_i8x16_max(i8*const lhs, i8*const rhs, i8*mut output);
extern fn raz_rt_i8x16_equal(i8*const lhs, i8*const rhs, i8*mut output);
extern fn raz_rt_i8x16_all_true(i8*const value) -> i32;
extern fn raz_rt_i8x16_shl(i8*const value, i32 count, i8*mut output);
extern fn raz_rt_i8x16_shr_s(i8*const value, i32 count, i8*mut output);
extern fn raz_rt_i8x16_shr_u(u8*const value, i32 count, u8*mut output);

extern fn raz_rt_i16x8_add(i16*const lhs, i16*const rhs, i16*mut output);
extern fn raz_rt_i16x8_sub(i16*const lhs, i16*const rhs, i16*mut output);
extern fn raz_rt_i16x8_mul(i16*const lhs, i16*const rhs, i16*mut output);
extern fn raz_rt_i16x8_min(i16*const lhs, i16*const rhs, i16*mut output);
extern fn raz_rt_i16x8_max(i16*const lhs, i16*const rhs, i16*mut output);
extern fn raz_rt_i16x8_equal(i16*const lhs, i16*const rhs, i16*mut output);
extern fn raz_rt_i16x8_splat(i16 value, i16*mut output);
extern fn raz_rt_i16x8_all_true(i16*const value) -> i32;
extern fn raz_rt_i16x8_bitmask(i16*const value) -> i32;
extern fn raz_rt_i16x8_shl(i16*const value, i32 count, i16*mut output);
extern fn raz_rt_i16x8_shr_s(i16*const value, i32 count, i16*mut output);
extern fn raz_rt_i16x8_shr_u(u16*const value, i32 count, u16*mut output);

extern fn raz_rt_i32x4_shl(i32*const value, i32 count, i32*mut output);
extern fn raz_rt_i32x4_shr_s(i32*const value, i32 count, i32*mut output);
extern fn raz_rt_i32x4_shr_u(u32*const value, i32 count, u32*mut output);
