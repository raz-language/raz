namespace core::callable;

trait Fn<Input> {
    type Output;

    fn call(Self& self, Input input) -> Output;
}

trait FnMut<Input> {
    type Output;

    fn call_mut(Self&mut self, Input input) -> Output;
}

trait FnOnce<Input> {
    type Output;

    fn call_once(Self self, Input input) -> Output;
}
