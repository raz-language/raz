namespace core::callable::weak;
// Weak handles for shared callable environments. Weak handles do not keep the
// capture environment alive and can be upgraded only while a strong owner exists.
extern fn raz_rt_callable_weak_create(i8*mut callable) -> i8*mut;
extern fn raz_rt_callable_weak_upgrade(i8*mut weak) -> i8*mut;
extern fn raz_rt_callable_weak_expired(i8*mut weak) -> i32;
extern fn raz_rt_callable_weak_destroy(i8*mut weak);

public fn callable_weak_create(i8*mut callable) -> i8*mut {
    return raz_rt_callable_weak_create(callable);
}

public fn callable_weak_upgrade(i8*mut weak) -> i8*mut {
    return raz_rt_callable_weak_upgrade(weak);
}

public fn callable_weak_expired(i8*mut weak) -> bool {
    return raz_rt_callable_weak_expired(weak) == 1;
}

public fn callable_weak_destroy(i8*mut weak) {
    raz_rt_callable_weak_destroy(weak);
}
