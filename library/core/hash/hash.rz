namespace core::hash;


// Hash and Eq form the key contract used by Raz hash collections. Hash values
// are deliberately stable only within a process/library version; callers must
// never persist bucket positions.
public trait Hash {
    fn hash(Self& self) -> i64;
}

public trait Eq {
    fn equals(Self& self, Self& other) -> bool;
}

fn mix_u64(u64 input) -> i64 {
    // One-multiply integer avalanche. Hash-table probe masking removed integer
    // division from the lookup loop, so keep primitive hashing equally cheap.

    u64 value = input;

    value ^= value >> 30;
    value *= 6364136223846793005;
    value ^= value >> 27;
    return (value & 9223372036854775807)as i64;
}

impl Hash for i64 {
    fn hash(i64& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for i64 {
    fn equals(i64& self, i64& other) -> bool {
        return *self == *other;
    }
}

impl Hash for u64 {
    fn hash(u64& self) -> i64 {
        return mix_u64(*self);
    }
}

impl Eq for u64 {
    fn equals(u64& self, u64& other) -> bool {
        return *self == *other;
    }
}

impl Hash for usize {
    fn hash(usize& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for usize {
    fn equals(usize& self, usize& other) -> bool {
        return *self == *other;
    }
}

impl Hash for i32 {
    fn hash(i32& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for i32 {
    fn equals(i32& self, i32& other) -> bool {
        return *self == *other;
    }
}

impl Hash for u32 {
    fn hash(u32& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for u32 {
    fn equals(u32& self, u32& other) -> bool {
        return *self == *other;
    }
}

impl Hash for i16 {
    fn hash(i16& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for i16 {
    fn equals(i16& self, i16& other) -> bool {
        return *self == *other;
    }
}

impl Hash for u16 {
    fn hash(u16& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for u16 {
    fn equals(u16& self, u16& other) -> bool {
        return *self == *other;
    }
}

impl Hash for i8 {
    fn hash(i8& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for i8 {
    fn equals(i8& self, i8& other) -> bool {
        return *self == *other;
    }
}

impl Hash for u8 {
    fn hash(u8& self) -> i64 {
        return mix_u64((*self)as u64);
    }
}

impl Eq for u8 {
    fn equals(u8& self, u8& other) -> bool {
        return *self == *other;
    }
}

impl Hash for bool {
    fn hash(bool& self) -> i64 {
        if (*self) {
            return mix_u64(1);
        }
        return mix_u64(0);
    }
}

impl Eq for bool {
    fn equals(bool& self, bool& other) -> bool {
        return *self == *other;
    }
}
