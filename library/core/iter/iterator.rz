namespace core::iter::iterator;

public trait Iterator {
    type Item;

    fn next(Self&mut self) -> bool;
    fn current(Self& self) -> Item;
}

public trait IntoIterator {
    type Item;
    type IntoIter;

    fn into_iter(Self&mut self) -> IntoIter;
}
