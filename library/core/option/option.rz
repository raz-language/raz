namespace core::option;


/// Optional value with either no payload or one value.
public enum Option<T> {
    None,
    Some(T),
}

impl<T> Option<T> {
    fn is_some(Option<T>& self) -> bool {
        match*self {
            Option<T>::None => {
                return false;
            }
            Option<T>::Some(_) => {
                return true;
            }
        }
    }
    fn is_none(Option<T>& self) -> bool {
        return !self.is_some();
    }
    /// Consumes the option and returns its payload or the supplied fallback.
    fn unwrap_or(Option<T> self, T fallback) -> T {
        match self {
            Option<T>::None => {
                return fallback;
            }
            Option<T>::Some(value) => {
                return value;
            }
        }
    }
    /// Returns this option when populated, otherwise consumes the fallback.
    fn or(Option<T> self, Option<T> fallback) -> Option<T> {
        match self {
            Option<T>::None => {
                return fallback;
            }
            Option<T>::Some(value) => {
                return Option<T>::Some(move value);
            }
        }
    }
    /// Moves the previous enum value out, leaving None. Moving the whole enum
    /// avoids aliasing the payload with storage that is immediately overwritten.
    fn take(Option<T>&mut self) -> Option<T> {
        Option<T> previous = move*self;

        *self = Option<T>::None;
        return previous;
    }
    /// Replaces the option with Some(value) and returns the previous state.
    fn replace(Option<T>&mut self, T value) -> Option<T> {
        Option<T> previous = move*self;

        *self = Option<T>::Some(move value);
        return previous;
    }
}
