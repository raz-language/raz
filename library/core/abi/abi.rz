namespace core::abi;


extern fn raz_rt_abi_pointer_size() -> i64;
extern fn raz_rt_abi_pointer_alignment() -> i64;
extern fn raz_rt_abi_bool_size() -> i64;
extern fn raz_rt_abi_bool_alignment() -> i64;
extern fn raz_rt_abi_i8_size() -> i64;
extern fn raz_rt_abi_i8_alignment() -> i64;
extern fn raz_rt_abi_i16_size() -> i64;
extern fn raz_rt_abi_i16_alignment() -> i64;
extern fn raz_rt_abi_i32_size() -> i64;
extern fn raz_rt_abi_i32_alignment() -> i64;
extern fn raz_rt_abi_i64_size() -> i64;
extern fn raz_rt_abi_i64_alignment() -> i64;
extern fn raz_rt_abi_f32_size() -> i64;
extern fn raz_rt_abi_f32_alignment() -> i64;
extern fn raz_rt_abi_f64_size() -> i64;
extern fn raz_rt_abi_f64_alignment() -> i64;
extern fn raz_rt_abi_size_t_size() -> i64;
extern fn raz_rt_abi_size_t_alignment() -> i64;
extern fn raz_rt_abi_little_endian() -> i64;

public fn pointer_size() -> i64 {
    return raz_rt_abi_pointer_size();
}

public fn pointer_alignment() -> i64 {
    return raz_rt_abi_pointer_alignment();
}

public fn bool_size() -> i64 {
    return raz_rt_abi_bool_size();
}

public fn bool_alignment() -> i64 {
    return raz_rt_abi_bool_alignment();
}

public fn i8_size() -> i64 {
    return raz_rt_abi_i8_size();
}

public fn i8_alignment() -> i64 {
    return raz_rt_abi_i8_alignment();
}

public fn i16_size() -> i64 {
    return raz_rt_abi_i16_size();
}

public fn i16_alignment() -> i64 {
    return raz_rt_abi_i16_alignment();
}

public fn i32_size() -> i64 {
    return raz_rt_abi_i32_size();
}

public fn i32_alignment() -> i64 {
    return raz_rt_abi_i32_alignment();
}

public fn i64_size() -> i64 {
    return raz_rt_abi_i64_size();
}

public fn i64_alignment() -> i64 {
    return raz_rt_abi_i64_alignment();
}

public fn f32_size() -> i64 {
    return raz_rt_abi_f32_size();
}

public fn f32_alignment() -> i64 {
    return raz_rt_abi_f32_alignment();
}

public fn f64_size() -> i64 {
    return raz_rt_abi_f64_size();
}

public fn f64_alignment() -> i64 {
    return raz_rt_abi_f64_alignment();
}

public fn size_t_size() -> i64 {
    return raz_rt_abi_size_t_size();
}

public fn size_t_alignment() -> i64 {
    return raz_rt_abi_size_t_alignment();
}

public fn little_endian() -> bool {
    return raz_rt_abi_little_endian() != 0;
}
