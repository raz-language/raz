namespace core::hardware;


extern fn raz_rt_cpu_has_sse2() -> i64;
extern fn raz_rt_cpu_has_avx2() -> i64;
extern fn raz_rt_cpu_has_neon() -> i64;
extern fn raz_rt_cache_line_size() -> i64;

public fn has_sse2() -> bool {
    return raz_rt_cpu_has_sse2() == 1;
}

public fn has_avx2() -> bool {
    return raz_rt_cpu_has_avx2() == 1;
}

public fn has_neon() -> bool {
    return raz_rt_cpu_has_neon() == 1;
}

public fn cache_line_size() -> i64 {
    return raz_rt_cache_line_size();
}
