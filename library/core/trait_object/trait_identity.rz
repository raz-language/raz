namespace core::trait_object::trait_identity;


// Runtime trait identity carried by every dyn Trait handle.
// The compiler derives the identity deterministically from the canonical trait name.
extern fn raz_rt_trait_object_trait_id(i8*mut object) -> u64;
extern fn raz_rt_trait_object_is_trait(i8*mut object, u64 expected_trait_id) -> i32;

public fn trait_object_trait_id(i8*mut object) -> u64 {
    return raz_rt_trait_object_trait_id(object);
}

public fn trait_object_is_trait(i8*mut object, u64 expected_trait_id) -> bool {
    return raz_rt_trait_object_is_trait(object, expected_trait_id) != 0;
}
