namespace core::trait_object::type_identity;
// Runtime concrete-type identity and checked downcasting for dyn Trait handles.
// Type IDs are deterministic compiler-generated values attached when an object
// is constructed. A mismatched downcast returns null rather than exposing the
// receiver with the wrong static type.
extern fn raz_rt_trait_object_type_id(i8*mut object) -> u64;
extern fn raz_rt_trait_object_downcast_data(i8*mut object, u64 expected_type_id) -> i8*mut;

public fn trait_object_type_id(i8*mut object) -> u64 {
    return raz_rt_trait_object_type_id(object);
}

public fn trait_object_downcast_data(i8*mut object, u64 expected_type_id) -> i8*mut {
    return raz_rt_trait_object_downcast_data(object, expected_type_id);
}
