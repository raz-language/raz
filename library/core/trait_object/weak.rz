namespace core::trait_object::weak;


// Weak handles for shared dynamic trait objects. Weak handles break ownership
// cycles and can be upgraded only while a strong dyn Trait owner remains alive.
extern fn raz_rt_trait_object_weak_create(i8*mut object) -> i8*mut;
extern fn raz_rt_trait_object_weak_upgrade(i8*mut weak) -> i8*mut;
extern fn raz_rt_trait_object_weak_expired(i8*mut weak) -> i32;
extern fn raz_rt_trait_object_weak_destroy(i8*mut weak);

public fn trait_object_weak_create(i8*mut object) -> i8*mut {
    return raz_rt_trait_object_weak_create(object);
}

public fn trait_object_weak_upgrade(i8*mut weak) -> i8*mut {
    return raz_rt_trait_object_weak_upgrade(weak);
}

public fn trait_object_weak_expired(i8*mut weak) -> bool {
    return raz_rt_trait_object_weak_expired(weak) == 1;
}

public fn trait_object_weak_destroy(i8*mut weak) {
    raz_rt_trait_object_weak_destroy(weak);
}
