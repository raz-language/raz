namespace core::bytes;


// Allocation-free byte views and search/comparison helpers. Checked scalar
// access stays in Raz so parser/codec loops do not pay an ABI call per byte;
// bulk equality, ordering and scanning use optimized host memory primitives.
extern fn raz_rt_load_u8(usize address) -> i64;
extern fn raz_rt_store_u8(usize address, i64 value) -> i64;
extern fn raz_rt_bytes_equal(usize left, usize right, i64 size) -> i64;
extern fn raz_rt_bytes_compare(usize left, usize right, i64 size) -> i64;
extern fn raz_rt_bytes_find(usize data, i64 size, i64 value) -> i64;
extern fn raz_rt_bytes_rfind(usize data, i64 size, i64 value) -> i64;
extern fn raz_rt_hash_bytes(usize data, i64 size) -> i64;
extern fn raz_rt_copy(usize destination, usize source, i64 size);
extern fn raz_rt_move(usize destination, usize source, i64 size);
extern fn raz_rt_fill(usize destination, i64 value, i64 size);

public struct BytesView {
    usize data;
    i64 length;
}

public fn valid(BytesView bytes) -> bool {
    return bytes.length >= 0 && (bytes.length == 0 || bytes.data != 0);
}

public fn is_empty(BytesView bytes) -> bool {
    return bytes.length == 0;
}

public fn byte_at(BytesView bytes, i64 index) -> i64 {
    if (index < 0 || index >= bytes.length || bytes.data == 0) {
        return -1;
    }
    unsafe {
        return (*((bytes.data + index)as u8*const))as i64;
    }
}

public fn set_byte(usize data, i64 length, i64 index, i64 value) -> bool {
    if (index < 0 || index >= length || data == 0) {
        return false;
    }
    unsafe {
        *((data + index)as u8*mut) = (value & 255)as u8;
    }
    return true;
}

public fn load_u8(usize address) -> i64 {
    if (address == 0) {
        return -1;
    }
    unsafe {
        return (*(address as u8*const))as i64;
    }
}

public fn store_u8(usize address, i64 value) -> bool {
    if (address == 0) {
        return false;
    }
    unsafe {
        *(address as u8*mut) = (value & 255)as u8;
    }
    return true;
}

/// Fast non-cryptographic hash for borrowed bytes. The value is process/library
/// version specific and is intended for hash tables, not persistent formats.
public fn hash(BytesView bytes) -> i64 {
    if (!valid(bytes)) {
        return 0;
    }
    return raz_rt_hash_bytes(bytes.data, bytes.length);
}

public fn equal(BytesView left, BytesView right) -> bool {
    if (left.length != right.length || left.length < 0) {
        return false;
    }
    return raz_rt_bytes_equal(left.data, right.data, left.length) == 1;
}

public fn compare(BytesView left, BytesView right) -> i64 {
    i64 shared = left.length;

    if (right.length < shared) {
        shared = right.length;
    }
    if (shared > 0) {
        i64 ordering = raz_rt_bytes_compare(left.data, right.data, shared);

        if (ordering != 0) {
            return ordering;
        }
    }
    if (left.length < right.length) {
        return -1;
    }
    if (left.length > right.length) {
        return 1;
    }
    return 0;
}

public fn starts_with(BytesView bytes, BytesView prefix) -> bool {
    if (prefix.length < 0 || prefix.length > bytes.length) {
        return false;
    }
    return raz_rt_bytes_equal(bytes.data, prefix.data, prefix.length) == 1;
}

public fn ends_with(BytesView bytes, BytesView suffix) -> bool {
    if (suffix.length < 0 || suffix.length > bytes.length) {
        return false;
    }
    return raz_rt_bytes_equal(bytes.data + bytes.length - suffix.length, suffix.data, suffix.length) == 1;
}

public fn find_byte(BytesView bytes, i64 value) -> i64 {
    if (!valid(bytes)) {
        return -1;
    }
    return raz_rt_bytes_find(bytes.data, bytes.length, value);
}

public fn rfind_byte(BytesView bytes, i64 value) -> i64 {
    if (!valid(bytes)) {
        return -1;
    }
    return raz_rt_bytes_rfind(bytes.data, bytes.length, value);
}

public fn copy_into(usize destination, i64 destination_capacity, BytesView source) -> i64 {
    if (source.length < 0 || destination_capacity < source.length) {
        return -1;
    }
    if (source.length > 0) {
        raz_rt_copy(destination, source.data, source.length);
    }
    return source.length;
}

public fn move_into(usize destination, i64 destination_capacity, BytesView source) -> i64 {
    if (source.length < 0 || destination_capacity < source.length) {
        return -1;
    }
    if (source.length > 0) {
        raz_rt_move(destination, source.data, source.length);
    }
    return source.length;
}

public fn zero(usize destination, i64 size) {
    if (destination != 0 && size > 0) {
        raz_rt_fill(destination, 0, size);
    }
}
