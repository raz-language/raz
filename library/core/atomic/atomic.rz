namespace core::atomic;

extern fn raz_rt_atomic_load_i64(usize value) -> i64;
extern fn raz_rt_atomic_store_i64(usize value, i64 desired);
extern fn raz_rt_atomic_add_i64(usize value, i64 delta) -> i64;
extern fn raz_rt_atomic_exchange_i64(usize value, i64 desired) -> i64;
extern fn raz_rt_atomic_compare_exchange_i64(usize value, i64 expected, i64 desired) -> i64;

public fn load_i64(usize value) -> i64 {
    return raz_rt_atomic_load_i64(value);
}

public fn store_i64(usize value, i64 desired) {
    raz_rt_atomic_store_i64(value, desired);
}

public fn fetch_add_i64(usize value, i64 delta) -> i64 {
    return raz_rt_atomic_add_i64(value, delta);
}

public fn exchange_i64(usize value, i64 desired) -> i64 {
    return raz_rt_atomic_exchange_i64(value, desired);
}

public fn compare_exchange_i64(usize value, i64 expected, i64 desired) -> bool {
    return raz_rt_atomic_compare_exchange_i64(value, expected, desired) == 1;
}

// Memory-order constants shared by ordered operations.
public const i64 relaxed = 0;
public const i64 acquire = 1;
public const i64 release = 2;
public const i64 acquire_release = 3;
public const i64 sequentially_consistent = 4;

extern fn raz_rt_atomic_load_i64_ordered(usize value, i64 order) -> i64;
extern fn raz_rt_atomic_store_i64_ordered(usize value, i64 desired, i64 order);
extern fn raz_rt_atomic_add_i64_ordered(usize value, i64 delta, i64 order) -> i64;
extern fn raz_rt_atomic_exchange_i64_ordered(usize value, i64 desired, i64 order) -> i64;
extern fn raz_rt_atomic_compare_exchange_i64_ordered(usize value, i64 expected, i64 desired, i64 success_order, i64 failure_order) -> i64;
extern fn raz_rt_memory_fence_ordered(i64 order);
extern fn raz_rt_cpu_relax();

public fn load_i64_ordered(usize value, i64 order) -> i64 {
    return raz_rt_atomic_load_i64_ordered(value, order);
}

public fn store_i64_ordered(usize value, i64 desired, i64 order) {
    raz_rt_atomic_store_i64_ordered(value, desired, order);
}

public fn fetch_add_i64_ordered(usize value, i64 delta, i64 order) -> i64 {
    return raz_rt_atomic_add_i64_ordered(value, delta, order);
}

public fn exchange_i64_ordered(usize value, i64 desired, i64 order) -> i64 {
    return raz_rt_atomic_exchange_i64_ordered(value, desired, order);
}

public fn compare_exchange_i64_ordered(usize value, i64 expected, i64 desired, i64 success_order, i64 failure_order) -> bool {
    return raz_rt_atomic_compare_exchange_i64_ordered(value, expected, desired, success_order, failure_order) == 1;
}

/// Emits the architecture's low-power/low-contention spin-wait hint.
public fn cpu_relax() {
    raz_rt_cpu_relax();
}

public fn fence(i64 order) {
    raz_rt_memory_fence_ordered(order);
}
