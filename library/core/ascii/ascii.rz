namespace core::ascii;


import core::bytes;
/// Returns true when the value is representable by one ASCII byte.
public fn is_ascii(i64 value) -> bool {
    return value >= 0 && value <= 127;
}

public fn is_digit(i64 value) -> bool {
    return value >= 48 && value <= 57;
}

public fn is_lower(i64 value) -> bool {
    return value >= 97 && value <= 122;
}

public fn is_upper(i64 value) -> bool {
    return value >= 65 && value <= 90;
}

public fn is_alpha(i64 value) -> bool {
    return is_lower(value) || is_upper(value);
}

public fn is_alphanumeric(i64 value) -> bool {
    return is_alpha(value) || is_digit(value);
}

public fn is_whitespace(i64 value) -> bool {
    return value == 32 || value == 9 || value == 10 || value == 11 || value == 12 || value == 13;
}

public fn is_hex_digit(i64 value) -> bool {
    return is_digit(value) || (value >= 65 && value <= 70) || (value >= 97 && value <= 102);
}

public fn digit_value(i64 value) -> i64 {
    if (!is_digit(value)) {
        return -1;
    }
    return value - 48;
}

public fn hex_value(i64 value) -> i64 {
    if (value >= 48 && value <= 57) {
        return value - 48;
    }
    if (value >= 65 && value <= 70) {
        return value - 55;
    }
    if (value >= 97 && value <= 102) {
        return value - 87;
    }
    return -1;
}

public fn to_lower(i64 value) -> i64 {
    if (is_upper(value)) {
        return value + 32;
    }
    return value;
}

public fn to_upper(i64 value) -> i64 {
    if (is_lower(value)) {
        return value - 32;
    }
    return value;
}

/// Allocation-free ASCII case-insensitive comparison over equal-length buffers.
public fn equal_ignore_case(usize left, usize right, i64 length) -> bool {
    if (length < 0 || (length > 0 && (left == 0 || right == 0))) {
        return false;
    }

    i64 index = 0;

    while (index < length) {
        i64 a = core::bytes::load_u8(left + index);
        i64 b = core::bytes::load_u8(right + index);

        if (to_lower(a) != to_lower(b)) {
            return false;
        }
        index += 1;
    }
    return true;
}
