namespace core::ptr;


extern fn raz_rt_volatile_load_i64(usize address) -> i64;
extern fn raz_rt_volatile_store_i64(usize address, i64 value);
extern fn raz_rt_memory_fence();

public unsafe fn volatile_load_i64(usize address) -> i64 {
    return raz_rt_volatile_load_i64(address);
}

public unsafe fn volatile_store_i64(usize address, i64 value) {
    raz_rt_volatile_store_i64(address, value);
}

public fn fence() {
    raz_rt_memory_fence();
}
