namespace std::encoding::hex;
import core::result;

public enum HexError {
    InvalidLength,
    InvalidDigit,
    OutputFull,
}

fn load_byte(usize address) -> i64 {
    unsafe {
        return (*((address)as u8*const))as i64;
    }
}

fn store_byte(usize address, i64 value) {
    unsafe {
        *((address)as u8*mut) = value as u8;
    }
}

fn hex_value(i64 value) -> i64 {
    if (value >= 48 && value <= 57) {
        return value - 48;
    }
    i64 folded = value | 32;

    if (folded >= 97 && folded <= 102) {
        return folded - 87;
    }
    return -1;
}

public fn encoded_length(i64 input_length) -> i64 {
    if (input_length < 0 || input_length > 4611686018427387903) {
        return -1;
    }
    return input_length * 2;
}

public fn decoded_length(i64 input_length) -> i64 {
    if (input_length < 0 || (input_length % 2) != 0) {
        return -1;
    }
    return input_length / 2;
}

fn digit(i64 value, bool uppercase) -> i64 {
    if (value < 10) {
        return 48 + value;
    }
    if (uppercase) {
        return 55 + value;
    }
    return 87 + value;
}

fn encode_impl(
    usize input,
    i64 input_length,
    usize output,
    i64 output_capacity,
    bool uppercase,
) -> Result<i64, HexError> {
    i64 required = encoded_length(input_length);

    if (required < 0) {
        return Result<i64, HexError>::Error(HexError::InvalidLength);
    }
    if ((input_length > 0 && input == 0) || output_capacity < required || (required > 0 && output == 0)) {
        return Result<i64, HexError>::Error(HexError::OutputFull);
    }

    i64 index = 0;

    while (index < input_length) {
        i64 value = load_byte(input + index);

        store_byte(output + index * 2, digit((value >> 4) & 15, uppercase));
        store_byte(output + index * 2 + 1, digit(value & 15, uppercase));
        index += 1;
    }
    return Result<i64, HexError>::Ok(required);
}

public fn encode_lower(
    usize input,
    i64 input_length,
    usize output,
    i64 output_capacity,
) -> Result<i64, HexError> {
    return encode_impl(input, input_length, output, output_capacity, false);
}

public fn encode_upper(
    usize input,
    i64 input_length,
    usize output,
    i64 output_capacity,
) -> Result<i64, HexError> {
    return encode_impl(input, input_length, output, output_capacity, true);
}

public fn decode(usize input, i64 input_length, usize output, i64 output_capacity) -> Result<i64, HexError> {
    i64 required = decoded_length(input_length);

    if (required < 0) {
        return Result<i64, HexError>::Error(HexError::InvalidLength);
    }
    if ((input_length > 0 && input == 0) || output_capacity < required || (required > 0 && output == 0)) {
        return Result<i64, HexError>::Error(HexError::OutputFull);
    }

    i64 index = 0;

    while (index < required) {
        i64 high = hex_value(load_byte(input + index * 2));
        i64 low = hex_value(load_byte(input + index * 2 + 1));

        if (high < 0 || low < 0) {
            return Result<i64, HexError>::Error(HexError::InvalidDigit);
        }
        store_byte(output + index, (high << 4) | low);
        index += 1;
    }
    return Result<i64, HexError>::Ok(required);
}
