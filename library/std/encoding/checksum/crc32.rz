namespace std::encoding::checksum;


// CRC is a bulk bit-level primitive: cross the runtime boundary once for the
// complete span rather than performing eight polynomial steps in Raz per byte.
// The runtime implementation is table-driven, unrolled and preserves this
// incremental unfinalized-state ABI exactly.
extern fn raz_rt_crc32_ieee_update(u32 state, usize data, i64 length) -> u32;

/// Begins an incremental IEEE CRC-32 computation.
public fn crc32_begin() -> u32 {
    return 0xffffffff as u32;
}

/// Updates an unfinalized IEEE CRC-32 state.
public fn crc32_update(u32 state, usize data, i64 length) -> u32 {
    if (length <= 0 || data == 0) {
        return state;
    }
    return raz_rt_crc32_ieee_update(state, data, length);
}

public fn crc32_finish(u32 state) -> u32 {
    return state ^ (0xffffffff as u32);
}

public fn crc32(usize data, i64 length) -> u32 {
    return crc32_finish(crc32_update(crc32_begin(), data, length));
}
