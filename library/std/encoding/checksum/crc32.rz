namespace std::encoding::checksum;
import core::bytes;
/// Begins an incremental IEEE CRC-32 computation.
public fn crc32_begin() -> u32 {
    return 0xffffffff as u32;
}

/// Updates an unfinalized IEEE CRC-32 state.
public fn crc32_update(u32 state, usize data, i64 length) -> u32 {
    if (length <= 0 || data == 0) {
        return state;
    }

    u32 current = state;
    i64 index = 0;

    while (index < length) {
        current ^= core::bytes::load_u8(data + index)as u32;

        i64 bit = 0;

        while (bit < 8) {
            if ((current & (1 as u32)) != 0) {
                current = (current >> 1) ^ (0xedb88320 as u32);
            } else {
                current >>= 1;
            }
            bit += 1;
        }
        index += 1;
    }
    return current;
}

public fn crc32_finish(u32 state) -> u32 {
    return state ^ (0xffffffff as u32);
}

public fn crc32(usize data, i64 length) -> u32 {
    return crc32_finish(crc32_update(crc32_begin(), data, length));
}
