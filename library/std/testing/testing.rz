namespace std::testing;

import alloc::string;
import std::fmt;
import std::io::stdio;

fn write_failure_prefix() -> bool {
    i64 bytes[18] = [97, 115, 115, 101, 114, 116, 105, 111, 110, 32, 102, 97, 105, 108, 101, 100, 58, 32];
    String text = alloc::string::with_capacity(18);
    i64 index = 0;

    while (index < 18) {
        if (!alloc::string::push_byte(&mut text, bytes[index])) {
            return false;
        }
        index += 1;
    }

    bool ok = std::io::stdio::eprint_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

fn write_separator() -> bool {
    i64 bytes[13] = [32, 101, 120, 112, 101, 99, 116, 101, 100, 32, 33, 61, 32];
    String text = alloc::string::with_capacity(13);
    i64 index = 0;

    while (index < 13) {
        if (!alloc::string::push_byte(&mut text, bytes[index])) {
            return false;
        }
        index += 1;
    }

    bool ok = std::io::stdio::eprint_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

public fn expect(bool condition) -> i64 {
    if (condition) {
        return 0;
    }
    write_failure_prefix();

    String message = alloc::string::with_capacity(19);
    i64 bytes[19] = [99, 111, 110, 100, 105, 116, 105, 111, 110, 32, 105, 115, 32, 102, 97, 108, 115, 101, 10];
    i64 index = 0;

    while (index < 19) {
        alloc::string::push_byte(&mut message, bytes[index]);
        index += 1;
    }
    std::io::stdio::eprint_string(&message);
    alloc::string::destroy(&mut message);
    return 1;
}

public fn expect_i64_eq(i64 actual, i64 expected) -> i64 {
    if (actual == expected) {
        return 0;
    }
    write_failure_prefix();

    String actual_text = std::fmt::format_i64(actual);
    String expected_text = std::fmt::format_i64(expected);

    std::io::stdio::eprint_string(&actual_text);
    write_separator();
    std::io::stdio::eprintln_string(&expected_text);
    alloc::string::destroy(&mut actual_text);
    alloc::string::destroy(&mut expected_text);
    return 1;
}

public fn expect_u64_eq(u64 actual, u64 expected) -> i64 {
    if (actual == expected) {
        return 0;
    }
    write_failure_prefix();

    String actual_text = std::fmt::format_u64(actual);
    String expected_text = std::fmt::format_u64(expected);

    std::io::stdio::eprint_string(&actual_text);
    write_separator();
    std::io::stdio::eprintln_string(&expected_text);
    alloc::string::destroy(&mut actual_text);
    alloc::string::destroy(&mut expected_text);
    return 1;
}

public fn expect_bool_eq(bool actual, bool expected) -> i64 {
    if (actual == expected) {
        return 0;
    }
    write_failure_prefix();

    String actual_text = std::fmt::format_bool(actual);
    String expected_text = std::fmt::format_bool(expected);

    std::io::stdio::eprint_string(&actual_text);
    write_separator();
    std::io::stdio::eprintln_string(&expected_text);
    alloc::string::destroy(&mut actual_text);
    alloc::string::destroy(&mut expected_text);
    return 1;
}
