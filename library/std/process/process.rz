namespace std::process;


extern fn raz_rt_process_id() -> i64;
extern fn raz_rt_process_run(usize command, i64 length) -> i64;

public fn id() -> i64 {
    return raz_rt_process_id();
}

public fn run(usize command, i64 length) -> i64 {
    return raz_rt_process_run(command, length);
}

extern fn raz_rt_process_argc() -> i64;
extern fn raz_rt_process_arg(i64 index, usize output, i64 capacity) -> i64;

public fn argc() -> i64 {
    return raz_rt_process_argc();
}

// Returns the full required byte length. If capacity is too small the runtime
// writes a truncated, NUL-terminated prefix while preserving the required size.
public fn arg(i64 index, usize output, i64 capacity) -> i64 {
    return raz_rt_process_arg(index, output, capacity);
}
