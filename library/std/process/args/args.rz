namespace std::process::args;
import alloc::string;
import core::option;
import std::process;

public struct Args {
    i64 index;
    i64 count;
}

public fn args() -> Args {
    return Args {
        index: 0,
        count: std::process::argc()
    };
}

public fn remaining(Args& iterator) -> i64 {
    i64 left = iterator.count - iterator.index;

    if (left < 0) {
        return 0;
    }
    return left;
}

public fn next(Args&mut iterator) -> Option<String> {
    if (iterator.index < 0 || iterator.index >= iterator.count) {
        return Option<String>::None;
    }

    i64 current = iterator.index;

    iterator.index += 1;

    i64 required = std::process::arg(current, 0, 0);

    if (required < 0) {
        return Option<String>::None;
    }

    String value = alloc::string::with_capacity(required);

    if (required > 0 && alloc::string::data_ptr(&value) == 0) {
        return Option<String>::None;
    }

    i64 actual = std::process::arg(current, alloc::string::data_ptr(&value), required + 1);

    if (actual < 0 || actual > required) {
        return Option<String>::None;
    }
    unsafe {
        if (!alloc::string::set_len_initialized(&mut value, actual)) {
            return Option<String>::None;
        }
    }
    return Option<String>::Some(move value);
}

/// Allocation-reusing argument iterator. The caller owns `output`; its backing
/// allocation grows only when a later argument exceeds the previous high-water
/// mark. Returns false at end-of-arguments or on host retrieval failure.
public fn next_into(Args&mut iterator, String&mut output) -> bool {
    if (iterator.index < 0 || iterator.index >= iterator.count) {
        return false;
    }
    i64 current = iterator.index;
    i64 required = std::process::arg(current, 0, 0);

    if (required < 0) {
        return false;
    }
    if (!alloc::string::reserve(output, required)) {
        return false;
    }
    i64 actual = std::process::arg(current, alloc::string::data_ptr(output), alloc::string::capacity(output) + 1);

    if (actual < 0 || actual > alloc::string::capacity(output)) {
        return false;
    }
    unsafe {
        if (!alloc::string::set_len_initialized(output, actual)) {
            return false;
        }
    }
    iterator.index += 1;
    return true;
}
