namespace std::process::owned;
import std::process;
import alloc::string;
import core::option;

public fn argument(i64 index) -> Option<String> {
    i64 required = std::process::arg(index, 0, 0);

    if (required < 0) {
        return Option<String>::None;
    }

    String value = alloc::string::with_capacity(required);

    if (required > 0 && alloc::string::data_ptr(&value) == 0) {
        return Option<String>::None;
    }

    i64 actual = std::process::arg(index, alloc::string::data_ptr(&value), required + 1);

    if (actual < 0 || actual > required) {
        return Option<String>::None;
    }
    unsafe {
        if (!alloc::string::set_len_initialized(&mut value, actual)) {
            return Option<String>::None;
        }
    }
    return Option<String>::Some(move value);
}
