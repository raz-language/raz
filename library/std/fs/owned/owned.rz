namespace std::fs::owned;

import alloc::string;
import core::result;
import std::fs;
import std::io::error;
import std::path::buf;

public fn exists_string(String& path) -> bool {
    return std::fs::exists(alloc::string::data_ptr(path), alloc::string::len(path));
}

public fn is_file_string(String& path) -> bool {
    return std::fs::is_file(alloc::string::data_ptr(path), alloc::string::len(path));
}

public fn is_dir_string(String& path) -> bool {
    return std::fs::is_dir(alloc::string::data_ptr(path), alloc::string::len(path));
}

public fn create_dir_string(String& path) -> bool {
    return std::fs::create_dir(alloc::string::data_ptr(path), alloc::string::len(path));
}

public fn remove_string(String& path) -> bool {
    return std::fs::remove(alloc::string::data_ptr(path), alloc::string::len(path));
}

public fn file_size_string(String& path) -> i64 {
    return std::fs::file_size(alloc::string::data_ptr(path), alloc::string::len(path));
}

public fn rename_string(String& from, String& to) -> bool {
    return std::fs::rename(
        alloc::string::data_ptr(from),
        alloc::string::len(from),
        alloc::string::data_ptr(to),
        alloc::string::len(to),
    );
}

public fn copy_file_string(String& from, String& to, bool overwrite) -> bool {
    return std::fs::copy_file(
        alloc::string::data_ptr(from),
        alloc::string::len(from),
        alloc::string::data_ptr(to),
        alloc::string::len(to),
        overwrite,
    );
}

public fn exists_path(PathBuf& path) -> bool {
    return std::fs::exists(path_buf_data_ptr(path), path_buf_len(path));
}

public fn is_file_path(PathBuf& path) -> bool {
    return std::fs::is_file(path_buf_data_ptr(path), path_buf_len(path));
}

public fn is_dir_path(PathBuf& path) -> bool {
    return std::fs::is_dir(path_buf_data_ptr(path), path_buf_len(path));
}

public fn file_size_path(PathBuf& path) -> i64 {
    return std::fs::file_size(path_buf_data_ptr(path), path_buf_len(path));
}

public fn remove_path(PathBuf& path) -> bool {
    return std::fs::remove(path_buf_data_ptr(path), path_buf_len(path));
}

public fn rename_path(PathBuf& from, PathBuf& to) -> bool {
    return std::fs::rename(
        path_buf_data_ptr(from),
        path_buf_len(from),
        path_buf_data_ptr(to),
        path_buf_len(to),
    );
}

public fn copy_file_path(PathBuf& from, PathBuf& to, bool overwrite) -> bool {
    return std::fs::copy_file(
        path_buf_data_ptr(from),
        path_buf_len(from),
        path_buf_data_ptr(to),
        path_buf_len(to),
        overwrite,
    );
}
