namespace std::fs::metadata;


import core::result;
import std::io::error;

public struct Metadata {
    i64 kind;
    i64 size;
    i64 modified_millis;
    bool readonly;
    bool symlink;
    bool exists;
}

// Six i64 fields are used at the ABI boundary to keep its layout stable across
// every target. The public Metadata compacts flags to bool in Raz.
struct RawMetadata {
    i64 kind;
    i64 size;
    i64 modified_millis;
    i64 readonly;
    i64 symlink;
    i64 exists;
}

extern fn raz_rt_fs_metadata(usize path, i64 length, RawMetadata&mut output, i64 capacity) -> i64;

public fn is_file(Metadata& value) -> bool {
    return value.kind == 1;
}

public fn is_dir(Metadata& value) -> bool {
    return value.kind == 2;
}

public fn is_symlink(Metadata& value) -> bool {
    return value.symlink;
}

public fn len(Metadata& value) -> i64 {
    return value.size;
}

public fn query(usize path, i64 length) -> Result<Metadata, IoError> {
    RawMetadata raw = RawMetadata {
        kind: 0,
        size: 0,
        modified_millis: 0,
        readonly: 0,
        symlink: 0,
        exists: 0
    };
    if (raz_rt_fs_metadata(path, length, &mut raw, 6) != 1) {
        return Result<Metadata, IoError>::Error(std::io::error::last_error(IoOperation::Metadata));
    }
    Metadata value = Metadata {
        kind: raw.kind,
        size: raw.size,
        modified_millis: raw.modified_millis,
        readonly: raw.readonly == 1,
        symlink: raw.symlink == 1,
        exists: raw.exists == 1,
    };
    return Result<Metadata, IoError>::Ok(value);
}
