namespace std::fs::platform;
import core::result;
import std::io::error;

// Portable filesystem capabilities whose policy remains in Raz while the
// runtime performs only the platform ABI call.
extern fn raz_rt_path_canonical(usize path, i64 length, usize output, i64 capacity) -> i64;
extern fn raz_rt_path_read_link(usize path, i64 length, usize output, i64 capacity) -> i64;
extern fn raz_rt_path_create_symlink(usize target, i64 target_length, usize link, i64 link_length, i64 directory) -> i64;
extern fn raz_rt_temp_directory(usize output, i64 capacity) -> i64;
extern fn raz_rt_create_temp_file(usize prefix, i64 prefix_length, usize output, i64 capacity) -> i64;
extern fn raz_rt_path_permissions(usize path, i64 length) -> i64;
extern fn raz_rt_path_set_permissions(usize path, i64 length, i64 mode) -> i64;

public const i64 owner_read = 256;
public const i64 owner_write = 128;
public const i64 owner_execute = 64;
public const i64 group_read = 32;
public const i64 group_write = 16;
public const i64 group_execute = 8;
public const i64 other_read = 4;
public const i64 other_write = 2;
public const i64 other_execute = 1;

// Buffer APIs return the required UTF-8 byte count. A caller can first invoke
// them with output=0/capacity=0, allocate exactly once, then call again.
public fn canonical(usize path, i64 length, usize output, i64 capacity) -> Result<i64, IoError> {
    i64 result = raz_rt_path_canonical(path, length, output, capacity);
    if (result < 0) { return Result<i64, IoError>::Error(last_error(IoOperation::Metadata)); }
    return Result<i64, IoError>::Ok(result);
}

public fn read_link(usize path, i64 length, usize output, i64 capacity) -> Result<i64, IoError> {
    i64 result = raz_rt_path_read_link(path, length, output, capacity);
    if (result < 0) { return Result<i64, IoError>::Error(last_error(IoOperation::ReadLink)); }
    return Result<i64, IoError>::Ok(result);
}

public fn create_symlink(usize target, i64 target_length, usize link, i64 link_length) -> Result<bool, IoError> {
    if (raz_rt_path_create_symlink(target, target_length, link, link_length, 0) != 1) {
        return Result<bool, IoError>::Error(last_error(IoOperation::Symlink));
    }
    return Result<bool, IoError>::Ok(true);
}

public fn create_directory_symlink(usize target, i64 target_length, usize link, i64 link_length) -> Result<bool, IoError> {
    if (raz_rt_path_create_symlink(target, target_length, link, link_length, 1) != 1) {
        return Result<bool, IoError>::Error(last_error(IoOperation::Symlink));
    }
    return Result<bool, IoError>::Ok(true);
}

public fn temp_directory(usize output, i64 capacity) -> Result<i64, IoError> {
    i64 result = raz_rt_temp_directory(output, capacity);
    if (result < 0) { return Result<i64, IoError>::Error(last_error(IoOperation::Metadata)); }
    return Result<i64, IoError>::Ok(result);
}

// Atomically creates a new empty temporary file and returns its path length.
public fn create_temp_file(usize prefix, i64 prefix_length, usize output, i64 capacity) -> Result<i64, IoError> {
    i64 result = raz_rt_create_temp_file(prefix, prefix_length, output, capacity);
    if (result < 0) { return Result<i64, IoError>::Error(last_error(IoOperation::CreateTemp)); }
    return Result<i64, IoError>::Ok(result);
}

public fn permissions(usize path, i64 length) -> Result<i64, IoError> {
    i64 result = raz_rt_path_permissions(path, length);
    if (result < 0) { return Result<i64, IoError>::Error(last_error(IoOperation::Metadata)); }
    return Result<i64, IoError>::Ok(result);
}

public fn set_permissions(usize path, i64 length, i64 mode) -> Result<bool, IoError> {
    if (raz_rt_path_set_permissions(path, length, mode) != 1) {
        return Result<bool, IoError>::Error(last_error(IoOperation::Permissions));
    }
    return Result<bool, IoError>::Ok(true);
}
