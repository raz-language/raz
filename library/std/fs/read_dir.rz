namespace std::fs::read_dir;


import alloc::string;
import core::result;
import std::fs::metadata;
import std::io::error;

struct RawDirMetadata {
    i64 kind;
    i64 size;
    i64 modified_millis;
    i64 readonly;
    i64 symlink;
    i64 exists;
}

extern fn raz_rt_dir_open(usize path, i64 length) -> usize;
extern fn raz_rt_dir_next(
    usize handle,
    usize output,
    i64 capacity,
    RawDirMetadata&mut metadata,
    i64 metadata_capacity,
) -> i64;
extern fn raz_rt_dir_close(usize handle);

public struct ReadDir {
    usize handle;
    bool finished;
}

public fn open(usize path, i64 length) -> Result<ReadDir, IoError> {
    usize handle = raz_rt_dir_open(path, length);

    if (handle == 0) {
        return Result<ReadDir, IoError>::Error(std::io::error::last_error(IoOperation::Open));
    }
    return Result<ReadDir, IoError>::Ok(ReadDir {
        handle: handle,
        finished: false
    }
    );
}

// Returns 1 for an entry, 0 at end-of-directory, -1 on error. The caller owns
// and reuses `name`, so a large directory normally allocates only when a longer
// filename than any previously seen is encountered.
public fn next(ReadDir&mut iterator, String&mut name, Metadata&mut metadata) -> i64 {
    if (iterator.handle == 0 || iterator.finished) {
        return 0;
    }
    RawDirMetadata raw = RawDirMetadata {
        kind: 0,
        size: 0,
        modified_millis: 0,
        readonly: 0,
        symlink: 0,
        exists: 0
    };

    // Fast path: once the reusable String has a useful capacity, ask the OS
    // iterator to fill it directly. raz_rt_dir_next does not consume the entry
    // when capacity is insufficient, so only unusually long names require a
    // sizing retry. Large directory walks therefore cross the native boundary
    // once per entry in steady state instead of twice.
    i64 available = alloc::string::capacity(name);
    i64 required = raz_rt_dir_next(iterator.handle, name.data, available + 1, &mut raw, 6);

    if (required == -1) {
        iterator.finished = true;
        return 0;
    }
    if (required < 0) {
        return -1;
    }

    i64 fetched = required;

    if (required > available) {
        i64 next_capacity = available;

        if (next_capacity < 64) {
            next_capacity = 64;
        }
        while (next_capacity < required) {
            if (next_capacity > 4611686018427387903) {
                next_capacity = required;
                break;
            }
            next_capacity *= 2;
        }
        if (!alloc::string::reserve_exact(name, next_capacity)) {
            return -1;
        }
        fetched = raz_rt_dir_next(iterator.handle, name.data, name.capacity + 1, &mut raw, 6);
        if (fetched < 0 || fetched > name.capacity) {
            return -1;
        }
    }
    name.length = fetched;
    *metadata = Metadata {
        kind: raw.kind,
        size: raw.size,
        modified_millis: raw.modified_millis,
        readonly: raw.readonly == 1,
        symlink: raw.symlink == 1,
        exists: raw.exists == 1,
    };
    return 1;
}

public fn close(ReadDir&mut iterator) {
    if (iterator.handle != 0) {
        raz_rt_dir_close(iterator.handle);
        iterator.handle = 0;
        iterator.finished = true;
    }
}

impl Drop for ReadDir {
    fn drop(ReadDir&mut self) {
        close(self);
    }
}
