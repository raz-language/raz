namespace std::sync::once;


import std::sync::condition;
import std::sync::mutex;

extern fn raz_rt_alloc_aligned(i64 size, i64 alignment) -> usize;
extern fn raz_rt_dealloc_aligned(usize pointer, i64 alignment);
extern fn raz_rt_volatile_load_i64(usize address) -> i64;
extern fn raz_rt_volatile_store_i64(usize address, i64 value);
// Once state and wake policy are fully Raz-owned. The native boundary is only
// allocation plus OS mutex/condition primitives. State: 0 idle, 1 running, 2 done.
const i64 ONCE_STATE = 0;
const i64 ONCE_VALUE = 8;
const i64 ONCE_MUTEX = 16;
const i64 ONCE_CONDITION = 24;
const i64 ONCE_BYTES = 32;

fn address(i8*mut once) -> usize {
    usize value = 0;

    unsafe {
        value = once as usize;
    }
    return value;
}

fn load(usize state, i64 offset) -> i64 {
    return raz_rt_volatile_load_i64(state + offset);
}

fn store(usize state, i64 offset, i64 value) {
    raz_rt_volatile_store_i64(state + offset, value);
}

public fn once_create() -> i8*mut {
    usize state = raz_rt_alloc_aligned(ONCE_BYTES, 8);

    if (state == 0) {
        unsafe {
            return 0 as i8*mut;
        }
    }

    usize mutex = std::sync::mutex::mutex_create_raw();
    usize condition = std::sync::condition::condition_create();

    if (mutex == 0 || condition == 0) {
        if (condition != 0) {
            std::sync::condition::condition_destroy(condition);
        }
        if (mutex != 0) {
            std::sync::mutex::mutex_destroy_raw(mutex);
        }
        raz_rt_dealloc_aligned(state, 8);
        unsafe {
            return 0 as i8*mut;
        }
    }
    store(state, ONCE_STATE, 0);
    store(state, ONCE_VALUE, 0);
    store(state, ONCE_MUTEX, mutex as i64);
    store(state, ONCE_CONDITION, condition as i64);
    unsafe {
        return state as i8*mut;
    }
}

public fn once_destroy(i8*mut once) {
    usize state = address(once);

    if (state == 0) {
        return;
    }

    usize condition = load(state, ONCE_CONDITION)as usize;
    usize mutex = load(state, ONCE_MUTEX)as usize;

    if (condition != 0) {
        std::sync::condition::condition_destroy(condition);
    }
    if (mutex != 0) {
        std::sync::mutex::mutex_destroy_raw(mutex);
    }
    raz_rt_dealloc_aligned(state, 8);
}

// Executes operation exactly once. Every caller receives the value produced by
// the winning operation; concurrent callers wait for that operation to finish.
public fn once_call_i64(i8*mut once, FnOnce() -> i64 operation) -> i64 {
    usize state = address(once);

    if (state == 0) {
        return 0;
    }

    usize mutex = load(state, ONCE_MUTEX)as usize;
    usize condition = load(state, ONCE_CONDITION)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);
    while (load(state, ONCE_STATE) == 1) {
        std::sync::condition::wait_raw(condition, mutex);
    }
    if (load(state, ONCE_STATE) == 2) {
        i64 value = load(state, ONCE_VALUE);

        std::sync::mutex::mutex_unlock_raw(mutex);
        return value;
    }
    store(state, ONCE_STATE, 1);
    std::sync::mutex::mutex_unlock_raw(mutex);

    i64 value = operation();

    std::sync::mutex::mutex_lock_raw(mutex);
    store(state, ONCE_VALUE, value);
    store(state, ONCE_STATE, 2);
    std::sync::mutex::mutex_unlock_raw(mutex);
    std::sync::condition::notify_all_raw(condition);
    return value;
}

public fn once_completed(i8*mut once) -> bool {
    usize state = address(once);

    if (state == 0) {
        return false;
    }

    usize mutex = load(state, ONCE_MUTEX)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);

    bool completed = load(state, ONCE_STATE) == 2;

    std::sync::mutex::mutex_unlock_raw(mutex);
    return completed;
}
