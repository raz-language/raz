namespace std::sync::rwlock;

extern fn raz_rt_rwlock_create() -> usize;
extern fn raz_rt_rwlock_destroy(usize lock);
extern fn raz_rt_rwlock_read_lock(usize lock);
extern fn raz_rt_rwlock_try_read(usize lock) -> i64;
extern fn raz_rt_rwlock_read_unlock(usize lock);
extern fn raz_rt_rwlock_write_lock(usize lock);
extern fn raz_rt_rwlock_try_write(usize lock) -> i64;
extern fn raz_rt_rwlock_write_unlock(usize lock);

public struct RwLock {
    usize handle;
}

public struct ReadGuard {
    usize handle;
    bool locked;
}

public struct WriteGuard {
    usize handle;
    bool locked;
}

// Compatibility raw surface.
public fn rwlock_create() -> usize {
    return raz_rt_rwlock_create();
}

public fn rwlock_destroy(usize lock) {
    raz_rt_rwlock_destroy(lock);
}

public fn read_lock(usize lock) {
    raz_rt_rwlock_read_lock(lock);
}

public fn try_read(usize lock) -> bool {
    return raz_rt_rwlock_try_read(lock) == 1;
}

public fn read_unlock(usize lock) {
    raz_rt_rwlock_read_unlock(lock);
}

public fn write_lock(usize lock) {
    raz_rt_rwlock_write_lock(lock);
}

public fn try_write(usize lock) -> bool {
    return raz_rt_rwlock_try_write(lock) == 1;
}

public fn write_unlock(usize lock) {
    raz_rt_rwlock_write_unlock(lock);
}

public fn create() -> RwLock {
    return RwLock {
        handle: raz_rt_rwlock_create()
    };
}

public fn valid(RwLock& lock) -> bool {
    return lock.handle != 0;
}

public fn read_guard(RwLock& lock) -> ReadGuard {
    if (!valid(lock)) {
        return ReadGuard {
            handle: 0,
            locked: false
        };
    }
    raz_rt_rwlock_read_lock(lock.handle);
    return ReadGuard {
        handle: lock.handle,
        locked: true
    };
}

public fn try_read_guard(RwLock& lock) -> ReadGuard {
    if (!valid(lock) || raz_rt_rwlock_try_read(lock.handle) != 1) {
        return ReadGuard {
            handle: 0,
            locked: false
        };
    }
    return ReadGuard {
        handle: lock.handle,
        locked: true
    };
}

public fn write_guard(RwLock& lock) -> WriteGuard {
    if (!valid(lock)) {
        return WriteGuard {
            handle: 0,
            locked: false
        };
    }
    raz_rt_rwlock_write_lock(lock.handle);
    return WriteGuard {
        handle: lock.handle,
        locked: true
    };
}

public fn try_write_guard(RwLock& lock) -> WriteGuard {
    if (!valid(lock) || raz_rt_rwlock_try_write(lock.handle) != 1) {
        return WriteGuard {
            handle: 0,
            locked: false
        };
    }
    return WriteGuard {
        handle: lock.handle,
        locked: true
    };
}

public fn read_guard_unlock(ReadGuard&mut guard) {
    if (guard.locked && guard.handle != 0) {
        raz_rt_rwlock_read_unlock(guard.handle);
        guard.locked = false;
        guard.handle = 0;
    }
}

public fn write_guard_unlock(WriteGuard&mut guard) {
    if (guard.locked && guard.handle != 0) {
        raz_rt_rwlock_write_unlock(guard.handle);
        guard.locked = false;
        guard.handle = 0;
    }
}

public fn destroy(RwLock&mut lock) {
    if (lock.handle != 0) {
        raz_rt_rwlock_destroy(lock.handle);
        lock.handle = 0;
    }
}

impl Drop for ReadGuard {
    fn drop(ReadGuard&mut self) {
        read_guard_unlock(self);
    }
}

impl Drop for WriteGuard {
    fn drop(WriteGuard&mut self) {
        write_guard_unlock(self);
    }
}

impl Drop for RwLock {
    fn drop(RwLock&mut self) {
        destroy(self);
    }
}
