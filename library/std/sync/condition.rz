namespace std::sync::condition;
import std::sync::mutex;
// Condition variables are permanent OS synchronization primitives. Higher-level
// wait predicates and state machines live in Raz.
extern fn raz_rt_condition_create() -> usize;
extern fn raz_rt_condition_destroy(usize condition);
extern fn raz_rt_condition_notify_one(usize condition);
extern fn raz_rt_condition_notify_all(usize condition);
extern fn raz_rt_condition_wait(usize condition, usize mutex);
extern fn raz_rt_condition_wait_millis(usize condition, usize mutex, i64 timeout_millis) -> i64;

public struct Condition {
    usize handle;
}

// Compatibility raw surface.
public fn condition_create() -> usize {
    return raz_rt_condition_create();
}

public fn condition_destroy(usize condition) {
    raz_rt_condition_destroy(condition);
}

public fn notify_one_raw(usize condition) {
    raz_rt_condition_notify_one(condition);
}

public fn notify_all_raw(usize condition) {
    raz_rt_condition_notify_all(condition);
}

public fn wait_raw(usize condition, usize mutex) {
    raz_rt_condition_wait(condition, mutex);
}

public fn wait_millis_raw(usize condition, usize mutex, i64 timeout_millis) -> bool {
    return raz_rt_condition_wait_millis(condition, mutex, timeout_millis) == 1;
}

public fn create() -> Condition {
    return Condition {
        handle: raz_rt_condition_create()
    };
}

public fn valid(Condition& condition) -> bool {
    return condition.handle != 0;
}

public fn notify_one(Condition& condition) {
    if (condition.handle != 0) {
        raz_rt_condition_notify_one(condition.handle);
    }
}

public fn notify_all(Condition& condition) {
    if (condition.handle != 0) {
        raz_rt_condition_notify_all(condition.handle);
    }
}

// The mutex must already be locked. As with std::condition_variable, the native
// primitive atomically releases the mutex while sleeping and reacquires it
// before returning.
public fn wait(Condition& condition, Mutex& mutex) {
    if (condition.handle != 0 && mutex.handle != 0) {
        raz_rt_condition_wait(condition.handle, mutex.handle);
    }
}

public fn wait_millis(Condition& condition, Mutex& mutex, i64 timeout_millis) -> bool {
    if (condition.handle == 0 || mutex.handle == 0 || timeout_millis < 0) {
        return false;
    }
    return raz_rt_condition_wait_millis(condition.handle, mutex.handle, timeout_millis) == 1;
}

public fn destroy(Condition&mut condition) {
    if (condition.handle != 0) {
        raz_rt_condition_destroy(condition.handle);
        condition.handle = 0;
    }
}

impl Drop for Condition {
    fn drop(Condition&mut self) {
        destroy(self);
    }
}
