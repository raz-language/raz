namespace std::sync::semaphore;


import std::sync::condition;
import std::sync::mutex;
import std::time;

extern fn raz_rt_alloc_aligned(i64 size, i64 alignment) -> usize;
extern fn raz_rt_dealloc_aligned(usize pointer, i64 alignment);
extern fn raz_rt_volatile_load_i64(usize address) -> i64;
extern fn raz_rt_volatile_store_i64(usize address, i64 value);
// Counting and wake policy live in Raz; only mutex/condition/allocation cross
// the native boundary.
const i64 SEM_PERMITS = 0;
const i64 SEM_MAXIMUM = 8;
const i64 SEM_MUTEX = 16;
const i64 SEM_CONDITION = 24;
const i64 SEM_BYTES = 32;

fn address(i8*mut semaphore) -> usize {
    usize value = 0;

    unsafe {
        value = semaphore as usize;
    }
    return value;
}

fn load(usize state, i64 offset) -> i64 {
    return raz_rt_volatile_load_i64(state + offset);
}

fn store(usize state, i64 offset, i64 value) {
    raz_rt_volatile_store_i64(state + offset, value);
}

fn deadline_after(i64 timeout_millis) -> i64 {
    i64 now = std::time::monotonic_nanos();

    if (timeout_millis <= 0) {
        return now;
    }
    if (timeout_millis > 9223372036854) {
        return 9223372036854775807;
    }

    i64 delta = timeout_millis * 1000000;

    if (now > 9223372036854775807 - delta) {
        return 9223372036854775807;
    }
    return now + delta;
}

fn remaining_millis(i64 deadline) -> i64 {
    i64 now = std::time::monotonic_nanos();

    if (now >= deadline) {
        return 0;
    }

    i64 nanos = deadline - now;
    i64 millis = nanos / 1000000;

    if (nanos % 1000000 != 0) {
        millis += 1;
    }
    return millis;
}

public fn semaphore_create(i64 initial, i64 maximum) -> i8*mut {
    if (initial < 0 || maximum <= 0 || initial > maximum) {
        unsafe {
            return 0 as i8*mut;
        }
    }

    usize state = raz_rt_alloc_aligned(SEM_BYTES, 8);

    if (state == 0) {
        unsafe {
            return 0 as i8*mut;
        }
    }

    usize mutex = std::sync::mutex::mutex_create_raw();
    usize condition = std::sync::condition::condition_create();

    if (mutex == 0 || condition == 0) {
        if (condition != 0) {
            std::sync::condition::condition_destroy(condition);
        }
        if (mutex != 0) {
            std::sync::mutex::mutex_destroy_raw(mutex);
        }
        raz_rt_dealloc_aligned(state, 8);
        unsafe {
            return 0 as i8*mut;
        }
    }
    store(state, SEM_PERMITS, initial);
    store(state, SEM_MAXIMUM, maximum);
    store(state, SEM_MUTEX, mutex as i64);
    store(state, SEM_CONDITION, condition as i64);
    unsafe {
        return state as i8*mut;
    }
}

public fn semaphore_destroy(i8*mut semaphore) {
    usize state = address(semaphore);

    if (state == 0) {
        return;
    }

    usize condition = load(state, SEM_CONDITION)as usize;
    usize mutex = load(state, SEM_MUTEX)as usize;

    if (condition != 0) {
        std::sync::condition::condition_destroy(condition);
    }
    if (mutex != 0) {
        std::sync::mutex::mutex_destroy_raw(mutex);
    }
    raz_rt_dealloc_aligned(state, 8);
}

public fn semaphore_acquire(i8*mut semaphore) -> bool {
    usize state = address(semaphore);

    if (state == 0) {
        return false;
    }

    usize mutex = load(state, SEM_MUTEX)as usize;
    usize condition = load(state, SEM_CONDITION)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);
    while (load(state, SEM_PERMITS) <= 0) {
        std::sync::condition::wait_raw(condition, mutex);
    }
    store(state, SEM_PERMITS, load(state, SEM_PERMITS) - 1);
    std::sync::mutex::mutex_unlock_raw(mutex);
    return true;
}

public fn semaphore_try_acquire(i8*mut semaphore) -> bool {
    usize state = address(semaphore);

    if (state == 0) {
        return false;
    }

    usize mutex = load(state, SEM_MUTEX)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);

    i64 permits = load(state, SEM_PERMITS);

    if (permits <= 0) {
        std::sync::mutex::mutex_unlock_raw(mutex);
        return false;
    }
    store(state, SEM_PERMITS, permits - 1);
    std::sync::mutex::mutex_unlock_raw(mutex);
    return true;
}

public fn semaphore_acquire_millis(i8*mut semaphore, i64 timeout_millis) -> bool {
    usize state = address(semaphore);

    if (state == 0 || timeout_millis < 0) {
        return false;
    }

    usize mutex = load(state, SEM_MUTEX)as usize;
    usize condition = load(state, SEM_CONDITION)as usize;
    i64 deadline = deadline_after(timeout_millis);

    std::sync::mutex::mutex_lock_raw(mutex);
    while (load(state, SEM_PERMITS) <= 0) {
        i64 remaining = remaining_millis(deadline);

        if (remaining <= 0) {
            std::sync::mutex::mutex_unlock_raw(mutex);
            return false;
        }
        std::sync::condition::wait_millis_raw(condition, mutex, remaining);
    }
    store(state, SEM_PERMITS, load(state, SEM_PERMITS) - 1);
    std::sync::mutex::mutex_unlock_raw(mutex);
    return true;
}

public fn semaphore_release(i8*mut semaphore, i64 count) -> i64 {
    usize state = address(semaphore);

    if (state == 0 || count <= 0) {
        return 0;
    }

    usize mutex = load(state, SEM_MUTEX)as usize;
    usize condition = load(state, SEM_CONDITION)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);

    i64 permits = load(state, SEM_PERMITS);
    i64 maximum = load(state, SEM_MAXIMUM);
    i64 available = maximum - permits;
    i64 released = count;

    if (released > available) {
        released = available;
    }
    if (released < 0) {
        released = 0;
    }
    store(state, SEM_PERMITS, permits + released);
    std::sync::mutex::mutex_unlock_raw(mutex);
    if (released == 1) {
        std::sync::condition::notify_one_raw(condition);
    } else if (released > 1) {
        std::sync::condition::notify_all_raw(condition);
    }
    return released;
}

public fn semaphore_available(i8*mut semaphore) -> i64 {
    usize state = address(semaphore);

    if (state == 0) {
        return 0;
    }

    usize mutex = load(state, SEM_MUTEX)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);

    i64 permits = load(state, SEM_PERMITS);

    std::sync::mutex::mutex_unlock_raw(mutex);
    return permits;
}
