namespace std::net::async_socket;

import alloc::string;
import std::net;
import std::thread::executor;

// Async socket operations are Raz worker-pool jobs over the synchronous native
// socket boundary. Hostnames and outbound payloads are copied into owned Raz
// strings so queued work never depends on the submitter's stack lifetime.
fn copy_host(usize host, i64 length) -> String {
    return alloc::string::from_bytes(host, length);
}

public fn tcp_connect(
    ExecutorI64&mut executor,
    usize host,
    i64 host_length,
    i64 port,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    if (host_length <= 0 || host == 0 || port < 0 || port > 65535) {
        return std::thread::executor::invalid_task();
    }

    String owned_host = copy_host(host, host_length);

    if (alloc::string::len(&owned_host) != host_length) {
        return std::thread::executor::invalid_task();
    }
    return std::thread::executor::submit(executor, move fn() -> i64 {
        return std::net::connect(alloc::string::data_ptr(&owned_host), alloc::string::len(&owned_host), port);
    }, timeout_millis);
}

public fn udp_connect(
    ExecutorI64&mut executor,
    usize host,
    i64 host_length,
    i64 port,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    if (host_length <= 0 || host == 0 || port < 0 || port > 65535) {
        return std::thread::executor::invalid_task();
    }

    String owned_host = copy_host(host, host_length);

    if (alloc::string::len(&owned_host) != host_length) {
        return std::thread::executor::invalid_task();
    }
    return std::thread::executor::submit(executor, move fn() -> i64 {
        return std::net::udp_connect(
            alloc::string::data_ptr(&owned_host),
            alloc::string::len(&owned_host),
            port,
        );
    }, timeout_millis);
}

public fn resolve_ipv4(
    ExecutorI64&mut executor,
    usize host,
    i64 host_length,
    usize output,
    i64 capacity,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    if (host_length <= 0 || host == 0 || output == 0 || capacity <= 0) {
        return std::thread::executor::invalid_task();
    }

    String owned_host = copy_host(host, host_length);

    if (alloc::string::len(&owned_host) != host_length) {
        return std::thread::executor::invalid_task();
    }
    return std::thread::executor::submit(executor, move fn() -> i64 {
        return std::net::resolve_ipv4(
            alloc::string::data_ptr(&owned_host),
            alloc::string::len(&owned_host),
            output,
            capacity,
        );
    }, timeout_millis);
}

public fn tcp_accept(ExecutorI64&mut executor, i64 listener, i64 timeout_millis) -> ExecutorTaskI64 {
    if (listener < 0) {
        return std::thread::executor::invalid_task();
    }
    return std::thread::executor::submit(executor, move fn() -> i64 {
        return std::net::accept(listener);
    }, timeout_millis);
}

public fn send(
    ExecutorI64&mut executor,
    i64 socket,
    usize data,
    i64 size,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    return send_mode(executor, socket, data, size, false, timeout_millis);
}

public fn send_all(
    ExecutorI64&mut executor,
    i64 socket,
    usize data,
    i64 size,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    return send_mode(executor, socket, data, size, true, timeout_millis);
}

fn send_mode(
    ExecutorI64&mut executor,
    i64 socket,
    usize data,
    i64 size,
    bool all,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    if (socket < 0 || size < 0 || (size > 0 && data == 0)) {
        return std::thread::executor::invalid_task();
    }

    String owned_data = alloc::string::from_bytes(data, size);

    if (size > 0 && alloc::string::len(&owned_data) != size) {
        return std::thread::executor::invalid_task();
    }
    return std::thread::executor::submit(executor, move fn() -> i64 {
        if (all) {
            return std::net::send_all(
                socket,
                alloc::string::data_ptr(&owned_data),
                alloc::string::len(&owned_data),
            );
        }
        return std::net::send(socket, alloc::string::data_ptr(&owned_data), alloc::string::len(&owned_data));
    }, timeout_millis);
}

public fn receive(
    ExecutorI64&mut executor,
    i64 socket,
    usize output,
    i64 capacity,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    if (socket < 0 || capacity < 0 || (capacity > 0 && output == 0)) {
        return std::thread::executor::invalid_task();
    }
    return std::thread::executor::submit(executor, move fn() -> i64 {
        return std::net::receive(socket, output, capacity);
    }, timeout_millis);
}

public fn receive_exact(
    ExecutorI64&mut executor,
    i64 socket,
    usize output,
    i64 size,
    i64 timeout_millis,
) -> ExecutorTaskI64 {
    if (socket < 0 || size < 0 || (size > 0 && output == 0)) {
        return std::thread::executor::invalid_task();
    }
    return std::thread::executor::submit(executor, move fn() -> i64 {
        return std::net::receive_exact(socket, output, size);
    }, timeout_millis);
}
