namespace std::net;
import core::result;
import std::io::error;
// Synchronous socket primitives. These wrappers expose bulk network operations
// without imposing an allocator, framing protocol, or scheduler on callers.
extern fn raz_rt_dns_resolve_ipv4(usize host, i64 host_length, usize output, i64 capacity) -> i64;
extern fn raz_rt_udp_bind(i64 port) -> i64;
extern fn raz_rt_udp_bind_host(usize host, i64 host_length, i64 port) -> i64;
extern fn raz_rt_udp_connect(usize host, i64 host_length, i64 port) -> i64;
extern fn raz_rt_socket_local_port(i64 socket) -> i64;
extern fn raz_rt_socket_family(i64 socket) -> i64;
extern fn raz_rt_socket_peer_port(i64 socket) -> i64;
extern fn raz_rt_socket_local_address(i64 socket, usize output, i64 capacity) -> i64;
extern fn raz_rt_socket_peer_address(i64 socket, usize output, i64 capacity) -> i64;
extern fn raz_rt_socket_set_nodelay(i64 socket, i64 enabled) -> i64;
extern fn raz_rt_socket_set_keepalive(i64 socket, i64 enabled) -> i64;
extern fn raz_rt_socket_set_reuse_address(i64 socket, i64 enabled) -> i64;
extern fn raz_rt_socket_set_buffer_sizes(i64 socket, i64 receive_size, i64 send_size) -> i64;
extern fn raz_rt_socket_set_timeout_millis(i64 socket, i64 receive_millis, i64 send_millis) -> i64;
extern fn raz_rt_socket_set_nonblocking(i64 socket, i64 enabled) -> i64;
extern fn raz_rt_socket_poll(i64 socket, i64 interests, i64 timeout_millis) -> i64;
extern fn raz_rt_socket_shutdown(i64 socket, i64 how) -> i64;
extern fn raz_rt_tcp_connect(usize host, i64 host_length, i64 port) -> i64;
extern fn raz_rt_tcp_listen(i64 port, i64 backlog) -> i64;
extern fn raz_rt_tcp_listen_host(usize host, i64 host_length, i64 port, i64 backlog) -> i64;
extern fn raz_rt_tcp_accept(i64 listener) -> i64;
extern fn raz_rt_socket_send(i64 socket, usize data, i64 size) -> i64;
extern fn raz_rt_socket_receive(i64 socket, usize data, i64 capacity) -> i64;
extern fn raz_rt_socket_close(i64 socket);

public fn resolve_ipv4(usize host, i64 length, usize output, i64 capacity) -> i64 {
    return raz_rt_dns_resolve_ipv4(host, length, output, capacity);
}

public fn connect(usize host, i64 length, i64 port) -> i64 {
    return raz_rt_tcp_connect(host, length, port);
}

public fn listen(i64 port, i64 backlog) -> i64 {
    return raz_rt_tcp_listen(port, backlog);
}

public fn listen_host(usize host, i64 host_length, i64 port, i64 backlog) -> i64 {
    return raz_rt_tcp_listen_host(host, host_length, port, backlog);
}

public fn listen_any(i64 port, i64 backlog) -> i64 {
    return raz_rt_tcp_listen_host(0, 0, port, backlog);
}

public fn accept(i64 listener) -> i64 {
    return raz_rt_tcp_accept(listener);
}

public fn send(i64 socket, usize data, i64 size) -> i64 {
    return raz_rt_socket_send(socket, data, size);
}

public fn receive(i64 socket, usize data, i64 capacity) -> i64 {
    return raz_rt_socket_receive(socket, data, capacity);
}

public fn send_all(i64 socket, usize data, i64 size) -> i64 {
    if (size < 0 || (size > 0 && data == 0)) {
        return -1;
    }

    i64 sent = 0;

    while (sent < size) {
        i64 count = raz_rt_socket_send(socket, data + sent, size - sent);

        if (count < 0) {
            return -1;
        }
        if (count == 0) {
            return sent;
        }
        sent += count;
    }
    return sent;
}

public fn receive_exact(i64 socket, usize data, i64 size) -> i64 {
    if (size < 0 || (size > 0 && data == 0)) {
        return -1;
    }

    i64 received = 0;

    while (received < size) {
        i64 count = raz_rt_socket_receive(socket, data + received, size - received);

        if (count < 0) {
            return -1;
        }
        if (count == 0) {
            return received;
        }
        received += count;
    }
    return received;
}

public fn close(i64 socket) {
    raz_rt_socket_close(socket);
}

public fn udp_bind(i64 port) -> i64 {
    return raz_rt_udp_bind(port);
}

public fn udp_bind_host(usize host, i64 host_length, i64 port) -> i64 {
    return raz_rt_udp_bind_host(host, host_length, port);
}

public fn udp_bind_any(i64 port) -> i64 {
    return raz_rt_udp_bind_host(0, 0, port);
}

public fn udp_connect(usize host, i64 length, i64 port) -> i64 {
    return raz_rt_udp_connect(host, length, port);
}

public fn local_port(i64 socket) -> i64 {
    return raz_rt_socket_local_port(socket);
}

public fn socket_family(i64 socket) -> i64 {
    return raz_rt_socket_family(socket);
}

public fn poll(i64 socket, i64 interests, i64 timeout_millis) -> i64 {
    return raz_rt_socket_poll(socket, interests, timeout_millis);
}

public fn set_nonblocking(i64 socket, bool enabled) -> bool {
    if (enabled) {
        return raz_rt_socket_set_nonblocking(socket, 1) == 1;
    }
    return raz_rt_socket_set_nonblocking(socket, 0) == 1;
}

public fn shutdown_read(i64 socket) -> bool {
    return raz_rt_socket_shutdown(socket, 0) == 1;
}

public fn shutdown_write(i64 socket) -> bool {
    return raz_rt_socket_shutdown(socket, 1) == 1;
}

public fn shutdown_both(i64 socket) -> bool {
    return raz_rt_socket_shutdown(socket, 2) == 1;
}

public fn peer_port(i64 socket) -> i64 {
    return raz_rt_socket_peer_port(socket);
}

public fn local_address(i64 socket, usize output, i64 capacity) -> i64 {
    return raz_rt_socket_local_address(socket, output, capacity);
}

public fn peer_address(i64 socket, usize output, i64 capacity) -> i64 {
    return raz_rt_socket_peer_address(socket, output, capacity);
}

public fn set_nodelay(i64 socket, bool enabled) -> bool {
    if (enabled) {
        return raz_rt_socket_set_nodelay(socket, 1) == 1;
    }
    return raz_rt_socket_set_nodelay(socket, 0) == 1;
}

public fn set_keepalive(i64 socket, bool enabled) -> bool {
    if (enabled) {
        return raz_rt_socket_set_keepalive(socket, 1) == 1;
    }
    return raz_rt_socket_set_keepalive(socket, 0) == 1;
}

public fn set_reuse_address(i64 socket, bool enabled) -> bool {
    if (enabled) {
        return raz_rt_socket_set_reuse_address(socket, 1) == 1;
    }
    return raz_rt_socket_set_reuse_address(socket, 0) == 1;
}

public fn set_buffer_sizes(i64 socket, i64 receive_size, i64 send_size) -> bool {
    return raz_rt_socket_set_buffer_sizes(socket, receive_size, send_size) == 1;
}

public fn set_timeout_millis(i64 socket, i64 receive_millis, i64 send_millis) -> bool {
    return raz_rt_socket_set_timeout_millis(socket, receive_millis, send_millis) == 1;
}

extern fn raz_rt_udp_send_to(i64 socket, usize host, i64 host_length, i64 port, usize data, i64 size) -> i64;
extern fn raz_rt_udp_receive_from(
    i64 socket,
    usize data,
    i64 capacity,
    usize address_output,
    i64 address_capacity,
    i64*mut port_output,
) -> i64;

public struct TcpStream {
    i64 socket;
}

public struct TcpListener {
    i64 socket;
}

public struct UdpSocket {
    i64 socket;
}

public fn tcp_stream_connect(usize host, i64 length, i64 port) -> TcpStream {
    return TcpStream {
        socket: raz_rt_tcp_connect(host, length, port)
    };
}

public fn tcp_stream_valid(TcpStream& stream) -> bool {
    return stream.socket >= 0;
}

public fn tcp_stream_send(TcpStream& stream, usize data, i64 size) -> i64 {
    return raz_rt_socket_send(stream.socket, data, size);
}

public fn tcp_stream_send_all(TcpStream& stream, usize data, i64 size) -> bool {
    return send_all(stream.socket, data, size) == size;
}

public fn tcp_stream_receive(TcpStream& stream, usize output, i64 capacity) -> i64 {
    return raz_rt_socket_receive(stream.socket, output, capacity);
}

public fn tcp_stream_receive_exact(TcpStream& stream, usize output, i64 size) -> bool {
    return receive_exact(stream.socket, output, size) == size;
}

public fn tcp_stream_shutdown(TcpStream& stream) -> bool {
    return raz_rt_socket_shutdown(stream.socket, 2) == 1;
}

public fn tcp_stream_close(TcpStream&mut stream) {
    if (stream.socket >= 0) {
        raz_rt_socket_close(stream.socket);
        stream.socket = -1;
    }
}

impl Drop for TcpStream {
    fn drop(TcpStream&mut self) {
        tcp_stream_close(self);
    }
}

public fn tcp_listener_bind(i64 port, i64 backlog) -> TcpListener {
    return TcpListener {
        socket: raz_rt_tcp_listen(port, backlog)
    };
}

public fn tcp_listener_bind_host(usize host, i64 host_length, i64 port, i64 backlog) -> TcpListener {
    return TcpListener {
        socket: raz_rt_tcp_listen_host(host, host_length, port, backlog)
    };
}

public fn tcp_listener_bind_any(i64 port, i64 backlog) -> TcpListener {
    return TcpListener {
        socket: raz_rt_tcp_listen_host(0, 0, port, backlog)
    };
}

public fn tcp_listener_valid(TcpListener& listener) -> bool {
    return listener.socket >= 0;
}

public fn tcp_listener_accept(TcpListener& listener) -> TcpStream {
    return TcpStream {
        socket: raz_rt_tcp_accept(listener.socket)
    };
}

public fn tcp_listener_close(TcpListener&mut listener) {
    if (listener.socket >= 0) {
        raz_rt_socket_close(listener.socket);
        listener.socket = -1;
    }
}

impl Drop for TcpListener {
    fn drop(TcpListener&mut self) {
        tcp_listener_close(self);
    }
}

public fn udp_socket_bind(i64 port) -> UdpSocket {
    return UdpSocket {
        socket: raz_rt_udp_bind(port)
    };
}

public fn udp_socket_bind_host(usize host, i64 host_length, i64 port) -> UdpSocket {
    return UdpSocket {
        socket: raz_rt_udp_bind_host(host, host_length, port)
    };
}

public fn udp_socket_bind_any(i64 port) -> UdpSocket {
    return UdpSocket {
        socket: raz_rt_udp_bind_host(0, 0, port)
    };
}

public fn udp_socket_connect(usize host, i64 length, i64 port) -> UdpSocket {
    return UdpSocket {
        socket: raz_rt_udp_connect(host, length, port)
    };
}

public fn udp_socket_valid(UdpSocket& socket) -> bool {
    return socket.socket >= 0;
}

public fn udp_socket_send(UdpSocket& socket, usize data, i64 size) -> i64 {
    return raz_rt_socket_send(socket.socket, data, size);
}

public fn udp_socket_receive(UdpSocket& socket, usize output, i64 capacity) -> i64 {
    return raz_rt_socket_receive(socket.socket, output, capacity);
}

public fn udp_socket_send_to(
    UdpSocket& socket,
    usize host,
    i64 host_length,
    i64 port,
    usize data,
    i64 size,
) -> i64 {
    return raz_rt_udp_send_to(socket.socket, host, host_length, port, data, size);
}

public fn udp_socket_receive_from(
    UdpSocket& socket,
    usize output,
    i64 capacity,
    usize address_output,
    i64 address_capacity,
    i64*mut port_output,
) -> i64 {
    return raz_rt_udp_receive_from(
        socket.socket,
        output,
        capacity,
        address_output,
        address_capacity,
        port_output,
    );
}

public fn udp_socket_close(UdpSocket&mut socket) {
    if (socket.socket >= 0) {
        raz_rt_socket_close(socket.socket);
        socket.socket = -1;
    }
}

impl Drop for UdpSocket {
    fn drop(UdpSocket&mut self) {
        udp_socket_close(self);
    }
}

/// Structured-error TCP/UDP wrappers. The original integer-returning surface is
/// preserved above for low-level callers and compatibility.
public fn try_tcp_stream_connect(usize host, i64 length, i64 port) -> Result<TcpStream, IoError> {
    i64 socket = raz_rt_tcp_connect(host, length, port);

    if (socket < 0) {
        return Result<TcpStream, IoError>::Error(last_error(IoOperation::Connect));
    }
    return Result<TcpStream, IoError>::Ok(TcpStream {
        socket: socket
    }
    );
}

public fn try_tcp_stream_send(TcpStream& stream, usize data, i64 size) -> Result<i64, IoError> {
    if (stream.socket < 0 || size < 0) {
        return Result<i64, IoError>::Error(error_with_code(IoOperation::Send, -1));
    }

    i64 count = raz_rt_socket_send(stream.socket, data, size);

    if (count < 0) {
        return Result<i64, IoError>::Error(last_error(IoOperation::Send));
    }
    return Result<i64, IoError>::Ok(count);
}

public fn try_tcp_stream_send_all(TcpStream& stream, usize data, i64 size) -> Result<bool, IoError> {
    if (stream.socket < 0 || size < 0) {
        return Result<bool, IoError>::Error(error_with_code(IoOperation::Send, -1));
    }

    i64 count = send_all(stream.socket, data, size);

    if (count < 0) {
        return Result<bool, IoError>::Error(last_error(IoOperation::Send));
    }
    if (count != size) {
        return Result<bool, IoError>::Error(error_with_code(IoOperation::Send, -1));
    }
    return Result<bool, IoError>::Ok(true);
}

public fn try_tcp_stream_receive(TcpStream& stream, usize output, i64 capacity) -> Result<i64, IoError> {
    if (stream.socket < 0 || capacity < 0) {
        return Result<i64, IoError>::Error(error_with_code(IoOperation::Receive, -1));
    }

    i64 count = raz_rt_socket_receive(stream.socket, output, capacity);

    if (count < 0) {
        return Result<i64, IoError>::Error(last_error(IoOperation::Receive));
    }
    return Result<i64, IoError>::Ok(count);
}

public fn try_tcp_stream_receive_exact(TcpStream& stream, usize output, i64 size) -> Result<bool, IoError> {
    if (stream.socket < 0 || size < 0) {
        return Result<bool, IoError>::Error(error_with_code(IoOperation::Receive, -1));
    }

    i64 count = receive_exact(stream.socket, output, size);

    if (count < 0) {
        return Result<bool, IoError>::Error(last_error(IoOperation::Receive));
    }
    if (count != size) {
        return Result<bool, IoError>::Error(error_with_code(IoOperation::Receive, -1));
    }
    return Result<bool, IoError>::Ok(true);
}

public fn try_tcp_listener_bind(i64 port, i64 backlog) -> Result<TcpListener, IoError> {
    i64 socket = raz_rt_tcp_listen(port, backlog);

    if (socket < 0) {
        return Result<TcpListener, IoError>::Error(last_error(IoOperation::Listen));
    }
    return Result<TcpListener, IoError>::Ok(TcpListener {
        socket: socket
    }
    );
}

public fn try_tcp_listener_accept(TcpListener& listener) -> Result<TcpStream, IoError> {
    if (listener.socket < 0) {
        return Result<TcpStream, IoError>::Error(error_with_code(IoOperation::Accept, -1));
    }

    i64 socket = raz_rt_tcp_accept(listener.socket);

    if (socket < 0) {
        return Result<TcpStream, IoError>::Error(last_error(IoOperation::Accept));
    }
    return Result<TcpStream, IoError>::Ok(TcpStream {
        socket: socket
    }
    );
}

public fn try_udp_socket_bind(i64 port) -> Result<UdpSocket, IoError> {
    i64 socket = raz_rt_udp_bind(port);

    if (socket < 0) {
        return Result<UdpSocket, IoError>::Error(last_error(IoOperation::Bind));
    }
    return Result<UdpSocket, IoError>::Ok(UdpSocket {
        socket: socket
    }
    );
}

public fn try_udp_socket_connect(usize host, i64 length, i64 port) -> Result<UdpSocket, IoError> {
    i64 socket = raz_rt_udp_connect(host, length, port);

    if (socket < 0) {
        return Result<UdpSocket, IoError>::Error(last_error(IoOperation::Connect));
    }
    return Result<UdpSocket, IoError>::Ok(UdpSocket {
        socket: socket
    }
    );
}

public fn try_udp_socket_send(UdpSocket& socket, usize data, i64 size) -> Result<i64, IoError> {
    if (socket.socket < 0 || size < 0) {
        return Result<i64, IoError>::Error(error_with_code(IoOperation::Send, -1));
    }

    i64 count = raz_rt_socket_send(socket.socket, data, size);

    if (count < 0) {
        return Result<i64, IoError>::Error(last_error(IoOperation::Send));
    }
    return Result<i64, IoError>::Ok(count);
}

public fn try_udp_socket_receive(UdpSocket& socket, usize output, i64 capacity) -> Result<i64, IoError> {
    if (socket.socket < 0 || capacity < 0) {
        return Result<i64, IoError>::Error(error_with_code(IoOperation::Receive, -1));
    }

    i64 count = raz_rt_socket_receive(socket.socket, output, capacity);

    if (count < 0) {
        return Result<i64, IoError>::Error(last_error(IoOperation::Receive));
    }
    return Result<i64, IoError>::Ok(count);
}

public fn try_udp_socket_send_to(
    UdpSocket& socket,
    usize host,
    i64 host_length,
    i64 port,
    usize data,
    i64 size,
) -> Result<i64, IoError> {
    if (socket.socket < 0 || size < 0) {
        return Result<i64, IoError>::Error(error_with_code(IoOperation::Send, -1));
    }

    i64 count = raz_rt_udp_send_to(socket.socket, host, host_length, port, data, size);

    if (count < 0) {
        return Result<i64, IoError>::Error(last_error(IoOperation::Send));
    }
    return Result<i64, IoError>::Ok(count);
}

public fn try_udp_socket_receive_from(
    UdpSocket& socket,
    usize output,
    i64 capacity,
    usize address_output,
    i64 address_capacity,
    i64*mut port_output,
) -> Result<i64, IoError> {
    if (socket.socket < 0 || capacity < 0) {
        return Result<i64, IoError>::Error(error_with_code(IoOperation::Receive, -1));
    }
    i64 count = raz_rt_udp_receive_from(
        socket.socket,
        output,
        capacity,
        address_output,
        address_capacity,
        port_output,
    );
    if (count < 0) {
        return Result<i64, IoError>::Error(last_error(IoOperation::Receive));
    }
    return Result<i64, IoError>::Ok(count);
}

/// Stable endpoint accessors for owning socket wrappers.
public fn tcp_stream_local_port(TcpStream& stream) -> i64 {
    if (stream.socket < 0) {
        return -1;
    }
    return raz_rt_socket_local_port(stream.socket);
}

public fn tcp_stream_peer_port(TcpStream& stream) -> i64 {
    if (stream.socket < 0) {
        return -1;
    }
    return raz_rt_socket_peer_port(stream.socket);
}

public fn tcp_listener_local_port(TcpListener& listener) -> i64 {
    if (listener.socket < 0) {
        return -1;
    }
    return raz_rt_socket_local_port(listener.socket);
}

public fn udp_socket_local_port(UdpSocket& socket) -> i64 {
    if (socket.socket < 0) {
        return -1;
    }
    return raz_rt_socket_local_port(socket.socket);
}
