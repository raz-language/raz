namespace std::net::url::query;
import core::bytes;

fn load_byte_fast(usize address) -> i64 {
    unsafe {
        return (*((address)as u8*const))as i64;
    }
}
/// Allocation-free iterator over a raw URL query string. Decoding is separate
/// so callers that only route/compare keys never allocate.
public struct QueryIterator {
    BytesView source;
    i64 cursor;
}

public struct QueryPair {
    BytesView key;
    BytesView value;
    bool has_value;
}

public fn pairs(BytesView source) -> QueryIterator {
    return QueryIterator {
        source: source,
        cursor: 0
    };
}

public fn next(QueryIterator&mut iterator, QueryPair&mut output) -> bool {
    if (iterator.cursor >= iterator.source.length) {
        return false;
    }

    i64 start = iterator.cursor;
    i64 end = start;

    while (end < iterator.source.length && load_byte_fast(iterator.source.data + end) != 38) {
        end += 1;
    }

    i64 equal = start;

    while (equal < end && load_byte_fast(iterator.source.data + equal) != 61) {
        equal += 1;
    }
    if (equal < end) {
        *output = QueryPair {
            key: BytesView {
                data: iterator.source.data + start,
                length: equal - start
            },
            value: BytesView {
                data: iterator.source.data + equal + 1,
                length: end - equal - 1
            },
            has_value: true,
        };
    } else {
        *output = QueryPair {
            key: BytesView {
                data: iterator.source.data + start,
                length: end - start
            },
            value: BytesView {
                data: iterator.source.data + end,
                length: 0
            },
            has_value: false,
        };
    }
    iterator.cursor = end;
    if (iterator.cursor < iterator.source.length) {
        iterator.cursor += 1;
    }
    return true;
}
