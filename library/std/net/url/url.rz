namespace std::net::url;


import core::ascii;
import core::bytes;
import core::result;

fn load_byte_fast(usize address) -> i64 {
    unsafe {
        return (*((address)as u8*const))as i64;
    }
}

public enum UrlError {
    Empty,
    InvalidScheme,
    MissingHost,
    InvalidPort,
    UnsupportedIpv6Literal,
}

/// Borrowed URL components. Every BytesView points into the original input.
public struct UrlView {
    BytesView source;
    BytesView scheme;
    BytesView host;
    i64 port;
    bool explicit_port;
    BytesView path;
    BytesView query;
    BytesView fragment;
}

fn empty_at(usize data, i64 offset) -> BytesView {
    return BytesView {
        data: data + offset,
        length: 0
    };
}

fn valid_scheme_byte(i64 byte, bool first) -> bool {
    if (first) {
        return core::ascii::is_alpha(byte);
    }
    return core::ascii::is_alphanumeric(byte) || byte == 43 || byte == 45 || byte == 46;
}

fn scheme_is(BytesView scheme, i64 a, i64 b, i64 c, i64 d, i64 e) -> bool {
    if (scheme.length == 4) {
        return (
            core::ascii::to_lower(load_byte_fast(scheme.data)) == a &&
            core::ascii::to_lower(load_byte_fast(scheme.data + 1)) == b &&
            core::ascii::to_lower(load_byte_fast(scheme.data + 2)) == c &&
            core::ascii::to_lower(load_byte_fast(scheme.data + 3)) == d
        );
    }
    if (scheme.length == 5) {
        return (
            core::ascii::to_lower(load_byte_fast(scheme.data)) == a &&
            core::ascii::to_lower(load_byte_fast(scheme.data + 1)) == b &&
            core::ascii::to_lower(load_byte_fast(scheme.data + 2)) == c &&
            core::ascii::to_lower(load_byte_fast(scheme.data + 3)) == d &&
            core::ascii::to_lower(load_byte_fast(scheme.data + 4)) == e
        );
    }
    return false;
}

public fn is_http(UrlView& value) -> bool {
    return value.scheme.length == 4 && scheme_is(value.scheme, 104, 116, 116, 112, 0);
}

public fn is_https(UrlView& value) -> bool {
    return value.scheme.length == 5 && scheme_is(value.scheme, 104, 116, 116, 112, 115);
}

fn default_port(BytesView scheme) -> i64 {
    if (scheme_is(scheme, 104, 116, 116, 112, 0)) {
        return 80;
    }
    if (scheme_is(scheme, 104, 116, 116, 112, 115)) {
        return 443;
    }
    return 0;
}

public fn parse(usize data, i64 length) -> Result<UrlView, UrlError> {
    if (length <= 0 || data == 0) {
        return Result<UrlView, UrlError>::Error(UrlError::Empty);
    }

    i64 scheme_end = 0;

    while (scheme_end < length && load_byte_fast(data + scheme_end) != 58) {
        if (!valid_scheme_byte(load_byte_fast(data + scheme_end), scheme_end == 0)) {
            return Result<UrlView, UrlError>::Error(UrlError::InvalidScheme);
        }
        scheme_end += 1;
    }
    if (
        scheme_end == 0 ||
        scheme_end + 2 >= length ||
        load_byte_fast(data + scheme_end) != 58 ||
        load_byte_fast(data + scheme_end + 1) != 47 ||
        load_byte_fast(data + scheme_end + 2) != 47
    ) {
        return Result<UrlView, UrlError>::Error(UrlError::InvalidScheme);
    }
    BytesView scheme = BytesView {
        data: data,
        length: scheme_end
    };

    i64 cursor = scheme_end + 3;

    if (cursor >= length) {
        return Result<UrlView, UrlError>::Error(UrlError::MissingHost);
    }

    i64 host_start = cursor;

    BytesView host = BytesView {
        data: 0,
        length: 0
    };
    if (load_byte_fast(data + cursor) == 91) {
        // RFC 3986 IP-literal host. UrlView exposes the literal contents
        // without brackets so it can be passed directly to the resolver.
        host_start = cursor + 1;
        cursor = host_start;
        while (cursor < length && load_byte_fast(data + cursor) != 93) {
            cursor += 1;
        }
        if (cursor >= length || cursor == host_start) {
            return Result<UrlView, UrlError>::Error(UrlError::MissingHost);
        }
        host = BytesView {
            data: data + host_start,
            length: cursor - host_start
        };
        cursor += 1;
        if (cursor < length) {
            i64 next = load_byte_fast(data + cursor);

            if (next != 58 && next != 47 && next != 63 && next != 35) {
                return Result<UrlView, UrlError>::Error(UrlError::MissingHost);
            }
        }
    } else {
        while (cursor < length) {
            i64 byte = load_byte_fast(data + cursor);

            if (byte == 58 || byte == 47 || byte == 63 || byte == 35) {
                break;
            }
            cursor += 1;
        }
        if (cursor == host_start) {
            return Result<UrlView, UrlError>::Error(UrlError::MissingHost);
        }
        host = BytesView {
            data: data + host_start,
            length: cursor - host_start
        };
    }

    i64 port = default_port(scheme);
    bool explicit_port = false;

    if (cursor < length && load_byte_fast(data + cursor) == 58) {
        explicit_port = true;
        cursor += 1;

        i64 port_start = cursor;
        i64 parsed_port = 0;

        while (cursor < length) {
            i64 byte = load_byte_fast(data + cursor);

            if (byte == 47 || byte == 63 || byte == 35) {
                break;
            }
            if (!core::ascii::is_digit(byte)) {
                return Result<UrlView, UrlError>::Error(UrlError::InvalidPort);
            }
            parsed_port = parsed_port * 10 + core::ascii::digit_value(byte);
            if (parsed_port > 65535) {
                return Result<UrlView, UrlError>::Error(UrlError::InvalidPort);
            }
            cursor += 1;
        }
        if (cursor == port_start || parsed_port <= 0) {
            return Result<UrlView, UrlError>::Error(UrlError::InvalidPort);
        }
        port = parsed_port;
    }

    i64 path_start = cursor;

    if (cursor < length && load_byte_fast(data + cursor) == 47) {
        while (
            cursor < length &&
            load_byte_fast(data + cursor) != 63 &&
            load_byte_fast(data + cursor) != 35
        ) {
            cursor += 1;
        }
    } else {
        path_start = cursor;
    }
    BytesView path = BytesView {
        data: data + path_start,
        length: cursor - path_start
    };

    BytesView query = empty_at(data, cursor);
    BytesView fragment = empty_at(data, cursor);

    if (cursor < length && load_byte_fast(data + cursor) == 63) {
        cursor += 1;

        i64 query_start = cursor;

        while (cursor < length && load_byte_fast(data + cursor) != 35) {
            cursor += 1;
        }
        query = BytesView {
            data: data + query_start,
            length: cursor - query_start
        };
    }
    if (cursor < length && load_byte_fast(data + cursor) == 35) {
        cursor += 1;
        fragment = BytesView {
            data: data + cursor,
            length: length - cursor
        };
    }
    return Result<UrlView, UrlError>::Ok(UrlView {
        source: BytesView {
            data: data,
            length: length
        },
        scheme: scheme,
        host: host,
        port: port,
        explicit_port: explicit_port,
        path: path,
        query: query,
        fragment: fragment,
    }
    );
}
