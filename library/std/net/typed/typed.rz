namespace std::net::typed;

import alloc::string;
import core::result;
import std::io::error;
import std::net;
import std::net::address;

/// Converts a typed endpoint to the host/port form required by the permanent
/// socket ABI boundary. The temporary owned String keeps the host bytes alive
/// for the duration of the runtime call.
public fn try_tcp_connect(SocketAddress& endpoint) -> Result<TcpStream, IoError> {
    Ipv4Address address = std::net::address::socket_address_ipv4(endpoint);
    String host = std::net::address::ipv4_to_string(&address);

    return std::net::try_tcp_stream_connect(
        alloc::string::data_ptr(&host),
        alloc::string::len(&host),
        std::net::address::socket_address_port(endpoint),
    );
}

public fn try_udp_connect(SocketAddress& endpoint) -> Result<UdpSocket, IoError> {
    Ipv4Address address = std::net::address::socket_address_ipv4(endpoint);
    String host = std::net::address::ipv4_to_string(&address);

    return std::net::try_udp_socket_connect(
        alloc::string::data_ptr(&host),
        alloc::string::len(&host),
        std::net::address::socket_address_port(endpoint),
    );
}

public fn try_udp_send_to(
    UdpSocket& socket,
    SocketAddress& endpoint,
    usize data,
    i64 size,
) -> Result<i64, IoError> {
    Ipv4Address address = std::net::address::socket_address_ipv4(endpoint);
    String host = std::net::address::ipv4_to_string(&address);

    return std::net::try_udp_socket_send_to(
        socket,
        alloc::string::data_ptr(&host),
        alloc::string::len(&host),
        std::net::address::socket_address_port(endpoint),
        data,
        size,
    );
}
