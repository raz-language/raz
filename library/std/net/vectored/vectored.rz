namespace std::net::vectored;
import std::net;
// Reusable scatter/gather descriptor storage. The descriptor layout is exactly
// two machine words (data pointer, byte length). POSIX can consume it directly
// as iovec; Windows translates at the ABI boundary into a fixed stack WSABUF
// array. No per-call Raz allocation is required once this vector is created.
extern fn raz_rt_alloc_aligned(i64 size, i64 alignment) -> usize;
extern fn raz_rt_dealloc_aligned(usize pointer, i64 alignment);
extern fn raz_rt_volatile_store_i64(usize address, i64 value);
extern fn raz_rt_socket_send_vectored(i64 socket, usize slices, i64 count) -> i64;
extern fn raz_rt_socket_receive_vectored(i64 socket, usize slices, i64 count) -> i64;

public struct IoVector {
    usize data;
    i64 length;
    i64 capacity;
}

public fn create(i64 capacity) -> IoVector {
    if (capacity <= 0 || capacity > 64) {
        return IoVector {
            data: 0,
            length: 0,
            capacity: 0
        };
    }

    usize data = raz_rt_alloc_aligned(capacity * 16, 8);

    if (data == 0) {
        return IoVector {
            data: 0,
            length: 0,
            capacity: 0
        };
    }
    return IoVector {
        data: data,
        length: 0,
        capacity: capacity
    };
}

public fn valid(IoVector& vector) -> bool {
    return vector.data != 0 && vector.capacity > 0;
}

public fn len(IoVector& vector) -> i64 {
    return vector.length;
}

public fn capacity(IoVector& vector) -> i64 {
    return vector.capacity;
}

public fn clear(IoVector&mut vector) {
    vector.length = 0;
}

public fn push(IoVector&mut vector, usize data, i64 length) -> bool {
    if (!valid(vector) || vector.length >= vector.capacity || length < 0 || (length > 0 && data == 0)) {
        return false;
    }

    usize record = vector.data + vector.length * 16;

    raz_rt_volatile_store_i64(record, data as i64);
    raz_rt_volatile_store_i64(record + 8, length);
    vector.length += 1;
    return true;
}

public fn send(i64 socket, IoVector& vector) -> i64 {
    if (!valid(vector) || vector.length <= 0) {
        return -1;
    }
    return raz_rt_socket_send_vectored(socket, vector.data, vector.length);
}

public fn receive(i64 socket, IoVector& vector) -> i64 {
    if (!valid(vector) || vector.length <= 0) {
        return -1;
    }
    return raz_rt_socket_receive_vectored(socket, vector.data, vector.length);
}

public fn send_tcp(TcpStream& stream, IoVector& vector) -> i64 {
    if (!std::net::tcp_stream_valid(stream)) {
        return -1;
    }
    return send(stream.socket, vector);
}

public fn receive_tcp(TcpStream& stream, IoVector& vector) -> i64 {
    if (!std::net::tcp_stream_valid(stream)) {
        return -1;
    }
    return receive(stream.socket, vector);
}

public fn destroy(IoVector&mut vector) {
    if (vector.data != 0) {
        raz_rt_dealloc_aligned(vector.data, 8);
    }
    vector.data = 0;
    vector.length = 0;
    vector.capacity = 0;
}

impl Drop for IoVector {
    fn drop(IoVector&mut self) {
        destroy(self);
    }
}
