namespace std::time;


extern fn raz_rt_time_unix_millis() -> i64;
extern fn raz_rt_time_monotonic_nanos() -> i64;
extern fn raz_rt_sleep_millis(i64 millis);

public fn unix_millis() -> i64 {
    return raz_rt_time_unix_millis();
}

public fn monotonic_nanos() -> i64 {
    return raz_rt_time_monotonic_nanos();
}

public fn sleep_millis(i64 millis) {
    raz_rt_sleep_millis(millis);
}

public struct Duration {
    i64 nanos;
}

public struct Instant {
    i64 nanos;
}

public fn nanoseconds(i64 value) -> Duration {
    return Duration {
        nanos: value
    };
}

public fn milliseconds(i64 value) -> Duration {
    if (value > 9223372036854775) {
        return Duration {
            nanos: 9223372036854775807
        };
    }
    if (value < -9223372036854775) {
        return Duration {
            nanos: -9223372036854775807
        };
    }
    return Duration {
        nanos: value * 1000000
    };
}

public fn seconds(i64 value) -> Duration {
    if (value > 9223372036) {
        return Duration {
            nanos: 9223372036854775807
        };
    }
    if (value < -9223372036) {
        return Duration {
            nanos: -9223372036854775807
        };
    }
    return Duration {
        nanos: value * 1000000000
    };
}

public fn as_nanos(Duration& value) -> i64 {
    return value.nanos;
}

public fn as_millis(Duration& value) -> i64 {
    return value.nanos / 1000000;
}

public fn as_seconds(Duration& value) -> i64 {
    return value.nanos / 1000000000;
}

public fn now() -> Instant {
    return Instant {
        nanos: monotonic_nanos()
    };
}

public fn elapsed(Instant& start) -> Duration {
    i64 current = monotonic_nanos();

    if (current < start.nanos) {
        return Duration {
            nanos: 0
        };
    }
    return Duration {
        nanos: current - start.nanos
    };
}

public fn sleep(Duration& duration) {
    if (duration.nanos <= 0) {
        return;
    }

    i64 millis = duration.nanos / 1000000;

    if (duration.nanos % 1000000 != 0) {
        millis += 1;
    }
    sleep_millis(millis);
}

public fn duration_add(Duration& left, Duration& right) -> Duration {
    if (right.nanos > 0 && left.nanos > 9223372036854775807 - right.nanos) {
        return Duration { nanos: 9223372036854775807 };
    }
    if (right.nanos < 0 && left.nanos < -9223372036854775807 - right.nanos) {
        return Duration { nanos: -9223372036854775807 };
    }
    return Duration { nanos: left.nanos + right.nanos };
}

public fn instant_add(Instant& instant, Duration& duration) -> Instant {
    if (duration.nanos <= 0) {
        return Instant { nanos: instant.nanos };
    }
    if (instant.nanos > 9223372036854775807 - duration.nanos) {
        return Instant { nanos: 9223372036854775807 };
    }
    return Instant { nanos: instant.nanos + duration.nanos };
}

public fn remaining(Instant& deadline) -> Duration {
    i64 current = monotonic_nanos();

    if (current >= deadline.nanos) {
        return Duration { nanos: 0 };
    }
    return Duration { nanos: deadline.nanos - current };
}

public fn reached(Instant& deadline) -> bool {
    return monotonic_nanos() >= deadline.nanos;
}
