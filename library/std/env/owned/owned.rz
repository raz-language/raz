namespace std::env::owned;

import std::env;
import alloc::string;
import core::option;
import core::result;
import std::io::error;

public enum EnvError {
    Io(IoError),
    OutOfMemory,
}

public fn get_string(usize name, i64 name_length) -> Option<String> {
    i64 required = std::env::get(name, name_length, 0, 0);

    if (required < 0) {
        return Option<String>::None;
    }

    String value = alloc::string::with_capacity(required);

    if (required > 0 && alloc::string::data_ptr(&value) == 0) {
        return Option<String>::None;
    }

    i64 actual = std::env::get(name, name_length, alloc::string::data_ptr(&value), required + 1);

    if (actual < 0 || actual > required) {
        return Option<String>::None;
    }
    unsafe {
        if (!alloc::string::set_len_initialized(&mut value, actual)) {
            return Option<String>::None;
        }
    }
    return Option<String>::Some(move value);
}

public fn current_dir_string() -> Result<String, EnvError> {
    i64 required = std::env::current_dir(0, 0);

    if (required < 0) {
        return Result<String, EnvError>::Error(EnvError::Io(last_error(IoOperation::Metadata)));
    }

    String value = alloc::string::with_capacity(required);

    if (required > 0 && alloc::string::data_ptr(&value) == 0) {
        return Result<String, EnvError>::Error(EnvError::OutOfMemory);
    }

    i64 actual = std::env::current_dir(alloc::string::data_ptr(&value), required + 1);

    if (actual < 0 || actual > required) {
        return Result<String, EnvError>::Error(EnvError::Io(last_error(IoOperation::Metadata)));
    }
    unsafe {
        if (!alloc::string::set_len_initialized(&mut value, actual)) {
            return Result<String, EnvError>::Error(EnvError::OutOfMemory);
        }
    }
    return Result<String, EnvError>::Ok(move value);
}

public fn get_name(String& name) -> Option<String> {
    return get_string(alloc::string::data_ptr(name), alloc::string::len(name));
}

public fn set_value(String& name, String& value) -> bool {
    return std::env::set(
        alloc::string::data_ptr(name),
        alloc::string::len(name),
        alloc::string::data_ptr(value),
        alloc::string::len(value),
    );
}

public fn remove_name(String& name) -> bool {
    return std::env::remove(alloc::string::data_ptr(name), alloc::string::len(name));
}
