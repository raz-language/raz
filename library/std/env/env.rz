namespace std::env;


extern fn raz_rt_env_get(usize name, i64 name_length, usize output, i64 capacity) -> i64;
extern fn raz_rt_current_dir(usize output, i64 capacity) -> i64;

public fn get(usize name, i64 name_length, usize output, i64 capacity) -> i64 {
    return raz_rt_env_get(name, name_length, output, capacity);
}

public fn current_dir(usize output, i64 capacity) -> i64 {
    return raz_rt_current_dir(output, capacity);
}

extern fn raz_rt_env_set(usize name, i64 name_length, usize value, i64 value_length) -> i64;
extern fn raz_rt_env_remove(usize name, i64 name_length) -> i64;

public fn set(usize name, i64 name_length, usize value, i64 value_length) -> bool {
    return raz_rt_env_set(name, name_length, value, value_length) == 1;
}

public fn remove(usize name, i64 name_length) -> bool {
    return raz_rt_env_remove(name, name_length) == 1;
}
