namespace std::env::path;

import alloc::string;
import core::result;
import std::env::owned;
import std::path::buf;

public fn current_dir() -> Result<PathBuf, EnvError> {
    Result<String, EnvError> result = std::env::owned::current_dir_string();

    match result {
        Result<String, EnvError>::Error(error) => {
            return Result<PathBuf, EnvError>::Error(error);
        }
        Result<String, EnvError>::Ok(value) => {
            PathBuf path = PathBuf {
                storage: move value
            };
            if (!path.normalize()) {
                return Result<PathBuf, EnvError>::Error(EnvError::OutOfMemory);
            }
            return Result<PathBuf, EnvError>::Ok(move path);
        }
    }
}
