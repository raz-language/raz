namespace std::thread::pool;
import std::sync::mutex;
import std::sync::condition;
import std::time;
// Raz-owned persistent worker pool. Native code contributes only allocation,
// OS synchronization/thread primitives, and erased-callable dispatch. Queue
// policy, backpressure, worker lifecycle, result state, cancellation and idle
// detection are implemented here.
extern fn raz_rt_alloc_aligned(i64 size, i64 alignment) -> usize;
extern fn raz_rt_dealloc_aligned(usize pointer, i64 alignment);
extern fn raz_rt_volatile_load_i64(usize address) -> i64;
extern fn raz_rt_volatile_store_i64(usize address, i64 value);
extern fn raz_rt_task_spawn_callable_i64(FnOnce() -> i64 operation) -> i8*mut;
extern fn raz_rt_task_join_i64(i8*mut task) -> i64;
extern fn raz_rt_callable_into_raw(FnOnce() -> i64 operation) -> usize;
extern fn raz_rt_callable_invoke_once_i64_raw(usize callable) -> i64;
extern fn raz_rt_callable_destroy_raw(usize callable);
const i64 POOL_BYTES = 120;
const i64 RESULT_BYTES = 32;
// Pool state offsets (all 8-byte slots).
const i64 P_QUEUE = 0;
const i64 P_CAPACITY = 8;
const i64 P_MASK = 16;
const i64 P_HEAD = 24;
const i64 P_TAIL = 32;
const i64 P_COUNT = 40;
const i64 P_MUTEX = 48;
const i64 P_NOT_EMPTY = 56;
const i64 P_NOT_FULL = 64;
const i64 P_IDLE = 72;
const i64 P_ACTIVE = 80;
const i64 P_ACCEPTING = 88;
const i64 P_STOPPING = 96;
const i64 P_WORKERS = 104;
const i64 P_WORKER_COUNT = 112;
// Result state: mutex, condition, status, value.
const i64 R_MUTEX = 0;
const i64 R_CONDITION = 8;
const i64 R_STATUS = 16;
const i64 R_VALUE = 24;

public struct WorkerPoolI64 {
    usize state;
}

public struct PoolTaskI64 {
    usize state;
}

public struct PoolTaskResultI64 {
    i64 status;
    i64 value;
}

fn load(usize base, i64 offset) -> i64 {
    return raz_rt_volatile_load_i64(base + offset);
}

fn store(usize base, i64 offset, i64 value) {
    raz_rt_volatile_store_i64(base + offset, value);
}

fn normalized_capacity(i64 requested) -> i64 {
    if (requested <= 0) {
        return 0;
    }

    i64 capacity = 1;

    while (capacity < requested) {
        if (capacity > 288230376151711743) {
            return 0;
        }
        capacity *= 2;
    }
    return capacity;
}

fn result_create() -> usize {
    usize state = raz_rt_alloc_aligned(RESULT_BYTES, 8);

    if (state == 0) {
        return 0;
    }

    usize mutex = std::sync::mutex::mutex_create_raw();
    usize condition = std::sync::condition::condition_create();

    if (mutex == 0 || condition == 0) {
        if (condition != 0) {
            std::sync::condition::condition_destroy(condition);
        }
        if (mutex != 0) {
            std::sync::mutex::mutex_destroy_raw(mutex);
        }
        raz_rt_dealloc_aligned(state, 8);
        return 0;
    }
    store(state, R_MUTEX, mutex as i64);
    store(state, R_CONDITION, condition as i64);
    store(state, R_STATUS, 0);
    store(state, R_VALUE, 0);
    return state;
}

fn result_finish(usize state, i64 status, i64 value) -> bool {
    if (state == 0) {
        return false;
    }

    usize mutex = load(state, R_MUTEX)as usize;
    usize condition = load(state, R_CONDITION)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);
    if (load(state, R_STATUS) != 0) {
        std::sync::mutex::mutex_unlock_raw(mutex);
        return false;
    }
    store(state, R_VALUE, value);
    store(state, R_STATUS, status);
    std::sync::mutex::mutex_unlock_raw(mutex);
    std::sync::condition::notify_all_raw(condition);
    return true;
}

fn deadline_nanos(i64 timeout_millis) -> i64 {
    i64 now = std::time::monotonic_nanos();

    if (timeout_millis <= 0) {
        return now;
    }
    if (timeout_millis > 9223372036854) {
        return 9223372036854775807;
    }

    i64 delta = timeout_millis * 1000000;

    if (now > 9223372036854775807 - delta) {
        return 9223372036854775807;
    }
    return now + delta;
}

fn remaining_millis(i64 deadline) -> i64 {
    i64 now = std::time::monotonic_nanos();

    if (now >= deadline) {
        return 0;
    }

    i64 remaining = deadline - now;
    i64 millis = remaining / 1000000;

    if (remaining % 1000000 != 0) {
        millis += 1;
    }
    return millis;
}

public fn task_valid(PoolTaskI64& task) -> bool {
    return task.state != 0;
}

public fn task_try_result(PoolTaskI64& task) -> PoolTaskResultI64 {
    if (task.state == 0) {
        return PoolTaskResultI64 {
            status: -2,
            value: 0
        };
    }

    usize mutex = load(task.state, R_MUTEX)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);
    PoolTaskResultI64 result = PoolTaskResultI64 {
        status: load(task.state, R_STATUS),
        value: load(task.state, R_VALUE)
    };
    std::sync::mutex::mutex_unlock_raw(mutex);
    return result;
}

public fn task_wait(PoolTaskI64& task) -> PoolTaskResultI64 {
    if (task.state == 0) {
        return PoolTaskResultI64 {
            status: -2,
            value: 0
        };
    }

    usize mutex = load(task.state, R_MUTEX)as usize;
    usize condition = load(task.state, R_CONDITION)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);
    while (load(task.state, R_STATUS) == 0) {
        std::sync::condition::wait_raw(condition, mutex);
    }
    PoolTaskResultI64 result = PoolTaskResultI64 {
        status: load(task.state, R_STATUS),
        value: load(task.state, R_VALUE)
    };
    std::sync::mutex::mutex_unlock_raw(mutex);
    return result;
}

// status 0 means timeout, 1 complete, -1 cancelled, -2 invalid.
public fn task_wait_millis(PoolTaskI64& task, i64 timeout_millis) -> PoolTaskResultI64 {
    if (task.state == 0 || timeout_millis < 0) {
        return PoolTaskResultI64 {
            status: -2,
            value: 0
        };
    }

    i64 deadline = deadline_nanos(timeout_millis);
    usize mutex = load(task.state, R_MUTEX)as usize;
    usize condition = load(task.state, R_CONDITION)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);
    while (load(task.state, R_STATUS) == 0) {
        i64 remaining = remaining_millis(deadline);

        if (remaining <= 0) {
            std::sync::mutex::mutex_unlock_raw(mutex);
            return PoolTaskResultI64 {
                status: 0,
                value: 0
            };
        }
        std::sync::condition::wait_millis_raw(condition, mutex, remaining);
    }
    PoolTaskResultI64 result = PoolTaskResultI64 {
        status: load(task.state, R_STATUS),
        value: load(task.state, R_VALUE)
    };
    std::sync::mutex::mutex_unlock_raw(mutex);
    return result;
}

// Explicit destruction waits for terminal state. There is intentionally no
// blocking Drop implementation.
public fn task_destroy(PoolTaskI64&mut task) {
    if (task.state == 0) {
        return;
    }
    task_wait(task);

    usize mutex = load(task.state, R_MUTEX)as usize;
    usize condition = load(task.state, R_CONDITION)as usize;

    std::sync::condition::condition_destroy(condition);
    std::sync::mutex::mutex_destroy_raw(mutex);
    raz_rt_dealloc_aligned(task.state, 8);
    task.state = 0;
}

fn worker_loop(usize state) -> i64 {
    usize mutex = load(state, P_MUTEX)as usize;
    usize not_empty = load(state, P_NOT_EMPTY)as usize;
    usize not_full = load(state, P_NOT_FULL)as usize;
    usize idle = load(state, P_IDLE)as usize;
    usize queue = load(state, P_QUEUE)as usize;
    i64 mask = load(state, P_MASK);

    while (true) {
        std::sync::mutex::mutex_lock_raw(mutex);
        while (load(state, P_COUNT) == 0 && load(state, P_STOPPING) == 0) {
            std::sync::condition::wait_raw(not_empty, mutex);
        }
        if (load(state, P_COUNT) == 0 && load(state, P_STOPPING) != 0) {
            std::sync::mutex::mutex_unlock_raw(mutex);
            return 0;
        }

        i64 head = load(state, P_HEAD);
        i64 slot = head & mask;
        usize callable = raz_rt_volatile_load_i64(queue + slot * 16)as usize;
        usize result_state = raz_rt_volatile_load_i64(queue + slot * 16 + 8)as usize;

        store(state, P_HEAD, head + 1);
        store(state, P_COUNT, load(state, P_COUNT) - 1);
        store(state, P_ACTIVE, load(state, P_ACTIVE) + 1);
        std::sync::mutex::mutex_unlock_raw(mutex);
        std::sync::condition::notify_one_raw(not_full);

        i64 value = raz_rt_callable_invoke_once_i64_raw(callable);

        result_finish(result_state, 1, value);
        std::sync::mutex::mutex_lock_raw(mutex);
        store(state, P_ACTIVE, load(state, P_ACTIVE) - 1);
        if (load(state, P_COUNT) == 0 && load(state, P_ACTIVE) == 0) {
            std::sync::condition::notify_all_raw(idle);
        }
        std::sync::mutex::mutex_unlock_raw(mutex);
    }
    return 0;
}

fn cleanup_state(usize state) {
    if (state == 0) {
        return;
    }

    usize workers = load(state, P_WORKERS)as usize;
    i64 worker_count = load(state, P_WORKER_COUNT);
    i64 index = 0;

    while (index < worker_count) {
        usize raw = raz_rt_volatile_load_i64(workers + index * 8)as usize;

        if (raw != 0) {
            unsafe {
                raz_rt_task_join_i64(raw as i8*mut);
            }
        }
        index += 1;
    }

    usize mutex = load(state, P_MUTEX)as usize;
    usize not_empty = load(state, P_NOT_EMPTY)as usize;
    usize not_full = load(state, P_NOT_FULL)as usize;
    usize idle = load(state, P_IDLE)as usize;

    std::sync::condition::condition_destroy(not_empty);
    std::sync::condition::condition_destroy(not_full);
    std::sync::condition::condition_destroy(idle);
    std::sync::mutex::mutex_destroy_raw(mutex);
    raz_rt_dealloc_aligned(load(state, P_QUEUE)as usize, 8);
    raz_rt_dealloc_aligned(workers, 8);
    raz_rt_dealloc_aligned(state, 8);
}

public fn create(i64 worker_count, i64 requested_capacity) -> WorkerPoolI64 {
    i64 capacity = normalized_capacity(requested_capacity);

    if (worker_count <= 0 || worker_count > 1024 || capacity == 0) {
        return WorkerPoolI64 {
            state: 0
        };
    }

    usize state = raz_rt_alloc_aligned(POOL_BYTES, 8);
    usize queue = raz_rt_alloc_aligned(capacity * 16, 8);
    usize workers = raz_rt_alloc_aligned(worker_count * 8, 8);
    usize mutex = std::sync::mutex::mutex_create_raw();
    usize not_empty = std::sync::condition::condition_create();
    usize not_full = std::sync::condition::condition_create();
    usize idle = std::sync::condition::condition_create();

    if (
        state == 0 ||
        queue == 0 ||
        workers == 0 ||
        mutex == 0 ||
        not_empty == 0 ||
        not_full == 0 ||
        idle == 0
    ) {
        if (not_empty != 0) {
            std::sync::condition::condition_destroy(not_empty);
        }
        if (not_full != 0) {
            std::sync::condition::condition_destroy(not_full);
        }
        if (idle != 0) {
            std::sync::condition::condition_destroy(idle);
        }
        if (mutex != 0) {
            std::sync::mutex::mutex_destroy_raw(mutex);
        }
        if (queue != 0) {
            raz_rt_dealloc_aligned(queue, 8);
        }
        if (workers != 0) {
            raz_rt_dealloc_aligned(workers, 8);
        }
        if (state != 0) {
            raz_rt_dealloc_aligned(state, 8);
        }
        return WorkerPoolI64 {
            state: 0
        };
    }
    store(state, P_QUEUE, queue as i64);
    store(state, P_CAPACITY, capacity);
    store(state, P_MASK, capacity - 1);
    store(state, P_HEAD, 0);
    store(state, P_TAIL, 0);
    store(state, P_COUNT, 0);
    store(state, P_MUTEX, mutex as i64);
    store(state, P_NOT_EMPTY, not_empty as i64);
    store(state, P_NOT_FULL, not_full as i64);
    store(state, P_IDLE, idle as i64);
    store(state, P_ACTIVE, 0);
    store(state, P_ACCEPTING, 1);
    store(state, P_STOPPING, 0);
    store(state, P_WORKERS, workers as i64);
    store(state, P_WORKER_COUNT, 0);

    i64 index = 0;

    while (index < worker_count) {
        usize captured = state;

        auto raw_task = raz_rt_task_spawn_callable_i64(move fn() -> i64 {
            return worker_loop(captured);
        }
        );

        usize task = 0;

        unsafe {
            task = raw_task as usize;
        }
        if (task == 0) {
            store(state, P_ACCEPTING, 0);
            store(state, P_STOPPING, 1);
            std::sync::condition::notify_all_raw(not_empty);
            cleanup_state(state);
            return WorkerPoolI64 {
                state: 0
            };
        }
        raz_rt_volatile_store_i64(workers + index * 8, task as i64);
        index += 1;
        store(state, P_WORKER_COUNT, index);
    }
    return WorkerPoolI64 {
        state: state
    };
}

public fn valid(WorkerPoolI64& pool) -> bool {
    return pool.state != 0;
}

public fn pending(WorkerPoolI64& pool) -> i64 {
    if (pool.state == 0) {
        return 0;
    }

    usize mutex = load(pool.state, P_MUTEX)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);

    i64 value = load(pool.state, P_COUNT);

    std::sync::mutex::mutex_unlock_raw(mutex);
    return value;
}

public fn active(WorkerPoolI64& pool) -> i64 {
    if (pool.state == 0) {
        return 0;
    }

    usize mutex = load(pool.state, P_MUTEX)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);

    i64 value = load(pool.state, P_ACTIVE);

    std::sync::mutex::mutex_unlock_raw(mutex);
    return value;
}

public fn submit(WorkerPoolI64&mut pool, FnOnce() -> i64 operation, i64 timeout_millis) -> PoolTaskI64 {
    if (pool.state == 0 || timeout_millis < 0) {
        return PoolTaskI64 {
            state: 0
        };
    }

    usize result_state = result_create();

    if (result_state == 0) {
        return PoolTaskI64 {
            state: 0
        };
    }

    usize callable = raz_rt_callable_into_raw(operation);

    if (callable == 0) {
        PoolTaskI64 failed = PoolTaskI64 {
            state: result_state
        };
        task_destroy(&mut failed);
        return PoolTaskI64 {
            state: 0
        };
    }

    usize mutex = load(pool.state, P_MUTEX)as usize;
    usize not_full = load(pool.state, P_NOT_FULL)as usize;
    usize not_empty = load(pool.state, P_NOT_EMPTY)as usize;
    i64 deadline = deadline_nanos(timeout_millis);

    std::sync::mutex::mutex_lock_raw(mutex);
    while (load(pool.state, P_ACCEPTING) != 0 && load(pool.state, P_COUNT) >= load(pool.state, P_CAPACITY)) {
        i64 remaining = remaining_millis(deadline);

        if (remaining <= 0) {
            std::sync::mutex::mutex_unlock_raw(mutex);
            raz_rt_callable_destroy_raw(callable);
            result_finish(result_state, -1, 0);
            return PoolTaskI64 {
                state: result_state
            };
        }
        std::sync::condition::wait_millis_raw(not_full, mutex, remaining);
    }
    if (load(pool.state, P_ACCEPTING) == 0) {
        std::sync::mutex::mutex_unlock_raw(mutex);
        raz_rt_callable_destroy_raw(callable);
        result_finish(result_state, -1, 0);
        return PoolTaskI64 {
            state: result_state
        };
    }

    i64 tail = load(pool.state, P_TAIL);
    i64 slot = tail & load(pool.state, P_MASK);
    usize queue = load(pool.state, P_QUEUE)as usize;

    raz_rt_volatile_store_i64(queue + slot * 16, callable as i64);
    raz_rt_volatile_store_i64(queue + slot * 16 + 8, result_state as i64);
    store(pool.state, P_TAIL, tail + 1);
    store(pool.state, P_COUNT, load(pool.state, P_COUNT) + 1);
    std::sync::mutex::mutex_unlock_raw(mutex);
    std::sync::condition::notify_one_raw(not_empty);
    return PoolTaskI64 {
        state: result_state
    };
}

public fn wait_idle_millis(WorkerPoolI64& pool, i64 timeout_millis) -> bool {
    if (pool.state == 0 || timeout_millis < 0) {
        return false;
    }

    usize mutex = load(pool.state, P_MUTEX)as usize;
    usize idle = load(pool.state, P_IDLE)as usize;
    i64 deadline = deadline_nanos(timeout_millis);

    std::sync::mutex::mutex_lock_raw(mutex);
    while (load(pool.state, P_COUNT) != 0 || load(pool.state, P_ACTIVE) != 0) {
        i64 remaining = remaining_millis(deadline);

        if (remaining <= 0) {
            std::sync::mutex::mutex_unlock_raw(mutex);
            return false;
        }
        std::sync::condition::wait_millis_raw(idle, mutex, remaining);
    }
    std::sync::mutex::mutex_unlock_raw(mutex);
    return true;
}

public fn shutdown(WorkerPoolI64&mut pool, bool cancel_pending) {
    if (pool.state == 0) {
        return;
    }

    usize mutex = load(pool.state, P_MUTEX)as usize;
    usize not_empty = load(pool.state, P_NOT_EMPTY)as usize;
    usize not_full = load(pool.state, P_NOT_FULL)as usize;

    std::sync::mutex::mutex_lock_raw(mutex);
    store(pool.state, P_ACCEPTING, 0);
    if (cancel_pending) {
        usize queue = load(pool.state, P_QUEUE)as usize;
        i64 mask = load(pool.state, P_MASK);

        while (load(pool.state, P_COUNT) > 0) {
            i64 head = load(pool.state, P_HEAD);
            i64 slot = head & mask;
            usize callable = raz_rt_volatile_load_i64(queue + slot * 16)as usize;
            usize result_state = raz_rt_volatile_load_i64(queue + slot * 16 + 8)as usize;

            store(pool.state, P_HEAD, head + 1);
            store(pool.state, P_COUNT, load(pool.state, P_COUNT) - 1);
            raz_rt_callable_destroy_raw(callable);
            result_finish(result_state, -1, 0);
        }
    }
    store(pool.state, P_STOPPING, 1);
    std::sync::mutex::mutex_unlock_raw(mutex);
    std::sync::condition::notify_all_raw(not_empty);
    std::sync::condition::notify_all_raw(not_full);
}

public fn destroy(WorkerPoolI64&mut pool) {
    if (pool.state == 0) {
        return;
    }
    shutdown(pool, false);
    cleanup_state(pool.state);
    pool.state = 0;
}
