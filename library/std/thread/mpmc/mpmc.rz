namespace std::thread::mpmc;

// Bounded many-producer/many-consumer i64 queue based on monotonically
// increasing positions and one sequence word per slot. Producers and
// consumers contend only on their own cacheline-separated positions; a slot's
// sequence word provides the ownership hand-off without a global lock.
extern fn raz_rt_alloc_aligned(i64 size, i64 alignment) -> usize;
extern fn raz_rt_dealloc_aligned(usize pointer, i64 alignment);
extern fn raz_rt_atomic_load_i64_ordered(usize value, i64 order) -> i64;
extern fn raz_rt_atomic_store_i64_ordered(usize value, i64 desired, i64 order);
extern fn raz_rt_atomic_compare_exchange_i64_ordered(usize value, i64 expected, i64 desired, i64 success_order, i64 failure_order) -> i64;
extern fn raz_rt_cpu_relax();

const i64 relaxed_order = 0;
const i64 acquire_order = 1;
const i64 release_order = 2;

public struct MpmcReceiveI64 {
    bool received;
    i64 value;
}

public struct MpmcI64 {
    usize state;
    usize slots;
    i64 capacity;
    i64 mask;
}

fn normalized_capacity(i64 requested) -> i64 {
    if (requested <= 0) {
        return 0;
    }
    i64 capacity = 2;
    while (capacity < requested) {
        // 128 bytes of state plus 16 bytes per slot must remain representable.
        if (capacity > 576460752303423479) {
            return 0;
        }
        capacity *= 2;
    }
    return capacity;
}

fn store_plain_i64(usize address, i64 value) {
    unsafe {
        *(address as i64*mut) = value;
    }
}

fn load_plain_i64(usize address) -> i64 {
    unsafe {
        return *(address as i64*const);
    }
}

fn sequence_address(MpmcI64& queue, i64 position) -> usize {
    return queue.slots + (position & queue.mask) * 16;
}

public fn create(i64 requested_capacity) -> MpmcI64 {
    i64 capacity = normalized_capacity(requested_capacity);
    if (capacity == 0 || capacity > 576460752303423479) {
        return MpmcI64 { state: 0, slots: 0, capacity: 0, mask: 0 };
    }

    // Enqueue and dequeue positions occupy separate cache lines. Slot records
    // follow at +128 and contain { sequence, value }.
    usize state = raz_rt_alloc_aligned(128 + capacity * 16, 64);
    if (state == 0) {
        return MpmcI64 { state: 0, slots: 0, capacity: 0, mask: 0 };
    }
    store_plain_i64(state, 0);
    store_plain_i64(state + 64, 0);
    usize slots = state + 128;
    i64 index = 0;
    while (index < capacity) {
        store_plain_i64(slots + index * 16, index);
        index += 1;
    }
    return MpmcI64 {
        state: state,
        slots: slots,
        capacity: capacity,
        mask: capacity - 1,
    };
}

public fn valid(MpmcI64& queue) -> bool {
    return queue.state != 0 && queue.slots != 0 && queue.capacity > 0;
}

public fn capacity(MpmcI64& queue) -> i64 {
    return queue.capacity;
}

/// Returns an approximate queue length. Under concurrent producers/consumers
/// the result is a snapshot for telemetry/backpressure, not synchronization.
public fn len(MpmcI64& queue) -> i64 {
    if (!valid(queue)) {
        return 0;
    }
    i64 enqueue = raz_rt_atomic_load_i64_ordered(queue.state, acquire_order);
    i64 dequeue = raz_rt_atomic_load_i64_ordered(queue.state + 64, acquire_order);
    i64 count = enqueue - dequeue;
    if (count < 0) {
        return 0;
    }
    if (count > queue.capacity) {
        return queue.capacity;
    }
    return count;
}

public fn is_empty(MpmcI64& queue) -> bool {
    return len(queue) == 0;
}

public fn try_send(MpmcI64& queue, i64 value) -> bool {
    if (!valid(queue)) {
        return false;
    }

    i64 position = raz_rt_atomic_load_i64_ordered(queue.state, relaxed_order);
    while (true) {
        usize sequence = sequence_address(queue, position);
        i64 observed = raz_rt_atomic_load_i64_ordered(sequence, acquire_order);
        i64 difference = observed - position;
        if (difference == 0) {
            if (raz_rt_atomic_compare_exchange_i64_ordered(queue.state, position, position + 1, relaxed_order, relaxed_order) == 1) {
                store_plain_i64(sequence + 8, value);
                raz_rt_atomic_store_i64_ordered(sequence, position + 1, release_order);
                return true;
            }
        } else if (difference < 0) {
            return false;
        }
        raz_rt_cpu_relax();
        position = raz_rt_atomic_load_i64_ordered(queue.state, relaxed_order);
    }
    return false;
}

public fn try_receive(MpmcI64& queue) -> MpmcReceiveI64 {
    if (!valid(queue)) {
        return MpmcReceiveI64 { received: false, value: 0 };
    }

    i64 position = raz_rt_atomic_load_i64_ordered(queue.state + 64, relaxed_order);
    while (true) {
        usize sequence = sequence_address(queue, position);
        i64 observed = raz_rt_atomic_load_i64_ordered(sequence, acquire_order);
        i64 difference = observed - (position + 1);
        if (difference == 0) {
            if (raz_rt_atomic_compare_exchange_i64_ordered(queue.state + 64, position, position + 1, relaxed_order, relaxed_order) == 1) {
                i64 value = load_plain_i64(sequence + 8);
                raz_rt_atomic_store_i64_ordered(sequence, position + queue.capacity, release_order);
                return MpmcReceiveI64 { received: true, value: value };
            }
        } else if (difference < 0) {
            return MpmcReceiveI64 { received: false, value: 0 };
        }
        raz_rt_cpu_relax();
        position = raz_rt_atomic_load_i64_ordered(queue.state + 64, relaxed_order);
    }
    return MpmcReceiveI64 { received: false, value: 0 };
}

public fn destroy(MpmcI64&mut queue) {
    if (queue.state != 0) {
        raz_rt_dealloc_aligned(queue.state, 64);
    }
    queue.state = 0;
    queue.slots = 0;
    queue.capacity = 0;
    queue.mask = 0;
}

impl Drop for MpmcI64 {
    fn drop(MpmcI64&mut self) {
        destroy(self);
    }
}
