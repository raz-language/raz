namespace std::thread::executor;
import std::thread::pool;
// Raz-owned executor facade. Queueing, worker lifecycle, backpressure,
// cancellation-at-shutdown and task result state all live in std::thread::pool.
// Native code is limited to the thread, mutex, condition and callable ABI used
// by that pool.
public struct ExecutorI64 {
    WorkerPoolI64 pool;
}

public struct ExecutorTaskI64 {
    PoolTaskI64 task;
}

public struct ExecutorTaskResultI64 {
    i64 status;
    i64 value;
}

public fn executor_create(i64 worker_count, i64 queue_capacity) -> ExecutorI64 {
    WorkerPoolI64 pool = std::thread::pool::create(worker_count, queue_capacity);

    return ExecutorI64 {
        pool: move pool
    };
}

public fn executor_valid(ExecutorI64& executor) -> bool {
    return std::thread::pool::valid(&executor.pool);
}

public fn invalid_task() -> ExecutorTaskI64 {
    PoolTaskI64 task = PoolTaskI64 {
        state: 0
    };
    return ExecutorTaskI64 {
        task: move task
    };
}

public fn submit(ExecutorI64&mut executor, FnOnce() -> i64 operation, i64 timeout_millis) -> ExecutorTaskI64 {
    PoolTaskI64 task = std::thread::pool::submit(&mut executor.pool, operation, timeout_millis);

    return ExecutorTaskI64 {
        task: move task
    };
}

public fn task_valid(ExecutorTaskI64& task) -> bool {
    return std::thread::pool::task_valid(&task.task);
}

public fn task_try_result(ExecutorTaskI64& task) -> ExecutorTaskResultI64 {
    PoolTaskResultI64 result = std::thread::pool::task_try_result(&task.task);

    return ExecutorTaskResultI64 {
        status: result.status,
        value: result.value
    };
}

public fn task_wait(ExecutorTaskI64& task) -> ExecutorTaskResultI64 {
    PoolTaskResultI64 result = std::thread::pool::task_wait(&task.task);

    return ExecutorTaskResultI64 {
        status: result.status,
        value: result.value
    };
}

public fn task_wait_millis(ExecutorTaskI64& task, i64 timeout_millis) -> ExecutorTaskResultI64 {
    PoolTaskResultI64 result = std::thread::pool::task_wait_millis(&task.task, timeout_millis);

    return ExecutorTaskResultI64 {
        status: result.status,
        value: result.value
    };
}

public fn task_destroy(ExecutorTaskI64&mut task) {
    std::thread::pool::task_destroy(&mut task.task);
}

public fn executor_pending(ExecutorI64& executor) -> i64 {
    return std::thread::pool::pending(&executor.pool);
}

public fn executor_active(ExecutorI64& executor) -> i64 {
    return std::thread::pool::active(&executor.pool);
}

public fn executor_wait_idle_millis(ExecutorI64& executor, i64 timeout_millis) -> bool {
    return std::thread::pool::wait_idle_millis(&executor.pool, timeout_millis);
}

public fn executor_shutdown(ExecutorI64&mut executor, bool cancel_pending) {
    std::thread::pool::shutdown(&mut executor.pool, cancel_pending);
}

public fn executor_destroy(ExecutorI64&mut executor) {
    std::thread::pool::destroy(&mut executor.pool);
}
