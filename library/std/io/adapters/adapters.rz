namespace std::io::adapters;
import std::io;
import std::fs::file;
import std::io::buffered;

impl Read for File {
    fn read(File&mut self, usize output, i64 capacity) -> i64 {
        return std::fs::file::read(self, output, capacity);
    }
}

impl Write for File {
    fn write(File&mut self, usize data, i64 size) -> i64 {
        return std::fs::file::write(self, data, size);
    }
}

impl Flush for File {
    fn flush(File&mut self) -> bool {
        return std::fs::file::flush(self);
    }
}

impl Seek for File {
    fn seek(File&mut self, i64 offset, i64 origin) -> bool {
        return std::fs::file::seek(self, offset, origin);
    }
    fn position(File& self) -> i64 {
        return std::fs::file::position(self);
    }
}

impl Read for BufReader {
    fn read(BufReader&mut self, usize output, i64 capacity) -> i64 {
        return reader_read(self, output, capacity);
    }
}

impl Write for BufWriter {
    fn write(BufWriter&mut self, usize data, i64 size) -> i64 {
        if (writer_write(self, data, size)) {
            return size;
        }
        return -1;
    }
}

impl Flush for BufWriter {
    fn flush(BufWriter&mut self) -> bool {
        return writer_flush(self);
    }
}
