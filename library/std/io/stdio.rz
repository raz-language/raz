namespace std::io::stdio;

import alloc::string;
import std::fmt;

// Standard streams. The runtime exposes only the host descriptors; retry loops
// and write-all policy stay in Raz.
extern fn raz_rt_stdio_read(i64 stream, usize output, i64 capacity) -> i64;
extern fn raz_rt_stdio_write(i64 stream, usize data, i64 size) -> i64;
extern fn raz_rt_stdio_flush(i64 stream) -> i64;
extern fn raz_rt_stdio_is_terminal(i64 stream) -> i64;
public const i64 stdin_stream = 0;
public const i64 stdout_stream = 1;
public const i64 stderr_stream = 2;

public fn read_stdin(usize output, i64 capacity) -> i64 {
    return raz_rt_stdio_read(stdin_stream, output, capacity);
}

public fn write(i64 stream, usize data, i64 size) -> i64 {
    return raz_rt_stdio_write(stream, data, size);
}

public fn write_all(i64 stream, usize data, i64 size) -> bool {
    if (size < 0) {
        return false;
    }

    i64 written = 0;

    while (written < size) {
        i64 count = raz_rt_stdio_write(stream, data + written, size - written);

        if (count <= 0) {
            return false;
        }
        written += count;
    }
    return true;
}

public fn write_stdout(usize data, i64 size) -> bool {
    return write_all(stdout_stream, data, size);
}

public fn write_stderr(usize data, i64 size) -> bool {
    return write_all(stderr_stream, data, size);
}

public fn flush(i64 stream) -> bool {
    return raz_rt_stdio_flush(stream) == 1;
}

public fn is_terminal(i64 stream) -> bool {
    return raz_rt_stdio_is_terminal(stream) == 1;
}

// Text conveniences layer on top of the byte-oriented primitives above. They
// keep the raw write API available for protocol and binary code while making
// ordinary console output concise and allocation-conscious.
public fn print_string(String& value) -> bool {
    return write_stdout(alloc::string::data_ptr(value), alloc::string::len(value));
}

public fn println_string(String& value) -> bool {
    String line = alloc::string::clone_string(value);

    if (!alloc::string::push_byte(&mut line, 10)) {
        alloc::string::destroy(&mut line);
        return false;
    }

    bool ok = print_string(&line);

    alloc::string::destroy(&mut line);
    return ok;
}

public fn print_i64(i64 value) -> bool {
    String text = std::fmt::format_i64(value);
    bool ok = print_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

public fn println_i64(i64 value) -> bool {
    String text = std::fmt::format_i64(value);
    bool ok = println_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

public fn print_u64(u64 value) -> bool {
    String text = std::fmt::format_u64(value);
    bool ok = print_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

public fn println_u64(u64 value) -> bool {
    String text = std::fmt::format_u64(value);
    bool ok = println_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

public fn print_bool(bool value) -> bool {
    String text = std::fmt::format_bool(value);
    bool ok = print_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

public fn println_bool(bool value) -> bool {
    String text = std::fmt::format_bool(value);
    bool ok = println_string(&text);

    alloc::string::destroy(&mut text);
    return ok;
}

public fn eprint_string(String& value) -> bool {
    return write_stderr(alloc::string::data_ptr(value), alloc::string::len(value));
}

public fn eprintln_string(String& value) -> bool {
    String line = alloc::string::clone_string(value);

    if (!alloc::string::push_byte(&mut line, 10)) {
        alloc::string::destroy(&mut line);
        return false;
    }

    bool ok = eprint_string(&line);

    alloc::string::destroy(&mut line);
    return ok;
}
