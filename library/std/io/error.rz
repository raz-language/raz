namespace std::io::error;
/// Operation category attached to a structured I/O failure.
public enum IoOperation {
    Open,
    Read,
    Write,
    Seek,
    Flush,
    CreateDir,
    Remove,
    Metadata,
    Rename,
    Copy,
    Connect,
    Listen,
    Accept,
    Send,
    Receive,
    Bind,
    Symlink,
    ReadLink,
    Permissions,
    CreateTemp,
}

/// Allocation-free error value used by filesystem and socket APIs.
/// `code` is the platform/runtime error code captured at the failing boundary.
public struct IoError {
    IoOperation operation;
    i64 code;
}

extern fn raz_rt_last_error_code() -> i64;

public fn last_error(IoOperation operation) -> IoError {
    return IoError {
        operation: operation,
        code: raz_rt_last_error_code()
    };
}

public fn error_with_code(IoOperation operation, i64 code) -> IoError {
    return IoError {
        operation: operation,
        code: code
    };
}


/// Portable high-level error class. The raw platform code remains available in
/// IoError for diagnostics and platform-specific handling.
public enum IoErrorKind {
    Other,
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidInput,
    WouldBlock,
    Interrupted,
    TimedOut,
    ConnectionRefused,
    ConnectionReset,
    BrokenPipe,
}

extern fn raz_rt_error_kind(i64 code) -> i64;

public fn kind(IoError& error) -> IoErrorKind {
    i64 value = raz_rt_error_kind(error.code);
    if (value == 1) { return IoErrorKind::NotFound; }
    if (value == 2) { return IoErrorKind::PermissionDenied; }
    if (value == 3) { return IoErrorKind::AlreadyExists; }
    if (value == 4) { return IoErrorKind::InvalidInput; }
    if (value == 5) { return IoErrorKind::WouldBlock; }
    if (value == 6) { return IoErrorKind::Interrupted; }
    if (value == 7) { return IoErrorKind::TimedOut; }
    if (value == 8) { return IoErrorKind::ConnectionRefused; }
    if (value == 9) { return IoErrorKind::ConnectionReset; }
    if (value == 10) { return IoErrorKind::BrokenPipe; }
    return IoErrorKind::Other;
}
