namespace std::io::error;
/// Operation category attached to a structured I/O failure.
public enum IoOperation {
    Open,
    Read,
    Write,
    Seek,
    Flush,
    CreateDir,
    Remove,
    Metadata,
    Rename,
    Copy,
    Connect,
    Listen,
    Accept,
    Send,
    Receive,
    Bind,
}

/// Allocation-free error value used by filesystem and socket APIs.
/// `code` is the platform/runtime error code captured at the failing boundary.
public struct IoError {
    IoOperation operation;
    i64 code;
}

extern fn raz_rt_last_error_code() -> i64;

public fn last_error(IoOperation operation) -> IoError {
    return IoError {
        operation: operation,
        code: raz_rt_last_error_code()
    };
}

public fn error_with_code(IoOperation operation, i64 code) -> IoError {
    return IoError {
        operation: operation,
        code: code
    };
}
