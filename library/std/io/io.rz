namespace std::io;
// Allocation-neutral I/O contracts. These intentionally use raw byte spans and
// i64 status/count values at the trait boundary: structured IoError adapters can
// be layered above them without forcing Result construction in hot inner loops.
public trait Read {
    fn read(Self&mut self, usize output, i64 capacity) -> i64;
}

public trait Write {
    fn write(Self&mut self, usize data, i64 size) -> i64;
}

public trait Flush {
    fn flush(Self&mut self) -> bool;
}

public trait Seek {
    fn seek(Self&mut self, i64 offset, i64 origin) -> bool;
    fn position(Self& self) -> i64;
}

public struct Reader {
    usize context;
}

public struct Writer {
    usize context;
}

public enum SeekFrom {
    Start(i64),
    Current(i64),
    End(i64)
}
