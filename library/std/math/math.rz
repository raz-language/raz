namespace std::math;

// Scalar floating-point primitives are narrow runtime boundaries so Raz keeps
// portable IEEE-754 behavior while the host maps them to the platform math
// library. Integer helpers remain entirely in Raz.
extern fn raz_rt_f64_floor(f64 value) -> f64;
extern fn raz_rt_f64_ceil(f64 value) -> f64;
extern fn raz_rt_f64_round(f64 value) -> f64;
extern fn raz_rt_f64_trunc(f64 value) -> f64;
extern fn raz_rt_f64_sqrt(f64 value) -> f64;
extern fn raz_rt_f64_cbrt(f64 value) -> f64;
extern fn raz_rt_f64_pow(f64 base, f64 exponent) -> f64;
extern fn raz_rt_f64_exp(f64 value) -> f64;
extern fn raz_rt_f64_log(f64 value) -> f64;
extern fn raz_rt_f64_log2(f64 value) -> f64;
extern fn raz_rt_f64_log10(f64 value) -> f64;
extern fn raz_rt_f64_sin(f64 value) -> f64;
extern fn raz_rt_f64_cos(f64 value) -> f64;
extern fn raz_rt_f64_tan(f64 value) -> f64;
extern fn raz_rt_f64_asin(f64 value) -> f64;
extern fn raz_rt_f64_acos(f64 value) -> f64;
extern fn raz_rt_f64_atan(f64 value) -> f64;
extern fn raz_rt_f64_atan2(f64 y, f64 x) -> f64;
extern fn raz_rt_f64_is_finite(f64 value) -> i64;
extern fn raz_rt_f64_is_nan(f64 value) -> i64;
extern fn raz_rt_f64_is_infinite(f64 value) -> i64;

public fn abs(f64 value) -> f64 {
    if (value < 0.0) {
        return -value;
    }
    return value;
}

public fn min(f64 left, f64 right) -> f64 {
    if (left < right) {
        return left;
    }
    return right;
}

public fn max(f64 left, f64 right) -> f64 {
    if (left > right) {
        return left;
    }
    return right;
}

public fn clamp(f64 value, f64 lower, f64 upper) -> f64 {
    if (value < lower) {
        return lower;
    }
    if (value > upper) {
        return upper;
    }
    return value;
}

public fn floor(f64 value) -> f64 { return raz_rt_f64_floor(value); }
public fn ceil(f64 value) -> f64 { return raz_rt_f64_ceil(value); }
public fn round(f64 value) -> f64 { return raz_rt_f64_round(value); }
public fn trunc(f64 value) -> f64 { return raz_rt_f64_trunc(value); }
public fn sqrt(f64 value) -> f64 { return raz_rt_f64_sqrt(value); }
public fn cbrt(f64 value) -> f64 { return raz_rt_f64_cbrt(value); }
public fn pow(f64 base, f64 exponent) -> f64 { return raz_rt_f64_pow(base, exponent); }
public fn exp(f64 value) -> f64 { return raz_rt_f64_exp(value); }
public fn log(f64 value) -> f64 { return raz_rt_f64_log(value); }
public fn log2(f64 value) -> f64 { return raz_rt_f64_log2(value); }
public fn log10(f64 value) -> f64 { return raz_rt_f64_log10(value); }
public fn sin(f64 value) -> f64 { return raz_rt_f64_sin(value); }
public fn cos(f64 value) -> f64 { return raz_rt_f64_cos(value); }
public fn tan(f64 value) -> f64 { return raz_rt_f64_tan(value); }
public fn asin(f64 value) -> f64 { return raz_rt_f64_asin(value); }
public fn acos(f64 value) -> f64 { return raz_rt_f64_acos(value); }
public fn atan(f64 value) -> f64 { return raz_rt_f64_atan(value); }
public fn atan2(f64 y, f64 x) -> f64 { return raz_rt_f64_atan2(y, x); }
public fn is_finite(f64 value) -> bool { return raz_rt_f64_is_finite(value) == 1; }
public fn is_nan(f64 value) -> bool { return raz_rt_f64_is_nan(value) == 1; }
public fn is_infinite(f64 value) -> bool { return raz_rt_f64_is_infinite(value) == 1; }

public fn i64_abs(i64 value) -> i64 {
    if (value < 0) {
        return -value;
    }
    return value;
}

public fn i64_min(i64 left, i64 right) -> i64 {
    if (left < right) { return left; }
    return right;
}

public fn i64_max(i64 left, i64 right) -> i64 {
    if (left > right) { return left; }
    return right;
}

public fn i64_clamp(i64 value, i64 lower, i64 upper) -> i64 {
    if (value < lower) { return lower; }
    if (value > upper) { return upper; }
    return value;
}

public fn gcd(i64 left, i64 right) -> i64 {
    i64 a = i64_abs(left);
    i64 b = i64_abs(right);

    while (b != 0) {
        i64 remainder = a % b;
        a = b;
        b = remainder;
    }
    return a;
}

public fn lcm(i64 left, i64 right) -> i64 {
    if (left == 0 || right == 0) {
        return 0;
    }
    return i64_abs((left / gcd(left, right)) * right);
}
