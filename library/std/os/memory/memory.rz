namespace std::os::memory;

extern fn raz_rt_page_alloc(i64 size) -> usize;
extern fn raz_rt_page_free(usize address, i64 size) -> i64;
extern fn raz_rt_page_protect(usize address, i64 size, i64 protection) -> i64;
extern fn raz_rt_page_lock(usize address, i64 size) -> i64;
extern fn raz_rt_page_unlock(usize address, i64 size) -> i64;

public fn allocate(i64 size) -> usize {
    if (size <= 0) { return 0; }
    return raz_rt_page_alloc(size);
}

public fn free(usize address, i64 size) -> bool {
    if (address == 0 || size <= 0) { return false; }
    return raz_rt_page_free(address, size) == 1;
}

fn protect_raw(usize address, i64 size, i64 mode) -> bool {
    if (address == 0 || size <= 0) { return false; }
    return raz_rt_page_protect(address, size, mode) == 1;
}

public fn protect_none(usize address, i64 size) -> bool { return protect_raw(address, size, 0); }
public fn protect_read(usize address, i64 size) -> bool { return protect_raw(address, size, 1); }
public fn protect_read_write(usize address, i64 size) -> bool { return protect_raw(address, size, 2); }
public fn protect_read_execute(usize address, i64 size) -> bool { return protect_raw(address, size, 3); }
public fn protect_read_write_execute(usize address, i64 size) -> bool { return protect_raw(address, size, 4); }

public fn lock(usize address, i64 size) -> bool {
    if (address == 0 || size <= 0) { return false; }
    return raz_rt_page_lock(address, size) == 1;
}

public fn unlock(usize address, i64 size) -> bool {
    if (address == 0 || size <= 0) { return false; }
    return raz_rt_page_unlock(address, size) == 1;
}
