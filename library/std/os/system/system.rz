namespace std::os::system;

extern fn raz_rt_hardware_threads() -> i64;
extern fn raz_rt_page_size() -> i64;
extern fn raz_rt_current_thread_set_affinity(i64 cpu) -> i64;

public fn logical_cpu_count() -> i64 {
    return raz_rt_hardware_threads();
}

public fn page_size() -> i64 {
    return raz_rt_page_size();
}

/// Pins the current native thread to one logical CPU when supported.
public fn set_current_thread_affinity(i64 cpu) -> bool {
    if (cpu < 0) { return false; }
    return raz_rt_current_thread_set_affinity(cpu) == 1;
}
