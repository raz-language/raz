namespace web::page;

import alloc::string;
import web::html_support;

extern fn raz_rt_cstr_len(string value) -> i64;
extern fn raz_rt_cstr_ptr(string value) -> usize;

/// Static HTML document builder for Raz web projects.
///
/// Interactive Raz application behavior executes as WebAssembly. Static pages
/// emit no JavaScript or WebAssembly; interactive pages emit only the minimal
/// host shim needed to instantiate app.wasm, bind browser events, and expose
/// DOM primitives to the module.
public struct Page {
    String html_open;
    String head;
    String body;
    String css;
    String client;
    // Compiler-private list of ordinary Raz functions referenced by browser
    // event bindings. The native page generator appends these roots to
    // dist/.raz-wasm-required; no application behavior is encoded here.
    String browser_roots;
    // Compiler-private lazy WASM chunk manifest. Each line is chunk-name<TAB>handler.
    String browser_chunks;
    i64 open_depth;
}

public impl Page {
    public fn new(string title) -> Page {
        Page page = Page {
            html_open: String::with_capacity(64),
            head: String::with_capacity(512),
            body: String::with_capacity(2048),
            css: String::with_capacity(1024),
            client: String::with_capacity(1024),
            browser_roots: String::with_capacity(256),
            browser_chunks: String::with_capacity(256),
            open_depth: 0,
        };
        page.html_open.push_str("<html lang=\"en\">\n");
        page.head.push_str("<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
        web::html_support::append_escaped_to(&mut page.head, title);
        page.head.push_str("</title>\n");
        return page;
    }

    public fn new_lang(string title, string language) -> Page {
        Page page = Page {
            html_open: String::with_capacity(64),
            head: String::with_capacity(512),
            body: String::with_capacity(2048),
            css: String::with_capacity(1024),
            client: String::with_capacity(1024),
            browser_roots: String::with_capacity(256),
            browser_chunks: String::with_capacity(256),
            open_depth: 0,
        };
        page.html_open.push_str("<html lang=\"");
        web::html_support::append_escaped_to(&mut page.html_open, language);
        page.html_open.push_str("\">\n");
        page.head.push_str("<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
        web::html_support::append_escaped_to(&mut page.head, title);
        page.head.push_str("</title>\n");
        return page;
    }
}
