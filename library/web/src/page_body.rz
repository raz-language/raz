namespace web::page;

import alloc::string;
import web::html_support;

fn body_tag_text(Page&mut page, string tag, string class_name, string value) -> bool {
    if (!page.body.push_str("<") || !web::html_support::append_html_name_to(&mut page.body, tag)) { return false; }
    if (raz_rt_cstr_len(class_name) > 0) {
        if (!page.body.push_str(" class=\"") || !web::html_support::append_escaped_to(&mut page.body, class_name) || !page.body.push_str("\"")) { return false; }
    }
    if (!page.body.push_str(">") || !web::html_support::append_escaped_to(&mut page.body, value)) { return false; }
    return page.body.push_str("</") && web::html_support::append_html_name_to(&mut page.body, tag) && page.body.push_str(">\n");
}

fn body_tag_id_text(Page&mut page, string tag, string id, string class_name, string value) -> bool {
    if (!page.body.push_str("<") || !web::html_support::append_html_name_to(&mut page.body, tag)) { return false; }
    if (raz_rt_cstr_len(id) > 0) {
        if (!page.body.push_str(" id=\"") || !web::html_support::append_escaped_to(&mut page.body, id) || !page.body.push_str("\"")) { return false; }
    }
    if (raz_rt_cstr_len(class_name) > 0) {
        if (!page.body.push_str(" class=\"") || !web::html_support::append_escaped_to(&mut page.body, class_name) || !page.body.push_str("\"")) { return false; }
    }
    if (!page.body.push_str(">") || !web::html_support::append_escaped_to(&mut page.body, value)) { return false; }
    return page.body.push_str("</") && web::html_support::append_html_name_to(&mut page.body, tag) && page.body.push_str(">\n");
}

public impl Page {
    // ---- text elements ----------------------------------------------------------
    public fn h1(Page&mut self, string value) -> bool { return body_tag_text(self, "h1", "", value); }
    public fn h2(Page&mut self, string value) -> bool { return body_tag_text(self, "h2", "", value); }
    public fn h3(Page&mut self, string value) -> bool { return body_tag_text(self, "h3", "", value); }
    public fn h4(Page&mut self, string value) -> bool { return body_tag_text(self, "h4", "", value); }
    public fn h5(Page&mut self, string value) -> bool { return body_tag_text(self, "h5", "", value); }
    public fn h6(Page&mut self, string value) -> bool { return body_tag_text(self, "h6", "", value); }
    public fn p(Page&mut self, string value) -> bool { return body_tag_text(self, "p", "", value); }
    public fn strong(Page&mut self, string value) -> bool { return body_tag_text(self, "strong", "", value); }
    public fn em(Page&mut self, string value) -> bool { return body_tag_text(self, "em", "", value); }
    public fn small(Page&mut self, string value) -> bool { return body_tag_text(self, "small", "", value); }
    public fn pre(Page&mut self, string value) -> bool { return body_tag_text(self, "pre", "", value); }
    public fn label(Page&mut self, string value) -> bool { return body_tag_text(self, "label", "", value); }
    public fn code(Page&mut self, string value) -> bool { return body_tag_text(self, "code", "", value); }
    public fn li(Page&mut self, string value) -> bool { return body_tag_text(self, "li", "", value); }
    public fn blockquote(Page&mut self, string value) -> bool { return body_tag_text(self, "blockquote", "", value); }
    public fn span(Page&mut self, string value) -> bool { return body_tag_text(self, "span", "", value); }
    public fn mark(Page&mut self, string value) -> bool { return body_tag_text(self, "mark", "", value); }
    public fn del(Page&mut self, string value) -> bool { return body_tag_text(self, "del", "", value); }
    public fn ins(Page&mut self, string value) -> bool { return body_tag_text(self, "ins", "", value); }
    public fn sub(Page&mut self, string value) -> bool { return body_tag_text(self, "sub", "", value); }
    public fn sup(Page&mut self, string value) -> bool { return body_tag_text(self, "sup", "", value); }
    public fn kbd(Page&mut self, string value) -> bool { return body_tag_text(self, "kbd", "", value); }
    public fn samp(Page&mut self, string value) -> bool { return body_tag_text(self, "samp", "", value); }
    public fn cite(Page&mut self, string value) -> bool { return body_tag_text(self, "cite", "", value); }
    public fn address(Page&mut self, string value) -> bool { return body_tag_text(self, "address", "", value); }
    public fn dt(Page&mut self, string value) -> bool { return body_tag_text(self, "dt", "", value); }
    public fn dd(Page&mut self, string value) -> bool { return body_tag_text(self, "dd", "", value); }
    public fn caption(Page&mut self, string value) -> bool { return body_tag_text(self, "caption", "", value); }
    public fn legend(Page&mut self, string value) -> bool { return body_tag_text(self, "legend", "", value); }
    public fn time(Page&mut self, string datetime, string value) -> bool {
        if (!self.body.push_str("<time datetime=\"") || !web::html_support::append_escaped_to(&mut self.body, datetime) || !self.body.push_str("\">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</time>\n");
    }
    public fn abbr(Page&mut self, string title, string value) -> bool {
        if (!self.body.push_str("<abbr title=\"") || !web::html_support::append_escaped_to(&mut self.body, title) || !self.body.push_str("\">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</abbr>\n");
    }
    public fn q(Page&mut self, string cite_url, string value) -> bool {
        if (!self.body.push_str("<q cite=\"") || !web::html_support::append_escaped_to(&mut self.body, cite_url) || !self.body.push_str("\">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</q>\n");
    }

    public fn br(Page&mut self) -> bool { return self.body.push_str("<br>\n"); }
    public fn hr(Page&mut self) -> bool { return self.body.push_str("<hr>\n"); }

    public fn h1_class(Page&mut self, string class_name, string value) -> bool { return body_tag_text(self, "h1", class_name, value); }
    public fn p_class(Page&mut self, string class_name, string value) -> bool { return body_tag_text(self, "p", class_name, value); }
    public fn h1_id(Page&mut self, string id, string value) -> bool { return body_tag_id_text(self, "h1", id, "", value); }
    public fn p_id(Page&mut self, string id, string value) -> bool { return body_tag_id_text(self, "p", id, "", value); }
    public fn span_id(Page&mut self, string id, string value) -> bool { return body_tag_id_text(self, "span", id, "", value); }

    // Any HTML/custom element is available immediately; dedicated helpers above
    // are only conveniences for common tags.
    public fn element(Page&mut self, string tag, string value) -> bool { return body_tag_text(self, tag, "", value); }
    public fn element_class(Page&mut self, string tag, string class_name, string value) -> bool { return body_tag_text(self, tag, class_name, value); }
    public fn element_id(Page&mut self, string tag, string id, string class_name, string value) -> bool { return body_tag_id_text(self, tag, id, class_name, value); }

    /// Emit a text element with one escaped attribute. Attribute and tag names
    /// are restricted to normal HTML name characters; values are always escaped.
    public fn element_attr(Page&mut self, string tag, string name, string attribute_value, string value) -> bool {
        if (!self.body.push_str("<") || !web::html_support::append_html_name_to(&mut self.body, tag)) { return false; }
        if (!web::html_support::append_attribute_to(&mut self.body, name, attribute_value) || !self.body.push_str(">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</") && web::html_support::append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    /// Safe multi-attribute variants for ordinary HTML without dropping to raw().
    public fn element_attr2(Page&mut self, string tag, string name1, string value1, string name2, string value2, string value) -> bool {
        if (!self.body.push_str("<") || !web::html_support::append_html_name_to(&mut self.body, tag)) { return false; }
        if (!web::html_support::append_attribute_to(&mut self.body, name1, value1) || !web::html_support::append_attribute_to(&mut self.body, name2, value2) || !self.body.push_str(">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</") && web::html_support::append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    public fn element_attr3(Page&mut self, string tag, string name1, string value1, string name2, string value2, string name3, string value3, string value) -> bool {
        if (!self.body.push_str("<") || !web::html_support::append_html_name_to(&mut self.body, tag)) { return false; }
        if (!web::html_support::append_attribute_to(&mut self.body, name1, value1) || !web::html_support::append_attribute_to(&mut self.body, name2, value2) || !web::html_support::append_attribute_to(&mut self.body, name3, value3) || !self.body.push_str(">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</") && web::html_support::append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    public fn void_element(Page&mut self, string tag) -> bool {
        return self.body.push_str("<") && web::html_support::append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    public fn void_attr(Page&mut self, string tag, string name, string value) -> bool {
        if (!self.body.push_str("<") || !web::html_support::append_html_name_to(&mut self.body, tag)) { return false; }
        return web::html_support::append_attribute_to(&mut self.body, name, value) && self.body.push_str(">\n");
    }

    public fn void_attr2(Page&mut self, string tag, string name1, string value1, string name2, string value2) -> bool {
        if (!self.body.push_str("<") || !web::html_support::append_html_name_to(&mut self.body, tag)) { return false; }
        return web::html_support::append_attribute_to(&mut self.body, name1, value1) && web::html_support::append_attribute_to(&mut self.body, name2, value2) && self.body.push_str(">\n");
    }

    public fn void_attr3(Page&mut self, string tag, string name1, string value1, string name2, string value2, string name3, string value3) -> bool {
        if (!self.body.push_str("<") || !web::html_support::append_html_name_to(&mut self.body, tag)) { return false; }
        return web::html_support::append_attribute_to(&mut self.body, name1, value1) && web::html_support::append_attribute_to(&mut self.body, name2, value2) && web::html_support::append_attribute_to(&mut self.body, name3, value3) && self.body.push_str(">\n");
    }


    // ---- links/media/forms ------------------------------------------------------
    public fn a(Page&mut self, string href, string label) -> bool {
        if (!self.body.push_str("<a href=\"") || !web::html_support::append_escaped_to(&mut self.body, href) || !self.body.push_str("\">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</a>\n");
    }
    public fn link(Page&mut self, string href, string label) -> bool { return self.a(href, label); }
    public fn a_class(Page&mut self, string href, string class_name, string label) -> bool {
        if (!self.body.push_str("<a href=\"") || !web::html_support::append_escaped_to(&mut self.body, href) || !self.body.push_str("\" class=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</a>\n");
    }

    public fn a_external(Page&mut self, string href, string label) -> bool {
        if (!self.body.push_str("<a href=\"") || !web::html_support::append_escaped_to(&mut self.body, href)) { return false; }
        if (!self.body.push_str("\" target=\"_blank\" rel=\"noopener noreferrer\">")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</a>\n");
    }

    public fn image(Page&mut self, string src, string alt) -> bool {
        if (!self.body.push_str("<img src=\"") || !web::html_support::append_escaped_to(&mut self.body, src) || !self.body.push_str("\" alt=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, alt)) { return false; }
        return self.body.push_str("\">\n");
    }

    public fn image_lazy(Page&mut self, string src, string alt) -> bool {
        if (!self.body.push_str("<img src=\"") || !web::html_support::append_escaped_to(&mut self.body, src) || !self.body.push_str("\" alt=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, alt)) { return false; }
        return self.body.push_str("\" loading=\"lazy\" decoding=\"async\">\n");
    }

    public fn image_size(Page&mut self, string src, string alt, string width, string height) -> bool {
        if (!self.body.push_str("<img src=\"") || !web::html_support::append_escaped_to(&mut self.body, src) || !self.body.push_str("\" alt=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, alt) || !self.body.push_str("\" width=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, width) || !self.body.push_str("\" height=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, height)) { return false; }
        return self.body.push_str("\">\n");
    }

    public fn source(Page&mut self, string src, string media_type) -> bool {
        return self.void_attr2("source", "src", src, "type", media_type);
    }

    public fn source_media(Page&mut self, string srcset, string media) -> bool {
        return self.void_attr2("source", "srcset", srcset, "media", media);
    }

    public fn track(Page&mut self, string src, string kind, string language) -> bool {
        return self.void_attr3("track", "src", src, "kind", kind, "srclang", language);
    }

    public fn iframe(Page&mut self, string src, string title) -> bool {
        if (!self.body.push_str("<iframe src=\"") || !web::html_support::append_escaped_to(&mut self.body, src) || !self.body.push_str("\" title=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, title)) { return false; }
        return self.body.push_str("\"></iframe>\n");
    }

}
