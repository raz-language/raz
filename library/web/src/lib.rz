    public fn end_audio(Page&mut self) -> bool { return self.close("audio"); }
    public fn end_video(Page&mut self) -> bool { return self.close("video"); }
    public fn end_canvas(Page&mut self) -> bool { return self.close("canvas"); }
    public fn end_svg(Page&mut self) -> bool { return self.close("svg"); }
    public fn end_select(Page&mut self) -> bool { return self.close("select"); }
    public fn end_form(Page&mut self) -> bool { return self.close("form"); }

    public fn th(Page&mut self, string value) -> bool { return body_tag_text(self, "th", "", value); }
    public fn td(Page&mut self, string value) -> bool { return body_tag_text(self, "td", "", value); }
    public fn summary(Page&mut self, string value) -> bool { return body_tag_text(self, "summary", "", value); }
    public fn figcaption(Page&mut self, string value) -> bool { return body_tag_text(self, "figcaption", "", value); }

    public fn textarea(Page&mut self, string name, string placeholder, string value) -> bool {
        if (!self.body.push_str("<textarea name=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\" placeholder=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, placeholder) || !self.body.push_str("\">")) { return false; }
        if (!append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</textarea>\n");
    }

    public fn option(Page&mut self, string value, string label) -> bool {
        if (!self.body.push_str("<option value=\"") || !append_escaped_to(&mut self.body, value) || !self.body.push_str("\">")) { return false; }
        if (!append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</option>\n");
    }

    public fn option_selected(Page&mut self, string value, string label) -> bool {
        if (!self.body.push_str("<option value=\"") || !append_escaped_to(&mut self.body, value) || !self.body.push_str("\" selected>")) { return false; }
        if (!append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</option>\n");
    }

    /// Accessible validation/status message for progressively-enhanced forms.
    public fn field_error(Page&mut self, string id, string message) -> bool {
        if (!self.body.push_str("<p id=\"") || !append_escaped_to(&mut self.body, id) || !self.body.push_str("\" role=\"alert\" aria-live=\"polite\">")) { return false; }
        if (!append_escaped_to(&mut self.body, message)) { return false; }
        return self.body.push_str("</p>\n");
    }

    // ---- browser interactivity --------------------------------------------------
    /// Lazily load an ES-module chunk the first time an element receives the
    /// selected event. This is a client-only enhancement: using it does not root
    /// any Raz function and therefore does not cause app.wasm to be emitted.
    public fn lazy_module_on(Page&mut self, string element_id, EventKind kind, string src) -> bool {
        string event_name = web::std::events::name(kind);
        if (!self.client.push_str("{ const el = document.getElementById('") || !append_js_string_to(&mut self.client, element_id)) { return false; }
        if (!self.client.push_str("'); if (el) el.addEventListener('") || !append_js_string_to(&mut self.client, event_name)) { return false; }
        if (!self.client.push_str("', () => { void import('") || !append_js_string_to(&mut self.client, src)) { return false; }
        return self.client.push_str("'); }, { once: true }); }\n");
    }

    public fn lazy_module_on_click(Page&mut self, string element_id, string src) -> bool {
        return self.lazy_module_on(element_id, EventKind::Click, src);
    }

    /// Lazily instantiate a Raz-WASM chunk the first time the selected event fires.
    /// The chunk contains only `handler` and the functions reachable from it; it is
    /// not included in the main app.wasm root set unless bound separately with `on`.
    public fn lazy_wasm_on(Page&mut self, string element_id, EventKind kind, string chunk, string handler) -> bool {
        string event_name = web::std::events::name(kind);
        if (!self.client.push_str("{ const el = document.getElementById('") || !append_js_string_to(&mut self.client, element_id)) { return false; }
        if (!self.client.push_str("'); let module = null; if (el) el.addEventListener('") || !append_js_string_to(&mut self.client, event_name)) { return false; }
        if (!self.client.push_str("', async (event) => { if (!module) module = await rzLoadWasm('/assets/chunks/") || !append_js_string_to(&mut self.client, chunk)) { return false; }
        if (!self.client.push_str(".wasm'); const fn = module['") || !append_js_string_to(&mut self.client, handler)) { return false; }
        if (!self.client.push_str("']; if (typeof fn !== 'function') return; rzUse(module); rzCurrentEvent = event; try { fn(); } finally { rzCurrentEvent = null; } }); }\n")) { return false; }
        return self.browser_chunks.push_str(chunk) && self.browser_chunks.push_str("\t") && self.browser_chunks.push_str(handler) && self.browser_chunks.push_str("\n");
    }

    public fn lazy_wasm_on_click(Page&mut self, string element_id, string chunk, string handler) -> bool {
        return self.lazy_wasm_on(element_id, EventKind::Click, chunk, handler);
    }

    // Event bindings contain no application behavior. They only dispatch a DOM
    // event to an exported ordinary Raz function in app.wasm.
    /// Roots an exported Raz function for browser APIs that invoke callbacks by name
    /// (for example `web::std::timers::set_timeout`). This emits no JavaScript by
    /// itself; it only keeps the named function available in app.wasm.
    public fn browser_export(Page&mut self, string handler) -> bool {
        return self.browser_roots.push_str(handler) && self.browser_roots.push_str("\n");
    }

    public fn on(Page&mut self, string element_id, EventKind kind, string handler) -> bool {
        string event_name = web::std::events::name(kind);
        if (!self.client.push_str("{ const el = document.getElementById('") || !append_js_string_to(&mut self.client, element_id)) { return false; }
        if (!self.client.push_str("'); const owner = rzMain; const fn = rz['") || !append_js_string_to(&mut self.client, handler)) { return false; }
        if (!self.client.push_str("']; if (el && typeof fn === 'function') el.addEventListener('") || !append_js_string_to(&mut self.client, event_name)) { return false; }
        if (!self.client.push_str("', (event) => { rzUse(owner); rzCurrentEvent = event; try { fn(); } finally { rzCurrentEvent = null; } }); }\n")) { return false; }
        // Keep browser codegen rooted in the functions the page actually binds.
        // One handler name per line makes the marker deterministic and trivial
        // for the compiler to consume after the native generation pass.
        return self.browser_roots.push_str(handler) && self.browser_roots.push_str("\n");
    }

    public fn on_click(Page&mut self, string element_id, string handler) -> bool {
        return self.on(element_id, EventKind::Click, handler);
    }

    public fn on_input(Page&mut self, string element_id, string handler) -> bool {
        return self.on(element_id, EventKind::Input, handler);
    }

    /// Append a reusable Component tree to this page as build-time-only HTML/CSS.
    /// Browser-bound components are rejected instead of silently adding a runtime.
    public fn component(Page&mut self, web::ui::Component&mut value) -> bool {
        return value.append_static(&mut self.body, &mut self.css);
    }

    /// Escape and append plain text without wrapping it in an element.
    public fn text(Page&mut self, string value) -> bool { return append_escaped_to(&mut self.body, value); }

    /// Escape hatch for deliberately-authored HTML. Normal text APIs escape by default.
    public fn raw(Page&mut self, string html) -> bool { return self.body.push_str(html); }

    /// Writes an explicit static file path. Interactive pages emit only the
    /// app.js WebAssembly host shim beside the HTML file.
    public fn write(Page&mut self, string path) -> bool {
        String owned = String::from(path);
        return write_page_to(self, &owned);
    }

    /// Writes a host-friendly static route. `/` becomes `dist/index.html` and
    /// `/about` becomes `dist/about/index.html`. Route traversal, query/hash
    /// suffixes, backslashes, and empty path segments are rejected so a build
    /// can never escape its dist directory.
    public fn write_route(Page&mut self, string route) -> bool {
        String path = String::new();
        if (!static_route_output(route, &mut path)) { return false; }
        return write_page_to(self, &path);
    }

    /// Writes an owned prerendered route path created by route_path(). Any
    /// unresolved dynamic segment or unsafe traversal is rejected.
    public fn write_route_path(Page&mut self, String& route) -> bool {
        String output = String::new();
        if (!static_route_output_string(route, &mut output)) { return false; }
        return write_page_to(self, &output);
    }

    /// Writes the conventional static-host 404 document.
    public fn write_not_found(Page&mut self) -> bool {
        String path = String::from("dist/404.html");
        return write_page_to(self, &path);
    }
}

/// Browser DOM primitives callable from ordinary Raz event functions. Their
/// implementations are WebAssembly imports supplied by generated host glue.
public fn set_text(string id, string value) -> bool { return web::std::dom::set_text(id, value); }
public fn set_text_i64(string id, i64 value) -> bool { return web::std::dom::set_text_i64(id, value); }
public fn toggle_class(string id, string class_name) -> bool { return web::std::dom::toggle_class(id, class_name); }
public fn element(string id) -> web::std::dom::Element { return web::std::dom::element(id); }
public fn event() -> Event { return web::std::events::current(); }

/// Creates the canonical static output root used by Raz web projects.
public fn prepare_dist() -> bool {
    string dist = "dist";
    return web::build::fs::create_dir_all(raz_rt_cstr_ptr(dist), 4);
}

/// Emit one host-friendly static route from a reusable Component tree.
/// This is the concise static-site path: ordinary Component authoring, no
/// application runtime, and no manual prepare_dist/Page/write_route boilerplate.
public fn write_component_route(string route, string title, web::ui::Component&mut component) -> bool {
    if (!prepare_dist()) { return false; }
    Page page = Page::new(title);
    if (!page.component(component)) { return false; }
    return page.write_route(route);
}

public fn write_component_route_path(String& route, string title, web::ui::Component&mut component) -> bool {
    if (!prepare_dist()) { return false; }
    Page page = Page::new(title);
    if (!page.component(component)) { return false; }
    return page.write_route_path(route);
}

public fn write_component_route_lang(string route, string title, string language, web::ui::Component&mut component) -> bool {
    if (!prepare_dist()) { return false; }
    Page page = Page::new_lang(title, language);
    if (!page.component(component)) { return false; }
    return page.write_route(route);
}
