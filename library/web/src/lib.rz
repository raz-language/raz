    public fn h1_class(Page&mut self, string class_name, string value) -> bool { return body_tag_text(self, "h1", class_name, value); }
    public fn p_class(Page&mut self, string class_name, string value) -> bool { return body_tag_text(self, "p", class_name, value); }
    public fn h1_id(Page&mut self, string id, string value) -> bool { return body_tag_id_text(self, "h1", id, "", value); }
    public fn p_id(Page&mut self, string id, string value) -> bool { return body_tag_id_text(self, "p", id, "", value); }
    public fn span_id(Page&mut self, string id, string value) -> bool { return body_tag_id_text(self, "span", id, "", value); }

    // Any HTML/custom element is available immediately; dedicated helpers above
    // are only conveniences for common tags.
    public fn element(Page&mut self, string tag, string value) -> bool { return body_tag_text(self, tag, "", value); }
    public fn element_class(Page&mut self, string tag, string class_name, string value) -> bool { return body_tag_text(self, tag, class_name, value); }
    public fn element_id(Page&mut self, string tag, string id, string class_name, string value) -> bool { return body_tag_id_text(self, tag, id, class_name, value); }

    /// Emit a text element with one escaped attribute. Attribute and tag names
    /// are restricted to normal HTML name characters; values are always escaped.
    public fn element_attr(Page&mut self, string tag, string name, string attribute_value, string value) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (!append_attribute_to(&mut self.body, name, attribute_value) || !self.body.push_str(">")) { return false; }
        if (!append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</") && append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    /// Safe multi-attribute variants for ordinary HTML without dropping to raw().
    public fn element_attr2(Page&mut self, string tag, string name1, string value1, string name2, string value2, string value) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (!append_attribute_to(&mut self.body, name1, value1) || !append_attribute_to(&mut self.body, name2, value2) || !self.body.push_str(">")) { return false; }
        if (!append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</") && append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    public fn element_attr3(Page&mut self, string tag, string name1, string value1, string name2, string value2, string name3, string value3, string value) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (!append_attribute_to(&mut self.body, name1, value1) || !append_attribute_to(&mut self.body, name2, value2) || !append_attribute_to(&mut self.body, name3, value3) || !self.body.push_str(">")) { return false; }
        if (!append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("</") && append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    public fn void_element(Page&mut self, string tag) -> bool {
        return self.body.push_str("<") && append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    public fn void_attr(Page&mut self, string tag, string name, string value) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        return append_attribute_to(&mut self.body, name, value) && self.body.push_str(">\n");
    }

    public fn void_attr2(Page&mut self, string tag, string name1, string value1, string name2, string value2) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        return append_attribute_to(&mut self.body, name1, value1) && append_attribute_to(&mut self.body, name2, value2) && self.body.push_str(">\n");
    }

    public fn void_attr3(Page&mut self, string tag, string name1, string value1, string name2, string value2, string name3, string value3) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        return append_attribute_to(&mut self.body, name1, value1) && append_attribute_to(&mut self.body, name2, value2) && append_attribute_to(&mut self.body, name3, value3) && self.body.push_str(">\n");
    }


    // ---- links/media/forms ------------------------------------------------------
    public fn a(Page&mut self, string href, string label) -> bool {
        if (!self.body.push_str("<a href=\"") || !append_escaped_to(&mut self.body, href) || !self.body.push_str("\">")) { return false; }
        if (!append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</a>\n");
    }
    public fn link(Page&mut self, string href, string label) -> bool { return self.a(href, label); }
    public fn a_class(Page&mut self, string href, string class_name, string label) -> bool {
        if (!self.body.push_str("<a href=\"") || !append_escaped_to(&mut self.body, href) || !self.body.push_str("\" class=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\">")) { return false; }
        if (!append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</a>\n");
    }

    public fn a_external(Page&mut self, string href, string label) -> bool {
        if (!self.body.push_str("<a href=\"") || !append_escaped_to(&mut self.body, href)) { return false; }
        if (!self.body.push_str("\" target=\"_blank\" rel=\"noopener noreferrer\">")) { return false; }
        if (!append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</a>\n");
    }

    public fn image(Page&mut self, string src, string alt) -> bool {
        if (!self.body.push_str("<img src=\"") || !append_escaped_to(&mut self.body, src) || !self.body.push_str("\" alt=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, alt)) { return false; }
        return self.body.push_str("\">\n");
    }

    public fn image_lazy(Page&mut self, string src, string alt) -> bool {
        if (!self.body.push_str("<img src=\"") || !append_escaped_to(&mut self.body, src) || !self.body.push_str("\" alt=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, alt)) { return false; }
        return self.body.push_str("\" loading=\"lazy\" decoding=\"async\">\n");
    }

    public fn image_size(Page&mut self, string src, string alt, string width, string height) -> bool {
        if (!self.body.push_str("<img src=\"") || !append_escaped_to(&mut self.body, src) || !self.body.push_str("\" alt=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, alt) || !self.body.push_str("\" width=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, width) || !self.body.push_str("\" height=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, height)) { return false; }
        return self.body.push_str("\">\n");
    }

    public fn source(Page&mut self, string src, string media_type) -> bool {
        return self.void_attr2("source", "src", src, "type", media_type);
    }

    public fn source_media(Page&mut self, string srcset, string media) -> bool {
        return self.void_attr2("source", "srcset", srcset, "media", media);
    }

    public fn track(Page&mut self, string src, string kind, string language) -> bool {
        return self.void_attr3("track", "src", src, "kind", kind, "srclang", language);
    }

    public fn iframe(Page&mut self, string src, string title) -> bool {
        if (!self.body.push_str("<iframe src=\"") || !append_escaped_to(&mut self.body, src) || !self.body.push_str("\" title=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, title)) { return false; }
        return self.body.push_str("\"></iframe>\n");
    }

    public fn button(Page&mut self, string label) -> bool { return body_tag_text(self, "button", "", label); }
    public fn button_id(Page&mut self, string id, string label) -> bool { return body_tag_id_text(self, "button", id, "", label); }

    public fn input(Page&mut self, string input_type, string name, string placeholder) -> bool {
        if (!self.body.push_str("<input type=\"") || !append_escaped_to(&mut self.body, input_type) || !self.body.push_str("\" name=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, name) || !self.body.push_str("\" placeholder=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, placeholder)) { return false; }
        return self.body.push_str("\">\n");
    }

    public fn input_id(Page&mut self, string id, string input_type, string name, string placeholder) -> bool {
        if (!self.body.push_str("<input id=\"") || !append_escaped_to(&mut self.body, id) || !self.body.push_str("\" type=\"") || !append_escaped_to(&mut self.body, input_type) || !self.body.push_str("\" name=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, name) || !self.body.push_str("\" placeholder=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, placeholder)) { return false; }
        return self.body.push_str("\">\n");
    }

    public fn label_for(Page&mut self, string target_id, string label) -> bool {
        if (!self.body.push_str("<label for=\"") || !append_escaped_to(&mut self.body, target_id) || !self.body.push_str("\">")) { return false; }
        if (!append_escaped_to(&mut self.body, label)) { return false; }
        return self.body.push_str("</label>\n");
    }

    public fn input_text(Page&mut self, string name, string placeholder) -> bool { return self.input("text", name, placeholder); }
    public fn input_email(Page&mut self, string name, string placeholder) -> bool { return self.input("email", name, placeholder); }
    public fn input_password(Page&mut self, string name, string placeholder) -> bool { return self.input("password", name, placeholder); }
    public fn input_search(Page&mut self, string name, string placeholder) -> bool { return self.input("search", name, placeholder); }
    public fn input_number(Page&mut self, string name, string placeholder) -> bool { return self.input("number", name, placeholder); }
    public fn input_url(Page&mut self, string name, string placeholder) -> bool { return self.input("url", name, placeholder); }
    public fn input_tel(Page&mut self, string name, string placeholder) -> bool { return self.input("tel", name, placeholder); }
    public fn input_date(Page&mut self, string name) -> bool { return self.input("date", name, ""); }
    public fn input_month(Page&mut self, string name) -> bool { return self.input("month", name, ""); }
    public fn input_week(Page&mut self, string name) -> bool { return self.input("week", name, ""); }
    public fn input_time(Page&mut self, string name) -> bool { return self.input("time", name, ""); }
    public fn input_datetime_local(Page&mut self, string name) -> bool { return self.input("datetime-local", name, ""); }
    public fn input_color(Page&mut self, string name) -> bool { return self.input("color", name, ""); }

    /// Range input with native browser validation and no client runtime requirement.
    public fn input_range(Page&mut self, string name, string minimum, string maximum, string step) -> bool {
        if (!self.body.push_str("<input type=\"range\" name=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\" min=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, minimum) || !self.body.push_str("\" max=\"") || !append_escaped_to(&mut self.body, maximum) || !self.body.push_str("\" step=\"") || !append_escaped_to(&mut self.body, step)) { return false; }
        return self.body.push_str("\">\n");
    }

    /// Hidden form value. This remains ordinary HTML and does not require the browser runtime.
    public fn input_hidden(Page&mut self, string name, string value) -> bool {
        if (!self.body.push_str("<input type=\"hidden\" name=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\" value=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("\">\n");
    }

    /// Progressive-enhancement checkbox. `checked` only controls initial HTML state.
    public fn input_checkbox(Page&mut self, string name, string value, bool checked) -> bool {
        if (!self.body.push_str("<input type=\"checkbox\" name=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\" value=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, value) || !self.body.push_str("\"")) { return false; }
        if (checked && !self.body.push_str(" checked")) { return false; }
        return self.body.push_str(">\n");
    }

    public fn input_radio(Page&mut self, string name, string value, bool checked) -> bool {
        if (!self.body.push_str("<input type=\"radio\" name=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\" value=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, value) || !self.body.push_str("\"")) { return false; }
        if (checked && !self.body.push_str(" checked")) { return false; }
        return self.body.push_str(">\n");
    }

    public fn input_file(Page&mut self, string name, string accept) -> bool {
        if (!self.body.push_str("<input type=\"file\" name=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\"")) { return false; }
        if (raz_rt_cstr_len(accept) > 0) {
            if (!self.body.push_str(" accept=\"") || !append_escaped_to(&mut self.body, accept) || !self.body.push_str("\"")) { return false; }
        }
        return self.body.push_str(">\n");
    }

    public fn input_submit(Page&mut self, string value) -> bool {
        if (!self.body.push_str("<input type=\"submit\" value=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, value)) { return false; }
        return self.body.push_str("\">\n");
    }

    public fn form(Page&mut self, string action, string method, string class_name) -> bool {
        if (!self.body.push_str("<form action=\"") || !append_escaped_to(&mut self.body, action) || !self.body.push_str("\" method=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, method) || !self.body.push_str("\"")) { return false; }
        if (raz_rt_cstr_len(class_name) > 0) {
            if (!self.body.push_str(" class=\"") || !append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\"")) { return false; }
        }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn form_get(Page&mut self, string action, string class_name) -> bool { return self.form(action, "get", class_name); }
    public fn form_post(Page&mut self, string action, string class_name) -> bool { return self.form(action, "post", class_name); }

    /// POST form suitable for file uploads on ordinary static/server-backed sites.
    public fn form_multipart(Page&mut self, string action, string class_name) -> bool {
        if (!self.body.push_str("<form action=\"") || !append_escaped_to(&mut self.body, action) || !self.body.push_str("\" method=\"post\" enctype=\"multipart/form-data\"")) { return false; }
        if (raz_rt_cstr_len(class_name) > 0) {
            if (!self.body.push_str(" class=\"") || !append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\"")) { return false; }
        }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    // ---- containers -------------------------------------------------------------
    public fn open(Page&mut self, string tag, string class_name) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (raz_rt_cstr_len(class_name) > 0) {
            if (!self.body.push_str(" class=\"") || !append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\"")) { return false; }
        }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn open_id(Page&mut self, string tag, string id, string class_name) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (raz_rt_cstr_len(id) > 0) {
            if (!self.body.push_str(" id=\"") || !append_escaped_to(&mut self.body, id) || !self.body.push_str("\"")) { return false; }
        }
        if (raz_rt_cstr_len(class_name) > 0) {
            if (!self.body.push_str(" class=\"") || !append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\"")) { return false; }
        }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn open_attr(Page&mut self, string tag, string name, string value) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (!append_attribute_to(&mut self.body, name, value) || !self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn open_attr2(Page&mut self, string tag, string name1, string value1, string name2, string value2) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (!append_attribute_to(&mut self.body, name1, value1) || !append_attribute_to(&mut self.body, name2, value2) || !self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn open_attr3(Page&mut self, string tag, string name1, string value1, string name2, string value2, string name3, string value3) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (!append_attribute_to(&mut self.body, name1, value1) || !append_attribute_to(&mut self.body, name2, value2) || !append_attribute_to(&mut self.body, name3, value3) || !self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn open_bool_attr(Page&mut self, string tag, string name) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (!append_boolean_attribute_to(&mut self.body, name) || !self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn begin(Page&mut self, string tag, string class_name) -> bool { return self.open(tag, class_name); }
    public fn begin_id(Page&mut self, string tag, string id, string class_name) -> bool { return self.open_id(tag, id, class_name); }

    public fn close(Page&mut self, string tag) -> bool {
        if (self.open_depth > 0) { self.open_depth -= 1; }
        return self.body.push_str("</") && append_html_name_to(&mut self.body, tag) && self.body.push_str(">\n");
    }

    public fn end(Page&mut self, string tag) -> bool { return self.close(tag); }

    public fn main(Page&mut self, string class_name) -> bool { return self.open("main", class_name); }
    public fn section(Page&mut self, string class_name) -> bool { return self.open("section", class_name); }
    public fn div(Page&mut self, string class_name) -> bool { return self.open("div", class_name); }
    public fn div_id(Page&mut self, string id, string class_name) -> bool { return self.open_id("div", id, class_name); }

    /// Opens a reusable layout boundary. Layouts are ordinary HTML and carry
    /// only a data marker for styling/testing; they introduce no browser runtime.
    public fn layout(Page&mut self, string name, string class_name) -> bool {
        if (!html_name_valid(name)) { return false; }
        if (!self.body.push_str("<div data-raz-layout=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\"")) { return false; }
        if (raz_rt_cstr_len(class_name) > 0) {
            if (!self.body.push_str(" class=\"") || !append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\"")) { return false; }
        }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }
    public fn nav(Page&mut self, string class_name) -> bool { return self.open("nav", class_name); }
    public fn header(Page&mut self, string class_name) -> bool { return self.open("header", class_name); }
    public fn footer(Page&mut self, string class_name) -> bool { return self.open("footer", class_name); }
    public fn ul(Page&mut self, string class_name) -> bool { return self.open("ul", class_name); }
    public fn ol(Page&mut self, string class_name) -> bool { return self.open("ol", class_name); }
    public fn article(Page&mut self, string class_name) -> bool { return self.open("article", class_name); }
    public fn aside(Page&mut self, string class_name) -> bool { return self.open("aside", class_name); }
    public fn figure(Page&mut self, string class_name) -> bool { return self.open("figure", class_name); }
    public fn details(Page&mut self, string class_name) -> bool { return self.open("details", class_name); }
    public fn table(Page&mut self, string class_name) -> bool { return self.open("table", class_name); }
    public fn thead(Page&mut self, string class_name) -> bool { return self.open("thead", class_name); }
    public fn tbody(Page&mut self, string class_name) -> bool { return self.open("tbody", class_name); }
    public fn tfoot(Page&mut self, string class_name) -> bool { return self.open("tfoot", class_name); }
    public fn tr(Page&mut self, string class_name) -> bool { return self.open("tr", class_name); }
    public fn dl(Page&mut self, string class_name) -> bool { return self.open("dl", class_name); }
    public fn menu(Page&mut self, string class_name) -> bool { return self.open("menu", class_name); }
    public fn search(Page&mut self, string class_name) -> bool { return self.open("search", class_name); }
    public fn fieldset(Page&mut self, string class_name) -> bool { return self.open("fieldset", class_name); }
    public fn picture(Page&mut self, string class_name) -> bool { return self.open("picture", class_name); }
    public fn audio(Page&mut self, string class_name) -> bool { return self.open("audio", class_name); }
    public fn video(Page&mut self, string class_name) -> bool { return self.open("video", class_name); }
    public fn canvas(Page&mut self, string class_name) -> bool { return self.open("canvas", class_name); }
    public fn select(Page&mut self, string class_name) -> bool { return self.open("select", class_name); }

    /// Accessible container carrying id, class, role, and aria-label in one call.
    public fn landmark(Page&mut self, string tag, string id, string class_name, string role, string label) -> bool {
        if (!self.body.push_str("<") || !append_html_name_to(&mut self.body, tag)) { return false; }
        if (raz_rt_cstr_len(id) > 0 && !append_attribute_to(&mut self.body, "id", id)) { return false; }
        if (raz_rt_cstr_len(class_name) > 0 && !append_attribute_to(&mut self.body, "class", class_name)) { return false; }
        if (raz_rt_cstr_len(role) > 0 && !append_attribute_to(&mut self.body, "role", role)) { return false; }
        if (raz_rt_cstr_len(label) > 0 && !append_attribute_to(&mut self.body, "aria-label", label)) { return false; }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    /// Begin a normal SVG fragment. Child SVG elements use the same safe open/
    /// element/void helpers because SVG tag and attribute names share the name grammar.
    public fn svg(Page&mut self, string view_box, string class_name) -> bool {
        if (!self.body.push_str("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"") || !append_escaped_to(&mut self.body, view_box) || !self.body.push_str("\"")) { return false; }
        if (raz_rt_cstr_len(class_name) > 0) {
            if (!self.body.push_str(" class=\"") || !append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\"")) { return false; }
        }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn svg_path(Page&mut self, string d) -> bool { return self.element_attr("path", "d", d, ""); }
    public fn svg_use(Page&mut self, string href) -> bool { return self.element_attr("use", "href", href, ""); }
    public fn select_name(Page&mut self, string name, string class_name) -> bool {
        if (!self.body.push_str("<select name=\"") || !append_escaped_to(&mut self.body, name) || !self.body.push_str("\"")) { return false; }
        if (raz_rt_cstr_len(class_name) > 0) {
            if (!self.body.push_str(" class=\"") || !append_escaped_to(&mut self.body, class_name) || !self.body.push_str("\"")) { return false; }
        }
        if (!self.body.push_str(">\n")) { return false; }
        self.open_depth += 1;
        return true;
    }

    public fn end_main(Page&mut self) -> bool { return self.close("main"); }
    public fn end_section(Page&mut self) -> bool { return self.close("section"); }
    public fn end_div(Page&mut self) -> bool { return self.close("div"); }
    public fn end_layout(Page&mut self) -> bool { return self.close("div"); }
    public fn end_nav(Page&mut self) -> bool { return self.close("nav"); }
    public fn end_header(Page&mut self) -> bool { return self.close("header"); }
    public fn end_footer(Page&mut self) -> bool { return self.close("footer"); }
    public fn end_ul(Page&mut self) -> bool { return self.close("ul"); }
    public fn end_ol(Page&mut self) -> bool { return self.close("ol"); }
    public fn end_article(Page&mut self) -> bool { return self.close("article"); }
    public fn end_aside(Page&mut self) -> bool { return self.close("aside"); }
    public fn end_figure(Page&mut self) -> bool { return self.close("figure"); }
    public fn end_details(Page&mut self) -> bool { return self.close("details"); }
    public fn end_table(Page&mut self) -> bool { return self.close("table"); }
    public fn end_thead(Page&mut self) -> bool { return self.close("thead"); }
    public fn end_tbody(Page&mut self) -> bool { return self.close("tbody"); }
    public fn end_tfoot(Page&mut self) -> bool { return self.close("tfoot"); }
    public fn end_tr(Page&mut self) -> bool { return self.close("tr"); }
    public fn end_dl(Page&mut self) -> bool { return self.close("dl"); }
    public fn end_menu(Page&mut self) -> bool { return self.close("menu"); }
    public fn end_search(Page&mut self) -> bool { return self.close("search"); }
    public fn end_fieldset(Page&mut self) -> bool { return self.close("fieldset"); }
