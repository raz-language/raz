    if (!script.push_str("storage_value_length: (keyPtr) => { const value = localStorage.getItem(rzCstr(keyPtr)); return value === null ? -1n : BigInt(rzEncoder.encode(value).length); },\n")) { return false; }
    if (!script.push_str("storage_value_write: (keyPtr, outPtr, capacity) => { const value = localStorage.getItem(rzCstr(keyPtr)); if (value === null) return -1n; const bytes = rzEncoder.encode(value); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("session_storage_set: (keyPtr, valuePtr) => { try { sessionStorage.setItem(rzCstr(keyPtr), rzCstr(valuePtr)); return 1n; } catch (_) { return 0n; } }, session_storage_remove: (keyPtr) => { try { sessionStorage.removeItem(rzCstr(keyPtr)); return 1n; } catch (_) { return 0n; } }, session_storage_clear: () => { try { sessionStorage.clear(); return 1n; } catch (_) { return 0n; } }, session_storage_value_length: (keyPtr) => { const value = sessionStorage.getItem(rzCstr(keyPtr)); return value === null ? -1n : BigInt(rzEncoder.encode(value).length); }, session_storage_value_write: (keyPtr, outPtr, capacity) => { const value = sessionStorage.getItem(rzCstr(keyPtr)); if (value === null) return -1n; const bytes = rzEncoder.encode(value); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("location_href_length: () => BigInt(rzEncoder.encode(location.href).length),\n")) { return false; }
    if (!script.push_str("location_href_write: (outPtr, capacity) => { const bytes = rzEncoder.encode(location.href); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("location_origin_length: () => BigInt(rzEncoder.encode(location.origin).length), location_origin_write: (outPtr, capacity) => { const bytes = rzEncoder.encode(location.origin); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0,count)); return BigInt(count); }, location_pathname_length: () => BigInt(rzEncoder.encode(location.pathname).length), location_pathname_write: (outPtr, capacity) => { const bytes = rzEncoder.encode(location.pathname); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0,count)); return BigInt(count); }, location_search_length: () => BigInt(rzEncoder.encode(location.search).length), location_search_write: (outPtr, capacity) => { const bytes = rzEncoder.encode(location.search); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0,count)); return BigInt(count); }, location_hash_length: () => BigInt(rzEncoder.encode(location.hash).length), location_hash_write: (outPtr, capacity) => { const bytes = rzEncoder.encode(location.hash); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0,count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("location_assign: (urlPtr) => { location.assign(rzCstr(urlPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("location_replace: (urlPtr) => { location.replace(rzCstr(urlPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("location_reload: () => { location.reload(); return 1n; },\n")) { return false; }
    if (!script.push_str("url_query_value_length: (namePtr) => { const p = new URLSearchParams(location.search); const key = rzCstr(namePtr); if (!p.has(key)) return -1n; return BigInt(rzEncoder.encode(p.get(key) || '').length); }, url_query_value_write: (namePtr, outPtr, capacity) => { const p = new URLSearchParams(location.search); const key = rzCstr(namePtr); if (!p.has(key)) return -1n; const bytes = rzEncoder.encode(p.get(key) || ''); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0,count)); return BigInt(count); }, url_query_has: (namePtr) => new URLSearchParams(location.search).has(rzCstr(namePtr)) ? 1n : 0n, url_encode_length: (valuePtr) => BigInt(rzEncoder.encode(encodeURIComponent(rzCstr(valuePtr))).length), url_encode_write: (valuePtr, outPtr, capacity) => { const bytes = rzEncoder.encode(encodeURIComponent(rzCstr(valuePtr))); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0,count)); return BigInt(count); }, url_decode_length: (valuePtr) => { try { return BigInt(rzEncoder.encode(decodeURIComponent(rzCstr(valuePtr))).length); } catch (_) { return -1n; } }, url_decode_write: (valuePtr, outPtr, capacity) => { try { const bytes = rzEncoder.encode(decodeURIComponent(rzCstr(valuePtr))); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0,count)); return BigInt(count); } catch (_) { return -1n; } },\n")) { return false; }
    if (!script.push_str("history_push: (urlPtr) => { history.pushState(null, '', rzCstr(urlPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("history_replace: (urlPtr) => { history.replaceState(null, '', rzCstr(urlPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("history_back: () => { history.back(); return 1n; },\n")) { return false; }
    if (!script.push_str("history_forward: () => { history.forward(); return 1n; },\n")) { return false; }
    if (!script.push_str("clipboard_write: (valuePtr) => { if (!navigator.clipboard) return 0n; void navigator.clipboard.writeText(rzCstr(valuePtr)); return 1n; }\n")) { return false; }
    if (!script.push_str("} };\nconst rzLoadWasm = async (url) => { const response = await fetch(url); const bytes = await response.arrayBuffer(); const { instance } = await WebAssembly.instantiate(bytes, rzImports); return instance.exports; };\n")) { return false; }
    if (page.browser_roots.len() > 0) {
        if (!script.push_str("const rzMain = await rzLoadWasm('/app.wasm');\nrzUse(rzMain);\n")) { return false; }
    }
    if (!script.push_string(&page.client)) { return false; }
    if (!web::build::fs::write_string(&script_path, &script)) { return false; }

    // The native/static generator is authoritative about whether browser code
    // exists. The compiler consumes this private marker after generation and
    // emits app.wasm only when at least one route actually bound an event.
    bool ok = true;
    if (page.browser_roots.len() > 0) {
        String marker_path = String::from("dist/.raz-wasm-required");
        ok = web::build::fs::append_string(&marker_path, &page.browser_roots);
    }
    if (ok && page.browser_chunks.len() > 0) {
        String chunks_path = String::from("dist/.raz-wasm-chunks");
        ok = web::build::fs::append_string(&chunks_path, &page.browser_chunks);
    }
    return ok;
}

fn string_contains(String& haystack, String& needle) -> bool {
    i64 haystack_length = haystack.len();
    i64 needle_length = needle.len();
    if (needle_length == 0) { return true; }
    if (needle_length > haystack_length) { return false; }
    usize haystack_data = haystack.as_ptr();
    usize needle_data = needle.as_ptr();
    i64 start = 0;
    while (start + needle_length <= haystack_length) {
        i64 i = 0;
        bool same = true;
        while (i < needle_length) {
            if (raz_rt_load_u8(haystack_data + start + i) != raz_rt_load_u8(needle_data + i)) {
                same = false;
                break;
            }
            i += 1;
        }
        if (same) { return true; }
        start += 1;
    }
    return false;
}

fn append_css_rule(Page&mut page, string prefix, string name, string selector, string declarations) -> bool {
    String rule = String::with_capacity(raz_rt_cstr_len(prefix) + raz_rt_cstr_len(name) + raz_rt_cstr_len(selector) + raz_rt_cstr_len(declarations) + 24);
    if (!rule.push_str(prefix)) { return false; }
    if (raz_rt_cstr_len(name) > 0 && !rule.push_str(name)) { return false; }
    if (raz_rt_cstr_len(selector) > 0 && !rule.push_str(selector)) { return false; }
    if (!rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" }\n")) { return false; }
    if (string_contains(&page.css, &rule)) { return true; }
    return page.css.push_string(&rule);
}

fn write_css_for_path(Page&mut page, String& html_path) -> bool {
    usize data = html_path.as_ptr();
    i64 length = html_path.len();
    i64 slash = -1;
    i64 i = 0;
    while (i < length) {
        i64 ch = raz_rt_load_u8(data + i);
        if (ch == 47 || ch == 92) { slash = i; }
        i += 1;
    }

    String css_path = String::with_capacity(length + 16);
    i = 0;
    while (i <= slash) {
        if (!css_path.push(raz_rt_load_u8(data + i))) { return false; }
        i += 1;
    }
    if (!css_path.push_str("app.css")) { return false; }
    if (page.css.len() == 0) {
        return web::build::fs::remove_file_if_present(&css_path);
    }
    return web::build::fs::write_string(&css_path, &page.css);
}

fn write_page_to(Page&mut page, String& path) -> bool {
    String document = String::with_capacity(page.head.len() + page.body.len() + 256);
    if (!document.push_str("<!doctype html>\n") ||
        !document.push_string(&page.html_open) ||
        !document.push_str("<head>\n") ||
        !document.push_string(&page.head)) {
        return false;
    }
    if (page.css.len() > 0) {
        if (!document.push_str("<link rel=\"stylesheet\" href=\"./app.css\">\n")) { return false; }
    }
    if (!document.push_str("</head>\n<body>\n") ||
        !document.push_string(&page.body)) {
        return false;
    }
    if (page.client.len() > 0) {
        if (!document.push_str("<script type=\"module\" src=\"./app.js\"></script>\n")) { return false; }
    }
    if (!document.push_str("</body>\n</html>\n")) { return false; }

    if (!web::build::fs::write_string(path, &document)) { return false; }
    if (!write_css_for_path(page, path)) { return false; }
    return write_client_for_path(page, path);
}


fn static_route_segment_forbidden(usize data, i64 start, i64 length) -> bool {
    if (length == 1 && raz_rt_load_u8(data + start) == 46) { return true; }
    if (length == 2 && raz_rt_load_u8(data + start) == 46 && raz_rt_load_u8(data + start + 1) == 46) { return true; }
    return false;
}

fn static_route_valid(string route) -> bool {
    i64 length = raz_rt_cstr_len(route);
    if (length <= 0) { return false; }
    usize data = raz_rt_cstr_ptr(route);
    if (raz_rt_load_u8(data) != 47) { return false; }
    if (length == 1) { return true; }
    i64 segment_start = 1;
    i64 i = 1;
    while (i <= length) {
        i64 ch = 47;
        if (i < length) { ch = raz_rt_load_u8(data + i); }
        if (ch == 92 || ch == 63 || ch == 35 || ch == 0) { return false; }
        if (ch == 47) {
            i64 segment_length = i - segment_start;
            if (segment_length <= 0 || static_route_segment_forbidden(data, segment_start, segment_length)) { return false; }
            segment_start = i + 1;
        }
        i += 1;
    }
    return true;
}

fn static_route_output(string route, String&mut output) -> bool {
    if (!static_route_valid(route)) { return false; }
    if (!output.push_str("dist")) { return false; }
    i64 length = raz_rt_cstr_len(route);
    if (length > 1 && !output.push_str(route)) { return false; }
    if (!web::build::fs::create_dir_all(output.as_ptr(), output.len())) { return false; }
    return output.push_str("/index.html");
}

fn route_name_byte(i64 ch) -> bool {
    if (ch >= 48 && ch <= 57) { return true; }
    if (ch >= 65 && ch <= 90) { return true; }
    if (ch >= 97 && ch <= 122) { return true; }
    return ch == 45 || ch == 95;
}

fn route_name_valid(string name) -> bool {
    i64 length = raz_rt_cstr_len(name);
    if (length <= 0) { return false; }
    usize data = raz_rt_cstr_ptr(name);
    i64 i = 0;
    while (i < length) {
        if (!route_name_byte(raz_rt_load_u8(data + i))) { return false; }
        i += 1;
    }
    return true;
}

fn static_route_value_valid(string value, bool splat) -> bool {
    i64 length = raz_rt_cstr_len(value);
    if (length <= 0) { return false; }
    usize data = raz_rt_cstr_ptr(value);
    i64 start = 0;
    i64 i = 0;
    while (i <= length) {
        bool boundary = i == length;
        i64 ch = 0;
        if (!boundary) {
            ch = raz_rt_load_u8(data + i);
            if (ch == 92 || ch == 63 || ch == 35 || ch == 0) { return false; }
            boundary = ch == 47;
        }
        if (!boundary) { i += 1; continue; }
        if (!splat && i != length) { return false; }
        i64 segment_length = i - start;
        if (segment_length <= 0 || static_route_segment_forbidden(data, start, segment_length)) { return false; }
        start = i + 1;
        i += 1;
    }
    return true;
}

fn static_route_marker_matches(usize data, i64 start, i64 length, i64 marker, string name) -> bool {
    if (length <= 1 || raz_rt_load_u8(data + start) != marker) { return false; }
    i64 name_length = raz_rt_cstr_len(name);
    if (length - 1 != name_length) { return false; }
    usize name_data = raz_rt_cstr_ptr(name);
    i64 i = 0;
    while (i < name_length) {
        if (raz_rt_load_u8(data + start + 1 + i) != raz_rt_load_u8(name_data + i)) { return false; }
        i += 1;
    }
    return true;
}

/// Copies a route pattern into an owned build-time path. Dynamic `:name` and
/// final `*name` segments can then be bound with route_bind/route_bind_splat.
public fn route_path(string pattern) -> String {
    return String::from(pattern);
}

fn route_bind_value(String&mut path, string name, string value, bool splat) -> bool {
    if (!route_name_valid(name) || !static_route_value_valid(value, splat)) { return false; }
    i64 length = path.len();
    usize data = path.as_ptr();
    String next = String::with_capacity(length + raz_rt_cstr_len(value) + 8);
    i64 i = 0;
    bool replaced = false;
    while (i < length) {
        if (raz_rt_load_u8(data + i) == 47) {
            i64 start = i + 1;
            i64 end = start;
            while (end < length && raz_rt_load_u8(data + end) != 47) { end += 1; }
            i64 marker = 58;
            if (splat) { marker = 42; }
            if (!replaced && static_route_marker_matches(data, start, end - start, marker, name)) {
                if (!next.push(47) || !next.push_str(value)) { return false; }
                replaced = true;
                i = end;
                continue;
            }
        }
        if (!next.push(raz_rt_load_u8(data + i))) { return false; }
        i += 1;
    }
    if (!replaced) { return false; }
    *path = move next;
    return true;
}

public fn route_bind(String&mut path, string name, string value) -> bool {
    return route_bind_value(path, name, value, false);
}

public fn route_bind_splat(String&mut path, string name, string value) -> bool {
    return route_bind_value(path, name, value, true);
}

fn static_route_string_valid(String& route) -> bool {
    i64 length = route.len();
    if (length <= 0) { return false; }
    usize data = route.as_ptr();
    if (raz_rt_load_u8(data) != 47) { return false; }
    if (length == 1) { return true; }
    i64 segment_start = 1;
    i64 i = 1;
    while (i <= length) {
        i64 ch = 47;
        if (i < length) { ch = raz_rt_load_u8(data + i); }
        if (ch == 92 || ch == 63 || ch == 35 || ch == 0) { return false; }
        if (ch == 47) {
            i64 segment_length = i - segment_start;
            if (segment_length <= 0 || static_route_segment_forbidden(data, segment_start, segment_length)) { return false; }
            i64 first = raz_rt_load_u8(data + segment_start);
            if (first == 58 || first == 42) { return false; }
            segment_start = i + 1;
        }
        i += 1;
    }
    return true;
}

fn static_route_output_string(String& route, String&mut output) -> bool {
    if (!static_route_string_valid(route)) { return false; }
    if (!output.push_str("dist")) { return false; }
    if (route.len() > 1 && !output.push_string(route)) { return false; }
    if (!web::build::fs::create_dir_all(output.as_ptr(), output.len())) { return false; }
    return output.push_str("/index.html");
}

/// Emits a host-independent redirect page at a static route. The generated
/// document uses a standards-based meta refresh plus a normal fallback link;
/// it intentionally requires no JavaScript or WebAssembly.
public fn write_redirect(string route, string target) -> bool {
    String path = String::new();
    if (!static_route_output(route, &mut path)) { return false; }
    String document = String::with_capacity(512 + raz_rt_cstr_len(target) * 2);
    if (!document.push_str("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta http-equiv=\"refresh\" content=\"0;url=")) { return false; }
    if (!append_escaped_to(&mut document, target)) { return false; }
    if (!document.push_str("\">\n<link rel=\"canonical\" href=\"")) { return false; }
    if (!append_escaped_to(&mut document, target)) { return false; }
    if (!document.push_str("\"></head><body><p>Redirecting to <a href=\"")) { return false; }
    if (!append_escaped_to(&mut document, target)) { return false; }
    if (!document.push_str("\">")) { return false; }
    if (!append_escaped_to(&mut document, target)) { return false; }
    if (!document.push_str("</a>.</p></body></html>\n")) { return false; }
    return web::build::fs::write_string(&path, &document);
}

public impl Page {
    public fn new(string title) -> Page {
        Page page = Page {
            html_open: String::with_capacity(64),
            head: String::with_capacity(512),
            body: String::with_capacity(2048),
            css: String::with_capacity(1024),
            client: String::with_capacity(1024),
            browser_roots: String::with_capacity(256),
            browser_chunks: String::with_capacity(256),
            open_depth: 0,
        };
        page.html_open.push_str("<html lang=\"en\">\n");
        page.head.push_str("<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
        append_escaped_to(&mut page.head, title);
        page.head.push_str("</title>\n");
        return page;
    }

    public fn new_lang(string title, string language) -> Page {
        Page page = Page {
            html_open: String::with_capacity(64),
            head: String::with_capacity(512),
            body: String::with_capacity(2048),
            css: String::with_capacity(1024),
            client: String::with_capacity(1024),
            browser_roots: String::with_capacity(256),
            browser_chunks: String::with_capacity(256),
            open_depth: 0,
        };
        page.html_open.push_str("<html lang=\"");
        append_escaped_to(&mut page.html_open, language);
        page.html_open.push_str("\">\n");
        page.head.push_str("<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
        append_escaped_to(&mut page.head, title);
        page.head.push_str("</title>\n");
        return page;
    }

    // ---- head metadata / assets -------------------------------------------------
    public fn description(Page&mut self, string value) -> bool {
        if (!self.head.push_str("<meta name=\"description\" content=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, value)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn author(Page&mut self, string value) -> bool {
        if (!self.head.push_str("<meta name=\"author\" content=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, value)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn theme_color(Page&mut self, string value) -> bool {
        if (!self.head.push_str("<meta name=\"theme-color\" content=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, value)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn canonical(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"canonical\" href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn meta(Page&mut self, string name, string content) -> bool {
        if (!self.head.push_str("<meta name=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, name) || !self.head.push_str("\" content=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, content)) { return false; }
        return self.head.push_str("\">\n");
    }

    /// Metadata whose key uses the HTML `property` attribute, such as Open Graph.
    public fn meta_property(Page&mut self, string property_name, string content) -> bool {
        if (!self.head.push_str("<meta property=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, property_name) || !self.head.push_str("\" content=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, content)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn keywords(Page&mut self, string value) -> bool { return self.meta("keywords", value); }
    public fn robots(Page&mut self, string value) -> bool { return self.meta("robots", value); }

    public fn base(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<base href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn manifest(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"manifest\" href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn alternate(Page&mut self, string href, string language) -> bool {
        if (!self.head.push_str("<link rel=\"alternate\" href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href) || !self.head.push_str("\" hreflang=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, language)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn preload(Page&mut self, string href, string resource_type) -> bool {
        if (!self.head.push_str("<link rel=\"preload\" href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href) || !self.head.push_str("\" as=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, resource_type)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn stylesheet(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"stylesheet\" href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    /// Add a static CSS rule. Raz extracts these rules to app.css beside the
    /// generated HTML. Identical rules are emitted once per page.
    public fn style(Page&mut self, string selector, string declarations) -> bool {
        return append_css_rule(self, "", "", selector, declarations);
    }

    public fn css(Page&mut self, string selector, string declarations) -> bool {
        return self.style(selector, declarations);
    }

    public fn css_class(Page&mut self, string class_name, string declarations) -> bool {
        if (!html_name_valid(class_name)) { return false; }
        return append_css_rule(self, ".", class_name, "", declarations);
    }

    public fn css_id(Page&mut self, string id_name, string declarations) -> bool {
        if (!html_name_valid(id_name)) { return false; }
        return append_css_rule(self, "#", id_name, "", declarations);
    }
    public fn css_pseudo(Page&mut self, string selector, string pseudo, string declarations) -> bool {
        if (!html_name_valid(pseudo)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(selector) + raz_rt_cstr_len(pseudo) + raz_rt_cstr_len(declarations) + 16);
        if (!rule.push_str(selector) || !rule.push_str(":") || !rule.push_str(pseudo) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }
    public fn css_pseudo_element(Page&mut self, string selector, string pseudo, string declarations) -> bool {
        if (!html_name_valid(pseudo)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(selector) + raz_rt_cstr_len(pseudo) + raz_rt_cstr_len(declarations) + 17);
        if (!rule.push_str(selector) || !rule.push_str("::") || !rule.push_str(pseudo) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_media(Page&mut self, string query, string selector, string declarations) -> bool {
        String rule = String::with_capacity(raz_rt_cstr_len(query) + raz_rt_cstr_len(selector) + raz_rt_cstr_len(declarations) + 32);
        if (!rule.push_str("@media ") || !rule.push_str(query) || !rule.push_str(" { ") || !rule.push_str(selector) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" } }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_container(Page&mut self, string query, string selector, string declarations) -> bool {
        String rule = String::with_capacity(raz_rt_cstr_len(query) + raz_rt_cstr_len(selector) + raz_rt_cstr_len(declarations) + 36);
        if (!rule.push_str("@container ") || !rule.push_str(query) || !rule.push_str(" { ") || !rule.push_str(selector) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" } }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_variable(Page&mut self, string name, string value) -> bool {
        if (!html_name_valid(name)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(name) + raz_rt_cstr_len(value) + 24);
        if (!rule.push_str(":root { --") || !rule.push_str(name) || !rule.push_str(": ") || !rule.push_str(value) || !rule.push_str("; }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_keyframes(Page&mut self, string name, string frames) -> bool {
        if (!html_name_valid(name)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(name) + raz_rt_cstr_len(frames) + 24);
        if (!rule.push_str("@keyframes ") || !rule.push_str(name) || !rule.push_str(" { ") || !rule.push_str(frames) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    /// Scope a static rule to an element carrying data-raz-scope="scope".
    /// Scope names use the same conservative HTML-name grammar as IDs/classes.
    public fn scoped_style(Page&mut self, string scope, string selector, string declarations) -> bool {
        if (!html_name_valid(scope)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(scope) + raz_rt_cstr_len(selector) + raz_rt_cstr_len(declarations) + 48);
        if (!rule.push_str("[data-raz-scope=\"") || !rule.push_str(scope) || !rule.push_str("\"]")) { return false; }
        if (raz_rt_cstr_len(selector) > 0) {
            if (!rule.push_str(" ") || !rule.push_str(selector)) { return false; }
        }
        if (!rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    /// Deliberate raw-CSS escape hatch. Unlike structured rules, raw blocks are
    /// preserved verbatim and are not deduplicated.
    public fn raw_css(Page&mut self, string css) -> bool {
        if (!self.css.push_str(css)) { return false; }
        return self.css.push_str("\n");
    }

    public fn icon(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"icon\" href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn script(Page&mut self, string src) -> bool {
        if (!self.body.push_str("<script src=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, src)) { return false; }
        return self.body.push_str("\"></script>\n");
    }

    /// Hint that an ES module chunk will be needed soon. Release asset
    /// fingerprinting rewrites the href just like other public/assets URLs.
    public fn module_preload(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"modulepreload\" href=\"")) { return false; }
        if (!append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    /// Load a standards-based ES module immediately without involving app.wasm.
    public fn module_script(Page&mut self, string src) -> bool {
        if (!self.body.push_str("<script type=\"module\" src=\"")) { return false; }
        if (!append_escaped_to(&mut self.body, src)) { return false; }
        return self.body.push_str("\"></script>\n");
    }

