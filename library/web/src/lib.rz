namespace web;

import alloc::string;
public import web::std::dom;
public import web::std::events;
public import web::std::storage;
public import web::std::location;
public import web::std::url;
public import web::std::fetch;
public import web::std::encoding;
public import web::std::history;
public import web::std::clipboard;
public import web::std::timers;
import web::build::fs;
import web::build::format;
import web::ui;

extern fn raz_rt_cstr_len(string value) -> i64;
extern fn raz_rt_cstr_ptr(string value) -> usize;
extern fn raz_rt_load_u8(usize address) -> i64;

// Browser host boundary. These symbols are inert during the native build-time
// page-generation run and become WebAssembly imports in the browser artifact.

/// Static HTML document builder for Raz web projects.
///
/// Interactive Raz application behavior executes as WebAssembly. Static pages
/// emit no JavaScript or WebAssembly; interactive pages emit only the minimal host shim needed to instantiate app.wasm,
/// bind browser events, and expose DOM primitives to the module.
public struct Page {
    String html_open;
    String head;
    String body;
    String css;
    String client;
    // Compiler-private list of ordinary Raz functions referenced by browser
    // event bindings. The native page generator appends these roots to
    // dist/.raz-wasm-required; no application behavior is encoded here.
    String browser_roots;
    // Compiler-private lazy WASM chunk manifest. Each line is chunk-name<TAB>handler.
    String browser_chunks;
    i64 open_depth;
}

fn append_escaped_to(String&mut output, string value) -> bool {
    i64 length = raz_rt_cstr_len(value);
    usize data = raz_rt_cstr_ptr(value);
    i64 i = 0;
    while (i < length) {
        i64 ch = raz_rt_load_u8(data + i);
        if (ch == 38) {
            if (!output.push_str("&amp;")) { return false; }
        } else if (ch == 60) {
            if (!output.push_str("&lt;")) { return false; }
        } else if (ch == 62) {
            if (!output.push_str("&gt;")) { return false; }
        } else if (ch == 34) {
            if (!output.push_str("&quot;")) { return false; }
        } else if (ch == 39) {
            if (!output.push_str("&#39;")) { return false; }
        } else {
            if (!output.push(ch)) { return false; }
        }
        i += 1;
    }
    return true;
}

fn html_name_byte_allowed(i64 ch) -> bool {
    if (ch >= 48 && ch <= 57) { return true; }
    if (ch >= 65 && ch <= 90) { return true; }
    if (ch >= 97 && ch <= 122) { return true; }
    return ch == 45 || ch == 95 || ch == 58;
}

fn html_name_valid(string value) -> bool {
    i64 length = raz_rt_cstr_len(value);
    if (length <= 0) { return false; }
    usize data = raz_rt_cstr_ptr(value);
    i64 i = 0;
    while (i < length) {
        if (!html_name_byte_allowed(raz_rt_load_u8(data + i))) { return false; }
        i += 1;
    }
    return true;
}

fn append_html_name_to(String&mut output, string value) -> bool {
    if (!html_name_valid(value)) { return false; }
    i64 length = raz_rt_cstr_len(value);
    usize data = raz_rt_cstr_ptr(value);
    i64 i = 0;
    while (i < length) {
        if (!output.push(raz_rt_load_u8(data + i))) { return false; }
        i += 1;
    }
    return true;
}

fn append_attribute_to(String&mut output, string name, string value) -> bool {
    if (!output.push_str(" ") || !append_html_name_to(output, name) || !output.push_str("=\"")) { return false; }
    if (!append_escaped_to(output, value)) { return false; }
    return output.push_str("\"");
}

fn append_boolean_attribute_to(String&mut output, string name) -> bool {
    return output.push_str(" ") && append_html_name_to(output, name);
}

fn append_js_string_to(String&mut output, string value) -> bool {
    i64 length = raz_rt_cstr_len(value);
    usize data = raz_rt_cstr_ptr(value);
    i64 i = 0;
    while (i < length) {
        i64 ch = raz_rt_load_u8(data + i);
        if (ch == 92) {
            if (!output.push_str("\\\\")) { return false; }
        } else if (ch == 39) {
            if (!output.push_str("\\'")) { return false; }
        } else if (ch == 10) {
            if (!output.push_str("\\n")) { return false; }
        } else if (ch == 13) {
            if (!output.push_str("\\r")) { return false; }
        } else if (ch == 9) {
            if (!output.push_str("\\t")) { return false; }
        } else {
            if (!output.push(ch)) { return false; }
        }
        i += 1;
    }
    return true;
}

fn body_tag_text(Page&mut page, string tag, string class_name, string value) -> bool {
    if (!page.body.push_str("<") || !append_html_name_to(&mut page.body, tag)) { return false; }
    if (raz_rt_cstr_len(class_name) > 0) {
        if (!page.body.push_str(" class=\"") || !append_escaped_to(&mut page.body, class_name) || !page.body.push_str("\"")) { return false; }
    }
    if (!page.body.push_str(">") || !append_escaped_to(&mut page.body, value)) { return false; }
    return page.body.push_str("</") && append_html_name_to(&mut page.body, tag) && page.body.push_str(">\n");
}

fn body_tag_id_text(Page&mut page, string tag, string id, string class_name, string value) -> bool {
    if (!page.body.push_str("<") || !append_html_name_to(&mut page.body, tag)) { return false; }
    if (raz_rt_cstr_len(id) > 0) {
        if (!page.body.push_str(" id=\"") || !append_escaped_to(&mut page.body, id) || !page.body.push_str("\"")) { return false; }
    }
    if (raz_rt_cstr_len(class_name) > 0) {
        if (!page.body.push_str(" class=\"") || !append_escaped_to(&mut page.body, class_name) || !page.body.push_str("\"")) { return false; }
    }
    if (!page.body.push_str(">") || !append_escaped_to(&mut page.body, value)) { return false; }
    return page.body.push_str("</") && append_html_name_to(&mut page.body, tag) && page.body.push_str(">\n");
}

fn client_element_lookup(String&mut output, string local_name, string id) -> bool {
    if (!output.push_str("const ") || !output.push_str(local_name) || !output.push_str(" = document.getElementById('") || !append_js_string_to(output, id)) { return false; }
    return output.push_str("');\n");
}

fn write_client_for_path(Page&mut page, String& html_path) -> bool {
    usize data = html_path.as_ptr();
    i64 length = html_path.len();
    i64 slash = -1;
    i64 i = 0;
    while (i < length) {
        i64 ch = raz_rt_load_u8(data + i);
        if (ch == 47 || ch == 92) { slash = i; }
        i += 1;
    }

    String script_path = String::with_capacity(length + 16);
    i = 0;
    while (i <= slash) {
        if (!script_path.push(raz_rt_load_u8(data + i))) { return false; }
        i += 1;
    }
    if (!script_path.push_str("app.js")) { return false; }
    if (page.client.len() == 0) {
        return web::build::fs::remove_file_if_present(&script_path);
    }

    // Client-only module loading is deliberately independent from the Raz WASM
    // host. A page that only lazy-loads an ES module must not pay for app.wasm.
    if (page.browser_roots.len() == 0 && page.browser_chunks.len() == 0) {
        String client_only = String::with_capacity(page.client.len() + 256);
        if (!client_only.push_str("// Generated Raz Web lazy-module loader.\n") ||
            !client_only.push_string(&page.client)) { return false; }
        return web::build::fs::write_string(&script_path, &client_only);
    }

    String script = String::with_capacity(page.client.len() + 6144);
    if (!script.push_str("// Generated Raz Web host shim. Application logic lives in app.wasm.\n")) { return false; }
    if (!script.push_str("let rzMemory = null;\nlet rzCurrentEvent = null;\nlet rz = null;\nconst rzDecoder = new TextDecoder();\nconst rzEncoder = new TextEncoder();\nconst rzUse = (exports) => { rz = exports; rzMemory = exports.memory; return exports; };\n")) { return false; }
    if (!script.push_str("const rzCstr = (ptr) => { const bytes = new Uint8Array(rzMemory.buffer); const start = Number(ptr); let end = start; while (end < bytes.length && bytes[end] !== 0) end++; return rzDecoder.decode(bytes.subarray(start, end)); };\n")) { return false; }
    if (!script.push_str("const rzWasi = new Proxy({}, { get: (_target, name) => name === 'proc_exit' ? ((code) => { throw new Error('Raz WASM exited with code ' + code); }) : (() => 0) });\n")) { return false; }
    if (!script.push_str("const rzImports = { wasi_snapshot_preview1: rzWasi, raz_web: {\n")) { return false; }
    if (!script.push_str("dom_set_text: (idPtr, valuePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = rzCstr(valuePtr); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_set_text_i64: (idPtr, value) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = value.toString(); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_toggle_class: (idPtr, classPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.classList.toggle(rzCstr(classPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_set_text_ptr: (idPtr, valuePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = rzCstr(valuePtr); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_set_text_i64_ptr: (idPtr, value) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = value.toString(); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_toggle_class_ptr: (idPtr, classPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.classList.toggle(rzCstr(classPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("event_value_length: () => { const value = rzCurrentEvent && rzCurrentEvent.target && 'value' in rzCurrentEvent.target ? String(rzCurrentEvent.target.value) : ''; return BigInt(rzEncoder.encode(value).length); },\n")) { return false; }
    if (!script.push_str("event_value_write: (outPtr, capacity) => { const value = rzCurrentEvent && rzCurrentEvent.target && 'value' in rzCurrentEvent.target ? String(rzCurrentEvent.target.value) : ''; const bytes = rzEncoder.encode(value); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("event_key_length: () => { const key = rzCurrentEvent && typeof rzCurrentEvent.key === 'string' ? rzCurrentEvent.key : ''; return BigInt(rzEncoder.encode(key).length); },\n")) { return false; }
    if (!script.push_str("event_key_write: (outPtr, capacity) => { const key = rzCurrentEvent && typeof rzCurrentEvent.key === 'string' ? rzCurrentEvent.key : ''; const bytes = rzEncoder.encode(key); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("event_checked: () => rzCurrentEvent && rzCurrentEvent.target && !!rzCurrentEvent.target.checked ? 1n : 0n,\n")) { return false; }
    if (!script.push_str("event_prevent_default: () => { if (!rzCurrentEvent) return 0n; rzCurrentEvent.preventDefault(); return 1n; },\n")) { return false; }
    if (!script.push_str("event_code_length: () => { const value = rzCurrentEvent && typeof rzCurrentEvent.code === 'string' ? rzCurrentEvent.code : ''; return BigInt(rzEncoder.encode(value).length); },\n")) { return false; }
    if (!script.push_str("event_code_write: (outPtr, capacity) => { const value = rzCurrentEvent && typeof rzCurrentEvent.code === 'string' ? rzCurrentEvent.code : ''; const bytes = rzEncoder.encode(value); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("event_repeat: () => rzCurrentEvent && rzCurrentEvent.repeat ? 1n : 0n, event_alt_key: () => rzCurrentEvent && rzCurrentEvent.altKey ? 1n : 0n, event_ctrl_key: () => rzCurrentEvent && rzCurrentEvent.ctrlKey ? 1n : 0n, event_shift_key: () => rzCurrentEvent && rzCurrentEvent.shiftKey ? 1n : 0n, event_meta_key: () => rzCurrentEvent && rzCurrentEvent.metaKey ? 1n : 0n,\n")) { return false; }
    if (!script.push_str("event_button: () => BigInt(rzCurrentEvent && Number.isInteger(rzCurrentEvent.button) ? rzCurrentEvent.button : -1), event_client_x: () => BigInt(Math.trunc(rzCurrentEvent && Number.isFinite(rzCurrentEvent.clientX) ? rzCurrentEvent.clientX : 0)), event_client_y: () => BigInt(Math.trunc(rzCurrentEvent && Number.isFinite(rzCurrentEvent.clientY) ? rzCurrentEvent.clientY : 0)),\n")) { return false; }
    if (!script.push_str("event_stop_propagation: () => { if (!rzCurrentEvent) return 0n; rzCurrentEvent.stopPropagation(); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_set_attribute: (idPtr, namePtr, valuePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.setAttribute(rzCstr(namePtr), rzCstr(valuePtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_remove_attribute: (idPtr, namePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.removeAttribute(rzCstr(namePtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_add_class: (idPtr, classPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.classList.add(rzCstr(classPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_remove_class: (idPtr, classPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.classList.remove(rzCstr(classPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_focus: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.focus(); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_set_value: (idPtr, valuePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || !('value' in el)) return 0n; el.value = rzCstr(valuePtr); return 1n; },\n")) { return false; }
    if (!script.push_str("dom_blur: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || typeof el.blur !== 'function') return 0n; el.blur(); return 1n; }, dom_click: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || typeof el.click !== 'function') return 0n; el.click(); return 1n; }, dom_exists: (idPtr) => document.getElementById(rzCstr(idPtr)) ? 1n : 0n,\n")) { return false; }
    if (!script.push_str("dom_value_length: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || !(\'value\' in el)) return -1n; return BigInt(rzEncoder.encode(String(el.value)).length); }, dom_value_write: (idPtr, outPtr, cap) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || !(\'value\' in el)) return -1n; const b = rzEncoder.encode(String(el.value)); const n = Math.min(b.length, Number(cap)); if (n) new Uint8Array(rzMemory.buffer, Number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n")) { return false; }
    if (!script.push_str("dom_text_length: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return -1n; return BigInt(rzEncoder.encode(el.textContent || \'\').length); }, dom_text_write: (idPtr, outPtr, cap) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return -1n; const b = rzEncoder.encode(el.textContent || \'\'); const n = Math.min(b.length, Number(cap)); if (n) new Uint8Array(rzMemory.buffer, Number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n")) { return false; }
    if (!script.push_str("dom_attribute_length: (idPtr, namePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return -1n; const v = el.getAttribute(rzCstr(namePtr)); return v === null ? -1n : BigInt(rzEncoder.encode(v).length); }, dom_attribute_write: (idPtr, namePtr, outPtr, cap) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return -1n; const v = el.getAttribute(rzCstr(namePtr)); if (v === null) return -1n; const b = rzEncoder.encode(v); const n = Math.min(b.length, Number(cap)); if (n) new Uint8Array(rzMemory.buffer, Number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n")) { return false; }
    if (!script.push_str("timer_set_timeout: (handlerPtr, delay) => { const name = rzCstr(handlerPtr); const owner = rz; const id = setTimeout(() => { const fn = owner && owner[name]; if (typeof fn === 'function') { rzUse(owner); fn(); } }, Math.max(0, Number(delay))); return BigInt(id); }, timer_clear_timeout: (id) => { clearTimeout(Number(id)); return 1n; }, timer_set_interval: (handlerPtr, delay) => { const name = rzCstr(handlerPtr); const owner = rz; const id = setInterval(() => { const fn = owner && owner[name]; if (typeof fn === 'function') { rzUse(owner); fn(); } }, Math.max(1, Number(delay))); return BigInt(id); }, timer_clear_interval: (id) => { clearInterval(Number(id)); return 1n; },\n")) { return false; }
    if (!script.push_str("storage_set: (keyPtr, valuePtr) => { try { localStorage.setItem(rzCstr(keyPtr), rzCstr(valuePtr)); return 1n; } catch (_) { return 0n; } },\n")) { return false; }
    if (!script.push_str("storage_remove: (keyPtr) => { try { localStorage.removeItem(rzCstr(keyPtr)); return 1n; } catch (_) { return 0n; } },\n")) { return false; }
