namespace web::page;

import alloc::string;
import web::html_support;

public impl Page {
    // ---- head metadata / assets -------------------------------------------------
    public fn description(Page&mut self, string value) -> bool {
        if (!self.head.push_str("<meta name=\"description\" content=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, value)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn author(Page&mut self, string value) -> bool {
        if (!self.head.push_str("<meta name=\"author\" content=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, value)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn theme_color(Page&mut self, string value) -> bool {
        if (!self.head.push_str("<meta name=\"theme-color\" content=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, value)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn canonical(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"canonical\" href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn meta(Page&mut self, string name, string content) -> bool {
        if (!self.head.push_str("<meta name=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, name) || !self.head.push_str("\" content=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, content)) { return false; }
        return self.head.push_str("\">\n");
    }

    /// Metadata whose key uses the HTML `property` attribute, such as Open Graph.
    public fn meta_property(Page&mut self, string property_name, string content) -> bool {
        if (!self.head.push_str("<meta property=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, property_name) || !self.head.push_str("\" content=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, content)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn keywords(Page&mut self, string value) -> bool { return self.meta("keywords", value); }
    public fn robots(Page&mut self, string value) -> bool { return self.meta("robots", value); }

    public fn base(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<base href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn manifest(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"manifest\" href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn alternate(Page&mut self, string href, string language) -> bool {
        if (!self.head.push_str("<link rel=\"alternate\" href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href) || !self.head.push_str("\" hreflang=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, language)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn preload(Page&mut self, string href, string resource_type) -> bool {
        if (!self.head.push_str("<link rel=\"preload\" href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href) || !self.head.push_str("\" as=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, resource_type)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn stylesheet(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"stylesheet\" href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    /// Add a static CSS rule. Raz extracts these rules to app.css beside the
    /// generated HTML. Identical rules are emitted once per page.
    public fn style(Page&mut self, string selector, string declarations) -> bool {
        return web::page_css::append_css_rule(&mut self.css, "", "", selector, declarations);
    }

    public fn css(Page&mut self, string selector, string declarations) -> bool {
        return self.style(selector, declarations);
    }

    public fn css_class(Page&mut self, string class_name, string declarations) -> bool {
        if (!web::html_support::html_name_valid(class_name)) { return false; }
        return web::page_css::append_css_rule(&mut self.css, ".", class_name, "", declarations);
    }

    public fn css_id(Page&mut self, string id_name, string declarations) -> bool {
        if (!web::html_support::html_name_valid(id_name)) { return false; }
        return web::page_css::append_css_rule(&mut self.css, "#", id_name, "", declarations);
    }
    public fn css_pseudo(Page&mut self, string selector, string pseudo, string declarations) -> bool {
        if (!web::html_support::html_name_valid(pseudo)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(selector) + raz_rt_cstr_len(pseudo) + raz_rt_cstr_len(declarations) + 16);
        if (!rule.push_str(selector) || !rule.push_str(":") || !rule.push_str(pseudo) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }
    public fn css_pseudo_element(Page&mut self, string selector, string pseudo, string declarations) -> bool {
        if (!web::html_support::html_name_valid(pseudo)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(selector) + raz_rt_cstr_len(pseudo) + raz_rt_cstr_len(declarations) + 17);
        if (!rule.push_str(selector) || !rule.push_str("::") || !rule.push_str(pseudo) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_media(Page&mut self, string query, string selector, string declarations) -> bool {
        String rule = String::with_capacity(raz_rt_cstr_len(query) + raz_rt_cstr_len(selector) + raz_rt_cstr_len(declarations) + 32);
        if (!rule.push_str("@media ") || !rule.push_str(query) || !rule.push_str(" { ") || !rule.push_str(selector) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" } }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_container(Page&mut self, string query, string selector, string declarations) -> bool {
        String rule = String::with_capacity(raz_rt_cstr_len(query) + raz_rt_cstr_len(selector) + raz_rt_cstr_len(declarations) + 36);
        if (!rule.push_str("@container ") || !rule.push_str(query) || !rule.push_str(" { ") || !rule.push_str(selector) || !rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" } }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_variable(Page&mut self, string name, string value) -> bool {
        if (!web::html_support::html_name_valid(name)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(name) + raz_rt_cstr_len(value) + 24);
        if (!rule.push_str(":root { --") || !rule.push_str(name) || !rule.push_str(": ") || !rule.push_str(value) || !rule.push_str("; }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    public fn css_keyframes(Page&mut self, string name, string frames) -> bool {
        if (!web::html_support::html_name_valid(name)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(name) + raz_rt_cstr_len(frames) + 24);
        if (!rule.push_str("@keyframes ") || !rule.push_str(name) || !rule.push_str(" { ") || !rule.push_str(frames) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    /// Scope a static rule to an element carrying data-raz-scope="scope".
    /// Scope names use the same conservative HTML-name grammar as IDs/classes.
    public fn scoped_style(Page&mut self, string scope, string selector, string declarations) -> bool {
        if (!web::html_support::html_name_valid(scope)) { return false; }
        String rule = String::with_capacity(raz_rt_cstr_len(scope) + raz_rt_cstr_len(selector) + raz_rt_cstr_len(declarations) + 48);
        if (!rule.push_str("[data-raz-scope=\"") || !rule.push_str(scope) || !rule.push_str("\"]")) { return false; }
        if (raz_rt_cstr_len(selector) > 0) {
            if (!rule.push_str(" ") || !rule.push_str(selector)) { return false; }
        }
        if (!rule.push_str(" { ") || !rule.push_str(declarations) || !rule.push_str(" }\n")) { return false; }
        if (string_contains(&self.css, &rule)) { return true; }
        return self.css.push_string(&rule);
    }

    /// Deliberate raw-CSS escape hatch. Unlike structured rules, raw blocks are
    /// preserved verbatim and are not deduplicated.
    public fn raw_css(Page&mut self, string css) -> bool {
        if (!self.css.push_str(css)) { return false; }
        return self.css.push_str("\n");
    }

    public fn icon(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"icon\" href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    public fn script(Page&mut self, string src) -> bool {
        if (!self.body.push_str("<script src=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, src)) { return false; }
        return self.body.push_str("\"></script>\n");
    }

    /// Hint that an ES module chunk will be needed soon. Release asset
    /// fingerprinting rewrites the href just like other public/assets URLs.
    public fn module_preload(Page&mut self, string href) -> bool {
        if (!self.head.push_str("<link rel=\"modulepreload\" href=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.head, href)) { return false; }
        return self.head.push_str("\">\n");
    }

    /// Load a standards-based ES module immediately without involving app.wasm.
    public fn module_script(Page&mut self, string src) -> bool {
        if (!self.body.push_str("<script type=\"module\" src=\"")) { return false; }
        if (!web::html_support::append_escaped_to(&mut self.body, src)) { return false; }
        return self.body.push_str("\"></script>\n");
    }

}
