    if (!script.push_str("/*raz-web-import:38*/dom_add_class: (idPtr, classPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.classList.add(rzCstr(classPtr)); return 1n; },\n")) { return false; }
