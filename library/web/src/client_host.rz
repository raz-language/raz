    if (!script.push_str("/*raz-web-import:40*/dom_focus: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.focus(); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:67*/dom_set_value: (idPtr, valuePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || !('value' in el)) return 0n; el.value = rzCstr(valuePtr); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:68*/dom_blur: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || typeof el.blur !== 'function') return 0n; el.blur(); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:69*/dom_click: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || typeof el.click !== 'function') return 0n; el.click(); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:70*/dom_exists: (idPtr) => document.getElementById(rzCstr(idPtr)) ? 1n : 0n,\n")) { return false; }
    if (!script.push_str("/*raz-web-import:87*/dom_value_length: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || !('value' in el)) return -1n; return BigInt(rzEncoder.encode(String(el.value)).length); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:88*/dom_value_write: (idPtr, outPtr, cap) => { const el = document.getElementById(rzCstr(idPtr)); if (!el || !('value' in el)) return -1n; const b = rzEncoder.encode(String(el.value)); const n = Math.min(b.length, Number(cap)); if (n) new Uint8Array(rzMemory.buffer, Number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:89*/dom_text_length: (idPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return -1n; return BigInt(rzEncoder.encode(el.textContent || '').length); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:90*/dom_text_write: (idPtr, outPtr, cap) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return -1n; const b = rzEncoder.encode(el.textContent || ''); const n = Math.min(b.length, Number(cap)); if (n) new Uint8Array(rzMemory.buffer, Number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:91*/dom_attribute_length: (idPtr, namePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return -1n; const v = el.getAttribute(rzCstr(namePtr)); return v === null ? -1n : BigInt(rzEncoder.encode(v).length); },\n")) { return false; }
