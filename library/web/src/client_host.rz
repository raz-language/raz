    // emits app.wasm only when at least one route actually bound an event.
    bool ok = true;
    if (browser_roots.len() > 0) {
        String marker_path = String::from("dist/.raz-wasm-required");
        ok = web::build::fs::append_string(&marker_path, &browser_roots);
    }
    if (ok && browser_chunks.len() > 0) {
        String chunks_path = String::from("dist/.raz-wasm-chunks");
        ok = web::build::fs::append_string(&chunks_path, &browser_chunks);
    }
    return ok;
}

