namespace web::client_host;

import alloc::string;
import web::build::fs;
import web::html_support;

extern fn raz_rt_load_u8(usize address) -> i64;

public fn client_element_lookup(String&mut output, string local_name, string id) -> bool {
    if (!output.push_str("const ") || !output.push_str(local_name) || !output.push_str(" = document.getElementById('") || !web::html_support::append_js_string_to(output, id)) { return false; }
    return output.push_str("');\n");
}

public fn write_client_for_path(String& client, String& browser_roots, String& browser_chunks, String& html_path) -> bool {
    usize data = html_path.as_ptr();
    i64 length = html_path.len();
    i64 slash = -1;
    i64 i = 0;
    while (i < length) {
        i64 ch = raz_rt_load_u8(data + i);
        if (ch == 47 || ch == 92) { slash = i; }
        i += 1;
    }

    String script_path = String::with_capacity(length + 16);
    i = 0;
    while (i <= slash) {
        if (!script_path.push(raz_rt_load_u8(data + i))) { return false; }
        i += 1;
    }
    if (!script_path.push_str("app.js")) { return false; }
    if (client.len() == 0) {
        return web::build::fs::remove_file_if_present(&script_path);
    }

    // Client-only module loading is deliberately independent from the Raz WASM
    // host. A page that only lazy-loads an ES module must not pay for app.wasm.
    if (browser_roots.len() == 0 && browser_chunks.len() == 0) {
        String client_only = String::with_capacity(client.len() + 256);
        if (!client_only.push_str("// Generated Raz Web lazy-module loader.\n") ||
            !client_only.push_string(&client)) { return false; }
        return web::build::fs::write_string(&script_path, &client_only);
    }

    String script = String::with_capacity(client.len() + 6144);
    if (!script.push_str("// Generated Raz Web host shim. Application logic lives in app.wasm.\n")) { return false; }
    if (!script.push_str("let rzMemory = null;\nlet rzCurrentEvent = null;\nlet rz = null;\nconst rzDecoder = new TextDecoder();\nconst rzEncoder = new TextEncoder();\nconst rzUse = (exports) => { rz = exports; rzMemory = exports.memory; return exports; };\n")) { return false; }
    if (!script.push_str("const rzCstr = (ptr) => { const bytes = new Uint8Array(rzMemory.buffer); const start = Number(ptr); let end = start; while (end < bytes.length && bytes[end] !== 0) end++; return rzDecoder.decode(bytes.subarray(start, end)); };\n")) { return false; }
    if (!script.push_str("const rzImports = { raz_web: {\n")) { return false; }
    if (!script.push_str("/*raz-web-import:24*/dom_set_text: (idPtr, valuePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = rzCstr(valuePtr); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:25*/dom_set_text_i64: (idPtr, value) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = value.toString(); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:26*/dom_toggle_class: (idPtr, classPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.classList.toggle(rzCstr(classPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:27*/dom_set_text_ptr: (idPtr, valuePtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = rzCstr(valuePtr); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:28*/dom_set_text_i64_ptr: (idPtr, value) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.textContent = value.toString(); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:29*/dom_toggle_class_ptr: (idPtr, classPtr) => { const el = document.getElementById(rzCstr(idPtr)); if (!el) return 0n; el.classList.toggle(rzCstr(classPtr)); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:30*/event_value_length: () => { const value = rzCurrentEvent && rzCurrentEvent.target && 'value' in rzCurrentEvent.target ? String(rzCurrentEvent.target.value) : ''; return BigInt(rzEncoder.encode(value).length); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:31*/event_value_write: (outPtr, capacity) => { const value = rzCurrentEvent && rzCurrentEvent.target && 'value' in rzCurrentEvent.target ? String(rzCurrentEvent.target.value) : ''; const bytes = rzEncoder.encode(value); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:32*/event_key_length: () => { const key = rzCurrentEvent && typeof rzCurrentEvent.key === 'string' ? rzCurrentEvent.key : ''; return BigInt(rzEncoder.encode(key).length); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:33*/event_key_write: (outPtr, capacity) => { const key = rzCurrentEvent && typeof rzCurrentEvent.key === 'string' ? rzCurrentEvent.key : ''; const bytes = rzEncoder.encode(key); const count = Math.min(bytes.length, Number(capacity)); if (count > 0) new Uint8Array(rzMemory.buffer, Number(outPtr), count).set(bytes.subarray(0, count)); return BigInt(count); },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:34*/event_checked: () => rzCurrentEvent && rzCurrentEvent.target && !!rzCurrentEvent.target.checked ? 1n : 0n,\n")) { return false; }
    if (!script.push_str("/*raz-web-import:35*/event_prevent_default: () => { if (!rzCurrentEvent) return 0n; rzCurrentEvent.preventDefault(); return 1n; },\n")) { return false; }
    if (!script.push_str("/*raz-web-import:56*/event_code_length: () => { const value = rzCurrentEvent && typeof rzCurrentEvent.code === 'string' ? rzCurrentEvent.code : ''; return BigInt(rzEncoder.encode(value).length); },\n")) { return false; }
