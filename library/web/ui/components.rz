namespace web::ui;

import alloc::string;

public fn stylesheet() -> StyleSheet { return StyleSheet { css: buffer_new() }; }

// A component owns one typed root element plus the CSS emitted with that root.
// Components can be nested without a JavaScript-side component object: child
// markup and styles are flattened into the Raz-rendered document buffers.
/// Wrapper-free component composition. A fragment may contain text/elements/
/// components but cannot carry HTML attributes because it emits no DOM node.
public fn fragment() -> Component { return component(Tag::Fragment); }

/// Semantic component constructors for the most common composition roots.
public fn div_component() -> Component { return component(Tag::Div); }
public fn main_component() -> Component { return component(Tag::Main); }
public fn section_component() -> Component { return component(Tag::Section); }
public fn article_component() -> Component { return component(Tag::Article); }
public fn nav_component() -> Component { return component(Tag::Nav); }
public fn form_component() -> Component { return component(Tag::Form); }

public fn component(Tag root_tag) -> Component {
    return Component { root: element(root_tag), styles: stylesheet(), scripts: buffer_new(), component_scope: 0, failed: false };
}

// Positive scopes define keyed rerender boundaries. The numeric scope is a
// backend-stable identity; the string key remains the DOM identity developers
// can inspect and use across list/component reconciliation.
fn component_scoped_with_scope(Tag root_tag, string key, i64 scope) -> Component {
    Element root = element(root_tag);
    root.component_scope = scope;
    bool failed = scope <= 0;
    if (!failed && !root.component_key(key)) { failed = true; }
    if (!failed && !append_attribute_i64(&mut root, "data-raz-component-scope", scope)) { failed = true; }
    return Component { root: move root, styles: stylesheet(), scripts: buffer_new(), component_scope: scope, failed: failed };
}

// Normal web components use the key alone. The scope hash is deterministic and
// matches @web_component("key") in the compiler.
public fn component_scoped(Tag root_tag, string key) -> Component {
    return component_scoped_with_scope(root_tag, key, web_component_scope_for_key(key));
}

impl StyleSheet {
    fn append_unique_rule(StyleSheet&mut self, Buffer&mut rule) -> bool {
        if (rule.length == 0) { return true; }
        if (buffer_contains_bytes(&self.css, rule.data, rule.length)) { return true; }
        return buffer_append_bytes(&mut self.css, rule.data, rule.length);
    }
    fn rule(StyleSheet&mut self, string selector, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, selector)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn scoped_rule(StyleSheet&mut self, string scope, string selector, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, "[data-raz-scope=\"")) { return false; }
        if (!append_escaped(&mut rule, scope)) { return false; }
        if (!buffer_append_literal(&mut rule, "\"]")) { return false; }
        if (raz_rt_cstr_len(selector) > 0) {
            if (!buffer_push_byte(&mut rule, 32)) { return false; }
            if (!buffer_append_literal(&mut rule, selector)) { return false; }
        }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn class_rule(StyleSheet&mut self, string class_name, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_push_byte(&mut rule, 46)) { return false; }
        if (!buffer_append_literal(&mut rule, class_name)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn id_rule(StyleSheet&mut self, string id_name, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_push_byte(&mut rule, 35)) { return false; }
        if (!buffer_append_literal(&mut rule, id_name)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn pseudo_rule(StyleSheet&mut self, string selector, string pseudo, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, selector)) { return false; }
        if (!buffer_push_byte(&mut rule, 58)) { return false; }
        if (!buffer_append_literal(&mut rule, pseudo)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn pseudo_element_rule(StyleSheet&mut self, string selector, string pseudo, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, selector)) { return false; }
        if (!buffer_append_literal(&mut rule, "::")) { return false; }
        if (!buffer_append_literal(&mut rule, pseudo)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn media_rule(StyleSheet&mut self, string query, string selector, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, "@media ")) { return false; }
        if (!buffer_append_literal(&mut rule, query)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, selector)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " } }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn container_rule(StyleSheet&mut self, string query, string selector, string declarations) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, "@container ")) { return false; }
        if (!buffer_append_literal(&mut rule, query)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, selector)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, declarations)) { return false; }
        if (!buffer_append_literal(&mut rule, " } }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn variable(StyleSheet&mut self, string name, string value) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, ":root { --")) { return false; }
        if (!buffer_append_literal(&mut rule, name)) { return false; }
        if (!buffer_append_literal(&mut rule, ": ")) { return false; }
        if (!buffer_append_literal(&mut rule, value)) { return false; }
        if (!buffer_append_literal(&mut rule, "; }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn keyframes(StyleSheet&mut self, string name, string frames) -> bool {
        Buffer rule = buffer_new();
        if (!buffer_append_literal(&mut rule, "@keyframes ")) { return false; }
        if (!buffer_append_literal(&mut rule, name)) { return false; }
        if (!buffer_append_literal(&mut rule, " { ")) { return false; }
        if (!buffer_append_literal(&mut rule, frames)) { return false; }
        if (!buffer_append_literal(&mut rule, " }\n")) { return false; }
        return self.append_unique_rule(&mut rule);
    }
    fn raw(StyleSheet&mut self, string css) -> bool {
        if (!buffer_append_literal(&mut self.css, css)) { return false; }
        return buffer_push_byte(&mut self.css, 10);
    }

}

fn mount_document(string title, Element& root, StyleSheet& styles, Buffer& scripts) -> bool {
    Buffer html = buffer_new();
    Buffer shape = buffer_new();
    Buffer title_buffer = buffer_new();
    if (!render_into(root, &mut html)) { return false; }
    if (!render_shape_into(root, &mut shape)) { return false; }
    if (!buffer_append_literal(&mut title_buffer, title)) { return false; }
    bool same_structure = web_structure_revision > 0 && bytes_equal(shape.data, shape.length, web_shape_data, web_shape_length);
    if (!replace_buffer(html.data, html.length, &mut web_html_data, &mut web_html_length)) { return false; }
    if (!replace_buffer(shape.data, shape.length, &mut web_shape_data, &mut web_shape_length)) { return false; }
    if (!replace_buffer(styles.css.data, styles.css.length, &mut web_css_data, &mut web_css_length)) { return false; }
    if (!replace_buffer(scripts.data, scripts.length, &mut web_js_data, &mut web_js_length)) { return false; }
    if (!replace_buffer(title_buffer.data, title_buffer.length, &mut web_title_data, &mut web_title_length)) { return false; }
    if (!same_structure) { web_structure_revision += 1; }
    web_revision += 1;
    return true;
}

public fn mount(string title, Element& root, StyleSheet& styles) -> bool {
    Buffer scripts = buffer_new();
    return mount_document(title, root, styles, &scripts);
}


fn route_mark_structural_scope(i64 scope) {
    if (scope < 0) { return; }
    i64 marker = scope + 1;
    if (web_route_structural_owner == 0) { web_route_structural_owner = marker; }
    else if (web_route_structural_owner != marker) { web_route_structural_owner = -1; }
}

fn route_matches(string path) -> bool {
    i64 length = raz_rt_cstr_len(path);
    if (length != web_route_length) { return false; }
    i64 index = 0;
    while (index < length) {
        i64 left = 0;
        i64 right = 0;
        unsafe {
            left = (*((web_route_data + index)as u8*const))as i64;
            right = (*((raz_rt_cstr_ptr(path) + index)as u8*const))as i64;
        }
        if (left != right) { return false; }
        index += 1;
    }
    return true;
}

fn http_mark_structural_scope(i64 slot, i64 scope) {
    if (slot < 0 || slot >= WEB_HTTP_CAPACITY || web_http_records == 0 || scope < 0) { return; }
    usize record = web_http_records + slot * WEB_HTTP_RECORD_BYTES;
    i64 marker = scope + 1;
    i64 current = raw_i64_get(record, 96);
    if (current == 0) { raw_i64_set(record, 96, marker); }
    else if (current != marker) { raw_i64_set(record, 96, -1); }
}

fn http_structural_scope(i64 slot) -> i64 {
    if (slot < 0 || slot >= WEB_HTTP_CAPACITY || web_http_records == 0) { return -1; }
    i64 marker = raw_i64_get(web_http_records + slot * WEB_HTTP_RECORD_BYTES, 96);
    if (marker == 0) { return 0; }
    if (marker < 0 || marker == 1) { return -1; }
    return marker - 1;
}

impl Component {
    fn valid(Component& self) -> bool { return !self.failed; }
    fn invalidate(Component&mut self) -> bool { self.failed = true; return false; }
    fn id(Component&mut self, string value) -> bool {
        if (self.failed || !self.root.id(value)) { self.failed = true; return false; }
        return true;
    }
    fn class_name(Component&mut self, string value) -> bool {
        if (self.failed || !self.root.class_name(value)) { self.failed = true; return false; }
        return true;
    }
    /// Safe escaped attribute on the component root. Fragments reject root
    /// attributes because they intentionally emit no wrapper element.
    fn attr(Component&mut self, string name, string value) -> bool {
        if (self.failed || self.root.tag == Tag::Fragment || !append_attribute(&mut self.root, name, value)) { self.failed = true; return false; }
        return true;
    }
    fn aria_label(Component&mut self, string value) -> bool { return self.attr("aria-label", value); }
    fn aria(Component&mut self, string name, string value) -> bool {
        if (self.failed || self.root.tag == Tag::Fragment || !self.root.aria(name, value)) { self.failed = true; return false; }
        return true;
    }
    fn aria_describedby(Component&mut self, string value) -> bool { return self.attr("aria-describedby", value); }
    fn aria_controls(Component&mut self, string value) -> bool { return self.attr("aria-controls", value); }
    fn aria_expanded(Component&mut self, bool value) -> bool {
        if (value) { return self.attr("aria-expanded", "true"); }
        return self.attr("aria-expanded", "false");
    }
    fn role(Component&mut self, string value) -> bool { return self.attr("role", value); }
    fn title(Component&mut self, string value) -> bool { return self.attr("title", value); }
    fn data(Component&mut self, string name, string value) -> bool {
        if (self.failed || self.root.tag == Tag::Fragment || !self.root.data(name, value)) { self.failed = true; return false; }
        return true;
    }
    fn scope(Component&mut self, string value) -> bool {
        if (self.failed || !self.root.scope(value)) { self.failed = true; return false; }
        return true;
    }
    fn key(Component&mut self, string value) -> bool {
        if (self.failed || !self.root.component_key(value)) { self.failed = true; return false; }
        return true;
    }
    /// Component-local state is namespaced by this component's stable scope.
    /// Reusable siblings may therefore use the same local state names safely.
    fn state_i64(Component& self, string key, i64 initial) -> StateI64 {
        return state_i64_scoped(self.component_scope, key, initial);
    }
    fn state_bool(Component& self, string key, bool initial) -> StateBool {
        return state_bool_scoped(self.component_scope, key, initial);
    }
    fn state_string(Component& self, string key, string initial) -> StateString {
        return state_string_scoped(self.component_scope, key, initial);
    }
    /// True once for this component scope during the lifetime of the Wasm
    /// instance. This is deliberately a render lifecycle primitive rather than
    /// a JavaScript mount hook: effect bodies remain ordinary Raz code.
    fn first_render(Component& self) -> bool {
        i64 scope = self.component_scope;
        return effect_changed(scope, WEB_EFFECT_RENDER, 0, 1);
    }
    fn render_generation(Component& self) -> i64 { return web_render_generation; }
    /// Effect observations also register a structural dependency. If the state
    /// changes, the smallest owning component is rerendered and the guarded Raz
    /// effect body executes exactly once for the new version.
    fn effect_i64(Component& self, StateI64& state) -> bool {
        if (self.component_scope <= 0) { state_mark_structural(state.slot); }
        else { state_mark_structural_scope(state.slot, self.component_scope); }
        return effect_changed(self.component_scope, WEB_EFFECT_STATE, state.slot, state_version(state.slot));
    }
    fn effect_bool(Component& self, StateBool& state) -> bool {
        if (self.component_scope <= 0) { state_mark_structural(state.slot); }
        else { state_mark_structural_scope(state.slot, self.component_scope); }
        return effect_changed(self.component_scope, WEB_EFFECT_STATE, state.slot, state_version(state.slot));
    }
    fn effect_string(Component& self, StateString& state) -> bool {
        if (self.component_scope <= 0) { state_mark_structural(state.slot); }
        else { state_mark_structural_scope(state.slot, self.component_scope); }
        return effect_changed(self.component_scope, WEB_EFFECT_STATE, state.slot, state_version(state.slot));
    }
    fn effect_request(Component& self, HttpRequest& request) -> bool {
        if (request.slot < 0 || request.slot >= WEB_HTTP_CAPACITY || web_http_records == 0) { return false; }
        if (self.component_scope <= 0) { http_mark_structural_scope(request.slot, 0); }
        else { http_mark_structural_scope(request.slot, self.component_scope); }
        i64 version = raw_i64_get(web_http_records + request.slot * WEB_HTTP_RECORD_BYTES, 56);
        return effect_changed(self.component_scope, WEB_EFFECT_HTTP, request.slot, version);
    }
    fn read_bool(Component& self, StateBool& state) -> bool {
        if (self.component_scope <= 0) { state_mark_structural(state.slot); }
        else { state_mark_structural_scope(state.slot, self.component_scope); }
        return state_value(state.slot) != 0;
    }
    /// Structural conditional helper. Reading through the component records the
    /// dependency against this keyed component scope so a state transition can
    /// rerender only this subtree when possible.
    fn when(Component& self, StateBool& state) -> bool { return self.read_bool(state); }
    fn unless(Component& self, StateBool& state) -> bool { return !self.read_bool(state); }
    fn read_i64(Component& self, StateI64& state) -> i64 {
        if (self.component_scope <= 0) { state_mark_structural(state.slot); }
        else { state_mark_structural_scope(state.slot, self.component_scope); }
        return state_value(state.slot);
    }
    fn read_derived_i64(Component& self, DerivedI64& value) -> i64 {
        if (self.component_scope <= 0) { derived_mark(value.id, WEB_STATE_DEP_STRUCTURAL); }
        else { derived_mark_structural_scope(value.id, self.component_scope); }
        return derived_value(value.id);
    }
    fn read_derived_bool(Component& self, DerivedBool& value) -> bool {
        if (self.component_scope <= 0) { derived_mark(value.id, WEB_STATE_DEP_STRUCTURAL); }
        else { derived_mark_structural_scope(value.id, self.component_scope); }
        return derived_value(value.id) != 0;
    }
    fn when_derived(Component& self, DerivedBool& value) -> bool { return self.read_derived_bool(value); }
    fn unless_derived(Component& self, DerivedBool& value) -> bool { return !self.read_derived_bool(value); }
    fn route_is(Component& self, string path) -> bool {
        if (self.component_scope <= 0) { route_mark_structural_scope(0); }
        else { route_mark_structural_scope(self.component_scope); }
        return route_matches(path);
    }
    fn route_prefix(Component& self, string path) -> bool {
        if (self.component_scope <= 0) { route_mark_structural_scope(0); }
        else { route_mark_structural_scope(self.component_scope); }
        i64 length = raz_rt_cstr_len(path);
        if (length > web_route_length) { return false; }
        i64 index = 0;
        while (index < length) {
            i64 left = 0;
            i64 right = 0;
            unsafe {
                left = (*((web_route_data + index)as u8*const))as i64;
                right = (*((raz_rt_cstr_ptr(path) + index)as u8*const))as i64;
            }
            if (left != right) { return false; }
            index += 1;
        }
        if (length == web_route_length || length == 1) { return true; }
        i64 boundary = 0;
        unsafe { boundary = (*((web_route_data + length)as u8*const))as i64; }
        return boundary == 47;
    }
    fn request_done(Component& self, HttpRequest& request) -> bool {
        if (self.component_scope <= 0) { http_mark_structural_scope(request.slot, 0); }
        else { http_mark_structural_scope(request.slot, self.component_scope); }
        if (request.slot < 0 || request.slot >= WEB_HTTP_CAPACITY || web_http_records == 0) { return false; }
        i64 request_state = raw_i64_get(web_http_records + request.slot * WEB_HTTP_RECORD_BYTES, 8);
        return request_state == WEB_HTTP_COMPLETE || request_state == WEB_HTTP_FAILED;
    }
    fn request_loading(Component& self, HttpRequest& request) -> bool {
        if (self.component_scope <= 0) { http_mark_structural_scope(request.slot, 0); }
        else { http_mark_structural_scope(request.slot, self.component_scope); }
        if (request.slot < 0 || request.slot >= WEB_HTTP_CAPACITY || web_http_records == 0) { return false; }
        i64 request_state = raw_i64_get(web_http_records + request.slot * WEB_HTTP_RECORD_BYTES, 8);
        return request_state == WEB_HTTP_PENDING || request_state == WEB_HTTP_INFLIGHT;
    }
    fn read_string_length(Component& self, StateString& state) -> i64 {
        if (self.component_scope <= 0) { state_mark_structural(state.slot); }
        else { state_mark_structural_scope(state.slot, self.component_scope); }
        return state_string_length(state.slot);
    }
    fn read_string_validation_failed(Component& self, StateString& state) -> bool {
        if (self.component_scope <= 0) { state_mark_structural(state.slot); }
        else { state_mark_structural_scope(state.slot, self.component_scope); }
        if (!state.valid() || web_state_records == 0) { return false; }
        return raw_i64_get(state_record(state.slot), 16) < 0;
    }
    fn text(Component&mut self, Tag tag, string value) -> bool {
        if (self.failed || !self.root.child_text(tag, value)) { self.failed = true; return false; }
        return true;
    }
    fn h1(Component&mut self, string value) -> bool { return self.text(Tag::H1, value); }
    fn h2(Component&mut self, string value) -> bool { return self.text(Tag::H2, value); }
    fn h3(Component&mut self, string value) -> bool { return self.text(Tag::H3, value); }
    fn h4(Component&mut self, string value) -> bool { return self.text(Tag::H4, value); }
    fn h5(Component&mut self, string value) -> bool { return self.text(Tag::H5, value); }
    fn h6(Component&mut self, string value) -> bool { return self.text(Tag::H6, value); }
    fn p(Component&mut self, string value) -> bool { return self.text(Tag::P, value); }
    fn span(Component&mut self, string value) -> bool { return self.text(Tag::Span, value); }
    fn small(Component&mut self, string value) -> bool { return self.text(Tag::Small, value); }
    fn strong(Component&mut self, string value) -> bool { return self.text(Tag::Strong, value); }
    fn em(Component&mut self, string value) -> bool { return self.text(Tag::Em, value); }
    fn code(Component&mut self, string value) -> bool { return self.text(Tag::Code, value); }
    fn pre(Component&mut self, string value) -> bool { return self.text(Tag::Pre, value); }
    fn blockquote(Component&mut self, string value) -> bool { return self.text(Tag::Blockquote, value); }
    fn article(Component&mut self, string value) -> bool { return self.text(Tag::Article, value); }
    fn aside(Component&mut self, string value) -> bool { return self.text(Tag::Aside, value); }
    fn raw_html(Component&mut self, string html) -> bool {
        if (self.failed) { return false; }
        if (!buffer_append_literal(&mut self.root.children, html)) { self.failed = true; return false; }
        if (!buffer_append_literal(&mut self.root.shape_children, html)) { self.failed = true; return false; }
        return true;
    }
    fn raw_css(Component&mut self, string css) -> bool {
        if (self.failed || !buffer_append_literal(&mut self.styles.css, css)) { self.failed = true; return false; }
        if (!buffer_push_byte(&mut self.styles.css, 10)) { self.failed = true; return false; }
        return true;
    }
    fn raw_js(Component&mut self, string javascript) -> bool {
        if (self.failed || !buffer_append_literal(&mut self.scripts, javascript)) { self.failed = true; return false; }
        if (!buffer_push_byte(&mut self.scripts, 10)) { self.failed = true; return false; }
        return true;
    }
    fn text_i64(Component&mut self, Tag tag, string prefix, i64 value) -> bool {
        if (self.failed || !self.root.child_text_i64(tag, prefix, value)) { self.failed = true; return false; }
        return true;
    }
    fn text_i64_state(Component&mut self, Tag tag, string prefix, StateI64& state) -> bool {
        if (self.failed || !self.root.child_text_i64_state(tag, prefix, state)) { self.failed = true; return false; }
        return true;
    }
    fn text_derived_i64(Component&mut self, Tag tag, string prefix, DerivedI64& value) -> bool {
        if (self.failed || !self.root.child_text_derived_i64(tag, prefix, value)) { self.failed = true; return false; }
        return true;
    }
    fn keyed_text(Component&mut self, Tag tag, string key, string value) -> bool {
        if (self.failed || !self.root.child_keyed_text(tag, key, value)) { self.failed = true; return false; }
        return true;
    }
    fn keyed_text_i64(Component&mut self, Tag tag, i64 key, string value) -> bool {
        if (self.failed || !self.root.child_keyed_text_i64(tag, key, value)) { self.failed = true; return false; }
        return true;
    }
    fn text_state(Component&mut self, Tag tag, string prefix, StateString& state) -> bool {
        if (self.failed || !self.root.child_text_state(tag, prefix, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_text(Component&mut self, string class_name, string placeholder, StateString& state) -> bool {
        if (self.failed || !self.root.child_input_text(class_name, placeholder, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_email(Component&mut self, string class_name, string placeholder, StateString& state) -> bool {
        if (self.failed || !self.root.child_input_email(class_name, placeholder, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_password(Component&mut self, string class_name, string placeholder, StateString& state) -> bool {
        if (self.failed || !self.root.child_input_password(class_name, placeholder, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_search(Component&mut self, string class_name, string placeholder, StateString& state) -> bool {
        if (self.failed || !self.root.child_input_search(class_name, placeholder, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_url(Component&mut self, string class_name, string placeholder, StateString& state) -> bool {
        if (self.failed || !self.root.child_input_url(class_name, placeholder, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_tel(Component&mut self, string class_name, string placeholder, StateString& state) -> bool {
        if (self.failed || !self.root.child_input_tel(class_name, placeholder, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_date(Component&mut self, string class_name, StateString& state) -> bool {
        if (self.failed || !self.root.child_input_date(class_name, state)) { self.failed = true; return false; }
        return true;
    }
    fn input_number(Component&mut self, string class_name, StateI64& state) -> bool {
        if (self.failed || !self.root.child_input_number(class_name, state)) { self.failed = true; return false; }
        return true;
    }
    fn checkbox(Component&mut self, string class_name, StateBool& state) -> bool {
        if (self.failed || !self.root.child_checkbox(class_name, state)) { self.failed = true; return false; }
        return true;
    }
    fn form_text_post(Component&mut self, string class_name, string placeholder, string submit_text, StateString& state, HttpRequest& request) -> bool {
        if (self.failed || !self.root.child_form_text_post(class_name, placeholder, submit_text, state, request)) { self.failed = true; return false; }
        return true;
    }
    fn form_text_post_min(Component&mut self, string class_name, string placeholder, string submit_text, StateString& state, HttpRequest& request, i64 minimum) -> bool {
        if (self.failed || !self.root.child_form_text_post_min(class_name, placeholder, submit_text, state, request, minimum)) { self.failed = true; return false; }
        return true;
    }
    fn validation_text(Component&mut self, Tag tag, string message, StateString& state) -> bool {
        if (!state.validation_failed()) { return true; }
        return self.text(tag, message);
    }
    fn nav_link(Component&mut self, string href, string text) -> bool {
        if (self.failed || !self.root.child_nav_link(href, text)) { self.failed = true; return false; }
        return true;
    }
    fn button_add(Component&mut self, string class_name, string aria_label, string text, StateI64& state, i64 delta) -> bool {
        if (self.failed || !self.root.child_button_add(class_name, aria_label, text, state, delta)) {
            self.failed = true;
            return false;
        }
        return true;
    }
    fn button_increment(Component&mut self, string class_name, string aria_label, string text, StateI64& state) -> bool {
        return self.button_add(class_name, aria_label, text, state, 1);
    }
    fn button_decrement(Component&mut self, string class_name, string aria_label, string text, StateI64& state) -> bool {
        return self.button_add(class_name, aria_label, text, state, -1);
    }
    fn button_set_i64(Component&mut self, string class_name, string aria_label, string text, StateI64& state, i64 value) -> bool {
        Element child = button();
        child.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { self.failed = true; return false; }
        if (raz_rt_cstr_len(aria_label) > 0 && !child.aria_label(aria_label)) { self.failed = true; return false; }
        if (!child.on_click_set_i64(state, value) || !child.text(text) || !self.root.child(&mut child)) { self.failed = true; return false; }
        return true;
    }
    fn button_set_bool(Component&mut self, string class_name, string aria_label, string text, StateBool& state, bool value) -> bool {
        Element child = button();
        child.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { self.failed = true; return false; }
        if (raz_rt_cstr_len(aria_label) > 0 && !child.aria_label(aria_label)) { self.failed = true; return false; }
        if (!child.on_click_set_bool(state, value) || !child.text(text) || !self.root.child(&mut child)) { self.failed = true; return false; }
        return true;
    }
    fn button_toggle(Component&mut self, string class_name, string aria_label, string text, StateBool& state) -> bool {
        if (self.failed || !self.root.child_button_toggle(class_name, aria_label, text, state)) {
            self.failed = true;
            return false;
        }
        return true;
    }
    fn style(Component&mut self, string selector, string declarations) -> bool {
        if (self.failed || !self.styles.rule(selector, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn scoped_style(Component&mut self, string scope, string selector, string declarations) -> bool {
        if (self.failed || !self.styles.scoped_rule(scope, selector, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn css(Component&mut self, string selector, string declarations) -> bool { return self.style(selector, declarations); }
    fn css_class(Component&mut self, string class_name, string declarations) -> bool {
        if (self.failed || !self.styles.class_rule(class_name, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn css_id(Component&mut self, string id_name, string declarations) -> bool {
        if (self.failed || !self.styles.id_rule(id_name, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn css_pseudo(Component&mut self, string selector, string pseudo, string declarations) -> bool {
        if (self.failed || !self.styles.pseudo_rule(selector, pseudo, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn css_pseudo_element(Component&mut self, string selector, string pseudo, string declarations) -> bool {
        if (self.failed || !self.styles.pseudo_element_rule(selector, pseudo, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn css_media(Component&mut self, string query, string selector, string declarations) -> bool {
        if (self.failed || !self.styles.media_rule(query, selector, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn css_container(Component&mut self, string query, string selector, string declarations) -> bool {
        if (self.failed || !self.styles.container_rule(query, selector, declarations)) { self.failed = true; return false; }
        return true;
    }
    fn css_variable(Component&mut self, string name, string value) -> bool {
        if (self.failed || !self.styles.variable(name, value)) { self.failed = true; return false; }
        return true;
    }
    fn css_keyframes(Component&mut self, string name, string frames) -> bool {
        if (self.failed || !self.styles.keyframes(name, frames)) { self.failed = true; return false; }
        return true;
    }
    fn css_raw(Component&mut self, string css) -> bool {
        if (self.failed || !self.styles.raw(css)) { self.failed = true; return false; }
        return true;
    }
    /// Append an ordinary semantic Element to this component. This keeps forms,
    /// media, tables, and one-off HTML nodes convenient without forcing every
    /// leaf node to become a standalone Component.
    fn element(Component&mut self, Element&mut child) -> bool {
        if (self.failed) { return false; }
        child.component_scope = self.component_scope;
        if (!self.root.child(child)) { self.failed = true; return false; }
        return true;
    }
    fn element_keyed(Component&mut self, string key, Element&mut child) -> bool {
        if (!child.key(key)) { self.failed = true; return false; }
        return self.element(child);
    }
    fn element_keyed_i64(Component&mut self, i64 key, Element&mut child) -> bool {
        if (!child.key_i64(key)) { self.failed = true; return false; }
        return self.element(child);
    }
    fn child(Component&mut self, Component&mut child) -> bool {
        if (self.failed || child.failed) { self.failed = true; return false; }
        if (!self.root.child(&mut child.root)) { self.failed = true; return false; }
        if (!buffer_append_unique_buffer(&mut self.styles.css, &child.styles.css)) { self.failed = true; return false; }
        if (!buffer_append_buffer(&mut self.scripts, &child.scripts)) { self.failed = true; return false; }
        return true;
    }
    /// Append a child with an explicit DOM reconciliation key. This is useful
    /// for dynamic lists whose order may change: the browser moves the existing
    /// keyed node instead of replacing unrelated siblings.
    fn child_keyed(Component&mut self, string key, Component&mut child) -> bool {
        if (child.failed || !child.root.key(key)) { self.failed = true; return false; }
        return self.child(child);
    }
    fn child_keyed_i64(Component&mut self, i64 key, Component&mut child) -> bool {
        if (child.failed || !child.root.key_i64(key)) { self.failed = true; return false; }
        return self.child(child);
    }

    /// Conditionally append a child while registering the condition as a
    /// structural dependency of this component scope. When the state changes,
    /// the runtime can therefore rerender this boundary instead of the page.
    fn child_when(Component&mut self, StateBool& state, Component&mut child) -> bool {
        if (!self.when(state)) { return true; }
        return self.child(child);
    }
    fn child_unless(Component&mut self, StateBool& state, Component&mut child) -> bool {
        if (!self.unless(state)) { return true; }
        return self.child(child);
    }
    fn child_when_keyed(Component&mut self, StateBool& state, string key, Component&mut child) -> bool {
        if (!self.when(state)) { return true; }
        return self.child_keyed(key, child);
    }
    fn child_unless_keyed(Component&mut self, StateBool& state, string key, Component&mut child) -> bool {
        if (!self.unless(state)) { return true; }
        return self.child_keyed(key, child);
    }
    fn child_when_derived(Component&mut self, DerivedBool& value, Component&mut child) -> bool {
        if (!self.when_derived(value)) { return true; }
        return self.child(child);
    }
    fn child_unless_derived(Component&mut self, DerivedBool& value, Component&mut child) -> bool {
        if (!self.unless_derived(value)) { return true; }
        return self.child(child);
    }
    fn child_when_derived_keyed(Component&mut self, DerivedBool& value, string key, Component&mut child) -> bool {
        if (!self.when_derived(value)) { return true; }
        return self.child_keyed(key, child);
    }

    /// Append this component as build-time-only HTML/CSS. This is the static
    /// component path used by Page: it deliberately rejects browser bindings,
    /// component rerender scopes, routes, state bindings, and raw client code so
    /// using reusable Component trees does not silently opt a static site into
    /// JavaScript or WebAssembly.
    fn append_static(Component&mut self, String&mut html, String&mut css) -> bool {
        if (self.failed || self.scripts.length != 0 || self.component_scope != 0) { return false; }
        Buffer rendered = buffer_new();
        if (!render_into(&self.root, &mut rendered)) { self.failed = true; return false; }
        bool browser_bound =
            buffer_contains_literal(&rendered, "data-raz-bind-") ||
            buffer_contains_literal(&rendered, "data-raz-click") ||
            buffer_contains_literal(&rendered, "data-raz-input") ||
            buffer_contains_literal(&rendered, "data-raz-check") ||
            buffer_contains_literal(&rendered, "data-raz-number") ||
            buffer_contains_literal(&rendered, "data-raz-submit") ||
            buffer_contains_literal(&rendered, "data-raz-nav") ||
            buffer_contains_literal(&rendered, "data-raz-component");
        if (browser_bound) { return false; }
        if (!buffer_append_to_string(&rendered, html)) { self.failed = true; return false; }
        if (!buffer_append_to_string(&self.styles.css, css)) { self.failed = true; return false; }
        return true;
    }
    fn publish(Component&mut self) -> bool {
        if (self.failed || self.component_scope <= 0) { return false; }
        Buffer html = buffer_new();
        if (!render_into(&self.root, &mut html)) { self.failed = true; return false; }
        if (!replace_buffer(html.data, html.length, &mut web_component_html_data, &mut web_component_html_length)) { self.failed = true; return false; }
        if (!replace_buffer(self.styles.css.data, self.styles.css.length, &mut web_component_css_data, &mut web_component_css_length)) { self.failed = true; return false; }
        web_component_scope = self.component_scope;
        web_component_revision += 1;
        return true;
    }
    fn mount(Component&mut self, string title) -> bool {
        if (self.failed) { return false; }
        if (!mount_document(title, &self.root, &self.styles, &self.scripts)) { self.failed = true; return false; }
        return true;
    }
}

// Reserved compiler/runtime bridge for @web_component functions that return
// Component directly. The Wasm backend feeds the moved return value into this
// helper so normal Raz ownership performs publication and destruction.
public fn raz_web_publish_component_value(Component component) -> i64 {
    if (!component.valid()) { return -1; }
    if (!component.publish()) { return -1; }
    return 1;
}

// Web application entry bridge. `kind = "web"` projects may return Component
// directly from ordinary Raz `main`; the browser host calls this function with
// that Wasm aggregate handle to publish the page without an application-written
// wrapper. The manifest-provided document title remains authoritative when the
// component does not explicitly mount a different title.
public fn raz_web_publish_main(Component component) -> i64 {
    if (!component.valid()) { return -1; }
    if (!component.mount("")) { return -1; }
    return 1;
}

public fn raz_web_begin_render() { begin_render(); }
