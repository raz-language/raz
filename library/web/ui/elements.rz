namespace web::ui;

import alloc::string;

public fn element(Tag tag) -> Element {
    return Element {
        tag: tag,
        component_scope: 0,
        attributes: buffer_new(),
        children: buffer_new(),
        shape_attributes: buffer_new(),
        shape_children: buffer_new(),
    };
}

public fn div() -> Element { return element(Tag::Div); }
public fn main_element() -> Element { return element(Tag::Main); }
public fn section() -> Element { return element(Tag::Section); }
public fn header() -> Element { return element(Tag::Header); }
public fn footer() -> Element { return element(Tag::Footer); }
public fn nav() -> Element { return element(Tag::Nav); }
public fn h1() -> Element { return element(Tag::H1); }
public fn h2() -> Element { return element(Tag::H2); }
public fn h3() -> Element { return element(Tag::H3); }
public fn h4() -> Element { return element(Tag::H4); }
public fn h5() -> Element { return element(Tag::H5); }
public fn h6() -> Element { return element(Tag::H6); }
public fn paragraph() -> Element { return element(Tag::P); }
public fn span() -> Element { return element(Tag::Span); }
public fn button() -> Element { return element(Tag::Button); }
public fn link() -> Element { return element(Tag::A); }
public fn unordered_list() -> Element { return element(Tag::Ul); }
public fn list_item() -> Element { return element(Tag::Li); }
public fn form() -> Element { return element(Tag::Form); }
public fn label() -> Element { return element(Tag::Label); }
public fn input() -> Element { return element(Tag::Input); }
public fn image() -> Element { return element(Tag::Img); }
public fn article() -> Element { return element(Tag::Article); }
public fn aside() -> Element { return element(Tag::Aside); }
public fn figure() -> Element { return element(Tag::Figure); }
public fn figcaption() -> Element { return element(Tag::Figcaption); }
public fn small() -> Element { return element(Tag::Small); }
public fn strong() -> Element { return element(Tag::Strong); }
public fn em() -> Element { return element(Tag::Em); }
public fn code() -> Element { return element(Tag::Code); }
public fn pre() -> Element { return element(Tag::Pre); }
public fn blockquote() -> Element { return element(Tag::Blockquote); }
public fn br() -> Element { return element(Tag::Br); }
public fn hr() -> Element { return element(Tag::Hr); }
public fn ol() -> Element { return element(Tag::Ol); }
public fn dl() -> Element { return element(Tag::Dl); }
public fn dt() -> Element { return element(Tag::Dt); }
public fn dd() -> Element { return element(Tag::Dd); }
public fn textarea() -> Element { return element(Tag::Textarea); }
public fn select() -> Element { return element(Tag::Select); }
public fn option() -> Element { return element(Tag::Option); }
public fn details() -> Element { return element(Tag::Details); }
public fn summary() -> Element { return element(Tag::Summary); }
public fn table() -> Element { return element(Tag::Table); }
public fn thead() -> Element { return element(Tag::Thead); }
public fn tbody() -> Element { return element(Tag::Tbody); }
public fn tr() -> Element { return element(Tag::Tr); }
public fn th() -> Element { return element(Tag::Th); }
public fn td() -> Element { return element(Tag::Td); }
public fn video() -> Element { return element(Tag::Video); }
public fn audio() -> Element { return element(Tag::Audio); }
public fn source() -> Element { return element(Tag::Source); }
// Short aliases keep ordinary HTML pleasant to write while the explicit names
// above remain available for codebases that prefer semantic constructors.
public fn main_view() -> Element { return element(Tag::Main); }
public fn p() -> Element { return element(Tag::P); }
public fn a() -> Element { return element(Tag::A); }
public fn ul() -> Element { return element(Tag::Ul); }
public fn li() -> Element { return element(Tag::Li); }
public fn img() -> Element { return element(Tag::Img); }

// Typed form constructors set the HTML input type at creation time, avoiding
// repeated manual `input_type(...)` calls while still returning an ordinary
// Element that can be further configured with name/id/ARIA attributes.
fn typed_input(InputType kind) -> Element {
    Element value = input();
    value.input_type(kind);
    return move value;
}
public fn text_input() -> Element { return typed_input(InputType::Text); }
public fn email_input() -> Element { return typed_input(InputType::Email); }
public fn password_input() -> Element { return typed_input(InputType::Password); }
public fn number_input() -> Element { return typed_input(InputType::Number); }
public fn search_input() -> Element { return typed_input(InputType::Search); }
public fn url_input() -> Element { return typed_input(InputType::Url); }
public fn tel_input() -> Element { return typed_input(InputType::Tel); }
public fn date_input() -> Element { return typed_input(InputType::Date); }
public fn checkbox_input() -> Element { return typed_input(InputType::Checkbox); }
public fn radio_input() -> Element { return typed_input(InputType::Radio); }
public fn file_input() -> Element { return typed_input(InputType::File); }
public fn hidden_input() -> Element { return typed_input(InputType::Hidden); }
public fn submit_input() -> Element { return typed_input(InputType::Submit); }

/// Creates an accessible label connected to a control id.
public fn label_for(string control_id, string text) -> Element {
    Element value = label();
    value.for_id(control_id);
    value.text(text);
    return move value;
}

/// Creates an option with escaped value/text. Selection remains explicit.
public fn option_value(string option_value, string text) -> Element {
    Element value = option();
    value.value(option_value);
    value.text(text);
    return move value;
}

/// Creates a layout boundary as an ordinary div carrying a stable data marker.
/// Layouts remain part of Raz's normal component tree and add no special host
/// runtime or JavaScript behavior.
public fn layout(string name) -> Element {
    Element value = div();
    value.attr("data-raz-layout", name);
    return move value;
}

impl Element {
    fn id(Element&mut self, string value) -> bool { return append_attribute(self, "id", value); }
    fn class_name(Element&mut self, string value) -> bool { return append_attribute(self, "class", value); }
    fn attr(Element&mut self, string name, string value) -> bool { return append_attribute(self, name, value); }
    fn bool_attr(Element&mut self, string name) -> bool { return append_boolean_attribute(self, name); }
    fn aria(Element&mut self, string name, string value) -> bool {
        if (!html_name_valid(name)) { return false; }
        Buffer key = buffer_new();
        if (!buffer_append_literal(&mut key, "aria-") || !buffer_append_literal(&mut key, name)) { return false; }
        if (!buffer_push_byte(&mut self.attributes, 32) || !buffer_append_buffer(&mut self.attributes, &key) || !buffer_append_literal(&mut self.attributes, "=\"") || !append_escaped(&mut self.attributes, value) || !buffer_push_byte(&mut self.attributes, 34)) { return false; }
        if (!buffer_push_byte(&mut self.shape_attributes, 32) || !buffer_append_buffer(&mut self.shape_attributes, &key) || !buffer_append_literal(&mut self.shape_attributes, "=\"") || !append_escaped(&mut self.shape_attributes, value) || !buffer_push_byte(&mut self.shape_attributes, 34)) { return false; }
        return true;
    }
    fn scope(Element&mut self, string value) -> bool { return append_attribute(self, "data-raz-scope", value); }
    fn key(Element&mut self, string value) -> bool { return append_attribute(self, "data-raz-key", value); }
    fn key_i64(Element&mut self, i64 value) -> bool { return append_attribute_i64(self, "data-raz-key", value); }
    fn component_key(Element&mut self, string value) -> bool {
        if (!append_attribute(self, "data-raz-component", value)) { return false; }
        return append_attribute(self, "data-raz-key", value);
    }
    fn aria_label(Element&mut self, string value) -> bool { return append_attribute(self, "aria-label", value); }
    fn href(Element&mut self, string value) -> bool {
        if (self.tag != Tag::A) { return false; }
        return append_attribute(self, "href", value);
    }
    fn navigate(Element&mut self, string value) -> bool {
        if (self.tag != Tag::A) { return false; }
        return append_attribute(self, "data-raz-nav", value);
    }
    fn src(Element&mut self, string value) -> bool {
        if (self.tag != Tag::Img && self.tag != Tag::Video && self.tag != Tag::Audio && self.tag != Tag::Source) { return false; }
        return append_attribute(self, "src", value);
    }
    fn alt(Element&mut self, string value) -> bool {
        if (self.tag != Tag::Img) { return false; }
        return append_attribute(self, "alt", value);
    }
    fn title(Element&mut self, string value) -> bool { return append_attribute(self, "title", value); }
    fn role(Element&mut self, string value) -> bool { return append_attribute(self, "role", value); }
    fn name(Element&mut self, string value) -> bool { return append_attribute(self, "name", value); }
    fn value(Element&mut self, string value) -> bool { return append_attribute(self, "value", value); }
    fn autocomplete(Element&mut self, string value) -> bool { return append_attribute(self, "autocomplete", value); }
    fn for_id(Element&mut self, string value) -> bool {
        if (self.tag != Tag::Label) { return false; }
        return append_attribute(self, "for", value);
    }
    fn aria_describedby(Element&mut self, string value) -> bool { return append_attribute(self, "aria-describedby", value); }
    fn aria_controls(Element&mut self, string value) -> bool { return append_attribute(self, "aria-controls", value); }
    fn aria_expanded(Element&mut self, bool value) -> bool {
        if (value) { return append_attribute(self, "aria-expanded", "true"); }
        return append_attribute(self, "aria-expanded", "false");
    }
    fn aria_hidden(Element&mut self, bool value) -> bool {
        if (value) { return append_attribute(self, "aria-hidden", "true"); }
        return append_attribute(self, "aria-hidden", "false");
    }
    fn tab_index(Element&mut self, i64 value) -> bool { return append_attribute_i64(self, "tabindex", value); }
    fn rows(Element&mut self, i64 value) -> bool {
        if (self.tag != Tag::Textarea || value <= 0) { return false; }
        return append_attribute_i64(self, "rows", value);
    }
    fn cols(Element&mut self, i64 value) -> bool {
        if (self.tag != Tag::Textarea || value <= 0) { return false; }
        return append_attribute_i64(self, "cols", value);
    }
    fn action(Element&mut self, string value) -> bool { if (self.tag != Tag::Form) { return false; } return append_attribute(self, "action", value); }
    fn method(Element&mut self, string value) -> bool { if (self.tag != Tag::Form) { return false; } return append_attribute(self, "method", value); }
    fn enctype(Element&mut self, string value) -> bool { if (self.tag != Tag::Form) { return false; } return append_attribute(self, "enctype", value); }
    fn accept(Element&mut self, string value) -> bool { if (self.tag != Tag::Input) { return false; } return append_attribute(self, "accept", value); }
    fn pattern(Element&mut self, string value) -> bool { if (self.tag != Tag::Input) { return false; } return append_attribute(self, "pattern", value); }
    fn min(Element&mut self, string value) -> bool { if (self.tag != Tag::Input) { return false; } return append_attribute(self, "min", value); }
    fn max(Element&mut self, string value) -> bool { if (self.tag != Tag::Input) { return false; } return append_attribute(self, "max", value); }
    fn step(Element&mut self, string value) -> bool { if (self.tag != Tag::Input) { return false; } return append_attribute(self, "step", value); }
    fn input_mode(Element&mut self, string value) -> bool { if (self.tag != Tag::Input && self.tag != Tag::Textarea) { return false; } return append_attribute(self, "inputmode", value); }
    fn form_action(Element&mut self, string value) -> bool { if (self.tag != Tag::Input) { return false; } return append_attribute(self, "formaction", value); }
    fn form_method(Element&mut self, string value) -> bool { if (self.tag != Tag::Input) { return false; } return append_attribute(self, "formmethod", value); }
    fn no_validate(Element&mut self) -> bool { if (self.tag != Tag::Form) { return false; } return append_boolean_attribute(self, "novalidate"); }
    fn read_only(Element&mut self) -> bool { if (self.tag != Tag::Input && self.tag != Tag::Textarea) { return false; } return append_boolean_attribute(self, "readonly"); }
    fn multiple(Element&mut self) -> bool { if (self.tag != Tag::Input && self.tag != Tag::Select) { return false; } return append_boolean_attribute(self, "multiple"); }
    fn selected(Element&mut self) -> bool { if (self.tag != Tag::Option) { return false; } return append_boolean_attribute(self, "selected"); }
    fn checked(Element&mut self) -> bool { if (self.tag != Tag::Input) { return false; } return append_boolean_attribute(self, "checked"); }
    fn disabled(Element&mut self) -> bool { return append_boolean_attribute(self, "disabled"); }
    fn hidden(Element&mut self) -> bool { return append_boolean_attribute(self, "hidden"); }
    fn open(Element&mut self) -> bool { if (self.tag != Tag::Details) { return false; } return append_boolean_attribute(self, "open"); }
    fn data(Element&mut self, string key, string value) -> bool {
        if (!html_name_valid(key)) { return false; }
        Buffer name_buffer = buffer_new();
        if (!buffer_append_literal(&mut name_buffer, "data-")) { return false; }
        if (!buffer_append_literal(&mut name_buffer, key)) { return false; }
        // Dynamic attribute names are emitted directly into both render streams.
        if (!buffer_push_byte(&mut self.attributes, 32) || !buffer_append_buffer(&mut self.attributes, &name_buffer) || !buffer_append_literal(&mut self.attributes, "=\"")) { return false; }
        if (!append_escaped(&mut self.attributes, value) || !buffer_push_byte(&mut self.attributes, 34)) { return false; }
        if (!buffer_push_byte(&mut self.shape_attributes, 32) || !buffer_append_buffer(&mut self.shape_attributes, &name_buffer) || !buffer_append_literal(&mut self.shape_attributes, "=\"")) { return false; }
        if (!append_escaped(&mut self.shape_attributes, value) || !buffer_push_byte(&mut self.shape_attributes, 34)) { return false; }
        return true;
    }
    fn input_type(Element&mut self, InputType value) -> bool {
        if (self.tag != Tag::Input) { return false; }
        return append_attribute(self, "type", input_type_name(value));
    }
    fn required(Element&mut self) -> bool {
        if (self.tag != Tag::Input && self.tag != Tag::Textarea && self.tag != Tag::Select) { return false; }
        return append_boolean_attribute(self, "required");
    }
    fn min_length(Element&mut self, i64 value) -> bool {
        if (self.tag != Tag::Input || value < 0) { return false; }
        return append_attribute_i64(self, "minlength", value);
    }
    fn max_length(Element&mut self, i64 value) -> bool {
        if (self.tag != Tag::Input || value < 0) { return false; }
        return append_attribute_i64(self, "maxlength", value);
    }
    fn on_click(Element&mut self, i64 event_id) -> bool { return append_event_attribute(self, "data-raz-click", event_id); }
    fn on_click_add(Element&mut self, StateI64& state, i64 delta) -> bool {
        i64 event_id = register_state_action_scoped(WEB_ACTION_ADD_I64, state.slot, delta, self.component_scope);
        return event_id > 0 && append_event_attribute(self, "data-raz-click", event_id);
    }
    fn on_click_set_i64(Element&mut self, StateI64& state, i64 value) -> bool {
        i64 event_id = register_state_action_scoped(WEB_ACTION_SET_I64, state.slot, value, self.component_scope);
        return event_id > 0 && append_event_attribute(self, "data-raz-click", event_id);
    }
    fn on_click_toggle(Element&mut self, StateBool& state) -> bool {
        i64 event_id = register_state_action_scoped(WEB_ACTION_TOGGLE_BOOL, state.slot, 0, self.component_scope);
        return event_id > 0 && append_event_attribute(self, "data-raz-click", event_id);
    }
    fn on_click_set_bool(Element&mut self, StateBool& state, bool value) -> bool {
        i64 argument = 0;
        if (value) { argument = 1; }
        i64 event_id = register_state_action_scoped(WEB_ACTION_SET_BOOL, state.slot, argument, self.component_scope);
        return event_id > 0 && append_event_attribute(self, "data-raz-click", event_id);
    }
    fn on_input(Element&mut self, i64 event_id) -> bool { return append_event_attribute(self, "data-raz-input", event_id); }
    fn bind_submit_text(Element&mut self, StateString& state, HttpRequest& request) -> bool {
        if (self.tag != Tag::Form || !state.valid() || request.slot < 0 || request.slot >= WEB_HTTP_CAPACITY) { return false; }
        if (web_http_records == 0 || raw_i64_get(web_http_records + request.slot * WEB_HTTP_RECORD_BYTES, 64) != WEB_HTTP_POST) { return false; }
        i64 event_id = register_state_action_scoped(WEB_ACTION_SUBMIT_STRING, state.slot, request.slot, self.component_scope);
        return event_id > 0 && append_event_attribute(self, "data-raz-submit", event_id);
    }
    fn bind_submit_text_min(Element&mut self, StateString& state, HttpRequest& request, i64 minimum) -> bool {
        if (self.tag != Tag::Form || !state.valid() || minimum < 0 || request.slot < 0 || request.slot >= WEB_HTTP_CAPACITY) { return false; }
        if (web_http_records == 0 || raw_i64_get(web_http_records + request.slot * WEB_HTTP_RECORD_BYTES, 64) != WEB_HTTP_POST) { return false; }
        if (minimum > 288230376151711743) { return false; }
        i64 encoded = minimum * WEB_HTTP_CAPACITY + request.slot;
        i64 event_id = register_state_action_scoped(WEB_ACTION_SUBMIT_STRING_MIN, state.slot, encoded, self.component_scope);
        return event_id > 0 && append_event_attribute(self, "data-raz-submit", event_id);
    }
    fn bind_input(Element&mut self, StateString& state) -> bool {
        if (self.tag != Tag::Input || !state.valid()) { return false; }
        state_mark_bound(state.slot);
        i64 event_id = register_state_action_scoped(WEB_ACTION_SET_STRING, state.slot, 0, self.component_scope);
        if (event_id <= 0 || !append_event_attribute(self, "data-raz-input", event_id)) { return false; }
        if (!append_attribute_i64(self, "data-raz-state-string", state.slot)) { return false; }
        return append_dynamic_attribute_bytes(self, "value", state_string_data(state.slot), state_string_length(state.slot));
    }
    fn bind_checkbox(Element&mut self, StateBool& state) -> bool {
        if (self.tag != Tag::Input || !state.valid()) { return false; }
        state_mark_bound(state.slot);
        if (!self.input_type(InputType::Checkbox)) { return false; }
        i64 event_id = register_state_action_scoped(WEB_ACTION_SET_BOOL_INPUT, state.slot, 0, self.component_scope);
        if (event_id <= 0 || !append_event_attribute(self, "data-raz-check", event_id)) { return false; }
        if (!append_attribute_i64(self, "data-raz-state-bool", state.slot)) { return false; }
        return append_dynamic_boolean_attribute(self, "checked", state_value(state.slot) != 0);
    }
    fn bind_number(Element&mut self, StateI64& state) -> bool {
        if (self.tag != Tag::Input || !state.valid()) { return false; }
        state_mark_bound(state.slot);
        if (!self.input_type(InputType::Number)) { return false; }
        i64 event_id = register_state_action_scoped(WEB_ACTION_SET_I64_INPUT, state.slot, 0, self.component_scope);
        if (event_id <= 0 || !append_event_attribute(self, "data-raz-number", event_id)) { return false; }
        if (!append_attribute_i64(self, "data-raz-state-i64", state.slot)) { return false; }
        return append_dynamic_attribute_i64(self, "value", state_value(state.slot));
    }
    fn on_change_text(Element&mut self, StateString& state) -> bool { return self.bind_input(state); }
    fn on_change_number(Element&mut self, StateI64& state) -> bool { return self.bind_number(state); }
    fn on_change_bool(Element&mut self, StateBool& state) -> bool { return self.bind_checkbox(state); }
    fn on_submit(Element&mut self, StateString& state, HttpRequest& request) -> bool { return self.bind_submit_text(state, request); }
    fn placeholder(Element&mut self, string value) -> bool {
        if (self.tag != Tag::Input && self.tag != Tag::Textarea) { return false; }
        return append_attribute(self, "placeholder", value);
    }
    fn text(Element&mut self, string value) -> bool {
        if (tag_is_void(self.tag)) { return false; }
        if (!append_escaped(&mut self.children, value)) { return false; }
        return append_escaped(&mut self.shape_children, value);
    }
    fn text_i64(Element&mut self, i64 value) -> bool {
        if (tag_is_void(self.tag)) { return false; }
        if (!append_i64(&mut self.children, value)) { return false; }
        return append_i64(&mut self.shape_children, value);
    }
    fn text_state(Element&mut self, StateString& state) -> bool {
        if (tag_is_void(self.tag) || !state.valid()) { return false; }
        state_mark_structural(state.slot);
        if (!append_escaped_bytes(&mut self.children, state_string_data(state.slot), state_string_length(state.slot))) { return false; }
        // Direct Element usage is conservatively structural. Component binding
        // helpers below use the masked variant because they emit patch metadata.
        return append_escaped_bytes(&mut self.shape_children, state_string_data(state.slot), state_string_length(state.slot));
    }
    fn text_state_bound(Element&mut self, StateString& state) -> bool {
        if (tag_is_void(self.tag) || !state.valid()) { return false; }
        state_mark_bound(state.slot);
        if (!append_escaped_bytes(&mut self.children, state_string_data(state.slot), state_string_length(state.slot))) { return false; }
        return buffer_append_literal(&mut self.shape_children, "__raz_state_string__");
    }
    fn text_i64_bound(Element&mut self, StateI64& state) -> bool {
        if (tag_is_void(self.tag) || !state.valid()) { return false; }
        state_mark_bound(state.slot);
        if (!append_i64(&mut self.children, state_value(state.slot))) { return false; }
        return buffer_append_literal(&mut self.shape_children, "__raz_state_i64__");
    }
    fn text_derived_i64_bound(Element&mut self, DerivedI64& value) -> bool {
        if (tag_is_void(self.tag) || !value.valid()) { return false; }
        derived_mark(value.id, WEB_STATE_DEP_BOUND);
        if (!append_i64(&mut self.children, derived_value(value.id))) { return false; }
        return buffer_append_literal(&mut self.shape_children, "__raz_derived_i64__");
    }
    fn child(Element&mut self, Element&mut child) -> bool {
        if (tag_is_void(self.tag)) { return false; }
        if (!render_into(child, &mut self.children)) { return false; }
        return render_shape_into(child, &mut self.shape_children);
    }
}

// Concise typed child helpers keep common markup in ordinary Raz without
// allocating a JavaScript-side VDOM or introducing a second template grammar.
impl Element {
    fn child_text(Element&mut self, Tag tag, string value) -> bool {
        Element child = element(tag);
        child.component_scope = self.component_scope;
        if (!child.text(value)) { return false; }
        return self.child(&mut child);
    }
    fn child_text_i64(Element&mut self, Tag tag, string prefix, i64 value) -> bool {
        Element child = element(tag);
        child.component_scope = self.component_scope;
        if (!child.text(prefix)) { return false; }
        if (!child.text_i64(value)) { return false; }
        return self.child(&mut child);
    }
    fn child_button_add(Element&mut self, string class_name, string aria_label, string text, StateI64& state, i64 delta) -> bool {
        Element child = button();
        child.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { return false; }
        if (raz_rt_cstr_len(aria_label) > 0 && !child.aria_label(aria_label)) { return false; }
        if (!child.on_click_add(state, delta)) { return false; }
        if (!child.text(text)) { return false; }
        return self.child(&mut child);
    }
    fn child_text_state(Element&mut self, Tag tag, string prefix, StateString& state) -> bool {
        Element child = element(tag);
        child.component_scope = self.component_scope;
        if (!append_attribute_i64(&mut child, "data-raz-bind-string", state.slot)) { return false; }
        if (!append_attribute(&mut child, "data-raz-prefix", prefix)) { return false; }
        if (!child.text(prefix)) { return false; }
        if (!child.text_state_bound(state)) { return false; }
        return self.child(&mut child);
    }
    fn child_text_i64_state(Element&mut self, Tag tag, string prefix, StateI64& state) -> bool {
        Element child = element(tag);
        child.component_scope = self.component_scope;
        if (!append_attribute_i64(&mut child, "data-raz-bind-i64", state.slot)) { return false; }
        if (!append_attribute(&mut child, "data-raz-prefix", prefix)) { return false; }
        if (!child.text(prefix)) { return false; }
        if (!child.text_i64_bound(state)) { return false; }
        return self.child(&mut child);
    }
    fn child_text_derived_i64(Element&mut self, Tag tag, string prefix, DerivedI64& value) -> bool {
        Element child = element(tag);
        child.component_scope = self.component_scope;
        if (!append_attribute_i64(&mut child, "data-raz-bind-derived-i64", value.id)) { return false; }
        usize dependency_record = derived_record(value.id);
        if (!append_attribute_i64(&mut child, "data-raz-derived-left", raw_i64_get(dependency_record, 8))) { return false; }
        if (!append_attribute_i64(&mut child, "data-raz-derived-right", raw_i64_get(dependency_record, 16))) { return false; }
        if (!append_attribute(&mut child, "data-raz-prefix", prefix)) { return false; }
        if (!child.text(prefix)) { return false; }
        if (!child.text_derived_i64_bound(value)) { return false; }
        return self.child(&mut child);
    }
    fn child_keyed_text(Element&mut self, Tag tag, string key, string value) -> bool {
        Element child = element(tag);
        child.component_scope = self.component_scope;
        if (!child.key(key) || !child.text(value)) { return false; }
        return self.child(&mut child);
    }
    fn child_keyed_text_i64(Element&mut self, Tag tag, i64 key, string value) -> bool {
        Element child = element(tag);
        child.component_scope = self.component_scope;
        if (!child.key_i64(key) || !child.text(value)) { return false; }
        return self.child(&mut child);
    }
    fn child_input_string(Element&mut self, InputType kind, string class_name, string placeholder, StateString& state, bool is_required, i64 minimum) -> bool {
        if (kind != InputType::Text && kind != InputType::Email && kind != InputType::Password && kind != InputType::Search && kind != InputType::Url && kind != InputType::Tel && kind != InputType::Date) { return false; }
        Element child = input();
        child.component_scope = self.component_scope;
        if (!child.input_type(kind)) { return false; }
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { return false; }
        if (raz_rt_cstr_len(placeholder) > 0 && !child.placeholder(placeholder)) { return false; }
        if (is_required && !child.required()) { return false; }
        if (minimum > 0 && !child.min_length(minimum)) { return false; }
        if (!child.bind_input(state)) { return false; }
        return self.child(&mut child);
    }
    fn child_input_text(Element&mut self, string class_name, string placeholder, StateString& state) -> bool {
        return self.child_input_string(InputType::Text, class_name, placeholder, state, false, 0);
    }
    fn child_input_email(Element&mut self, string class_name, string placeholder, StateString& state) -> bool {
        return self.child_input_string(InputType::Email, class_name, placeholder, state, false, 0);
    }
    fn child_input_password(Element&mut self, string class_name, string placeholder, StateString& state) -> bool {
        return self.child_input_string(InputType::Password, class_name, placeholder, state, false, 0);
    }
    fn child_input_search(Element&mut self, string class_name, string placeholder, StateString& state) -> bool {
        return self.child_input_string(InputType::Search, class_name, placeholder, state, false, 0);
    }
    fn child_input_url(Element&mut self, string class_name, string placeholder, StateString& state) -> bool {
        return self.child_input_string(InputType::Url, class_name, placeholder, state, false, 0);
    }
    fn child_input_tel(Element&mut self, string class_name, string placeholder, StateString& state) -> bool {
        return self.child_input_string(InputType::Tel, class_name, placeholder, state, false, 0);
    }
    fn child_input_date(Element&mut self, string class_name, StateString& state) -> bool {
        return self.child_input_string(InputType::Date, class_name, "", state, false, 0);
    }
    fn child_input_number(Element&mut self, string class_name, StateI64& state) -> bool {
        Element child = input();
        child.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { return false; }
        if (!child.bind_number(state)) { return false; }
        return self.child(&mut child);
    }
    fn child_checkbox(Element&mut self, string class_name, StateBool& state) -> bool {
        Element child = input();
        child.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { return false; }
        if (!child.bind_checkbox(state)) { return false; }
        return self.child(&mut child);
    }
    fn child_form_text_post(Element&mut self, string class_name, string placeholder, string submit_text, StateString& state, HttpRequest& request) -> bool {
        Element form = element(Tag::Form);
        form.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !form.class_name(class_name)) { return false; }
        if (!form.bind_submit_text(state, request)) { return false; }
        if (!form.child_input_text("", placeholder, state)) { return false; }
        Element submit = input();
        submit.component_scope = self.component_scope;
        if (!submit.input_type(InputType::Submit) || !append_attribute(&mut submit, "value", submit_text)) { return false; }
        if (!form.child(&mut submit)) { return false; }
        return self.child(&mut form);
    }
    fn child_form_text_post_min(Element&mut self, string class_name, string placeholder, string submit_text, StateString& state, HttpRequest& request, i64 minimum) -> bool {
        Element form = element(Tag::Form);
        form.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !form.class_name(class_name)) { return false; }
        if (!form.bind_submit_text_min(state, request, minimum)) { return false; }
        if (!form.child_input_string(InputType::Text, "", placeholder, state, minimum > 0, minimum)) { return false; }
        Element submit = input();
        submit.component_scope = self.component_scope;
        if (!submit.input_type(InputType::Submit) || !append_attribute(&mut submit, "value", submit_text)) { return false; }
        if (!form.child(&mut submit)) { return false; }
        return self.child(&mut form);
    }
    fn child_nav_link(Element&mut self, string href, string text) -> bool {
        Element child = link();
        child.component_scope = self.component_scope;
        if (!child.href(href) || !child.navigate(href) || !child.text(text)) { return false; }
        return self.child(&mut child);
    }
    fn child_button_toggle(Element&mut self, string class_name, string aria_label, string text, StateBool& state) -> bool {
        Element child = button();
        child.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { return false; }
        if (raz_rt_cstr_len(aria_label) > 0 && !child.aria_label(aria_label)) { return false; }
        if (!child.on_click_toggle(state)) { return false; }
        if (!child.text(text)) { return false; }
        return self.child(&mut child);
    }
}
