    fn button_set_i64(Component&mut self, string class_name, string aria_label, string text, StateI64& state, i64 value) -> bool {
        Element child = button();
        child.component_scope = self.component_scope;
        if (raz_rt_cstr_len(class_name) > 0 && !child.class_name(class_name)) { self.failed = true; return false; }
        if (raz_rt_cstr_len(aria_label) > 0 && !child.aria_label(aria_label)) { self.failed = true; return false; }
        if (!child.on_click_set_i64(state, value) || !child.text(text) || !self.root.child(&mut child)) { self.failed = true; return false; }
        return true;
    }
    fn button_set_bool(Component&mut self, string class_name, string aria_label, string text, StateBool& state, bool value) -> bool {
