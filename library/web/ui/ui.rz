}

struct Buffer {
    usize data;
    i64 length;
    i64 capacity;
}

public struct StateI64 {
    i64 slot;
}

public struct StateBool {
    i64 slot;
}

public struct StateString {
    i64 slot;
}

// Derived scalar values are lightweight dependency records. They do not own
// application state: each record points at source StateI64 slots and can be
// recomputed by the browser directly through the Wasm ABI when all sources are
// bound-only. A structural get() promotes the source states conservatively.
public struct DerivedI64 {
    i64 id;
}

public struct DerivedBool {
    i64 id;
}

public struct HttpRequest {
    i64 slot;
}

public struct JsonString {
    usize data;
    i64 length;
    bool found;
}

public struct JsonI64 {
    i64 value;
    bool found;
}

public struct JsonBool {
    bool value;
    bool found;
}

public struct JsonF64 {
    f64 value;
    bool found;
}

public struct JsonNull {
    bool found;
}

public struct JsonObject {
    usize data;
    i64 length;
    bool found;
}

public struct JsonArray {
    usize data;
    i64 length;
    bool found;
}

// User-defined response models implement JsonDecode and can then be wrapped in
// Resource<T>. The resource tracks the underlying HTTP response generation and
// decodes at most once per completed response, keeping browser transport and
// application models fully on the Raz side of the Wasm boundary.
public trait JsonDecode {
    fn decode(Self&mut self, HttpRequest& request) -> bool;
}

public struct Resource<T> {
    i64 request_slot;
    T value;
    i64 decoded_version;
    bool decoded;
    bool failed;
}

struct JsonSlice {
    usize data;
    i64 length;
    i64 kind;
    bool found;
}

public struct Element {
    Tag tag;
    // Zero is the page scope. Positive values identify keyed component
    // rerender boundaries and are copied into descendant event bindings.
    i64 component_scope;
    Buffer attributes;
    Buffer children;
    // A parallel structural representation masks values from explicitly bound
    // state. If this exact byte sequence is unchanged across renders, the
    // browser can update those bindings directly without parsing/morphing HTML.
    Buffer shape_attributes;
    Buffer shape_children;
}

public struct StyleSheet {
    Buffer css;
}

public struct Component {
    Element root;
    StyleSheet styles;
    Buffer scripts;
    i64 component_scope;
    bool failed;
}

// Browser-visible document buffers. The generated web host reads these through
// stable exports after _start and again after an event dispatcher rerenders.
global mut usize web_html_data = 0;
global mut i64 web_html_length = 0;
global mut usize web_css_data = 0;
global mut i64 web_css_length = 0;
global mut usize web_title_data = 0;
global mut i64 web_title_length = 0;
global mut usize web_js_data = 0;
global mut i64 web_js_length = 0;
global mut i64 web_revision = 0;
global mut usize web_shape_data = 0;
global mut i64 web_shape_length = 0;
global mut i64 web_structure_revision = 0;
// Component-local render output. A positive component scope can publish only
// its keyed subtree here, letting the browser patch that boundary without
// rerunning or replacing the page-level document.
global mut usize web_component_html_data = 0;
global mut i64 web_component_html_length = 0;
global mut usize web_component_css_data = 0;
global mut i64 web_component_css_length = 0;
global mut i64 web_component_scope = 0;
global mut i64 web_component_revision = 0;

// Small browser-resident reactive store. State is keyed by the developer's
// stable string name instead of render order, so moving a state declaration in
// a component does not silently retarget another value. Records are four i64s:
// key hash, kind, value, and per-state version. Event records are three i64s:
// action kind, state slot, and action argument. The tables live for the Wasm
// instance lifetime and are reclaimed when the page unloads with the instance.
const i64 WEB_STATE_CAPACITY = 512;
const i64 WEB_STATE_RECORD_BYTES = 64;
const i64 WEB_EVENT_CAPACITY = 1024;
const i64 WEB_EVENT_RECORD_BYTES = 32;
const i64 WEB_STATE_I64 = 1;
const i64 WEB_STATE_BOOL = 2;
const i64 WEB_ACTION_ADD_I64 = 1;
const i64 WEB_ACTION_SET_I64 = 2;
const i64 WEB_ACTION_TOGGLE_BOOL = 3;
const i64 WEB_ACTION_SET_BOOL = 4;
const i64 WEB_ACTION_SET_STRING = 5;
const i64 WEB_ACTION_SUBMIT_STRING = 6;
const i64 WEB_ACTION_SUBMIT_STRING_MIN = 7;
const i64 WEB_ACTION_SET_BOOL_INPUT = 8;
const i64 WEB_ACTION_SET_I64_INPUT = 9;
const i64 WEB_STATE_STRING = 3;
const i64 WEB_STATE_DEP_BOUND = 1;
const i64 WEB_STATE_DEP_STRUCTURAL = 2;

const i64 WEB_DERIVED_CAPACITY = 128;
const i64 WEB_DERIVED_RECORD_BYTES = 32;
const i64 WEB_DERIVED_ADD = 1;
const i64 WEB_DERIVED_SUB = 2;
const i64 WEB_DERIVED_MUL_CONST = 3;
const i64 WEB_DERIVED_EQ = 4;
const i64 WEB_DERIVED_NE = 5;
const i64 WEB_DERIVED_LT = 6;
const i64 WEB_DERIVED_LTE = 7;
const i64 WEB_DERIVED_GT = 8;
const i64 WEB_DERIVED_GTE = 9;
const i64 WEB_DERIVED_EQ_CONST = 10;
const i64 WEB_DERIVED_NE_CONST = 11;
const i64 WEB_DERIVED_LT_CONST = 12;
const i64 WEB_DERIVED_LTE_CONST = 13;
const i64 WEB_DERIVED_GT_CONST = 14;
const i64 WEB_DERIVED_GTE_CONST = 15;
const i64 WEB_DERIVED_ADD_CONST = 16;
const i64 WEB_DERIVED_SUB_CONST = 17;

const i64 WEB_EFFECT_CAPACITY = 512;
const i64 WEB_EFFECT_RECORD_BYTES = 32;
const i64 WEB_EFFECT_STATE = 1;
const i64 WEB_EFFECT_HTTP = 2;
const i64 WEB_EFFECT_RENDER = 3;

const i64 WEB_HTTP_CAPACITY = 32;
const i64 WEB_HTTP_RECORD_BYTES = 104;
// Retained component props are compiler-managed snapshots used only for local
// rerenders. The first ABI supports flat Copy structs whose fields occupy one
// Wasm aggregate slot each. Records are scope, data pointer, and slot count.
const i64 WEB_COMPONENT_PROPS_CAPACITY = 64;
const i64 WEB_COMPONENT_PROPS_RECORD_BYTES = 24;
const i64 WEB_HTTP_IDLE = 0;
const i64 WEB_HTTP_PENDING = 1;
const i64 WEB_HTTP_INFLIGHT = 2;
const i64 WEB_HTTP_COMPLETE = 3;
const i64 WEB_HTTP_FAILED = 4;
const i64 WEB_HTTP_GET = 1;
const i64 WEB_HTTP_POST = 2;
const i64 WEB_HTTP_PUT = 3;
const i64 WEB_HTTP_PATCH = 4;
const i64 WEB_HTTP_DELETE = 5;

global mut usize web_state_records = 0;
global mut usize web_event_records = 0;
global mut i64 web_event_count = 0;
global mut usize web_derived_records = 0;
global mut i64 web_derived_count = 0;

global mut usize web_effect_records = 0;
global mut i64 web_render_generation = 0;

// Browser route and fetch state are owned by the Wasm instance. JavaScript is
// only the transport bridge to History/fetch and never owns application state.
global mut usize web_route_data = 0;
global mut i64 web_route_length = 0;
// Structural route reads use the same owner marker convention as state: 0 =
// unobserved, scope+1 = one owner, -1 = mixed owners.
global mut i64 web_route_structural_owner = 0;
global mut usize web_http_records = 0;
global mut usize web_component_props_records = 0;
fn buffer_new() -> Buffer {
    return Buffer { data: 0, length: 0, capacity: 0 };
}

fn raw_i64_get(usize base, i64 offset) -> i64 {
    unsafe { return *((base + offset)as i64*const); }
}

fn raw_i64_set(usize base, i64 offset, i64 value) {
    unsafe { *((base + offset)as i64*mut) = value; }
}

fn zero_bytes(usize base, i64 length) {
    i64 index = 0;
    while (index < length) {
        unsafe { *((base + index)as u8*mut) = 0; }
        index += 1;
    }
}

fn ensure_state_records() -> bool {
    if (web_state_records != 0) { return true; }
    i64 bytes = WEB_STATE_CAPACITY * WEB_STATE_RECORD_BYTES;
    usize next = raz_rt_alloc(bytes);
    if (next == 0) { return false; }
    zero_bytes(next, bytes);
    web_state_records = next;
    return true;
}

fn ensure_event_records() -> bool {
    if (web_event_records != 0) { return true; }
    i64 bytes = WEB_EVENT_CAPACITY * WEB_EVENT_RECORD_BYTES;
    usize next = raz_rt_alloc(bytes);
    if (next == 0) { return false; }
    zero_bytes(next, bytes);
    web_event_records = next;
    return true;
}

fn ensure_derived_records() -> bool {
    if (web_derived_records != 0) { return true; }
    i64 bytes = WEB_DERIVED_CAPACITY * WEB_DERIVED_RECORD_BYTES;
    usize next = raz_rt_alloc(bytes);
    if (next == 0) { return false; }
    zero_bytes(next, bytes);
    web_derived_records = next;
    return true;
}

fn derived_record(i64 id) -> usize {
    return web_derived_records + (id - 1) * WEB_DERIVED_RECORD_BYTES;
}

fn ensure_effect_records() -> bool {
    if (web_effect_records != 0) { return true; }
    i64 bytes = WEB_EFFECT_CAPACITY * WEB_EFFECT_RECORD_BYTES;
    usize next = raz_rt_alloc(bytes);
    if (next == 0) { return false; }
    zero_bytes(next, bytes);
    web_effect_records = next;
    return true;
}

fn effect_record(i64 slot) -> usize {
    return web_effect_records + slot * WEB_EFFECT_RECORD_BYTES;
}

// Returns true on first observation and whenever the observed version changes.
// Records are keyed by component scope + effect kind + source identity, so
// ordinary Raz conditional code can implement effects without closures or a
// second scheduler.
fn effect_changed(i64 scope, i64 kind, i64 source, i64 version) -> bool {
    if (scope < 0 || source < 0 || !ensure_effect_records()) { return false; }
    i64 slot = 0;
    i64 empty = -1;
    while (slot < WEB_EFFECT_CAPACITY) {
        usize record = effect_record(slot);
        i64 stored_kind = raw_i64_get(record, 0);
        if (stored_kind == 0) { if (empty < 0) { empty = slot; } }
        else if (stored_kind == kind && raw_i64_get(record, 8) == scope && raw_i64_get(record, 16) == source) {
            i64 previous = raw_i64_get(record, 24);
            if (previous == version) { return false; }
            raw_i64_set(record, 24, version);
            return true;
        }
        slot += 1;
    }
    if (empty < 0) { return false; }
    usize record = effect_record(empty);
    raw_i64_set(record, 0, kind);
    raw_i64_set(record, 8, scope);
    raw_i64_set(record, 16, source);
    raw_i64_set(record, 24, version);
    return true;
}

fn ensure_component_props_records() -> bool {
    if (web_component_props_records != 0) { return true; }
    i64 bytes = WEB_COMPONENT_PROPS_CAPACITY * WEB_COMPONENT_PROPS_RECORD_BYTES;
    usize next = raz_rt_alloc(bytes);
    if (next == 0) { return false; }
    zero_bytes(next, bytes);
    web_component_props_records = next;
    return true;
}

fn component_props_record(i64 slot) -> usize {
    return web_component_props_records + slot * WEB_COMPONENT_PROPS_RECORD_BYTES;
}

// Compiler-reserved retention ABI. Normal applications never call these
// directly: Wasm direct-call lowering snapshots props before invoking an
// annotated component, and the synthesized local dispatcher replays the last
// snapshot when that component rerenders independently of its parent.
public fn raz_web_component_props_retain(i64 scope, usize source, i64 slots) -> i64 {
    if (scope <= 0 || source == 0 || slots <= 0 || !ensure_component_props_records()) { return -1; }
    i64 slot = 0;
    i64 empty = -1;
    while (slot < WEB_COMPONENT_PROPS_CAPACITY) {
        usize record = component_props_record(slot);
        i64 stored_scope = raw_i64_get(record, 0);
        if (stored_scope == scope) {
            usize data = (raw_i64_get(record, 8))as usize;
            i64 stored_slots = raw_i64_get(record, 16);
            i64 bytes = slots * 8;
            if (data == 0 || stored_slots != slots) {
                usize next = raz_rt_alloc(bytes);
                if (next == 0) { return -1; }
                if (data != 0) { raz_rt_dealloc(data); }
                data = next;
                raw_i64_set(record, 8, (data)as i64);
                raw_i64_set(record, 16, slots);
            }
            raz_rt_copy(data, source, bytes);
            return 1;
        }
        if (stored_scope == 0 && empty < 0) { empty = slot; }
        slot += 1;
    }
    if (empty < 0) { return -1; }
    usize record = component_props_record(empty);
    i64 bytes = slots * 8;
    usize data = raz_rt_alloc(bytes);
    if (data == 0) { return -1; }
    raz_rt_copy(data, source, bytes);
    raw_i64_set(record, 0, scope);
    raw_i64_set(record, 8, (data)as i64);
    raw_i64_set(record, 16, slots);
    return 1;
}

public fn raz_web_component_props_ptr(i64 scope) -> usize {
    if (scope <= 0 || web_component_props_records == 0) { return 0; }
    i64 slot = 0;
    while (slot < WEB_COMPONENT_PROPS_CAPACITY) {
        usize record = component_props_record(slot);
        i64 stored_scope = raw_i64_get(record, 0);
        if (stored_scope == scope) { return (raw_i64_get(record, 8))as usize; }
        if (stored_scope == 0) { return 0; }
        slot += 1;
    }
    return 0;
}


fn register_derived_id(i64 kind, i64 left_slot, i64 right_slot, i64 argument) -> i64 {
    if (left_slot < 0 || left_slot >= WEB_STATE_CAPACITY || web_derived_count >= WEB_DERIVED_CAPACITY) { return -1; }
    bool needs_right = kind == WEB_DERIVED_ADD || kind == WEB_DERIVED_SUB || kind == WEB_DERIVED_EQ || kind == WEB_DERIVED_NE || kind == WEB_DERIVED_LT || kind == WEB_DERIVED_LTE || kind == WEB_DERIVED_GT || kind == WEB_DERIVED_GTE;
    bool uses_constant = kind == WEB_DERIVED_MUL_CONST || kind == WEB_DERIVED_EQ_CONST || kind == WEB_DERIVED_NE_CONST || kind == WEB_DERIVED_LT_CONST || kind == WEB_DERIVED_LTE_CONST || kind == WEB_DERIVED_GT_CONST || kind == WEB_DERIVED_GTE_CONST || kind == WEB_DERIVED_ADD_CONST || kind == WEB_DERIVED_SUB_CONST;
    if (needs_right && (right_slot < 0 || right_slot >= WEB_STATE_CAPACITY)) { return -1; }
    if (uses_constant && right_slot != -1) { return -1; }
    if (!ensure_derived_records()) { return -1; }
    i64 id = web_derived_count + 1;
    usize record = derived_record(id);
    raw_i64_set(record, 0, kind);
    raw_i64_set(record, 8, left_slot);
    raw_i64_set(record, 16, right_slot);
    raw_i64_set(record, 24, argument);
    web_derived_count += 1;
    return id;
}

fn register_derived_i64(i64 kind, i64 left_slot, i64 right_slot, i64 argument) -> DerivedI64 {
    return DerivedI64 { id: register_derived_id(kind, left_slot, right_slot, argument) };
}

fn register_derived_bool(i64 kind, i64 left_slot, i64 right_slot) -> DerivedBool {
    return DerivedBool { id: register_derived_id(kind, left_slot, right_slot, 0) };
}

fn state_key_hash(string key) -> i64 {
    i64 length = raz_rt_cstr_len(key);
    i64 hash = 17;
    i64 index = 0;
    while (index < length) {
        i64 byte = 0;
        unsafe { byte = (*((raz_rt_cstr_ptr(key) + index)as u8*const))as i64; }
        hash = (hash * 131 + byte + 1) % 281474976710597;
        index += 1;
    }
    if (hash == 0) { return 1; }
    return hash;
}

// Component keys are the public stable identity. The compiler uses this exact
// hash for @web_component("key"), removing hand-assigned numeric scopes.
public fn web_component_scope_for_key(string key) -> i64 { return state_key_hash(key); }

fn state_record(i64 slot) -> usize {
    return web_state_records + slot * WEB_STATE_RECORD_BYTES;
}

fn state_scoped_hash(i64 scope, string key) -> i64 {
    i64 hash = state_key_hash(key);
    if (scope <= 0) { return hash; }
    // Scope is already a stable component-key hash. Mix it with the local key
    // using a separate domain so reusable component instances may use natural
    // local names such as "count" without sharing browser state.
    i64 mixed = (hash * 65537 + scope * 257 + 193) % 281474976710597;
    if (mixed == 0) { return 1; }
    return mixed;
}

fn state_find_or_create_hash(i64 hash, i64 kind, i64 initial) -> i64 {
    if (!ensure_state_records() || hash <= 0) { return -1; }
    i64 start = hash % WEB_STATE_CAPACITY;
    i64 probe = 0;
    while (probe < WEB_STATE_CAPACITY) {
        i64 slot = (start + probe) % WEB_STATE_CAPACITY;
        usize record = state_record(slot);
        i64 stored_hash = raw_i64_get(record, 0);
        if (stored_hash == 0) {
            raw_i64_set(record, 0, hash);
            raw_i64_set(record, 8, kind);
            raw_i64_set(record, 16, initial);
            raw_i64_set(record, 24, 0);
            return slot;
        }
        if (stored_hash == hash && raw_i64_get(record, 8) == kind) { return slot; }
        probe += 1;
    }
    return -1;
}

fn state_find_or_create(string key, i64 kind, i64 initial) -> i64 {
    return state_find_or_create_hash(state_key_hash(key), kind, initial);
}

fn state_string_find_or_create_hash(i64 hash, string initial) -> i64 {
    if (!ensure_state_records() || hash <= 0) { return -1; }
    i64 start = hash % WEB_STATE_CAPACITY;
    i64 probe = 0;
    while (probe < WEB_STATE_CAPACITY) {
        i64 slot = (start + probe) % WEB_STATE_CAPACITY;
        usize record = state_record(slot);
        i64 stored_hash = raw_i64_get(record, 0);
        if (stored_hash == 0) {
            i64 length = raz_rt_cstr_len(initial);
            usize data = 0;
            if (length > 0) {
                data = raz_rt_alloc(length);
                if (data == 0) { return -1; }
                raz_rt_copy(data, raz_rt_cstr_ptr(initial), length);
            }
            raw_i64_set(record, 0, hash);
            raw_i64_set(record, 8, WEB_STATE_STRING);
            raw_i64_set(record, 16, 0);
            raw_i64_set(record, 24, 0);
            raw_i64_set(record, 32, (data)as i64);
            raw_i64_set(record, 40, length);
            return slot;
        }
        if (stored_hash == hash && raw_i64_get(record, 8) == WEB_STATE_STRING) { return slot; }
        probe += 1;
    }
    return -1;
}

fn state_string_find_or_create(string key, string initial) -> i64 {
    return state_string_find_or_create_hash(state_key_hash(key), initial);
}

fn state_string_data(i64 slot) -> usize {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return 0; }
    return raw_i64_get(state_record(slot), 32)as usize;
}

fn state_string_length(i64 slot) -> i64 {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return 0; }
    return raw_i64_get(state_record(slot), 40);
}

fn state_replace_string(i64 slot, usize data, i64 length) -> bool {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0 || length < 0) { return false; }
    if (length > 0 && data == 0) { return false; }
    usize next = 0;
    if (length > 0) {
        next = raz_rt_alloc(length);
        if (next == 0) { return false; }
        raz_rt_copy(next, data, length);
    }
    usize record = state_record(slot);
    usize old = raw_i64_get(record, 32)as usize;
    if (old != 0) { raz_rt_dealloc(old); }
    raw_i64_set(record, 32, (next)as i64);
    raw_i64_set(record, 40, length);
    // String record value slot is reserved for form-validation state:
    // 0 = untouched/validity unknown, 1 = last submission valid, -1 = invalid.
    raw_i64_set(record, 16, 0);
    raw_i64_set(record, 24, raw_i64_get(record, 24) + 1);
    return true;
}

fn state_value(i64 slot) -> i64 {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return 0; }
    return raw_i64_get(state_record(slot), 16);
}

fn state_version(i64 slot) -> i64 {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return 0; }
    return raw_i64_get(state_record(slot), 24);
}

fn state_dependency_flags(i64 slot) -> i64 {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return WEB_STATE_DEP_STRUCTURAL; }
    return raw_i64_get(state_record(slot), 48);
}

fn state_mark_dependency(i64 slot, i64 flag) {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return; }
    usize record = state_record(slot);
    i64 flags = raw_i64_get(record, 48);
    raw_i64_set(record, 48, flags | flag);
}

fn state_mark_bound(i64 slot) { state_mark_dependency(slot, WEB_STATE_DEP_BOUND); }

// Offset 56 tracks the unique owner of structural reads. 0 means no owner
// has been recorded, scope+1 identifies one owner (page scope is therefore 1),
// and -1 means the state is structurally consumed by multiple scopes.
fn state_mark_structural_scope(i64 slot, i64 scope) {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0 || scope < 0) { return; }
    state_mark_dependency(slot, WEB_STATE_DEP_STRUCTURAL);
    usize record = state_record(slot);
    i64 marker = scope + 1;
    i64 current = raw_i64_get(record, 56);
    if (current == 0) { raw_i64_set(record, 56, marker); }
    else if (current != marker) { raw_i64_set(record, 56, -1); }
}

fn state_mark_structural(i64 slot) { state_mark_structural_scope(slot, 0); }

fn state_requires_render(i64 slot) -> bool {
    i64 flags = state_dependency_flags(slot);
    return (flags & WEB_STATE_DEP_STRUCTURAL) != 0;
}

fn state_structural_scope(i64 slot) -> i64 {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return -1; }
    i64 marker = raw_i64_get(state_record(slot), 56);
    if (marker <= 0) { return -1; }
    return marker - 1;
}

fn clear_state_dependencies() {
    if (web_state_records == 0) { return; }
    i64 slot = 0;
    while (slot < WEB_STATE_CAPACITY) {
        usize record = state_record(slot);
        if (raw_i64_get(record, 0) != 0) {
            raw_i64_set(record, 48, 0);
            raw_i64_set(record, 56, 0);
        }
        slot += 1;
    }
}

fn state_replace(i64 slot, i64 value) -> bool {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return false; }
    usize record = state_record(slot);
    if (raw_i64_get(record, 16) != value) {
        raw_i64_set(record, 16, value);
        raw_i64_set(record, 24, raw_i64_get(record, 24) + 1);
    }
    return true;
}

fn state_add(i64 slot, i64 delta) -> bool {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || web_state_records == 0) { return false; }
    usize record = state_record(slot);
    raw_i64_set(record, 16, raw_i64_get(record, 16) + delta);
    raw_i64_set(record, 24, raw_i64_get(record, 24) + 1);
    return true;
}

fn register_state_action_scoped(i64 kind, i64 slot, i64 argument, i64 scope) -> i64 {
    if (slot < 0 || slot >= WEB_STATE_CAPACITY || scope < 0) { return -1; }
    if (!ensure_event_records()) { return -1; }
    // Event IDs must remain stable when a single component rerenders. Reuse an
    // existing action record before allocating a new ID.
    i64 index = 0;
    while (index < web_event_count) {
        usize existing = web_event_records + index * WEB_EVENT_RECORD_BYTES;
        if (raw_i64_get(existing, 0) == kind && raw_i64_get(existing, 8) == slot && raw_i64_get(existing, 16) == argument && raw_i64_get(existing, 24) == scope) {
            return index + 1;
        }
        index += 1;
    }
    if (web_event_count >= WEB_EVENT_CAPACITY) { return -1; }
    usize record = web_event_records + web_event_count * WEB_EVENT_RECORD_BYTES;
    raw_i64_set(record, 0, kind);
    raw_i64_set(record, 8, slot);
    raw_i64_set(record, 16, argument);
    raw_i64_set(record, 24, scope);
    web_event_count += 1;
    return web_event_count;
}

fn register_state_action(i64 kind, i64 slot, i64 argument) -> i64 {
    return register_state_action_scoped(kind, slot, argument, 0);
}

// Start a new render pass. State survives; only ephemeral DOM event bindings
// are rebuilt. Event IDs therefore stay compact and can be delegated by the JS
// host without retaining JavaScript closures for each DOM node.
public fn begin_render() {
    web_render_generation += 1;
    // State action IDs are lifetime-stable so component-local rerenders cannot
    // invalidate sibling DOM bindings. Derived records remain per full render.
    web_derived_count = 0;
    clear_state_dependencies();
    web_route_structural_owner = 0;
    if (web_http_records != 0) {
        i64 request_slot = 0;
        while (request_slot < WEB_HTTP_CAPACITY) {
            usize request_record = web_http_records + request_slot * WEB_HTTP_RECORD_BYTES;
            if (raw_i64_get(request_record, 0) != 0) { raw_i64_set(request_record, 96, 0); }
            request_slot += 1;
        }
    }
}

public fn state_i64(string key, i64 initial) -> StateI64 {
    return StateI64 { slot: state_find_or_create(key, WEB_STATE_I64, initial) };
}

public fn state_bool(string key, bool initial) -> StateBool {
    i64 value = 0;
    if (initial) { value = 1; }
    return StateBool { slot: state_find_or_create(key, WEB_STATE_BOOL, value) };
}

public fn state_string(string key, string initial) -> StateString {
    return StateString { slot: state_string_find_or_create(key, initial) };
}

/// Creates state in a stable component namespace. Scope zero intentionally
/// falls back to page/global state so the same helpers work on unscoped roots.
public fn state_i64_scoped(i64 scope, string key, i64 initial) -> StateI64 {
    return StateI64 { slot: state_find_or_create_hash(state_scoped_hash(scope, key), WEB_STATE_I64, initial) };
}

public fn state_bool_scoped(i64 scope, string key, bool initial) -> StateBool {
    i64 value = 0;
    if (initial) { value = 1; }
    return StateBool { slot: state_find_or_create_hash(state_scoped_hash(scope, key), WEB_STATE_BOOL, value) };
}

public fn state_string_scoped(i64 scope, string key, string initial) -> StateString {
    return StateString { slot: state_string_find_or_create_hash(state_scoped_hash(scope, key), initial) };
}

public fn derived_add(StateI64& left, StateI64& right) -> DerivedI64 {
    return register_derived_i64(WEB_DERIVED_ADD, left.slot, right.slot, 0);
}

public fn derived_sub(StateI64& left, StateI64& right) -> DerivedI64 {
    return register_derived_i64(WEB_DERIVED_SUB, left.slot, right.slot, 0);
}

public fn derived_mul(StateI64& source, i64 factor) -> DerivedI64 {
    return register_derived_i64(WEB_DERIVED_MUL_CONST, source.slot, -1, factor);
}
public fn derived_add_const(StateI64& source, i64 value) -> DerivedI64 { return register_derived_i64(WEB_DERIVED_ADD_CONST, source.slot, -1, value); }
public fn derived_sub_const(StateI64& source, i64 value) -> DerivedI64 { return register_derived_i64(WEB_DERIVED_SUB_CONST, source.slot, -1, value); }

public fn derived_eq(StateI64& left, StateI64& right) -> DerivedBool { return register_derived_bool(WEB_DERIVED_EQ, left.slot, right.slot); }
public fn derived_ne(StateI64& left, StateI64& right) -> DerivedBool { return register_derived_bool(WEB_DERIVED_NE, left.slot, right.slot); }
public fn derived_lt(StateI64& left, StateI64& right) -> DerivedBool { return register_derived_bool(WEB_DERIVED_LT, left.slot, right.slot); }
public fn derived_lte(StateI64& left, StateI64& right) -> DerivedBool { return register_derived_bool(WEB_DERIVED_LTE, left.slot, right.slot); }
public fn derived_gt(StateI64& left, StateI64& right) -> DerivedBool { return register_derived_bool(WEB_DERIVED_GT, left.slot, right.slot); }
public fn derived_gte(StateI64& left, StateI64& right) -> DerivedBool { return register_derived_bool(WEB_DERIVED_GTE, left.slot, right.slot); }

public fn derived_eq_const(StateI64& source, i64 value) -> DerivedBool { return DerivedBool { id: register_derived_id(WEB_DERIVED_EQ_CONST, source.slot, -1, value) }; }
public fn derived_ne_const(StateI64& source, i64 value) -> DerivedBool { return DerivedBool { id: register_derived_id(WEB_DERIVED_NE_CONST, source.slot, -1, value) }; }
public fn derived_lt_const(StateI64& source, i64 value) -> DerivedBool { return DerivedBool { id: register_derived_id(WEB_DERIVED_LT_CONST, source.slot, -1, value) }; }
public fn derived_lte_const(StateI64& source, i64 value) -> DerivedBool { return DerivedBool { id: register_derived_id(WEB_DERIVED_LTE_CONST, source.slot, -1, value) }; }
public fn derived_gt_const(StateI64& source, i64 value) -> DerivedBool { return DerivedBool { id: register_derived_id(WEB_DERIVED_GT_CONST, source.slot, -1, value) }; }
public fn derived_gte_const(StateI64& source, i64 value) -> DerivedBool { return DerivedBool { id: register_derived_id(WEB_DERIVED_GTE_CONST, source.slot, -1, value) }; }

fn buffer_reserve(Buffer&mut value, i64 required) -> bool {
    if (required < 0) { return false; }
    if (required <= value.capacity) { return true; }
    i64 next = value.capacity;
    if (next < 64) { next = 64; }
    while (next < required) {
        if (next > 2305843009213693951) {
            next = required;
            break;
        }
        next *= 2;
    }
    usize pointer = raz_rt_alloc(next);
    if (pointer == 0) { return false; }
    if (value.data != 0 && value.length > 0) {
        raz_rt_copy(pointer, value.data, value.length);
    }
    if (value.data != 0) { raz_rt_dealloc(value.data); }
    value.data = pointer;
    value.capacity = next;
    return true;
}
fn buffer_push_byte(Buffer&mut value, i64 byte) -> bool {
    if (!buffer_reserve(value, value.length + 1)) { return false; }
    unsafe {
        *((value.data + value.length)as u8*mut) = (byte & 255)as u8;
    }
    value.length += 1;
    return true;
}

fn buffer_append_bytes(Buffer&mut value, usize data, i64 length) -> bool {
    if (length < 0 || (length > 0 && data == 0)) { return false; }
    if (length == 0) { return true; }
    if (value.length > 9223372036854775807 - length) { return false; }
    if (!buffer_reserve(value, value.length + length)) { return false; }
    raz_rt_copy(value.data + value.length, data, length);
    value.length += length;
    return true;
}

fn buffer_append_literal(Buffer&mut value, string text) -> bool {
    return buffer_append_bytes(value, raz_rt_cstr_ptr(text), raz_rt_cstr_len(text));
}

fn buffer_append_buffer(Buffer&mut value, Buffer& other) -> bool {
    return buffer_append_bytes(value, other.data, other.length);
}

fn buffer_append_to_string(Buffer& value, String&mut output) -> bool {
    i64 index = 0;
    while (index < value.length) {
        i64 byte = 0;
        unsafe { byte = (*((value.data + index)as u8*const))as i64; }
        if (!output.push(byte)) { return false; }
        index += 1;
    }
    return true;
}

fn buffer_contains_literal(Buffer& value, string text) -> bool {
    return buffer_contains_bytes(value, raz_rt_cstr_ptr(text), raz_rt_cstr_len(text));
}

fn buffer_contains_bytes(Buffer& value, usize needle, i64 needle_length) -> bool {
    if (needle_length <= 0) { return true; }
    if (value.data == 0 || needle == 0 || needle_length > value.length) { return false; }
    i64 start = 0;
    while (start + needle_length <= value.length) {
        i64 index = 0;
        bool same = true;
        while (index < needle_length) {
            i64 left = 0;
            i64 right = 0;
            unsafe {
                left = (*((value.data + start + index)as u8*const))as i64;
                right = (*((needle + index)as u8*const))as i64;
            }
            if (left != right) { same = false; break; }
            index += 1;
        }
        if (same) { return true; }
        start += 1;
    }
    return false;
}

fn buffer_append_unique_buffer(Buffer&mut value, Buffer& other) -> bool {
    if (other.length <= 0) { return true; }
    if (buffer_contains_bytes(value, other.data, other.length)) { return true; }
    return buffer_append_buffer(value, other);
}

fn literal_byte(string value, i64 index) -> i64 {
    unsafe {
        return (*((raz_rt_cstr_ptr(value) + index)as u8*const))as i64;
    }
}

fn append_escaped(Buffer&mut output, string value) -> bool {
    i64 length = raz_rt_cstr_len(value);
    i64 index = 0;
    while (index < length) {
        i64 byte = literal_byte(value, index);
        if (byte == 38) {
            if (!buffer_append_literal(output, "&amp;")) { return false; }
        } else if (byte == 60) {
            if (!buffer_append_literal(output, "&lt;")) { return false; }
        } else if (byte == 62) {
            if (!buffer_append_literal(output, "&gt;")) { return false; }
        } else if (byte == 34) {
            if (!buffer_append_literal(output, "&quot;")) { return false; }
        } else if (byte == 39) {
            if (!buffer_append_literal(output, "&#39;")) { return false; }
        } else if (!buffer_push_byte(output, byte)) {
            return false;
        }
        index += 1;
    }
    return true;
}
fn append_escaped_bytes(Buffer&mut output, usize data, i64 length) -> bool {
    if (length < 0 || (length > 0 && data == 0)) { return false; }
    i64 index = 0;
    while (index < length) {
        i64 byte = 0;
        unsafe { byte = (*((data + index)as u8*const))as i64; }
        if (byte == 38) { if (!buffer_append_literal(output, "&amp;")) { return false; } }
        else if (byte == 60) { if (!buffer_append_literal(output, "&lt;")) { return false; } }
        else if (byte == 62) { if (!buffer_append_literal(output, "&gt;")) { return false; } }
        else if (byte == 34) { if (!buffer_append_literal(output, "&quot;")) { return false; } }
        else if (byte == 39) { if (!buffer_append_literal(output, "&#39;")) { return false; } }
        else if (!buffer_push_byte(output, byte)) { return false; }
        index += 1;
    }
    return true;
}

fn append_html_byte(Buffer&mut output, i64 byte) -> bool {
    if (byte == 38) { return buffer_append_literal(output, "&amp;"); }
    if (byte == 60) { return buffer_append_literal(output, "&lt;"); }
    if (byte == 62) { return buffer_append_literal(output, "&gt;"); }
    if (byte == 34) { return buffer_append_literal(output, "&quot;"); }
    if (byte == 39) { return buffer_append_literal(output, "&#39;"); }
    return buffer_push_byte(output, byte);
}

fn json_hex(i64 byte) -> i64 {
    if (byte >= 48 && byte <= 57) { return byte - 48; }
    if (byte >= 65 && byte <= 70) { return byte - 55; }
    if (byte >= 97 && byte <= 102) { return byte - 87; }
    return -1;
}

fn append_utf8_scalar(Buffer&mut output, i64 scalar) -> bool {
    if (scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343)) { return false; }
    if (scalar <= 127) { return append_html_byte(output, scalar); }
    if (scalar <= 2047) {
        if (!buffer_push_byte(output, 192 | (scalar / 64))) { return false; }
        return buffer_push_byte(output, 128 | (scalar % 64));
    }
    if (scalar <= 65535) {
        if (!buffer_push_byte(output, 224 | (scalar / 4096))) { return false; }
        if (!buffer_push_byte(output, 128 | ((scalar / 64) % 64))) { return false; }
        return buffer_push_byte(output, 128 | (scalar % 64));
    }
    if (!buffer_push_byte(output, 240 | (scalar / 262144))) { return false; }
    if (!buffer_push_byte(output, 128 | ((scalar / 4096) % 64))) { return false; }
    if (!buffer_push_byte(output, 128 | ((scalar / 64) % 64))) { return false; }
    return buffer_push_byte(output, 128 | (scalar % 64));
}

fn json_u16(usize data, i64 length, i64 index) -> i64 {
    if (index < 0 || index + 4 > length) { return -1; }
    i64 value = 0;
    i64 offset = 0;
    while (offset < 4) {
        i64 digit = json_hex(json_byte(data, index + offset));
        if (digit < 0) { return -1; }
        value = value * 16 + digit;
        offset += 1;
    }
    return value;
}

// Decode a JSON string slice directly into HTML output. The slice excludes the
// surrounding quotes but may contain all standard JSON escapes, including
// UTF-16 surrogate pairs. Response models remain zero-copy views over the HTTP
// bytes while rendering still receives decoded UTF-8.
fn append_json_simple_escape(Buffer&mut output, i64 escaped) -> i64 {
    i64 value = -1;
    if (escaped == 34 || escaped == 92 || escaped == 47) { value = escaped; }
    else if (escaped == 98) { value = 8; }
    else if (escaped == 102) { value = 12; }
    else if (escaped == 110) { value = 10; }
    else if (escaped == 114) { value = 13; }
    else if (escaped == 116) { value = 9; }
    if (value < 0) { return 0; }
    if (!append_html_byte(output, value)) { return -1; }
    return 1;
}

fn append_json_unicode_escape(Buffer&mut output, usize data, i64 length, i64&mut index) -> bool {
    i64 high = json_u16(data, length, *index + 1);
    if (high < 0) { return false; }
    *index += 5;
    i64 scalar = high;
    if (high >= 55296 && high <= 56319) {
        if (*index + 6 > length) { return false; }
        if (json_byte(data, *index) != 92 || json_byte(data, *index + 1) != 117) { return false; }
        i64 low = json_u16(data, length, *index + 2);
        if (low < 56320 || low > 57343) { return false; }
        scalar = 65536 + (high - 55296) * 1024 + (low - 56320);
        *index += 6;
    } else if (high >= 56320 && high <= 57343) {
        return false;
    }
    return append_utf8_scalar(output, scalar);
}

fn append_json_string_html(Buffer&mut output, usize data, i64 length) -> bool {
    i64 index = 0;
    while (index < length) {
        i64 byte = json_byte(data, index);
        if (byte != 92) {
            if (byte < 32 || !append_html_byte(output, byte)) { return false; }
            index += 1;
            continue;
        }
        index += 1;
        if (index >= length) { return false; }
        i64 escaped = json_byte(data, index);
        i64 simple = append_json_simple_escape(output, escaped);
        if (simple < 0) { return false; }
        if (simple > 0) { index += 1; continue; }
        if (escaped != 117) { return false; }
        if (!append_json_unicode_escape(output, data, length, &mut index)) { return false; }
    }
    return true;
}

fn append_i64(Buffer&mut output, i64 value) -> bool {
    if (value == 0) { return buffer_push_byte(output, 48); }
    i64 digits[20];
    i64 count = 0;
    i64 current = value;
    while (current != 0) {
        i64 remainder = current % 10;
        if (remainder < 0) { remainder = -remainder; }
        digits[count] = 48 + remainder;
        count += 1;
        current /= 10;
    }
    if (value < 0 && !buffer_push_byte(output, 45)) { return false; }
    while (count > 0) {
        count -= 1;
        if (!buffer_push_byte(output, digits[count])) { return false; }
    }
    return true;
}

fn tag_name(Tag tag) -> string {
    match tag {
        Tag::Fragment => { return ""; }
        Tag::Div => { return "div"; }
        Tag::Main => { return "main"; }
        Tag::Section => { return "section"; }
        Tag::Header => { return "header"; }
        Tag::Footer => { return "footer"; }
        Tag::Nav => { return "nav"; }
        Tag::Article => { return "article"; }
        Tag::Aside => { return "aside"; }
        Tag::Figure => { return "figure"; }
        Tag::Figcaption => { return "figcaption"; }
        Tag::H1 => { return "h1"; }
        Tag::H2 => { return "h2"; }
        Tag::H3 => { return "h3"; }
        Tag::H4 => { return "h4"; }
        Tag::H5 => { return "h5"; }
        Tag::H6 => { return "h6"; }
        Tag::P => { return "p"; }
        Tag::Span => { return "span"; }
        Tag::Small => { return "small"; }
        Tag::Strong => { return "strong"; }
        Tag::Em => { return "em"; }
        Tag::Code => { return "code"; }
        Tag::Pre => { return "pre"; }
        Tag::Blockquote => { return "blockquote"; }
        Tag::Br => { return "br"; }
        Tag::Hr => { return "hr"; }
        Tag::Button => { return "button"; }
        Tag::A => { return "a"; }
        Tag::Ul => { return "ul"; }
        Tag::Ol => { return "ol"; }
        Tag::Li => { return "li"; }
        Tag::Dl => { return "dl"; }
        Tag::Dt => { return "dt"; }
        Tag::Dd => { return "dd"; }
        Tag::Form => { return "form"; }
        Tag::Label => { return "label"; }
        Tag::Input => { return "input"; }
        Tag::Textarea => { return "textarea"; }
        Tag::Select => { return "select"; }
        Tag::Option => { return "option"; }
        Tag::Details => { return "details"; }
        Tag::Summary => { return "summary"; }
        Tag::Table => { return "table"; }
        Tag::Thead => { return "thead"; }
        Tag::Tbody => { return "tbody"; }
        Tag::Tr => { return "tr"; }
        Tag::Th => { return "th"; }
        Tag::Td => { return "td"; }
        Tag::Img => { return "img"; }
        Tag::Video => { return "video"; }
        Tag::Audio => { return "audio"; }
        Tag::Source => { return "source"; }
    }
}

fn tag_is_void(Tag tag) -> bool {
    match tag {
        Tag::Input => { return true; }
        Tag::Img => { return true; }
        Tag::Br => { return true; }
        Tag::Hr => { return true; }
        Tag::Source => { return true; }
        _ => { return false; }
    }
}

fn input_type_name(InputType value) -> string {
    match value {
        InputType::Text => { return "text"; }
        InputType::Email => { return "email"; }
        InputType::Password => { return "password"; }
        InputType::Number => { return "number"; }
        InputType::Search => { return "search"; }
        InputType::Url => { return "url"; }
        InputType::Tel => { return "tel"; }
        InputType::Date => { return "date"; }
        InputType::Checkbox => { return "checkbox"; }
        InputType::Radio => { return "radio"; }
        InputType::File => { return "file"; }
        InputType::Hidden => { return "hidden"; }
        InputType::Submit => { return "submit"; }
        InputType::Button => { return "button"; }
        InputType::Reset => { return "reset"; }
        InputType::Color => { return "color"; }
        InputType::Range => { return "range"; }
        InputType::Month => { return "month"; }
        InputType::Week => { return "week"; }
        InputType::Time => { return "time"; }
        InputType::DateTimeLocal => { return "datetime-local"; }
    }
}

fn html_name_byte_allowed(i64 byte) -> bool {
    if (byte >= 48 && byte <= 57) { return true; }
    if (byte >= 65 && byte <= 90) { return true; }
    if (byte >= 97 && byte <= 122) { return true; }
    return byte == 45 || byte == 95 || byte == 58;
}

fn html_name_valid(string value) -> bool {
    i64 length = raz_rt_cstr_len(value);
    if (length <= 0) { return false; }
    i64 index = 0;
    while (index < length) {
        if (!html_name_byte_allowed(literal_byte(value, index))) { return false; }
        index += 1;
    }
    return true;
}

fn append_attribute_to(Buffer&mut output, string name, string value) -> bool {
    if (!html_name_valid(name)) { return false; }
    if (!buffer_push_byte(output, 32)) { return false; }
    if (!buffer_append_literal(output, name)) { return false; }
    if (!buffer_append_literal(output, "=\"")) { return false; }
    if (!append_escaped(output, value)) { return false; }
    return buffer_push_byte(output, 34);
}

fn append_attribute_i64_to(Buffer&mut output, string name, i64 value) -> bool {
    if (!html_name_valid(name)) { return false; }
    if (!buffer_push_byte(output, 32)) { return false; }
    if (!buffer_append_literal(output, name)) { return false; }
    if (!buffer_append_literal(output, "=\"")) { return false; }
    if (!append_i64(output, value)) { return false; }
    return buffer_push_byte(output, 34);
}

fn append_boolean_attribute_to(Buffer&mut output, string name) -> bool {
    if (!html_name_valid(name)) { return false; }
    if (!buffer_push_byte(output, 32)) { return false; }
    return buffer_append_literal(output, name);
}

fn append_attribute(Element&mut element, string name, string value) -> bool {
    if (!append_attribute_to(&mut element.attributes, name, value)) { return false; }
    return append_attribute_to(&mut element.shape_attributes, name, value);
}

fn append_attribute_i64(Element&mut element, string name, i64 value) -> bool {
    if (!append_attribute_i64_to(&mut element.attributes, name, value)) { return false; }
    return append_attribute_i64_to(&mut element.shape_attributes, name, value);
}

fn append_boolean_attribute(Element&mut element, string name) -> bool {
    if (!append_boolean_attribute_to(&mut element.attributes, name)) { return false; }
    return append_boolean_attribute_to(&mut element.shape_attributes, name);
}

// Dynamic attributes carry the real value in HTML but a fixed marker in the
// structural stream. Callers must also emit a data-raz-state-* binding that the
// browser host knows how to patch when the structural revision is unchanged.
fn append_dynamic_attribute_bytes(Element&mut element, string name, usize data, i64 length) -> bool {
    if (!buffer_push_byte(&mut element.attributes, 32)) { return false; }
    if (!buffer_append_literal(&mut element.attributes, name)) { return false; }
    if (!buffer_append_literal(&mut element.attributes, "=\"")) { return false; }
    if (!append_escaped_bytes(&mut element.attributes, data, length)) { return false; }
    if (!buffer_push_byte(&mut element.attributes, 34)) { return false; }
    return append_attribute_to(&mut element.shape_attributes, name, "__raz_state_bytes__");
}

fn append_dynamic_attribute_i64(Element&mut element, string name, i64 value) -> bool {
    if (!buffer_push_byte(&mut element.attributes, 32)) { return false; }
    if (!buffer_append_literal(&mut element.attributes, name)) { return false; }
    if (!buffer_append_literal(&mut element.attributes, "=\"")) { return false; }
    if (!append_i64(&mut element.attributes, value)) { return false; }
    if (!buffer_push_byte(&mut element.attributes, 34)) { return false; }
    return append_attribute_to(&mut element.shape_attributes, name, "__raz_state_i64__");
}

fn append_dynamic_boolean_attribute(Element&mut element, string name, bool present) -> bool {
    if (present && !append_boolean_attribute_to(&mut element.attributes, name)) { return false; }
    // Always contribute the same marker regardless of the live boolean value.
    if (!buffer_push_byte(&mut element.shape_attributes, 32)) { return false; }
    if (!buffer_append_literal(&mut element.shape_attributes, "__raz_state_bool_")) { return false; }
    if (!buffer_append_literal(&mut element.shape_attributes, name)) { return false; }
    return buffer_append_literal(&mut element.shape_attributes, "__");
}

fn append_event_attribute(Element&mut element, string name, i64 event_id) -> bool {
    if (event_id < 0) { return false; }
    if (!append_attribute_i64_to(&mut element.attributes, name, event_id)) { return false; }
    return append_attribute_i64_to(&mut element.shape_attributes, name, event_id);
}

fn render_buffers(Tag tag, Buffer& attributes, Buffer& children, Buffer&mut output) -> bool {
    // Fragments are a compile/render-time composition primitive, not a DOM
    // element. Attributes are intentionally invalid on a fragment; callers
    // get wrapper-free children in both the HTML and structural streams.
    if (tag == Tag::Fragment) {
        if (attributes.length != 0) { return false; }
        return buffer_append_buffer(output, children);
    }
    string name = tag_name(tag);
    if (!buffer_push_byte(output, 60)) { return false; }
    if (!buffer_append_literal(output, name)) { return false; }
    if (!buffer_append_buffer(output, attributes)) { return false; }
    if (tag_is_void(tag)) { return buffer_append_literal(output, " />"); }
    if (!buffer_push_byte(output, 62)) { return false; }
    if (!buffer_append_buffer(output, children)) { return false; }
    if (!buffer_append_literal(output, "</")) { return false; }
    if (!buffer_append_literal(output, name)) { return false; }
    return buffer_push_byte(output, 62);
}

fn render_into(Element& element, Buffer&mut output) -> bool {
    return render_buffers(element.tag, &element.attributes, &element.children, output);
}

fn render_shape_into(Element& element, Buffer&mut output) -> bool {
    return render_buffers(element.tag, &element.shape_attributes, &element.shape_children, output);
}

fn bytes_equal(usize left, i64 left_length, usize right, i64 right_length) -> bool {
    if (left_length != right_length) { return false; }
    i64 index = 0;
    while (index < left_length) {
        i64 a = 0;
        i64 b = 0;
        unsafe {
            a = (*((left + index)as u8*const))as i64;
            b = (*((right + index)as u8*const))as i64;
        }
        if (a != b) { return false; }
        index += 1;
    }
    return true;
}

fn replace_buffer(usize data, i64 length, usize&mut destination, i64&mut destination_length) -> bool {
    if (length < 0 || (length > 0 && data == 0)) { return false; }
    usize next = 0;
    if (length > 0) {
        next = raz_rt_alloc(length);
        if (next == 0) { return false; }
        raz_rt_copy(next, data, length);
    }
    if (*destination != 0) { raz_rt_dealloc(*destination); }
    *destination = next;
    *destination_length = length;
    return true;
}

impl Drop for Buffer {
    fn drop(Buffer&mut self) {
        if (self.data != 0) { raz_rt_dealloc(self.data); }
        self.data = 0;
        self.length = 0;
        self.capacity = 0;
    }
}
public fn element(Tag tag) -> Element {
    return Element {
        tag: tag,
        component_scope: 0,
        attributes: buffer_new(),
        children: buffer_new(),
        shape_attributes: buffer_new(),
        shape_children: buffer_new(),
    };
}

public fn div() -> Element { return element(Tag::Div); }
public fn main_element() -> Element { return element(Tag::Main); }
public fn section() -> Element { return element(Tag::Section); }
public fn header() -> Element { return element(Tag::Header); }
public fn footer() -> Element { return element(Tag::Footer); }
