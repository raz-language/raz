namespace web::build::format;

import alloc::string;

public fn append_i64(String&mut output, i64 value) -> bool {
    if (value == 0) { return alloc::string::push_byte(output, 48); }
    i64 digits[20];
    i64 count = 0;
    i64 current = value;
    while (current != 0) {
        i64 remainder = current % 10;
        if (remainder < 0) { remainder = -remainder; }
        digits[count] = 48 + remainder;
        count += 1;
        current /= 10;
    }
    if (value < 0 && !alloc::string::push_byte(output, 45)) { return false; }
    while (count > 0) {
        count -= 1;
        if (!alloc::string::push_byte(output, digits[count])) { return false; }
    }
    return true;
}
