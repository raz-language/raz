namespace web::std::url;

import alloc::string;

extern fn raz_web_url_query_value_length(string name) -> i64;
extern fn raz_web_url_query_value_write(string name, usize output, i64 capacity) -> i64;
extern fn raz_web_url_encode_length(string value) -> i64;
extern fn raz_web_url_encode_write(string value, usize output, i64 capacity) -> i64;
extern fn raz_web_url_decode_length(string value) -> i64;
extern fn raz_web_url_decode_write(string value, usize output, i64 capacity) -> i64;

fn read_query_value(string name) -> String {
    i64 length = raz_web_url_query_value_length(name);
    if (length < 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = raz_web_url_query_value_write(name, value.as_ptr(), length);
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}

fn read_encoded(string value, bool decode) -> String {
    i64 length = 0;
    if (decode) { length = raz_web_url_decode_length(value); } else { length = raz_web_url_encode_length(value); }
    if (length < 0) { return String::new(); }
    String output = String::with_capacity(length);
    if (!alloc::string::resize(&mut output, length, 0)) { return String::new(); }
    i64 written = 0;
    if (decode) { written = raz_web_url_decode_write(value, output.as_ptr(), length); } else { written = raz_web_url_encode_write(value, output.as_ptr(), length); }
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut output, written); }
    return output;
}

/// Reads one query-string value from the current document URL.
/// Missing keys return an empty string; `has_query` distinguishes missing from an explicitly empty value.
public fn query(string name) -> String { return read_query_value(name); }

extern fn raz_web_url_query_has(string name) -> bool;
public fn has_query(string name) -> bool { return raz_web_url_query_has(name); }

public fn encode_component(string value) -> String { return read_encoded(value, false); }
public fn decode_component(string value) -> String { return read_encoded(value, true); }
