namespace web::std::timers;

extern fn raz_web_timer_set_timeout(string exported_handler, i64 delay_ms) -> i64;
extern fn raz_web_timer_clear_timeout(i64 timer_id) -> bool;
extern fn raz_web_timer_set_interval(string exported_handler, i64 delay_ms) -> i64;
extern fn raz_web_timer_clear_interval(i64 timer_id) -> bool;

/// Schedules an exported zero-argument Raz function after `delay_ms`.
/// The returned id can be passed to `clear_timeout`.
public fn set_timeout(string exported_handler, i64 delay_ms) -> i64 {
    return raz_web_timer_set_timeout(exported_handler, delay_ms);
}

public fn clear_timeout(i64 timer_id) -> bool {
    return raz_web_timer_clear_timeout(timer_id);
}


/// Repeatedly invokes an exported zero-argument Raz function until cleared.
public fn set_interval(string exported_handler, i64 delay_ms) -> i64 {
    return raz_web_timer_set_interval(exported_handler, delay_ms);
}

public fn clear_interval(i64 timer_id) -> bool {
    return raz_web_timer_clear_interval(timer_id);
}
