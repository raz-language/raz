namespace web::std::storage;

import alloc::string;

extern fn raz_web_storage_set(string key, string value) -> bool;
extern fn raz_web_storage_remove(string key) -> bool;
extern fn raz_web_storage_clear() -> bool;
extern fn raz_web_storage_value_length(string key) -> i64;
extern fn raz_web_storage_value_write(string key, usize output, i64 capacity) -> i64;
extern fn raz_web_session_storage_set(string key, string value) -> bool;
extern fn raz_web_session_storage_remove(string key) -> bool;
extern fn raz_web_session_storage_clear() -> bool;
extern fn raz_web_session_storage_value_length(string key) -> i64;
extern fn raz_web_session_storage_value_write(string key, usize output, i64 capacity) -> i64;

public fn set(string key, string value) -> bool {
    return raz_web_storage_set(key, value);
}

public fn remove(string key) -> bool {
    return raz_web_storage_remove(key);
}

public fn clear() -> bool {
    return raz_web_storage_clear();
}

public fn get(string key) -> String {
    i64 length = raz_web_storage_value_length(key);
    if (length <= 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = raz_web_storage_value_write(key, value.as_ptr(), length);
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}


/// Session-scoped storage. Values disappear when the browser tab/session ends.
public fn session_set(string key, string value) -> bool { return raz_web_session_storage_set(key, value); }
public fn session_remove(string key) -> bool { return raz_web_session_storage_remove(key); }
public fn session_clear() -> bool { return raz_web_session_storage_clear(); }
public fn session_get(string key) -> String {
    i64 length = raz_web_session_storage_value_length(key);
    if (length <= 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = raz_web_session_storage_value_write(key, value.as_ptr(), length);
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}
