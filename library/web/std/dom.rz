namespace web::std::dom;

import alloc::string;

extern fn raz_rt_cstr_ptr(string value) -> usize;

// Browser DOM ABI. Every function in this module is implemented by the tiny
// generated JavaScript host shim and called from Raz WebAssembly.
extern fn raz_web_dom_set_text(string id, string value) -> bool;
extern fn raz_web_dom_set_text_i64(string id, i64 value) -> bool;
extern fn raz_web_dom_toggle_class(string id, string class_name) -> bool;
extern fn raz_web_dom_set_text_ptr(usize id, string value) -> bool;
extern fn raz_web_dom_set_text_i64_ptr(usize id, i64 value) -> bool;
extern fn raz_web_dom_toggle_class_ptr(usize id, string class_name) -> bool;
extern fn raz_web_dom_set_attribute(string id, string name, string value) -> bool;
extern fn raz_web_dom_remove_attribute(string id, string name) -> bool;
extern fn raz_web_dom_add_class(string id, string class_name) -> bool;
extern fn raz_web_dom_remove_class(string id, string class_name) -> bool;
extern fn raz_web_dom_focus(string id) -> bool;
extern fn raz_web_dom_set_value(string id, string value) -> bool;
extern fn raz_web_dom_blur(string id) -> bool;
extern fn raz_web_dom_click(string id) -> bool;
extern fn raz_web_dom_exists(string id) -> bool;
extern fn raz_web_dom_value_length(string id) -> i64;
extern fn raz_web_dom_value_write(string id, usize output, i64 capacity) -> i64;
extern fn raz_web_dom_text_length(string id) -> i64;
extern fn raz_web_dom_text_write(string id, usize output, i64 capacity) -> i64;
extern fn raz_web_dom_attribute_length(string id, string name) -> i64;
extern fn raz_web_dom_attribute_write(string id, string name, usize output, i64 capacity) -> i64;

public struct Element {
    usize id;
}

public fn element(string id) -> Element {
    return Element { id: raz_rt_cstr_ptr(id) };
}

public impl Element {
    public fn set_text(Element& self, string value) -> bool {
        return raz_web_dom_set_text_ptr(self.id, value);
    }
    public fn set_text_i64(Element& self, i64 value) -> bool {
        return raz_web_dom_set_text_i64_ptr(self.id, value);
    }
    public fn toggle_class(Element& self, string class_name) -> bool {
        return raz_web_dom_toggle_class_ptr(self.id, class_name);
    }
}

public fn set_text(string id, string value) -> bool {
    return raz_web_dom_set_text(id, value);
}

public fn set_text_i64(string id, i64 value) -> bool {
    return raz_web_dom_set_text_i64(id, value);
}

public fn toggle_class(string id, string class_name) -> bool {
    return raz_web_dom_toggle_class(id, class_name);
}

public fn set_attribute(string id, string name, string value) -> bool {
    return raz_web_dom_set_attribute(id, name, value);
}

public fn remove_attribute(string id, string name) -> bool {
    return raz_web_dom_remove_attribute(id, name);
}

public fn add_class(string id, string class_name) -> bool {
    return raz_web_dom_add_class(id, class_name);
}

public fn remove_class(string id, string class_name) -> bool {
    return raz_web_dom_remove_class(id, class_name);
}

public fn focus(string id) -> bool {
    return raz_web_dom_focus(id);
}

/// Updates the value property of an input, textarea, or select element.
public fn set_value(string id, string value) -> bool { return raz_web_dom_set_value(id, value); }

/// Returns whether an element with the supplied id exists in the current document.
public fn exists(string id) -> bool { return raz_web_dom_exists(id); }

public fn blur(string id) -> bool { return raz_web_dom_blur(id); }
public fn click(string id) -> bool { return raz_web_dom_click(id); }


fn read_dom_value(string id, string name, i64 kind) -> String {
    i64 length = 0;
    if (kind == 0) { length = raz_web_dom_value_length(id); }
    else if (kind == 1) { length = raz_web_dom_text_length(id); }
    else { length = raz_web_dom_attribute_length(id, name); }
    if (length < 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = 0;
    if (kind == 0) { written = raz_web_dom_value_write(id, value.as_ptr(), length); }
    else if (kind == 1) { written = raz_web_dom_text_write(id, value.as_ptr(), length); }
    else { written = raz_web_dom_attribute_write(id, name, value.as_ptr(), length); }
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}

public fn value(string id) -> String { return read_dom_value(id, "", 0); }
public fn text(string id) -> String { return read_dom_value(id, "", 1); }
public fn attribute(string id, string name) -> String { return read_dom_value(id, name, 2); }
