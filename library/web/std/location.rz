namespace web::std::location;

import alloc::string;

extern fn raz_web_location_href_length() -> i64;
extern fn raz_web_location_href_write(usize output, i64 capacity) -> i64;
extern fn raz_web_location_origin_length() -> i64;
extern fn raz_web_location_origin_write(usize output, i64 capacity) -> i64;
extern fn raz_web_location_pathname_length() -> i64;
extern fn raz_web_location_pathname_write(usize output, i64 capacity) -> i64;
extern fn raz_web_location_search_length() -> i64;
extern fn raz_web_location_search_write(usize output, i64 capacity) -> i64;
extern fn raz_web_location_hash_length() -> i64;
extern fn raz_web_location_hash_write(usize output, i64 capacity) -> i64;
extern fn raz_web_location_assign(string url) -> bool;
extern fn raz_web_location_replace(string url) -> bool;
extern fn raz_web_location_reload() -> bool;

fn read_location(i64 kind) -> String {
    i64 length = 0;
    if (kind == 0) { length = raz_web_location_href_length(); }
    else if (kind == 1) { length = raz_web_location_origin_length(); }
    else if (kind == 2) { length = raz_web_location_pathname_length(); }
    else if (kind == 3) { length = raz_web_location_search_length(); }
    else { length = raz_web_location_hash_length(); }
    if (length <= 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = 0;
    if (kind == 0) { written = raz_web_location_href_write(value.as_ptr(), length); }
    else if (kind == 1) { written = raz_web_location_origin_write(value.as_ptr(), length); }
    else if (kind == 2) { written = raz_web_location_pathname_write(value.as_ptr(), length); }
    else if (kind == 3) { written = raz_web_location_search_write(value.as_ptr(), length); }
    else { written = raz_web_location_hash_write(value.as_ptr(), length); }
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}

public fn href() -> String { return read_location(0); }
public fn origin() -> String { return read_location(1); }
public fn pathname() -> String { return read_location(2); }
public fn search() -> String { return read_location(3); }
public fn hash() -> String { return read_location(4); }

public fn assign(string url) -> bool { return raz_web_location_assign(url); }
public fn replace(string url) -> bool { return raz_web_location_replace(url); }
public fn reload() -> bool { return raz_web_location_reload(); }
