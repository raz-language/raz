namespace web::std::history;

extern fn raz_web_history_push(string url) -> bool;
extern fn raz_web_history_replace(string url) -> bool;
extern fn raz_web_history_back() -> bool;
extern fn raz_web_history_forward() -> bool;

public fn push(string url) -> bool { return raz_web_history_push(url); }
public fn replace(string url) -> bool { return raz_web_history_replace(url); }
public fn back() -> bool { return raz_web_history_back(); }
public fn forward() -> bool { return raz_web_history_forward(); }
