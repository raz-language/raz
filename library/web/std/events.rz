namespace web::std::events;

import alloc::string;

/// Browser event kinds supported by the Raz web runtime. Event handlers are
/// ordinary exported Raz functions compiled into app.wasm.
public enum EventKind {
    Click,
    Input,
    Change,
    Submit,
    KeyDown,
    KeyUp,
    Focus,
    Blur,
    PointerDown,
    PointerUp,
    PointerMove,
}

public fn name(EventKind kind) -> string {
    match kind {
        EventKind::Click => { return "click"; },
        EventKind::Input => { return "input"; },
        EventKind::Change => { return "change"; },
        EventKind::Submit => { return "submit"; },
        EventKind::KeyDown => { return "keydown"; },
        EventKind::KeyUp => { return "keyup"; },
        EventKind::Focus => { return "focus"; },
        EventKind::Blur => { return "blur"; },
        EventKind::PointerDown => { return "pointerdown"; },
        EventKind::PointerUp => { return "pointerup"; },
        EventKind::PointerMove => { return "pointermove"; },
    }
}

// The generated host shim exposes the currently-dispatched DOM event only for
// the duration of the matching Raz WASM handler invocation.
extern fn raz_web_event_value_length() -> i64;
extern fn raz_web_event_value_write(usize output, i64 capacity) -> i64;
extern fn raz_web_event_key_length() -> i64;
extern fn raz_web_event_key_write(usize output, i64 capacity) -> i64;
extern fn raz_web_event_checked() -> bool;
extern fn raz_web_event_prevent_default() -> bool;
extern fn raz_web_event_code_length() -> i64;
extern fn raz_web_event_code_write(usize output, i64 capacity) -> i64;
extern fn raz_web_event_repeat() -> bool;
extern fn raz_web_event_alt_key() -> bool;
extern fn raz_web_event_ctrl_key() -> bool;
extern fn raz_web_event_shift_key() -> bool;
extern fn raz_web_event_meta_key() -> bool;
extern fn raz_web_event_button() -> i64;
extern fn raz_web_event_client_x() -> i64;
extern fn raz_web_event_client_y() -> i64;
extern fn raz_web_event_stop_propagation() -> bool;

public struct Event {
    i64 marker;
}

fn read_value() -> String {
    i64 length = raz_web_event_value_length();
    if (length <= 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = raz_web_event_value_write(value.as_ptr(), length);
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}

fn read_key() -> String {
    i64 length = raz_web_event_key_length();
    if (length <= 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = raz_web_event_key_write(value.as_ptr(), length);
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}


fn read_code() -> String {
    i64 length = raz_web_event_code_length();
    if (length <= 0) { return String::new(); }
    String value = String::with_capacity(length);
    if (!alloc::string::resize(&mut value, length, 0)) { return String::new(); }
    i64 written = raz_web_event_code_write(value.as_ptr(), length);
    if (written < 0) { return String::new(); }
    if (written < length) { alloc::string::truncate(&mut value, written); }
    return value;
}

public fn current() -> Event {
    return Event { marker: 0 };
}

public impl Event {
    public fn value(Event& self) -> String { return read_value(); }
    public fn key(Event& self) -> String { return read_key(); }
    public fn checked(Event& self) -> bool { return raz_web_event_checked(); }
    public fn prevent_default(Event&mut self) -> bool { return raz_web_event_prevent_default(); }
    public fn stop_propagation(Event&mut self) -> bool { return raz_web_event_stop_propagation(); }
}

/// Typed view over input/change events. Values are read from the currently dispatched DOM event.
public struct InputEvent { i64 marker; }
public fn current_input() -> InputEvent { return InputEvent { marker: 0 }; }
public impl InputEvent {
    public fn value(InputEvent& self) -> String { return read_value(); }
    public fn checked(InputEvent& self) -> bool { return raz_web_event_checked(); }
}

/// Typed keyboard event view with standard key/code and modifier state.
public struct KeyboardEvent { i64 marker; }
public fn current_keyboard() -> KeyboardEvent { return KeyboardEvent { marker: 0 }; }
public impl KeyboardEvent {
    public fn key(KeyboardEvent& self) -> String { return read_key(); }
    public fn code(KeyboardEvent& self) -> String { return read_code(); }
    public fn repeat(KeyboardEvent& self) -> bool { return raz_web_event_repeat(); }
    public fn alt_key(KeyboardEvent& self) -> bool { return raz_web_event_alt_key(); }
    public fn ctrl_key(KeyboardEvent& self) -> bool { return raz_web_event_ctrl_key(); }
    public fn shift_key(KeyboardEvent& self) -> bool { return raz_web_event_shift_key(); }
    public fn meta_key(KeyboardEvent& self) -> bool { return raz_web_event_meta_key(); }
}

/// Typed pointer/mouse event view. Coordinates are viewport-relative client coordinates.
public struct PointerEvent { i64 marker; }
public fn current_pointer() -> PointerEvent { return PointerEvent { marker: 0 }; }
public impl PointerEvent {
    public fn button(PointerEvent& self) -> i64 { return raz_web_event_button(); }
    public fn client_x(PointerEvent& self) -> i64 { return raz_web_event_client_x(); }
    public fn client_y(PointerEvent& self) -> i64 { return raz_web_event_client_y(); }
    public fn alt_key(PointerEvent& self) -> bool { return raz_web_event_alt_key(); }
    public fn ctrl_key(PointerEvent& self) -> bool { return raz_web_event_ctrl_key(); }
    public fn shift_key(PointerEvent& self) -> bool { return raz_web_event_shift_key(); }
    public fn meta_key(PointerEvent& self) -> bool { return raz_web_event_meta_key(); }
}

