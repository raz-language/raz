namespace web::std::encoding;

import alloc::string;

extern fn raz_rt_cstr_len(string value) -> i64;

/// Number of UTF-8 bytes in a Raz string. Raz browser strings use the same
/// UTF-8 representation passed to TextEncoder/TextDecoder at the host edge.
public fn utf8_length(string value) -> i64 { return raz_rt_cstr_len(value); }

/// Percent-encode a value using the browser's encodeURIComponent rules.
public fn uri_component(string value) -> String { return web::std::url::encode_component(value); }

/// Decode a value using the browser's decodeURIComponent rules.
public fn decode_uri_component(string value) -> String { return web::std::url::decode_component(value); }
