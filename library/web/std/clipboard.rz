namespace web::std::clipboard;

extern fn raz_web_clipboard_write(string value) -> bool;

/// Requests a browser clipboard write. Browsers can reject this when the page
/// lacks permission or the call is outside a user gesture.
public fn write_text(string value) -> bool {
    return raz_web_clipboard_write(value);
}
