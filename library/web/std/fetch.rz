namespace web::std::fetch;

import alloc::string;

/// Browser fetch handle. Response bytes and status remain owned by the Raz
/// WebAssembly instance; JavaScript is only the transport bridge.
public fn get(string url) -> web::ui::HttpRequest { return web::ui::http_get(url); }
public fn post_text(string url, string body) -> web::ui::HttpRequest { return web::ui::http_post_text(url, body); }
public fn put_text(string url, string body) -> web::ui::HttpRequest { return web::ui::http_put_text(url, body); }
public fn patch_text(string url, string body) -> web::ui::HttpRequest { return web::ui::http_patch_text(url, body); }
public fn delete(string url) -> web::ui::HttpRequest { return web::ui::http_delete(url); }

public fn valid(web::ui::HttpRequest& response) -> bool { return web::ui::http_request_valid(response); }
public fn loading(web::ui::HttpRequest& response) -> bool { return web::ui::http_request_loading(response); }
public fn done(web::ui::HttpRequest& response) -> bool { return web::ui::http_request_done(response); }
public fn failed(web::ui::HttpRequest& response) -> bool { return web::ui::http_request_failed(response); }
public fn ok(web::ui::HttpRequest& response) -> bool { return web::ui::http_request_ok(response); }
public fn status(web::ui::HttpRequest& response) -> i64 { return web::ui::http_request_status(response); }
public fn text(web::ui::HttpRequest& response) -> String { return web::ui::http_request_text(response); }


public fn resource<T>(web::ui::HttpRequest& response, T initial) -> web::ui::Resource<T> {
    return web::ui::resource(response, move initial);
}

public enum ErrorKind {
    None,
    Network,
    Redirect,
    Client,
    Server,
    OtherHttp,
}

public fn error_kind(web::ui::HttpRequest& response) -> ErrorKind {
    if (web::ui::http_request_loading(response)) { return ErrorKind::None; }
    if (web::ui::http_request_failed(response)) { return ErrorKind::Network; }
    i64 code = web::ui::http_request_status(response);
    if (code >= 300 && code < 400) { return ErrorKind::Redirect; }
    if (code >= 400 && code < 500) { return ErrorKind::Client; }
    if (code >= 500 && code < 600) { return ErrorKind::Server; }
    if (code >= 200 && code < 300) { return ErrorKind::None; }
    if (code > 0) { return ErrorKind::OtherHttp; }
    return ErrorKind::Network;
}

public fn informational(web::ui::HttpRequest& response) -> bool { i64 code = status(response); return code >= 100 && code < 200; }
public fn successful(web::ui::HttpRequest& response) -> bool { i64 code = status(response); return code >= 200 && code < 300; }
public fn redirected(web::ui::HttpRequest& response) -> bool { i64 code = status(response); return code >= 300 && code < 400; }
public fn client_error(web::ui::HttpRequest& response) -> bool { i64 code = status(response); return code >= 400 && code < 500; }
public fn server_error(web::ui::HttpRequest& response) -> bool { i64 code = status(response); return code >= 500 && code < 600; }
