namespace raz_compiler_main;
public import raz_compiler_driver_registry;
// Keep the compiler entrypoint boring: load input, run each phase in order, emit
// backend artifacts, and leave the actual language rules in the subsystem modules above.
fn main() -> i64 {
  write_stage1_diagnostic(80, 0, 0);
  if (bootstrap_qualifications_requested()) {
    if (!qualify_extended_lexer()) {
      return 39;
    }
    if (!qualify_mir_control_flow()) {
      return 47;
    }
    if (!emit_forge_cfg_qualification()) {
      return 48;
    }
    if (!qualify_mir_memory()) {
      return 49;
    }
    if (!qualify_mir_many_arguments()) {
      return 50;
    }
    if (!qualify_mir_extern_dispatch()) {
      return 51;
    }
    if (!qualify_mir_call_frame_ownership()) {
      return 54;
    }
    if (!qualify_mir_owned_aggregate()) {
      return 52;
    }
    if (!qualify_mir_owned_array()) {
      return 53;
    }
  }
  write_stage1_diagnostic(81, 0, 0);

  i64 process_argc = raz_rt_stage1_process_argc();

  if (process_argc > 32) {
    return 55;
  }

  i64 cli_command = cli_detect_command(process_argc);

  if (cli_command == 1) {
    i64 topic = cli_help_topic(process_argc);

    if (topic > 0) {
      cli_print_command_help(topic);
    } else {
      cli_print_general_help();
    }
    return 0;
  }
  if (cli_command == 2) {
    cli_print_version();
    return 0;
  }
  if (cli_command == 7) {
    cli_print_backends();
    return 0;
  }
  if (cli_command == 8) {
    cli_print_targets();
    return 0;
  }
  if (cli_command == 9) {
    cli_print_doctor();
    return 0;
  }
  if (cli_command == 13) {
    return cli_clean_project();
  }
  if (cli_command == 14) {
    return cli_init_project();
  }
  if (cli_command == 15) {
    return cli_new_project(process_argc);
  }
  if (cli_command == 18 && !cli_command_help_requested(process_argc, cli_command)) {
    return tooling_fmt_command(process_argc);
  }
  if (cli_command == 19 && !cli_command_help_requested(process_argc, cli_command)) {
    return tooling_doc_command(process_argc);
  }
  if (cli_command == 20 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_add_command(process_argc);
  }
  if (cli_command == 21 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_remove_command(process_argc);
  }
  if (cli_command == 22 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_registry_update_command();
  }
  if (cli_command == 23 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_lock_command();
  }
  if (cli_command == 24 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_metadata_command(false);
  }
  if (cli_command == 25 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_metadata_command(true);
  }
  if (cli_command == 26 && !cli_command_help_requested(process_argc, cli_command)) {
    return registry_command(process_argc);
  }
  if (cli_command == 27 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_pack_command(process_argc);
  }
  if (cli_command == 28 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_publish_command();
  }
  if (cli_command == 29 && !cli_command_help_requested(process_argc, cli_command)) {
    return signing_keygen_command(process_argc);
  }
  if (cli_command == 30 && !cli_command_help_requested(process_argc, cli_command)) {
    return package_registry_update_command();
  }
  if (cli_command_help_requested(process_argc, cli_command)) {
    cli_print_command_help(cli_command);
    return 0;
  }

  i64 backend = backend_default();

  if (cli_command == 5) {
    backend = 0;
  }
  if (cli_command == 6) {
    backend = 1;
  }

  bool forge_native = false;
  bool forge_structured_only = false;
  bool profile_queries = cli_command == 11;
  bool run_after_build = cli_command == 12;
  bool test_after_build = cli_command == 16;
  bool check_only = cli_command == 4 || cli_command == 11 || cli_command == 17;
  LlvmTargetOptions llvm_options;

  llvm_target_options_init(&mut llvm_options);

  i64 argument_base = 1;

  if (cli_command >= 3 && cli_command <= 6) {
    argument_base = 2;
  }
  if (
  cli_command == 10 ||
  cli_command == 11 ||
  cli_command == 12 ||
  cli_command == 16 ||
  cli_command == 17
  ) {
    argument_base = 2;
  }

  bool scanning_options = true;

  while (scanning_options && argument_base < process_argc) {
    i64 option_argument = raz_rt_stage1_arena_create(4096);

    if (option_argument == 0) {
      return 55;
    }

    i64 option_length = raz_rt_stage1_process_arg(argument_base, option_argument, 4096);

    if (option_length <= 0) {
      return 55;
    }

    i64 backend_shortcut = cli_backend_shortcut(option_argument, option_length);

    if (backend_shortcut >= 0) {
      backend = backend_shortcut;
      argument_base += 1;
    } else if (profile_queries_option(option_argument, option_length)) {
      profile_queries = true;
      argument_base += 1;
    } else if (forge_native_option(option_argument, option_length)) {
      forge_native = true;
      argument_base += 1;
    } else if (forge_structured_only_option(option_argument, option_length)) {
      forge_native = true;
      forge_structured_only = true;
      argument_base += 1;
    } else if (backend_option_present(option_argument, option_length)) {
      backend = backend_option_kind(option_argument, option_length);
      if (backend < 0) {
        return 55;
      }
      argument_base += 1;
    } else {
      i64 parsed_option = llvm_parse_target_option(&mut llvm_options, option_argument, option_length);

      if (parsed_option < 0) {
        return 55;
      }
      if (parsed_option > 0) {
        argument_base += 1;
      } else {
        scanning_options = false;
        raz_rt_stage1_arena_destroy(option_argument);
      }
    }
  }
  if (backend != 1 && llvm_target_options_require_llvm(&llvm_options)) {
    return 55;
  }
  if (backend != 0 && (forge_native || forge_structured_only)) {
    return 55;
  }

  i64 remaining_argc = process_argc - argument_base;

  if (remaining_argc > 2) {
    return 55;
  }
  if (
  (cli_command == 4 || cli_command == 11 || cli_command == 16 || cli_command == 17) &&
  remaining_argc > 1
  ) {
    return 55;
  }
  if (cli_command == 10 && remaining_argc != 2) {
    return 55;
  }

  i64 cli_manifest_path = 0;
  i64 cli_manifest_length = 0;
  i64 cli_output_path = 0;
  i64 cli_output_length = 0;

  if (process_argc > argument_base) {
    cli_manifest_path = raz_rt_stage1_arena_create(4096);
    if (cli_manifest_path == 0) {
      return 55;
    }
    cli_manifest_length = raz_rt_stage1_process_arg(argument_base, cli_manifest_path, 4096);
    if (cli_manifest_length <= 0) {
      return 55;
    }
  }
  if (path_is_check_option(cli_manifest_path, cli_manifest_length)) {
    if (process_argc != argument_base + 2) {
      return 55;
    }
    check_only = true;
    cli_manifest_length = raz_rt_stage1_process_arg(argument_base + 1, cli_manifest_path, 4096);
    if (cli_manifest_length <= 0) {
      return 55;
    }
  } else if (process_argc >= argument_base + 2) {
    cli_output_path = raz_rt_stage1_arena_create(4096);
    if (cli_output_path == 0) {
      return 55;
    }
    cli_output_length = raz_rt_stage1_process_arg(argument_base + 1, cli_output_path, 4096);
    if (cli_output_length <= 0) {
      return 55;
    }
  }
  if (run_after_build && cli_output_path == 0) {
    cli_output_path = raz_rt_stage1_arena_create(32);
    if (cli_output_path == 0) {
      return 40;
    }
    if (raz_rt_stage1_host_platform() == 1) {
      i64 run_name[11] = [114, 97, 122, 45, 114, 117, 110, 46, 101, 120, 101];
      i64 rn = 0;

      while (rn<11) {
        raz_rt_stage1_arena_set(cli_output_path, rn, run_name[rn]);
        rn += 1;
      }
      cli_output_length = 11;
    } else {
      i64 run_name[7] = [114, 97, 122, 45, 114, 117, 110];
      i64 rn = 0;

      while (rn<7) {
        raz_rt_stage1_arena_set(cli_output_path, rn, run_name[rn]);
        rn += 1;
      }
      cli_output_length = 7;
    }
    forge_native = backend == 0;
    if (backend == 1) {
      llvm_options.emit_kind = 2;
    }
  }

  bool direct_source = path_has_rz_extension(cli_manifest_path, cli_manifest_length);
  bool project_manifest = path_has_toml_extension(cli_manifest_path, cli_manifest_length);
  i64 manifest_capacity = 65536;
  i64 source_capacity = 4194304;
  i64 module_capacity = 4194304;
  i64 manifest_path[18] = [115, 116, 97, 103, 101, 49, 45, 112, 97, 99, 107, 97, 103, 101, 46, 116, 120, 116];
  i64 manifest = raz_rt_stage1_arena_create(manifest_capacity);

  if (manifest == 0) {
    return 40;
  }

  i64 manifest_length = 0;

  if (!direct_source && !project_manifest) {
    if (cli_manifest_path != 0) {
      manifest_length = raz_rt_stage1_read_ascii(
      cli_manifest_path,
      cli_manifest_length,
      manifest,
      manifest_capacity,
      );
    } else {
      manifest_length = raz_rt_read_ascii_i64(&mut manifest_path[0], 18, manifest, manifest_capacity);
    }
    if (manifest_length <= 0 || manifest_length >= manifest_capacity) {
      return 40;
    }
  }

  i64 bytes = raz_rt_stage1_arena_create(source_capacity);

  if (bytes == 0) {
    raz_rt_stage1_arena_destroy(manifest);
    return 40;
  }

  i64 length = 0;
  i64 cursor = 0;
  i64 module_count = 0;

  if (project_manifest) {
    write_stage1_diagnostic(82, 0, 0);

    i64 visited = raz_rt_stage1_arena_create(262144);
    i64 active = raz_rt_stage1_arena_create(262144);
    i64 project_state = raz_rt_stage1_arena_create(9);

    if (visited == 0 || active == 0 || project_state == 0) {
      return 40;
    }
    raz_rt_stage1_arena_set(project_state, 0, bytes);
    raz_rt_stage1_arena_set(project_state, 1, 0);
    raz_rt_stage1_arena_set(project_state, 2, source_capacity);
    raz_rt_stage1_arena_set(project_state, 3, module_capacity);
    raz_rt_stage1_arena_set(project_state, 4, 0);
    raz_rt_stage1_arena_set(project_state, 5, visited);
    raz_rt_stage1_arena_set(project_state, 6, 0);
    raz_rt_stage1_arena_set(project_state, 7, active);
    raz_rt_stage1_arena_set(project_state, 8, 0);
    write_stage1_diagnostic(83, 0, 0);
    if (
    cli_manifest_path == 0 ||
    !append_project_manifest(cli_manifest_path, cli_manifest_length, project_state, 0)
    ) {
      return 40;
    }
    write_stage1_diagnostic(
    84,
    raz_rt_stage1_arena_get(project_state, 4),
    raz_rt_stage1_arena_get(project_state, 1),
    );
    length = raz_rt_stage1_arena_get(project_state, 1);
    module_count = raz_rt_stage1_arena_get(project_state, 4);
    raz_rt_stage1_arena_destroy(project_state);
    raz_rt_stage1_arena_destroy(visited);
    raz_rt_stage1_arena_destroy(active);
  }
  if (direct_source) {
    i64 module_bytes = raz_rt_stage1_arena_create(module_capacity);

    if (module_bytes == 0) {
      return 40;
    }
    i64 module_length = raz_rt_stage1_read_ascii(
    cli_manifest_path,
    cli_manifest_length,
    module_bytes,
    module_capacity,
    );
    if (module_length <= 0 || module_length >= module_capacity || module_length + 1 >= source_capacity) {
      return 40;
    }
    if (raz_rt_stage1_arena_copy(bytes, length, module_bytes, 0, module_length) != module_length) {
      raz_rt_stage1_arena_destroy(module_bytes);
      return 40;
    }
    length += module_length;
    raz_rt_stage1_arena_set(bytes, length, 10);
    length += 1;
    module_count = 1;
    raz_rt_stage1_arena_destroy(module_bytes);
  }
  while (!direct_source && !project_manifest && cursor < manifest_length) {
    while (
    cursor < manifest_length &&
    (
    raz_rt_stage1_arena_get(manifest, cursor) == 10 ||
    raz_rt_stage1_arena_get(manifest, cursor) == 13 ||
    raz_rt_stage1_arena_get(manifest, cursor) == 32 ||
    raz_rt_stage1_arena_get(manifest, cursor) == 9
    )
    ) {
      cursor += 1;
    }
    if (cursor >= manifest_length) {
      cursor = manifest_length;
    } else {
      i64 path[256];
      i64 path_length = 0;

      while (
      cursor < manifest_length &&
      raz_rt_stage1_arena_get(manifest, cursor) != 10 &&
      raz_rt_stage1_arena_get(manifest, cursor) != 13
      ) {
        if (path_length >= 255) {
          return 40;
        }
        path[path_length] = raz_rt_stage1_arena_get(manifest, cursor);
        path_length += 1;
        cursor += 1;
      }
      while (path_length> 0 && (path[path_length - 1] == 32 || path[path_length - 1] == 9)) {
        path_length -= 1;
      }
      if (path_length> 0) {
        i64 module_bytes = raz_rt_stage1_arena_create(module_capacity);

        if (module_bytes == 0) {
          return 40;
        }
        i64 module_length = raz_rt_read_ascii_i64(
        &mut path[0],
        path_length,
        module_bytes,
        module_capacity,
        );
        if (
        module_length <= 0 ||
        module_length >= module_capacity ||
        length + module_length + 1 >= source_capacity
        ) {
          return 40;
        }
        if (
        raz_rt_stage1_arena_copy(bytes, length, module_bytes, 0, module_length) != module_length
        ) {
          raz_rt_stage1_arena_destroy(module_bytes);
          return 40;
        }
        length += module_length;
        raz_rt_stage1_arena_set(bytes, length, 10);
        length += 1;
        module_count += 1;
        raz_rt_stage1_arena_destroy(module_bytes);
      }
    }
  }
  if (module_count <= 0) {
    return 40;
  }
  write_stage1_diagnostic(90, module_count, length);

  Source input;

  input.bytes = bytes;
  input.length = length;
  if (
  !check_only &&
  !test_after_build &&
  !run_after_build &&
  cli_output_path != 0 &&
  incremental_try_restore_artifact(
  cli_manifest_path,
  cli_manifest_length,
  &input,
  backend,
  llvm_options.emit_kind,
  forge_native,
  forge_structured_only,
  cli_output_path,
  cli_output_length,
  )
  ) {
    write_stage1_diagnostic(96, 1, length);
    raz_rt_stage1_arena_destroy(bytes);
    raz_rt_stage1_arena_destroy(manifest);
    if (cli_manifest_path != 0) {
      raz_rt_stage1_arena_destroy(cli_manifest_path);
    }
    if (cli_output_path != 0) {
      raz_rt_stage1_arena_destroy(cli_output_path);
    }
    return 0;
  }
  // Parsing already performs the complete lexical walk and reports invalid
  // bytes. Avoid a second full-file lexer pass here: on the self-host compiler
  // this source is large and arena-backed, so the redundant preflight scan was
  // a measurable bootstrap cost with no additional correctness coverage.
  write_stage1_diagnostic(91, 0, length);
  // HIR is the sole normative Raz grammar/semantic parser. parser.rz remains
  // available as a bootstrap/preflight utility, but production compilation no
  // longer parses the source twice or lets a compact syntax subset reject a
  // construct before the authoritative frontend sees it.
  write_stage1_diagnostic(92, 0, 0);

  HirModule hir;

  if (!build_hir(input, &mut hir)) {
    write_stage1_diagnostic(2, diagnostic_code_value(hir.diagnostic_code), hir.diagnostic_offset);
    cli_render_frontend_diagnostic(&input, hir.diagnostic_code, hir.diagnostic_offset);
    return 43;
  }
  incremental_classify_module_changes(cli_manifest_path, cli_manifest_length, &mut hir);
  incremental_load_module_cache_state(cli_manifest_path, cli_manifest_length, &mut hir);
  incremental_persist_module_fingerprints(cli_manifest_path, cli_manifest_length, &hir);
  if (profile_queries) {
    write_query_profile(&hir);
  }
  if (check_only) {
    destroy_hir(&mut hir);
    raz_rt_stage1_arena_destroy(bytes);
    raz_rt_stage1_arena_destroy(manifest);
    if (cli_manifest_path != 0) {
      raz_rt_stage1_arena_destroy(cli_manifest_path);
    }
    return 0;
  }
  write_stage1_diagnostic(
  93,
  raz_rt_stage1_arena_get(hir.function_statement_counts, 0),
  raz_rt_stage1_arena_get(
  hir.statement_kinds,
  raz_rt_stage1_arena_get(hir.function_statement_starts, 0),
  ),
  );

  MirModule mir;

  if (!lower_hir(&hir, &mut mir)) {
    write_stage1_diagnostic(3, 0, 0);
    destroy_hir(&mut hir);
    return 44;
  }
  if (!run_mir_pipeline(&mut mir, llvm_options.optimization_kind)) {
    write_stage1_diagnostic(3, mir.function_count, mir.instruction_count);
    destroy_mir(&mut mir);
    destroy_hir(&mut hir);
    return 45;
  }
  incremental_persist_module_mir_state(cli_manifest_path, cli_manifest_length, &hir, &mut mir);
  write_stage1_diagnostic(94, mir.function_count, mir.instruction_count);
  if (test_after_build) {
    i64 test_status = execute_mir_tests(&input, &hir, &mut mir);

    destroy_mir(&mut mir);
    destroy_hir(&mut hir);
    raz_rt_stage1_arena_destroy(bytes);
    raz_rt_stage1_arena_destroy(manifest);
    if (cli_manifest_path != 0) {
      raz_rt_stage1_arena_destroy(cli_manifest_path);
    }
    return test_status;
  }
  if (run_after_build) {
    i64 run_status = execute_mir_main(&hir, &mut mir);

    destroy_mir(&mut mir);
    destroy_hir(&mut hir);
    raz_rt_stage1_arena_destroy(bytes);
    raz_rt_stage1_arena_destroy(manifest);
    if (cli_manifest_path != 0) {
      raz_rt_stage1_arena_destroy(cli_manifest_path);
    }
    if (cli_output_path != 0) {
      raz_rt_stage1_arena_destroy(cli_output_path);
    }
    return run_status;
  }

  i64 backend_output_path = cli_output_path;
  i64 backend_output_length = cli_output_length;
  i64 llvm_sidecar_path = 0;

  if (backend == 1 && llvm_options.emit_kind != 0) {
    if (cli_output_path == 0 || cli_output_length <= 0) {
      return 46;
    }
    llvm_sidecar_path = llvm_make_ir_sidecar(cli_output_path, cli_output_length);
    if (llvm_sidecar_path == 0) {
      return 46;
    }
    backend_output_path = llvm_sidecar_path;
    backend_output_length = cli_output_length + 3;
  }
  if (
  !emit_backend_module(
  backend,
  forge_native,
  forge_structured_only,
  &llvm_options,
  &input,
  &hir,
  &mir,
  backend_output_path,
  backend_output_length,
  )
  ) {
    return 46;
  }
  if (backend == 1 && llvm_options.emit_kind != 0) {
    if (
    !llvm_finalize_native_output(
    &llvm_options,
    backend_output_path,
    backend_output_length,
    cli_output_path,
    cli_output_length,
    )
    ) {
      return 46;
    }
  }
  incremental_store_artifact(
  cli_manifest_path,
  cli_manifest_length,
  &input,
  backend,
  llvm_options.emit_kind,
  forge_native,
  forge_structured_only,
  cli_output_path,
  cli_output_length,
  );
  write_stage1_diagnostic(95, 0, 0);
  destroy_mir(&mut mir);
  destroy_hir(&mut hir);
  raz_rt_stage1_arena_destroy(bytes);
  raz_rt_stage1_arena_destroy(manifest);
  if (cli_manifest_path != 0) {
    raz_rt_stage1_arena_destroy(cli_manifest_path);
  }
  if (llvm_sidecar_path != 0) {
    raz_rt_stage1_arena_destroy(llvm_sidecar_path);
  }
  if (cli_output_path != 0) {
    raz_rt_stage1_arena_destroy(cli_output_path);
  }
  return 0;
}
