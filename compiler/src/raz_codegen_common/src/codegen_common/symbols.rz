namespace raz_codegen_common::symbols;

public import raz_codegen_common::writer;
import frontend::parser;
import hir::core::model;

// Canonical native symbol spelling shared by native backends. This keeps ABI
// identity independent from any one backend's IR or object emitter.
fn writer_scalar_type(CodegenWriter&mut out, i64 type_kind) {
    if (type_kind == 12 || type_kind == 14) { codegen_writer_literal(out, "ptr"); return; }
    if (type_kind == 13 || hir_type_is_enum(type_kind)) { writer_i64(out); return; }
    if (type_kind == 1) { codegen_writer_literal(out, "f64"); return; }
    if (type_kind == 11) { codegen_writer_literal(out, "f32"); return; }
    i64 width = primitive_type_width(type_kind);
    if (width == 8) { codegen_writer_literal(out, "i8"); }
    else if (width == 16) { codegen_writer_literal(out, "i16"); }
    else if (width == 32) { writer_i32(out); }
    else { writer_i64(out); }
}

public fn writer_module_global_needs_identity_suffix(Source& source, HirModule& hir, i64 global_index) -> bool {
    i64 cached = raz_compiler_rt_arena_get(hir.global_identity_suffix_cache, global_index);
    if (cached != 0) {
        return cached == 2;
    }

    bool needs_suffix = false;
    if (raz_compiler_rt_arena_get(hir.global_extern_flags, global_index) == 0) {
        i64 offset = raz_compiler_rt_arena_get(hir.global_name_offsets, global_index);
        i64 length = raz_compiler_rt_arena_get(hir.global_name_lengths, global_index);
        i64 index = 0;
        while (!needs_suffix && index < hir.global_count) {
            if (
                index != global_index &&
                raz_compiler_rt_arena_get(hir.global_extern_flags, index) == 0 &&
                token_same(
                    source,
                    offset,
                    length,
                    raz_compiler_rt_arena_get(hir.global_name_offsets, index),
                    raz_compiler_rt_arena_get(hir.global_name_lengths, index),
                )
            ) {
                needs_suffix = true;
            }
            index += 1;
        }
    }

    if (needs_suffix) {
        raz_compiler_rt_arena_set(hir.global_identity_suffix_cache, global_index, 2);
    } else {
        raz_compiler_rt_arena_set(hir.global_identity_suffix_cache, global_index, 1);
    }
    return needs_suffix;
}

fn writer_structure_needs_identity_suffix(Source& source, HirModule& hir, i64 structure) -> bool {
    i64 cached = raz_compiler_rt_arena_get(hir.struct_identity_suffix_cache, structure);
    if (cached != 0) {
        return cached == 2;
    }

    i64 offset = raz_compiler_rt_arena_get(hir.struct_name_offsets, structure);
    i64 length = raz_compiler_rt_arena_get(hir.struct_name_lengths, structure);
    bool needs_suffix = false;

    if (offset >= 0 && length > 0) {
        i64 template = raz_compiler_rt_arena_get(hir.struct_generic_template_indices, structure);
        i64 index = 0;
        while (!needs_suffix && index < hir.struct_count) {
            if (index != structure) {
                i64 other_offset = raz_compiler_rt_arena_get(hir.struct_name_offsets, index);
                i64 other_length = raz_compiler_rt_arena_get(hir.struct_name_lengths, index);
                if (other_offset >= 0 && token_same(source, offset, length, other_offset, other_length)) {
                    i64 other_template = raz_compiler_rt_arena_get(hir.struct_generic_template_indices, index);
                    needs_suffix = template < 0 || other_template < 0 || template != other_template;
                }
            }
            index += 1;
        }
    }
    if (needs_suffix) {
        raz_compiler_rt_arena_set(hir.struct_identity_suffix_cache, structure, 2);
    } else {
        raz_compiler_rt_arena_set(hir.struct_identity_suffix_cache, structure, 1);
    }
    return needs_suffix;
}

public fn writer_structure_name(CodegenWriter&mut out, Source& source, HirModule& hir, i64 structure) {
    writer_text(
        out,
        source,
        raz_compiler_rt_arena_get(hir.struct_name_offsets, structure),
        raz_compiler_rt_arena_get(hir.struct_name_lengths, structure),
    );
    if (writer_structure_needs_identity_suffix(source, hir, structure)) {
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 115);
        codegen_writer_decimal(out, structure);
    }

    i64 generic_template = raz_compiler_rt_arena_get(hir.struct_generic_template_indices, structure);

    if (generic_template >= 0) {
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 103);

        i64 argument_start = raz_compiler_rt_arena_get(hir.struct_generic_argument_starts, structure);
        i64 argument_count = raz_compiler_rt_arena_get(hir.struct_generic_argument_counts, structure);

        i64 parameter_start = raz_compiler_rt_arena_get(
            hir.generic_struct_parameter_starts,
            generic_template
        );

        i64 argument = 0;

        while (argument < argument_count) {
            i64 parameter_kind = raz_compiler_rt_arena_get(
                hir.generic_parameter_kinds,
                parameter_start + argument
            );
            if (parameter_kind != 1) {
                i64 argument_structure = raz_compiler_rt_arena_get(
                    hir.struct_generic_argument_type_structs,
                    argument_start + argument,
                );
                i64 argument_type = raz_compiler_rt_arena_get(
                    hir.struct_generic_argument_types,
                    argument_start + argument,
                );
                codegen_writer_put(out, 95);
                if (argument_structure >= 0) {
                    writer_structure_name(out, source, hir, argument_structure);
                } else if (argument_structure == -2) {
                    codegen_writer_put(out, 99);
                    codegen_writer_decimal(out, argument_type);
                } else {
                    writer_scalar_type(out, argument_type);
                }
            }
            argument += 1;
        }
    }
}

fn writer_function_generic_identity(
    CodegenWriter&mut out,
    Source& source,
    HirModule& hir,
    i64 function_index,
) {
    i64 template = raz_compiler_rt_arena_get(hir.function_generic_template_indices, function_index);
    i64 argument_start = raz_compiler_rt_arena_get(hir.function_generic_argument_starts, function_index);
    i64 argument_count = raz_compiler_rt_arena_get(hir.function_generic_argument_counts, function_index);
    i64 parameter_start = raz_compiler_rt_arena_get(hir.generic_function_parameter_starts, template);
    i64 index = 0;

    while (index < argument_count) {
        i64 parameter_kind = raz_compiler_rt_arena_get(hir.generic_parameter_kinds, parameter_start + index);

        if (parameter_kind != 1) {
            i64 argument_structure = raz_compiler_rt_arena_get(
                hir.function_generic_argument_type_structs,
                argument_start + index,
            );
            i64 argument_type = raz_compiler_rt_arena_get(
                hir.function_generic_argument_types,
                argument_start + index,
            );
            codegen_writer_put(out, 95);
            if (argument_structure >= 0) {
                writer_structure_name(out, source, hir, argument_structure);
            } else if (argument_structure == -2) {
                codegen_writer_put(out, 99);
                codegen_writer_decimal(out, argument_type);
            } else {
                writer_scalar_type(out, argument_type);
            }
        }
        index += 1;
    }
}

public fn function_native_symbol_same(Source& source, HirModule& hir, i64 left, i64 right) -> bool {
    i64 left_offset = raz_compiler_rt_arena_get(hir.function_name_offsets, left);
    i64 left_length = raz_compiler_rt_arena_get(hir.function_name_lengths, left);

    if (raz_compiler_rt_arena_get(hir.function_link_name_lengths, left) > 0) {
        left_offset = raz_compiler_rt_arena_get(hir.function_link_name_offsets, left);
        left_length = raz_compiler_rt_arena_get(hir.function_link_name_lengths, left);
    }

    i64 right_offset = raz_compiler_rt_arena_get(hir.function_name_offsets, right);
    i64 right_length = raz_compiler_rt_arena_get(hir.function_name_lengths, right);

    if (raz_compiler_rt_arena_get(hir.function_link_name_lengths, right) > 0) {
        right_offset = raz_compiler_rt_arena_get(hir.function_link_name_offsets, right);
        right_length = raz_compiler_rt_arena_get(hir.function_link_name_lengths, right);
    }
    return token_same(source, left_offset, left_length, right_offset, right_length);
}

fn writer_function_needs_identity_suffix(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 cached = raz_compiler_rt_arena_get(hir.function_identity_suffix_cache, function_index);
    if (cached != 0) {
        return cached == 2;
    }

    bool needs_suffix = false;
    bool eligible =
        raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0 &&
        raz_compiler_rt_arena_get(hir.function_inherent_structs, function_index) == -1 &&
        raz_compiler_rt_arena_get(hir.function_closure_ids, function_index) < 0 &&
        raz_compiler_rt_arena_get(hir.function_drop_structs, function_index) < 0 &&
        raz_compiler_rt_arena_get(hir.function_clone_structs, function_index) < 0;

    if (eligible) {
        i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
        i64 length = raz_compiler_rt_arena_get(hir.function_name_lengths, function_index);
        bool is_main =
            length == 4 &&
            source_byte(source, offset) == 109 &&
            source_byte(source, offset + 1) == 97 &&
            source_byte(source, offset + 2) == 105 &&
            source_byte(source, offset + 3) == 110;

        if (!is_main) {
            i64 template = raz_compiler_rt_arena_get(hir.function_generic_template_indices, function_index);
            i64 index = 0;
            while (!needs_suffix && index < hir.function_count) {
                if (
                    index != function_index &&
                    raz_compiler_rt_arena_get(hir.function_is_extern, index) == 0 &&
                    raz_compiler_rt_arena_get(hir.function_inherent_structs, index) == -1 &&
                    raz_compiler_rt_arena_get(hir.function_closure_ids, index) < 0 &&
                    raz_compiler_rt_arena_get(hir.function_drop_structs, index) < 0 &&
                    raz_compiler_rt_arena_get(hir.function_clone_structs, index) < 0
                ) {
                    i64 other_offset = raz_compiler_rt_arena_get(hir.function_name_offsets, index);
                    i64 other_length = raz_compiler_rt_arena_get(hir.function_name_lengths, index);
                    if (token_same(source, offset, length, other_offset, other_length)) {
                        i64 other_template = raz_compiler_rt_arena_get(hir.function_generic_template_indices, index);
                        needs_suffix = template < 0 || other_template < 0 || template != other_template;
                    }
                }
                index += 1;
            }
        }
    }

    if (needs_suffix) {
        raz_compiler_rt_arena_set(hir.function_identity_suffix_cache, function_index, 2);
    } else {
        raz_compiler_rt_arena_set(hir.function_identity_suffix_cache, function_index, 1);
    }
    return needs_suffix;
}

fn writer_function_package_namespace_identity(CodegenWriter&mut out, HirModule& hir, i64 function_index) {
    i64 module_id = raz_compiler_rt_arena_get(hir.incremental_function_module_ids, function_index);
    i64 package_hash = 0;
    i64 namespace_hash = 0;
    i64 module = 0;
    while (module < hir.incremental_module_fingerprint_count) {
        if (raz_compiler_rt_arena_get(hir.incremental_module_ids, module) == module_id) {
            package_hash = raz_compiler_rt_arena_get(hir.incremental_module_package_hashes, module);
            namespace_hash = raz_compiler_rt_arena_get(hir.incremental_module_namespace_hashes, module);
            module = hir.incremental_module_fingerprint_count;
        } else { module += 1; }
    }
    codegen_writer_put(out, 95); codegen_writer_put(out, 112); codegen_writer_decimal(out, package_hash);
    codegen_writer_put(out, 95); codegen_writer_put(out, 110); codegen_writer_decimal(out, namespace_hash);
}

public fn writer_function_name(CodegenWriter&mut out, Source& source, HirModule& hir, i64 function_index) {
    codegen_writer_put(out, 64);
    if (raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0) {
        if (raz_compiler_rt_arena_get(hir.function_link_name_lengths, function_index) > 0) {
            writer_text(
                out,
                source,
                raz_compiler_rt_arena_get(hir.function_link_name_offsets, function_index),
                raz_compiler_rt_arena_get(hir.function_link_name_lengths, function_index),
            );
        } else {
            writer_text(
                out,
                source,
                raz_compiler_rt_arena_get(hir.function_name_offsets, function_index),
                raz_compiler_rt_arena_get(hir.function_name_lengths, function_index),
            );
        }
        return;
    }
    // Explicit C-ABI Raz definitions live in the platform symbol namespace.
    // Normal Raz definitions remain mangled below so ordinary public helpers
    // cannot interpose libc/OS symbols accidentally.  @link_name remains the
    // strongest spelling override for an explicitly exported definition.
    i64 definition_link_name_length = raz_compiler_rt_arena_get(
        hir.function_link_name_lengths,
        function_index
    );
    if (definition_link_name_length > 0) {
        writer_text(
            out,
            source,
            raz_compiler_rt_arena_get(hir.function_link_name_offsets, function_index),
            definition_link_name_length,
        );
        return;
    }
    if (raz_compiler_rt_arena_get(hir.function_abi_kinds, function_index) == 1) {
        writer_text(
            out,
            source,
            raz_compiler_rt_arena_get(hir.function_name_offsets, function_index),
            raz_compiler_rt_arena_get(hir.function_name_lengths, function_index),
        );
        return;
    }

    i64 drop_structure = raz_compiler_rt_arena_get(hir.function_drop_structs, function_index);
    i64 clone_structure = raz_compiler_rt_arena_get(hir.function_clone_structs, function_index);
    i64 closure_id = raz_compiler_rt_arena_get(hir.function_closure_ids, function_index);
    i64 generic_template = raz_compiler_rt_arena_get(hir.function_generic_template_indices, function_index);

    if (closure_id >= 0) {
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 122);
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 99);
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 117);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 101);
        codegen_writer_put(out, 95);
        codegen_writer_decimal(out, closure_id);
    } else if (drop_structure >= 0) {
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 122);
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 100);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 112);
        codegen_writer_put(out, 95);
        writer_structure_name(out, source, hir, drop_structure);
    } else if (clone_structure >= 0) {
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 122);
        codegen_writer_put(out, 95);
        codegen_writer_put(out, 99);
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 110);
        codegen_writer_put(out, 101);
        codegen_writer_put(out, 95);
        writer_structure_name(out, source, hir, clone_structure);
    } else {
        i64 function_name_offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
        i64 function_name_length = raz_compiler_rt_arena_get(hir.function_name_lengths, function_index);

        if (
            function_name_length == 4 &&
            source_byte(source, function_name_offset) == 109 &&
            source_byte(source, function_name_offset + 1) == 97 &&
            source_byte(source, function_name_offset + 2) == 105 &&
            source_byte(source, function_name_offset + 3) == 110
        ) {
            // Keep the Raz language entry distinct from the C ABI main. The
            // generated C entry delegates through `_raz_entry`, which owns
            // module-global initialization/finalization.
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 114);
            codegen_writer_put(out, 97);
            codegen_writer_put(out, 122);
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 109);
            codegen_writer_put(out, 97);
            codegen_writer_put(out, 105);
            codegen_writer_put(out, 110);
        } else {
            // Raz-defined functions use an internal native namespace. Keeping
            // source names out of the platform symbol namespace prevents public
            // library helpers such as `close`, `read`, and `write` from
            // interposing libc/OS entry points used by the runtime itself.
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 114);
            codegen_writer_put(out, 97);
            codegen_writer_put(out, 122);
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 102);
            codegen_writer_put(out, 110);
            codegen_writer_put(out, 95);
            writer_text(out, source, function_name_offset, function_name_length);
            if (writer_function_needs_identity_suffix(source, hir, function_index)) {
                writer_function_package_namespace_identity(out, hir, function_index);
            }
        }

        i64 inherent_structure = raz_compiler_rt_arena_get(hir.function_inherent_structs, function_index);

        if (inherent_structure != -1) {
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 105);
            codegen_writer_put(out, 95);
            if (inherent_structure >= 0) {
                writer_structure_name(out, source, hir, inherent_structure);
            } else if (hir_method_target_is_scalar(inherent_structure)) {
                codegen_writer_put(out, 116);
                codegen_writer_decimal(out, hir_method_target_scalar_type(inherent_structure));
            } else {
                codegen_writer_put(out, 101);
                codegen_writer_decimal(out, -2 - inherent_structure);
            }
        }
        if (generic_template >= 0) {
            codegen_writer_put(out, 95);
            codegen_writer_put(out, 103);
            writer_function_generic_identity(out, source, hir, function_index);
        }
    }
}

public fn writer_async_function_name(
    CodegenWriter&mut out,
    Source& source,
    HirModule& hir,
    i64 function_index,
    i64 suffix,
) {
    writer_function_name(out, source, hir, function_index);
    if (suffix == 1) {
        codegen_writer_literal(out, "__async_new");
    } else if (suffix == 2) {
        codegen_writer_literal(out, "__async_poll");
    } else if (suffix == 3) {
        string text = "__async_drop";
        i64 i = 0;

        while (i < 12) {
            codegen_writer_put(out, compiler_literal_byte(text, i));
            i += 1;
        }
    }
}
