namespace raz_codegen_common::abi;

// Compiler-host ABI used by native textual backends during final emission/link.
// Keep these declarations backend-neutral so LLVM does not inherit them from Forge.
public extern fn raz_rt_write_ascii_i64(i64&mut path, i64 path_length, i64 data, i64 size) -> i64;
public extern fn raz_compiler_runtime_library_path_i64(i64 output, i64 capacity) -> i64;
public extern fn raz_compiler_runtime_link_args_i64(i64 output, i64 capacity) -> i64;
