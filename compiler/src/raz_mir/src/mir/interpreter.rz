public fn qualify_mir_compact_array_references() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 1;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 0);

    i64 storage = mir_emit(&mut mir, 30, 4, 2, -1, 5);
    i64 zero = mir_emit_typed(&mut mir, 1, 0, 0, 0, 0, 0);
    i64 two = mir_emit_typed(&mut mir, 1, 2, 0, 0, 0, 0);
    i64 reference = mir_emit_typed(&mut mir, 45, storage, zero, 1, 0, 12);
    i64 offset_reference = mir_emit_typed(&mut mir, 4, reference, two, 0, 0, 12);
    i64 value = mir_emit_typed(&mut mir, 1, 90, 0, 0, 0, 5);

    mir_emit_typed(&mut mir, 27, offset_reference, value, 0, 0, 5);

    i64 through_pointer = mir_emit_typed(&mut mir, 26, offset_reference, 0, 0, 0, 5);
    i64 through_array = mir_emit_typed(&mut mir, 28, storage, two, 0, 0, 5);
    i64 sum = mir_emit_typed(&mut mir, 4, through_pointer, through_array, 0, 0, 0);

    mir_emit(&mut mir, 31, storage, 0, 0, 0);
    mir_emit(&mut mir, 10, sum, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);

    i64 result = execute_mir_function(&mir, 0, 0, 0, 0);

    destroy_mir(&mut mir);
    return result == 180;
}

public fn execute_mir_main(HirModule& hir, MirModule& mir) -> i64 {
    i64 index = 0;

    while (index < hir.function_count) {
        if (raz_compiler_rt_arena_get(hir.function_name_lengths, index) == 4) {
            return execute_mir_function(mir, index, 0, 0, 0);
        }
        index += 1;
    }
    return -1;
}

// compiler candidate-owned Forge text emission and source-file driver.
fn mir_bench_write_literal(string text) {
    i64 length = compiler_literal_length(text);

    if (length <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, compiler_literal_byte(text, i));
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn mir_bench_write_i64(i64 value) {
    i64 bytes = raz_compiler_rt_arena_create(32);

    if (bytes == 0) {
        return;
    }

    i64 cursor = 0;
    i64 magnitude = value;

    if (value < 0) {
        raz_compiler_rt_arena_set(bytes, cursor, 45);
        cursor += 1;
        if (value == (-9223372036854775807 - 1)) {
            string literal = "9223372036854775808";
            i64 i = 0;

            while (i < 19) {
                raz_compiler_rt_arena_set(bytes, cursor, compiler_literal_byte(literal, i));
                cursor += 1;
                i += 1;
            }
            raz_compiler_rt_stdio_write_ascii(1, bytes, cursor);
            raz_compiler_rt_arena_destroy(bytes);
            return;
        }
        magnitude = -value;
    }

    i64 digits = raz_compiler_rt_arena_create(24);

    if (digits == 0) {
        raz_compiler_rt_arena_destroy(bytes);
        return;
    }

    i64 count = 0;

    if (magnitude == 0) {
        raz_compiler_rt_arena_set(digits, count, 48);
        count = 1;
    } else {
        while (magnitude > 0) {
            raz_compiler_rt_arena_set(digits, count, 48 + magnitude % 10);
            count += 1;
            magnitude = magnitude / 10;
        }
    }

    i64 i = count;

    while (i > 0) {
        i -= 1;
        raz_compiler_rt_arena_set(bytes, cursor, raz_compiler_rt_arena_get(digits, i));
        cursor += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, bytes, cursor);
    raz_compiler_rt_arena_destroy(digits);
    raz_compiler_rt_arena_destroy(bytes);
}

public fn execute_mir_benches(Source& input, HirModule& hir, MirModule& mir, i64 iterations) -> i64 {
    if (iterations <= 0) {
        return 57;
    }

    i64 index = 0;
    i64 discovered = 0;

    while (index < hir.function_count) {
        i64 length = raz_compiler_rt_arena_get(hir.function_name_lengths, index);
        i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, index);

        bool bench_name =
            length >= 6 &&
            raz_compiler_rt_arena_get(input.bytes, offset) == 98 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 1) == 101 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 2) == 110 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 3) == 99 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 4) == 104 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 5) == 95;
        if (bench_name && raz_compiler_rt_arena_get(hir.function_is_extern, index) == 0) {
            if (raz_compiler_rt_arena_get(hir.function_parameter_counts, index) != 0) {
                return 57;
            }
            discovered += 1;
            // Warm once so one-time interpreter/table initialization is not part of the sample.

            i64 warm = execute_mir_function(mir, index, 0, 0, 0);

            if (warm != 0) {
                return warm;
            }

            i64 start = raz_compiler_rt_monotonic_nanos();
            i64 iteration = 0;

            while (iteration < iterations) {
                i64 status = execute_mir_function(mir, index, 0, 0, 0);

                if (status != 0) {
                    return status;
                }
                iteration += 1;
            }

            i64 elapsed = raz_compiler_rt_monotonic_nanos() - start;
            i64 ns_per_op = elapsed / iterations;

            mir_bench_write_literal("bench ");

            i64 name = raz_compiler_rt_arena_create(length);

            if (name == 0) {
                return 40;
            }
            raz_compiler_rt_arena_copy(name, 0, input.bytes, offset, length);
            raz_compiler_rt_stdio_write_ascii(1, name, length);
            raz_compiler_rt_arena_destroy(name);
            mir_bench_write_literal("  ");
            mir_bench_write_i64(ns_per_op);
            mir_bench_write_literal(" ns/op\n");
        }
        index += 1;
    }
    if (discovered == 0) {
        mir_bench_write_literal("no bench_ functions discovered\n");
    }
    return 0;
}

fn mir_test_name_matches_filter(
    Source& input,
    i64 name_offset,
    i64 name_length,
    i64 filter,
    i64 filter_length,
) -> bool {
    if (filter_length <= 0) {
        return true;
    }
    if (filter == 0 || filter_length > name_length) {
        return false;
    }

    i64 start = 0;

    while (start <= name_length - filter_length) {
        i64 i = 0;

        while (
            i < filter_length &&
            raz_compiler_rt_arena_get(
                input.bytes,
                name_offset + start + i
            ) == raz_compiler_rt_arena_get(filter, i)
        ) {
            i += 1;
        }
        if (i == filter_length) {
            return true;
        }
        start += 1;
    }
    return false;
}

fn mir_test_write_name(Source& input, i64 offset, i64 length) {
    if (length <= 0) {
        return;
    }

    i64 name = raz_compiler_rt_arena_create(length);

    if (name == 0) {
        return;
    }
    raz_compiler_rt_arena_copy(name, 0, input.bytes, offset, length);
    raz_compiler_rt_stdio_write_ascii(1, name, length);
    raz_compiler_rt_arena_destroy(name);
}

public fn execute_mir_tests(Source& input, HirModule& hir, MirModule& mir, i64 filter, i64 filter_length, ) -> i64 {
    i64 index = 0;
    i64 discovered = 0;
    i64 passed = 0;
    i64 failed = 0;
    i64 first_failure = 0;

    while (index < hir.function_count) {
        i64 length = raz_compiler_rt_arena_get(hir.function_name_lengths, index);
        i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, index);

        bool test_name =
            length >= 5 &&
            raz_compiler_rt_arena_get(input.bytes, offset) == 116 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 1) == 101 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 2) == 115 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 3) == 116 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 4) == 95;
        if (
            test_name &&
            raz_compiler_rt_arena_get(hir.function_is_extern, index) == 0 &&
            mir_test_name_matches_filter(input, offset, length, filter, filter_length)
        ) {
            if (raz_compiler_rt_arena_get(hir.function_parameter_counts, index) != 0) {
                return 57;
            }
            discovered += 1;
            mir_bench_write_literal("test ");
            mir_test_write_name(input, offset, length);
            mir_bench_write_literal(" ... ");

            i64 status = execute_mir_function(mir, index, 0, 0, 0);

            if (status == 0) {
                mir_bench_write_literal("ok\n");
                passed += 1;
            } else {
                mir_bench_write_literal("FAILED (status ");
                mir_bench_write_i64(status);
                mir_bench_write_literal(")\n");
                failed += 1;
                if (first_failure == 0) {
                    first_failure = status;
                }
            }
        }
        index += 1;
    }
    if (discovered == 0) {
        if (filter_length > 0) {
            mir_bench_write_literal("no tests matched the filter\n");
        } else {
            mir_bench_write_literal("no test_ functions discovered");
            mir_bench_write_literal("\n");
        }
        return 0;
    }
    mir_bench_write_literal("test result: ");
    mir_bench_write_i64(passed);
    mir_bench_write_literal(" passed; ");
    mir_bench_write_i64(failed);
    mir_bench_write_literal(" failed\n");
    return first_failure;
}
