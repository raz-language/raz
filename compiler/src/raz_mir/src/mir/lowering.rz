            i64 iterator_loop = raz_compiler_rt_arena_get(hir.statement_b, cursor);
            i64 body = raz_compiler_rt_arena_get(hir.statement_c, cursor);
            i64 iterator_slot = raz_compiler_rt_arena_get(hir.node_values, iterator_loop);
            i64 iterator_value = lower_hir_expression(
                hir,
                out,
                raz_compiler_rt_arena_get(hir.node_a, iterator_loop),
            );
