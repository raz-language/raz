            }
            i64 increment_label = mir_emit(out, 24, 0, 0, 0, 0);
            if (!hir_statement_range_terminates(hir, body_start, body_end)) {
                i64 loaded = mir_emit_typed(out, 3, slot, 0, 0, 0, range_type);
                i64 one = mir_emit_typed(out, 1, 1, 0, 0, 0, range_type);
                i64 next_value = mir_emit_typed(out, 4, loaded, one, 0, 0, range_type);
                mir_emit_typed(out, 9, slot, next_value, 0, 0, range_type);
                mir_emit(out, 22, 0, loop_label, -1, 0);
            } else {
                // A continue terminator still needs the induction update.
                i64 patch_cursor = body_instruction_start;
                bool has_continue = false;
                while (patch_cursor < increment_label) {
                    if (
                        raz_compiler_rt_arena_get(out.opcodes, patch_cursor) == 22 &&
                        raz_compiler_rt_arena_get(out.op_b, patch_cursor) == -3
                    ) {
                        has_continue = true;
                    }
                    patch_cursor += 1;
                }
                if (has_continue) {
                    i64 loaded = mir_emit_typed(out, 3, slot, 0, 0, 0, range_type);
                    i64 one = mir_emit_typed(out, 1, 1, 0, 0, 0, range_type);
                    i64 next_value = mir_emit_typed(out, 4, loaded, one, 0, 0, range_type);
                    mir_emit_typed(out, 9, slot, next_value, 0, 0, range_type);
                    mir_emit(out, 22, 0, loop_label, -1, 0);
                }
            }
            i64 exit_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 patch = body_instruction_start;
            while (patch < exit_label) {
                if (raz_compiler_rt_arena_get(out.opcodes, patch) == 22) {
                    i64 target = raz_compiler_rt_arena_get(out.op_b, patch);
                    if (target == -2) {
                        if (!mir_patch_target(out, patch, exit_label)) {
                            return false;
                        }
                    } else if (target == -3) {
                        if (!mir_patch_target(out, patch, increment_label)) {
                            return false;
                        }
                    }
                }
                patch += 1;
            }
            if (
                !mir_patch_operand(out, branch, 1, exit_label) ||
                !mir_patch_operand(out, branch, 2, body_label)
            ) {
                return false;
            }
        } else if (kind == 6) {
            i64 loop_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 condition = lower_hir_expression(
                hir,
                out,
                raz_compiler_rt_arena_get(hir.statement_a, cursor)
            );
            i64 branch = mir_emit(out, 23, condition, -1, -1, -1);
            i64 body_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 body_instruction_start = out.instruction_count;
            i64 body = raz_compiler_rt_arena_get(hir.statement_b, cursor);
            i64 body_start = raz_compiler_rt_arena_get(hir.block_statement_starts, body);
            i64 body_end = body_start + raz_compiler_rt_arena_get(hir.block_statement_counts, body);
            i64 nested_start = raz_compiler_rt_arena_get(hir.block_statement_starts, body);
            i64 nested_end = nested_start + raz_compiler_rt_arena_get(hir.block_statement_counts, body);
            if (
                !lower_hir_statement_range(
                    hir,
                    out,
                    nested_start,
                    nested_end,
                    raz_compiler_rt_arena_get(hir.block_defer_starts, body),
                    raz_compiler_rt_arena_get(hir.block_defer_counts, body),
                )
            ) {
                return false;
            }
            if (!hir_statement_range_terminates(hir, body_start, body_end)) {
                mir_emit(out, 22, 0, loop_label, -1, 0);
            }
            i64 exit_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 patch = body_instruction_start;
            while (patch < exit_label) {
                if (raz_compiler_rt_arena_get(out.opcodes, patch) == 22) {
                    i64 target = raz_compiler_rt_arena_get(out.op_b, patch);
                    if (target == -2) {
                        if (!mir_patch_target(out, patch, exit_label)) {
                            return false;
                        }
                    } else if (target == -3) {
                        if (!mir_patch_target(out, patch, loop_label)) {
                            return false;
                        }
                    }
                }
                patch += 1;
            }
            if (
                !mir_patch_operand(out, branch, 1, exit_label) ||
                !mir_patch_operand(out, branch, 2, body_label)
            ) {
                return false;
            }
        } else if (kind == 7) {
            i64 condition = lower_hir_expression(
                hir,
                out,
                raz_compiler_rt_arena_get(hir.statement_a, cursor)
            );
            i64 branch = mir_emit(out, 23, condition, -1, -1, -1);
            i64 then_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 then_block = raz_compiler_rt_arena_get(hir.statement_b, cursor);
            i64 then_start = raz_compiler_rt_arena_get(hir.block_statement_starts, then_block);
            i64 then_end = then_start + raz_compiler_rt_arena_get(hir.block_statement_counts, then_block);
            i64 nested_start = raz_compiler_rt_arena_get(hir.block_statement_starts, then_block);
            i64 nested_end = nested_start + raz_compiler_rt_arena_get(hir.block_statement_counts, then_block);
            if (
                !lower_hir_statement_range(
                    hir,
                    out,
                    nested_start,
                    nested_end,
                    raz_compiler_rt_arena_get(hir.block_defer_starts, then_block),
                    raz_compiler_rt_arena_get(hir.block_defer_counts, then_block),
                )
            ) {
                return false;
            }
            bool then_terminates = hir_statement_range_terminates(hir, then_start, then_end);
            i64 then_jump = -1;
            if (!then_terminates) {
                then_jump = mir_emit(out, 22, 0, -1, -1, 0);
            }
            i64 else_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 else_block = raz_compiler_rt_arena_get(hir.statement_c, cursor);
            if (else_block >= 0) {
                i64 else_start = raz_compiler_rt_arena_get(hir.block_statement_starts, else_block);
                i64 else_end = else_start + raz_compiler_rt_arena_get(hir.block_statement_counts, else_block);
                i64 nested_start = raz_compiler_rt_arena_get(hir.block_statement_starts, else_block);
                i64 nested_end =
                    nested_start +
                    raz_compiler_rt_arena_get(hir.block_statement_counts, else_block);
                if (
                    !lower_hir_statement_range(
                        hir,
                        out,
                        nested_start,
                        nested_end,
                        raz_compiler_rt_arena_get(hir.block_defer_starts, else_block),
                        raz_compiler_rt_arena_get(hir.block_defer_counts, else_block),
                    )
                ) {
                    return false;
                }
            }
            i64 merge_label = mir_emit(out, 24, 0, 0, 0, 0);
            if (
                !mir_patch_operand(out, branch, 1, else_label) ||
                !mir_patch_operand(out, branch, 2, then_label)
            ) {
                return false;
            }
            if (then_jump >= 0 && !mir_patch_target(out, then_jump, merge_label)) {
                return false;
            }
        } else {
            i64 condition = lower_hir_expression(
                hir,
                out,
                raz_compiler_rt_arena_get(hir.statement_a, cursor)
            );
            i64 then_value = lower_hir_expression(
                hir,
                out,
                raz_compiler_rt_arena_get(hir.statement_b, cursor)
            );
            i64 else_value = lower_hir_expression(
                hir,
                out,
                raz_compiler_rt_arena_get(hir.statement_c, cursor)
            );
            i64 selected = mir_emit(out, 17, condition, then_value, else_value, 0);
            mir_emit(out, 10, selected, 0, 0, 0);
        }
        if (kind == 2 || kind == 3 || kind == 11 || kind == 12) {
            return true;
        }
        if (kind == 7) {
            i64 terminating_then = raz_compiler_rt_arena_get(hir.statement_b, cursor);
            i64 terminating_else = raz_compiler_rt_arena_get(hir.statement_c, cursor);
            if (terminating_else >= 0) {
                i64 terminating_then_start = raz_compiler_rt_arena_get(
                    hir.block_statement_starts,
                    terminating_then,
                );
                i64 terminating_then_end =
                    terminating_then_start +
                    raz_compiler_rt_arena_get(hir.block_statement_counts, terminating_then);
                i64 terminating_else_start = raz_compiler_rt_arena_get(
                    hir.block_statement_starts,
                    terminating_else,
                );
                i64 terminating_else_end =
                    terminating_else_start +
                    raz_compiler_rt_arena_get(hir.block_statement_counts, terminating_else);
                if (
                    hir_statement_range_terminates(hir, terminating_then_start, terminating_then_end) &&
                    hir_statement_range_terminates(hir, terminating_else_start, terminating_else_end)
                ) {
                    return true;
                }
            }
        }
        cursor += 1;
    }
    i64 cleanup_remaining = scope_defer_count;
    while (cleanup_remaining > 0) {
        cleanup_remaining -= 1;
        i64 deferred_block = raz_compiler_rt_arena_get(
            hir.defer_blocks,
            scope_defer_start + cleanup_remaining
        );
        i64 deferred_start = raz_compiler_rt_arena_get(hir.block_statement_starts, deferred_block);
        i64 deferred_end =
            deferred_start +
            raz_compiler_rt_arena_get(hir.block_statement_counts, deferred_block);
        if (
            !lower_hir_statement_range(
                hir,
                out,
                deferred_start,
                deferred_end,
                raz_compiler_rt_arena_get(hir.block_defer_starts, deferred_block),
                raz_compiler_rt_arena_get(hir.block_defer_counts, deferred_block),
            )
        ) {
            return false;
        }
    }
    if (!hir_statement_range_terminates(hir, range_start, end)) {
        i64 scope_function = -1;
        i64 scope_block = -1;
        if (range_start < end) {
            scope_function = raz_compiler_rt_arena_get(hir.statement_function_indices, range_start);
            scope_block = raz_compiler_rt_arena_get(hir.statement_block_indices, range_start);
        }
        if (
            scope_function >= 0 &&
            !lower_hir_emit_scope_drops(hir, out, scope_function, scope_block, 0, -1, -1)
        ) {
            return false;
        }
        if (
            scope_function >= 0 &&
            scope_block < 0 &&
            !lower_hir_emit_parameter_drops(hir, out, scope_function, 0, -1)
        ) {
            return false;
        }
    }
    return true;
}

fn lower_hir_spill_parameters(HirModule& hir, MirModule&mut out, i64 function_index) -> bool {
    i64 declared_local_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);
    i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);
    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);
    out.lowering_parameter_local_base = declared_local_count;
    out.lowering_parameter_start = parameter_start;
    out.lowering_function_index = function_index;
    bool has_mutated_parameter = false;
    i64 parameter = 0;
    while (parameter < parameter_count) {
        if (raz_compiler_rt_arena_get(hir.parameter_mutated, parameter_start + parameter) != 0) {
            has_mutated_parameter = true;
        }
        parameter += 1;
    }
    if (has_mutated_parameter) {
        raz_compiler_rt_arena_set(
            out.function_local_counts,
            function_index,
            declared_local_count + parameter_count,
        );
    } else {
        raz_compiler_rt_arena_set(out.function_local_counts, function_index, declared_local_count);
    }
    if (raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0 || !has_mutated_parameter) {
        return true;
    }
    parameter = 0;
    while (parameter < parameter_count) {
        if (raz_compiler_rt_arena_get(hir.parameter_mutated, parameter_start + parameter) != 0) {
            i64 type_kind = raz_compiler_rt_arena_get(hir.parameter_types, parameter_start + parameter);
            if (raz_compiler_rt_arena_get(hir.parameter_references, parameter_start + parameter) != 0) {
                type_kind = 12;
            }
            i64 incoming = mir_emit_typed(out, 2, parameter, 0, 0, 0, type_kind);
            mir_emit_typed(out, 9, declared_local_count + parameter, incoming, 0, 0, type_kind);
        }
        parameter += 1;
    }
    return true;
}

fn mir_materialize_static_global_value(HirModule& hir, i64 node) -> i64 {
    if (node < 0) {
        return 0;
    }
    i64 kind = raz_compiler_rt_arena_get(hir.node_kinds, node);
    if (kind == 1 || kind == 30 || kind == 47) {
        return raz_compiler_rt_arena_get(hir.node_values, node);
    }
    if (kind == 53 || kind == 34) {
        i64 argument_start = raz_compiler_rt_arena_get(hir.node_a, node);
        i64 argument_count = raz_compiler_rt_arena_get(hir.node_b, node);
        if (kind == 34) {
            argument_start = raz_compiler_rt_arena_get(hir.node_b, node);
            argument_count = raz_compiler_rt_arena_get(hir.node_c, node);
        }
        i64 storage = raz_compiler_rt_arena_create(argument_count);
        if (storage == 0) {
            return 0;
        }
        i64 argument = 0;
        while (argument < argument_count) {
            i64 child = raz_compiler_rt_arena_get(hir.arguments, argument_start + argument);
            raz_compiler_rt_arena_set(storage, argument, mir_materialize_static_global_value(hir, child));
            argument += 1;
        }
        return storage;
    }
    return 0;
}

public fn lower_hir(HirModule& hir, MirModule&mut out) -> bool {
    if (!init_mir(out)) {
        return false;
    }
    out.function_count = hir.function_count;
    out.global_count = hir.global_count;
    out.module_count = hir.incremental_module_fingerprint_count;
    if (!lower_hir_prepare_cleanup_indexes(hir, out)) {
        return false;
    }
    i64 module_index = 0;
    while (module_index < out.module_count) {
        raz_compiler_rt_arena_set(
            out.module_ids,
            module_index,
            raz_compiler_rt_arena_get(hir.incremental_module_ids, module_index),
        );
        raz_compiler_rt_arena_set(
            out.module_function_starts,
            module_index,
            raz_compiler_rt_arena_get(hir.incremental_module_function_starts, module_index),
        );
        raz_compiler_rt_arena_set(
            out.module_function_counts,
            module_index,
            raz_compiler_rt_arena_get(hir.incremental_module_function_counts, module_index),
        );
        module_index += 1;
    }
    i64 module_function_index = 0;
    while (module_function_index < hir.function_count) {
        raz_compiler_rt_arena_set(
            out.module_function_indices,
            module_function_index,
            raz_compiler_rt_arena_get(hir.incremental_module_function_indices, module_function_index),
        );
        module_function_index += 1;
    }
    i64 global_index = 0;
    while (global_index < hir.global_count) {
        i64 external_global = raz_compiler_rt_arena_get(hir.global_extern_flags, global_index);
        raz_compiler_rt_arena_set(out.global_extern_flags, global_index, external_global);
        i64 initial_value = 0;
        if (external_global == 0) {
            i64 initializer = raz_compiler_rt_arena_get(hir.global_initializer_nodes, global_index);
            if (initializer >= 0) {
                initial_value = mir_materialize_static_global_value(hir, initializer);
            }
        }
        raz_compiler_rt_arena_set(out.global_values, global_index, initial_value);
        global_index += 1;
    }
    if (
        hir.function_count == 1 &&
        !mir_function_needs_drop_cleanup(out, 0) &&
        raz_compiler_rt_arena_get(hir.function_statement_counts, 0) == 1 &&
        raz_compiler_rt_arena_get(hir.function_defer_counts, 0) == 0
    ) {
        i64 direct_statement = raz_compiler_rt_arena_get(hir.function_statement_starts, 0);
        if (raz_compiler_rt_arena_get(hir.statement_kinds, direct_statement) == 2) {
            raz_compiler_rt_arena_set(out.function_instruction_starts, 0, out.instruction_count);
            raz_compiler_rt_arena_set(
                out.function_module_ids,
                0,
                raz_compiler_rt_arena_get(hir.incremental_function_module_ids, 0),
            );
            raz_compiler_rt_arena_set(
                out.function_parameter_counts,
                0,
                raz_compiler_rt_arena_get(hir.function_parameter_counts, 0),
            );
            raz_compiler_rt_arena_set(
                out.function_is_extern,
                0,
                raz_compiler_rt_arena_get(hir.function_is_extern, 0),
            );
            raz_compiler_rt_arena_set(
                out.function_extern_kinds,
                0,
                raz_compiler_rt_arena_get(hir.function_extern_kinds, 0),
            );
            if (!lower_hir_spill_parameters(hir, out, 0)) {
                return false;
            }
            i64 direct_return_node = raz_compiler_rt_arena_get(hir.statement_a, direct_statement);
            i64 direct_return_opcode = 21;
            i64 direct_return_operand = 0;
            if (direct_return_node >= 0) {
                direct_return_opcode = 10;
                direct_return_operand = lower_hir_expression(hir, out, direct_return_node);
            }
            i64 direct_terminator = mir_emit(out, direct_return_opcode, direct_return_operand, 0, 0, 0);
            raz_compiler_rt_arena_set(
                out.function_instruction_counts,
                0,
                out.instruction_count - raz_compiler_rt_arena_get(out.function_instruction_starts, 0),
            );
            return true;
        }
    }
    i64 function_index = 0;
    while (function_index < hir.function_count) {
        raz_compiler_rt_arena_set(out.function_instruction_starts, function_index, out.instruction_count);
        raz_compiler_rt_arena_set(
            out.function_module_ids,
            function_index,
            raz_compiler_rt_arena_get(hir.incremental_function_module_ids, function_index),
        );
        raz_compiler_rt_arena_set(
            out.function_parameter_counts,
            function_index,
            raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index),
        );
        raz_compiler_rt_arena_set(
            out.function_is_extern,
            function_index,
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index),
        );
        raz_compiler_rt_arena_set(
            out.function_extern_kinds,
            function_index,
            raz_compiler_rt_arena_get(hir.function_extern_kinds, function_index),
        );
        if (!lower_hir_spill_parameters(hir, out, function_index)) {
            return false;
        }
        i64 statement = raz_compiler_rt_arena_get(hir.function_statement_starts, function_index);
        i64 end = statement + raz_compiler_rt_arena_get(hir.function_statement_counts, function_index);
        bool lowered_direct = false;
        if (
            !mir_function_needs_drop_cleanup(out, function_index) &&
            raz_compiler_rt_arena_get(hir.function_defer_counts, function_index) == 0 &&
            end == statement + 1 &&
            raz_compiler_rt_arena_get(hir.statement_kinds, statement) == 2
        ) {
            i64 direct_return = raz_compiler_rt_arena_get(hir.statement_a, statement);
            if (direct_return < 0) {
                mir_emit(out, 21, 0, 0, 0, 0);
            } else {
                i64 direct_value = lower_hir_expression(hir, out, direct_return);
                mir_emit(out, 10, direct_value, 0, 0, 0);
            }
            lowered_direct = true;
        }
        i64 scan_statement = statement;
        bool linear =
            raz_compiler_rt_arena_get(hir.function_defer_counts, function_index) == 0 &&
            !mir_function_needs_drop_cleanup(out, function_index);
        while (!lowered_direct && scan_statement < end) {
            i64 scan_kind = raz_compiler_rt_arena_get(hir.statement_kinds, scan_statement);
            if (scan_kind != 1 && scan_kind != 2 && scan_kind != 4 && scan_kind != 5 && scan_kind != 8) {
                linear = false;
            }
            if (scan_kind == 4) {
                i64 scan_target = raz_compiler_rt_arena_get(hir.statement_a, scan_statement);
                if (raz_compiler_rt_arena_get(hir.node_kinds, scan_target) != 3) {
                    linear = false;
                }
            }
            scan_statement += 1;
        }
        if (lowered_direct) {} else if (linear) {
            while (statement < end) {
                i64 linear_kind = raz_compiler_rt_arena_get(hir.statement_kinds, statement);
                if (linear_kind == 8 || linear_kind == 1) {
                    i64 linear_value = lower_hir_expression(
                        hir,
                        out,
                        raz_compiler_rt_arena_get(hir.statement_b, statement),
                    );
                    i64 linear_store_type = raz_compiler_rt_arena_get(hir.statement_c, statement);
                    if (linear_kind == 8) {
                        i64 linear_local_index = raz_compiler_rt_arena_get(hir.statement_c, statement);
                        linear_store_type = raz_compiler_rt_arena_get(hir.local_types, linear_local_index);
                    }
                    mir_emit_typed(
                        out,
                        9,
                        raz_compiler_rt_arena_get(hir.statement_a, statement),
                        linear_value,
                        0,
                        0,
                        linear_store_type,
                    );
                } else if (linear_kind == 2) {
                    i64 linear_return = raz_compiler_rt_arena_get(hir.statement_a, statement);
                    if (linear_return < 0) {
                        mir_emit(out, 21, 0, 0, 0, 0);
                    } else {
                        i64 linear_return_value = lower_hir_expression(hir, out, linear_return);
                        mir_emit(out, 10, linear_return_value, 0, 0, 0);
                    }
                    statement = end;
                } else if (linear_kind == 4) {
                    i64 linear_target = raz_compiler_rt_arena_get(hir.statement_a, statement);
                    if (raz_compiler_rt_arena_get(hir.node_kinds, linear_target) != 3) {
                        return false;
                    }
                    i64 linear_assignment = lower_hir_expression(
                        hir,
                        out,
                        raz_compiler_rt_arena_get(hir.statement_b, statement),
                    );
                    i64 linear_slot = raz_compiler_rt_arena_get(hir.node_a, linear_target);
                    i64 linear_operation = raz_compiler_rt_arena_get(hir.statement_c, statement);
                    i64 linear_target_type = raz_compiler_rt_arena_get(hir.node_types, linear_target);
                    if (linear_operation != 0) {
                        i64 linear_current = mir_emit_typed(out, 3, linear_slot, 0, 0, 0, linear_target_type);
                        linear_assignment = lower_compound_value(
                            out,
                            linear_operation,
                            linear_current,
                            linear_assignment,
                            linear_target_type,
                        );
                    }
                    mir_emit_typed(out, 9, linear_slot, linear_assignment, 0, 0, linear_target_type);
                } else if (linear_kind == 5) {
                    lower_hir_expression(hir, out, raz_compiler_rt_arena_get(hir.statement_a, statement));
                } else {
                    return false;
                }
                statement += 1;
            }
        } else {
            if (
                !lower_hir_statement_range(
                    hir,
                    out,
                    statement,
                    end,
                    raz_compiler_rt_arena_get(hir.function_defer_starts, function_index),
                    raz_compiler_rt_arena_get(hir.function_defer_counts, function_index),
                )
            ) {
                return false;
            }
        }
        raz_compiler_rt_arena_set(
            out.function_instruction_counts,
            function_index,
            out.instruction_count - raz_compiler_rt_arena_get(out.function_instruction_starts, function_index),
        );
        function_index += 1;
    }
    return out.function_count > 0;
}
