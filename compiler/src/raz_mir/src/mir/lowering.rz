            // `self` receiver for next()/current() is the pointer read out of
            // that slot. Taking the slot's own address instead passes a
            // pointer-to-pointer and the iterator reads garbage fields.
            i64 iterator_type = raz_compiler_rt_arena_get(
                hir.node_types,
                raz_compiler_rt_arena_get(hir.node_a, iterator_loop)
            );
            mir_emit_typed(out, 9, iterator_slot, iterator_value, 0, 0, iterator_type);
            i64 loop_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 iterator_ref = mir_emit_typed(out, 3, iterator_slot, 0, 0, 0, iterator_type);
            i64 next_argument_start = out.call_argument_count;
            raz_compiler_rt_arena_set(out.call_arguments, out.call_argument_count, iterator_ref);
            out.call_argument_count += 1;
            i64 next_function = raz_compiler_rt_arena_get(hir.node_b, iterator_loop);
            i64 condition = mir_emit_typed(out, 8, next_function, next_argument_start, 1, 0, 10);
            i64 branch = mir_emit(out, 23, condition, -1, -1, -1);
            i64 body_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 current_ref = mir_emit_typed(out, 3, iterator_slot, 0, 0, 0, iterator_type);
            i64 current_argument_start = out.call_argument_count;
            raz_compiler_rt_arena_set(out.call_arguments, out.call_argument_count, current_ref);
            out.call_argument_count += 1;
            i64 current_function = raz_compiler_rt_arena_get(hir.node_c, iterator_loop);
            i64 current_type = raz_compiler_rt_arena_get(hir.function_return_types, current_function);
            i64 current_storage_type = current_type;
            if (raz_compiler_rt_arena_get(hir.function_return_references, current_function) != 0) {
