                            return false;
                        }
                    }
                }
                patch += 1;
            }
        } else if (kind == 17) {
            i64 slot = raz_compiler_rt_arena_get(hir.statement_a, cursor);
            i64 array_loop = raz_compiler_rt_arena_get(hir.statement_b, cursor);
            i64 body = raz_compiler_rt_arena_get(hir.statement_c, cursor);
            i64 element_type = raz_compiler_rt_arena_get(hir.node_types, array_loop);
            i64 element_structure = raz_compiler_rt_arena_get(hir.node_type_structs, array_loop);
            i64 array_value = lower_hir_expression(
                hir,
                out,
                raz_compiler_rt_arena_get(hir.node_a, array_loop)
            );
            i64 array_extent = raz_compiler_rt_arena_get(hir.node_b, array_loop);
            i64 index_slot = raz_compiler_rt_arena_get(hir.node_c, array_loop);
            i64 zero = mir_emit_typed(out, 1, 0, 0, 0, 0, 0);
            mir_emit_typed(out, 9, index_slot, zero, 0, 0, 0);
            i64 loop_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 current_index = mir_emit_typed(out, 3, index_slot, 0, 0, 0, 0);
            i64 extent_value = mir_emit_typed(out, 1, array_extent, 0, 0, 0, 0);
            i64 condition = mir_emit_typed(out, 13, current_index, extent_value, 0, 0, 0);
            i64 branch = mir_emit(out, 23, condition, -1, -1, -1);
            i64 body_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 borrow_kind = raz_compiler_rt_arena_get(hir.node_values, array_loop);
