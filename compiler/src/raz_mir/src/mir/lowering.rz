                        if (binding_mode != 0) { stored_type = 12; }
                        mir_emit_typed(out, 9, local_slot, payload_value, 0, 0, stored_type);
                    }
                    binding += 1;
                }
                i64 guard_node = raz_compiler_rt_arena_get(hir.match_arm_guards, arm);
