            }
            i64 merge_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 patch = match_instruction_start;
            while (patch < merge_label) {
                if (
                    raz_compiler_rt_arena_get(out.opcodes, patch) == 22 &&
                    raz_compiler_rt_arena_get(out.op_b, patch) == -4
                ) {
                    if (!mir_patch_target(out, patch, merge_label)) {
                        return false;
                    }
                }
                patch += 1;
            }
        } else if (kind == 19) {
            // Custom iteration is desugared to the stable IntoIterator /
