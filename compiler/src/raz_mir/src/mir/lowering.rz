                i64 loaded_index = mir_emit_typed(out, 3, index_slot, 0, 0, 0, 0);
                i64 one = mir_emit_typed(out, 1, 1, 0, 0, 0, 0);
                i64 next_index = mir_emit_typed(out, 4, loaded_index, one, 0, 0, 0);
                mir_emit_typed(out, 9, index_slot, next_index, 0, 0, 0);
                mir_emit(out, 22, 0, loop_label, -1, 0);
