            i64 body_start = raz_compiler_rt_arena_get(hir.block_statement_starts, body);
            i64 body_end = body_start + raz_compiler_rt_arena_get(hir.block_statement_counts, body);
            if (
                !lower_hir_statement_range(
                    hir,
                    out,
                    body_start,
                    body_end,
                    raz_compiler_rt_arena_get(hir.block_defer_starts, body),
                    raz_compiler_rt_arena_get(hir.block_defer_counts, body),
                )
