                        // child from the parent image alone. Without this metadata
                        // structured Forge loads the first word of the payload as a
                        // scalar instead of carrying the inline aggregate address.
                        if (
                            binding_mode == 0 &&
                            payload_value >= 0 &&
                            raz_compiler_rt_arena_get(out.opcodes, payload_value) == 28 &&
                            (payload_structure >= 0 || payload_extent >= 0)
                        ) {
                            i64 encoded_structure = 0;
                            i64 encoded_extent = 0;
                            if (payload_structure >= 0) { encoded_structure = payload_structure + 1; }
                            if (payload_extent >= 0) { encoded_extent = payload_extent + 1; }
                            raz_compiler_rt_arena_set(out.op_c, payload_value, encoded_structure);
                            raz_compiler_rt_arena_set(out.op_d, payload_value, encoded_extent);
                        }
