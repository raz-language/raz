                    branch = mir_emit(out, 23, condition, -1, -1, -1);
                    mir_emit(out, 24, 0, 0, 0, 0);
                }
                i64 binding_start = raz_compiler_rt_arena_get(hir.match_arm_binding_starts, arm);
                i64 binding_count = raz_compiler_rt_arena_get(hir.match_arm_binding_counts, arm);
                i64 member_index = raz_compiler_rt_arena_get(hir.match_arm_member_indices, arm);
                i64 payload_start = 0;
                if (member_index >= 0) {
                    payload_start = raz_compiler_rt_arena_get(hir.enum_member_payload_starts, member_index);
                }
                i64 binding = 0;
                while (binding < binding_count) {
                    i64 local_slot = raz_compiler_rt_arena_get(
                        hir.match_binding_local_slots,
                        binding_start + binding,
                    );
                    if (local_slot >= 0) {
                        i64 binding_path = raz_compiler_rt_arena_get(
                            hir.match_binding_path_indices,
                            binding_start + binding,
                        );
                        i64 binding_mode = raz_compiler_rt_arena_get(
                            hir.match_binding_modes,
                            binding_start + binding,
                        );
                        i64 payload_value = -1;
                        if (binding_mode == 0) {
                            payload_value = lower_match_path_value(hir, out, subject, binding_path);
                        } else {
                            payload_value = lower_match_path_reference(
                                hir,
                                out,
                                subject,
                                binding_path,
                                binding_mode,
                            );
                        }
                        i64 local_index = mir_local_index_for_slot(
                            hir,
                            out.lowering_function_index,
                            local_slot,
                        );
                        i64 payload_type = 0;
                        i64 payload_structure = -1;
                        i64 payload_extent = -1;
                        if (local_index >= 0) {
                            payload_type = raz_compiler_rt_arena_get(hir.local_types, local_index);
                            payload_structure = raz_compiler_rt_arena_get(hir.local_type_structs, local_index);
                            payload_extent = raz_compiler_rt_arena_get(hir.local_array_extents, local_index);
                        }
