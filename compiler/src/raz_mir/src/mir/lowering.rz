                !mir_patch_operand(out, branch, 1, exit_label) ||
                !mir_patch_operand(out, branch, 2, body_label)
            ) {
                return false;
            }
        } else if (kind == 13) {
            i64 slot = raz_compiler_rt_arena_get(hir.statement_a, cursor);
            i64 range = raz_compiler_rt_arena_get(hir.statement_b, cursor);
            i64 body = raz_compiler_rt_arena_get(hir.statement_c, cursor);
            i64 range_type = raz_compiler_rt_arena_get(hir.node_types, range);
            i64 start_value = lower_hir_expression(hir, out, raz_compiler_rt_arena_get(hir.node_a, range));
            i64 end_value = lower_hir_expression(hir, out, raz_compiler_rt_arena_get(hir.node_b, range));
            mir_emit_typed(out, 9, slot, start_value, 0, 0, range_type);
            i64 loop_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 current_value = mir_emit_typed(out, 3, slot, 0, 0, 0, range_type);
            i64 compare_opcode = 13;
            if (raz_compiler_rt_arena_get(hir.node_c, range) != 0) {
                compare_opcode = 14;
            }
            i64 condition = mir_emit_typed(out, compare_opcode, current_value, end_value, 0, 0, range_type);
            i64 branch = mir_emit(out, 23, condition, -1, -1, -1);
            i64 body_label = mir_emit(out, 24, 0, 0, 0, 0);
            i64 body_instruction_start = out.instruction_count;
            i64 body_start = raz_compiler_rt_arena_get(hir.block_statement_starts, body);
            i64 body_end = body_start + raz_compiler_rt_arena_get(hir.block_statement_counts, body);
            i64 nested_start = raz_compiler_rt_arena_get(hir.block_statement_starts, body);
            i64 nested_end = nested_start + raz_compiler_rt_arena_get(hir.block_statement_counts, body);
            if (
                !lower_hir_statement_range(
                    hir,
                    out,
                    nested_start,
                    nested_end,
                    raz_compiler_rt_arena_get(hir.block_defer_starts, body),
                    raz_compiler_rt_arena_get(hir.block_defer_counts, body),
                )
            ) {
