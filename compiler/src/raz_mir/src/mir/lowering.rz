                    // inspect destructured values. A false guard falls through
                    // to the next structural arm rather than terminating match.
                    i64 guard_condition = lower_hir_expression(hir, out, guard_node);
                    guard_branch = mir_emit(out, 23, guard_condition, -1, -1, -1);
                    mir_emit(out, 24, 0, 0, 0, 0);
                }
                i64 arm_start = raz_compiler_rt_arena_get(hir.block_statement_starts, arm_block);
                i64 arm_statement_end =
                    arm_start +
                    raz_compiler_rt_arena_get(hir.block_statement_counts, arm_block);
                if (
                    !lower_hir_statement_range(
                        hir,
                        out,
                        arm_start,
                        arm_statement_end,
                        raz_compiler_rt_arena_get(hir.block_defer_starts, arm_block),
                        raz_compiler_rt_arena_get(hir.block_defer_counts, arm_block),
                    )
