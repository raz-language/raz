namespace raz_codegen_web::browser_host_js;

public import common::writer;

// Browser import numbering is shared with raz_codegen_wasm::browser_host.
// The low lane owns logical imports 24..71 and the high lane owns 72..100.
public fn web_browser_import_enabled(i64 import_mask, i64 import_mask_high, i64 logical_import) -> bool {
    if (logical_import < 24 || logical_import > 100) { return false; }
    i64 bit = logical_import - 24;
    if (bit < 48) { return (import_mask & (1 << bit)) != 0; }
    bit -= 48;
    return (import_mask_high & (1 << bit)) != 0;
}

fn web_write_browser_host_binding(
    CodegenWriter&mut out,
    i64 import_mask,
    i64 import_mask_high,
    i64 logical_import,
    string binding,
) {
    if (web_browser_import_enabled(import_mask, import_mask_high, logical_import)) {
        codegen_writer_literal(out, binding);
    }
}

public fn web_write_browser_host(
    CodegenWriter&mut out,
    i64 import_mask,
    i64 import_mask_high,
) {
    codegen_writer_literal(out, "const cstr = (ptr) => { ptr = number(ptr); if (!ptr) return ''; const bytes = new Uint8Array(memory().buffer); let end = ptr; while (end < bytes.length && bytes[end] !== 0) end++; return decoder.decode(bytes.subarray(ptr, end)); };\n");
    codegen_writer_literal(out, "const razWeb = {\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 24, "  dom_set_text: (id, value) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.textContent = cstr(value); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 25, "  dom_set_text_i64: (id, value) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.textContent = String(value); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 26, "  dom_toggle_class: (id, name) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.classList.toggle(cstr(name)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 27, "  dom_set_text_ptr: (id, value) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.textContent = cstr(value); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 28, "  dom_set_text_i64_ptr: (id, value) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.textContent = String(value); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 29, "  dom_toggle_class_ptr: (id, name) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.classList.toggle(cstr(name)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 30, "  event_value_length: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 31, "  event_value_write: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 32, "  event_key_length: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 33, "  event_key_write: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 34, "  event_checked: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 35, "  event_prevent_default: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 56, "  event_code_length: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 57, "  event_code_write: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 58, "  event_repeat: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 59, "  event_alt_key: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 60, "  event_ctrl_key: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 61, "  event_shift_key: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 62, "  event_meta_key: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 63, "  event_button: () => -1n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 64, "  event_client_x: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 65, "  event_client_y: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 66, "  event_stop_propagation: () => 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 36, "  dom_set_attribute: (id, name, value) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.setAttribute(cstr(name), cstr(value)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 37, "  dom_remove_attribute: (id, name) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.removeAttribute(cstr(name)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 38, "  dom_add_class: (id, name) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.classList.add(cstr(name)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 39, "  dom_remove_class: (id, name) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.classList.remove(cstr(name)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 40, "  dom_focus: (id) => { const el = document.getElementById(cstr(id)); if (!el) return 0n; el.focus(); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 67, "  dom_set_value: (id, value) => { const el = document.getElementById(cstr(id)); if (!el || !('value' in el)) return 0n; el.value = cstr(value); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 68, "  dom_blur: (id) => { const el = document.getElementById(cstr(id)); if (!el || typeof el.blur !== 'function') return 0n; el.blur(); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 69, "  dom_click: (id) => { const el = document.getElementById(cstr(id)); if (!el || typeof el.click !== 'function') return 0n; el.click(); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 70, "  dom_exists: (id) => document.getElementById(cstr(id)) ? 1n : 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 87, "  dom_value_length: (id) => { const el = document.getElementById(cstr(id)); if (!el || !('value' in el)) return -1n; return BigInt(encoder.encode(String(el.value)).length); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 88, "  dom_value_write: (id, outPtr, cap) => { const el = document.getElementById(cstr(id)); if (!el || !('value' in el)) return -1n; const b = encoder.encode(String(el.value)); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 89, "  dom_text_length: (id) => { const el = document.getElementById(cstr(id)); if (!el) return -1n; return BigInt(encoder.encode(el.textContent || '').length); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 90, "  dom_text_write: (id, outPtr, cap) => { const el = document.getElementById(cstr(id)); if (!el) return -1n; const b = encoder.encode(el.textContent || ''); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 91, "  dom_attribute_length: (id, name) => { const el = document.getElementById(cstr(id)); if (!el) return -1n; const v = el.getAttribute(cstr(name)); return v === null ? -1n : BigInt(encoder.encode(v).length); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 92, "  dom_attribute_write: (id, name, outPtr, cap) => { const el = document.getElementById(cstr(id)); if (!el) return -1n; const v = el.getAttribute(cstr(name)); if (v === null) return -1n; const b = encoder.encode(v); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 71, "  timer_set_timeout: (handler, delay) => { const name = cstr(handler); const id = setTimeout(() => { const fn = instance && instance.exports[name]; if (typeof fn === 'function') fn(); }, Math.max(0, number(delay))); return BigInt(id); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 72, "  timer_clear_timeout: (id) => { clearTimeout(number(id)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 80, "  timer_set_interval: (handler, delay) => { const name = cstr(handler); const id = setInterval(() => { const fn = instance && instance.exports[name]; if (typeof fn === 'function') fn(); }, Math.max(1, number(delay))); return BigInt(id); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 81, "  timer_clear_interval: (id) => { clearInterval(number(id)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 41, "  storage_set: (key, value) => { try { localStorage.setItem(cstr(key), cstr(value)); return 1n; } catch { return 0n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 42, "  storage_remove: (key) => { try { localStorage.removeItem(cstr(key)); return 1n; } catch { return 0n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 43, "  storage_clear: () => { try { localStorage.clear(); return 1n; } catch { return 0n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 44, "  storage_value_length: (key) => { const v = localStorage.getItem(cstr(key)); return v === null ? -1n : BigInt(encoder.encode(v).length); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 45, "  storage_value_write: (key, outPtr, cap) => { const v = localStorage.getItem(cstr(key)); if (v === null) return -1n; const b = encoder.encode(v); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 82, "  session_storage_set: (key, value) => { try { sessionStorage.setItem(cstr(key), cstr(value)); return 1n; } catch { return 0n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 83, "  session_storage_remove: (key) => { try { sessionStorage.removeItem(cstr(key)); return 1n; } catch { return 0n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 84, "  session_storage_clear: () => { try { sessionStorage.clear(); return 1n; } catch { return 0n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 85, "  session_storage_value_length: (key) => { const v = sessionStorage.getItem(cstr(key)); return v === null ? -1n : BigInt(encoder.encode(v).length); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 86, "  session_storage_value_write: (key, outPtr, cap) => { const v = sessionStorage.getItem(cstr(key)); if (v === null) return -1n; const b = encoder.encode(v); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 46, "  location_href_length: () => BigInt(encoder.encode(location.href).length),\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 47, "  location_href_write: (outPtr, cap) => { const b = encoder.encode(location.href); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 93, "  location_origin_length: () => BigInt(encoder.encode(location.origin).length),\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 94, "  location_origin_write: (outPtr, cap) => { const b = encoder.encode(location.origin); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 95, "  location_pathname_length: () => BigInt(encoder.encode(location.pathname).length),\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 96, "  location_pathname_write: (outPtr, cap) => { const b = encoder.encode(location.pathname); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 97, "  location_search_length: () => BigInt(encoder.encode(location.search).length),\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 98, "  location_search_write: (outPtr, cap) => { const b = encoder.encode(location.search); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 99, "  location_hash_length: () => BigInt(encoder.encode(location.hash).length),\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 100, "  location_hash_write: (outPtr, cap) => { const b = encoder.encode(location.hash); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 48, "  location_assign: (url) => { location.assign(cstr(url)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 49, "  location_replace: (url) => { location.replace(cstr(url)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 50, "  location_reload: () => { location.reload(); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 73, "  url_query_value_length: (name) => { const p = new URLSearchParams(location.search); const key = cstr(name); if (!p.has(key)) return -1n; return BigInt(encoder.encode(p.get(key) || '').length); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 74, "  url_query_value_write: (name, outPtr, cap) => { const p = new URLSearchParams(location.search); const key = cstr(name); if (!p.has(key)) return -1n; const b = encoder.encode(p.get(key) || ''); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 79, "  url_query_has: (name) => new URLSearchParams(location.search).has(cstr(name)) ? 1n : 0n,\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 75, "  url_encode_length: (value) => BigInt(encoder.encode(encodeURIComponent(cstr(value))).length),\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 76, "  url_encode_write: (value, outPtr, cap) => { const b = encoder.encode(encodeURIComponent(cstr(value))); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 77, "  url_decode_length: (value) => { try { return BigInt(encoder.encode(decodeURIComponent(cstr(value))).length); } catch { return -1n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 78, "  url_decode_write: (value, outPtr, cap) => { try { const b = encoder.encode(decodeURIComponent(cstr(value))); const n = Math.min(b.length, number(cap)); if (n) new Uint8Array(memory().buffer, number(outPtr), n).set(b.subarray(0,n)); return BigInt(n); } catch { return -1n; } },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 51, "  history_push: (url) => { history.pushState(null, '', cstr(url)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 52, "  history_replace: (url) => { history.replaceState(null, '', cstr(url)); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 53, "  history_back: () => { history.back(); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 54, "  history_forward: () => { history.forward(); return 1n; },\n");
    web_write_browser_host_binding(out, import_mask, import_mask_high, 55, "  clipboard_write: (value) => { if (!navigator.clipboard) return 0n; void navigator.clipboard.writeText(cstr(value)); return 1n; },\n");
    codegen_writer_literal(out, "};\n");
}
