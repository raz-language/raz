namespace raz_codegen_web::codegen;

public import raz_codegen_web::runtime_analysis;
public import raz_codegen_web::runtime_js;
public import raz_codegen_web::support;
public import wasm::codegen;

// Web is an application target of Raz, not a separate language or a fifth code
// backend. It reuses the normal frontend, HIR, MIR, optimizer, and Wasm backend;
// this module only orchestrates the final browser application artifacts.

public fn emit_web_application(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 output_path,
    i64 output_path_length,
    i64 title,
    i64 title_length,
    i64 custom_index,
    i64 custom_index_length,
    i64 extra_css,
    i64 extra_css_length,
    i64 extra_javascript,
    i64 extra_javascript_length,
    bool release_profile,
) -> bool {
    if (output_path == 0 || output_path_length <= 0) { return false; }

    i64 root = raz_compiler_rt_arena_create(8192);
    i64 assets = raz_compiler_rt_arena_create(8192);
    i64 wasm_path = raz_compiler_rt_arena_create(8192);
    i64 js_path = raz_compiler_rt_arena_create(8192);
    i64 css_path = raz_compiler_rt_arena_create(8192);
    if (root == 0 || assets == 0 || wasm_path == 0 || js_path == 0 || css_path == 0) {
        if (root != 0) { raz_compiler_rt_arena_destroy(root); }
        if (assets != 0) { raz_compiler_rt_arena_destroy(assets); }
        if (wasm_path != 0) { raz_compiler_rt_arena_destroy(wasm_path); }
        if (js_path != 0) { raz_compiler_rt_arena_destroy(js_path); }
        if (css_path != 0) { raz_compiler_rt_arena_destroy(css_path); }
        return false;
    }

    i64 root_length = web_path_dirname(output_path, output_path_length, root, 8192);
    i64 assets_length = web_join_literal(root, root_length, "assets", assets, 8192);
    i64 wasm_length = web_join_literal(assets, assets_length, "app.wasm", wasm_path, 8192);
    i64 js_length = web_join_literal(assets, assets_length, "app.js", js_path, 8192);
    i64 css_length = web_join_literal(assets, assets_length, "app.css", css_path, 8192);

    bool success =
        root_length > 0 && assets_length > 0 && wasm_length > 0 && js_length > 0 && css_length > 0;
    if (success) {
        success = web_create_dir_ascii(root, root_length) == 0;
    }
    if (success) {
        success = web_create_dir_ascii(assets, assets_length) == 0;
    }

    // Keep every allocator-owning artifact stage explicit instead of one giant
    // short-circuit expression. Besides reducing optimizer pressure on the
    // Windows self-host compiler, a crash now leaves an unambiguous partial
    // artifact trail: app.wasm -> app.js -> app.css -> index.html.
    i64 browser_import_mask = 0;
    i64 browser_import_mask_high = 0;
    i64 runtime_capabilities = 63;
    if (success) {
        runtime_capabilities = web_runtime_capabilities(source, hir, mir);
    }
    if (success) {
        success = emit_web_wasm_module_imports(
            source, hir, mir, wasm_path, wasm_length,
            &mut browser_import_mask, &mut browser_import_mask_high
        );
    }
    if (success) {
        success = web_write_loader(
            js_path,
            js_length,
            extra_javascript,
            extra_javascript_length,
            release_profile,
            browser_import_mask,
            browser_import_mask_high,
            runtime_capabilities,
        );
    }
    if (success) {
        success = web_write_css(css_path, css_length, extra_css, extra_css_length);
    }
    if (success) {
        if (custom_index_length > 0) {
            success = web_copy_text_file(
                custom_index,
                custom_index_length,
                output_path,
                output_path_length,
            );
        } else {
            success = web_write_index(output_path, output_path_length, title, title_length);
        }
    }

    raz_compiler_rt_arena_destroy(css_path);
    raz_compiler_rt_arena_destroy(js_path);
    raz_compiler_rt_arena_destroy(wasm_path);
    raz_compiler_rt_arena_destroy(assets);
    raz_compiler_rt_arena_destroy(root);
    return success;
}
