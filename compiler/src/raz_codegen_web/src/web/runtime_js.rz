namespace raz_codegen_web::runtime_js;

public import common::writer;
public import raz_codegen_web::browser_host_js;
public import raz_codegen_web::runtime_analysis;
public import raz_codegen_web::support;

// Emit the reactive browser loader. Host ABI bindings are emitted separately
// so the 77-entry browser surface does not obscure the component runtime.

public fn web_write_loader(
    i64 path, i64 path_length, i64 extra_path, i64 extra_path_length,
    bool release_profile, i64 import_mask, i64 import_mask_high, i64 runtime_capabilities
) -> bool {
    CodegenWriter out;
    codegen_writer_init_capacity(&mut out, 32768);
    if (out.failed) { return false; }

    bool runtime_events = web_runtime_has_events(runtime_capabilities);
    bool runtime_routing = web_runtime_has_routing(runtime_capabilities);
    bool runtime_http = web_runtime_has_http(runtime_capabilities);
    bool runtime_patch = runtime_events || runtime_routing || runtime_http;
    bool runtime_bindings = runtime_patch && web_runtime_has_bindings(runtime_capabilities);
    bool runtime_scoped = runtime_patch && web_runtime_has_scoped_components(runtime_capabilities);
    bool runtime_raw_js = web_runtime_has_raw_js(runtime_capabilities);
    bool runtime_host_bytes = runtime_events || runtime_routing || runtime_http;
    bool browser_host_any = import_mask != 0 || import_mask_high != 0;
    bool runtime_encoder = browser_host_any || runtime_host_bytes;

    codegen_writer_literal(&mut out, "// Generated by the Raz web backend.\n");
    codegen_writer_literal(&mut out, "const decoder = new TextDecoder();\n");
    if (runtime_encoder) { codegen_writer_literal(&mut out, "const encoder = new TextEncoder();\n"); }
    codegen_writer_literal(&mut out, "let instance = null;\n");
    if (runtime_patch) { codegen_writer_literal(&mut out, "let renderedRevision = null;\n"); }
    if (runtime_bindings) { codegen_writer_literal(&mut out, "let renderedStructureRevision = null;\n"); }
    if (runtime_raw_js) { codegen_writer_literal(&mut out, "let renderedRawJs = null;\n"); }
    codegen_writer_literal(&mut out, "const memory = () => instance.exports.memory;\n");
    codegen_writer_literal(&mut out, "const number = (value) => typeof value === 'bigint' ? Number(value) : value;\n");
    codegen_writer_literal(&mut out, "const text = (ptr, len) => { ptr = number(ptr); len = number(len); if (!ptr || len <= 0) return ''; return decoder.decode(new Uint8Array(memory().buffer, ptr, len)); };\n");
    codegen_writer_literal(&mut out, "const exportedText = (prefix) => { const p = instance.exports[prefix + '_ptr']; const n = instance.exports[prefix + '_len']; return p && n ? text(p(), n()) : ''; };\n");
    if (browser_host_any) { web_write_browser_host(&mut out, import_mask, import_mask_high); }

    codegen_writer_literal(&mut out, "const root = document.querySelector('[data-raz-root]');\n");
    codegen_writer_literal(&mut out, "const runtimeStyle = document.createElement('style');\n");
    codegen_writer_literal(&mut out, "runtimeStyle.dataset.razRuntimeStyle = ''; document.head.append(runtimeStyle);\n");

    // DOM reconciliation is only needed when something can request a second
    // render. A plain Component application gets a direct initial innerHTML
    // publish and carries none of the keyed patcher below.
    if (runtime_patch) {
        codegen_writer_literal(&mut out, "const syncAttributes = (current, next) => {\n");
        codegen_writer_literal(&mut out, "  for (const attr of [...current.attributes]) if (!next.hasAttribute(attr.name)) current.removeAttribute(attr.name);\n");
        codegen_writer_literal(&mut out, "  for (const attr of [...next.attributes]) if (current.getAttribute(attr.name) !== attr.value) current.setAttribute(attr.name, attr.value);\n");
        codegen_writer_literal(&mut out, "  if (current instanceof HTMLInputElement) { const wanted = next.getAttribute('value') ?? ''; if (current !== document.activeElement && current.value !== wanted) current.value = wanted; if (current.type === 'checkbox') { const checked = next.hasAttribute('checked'); if (current.checked !== checked) current.checked = checked; } }\n");
        codegen_writer_literal(&mut out, "};\n");
        codegen_writer_literal(&mut out, "const nodeKey = (node) => node?.nodeType === Node.ELEMENT_NODE ? node.getAttribute('data-raz-key') : null;\n");
        codegen_writer_literal(&mut out, "const patchChildren = (current, next) => { let index = 0; while (index < next.childNodes.length || index < current.childNodes.length) { const newChild = next.childNodes[index]; let oldChild = current.childNodes[index]; if (!newChild) { oldChild.remove(); continue; } const key = nodeKey(newChild); if (key !== null && nodeKey(oldChild) !== key) { let match = null; for (let scan = index + 1; scan < current.childNodes.length; scan++) { if (nodeKey(current.childNodes[scan]) === key) { match = current.childNodes[scan]; break; } } if (match) { current.insertBefore(match, oldChild ?? null); oldChild = match; } } if (!oldChild) { current.append(newChild.cloneNode(true)); index++; continue; } patchNode(oldChild, newChild); index++; } };\n");
        if (runtime_scoped) {
            codegen_writer_literal(&mut out, "const componentKey = node => node?.nodeType === Node.ELEMENT_NODE ? node.getAttribute('data-raz-component') : null;\n");
        }
        codegen_writer_literal(&mut out, "const patchNode = (current, next) => {\n");
        codegen_writer_literal(&mut out, "  if (!current || !next || current.nodeType !== next.nodeType || (current.nodeType === 1 && current.tagName !== next.tagName) || (nodeKey(current) !== null && nodeKey(next) !== null && nodeKey(current) !== nodeKey(next))) { const replacement = next.cloneNode(true); current?.replaceWith(replacement); return replacement; }\n");
        codegen_writer_literal(&mut out, "  if (current.isEqualNode?.(next)) return current;\n");
        codegen_writer_literal(&mut out, "  if (current.nodeType === Node.TEXT_NODE) { if (current.nodeValue !== next.nodeValue) current.nodeValue = next.nodeValue; return current; }\n");
        if (runtime_scoped) {
            codegen_writer_literal(&mut out, "  if (current.nodeType !== Node.ELEMENT_NODE) return current; const boundary = componentKey(current); if (boundary !== null && boundary === componentKey(next)) { syncAttributes(current, next); patchChildren(current, next); return current; } syncAttributes(current, next); patchChildren(current, next); return current;\n");
        } else {
            codegen_writer_literal(&mut out, "  if (current.nodeType !== Node.ELEMENT_NODE) return current; syncAttributes(current, next); patchChildren(current, next); return current;\n");
        }
        codegen_writer_literal(&mut out, "};\n");
        codegen_writer_literal(&mut out, "const patchRoot = (html) => { const template = document.createElement('template'); template.innerHTML = html; patchChildren(root, template.content); };\n");
    }

    if (runtime_scoped) {
        codegen_writer_literal(&mut out, "const componentStyles = new Map();\n");
        codegen_writer_literal(&mut out, "const syncComponent = (scope) => {\n");
        codegen_writer_literal(&mut out, "  const publishedScope = instance.exports.raz_web_component_scope; if (!publishedScope || number(publishedScope()) !== scope) return false;\n");
        codegen_writer_literal(&mut out, "  const current = root.querySelector(`[data-raz-component-scope=\"${scope}\"]`); if (!current) return false; const template = document.createElement('template'); template.innerHTML = exportedText('raz_web_component_html'); const next = template.content.firstElementChild; if (!next) return false; patchNode(current, next);\n");
        codegen_writer_literal(&mut out, "  const css = exportedText('raz_web_component_css'); let style = componentStyles.get(scope); if (!style) { style = document.createElement('style'); style.dataset.razComponentStyle = String(scope); document.head.append(style); componentStyles.set(scope, style); } if (style.textContent !== css) style.textContent = css; return true;\n");
        codegen_writer_literal(&mut out, "};\n");
        codegen_writer_literal(&mut out, "const renderOwnedScope = (scope) => { const renderComponent = instance.exports.raz_web_render_component; if (scope <= 0 || typeof renderComponent !== 'function') return false; const status = renderComponent(BigInt(scope)); return number(status) >= 0 && syncComponent(scope); };\n");
    }

    if (runtime_bindings) {
        codegen_writer_literal(&mut out, "let bindingIndexRevision = null; let bindingIndex = new Map(); let derivedBindings = [];\n");
        codegen_writer_literal(&mut out, "const addBinding = (slot, kind, node) => { const key = String(slot); let list = bindingIndex.get(key); if (!list) { list = []; bindingIndex.set(key, list); } list.push([kind, node]); };\n");
        codegen_writer_literal(&mut out, "const rebuildBindingIndex = (structureRevision) => { bindingIndex = new Map(); derivedBindings = []; for (const node of root.querySelectorAll('[data-raz-bind-string]')) addBinding(node.getAttribute('data-raz-bind-string'), 'text-string', node); for (const node of root.querySelectorAll('[data-raz-bind-i64]')) addBinding(node.getAttribute('data-raz-bind-i64'), 'text-i64', node); for (const node of root.querySelectorAll('input[data-raz-state-string]')) addBinding(node.getAttribute('data-raz-state-string'), 'input-string', node); for (const node of root.querySelectorAll('input[data-raz-state-i64]')) addBinding(node.getAttribute('data-raz-state-i64'), 'input-i64', node); for (const node of root.querySelectorAll('input[data-raz-state-bool]')) addBinding(node.getAttribute('data-raz-state-bool'), 'input-bool', node); derivedBindings = [...root.querySelectorAll('[data-raz-bind-derived-i64]')]; bindingIndexRevision = structureRevision; };\n");
        codegen_writer_literal(&mut out, "const ensureBindingIndex = () => { const structureFn = instance.exports.raz_web_structure_revision; const revision = structureFn ? structureFn() : null; if (bindingIndexRevision !== revision) rebuildBindingIndex(revision); return true; };\n");
        codegen_writer_literal(&mut out, "const applyStateBindings = (changedSlot = null) => {\n");
        codegen_writer_literal(&mut out, "  const i64Value = instance.exports.raz_web_state_i64; const derivedI64 = instance.exports.raz_web_derived_i64; const boolValue = instance.exports.raz_web_state_bool; const stringPtr = instance.exports.raz_web_state_string_ptr; const stringLen = instance.exports.raz_web_state_string_len; if (!i64Value || !boolValue || !stringPtr || !stringLen || !ensureBindingIndex()) return false;\n");
        codegen_writer_literal(&mut out, "  const entries = changedSlot === null ? [...bindingIndex.values()].flat() : (bindingIndex.get(String(changedSlot)) ?? []); for (const [kind, node] of entries) { const slotText = node.getAttribute(kind.startsWith('text-') ? (kind === 'text-string' ? 'data-raz-bind-string' : 'data-raz-bind-i64') : (kind === 'input-string' ? 'data-raz-state-string' : kind === 'input-i64' ? 'data-raz-state-i64' : 'data-raz-state-bool')); const slot = BigInt(slotText); const prefix = node.getAttribute('data-raz-prefix') ?? ''; if (kind === 'text-string') { const wanted = prefix + text(stringPtr(slot), stringLen(slot)); if (node.textContent !== wanted) node.textContent = wanted; } else if (kind === 'text-i64') { const wanted = prefix + String(number(i64Value(slot))); if (node.textContent !== wanted) node.textContent = wanted; } else if (kind === 'input-string') { const wanted = text(stringPtr(slot), stringLen(slot)); if (node.value !== wanted) node.value = wanted; } else if (kind === 'input-i64') { const wanted = String(number(i64Value(slot))); if (node.value !== wanted) node.value = wanted; } else { const wanted = number(boolValue(slot)) !== 0; if (node.checked !== wanted) node.checked = wanted; } }\n");
        codegen_writer_literal(&mut out, "  if (derivedI64) for (const node of derivedBindings) { const id = BigInt(node.getAttribute('data-raz-bind-derived-i64')); if (changedSlot !== null && node.getAttribute('data-raz-derived-left') !== String(changedSlot) && node.getAttribute('data-raz-derived-right') !== String(changedSlot)) continue; const prefix = node.getAttribute('data-raz-prefix') ?? ''; const wanted = prefix + String(number(derivedI64(id))); if (node.textContent !== wanted) node.textContent = wanted; } return true;\n");
        codegen_writer_literal(&mut out, "};\n");
    }

    if (runtime_patch) {
        codegen_writer_literal(&mut out, "const syncView = (force = false) => {\n");
        codegen_writer_literal(&mut out, "  const revisionFn = instance.exports.raz_web_revision; if (!revisionFn) return; const revision = revisionFn(); if (!force && renderedRevision === revision) return;\n");
        if (runtime_events) {
            codegen_writer_literal(&mut out, "  const active = document.activeElement && root.contains(document.activeElement) ? document.activeElement : null; const activeInput = active?.getAttribute?.('data-raz-input') ?? active?.getAttribute?.('data-raz-number') ?? null; const selectionStart = active?.selectionStart ?? null; const selectionEnd = active?.selectionEnd ?? null;\n");
        }
        if (runtime_bindings) {
            codegen_writer_literal(&mut out, "  const structureFn = instance.exports.raz_web_structure_revision; const structureRevision = structureFn ? structureFn() : null; const bindingFastPath = renderedStructureRevision !== null && structureRevision !== null && renderedStructureRevision === structureRevision;\n");
            codegen_writer_literal(&mut out, "  if (!bindingFastPath || !applyStateBindings()) patchRoot(exportedText('raz_web_html'));\n");
        } else {
            codegen_writer_literal(&mut out, "  patchRoot(exportedText('raz_web_html'));\n");
        }
        codegen_writer_literal(&mut out, "  runtimeStyle.textContent = exportedText('raz_web_css'); const title = exportedText('raz_web_title'); if (title) document.title = title;\n");
        if (runtime_raw_js) {
            codegen_writer_literal(&mut out, "  const rawJs = exportedText('raz_web_js'); if (rawJs !== renderedRawJs) { renderedRawJs = rawJs; if (rawJs) (0, eval)(rawJs); }\n");
        }
        if (runtime_events) {
            codegen_writer_literal(&mut out, "  if (activeInput) { const next = root.querySelector(`[data-raz-input=\"${activeInput}\"], [data-raz-number=\"${activeInput}\"]`); if (next) { next.focus({ preventScroll: true }); if (selectionStart !== null && next.setSelectionRange) next.setSelectionRange(selectionStart, selectionEnd); } }\n");
        }
        if (runtime_bindings) {
            codegen_writer_literal(&mut out, "  if (renderedStructureRevision !== structureRevision) bindingIndexRevision = null; renderedStructureRevision = structureRevision;\n");
        }
        codegen_writer_literal(&mut out, "  renderedRevision = revision;\n};\n");
    } else {
        codegen_writer_literal(&mut out, "const syncView = () => { root.innerHTML = exportedText('raz_web_html'); runtimeStyle.textContent = exportedText('raz_web_css'); const title = exportedText('raz_web_title'); if (title) document.title = title;");
        if (runtime_raw_js) {
            codegen_writer_literal(&mut out, " const rawJs = exportedText('raz_web_js'); if (rawJs !== renderedRawJs) { renderedRawJs = rawJs; if (rawJs) (0, eval)(rawJs); }");
        }
        codegen_writer_literal(&mut out, " };\n");
    }

    codegen_writer_literal(&mut out, "const runMain = () => {\n");
    codegen_writer_literal(&mut out, "  const main = instance.exports.main; if (typeof main !== 'function') throw new Error('Raz web project has no main function');\n");
    codegen_writer_literal(&mut out, "  const begin = instance.exports.raz_web_begin_render; if (typeof begin === 'function') begin();\n");
    codegen_writer_literal(&mut out, "  const component = main(); const publish = instance.exports.raz_web_publish_main; if (typeof publish !== 'function') throw new Error('Raz web runtime publisher is missing');\n");
    codegen_writer_literal(&mut out, "  const status = publish(component); if (number(status) < 0) throw new Error('Raz web main returned an invalid Component');\n");
    codegen_writer_literal(&mut out, "};\n");

    if (runtime_host_bytes) {
        codegen_writer_literal(&mut out, "const withHostBytes = (bytes, fn) => {\n");
        codegen_writer_literal(&mut out, "  const alloc = instance.exports.raz_web_host_alloc; const free = instance.exports.raz_web_host_free; if (!alloc || !free) throw new Error('Raz web host byte ABI is missing');\n");
        codegen_writer_literal(&mut out, "  const ptr = bytes.length ? alloc(BigInt(bytes.length)) : 0n; if (bytes.length && !number(ptr)) throw new Error('Raz web host allocation failed');\n");
        codegen_writer_literal(&mut out, "  if (bytes.length) new Uint8Array(memory().buffer, number(ptr), bytes.length).set(bytes);\n");
        codegen_writer_literal(&mut out, "  try { return fn(ptr, BigInt(bytes.length)); } finally { if (number(ptr)) free(ptr); }\n");
        codegen_writer_literal(&mut out, "};\n");
        codegen_writer_literal(&mut out, "const withHostText = (value, fn) => withHostBytes(encoder.encode(value), fn);\n");
    }

    if (runtime_routing) {
        codegen_writer_literal(&mut out, "const setRoute = (value) => { const set = instance.exports.raz_web_route_set; if (set) withHostText(value, (ptr, len) => set(ptr, len)); };\n");
        codegen_writer_literal(&mut out, "const browserRoute = () => location.pathname;\n");
        codegen_writer_literal(&mut out, "const syncRouteChange = () => { const scopeFn = instance.exports.raz_web_route_render_scope; const scope = scopeFn ? number(scopeFn()) : -1; if (scope === 0) return;");
        if (runtime_scoped) {
            codegen_writer_literal(&mut out, " if (scope > 0 && renderOwnedScope(scope)) {");
            if (runtime_http) { codegen_writer_literal(&mut out, " void pumpHttp();"); }
            codegen_writer_literal(&mut out, " return; }");
        }
        codegen_writer_literal(&mut out, " runMain(); syncView(true);");
        if (runtime_http) { codegen_writer_literal(&mut out, " void pumpHttp();"); }
        codegen_writer_literal(&mut out, " };\n");
    }

    if (runtime_http) {
        codegen_writer_literal(&mut out, "const pumpHttp = async () => {\n");
        codegen_writer_literal(&mut out, "  const next = instance.exports.raz_web_http_pending_next; const urlPtr = instance.exports.raz_web_http_url_ptr; const urlLen = instance.exports.raz_web_http_url_len; const methodFn = instance.exports.raz_web_http_method; const bodyPtr = instance.exports.raz_web_http_body_ptr; const bodyLen = instance.exports.raz_web_http_body_len; const complete = instance.exports.raz_web_http_complete;\n");
        if (runtime_scoped) {
            codegen_writer_literal(&mut out, "  if (!next || !urlPtr || !urlLen || !methodFn || !bodyPtr || !bodyLen || !complete) return; const scopeFn = instance.exports.raz_web_http_render_scope; let cursor = 0; let changed = false; let fullRender = false; const scopes = new Set();\n");
        } else {
            codegen_writer_literal(&mut out, "  if (!next || !urlPtr || !urlLen || !methodFn || !bodyPtr || !bodyLen || !complete) return; let cursor = 0; let changed = false;\n");
        }
        codegen_writer_literal(&mut out, "  while (true) { const id = number(next(BigInt(cursor))); if (!id) break; cursor = id; const url = text(urlPtr(BigInt(id)), urlLen(BigInt(id)));\n");
        codegen_writer_literal(&mut out, "    try { const method = number(methodFn(BigInt(id))); const options = {}; const names = ['', 'GET', 'POST', 'PUT', 'PATCH', 'DELETE']; if (method > 1 && method < names.length) options.method = names[method]; if (method === 2 || method === 3 || method === 4) { const bp = number(bodyPtr(BigInt(id))); const bl = number(bodyLen(BigInt(id))); options.body = new Uint8Array(memory().buffer, bp, bl).slice(); options.headers = { 'content-type': 'text/plain; charset=utf-8' }; } const response = await fetch(url, options); const bytes = new Uint8Array(await response.arrayBuffer()); withHostBytes(bytes, (ptr, len) => complete(BigInt(id), BigInt(response.status), ptr, len)); }\n");
        if (runtime_scoped) {
            codegen_writer_literal(&mut out, "    catch { complete(BigInt(id), 0n, 0n, 0n); } changed = true; const scope = scopeFn ? number(scopeFn(BigInt(id))) : -1; if (scope < 0) fullRender = true; else if (scope > 0) scopes.add(scope); }\n");
            codegen_writer_literal(&mut out, "  if (changed) { if (fullRender) { runMain(); syncView(true); } else { for (const scope of scopes) { if (!renderOwnedScope(scope)) { fullRender = true; break; } } if (fullRender) { runMain(); syncView(true); } } }\n");
        } else {
            codegen_writer_literal(&mut out, "    catch { complete(BigInt(id), 0n, 0n, 0n); } changed = true; }\n");
            codegen_writer_literal(&mut out, "  if (changed) { runMain(); syncView(true); }\n");
        }
        codegen_writer_literal(&mut out, "};\n");
    }

    if (runtime_events) {
        codegen_writer_literal(&mut out, "const dispatchNode = (node, attribute) => {\n");
        codegen_writer_literal(&mut out, "  if (!node) return; const raw = node.getAttribute(attribute); if (!raw) return;\n");
        codegen_writer_literal(&mut out, "  let result; if (attribute === 'data-raz-input') { const dispatch = instance.exports.raz_web_dispatch_text; if (!dispatch) return; result = withHostText(node.value ?? '', (ptr, len) => dispatch(BigInt(raw), ptr, len)); }\n");
        codegen_writer_literal(&mut out, "  else if (attribute === 'data-raz-number') { const dispatch = instance.exports.raz_web_dispatch_i64; if (!dispatch) return; let value; try { value = BigInt(node.value || '0'); } catch { return; } result = dispatch(BigInt(raw), value); }\n");
        codegen_writer_literal(&mut out, "  else if (attribute === 'data-raz-check') { const dispatch = instance.exports.raz_web_dispatch_bool; if (!dispatch) return; result = dispatch(BigInt(raw), node.checked ? 1n : 0n); }\n");
        codegen_writer_literal(&mut out, "  else { const dispatch = instance.exports.raz_web_dispatch; if (!dispatch) return; result = dispatch(BigInt(raw)); }\n");
        codegen_writer_literal(&mut out, "  if (number(result) < 0) throw new Error(`Raz web event ${raw} failed`);");
        if (runtime_bindings) {
            codegen_writer_literal(&mut out, " const requiresRender = instance.exports.raz_web_event_requires_render; const stateSlotFn = instance.exports.raz_web_event_state_slot; const changedSlot = stateSlotFn ? number(stateSlotFn(BigInt(raw))) : null; if (requiresRender && number(requiresRender(BigInt(raw))) === 0 && applyStateBindings(changedSlot)) {");
            if (runtime_http) { codegen_writer_literal(&mut out, " void pumpHttp();"); }
            codegen_writer_literal(&mut out, " return; }");
        }
        if (runtime_scoped) {
            codegen_writer_literal(&mut out, " const scopeFn = instance.exports.raz_web_event_render_scope; const scope = scopeFn ? number(scopeFn(BigInt(raw))) : -1; if (scope > 0 && renderOwnedScope(scope)) {");
            if (runtime_http) { codegen_writer_literal(&mut out, " void pumpHttp();"); }
            codegen_writer_literal(&mut out, " return; }");
        }
        codegen_writer_literal(&mut out, " runMain(); syncView(true);");
        if (runtime_http) { codegen_writer_literal(&mut out, " void pumpHttp();"); }
        codegen_writer_literal(&mut out, "\n};\n");
        // Event delegation keeps listener count constant across Raz rerenders.
        codegen_writer_literal(&mut out, "root.addEventListener('input', (event) => { const node = event.target.closest?.('[data-raz-input], [data-raz-number]'); if (!node || !root.contains(node)) return; dispatchNode(node, node.hasAttribute('data-raz-number') ? 'data-raz-number' : 'data-raz-input'); });\n");
        codegen_writer_literal(&mut out, "root.addEventListener('change', (event) => { const node = event.target.closest?.('[data-raz-check]'); if (node && root.contains(node)) dispatchNode(node, 'data-raz-check'); });\n");
        codegen_writer_literal(&mut out, "root.addEventListener('submit', (event) => { const node = event.target.closest?.('form[data-raz-submit]'); if (!node || !root.contains(node)) return; event.preventDefault(); dispatchNode(node, 'data-raz-submit'); });\n");
    }

    if (runtime_events && runtime_routing) {
        codegen_writer_literal(&mut out, "root.addEventListener('click', (event) => { const action = event.target.closest?.('[data-raz-click]'); if (action && root.contains(action)) { dispatchNode(action, 'data-raz-click'); return; } const node = event.target.closest?.('a[data-raz-nav]'); if (!node || !root.contains(node) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; const url = new URL(node.getAttribute('data-raz-nav'), location.href); if (url.origin !== location.origin) return; event.preventDefault(); history.pushState(null, '', url); setRoute(browserRoute()); syncRouteChange(); });\n");
    } else if (runtime_events) {
        codegen_writer_literal(&mut out, "root.addEventListener('click', (event) => { const action = event.target.closest?.('[data-raz-click]'); if (action && root.contains(action)) dispatchNode(action, 'data-raz-click'); });\n");
    } else if (runtime_routing) {
        codegen_writer_literal(&mut out, "root.addEventListener('click', (event) => { const node = event.target.closest?.('a[data-raz-nav]'); if (!node || !root.contains(node) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; const url = new URL(node.getAttribute('data-raz-nav'), location.href); if (url.origin !== location.origin) return; event.preventDefault(); history.pushState(null, '', url); setRoute(browserRoute()); syncRouteChange(); });\n");
    }
    if (runtime_routing) {
        codegen_writer_literal(&mut out, "addEventListener('popstate', () => { setRoute(browserRoute()); syncRouteChange(); });\n");
    }

    codegen_writer_literal(&mut out, "const wasmUrl = new URL('./app.wasm', import.meta.url);\n");
    if (browser_host_any) {
        codegen_writer_literal(&mut out, "const imports = { raz_web: razWeb };\n");
        codegen_writer_literal(&mut out, "let loaded; try { loaded = await WebAssembly.instantiateStreaming(fetch(wasmUrl), imports); } catch { const response = await fetch(wasmUrl); const bytes = await response.arrayBuffer(); loaded = await WebAssembly.instantiate(bytes, imports); }\n");
    } else {
        codegen_writer_literal(&mut out, "let loaded; try { loaded = await WebAssembly.instantiateStreaming(fetch(wasmUrl), {}); } catch { const response = await fetch(wasmUrl); const bytes = await response.arrayBuffer(); loaded = await WebAssembly.instantiate(bytes, {}); }\n");
    }
    codegen_writer_literal(&mut out, "instance = loaded.instance;\n");
    if (runtime_routing) { codegen_writer_literal(&mut out, "setRoute(browserRoute());\n"); }
    // Web applications are libraries driven by the browser. Invoke main
    // directly and keep the instance alive for retained runtime capabilities.
    codegen_writer_literal(&mut out, "runMain();\n");
    codegen_writer_literal(&mut out, "syncView(true);\n");
    if (runtime_http) { codegen_writer_literal(&mut out, "await pumpHttp();\n"); }
    if (runtime_routing) {
        if (runtime_bindings) {
            codegen_writer_literal(&mut out, "globalThis.Raz = Object.freeze({ wasm: instance.exports, root, sync: () => { renderedStructureRevision = null; syncView(true); }, route: (value) => { history.pushState(null, '', value); setRoute(browserRoute()); syncRouteChange(); } });\n");
        } else {
            codegen_writer_literal(&mut out, "globalThis.Raz = Object.freeze({ wasm: instance.exports, root, sync: () => syncView(true), route: (value) => { history.pushState(null, '', value); setRoute(browserRoute()); syncRouteChange(); } });\n");
        }
    } else if (runtime_bindings) {
        codegen_writer_literal(&mut out, "globalThis.Raz = Object.freeze({ wasm: instance.exports, root, sync: () => { renderedStructureRevision = null; syncView(true); } });\n");
    } else {
        codegen_writer_literal(&mut out, "globalThis.Raz = Object.freeze({ wasm: instance.exports, root, sync: () => syncView(true) });\n");
    }

    if (release_profile) {
        CodegenWriter compact;
        codegen_writer_init_capacity(&mut compact, out.length);
        if (compact.failed || !web_compact_generated_js(&mut compact, &out)) { codegen_writer_destroy(&mut compact); codegen_writer_destroy(&mut out); return false; }
        if (extra_path_length > 0) { codegen_writer_newline(&mut compact); if (!web_append_file(&mut compact, extra_path, extra_path_length)) { codegen_writer_destroy(&mut compact); codegen_writer_destroy(&mut out); return false; } codegen_writer_newline(&mut compact); }
        bool ok = !compact.failed && raz_compiler_rt_write_ascii(path, path_length, compact.data, compact.length) == compact.length;
        codegen_writer_destroy(&mut compact);
        codegen_writer_destroy(&mut out);
        return ok;
    }

    if (extra_path_length > 0) { codegen_writer_literal(&mut out, "\n// User JavaScript from raz.toml [web].javascript\n"); if (!web_append_file(&mut out, extra_path, extra_path_length)) { codegen_writer_destroy(&mut out); return false; } codegen_writer_literal(&mut out, "\n"); }
    bool ok = !out.failed && raz_compiler_rt_write_ascii(path, path_length, out.data, out.length) == out.length;
    codegen_writer_destroy(&mut out);
    return ok;
}
