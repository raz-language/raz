fn primitive_type_kind(Source& source, i64 offset, i64 length) -> i64 {
  if (token_is_string_type(source, offset, length)) {
    return 13;
  }
  if (token_is_f64(source, offset, length)) {
    return 1;
  }
  if (token_is_f32(source, offset, length)) {
    return 11;
  }
  if (length == 2) {
    i64 first = source_byte(source, offset);

    if (first == 105) {
      return 2;
    }
    if (first == 117) {
      return 5;
    }
  }
  if (length == 3) {
    i64 first = source_byte(source, offset);
    i64 second = source_byte(source, offset + 1);
    i64 third = source_byte(source, offset + 2);

    if (second == 49 && third == 54) {
      if (first == 105) {
        return 3;
      }
      if (first == 117) {
        return 6;
      }
    }
    if (second == 51 && third == 50) {
      if (first == 105) {
        return 4;
      }
      if (first == 117) {
        return 7;
      }
    }
    if (first == 117 && second == 54 && third == 52) {
      return 8;
    }
    if (first == 117 && second == 105 && third == 110) {
      return 8;
    }
    if (first == 105 && second == 115 && third == 105) {
      return 0;
    }
  }
  if (length == 5 && source_byte(source, offset) == 117) {
    return 9;
  }
  if (length == 4) {
    if (source_byte(source, offset) == 98 && source_byte(source, offset + 1) == 121) {
      return 5;
    }
    if (source_byte(source, offset) == 117 && source_byte(source, offset + 1) == 105) {
      return 8;
    }
    if (
    source_byte(source, offset) == 99 &&
    source_byte(source, offset + 1) == 104 &&
    source_byte(source, offset + 2) == 97 &&
    source_byte(source, offset + 3) == 114
    ) {
      return 10;
    }
  }
  return 0;
}

fn primitive_type_is_float(i64 type_kind) -> bool {
  return type_kind == 1 || type_kind == 11;
}

fn primitive_type_is_unsigned(i64 type_kind) -> bool {
  return (type_kind >= 5 && type_kind <= 9) || type_kind == 10;
}

fn primitive_type_is_integer(i64 type_kind) -> bool {
  // Only the built-in scalar integer/boolean/character kinds participate in
  // integer arithmetic. Higher HIR-only kinds are enums/aggregates/handles.
  return type_kind == 0 || (type_kind >= 2 && type_kind <= 10);
}

fn primitive_type_width(i64 type_kind) -> i64 {
  if (type_kind == 2 || type_kind == 5) {
    return 8;
  }
  if (type_kind == 3 || type_kind == 6) {
    return 16;
  }
  if (type_kind == 4 || type_kind == 7 || type_kind == 10 || type_kind == 11) {
    return 32;
  }
  return 64;
}

fn primitive_cast_supported(i64 source_type, i64 target_type) -> bool {
  if (source_type == target_type) {
    return true;
  }
  if (
  source_type == 12 ||
  target_type == 12 ||
  source_type == 13 ||
  target_type == 13 ||
  source_type == 14 ||
  target_type == 14
  ) {
    return false;
  }

  bool source_float = primitive_type_is_float(source_type);
  bool target_float = primitive_type_is_float(target_type);

  if (!source_float && !target_float) {
    return true;
  }
  if (source_float && target_float) {
    return true;
  }

  i64 integer_type = source_type;

  if (source_float) {
    integer_type = target_type;
  }
  if (primitive_type_is_unsigned(integer_type) && primitive_type_width(integer_type) == 64) {
    return false;
  }
  return true;
}

