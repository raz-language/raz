// Self-host compiler arena. The first 24 bytes intentionally preserve the
// bootstrap arena ABI header so the few remaining Stage-1 OS/string adapters
// can consume arena-backed buffers while arena ownership itself lives in Raz.
fn raz_rt_stage1_arena_create(i64 count) -> i64 {
  if (count <= 0 || count > 1152921504606846972) {
    return 0;
  }

  i64 bytes = 24 + count * 8;
  usize allocation = raz_rt_alloc_aligned(bytes, 8);

  if (allocation == 0) {
    return 0;
  }
  raz_rt_fill(allocation, 0, bytes);
  unsafe {
    *((allocation + 0)as i64*mut) = 4923358263036431937;
    *((allocation + 8)as i64*mut) = count;
  }
  return (allocation + 24)as i64;
}

fn raz_rt_stage1_arena_destroy(i64 handle) {
  if (handle == 0) {
    return;
  }

  usize allocation = (handle as usize) - 24;

  unsafe {
    *((allocation + 0)as i64*mut) = 0;
    *((allocation + 8)as i64*mut) = 0;
  }
  raz_rt_dealloc_aligned(allocation, 8);
}

fn raz_rt_stage1_arena_count(i64 handle) -> i64 {
  if (handle == 0) {
    return 0;
  }

  usize allocation = (handle as usize) - 24;

  unsafe {
    if (*((allocation + 0)as i64*const) != 4923358263036431937) {
      return 0;
    }
    return *((allocation + 8)as i64*const);
  }
}

fn raz_rt_stage1_arena_get(i64 handle, i64 index) -> i64 {
  i64 count = raz_rt_stage1_arena_count(handle);

  if (index < 0 || index >= count) {
    return 0;
  }
  unsafe {
    return *(((handle as usize) + index * 8)as i64*const);
  }
}

fn raz_rt_stage1_arena_set(i64 handle, i64 index, i64 value) {
  i64 count = raz_rt_stage1_arena_count(handle);

  if (index < 0 || index >= count) {
    return;
  }
  unsafe {
    *(((handle as usize) + index * 8)as i64*mut) = value;
  }
}

fn raz_rt_stage1_arena_range_equal(i64 handle, i64 left, i64 right, i64 count) -> i64 {
  i64 capacity = raz_rt_stage1_arena_count(handle);

  if (
  left < 0 ||
  right < 0 ||
  count < 0 ||
  left > capacity ||
  right > capacity ||
  count > capacity - left ||
  count > capacity - right
  ) {
    return 0;
  }
  return raz_rt_bytes_equal((handle as usize) + left * 8, (handle as usize) + right * 8, count * 8);
}

fn raz_rt_stage1_arena_range_hash(i64 handle, i64 offset, i64 count, i64 seed) -> i64 {
  i64 capacity = raz_rt_stage1_arena_count(handle);

  if (offset < 0 || count < 0 || offset > capacity || count > capacity - offset) {
    return seed;
  }

  i64 modulus = 281474976710597;
  i64 hash = seed % modulus;

  if (hash < 0) {
    hash += modulus;
  }

  i64 index = 0;

  while (index < count) {
    hash = (hash * 131 + raz_rt_stage1_arena_get(handle, offset + index) + 1) % modulus;
    index += 1;
  }
  return hash;
}

fn raz_rt_stage1_arena_copy(
i64 destination,
i64 destination_offset,
i64 source,
i64 source_offset,
i64 count,
) -> i64 {
  i64 destination_count = raz_rt_stage1_arena_count(destination);
  i64 source_count = raz_rt_stage1_arena_count(source);

  if (
  destination_offset < 0 ||
  source_offset < 0 ||
  count < 0 ||
  destination_offset > destination_count ||
  source_offset > source_count ||
  count > destination_count - destination_offset ||
  count > source_count - source_offset
  ) {
    return -1;
  }
  if (count > 0) {
    raz_rt_move(
    (destination as usize) + destination_offset * 8,
    (source as usize) + source_offset * 8,
    count * 8,
    );
  }
  return count;
}

fn stage1_ascii_pack(i64 handle, i64 offset, i64 length) -> usize {
  i64 capacity = raz_rt_stage1_arena_count(handle);

  if (offset < 0 || length < 0 || offset > capacity || length > capacity - offset) {
    return 0;
  }

  usize bytes = raz_rt_alloc_aligned(length + 1, 8);

  if (bytes == 0) {
    return 0;
  }

  i64 index = 0;

  while (index < length) {
    unsafe {
      *((bytes + index)as u8*mut) = (raz_rt_stage1_arena_get(handle, offset + index) & 255)as u8;
    }
    index += 1;
  }
  unsafe {
    *((bytes + length)as u8*mut) = 0;
  }
  return bytes;
}

fn stage1_ascii_unpack(i64 handle, i64 offset, usize bytes, i64 length) -> bool {
  i64 capacity = raz_rt_stage1_arena_count(handle);

  if (
  offset < 0 ||
  length < 0 ||
  offset > capacity ||
  length > capacity - offset ||
  (length > 0 && bytes == 0)
  ) {
    return false;
  }

  i64 index = 0;

  while (index < length) {
    unsafe {
      raz_rt_stage1_arena_set(handle, offset + index, (*((bytes + index)as u8*const))as i64);
    }
    index += 1;
  }
  return true;
}

fn raz_rt_stage1_write_ascii(i64 path, i64 path_length, i64 data, i64 size) -> i64 {
  if (path_length < 0 || size < 0) {
    return -1;
  }

  usize path_bytes = stage1_ascii_pack(path, 0, path_length);
  usize data_bytes = stage1_ascii_pack(data, 0, size);

  if ((path_length > 0 && path_bytes == 0) || (size > 0 && data_bytes == 0)) {
    if (path_bytes != 0) {
      raz_rt_dealloc_aligned(path_bytes, 8);
    }
    if (data_bytes != 0) {
      raz_rt_dealloc_aligned(data_bytes, 8);
    }
    return -1;
  }

  usize file = raz_rt_file_open(path_bytes, path_length, 2 | 8 | 16);

  if (file == 0) {
    if (path_bytes != 0) {
      raz_rt_dealloc_aligned(path_bytes, 8);
    }
    if (data_bytes != 0) {
      raz_rt_dealloc_aligned(data_bytes, 8);
    }
    return -1;
  }

  i64 written = 0;

  while (written < size) {
    i64 count = raz_rt_file_write(file, data_bytes + written, size - written);

    if (count <= 0) {
      raz_rt_file_close(file);
      raz_rt_dealloc_aligned(path_bytes, 8);
      if (data_bytes != 0) {
        raz_rt_dealloc_aligned(data_bytes, 8);
      }
      return -1;
    }
    written += count;
  }
  raz_rt_file_close(file);
  if (path_bytes != 0) {
    raz_rt_dealloc_aligned(path_bytes, 8);
  }
  if (data_bytes != 0) {
    raz_rt_dealloc_aligned(data_bytes, 8);
  }
  return written;
}

fn raz_rt_stage1_read_ascii(i64 path, i64 path_length, i64 data, i64 capacity) -> i64 {
  if (path_length < 0 || capacity < 0) {
    return -1;
  }

  usize path_bytes = stage1_ascii_pack(path, 0, path_length);

  if (path_length > 0 && path_bytes == 0) {
    return -1;
  }

  usize file = raz_rt_file_open(path_bytes, path_length, 1);

  if (path_bytes != 0) {
    raz_rt_dealloc_aligned(path_bytes, 8);
  }
  if (file == 0) {
    return -1;
  }

  usize bytes = raz_rt_alloc_aligned(capacity + 1, 8);

  if (bytes == 0) {
    raz_rt_file_close(file);
    return -1;
  }

  i64 total = 0;
  bool reading = true;

  while (reading && total < capacity) {
    i64 count = raz_rt_file_read(file, bytes + total, capacity - total);

    if (count < 0) {
      raz_rt_file_close(file);
      raz_rt_dealloc_aligned(bytes, 8);
      return -1;
    }
    if (count == 0) {
      reading = false;
    } else {
      total += count;
    }
  }
  raz_rt_file_close(file);
  if (total > 0) {
    stage1_ascii_unpack(data, 0, bytes, total);
  }
  raz_rt_dealloc_aligned(bytes, 8);
  return total;
}

fn raz_rt_stage1_process_argc() -> i64 {
  return raz_rt_process_argc();
}

fn raz_rt_stage1_process_arg(i64 index, i64 output, i64 capacity) -> i64 {
  if (capacity < 0) {
    return -1;
  }

  usize bytes = raz_rt_alloc_aligned(capacity + 1, 8);

  if (bytes == 0) {
    return -1;
  }

  i64 result = raz_rt_process_arg(index, bytes, capacity + 1);

  if (result >= 0 && result <= capacity) {
    stage1_ascii_unpack(output, 0, bytes, result);
  }
  raz_rt_dealloc_aligned(bytes, 8);
  return result;
}

fn raz_rt_stage1_stdio_write_ascii(i64 stream, i64 data, i64 size) -> i64 {
  usize bytes = stage1_ascii_pack(data, 0, size);

  if (size > 0 && bytes == 0) {
    return -1;
  }

  i64 result = raz_rt_stdio_write(stream, bytes, size);

  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return result;
}

fn raz_rt_stage1_env_get_ascii(i64 name, i64 name_length, i64 output, i64 capacity) -> i64 {
  usize name_bytes = stage1_ascii_pack(name, 0, name_length);

  if (name_length > 0 && name_bytes == 0) {
    return -1;
  }

  usize output_bytes = raz_rt_alloc_aligned(capacity + 1, 8);

  if (output_bytes == 0) {
    if (name_bytes != 0) {
      raz_rt_dealloc_aligned(name_bytes, 8);
    }
    return -1;
  }

  i64 result = raz_rt_env_get(name_bytes, name_length, output_bytes, capacity + 1);

  if (result >= 0 && result <= capacity) {
    stage1_ascii_unpack(output, 0, output_bytes, result);
  }
  raz_rt_dealloc_aligned(output_bytes, 8);
  if (name_bytes != 0) {
    raz_rt_dealloc_aligned(name_bytes, 8);
  }
  return result;
}

fn raz_rt_stage1_path_exists_ascii(i64 path, i64 path_length) -> i64 {
  usize bytes = stage1_ascii_pack(path, 0, path_length);

  if (path_length > 0 && bytes == 0) {
    return 0;
  }

  i64 result = raz_rt_path_exists(bytes, path_length);

  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return result;
}

fn raz_rt_stage1_process_run_ascii(i64 command, i64 length) -> i64 {
  usize bytes = stage1_ascii_pack(command, 0, length);

  if (length > 0 && bytes == 0) {
    return -1;
  }

  i64 result = raz_rt_process_run(bytes, length);

  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return result;
}

fn raz_rt_stage1_tcp_connect_ascii(i64 host, i64 host_length, i64 port) -> i64 {
  usize bytes = stage1_ascii_pack(host, 0, host_length);

  if (host_length > 0 && bytes == 0) {
    return -1;
  }

  i64 result = raz_rt_tcp_connect(bytes, host_length, port);

  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return result;
}

fn raz_rt_stage1_socket_set_timeout_millis(i64 socket, i64 receive_millis, i64 send_millis) -> i64 {
  return raz_rt_socket_set_timeout_millis(socket, receive_millis, send_millis);
}

fn raz_rt_stage1_socket_send_ascii(i64 socket, i64 data, i64 offset, i64 size) -> i64 {
  usize bytes = stage1_ascii_pack(data, offset, size);

  if (size > 0 && bytes == 0) {
    return -1;
  }

  i64 sent = 0;

  while (sent < size) {
    i64 count = raz_rt_socket_send(socket, bytes + sent, size - sent);

    if (count < 0) {
      if (bytes != 0) {
        raz_rt_dealloc_aligned(bytes, 8);
      }
      return -1;
    }
    if (count == 0) {
      break;
    }
    sent += count;
  }
  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return sent;
}

fn raz_rt_stage1_socket_receive_ascii(i64 socket, i64 output, i64 offset, i64 capacity) -> i64 {
  usize bytes = raz_rt_alloc_aligned(capacity + 1, 8);

  if (bytes == 0) {
    return -1;
  }

  i64 count = raz_rt_socket_receive(socket, bytes, capacity);

  if (count > 0) {
    stage1_ascii_unpack(output, offset, bytes, count);
  }
  raz_rt_dealloc_aligned(bytes, 8);
  return count;
}

fn raz_rt_stage1_socket_close(i64 socket) {
  raz_rt_socket_close(socket);
}

fn raz_rt_stage1_tls_available() -> i64 {
  return raz_rt_tls_available();
}

fn raz_rt_stage1_tls_client_create_ascii(i64 host, i64 host_length) -> usize {
  usize bytes = stage1_ascii_pack(host, 0, host_length);

  if (host_length > 0 && bytes == 0) {
    return 0;
  }

  usize handle = raz_rt_tls_client_create(bytes, host_length);

  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return handle;
}

fn raz_rt_stage1_tls_feed_ascii(i64 handle, i64 data, i64 offset, i64 size) -> i64 {
  usize bytes = stage1_ascii_pack(data, offset, size);

  if (size > 0 && bytes == 0) {
    return -1;
  }

  i64 result = raz_rt_tls_feed(handle as usize, bytes, size);

  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return result;
}

fn raz_rt_stage1_tls_drain_ascii(i64 handle, i64 output, i64 offset, i64 capacity) -> i64 {
  usize bytes = raz_rt_alloc_aligned(capacity + 1, 8);

  if (bytes == 0) {
    return -1;
  }

  i64 count = raz_rt_tls_drain(handle as usize, bytes, capacity);

  if (count > 0) {
    stage1_ascii_unpack(output, offset, bytes, count);
  }
  raz_rt_dealloc_aligned(bytes, 8);
  return count;
}

fn raz_rt_stage1_tls_pending_encrypted(i64 handle) -> i64 {
  return raz_rt_tls_pending_encrypted(handle as usize);
}

fn raz_rt_stage1_tls_handshake(i64 handle) -> i64 {
  return raz_rt_tls_handshake(handle as usize);
}

fn raz_rt_stage1_tls_handshake_finished(i64 handle) -> i64 {
  return raz_rt_tls_handshake_finished(handle as usize);
}

fn raz_rt_stage1_tls_write_plain_ascii(i64 handle, i64 data, i64 offset, i64 size) -> i64 {
  usize bytes = stage1_ascii_pack(data, offset, size);

  if (size > 0 && bytes == 0) {
    return -1;
  }

  i64 result = raz_rt_tls_write_plain(handle as usize, bytes, size);

  if (bytes != 0) {
    raz_rt_dealloc_aligned(bytes, 8);
  }
  return result;
}

fn raz_rt_stage1_tls_read_plain_ascii(i64 handle, i64 output, i64 offset, i64 capacity) -> i64 {
  usize bytes = raz_rt_alloc_aligned(capacity + 1, 8);

  if (bytes == 0) {
    return -1;
  }

  i64 count = raz_rt_tls_read_plain(handle as usize, bytes, capacity);

  if (count > 0) {
    stage1_ascii_unpack(output, offset, bytes, count);
  }
  raz_rt_dealloc_aligned(bytes, 8);
  return count;
}

fn raz_rt_stage1_tls_shutdown(i64 handle) -> i64 {
  return raz_rt_tls_shutdown(handle as usize);
}

fn raz_rt_stage1_tls_destroy(i64 handle) {
  raz_rt_tls_destroy(handle as usize);
}

public struct Parser {
  Lexer scan;
  Token current;
  Diagnostic last_error;
  ModuleSyntax&mut module;
  i64 current_function;
}

fn init_token(Token&mut out, TokenKind kind, i64 offset, i64 length) {
  out.kind = kind;
  out.offset = offset;
  out.length = length;
}

fn clear_diagnostic(Diagnostic&mut out) {
  out.code = DiagnosticCode::None;
  out.offset = 0;
}

fn set_diagnostic(Diagnostic&mut out, DiagnosticCode code, i64 offset) {
  out.code = code;
  out.offset = offset;
}

fn diagnostic_code_value(DiagnosticCode code) -> i64 {
  if (code == DiagnosticCode::InvalidByte) {
    return 1;
  }
  if (code == DiagnosticCode::ExpectedToken) {
    return 2;
  }
  if (code == DiagnosticCode::ExpectedIdentifier) {
    return 3;
  }
  if (code == DiagnosticCode::TooManyItems) {
    return 4;
  }
  if (code == DiagnosticCode::UnknownName) {
    return 5;
  }
  if (code == DiagnosticCode::DuplicateName) {
    return 6;
  }
  if (code == DiagnosticCode::UnknownType) {
    return 7;
  }
  if (code == DiagnosticCode::WrongArgumentCount) {
    return 8;
  }
  if (code == DiagnosticCode::MissingReturn) {
    return 9;
  }
  if (code == DiagnosticCode::InvalidMove) {
    return 10;
  }
  if (code == DiagnosticCode::UseAfterMove) {
    return 11;
  }
  if (code == DiagnosticCode::BorrowConflict) {
    return 12;
  }
  if (code == DiagnosticCode::AmbiguousName) {
    return 13;
  }
  return 0;
}

fn source_byte(Source& value, i64 index) -> i64 {
  return raz_rt_stage1_arena_get(value.bytes, index);
}

fn is_space(i64 value) -> bool {
  return value == 32 || value == 9 || value == 10 || value == 13;
}

fn is_alpha(i64 value) -> bool {
  return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95;
}

fn is_digit(i64 value) -> bool {
  return value >= 48 && value <= 57;
}

fn digit_value(i64 value) -> i64 {
  if (value >= 48 && value <= 57) {
    return value - 48;
  }
  if (value >= 97 && value <= 102) {
    return value - 87;
  }
  if (value >= 65 && value <= 70) {
    return value - 55;
  }
  return -1;
}

fn skip_space(Lexer&mut scan) {
  while (scan.offset < scan.input.length && is_space(source_byte(&scan.input, scan.offset))) {
    scan.offset += 1;
  }
}

fn init_lexer(Lexer&mut out, Source input) {
  out.input = input;
  out.offset = 0;
  clear_diagnostic(&mut out.last_error);
}

fn next_token(Lexer&mut scan, Token&mut out) {
  skip_space(scan);

  i64 start = scan.offset;

  if (start >= scan.input.length) {
    init_token(out, TokenKind::End, start, 0);
    return;
  }

  i64 current = source_byte(&scan.input, scan.offset);

  if (
  current == 47 &&
  scan.offset + 1 < scan.input.length &&
  source_byte(&scan.input, scan.offset + 1) == 47
  ) {
    scan.offset += 2;
    while (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) != 10) {
      scan.offset += 1;
    }
    next_token(scan, out);
    return;
  }
  if (
  current == 47 &&
  scan.offset + 1 < scan.input.length &&
  source_byte(&scan.input, scan.offset + 1) == 42
  ) {
    scan.offset += 2;

    i64 depth = 1;

    while (scan.offset < scan.input.length && depth > 0) {
      i64 comment = source_byte(&scan.input, scan.offset);

      if (
      comment == 47 &&
      scan.offset + 1 < scan.input.length &&
      source_byte(&scan.input, scan.offset + 1) == 42
      ) {
        depth += 1;
        scan.offset += 2;
      } else if (
      comment == 42 &&
      scan.offset + 1 < scan.input.length &&
      source_byte(&scan.input, scan.offset + 1) == 47
      ) {
        depth -= 1;
        scan.offset += 2;
      } else {
        scan.offset += 1;
      }
    }
    if (depth != 0) {
      set_diagnostic(&mut scan.last_error, DiagnosticCode::InvalidByte, start);
      init_token(out, TokenKind::Unknown, start, scan.offset - start);
      return;
    }
    next_token(scan, out);
    return;
  }
  if (current == 34) {
    scan.offset += 1;

    bool escaped = false;

    while (scan.offset < scan.input.length) {
      i64 byte = source_byte(&scan.input, scan.offset);

      if (!escaped && byte == 34) {
        scan.offset += 1;
        init_token(out, TokenKind::String, start, scan.offset - start);
        return;
      }
      if (!escaped && byte == 92) {
        escaped = true;
      } else {
        escaped = false;
      }
      scan.offset += 1;
    }
    set_diagnostic(&mut scan.last_error, DiagnosticCode::InvalidByte, start);
    init_token(out, TokenKind::Unknown, start, scan.offset - start);
    return;
  }
  if (current == 39) {
    // A leading apostrophe followed by an identifier is a named lifetime
    // unless it is closed by another apostrophe as a character literal.
    if (scan.offset + 1 < scan.input.length && is_alpha(source_byte(&scan.input, scan.offset + 1))) {
      i64 probe = scan.offset + 2;

      while (
      probe < scan.input.length &&
      (is_alpha(source_byte(&scan.input, probe)) || is_digit(source_byte(&scan.input, probe)))
      ) {
        probe += 1;
      }
      if (probe >= scan.input.length || source_byte(&scan.input, probe) != 39) {
        scan.offset = probe;
        init_token(out, TokenKind::Lifetime, start, scan.offset - start);
        return;
      }
    }
    scan.offset += 1;

    bool escaped = false;

    while (scan.offset < scan.input.length) {
      i64 byte = source_byte(&scan.input, scan.offset);

      if (!escaped && byte == 39) {
        scan.offset += 1;
        init_token(out, TokenKind::Character, start, scan.offset - start);
        return;
      }
      if (!escaped && byte == 92) {
        escaped = true;
      } else {
        escaped = false;
      }
      scan.offset += 1;
    }
    set_diagnostic(&mut scan.last_error, DiagnosticCode::InvalidByte, start);
    init_token(out, TokenKind::Unknown, start, scan.offset - start);
    return;
  }
  if (is_alpha(current)) {
    scan.offset += 1;
    while (
    scan.offset < scan.input.length &&
    (
    is_alpha(source_byte(&scan.input, scan.offset)) ||
    is_digit(source_byte(&scan.input, scan.offset))
    )
    ) {
      scan.offset += 1;
    }
    init_token(out, TokenKind::Identifier, start, scan.offset - start);
    return;
  }
  if (is_digit(current)) {
    i64 base = 10;

    if (current == 48 && scan.offset + 1 < scan.input.length) {
      i64 prefix = source_byte(&scan.input, scan.offset + 1);

      if (prefix == 120 || prefix == 88) {
        base = 16;
        scan.offset += 2;
      } else if (prefix == 98 || prefix == 66) {
        base = 2;
        scan.offset += 2;
      } else if (prefix == 111 || prefix == 79) {
        base = 8;
        scan.offset += 2;
      }
    }
    if (scan.offset == start) {
      scan.offset += 1;
    }

    i64 digits = 1;

    if (base != 10) {
      digits = 0;
    }

    bool scanning_digits = true;

    while (scan.offset < scan.input.length && scanning_digits) {
      i64 byte = source_byte(&scan.input, scan.offset);

      if (byte == 95) {
        scan.offset += 1;
      } else {
        i64 digit = digit_value(byte);

        if (digit < 0 || digit >= base) {
          scanning_digits = false;
        } else {
          digits += 1;
          scan.offset += 1;
        }
      }
    }
    if (digits == 0) {
      set_diagnostic(&mut scan.last_error, DiagnosticCode::InvalidByte, start);
      init_token(out, TokenKind::Unknown, start, scan.offset - start);
      return;
    }

    bool floating = false;

    if (
    base == 10 &&
    scan.offset < scan.input.length &&
    source_byte(&scan.input, scan.offset) == 46 &&
    scan.offset + 1 < scan.input.length &&
    is_digit(source_byte(&scan.input, scan.offset + 1))
    ) {
      floating = true;
      scan.offset += 1;
      while (
      scan.offset < scan.input.length &&
      (
      is_digit(source_byte(&scan.input, scan.offset)) ||
      source_byte(&scan.input, scan.offset) == 95
      )
      ) {
        scan.offset += 1;
      }
    }
    if (
    base == 10 &&
    scan.offset < scan.input.length &&
    (source_byte(&scan.input, scan.offset) == 101 || source_byte(&scan.input, scan.offset) == 69)
    ) {
      floating = true;
      scan.offset += 1;
      if (
      scan.offset < scan.input.length &&
      (source_byte(&scan.input, scan.offset) == 43 || source_byte(&scan.input, scan.offset) == 45)
      ) {
        scan.offset += 1;
      }

      i64 exponent_start = scan.offset;

      while (
      scan.offset < scan.input.length &&
      (
      is_digit(source_byte(&scan.input, scan.offset)) ||
      source_byte(&scan.input, scan.offset) == 95
      )
      ) {
        scan.offset += 1;
      }
      if (scan.offset == exponent_start) {
        set_diagnostic(&mut scan.last_error, DiagnosticCode::InvalidByte, start);
        init_token(out, TokenKind::Unknown, start, scan.offset - start);
        return;
      }
    }
    if (floating) {
      init_token(out, TokenKind::Float, start, scan.offset - start);
    } else {
      init_token(out, TokenKind::Integer, start, scan.offset - start);
    }
    return;
  }
  scan.offset += 1;
  if (current == 40) {
    init_token(out, TokenKind::LeftParen, start, 1);
    return;
  }
  if (current == 41) {
    init_token(out, TokenKind::RightParen, start, 1);
    return;
  }
  if (current == 123) {
    init_token(out, TokenKind::LeftBrace, start, 1);
    return;
  }
  if (current == 125) {
    init_token(out, TokenKind::RightBrace, start, 1);
    return;
  }
  if (current == 44) {
    init_token(out, TokenKind::Comma, start, 1);
    return;
  }
  if (current == 59) {
    init_token(out, TokenKind::Semicolon, start, 1);
    return;
  }
  if (current == 91) {
    init_token(out, TokenKind::LeftBracket, start, 1);
    return;
  }
  if (current == 93) {
    init_token(out, TokenKind::RightBracket, start, 1);
    return;
  }
  if (current == 46) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 46) {
      scan.offset += 1;
      if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
        scan.offset += 1;
        init_token(out, TokenKind::DotDotEqual, start, 3);
        return;
      }
      init_token(out, TokenKind::DotDot, start, 2);
      return;
    }
    init_token(out, TokenKind::Dot, start, 1);
    return;
  }
  if (current == 58) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 58) {
      scan.offset += 1;
      init_token(out, TokenKind::ColonColon, start, 2);
      return;
    }
    init_token(out, TokenKind::Colon, start, 1);
    return;
  }
  if (current == 38) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 38) {
      scan.offset += 1;
      init_token(out, TokenKind::AmpAmp, start, 2);
      return;
    }
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::AmpersandEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Ampersand, start, 1);
    return;
  }
  if (current == 124) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 124) {
      scan.offset += 1;
      init_token(out, TokenKind::PipePipe, start, 2);
      return;
    }
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::PipeEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Pipe, start, 1);
    return;
  }
  if (current == 61) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::EqualEqual, start, 2);
      return;
    }
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 62) {
      scan.offset += 1;
      init_token(out, TokenKind::FatArrow, start, 2);
      return;
    }
    init_token(out, TokenKind::Equal, start, 1);
    return;
  }
  if (current == 33) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::BangEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Bang, start, 1);
    return;
  }
  if (current == 60) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 60) {
      scan.offset += 1;
      if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
        scan.offset += 1;
        init_token(out, TokenKind::LessLessEqual, start, 3);
        return;
      }
      init_token(out, TokenKind::LessLess, start, 2);
      return;
    }
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::LessEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Less, start, 1);
    return;
  }
  if (current == 62) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 62) {
      scan.offset += 1;
      if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
        scan.offset += 1;
        init_token(out, TokenKind::GreaterGreaterEqual, start, 3);
        return;
      }
      init_token(out, TokenKind::GreaterGreater, start, 2);
      return;
    }
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::GreaterEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Greater, start, 1);
    return;
  }
  if (current == 43) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::PlusEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Plus, start, 1);
    return;
  }
  if (current == 42) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::StarEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Star, start, 1);
    return;
  }
  if (current == 47) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::SlashEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Slash, start, 1);
    return;
  }
  if (current == 37) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::PercentEqual, start, 2);
      return;
    }
    init_token(out, TokenKind::Percent, start, 1);
    return;
  }
  if (current == 94) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 61) {
      scan.offset += 1;
      init_token(out, TokenKind::CaretEqual, start, 2);
