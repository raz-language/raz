fn token_is_numeric_type(Source& source, i64 offset, i64 length) -> bool {
  if (length == 2) {
    i64 first = source_byte(source, offset);
    i64 second = source_byte(source, offset + 1);

    return (first == 105 || first == 117) && second == 56;
  }
  if (length == 3) {
    i64 first = source_byte(source, offset);
    i64 second = source_byte(source, offset + 1);
    i64 third = source_byte(source, offset + 2);

    if ((first == 105 || first == 117) && second == 49 && third == 54) {
      return true;
    }
    if ((first == 105 || first == 117 || first == 102) && second == 51 && third == 50) {
      return true;
    }
    if ((first == 105 || first == 117 || first == 102) && second == 54 && third == 52) {
      return true;
    }
    if (first == 105 && second == 110 && third == 116) {
      return true;
    }
  }
  if (length == 4) {
    bool uint_name =
    source_byte(source, offset) == 117 &&
    source_byte(source, offset + 1) == 105 &&
    source_byte(source, offset + 2) == 110 &&
    source_byte(source, offset + 3) == 116;
    bool byte_name =
    source_byte(source, offset) == 98 &&
    source_byte(source, offset + 1) == 121 &&
    source_byte(source, offset + 2) == 116 &&
    source_byte(source, offset + 3) == 101;
    return uint_name || byte_name;
  }
  if (length == 5) {
    bool usize_name =
    source_byte(source, offset) == 117 &&
    source_byte(source, offset + 1) == 115 &&
    source_byte(source, offset + 2) == 105 &&
    source_byte(source, offset + 3) == 122 &&
    source_byte(source, offset + 4) == 101;
    bool isize_name =
    source_byte(source, offset) == 105 &&
    source_byte(source, offset + 1) == 115 &&
    source_byte(source, offset + 2) == 105 &&
    source_byte(source, offset + 3) == 122 &&
    source_byte(source, offset + 4) == 101;
    return usize_name || isize_name;
  }
  return false;
}

fn token_is_string_type(Source& source, i64 offset, i64 length) -> bool {
  return (
  length == 6 &&
