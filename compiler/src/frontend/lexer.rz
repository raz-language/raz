fn token_is_scalar_type(Source& source, i64 offset, i64 length) -> bool {
  if (token_is_numeric_type(source, offset, length) || token_is_string_type(source, offset, length)) {
    return true;
  }
  if (
  length == 4 &&
  source_byte(source, offset) == 98 &&
  source_byte(source, offset + 1) == 111 &&
  source_byte(source, offset + 2) == 111 &&
  source_byte(source, offset + 3) == 108
  ) {
    return true;
  }
  return (
  length == 4 &&
  source_byte(source, offset) == 99 &&
  source_byte(source, offset + 1) == 104 &&
  source_byte(source, offset + 2) == 97 &&
  source_byte(source, offset + 3) == 114
  );
}

