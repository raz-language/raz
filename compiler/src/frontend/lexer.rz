      return;
    }
    init_token(out, TokenKind::Minus, start, 1);
    return;
  }
  set_diagnostic(&mut scan.last_error, DiagnosticCode::InvalidByte, start);
  init_token(out, TokenKind::Unknown, start, 1);
}

fn token_count(Source input) -> i64 {
  Lexer scan;

  init_lexer(&mut scan, input);

  Token item;
  i64 count = 0;

  while (true) {
    next_token(&mut scan, &mut item);
    if (item.kind == TokenKind::End) {
      return count;
    }
    if (item.kind == TokenKind::Unknown) {
      return -1;
    }
    count += 1;
  }
  return -1;
}

fn qualify_extended_lexer() -> bool {
  i64 data = raz_rt_stage1_arena_create(27);

  if (data == 0) {
    return false;
  }

  i64 seed[27] = [91, 32, 93, 32, 46, 32, 58, 32, 38, 32, 124, 32, 33, 32, 38, 38, 32, 124, 124, 32, 43, 61, 32, 45, 61, 32, 10];
  i64 index = 0;

  while (index < 27) {
    raz_rt_stage1_arena_set(data, index, seed[index]);
    index += 1;
  }

  Source input;

  input.bytes = data;
  input.length = 27;

  bool passed = token_count(input) == 11;

  raz_rt_stage1_arena_destroy(data);
  return passed;
}

fn token_is_fn(Source& source, Token& token) -> bool {
  return (
  token.length == 2 &&
  source_byte(source, token.offset) == 102 &&
  source_byte(source, token.offset + 1) == 110
  );
}

fn token_is_public(Source& source, Token& token) -> bool {
  return (
  token.length == 6 &&
  source_byte(source, token.offset) == 112 &&
