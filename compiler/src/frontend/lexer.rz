fn token_is_thread_local(Source& source, Token& token) -> bool {
  return (
  token.length == 12 &&
  source_byte(source, token.offset) == 116 &&
  source_byte(source, token.offset + 1) == 104 &&
  source_byte(source, token.offset + 2) == 114 &&
  source_byte(source, token.offset + 3) == 101 &&
  source_byte(source, token.offset + 4) == 97 &&
  source_byte(source, token.offset + 5) == 100 &&
