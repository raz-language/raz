    }
    init_token(out, TokenKind::Caret, start, 1);
    return;
  }
  if (current == 126) {
    init_token(out, TokenKind::Tilde, start, 1);
    return;
  }
  if (current == 63) {
    init_token(out, TokenKind::Question, start, 1);
    return;
  }
  if (current == 64) {
    init_token(out, TokenKind::At, start, 1);
    return;
  }
  if (current == 45) {
    if (scan.offset < scan.input.length && source_byte(&scan.input, scan.offset) == 62) {
      scan.offset += 1;
      init_token(out, TokenKind::Arrow, start, 2);
