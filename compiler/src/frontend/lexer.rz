fn token_is_raz_package(Source& source, Token& token) -> bool {
  i64 expected[13] = [95, 95, 114, 97, 122, 95, 112, 97, 99, 107, 97, 103, 101];

  if (token.length != 13) {
    return false;
  }

  i64 index = 0;

  while (index < 13) {
    if (source_byte(source, token.offset + index) != expected[index]) {
      return false;
    }
    index += 1;
  }
  return true;
}

fn token_is_raz_module(Source& source, Token& token) -> bool {
  i64 expected[12] = [95, 95, 114, 97, 122, 95, 109, 111, 100, 117, 108, 101];

  if (token.length != 12) {
    return false;
  }

  i64 index = 0;

  while (index < 12) {
    if (source_byte(source, token.offset + index) != expected[index]) {
