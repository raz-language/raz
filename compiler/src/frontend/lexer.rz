fn token_extern_kind(Source& source, Token& token) -> i64 {
  if (token.length == 27 && source_byte(source, token.offset + 21) == 99) {
    return 1;
  }
  if (token.length == 28 && source_byte(source, token.offset + 21) == 100) {
    return 2;
  }
  if (token.length == 24 && source_byte(source, token.offset + 21) == 103) {
    return 3;
  }
  if (token.length == 24 && source_byte(source, token.offset + 21) == 115) {
    return 4;
  }
  if (token.length == 26 && source_byte(source, token.offset + 15) == 119) {
    return 5;
  }
  if (token.length == 25 && source_byte(source, token.offset + 15) == 114) {
    return 6;
  }
  if (token.length == 23 && source_byte(source, token.offset + 8) == 119) {
    return 5;
  }
  if (token.length == 22 && source_byte(source, token.offset + 8) == 114) {
    return 6;
  }
  return 0;
}

fn token_same(Source& source, i64 left_offset, i64 left_length, i64 right_offset, i64 right_length) -> bool {
  if (left_length != right_length) {
    return false;
  }
  return raz_rt_stage1_arena_range_equal(source.bytes, left_offset, right_offset, left_length) != 0;
}
