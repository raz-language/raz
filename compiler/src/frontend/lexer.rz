namespace raz_compiler_frontend_lexer;
// Token definitions and scanner utilities live here. Keep this layer small and
// allocation-light; every compiler phase starts by walking these tokens.
public enum TokenKind {
  End,
  Identifier,
  Integer,
  Float,
  LeftParen,
  RightParen,
  LeftBrace,
  RightBrace,
  LeftBracket,
  RightBracket,
  Comma,
  Semicolon,
  Dot,
  Colon,
  Ampersand,
  Pipe,
  Bang,
  Equal,
  EqualEqual,
  BangEqual,
  Arrow,
  Plus,
  PlusEqual,
  Minus,
  MinusEqual,
  Star,
  StarEqual,
  Slash,
  SlashEqual,
  Percent,
  PercentEqual,
  Less,
  LessEqual,
  LessLess,
  LessLessEqual,
  Greater,
  GreaterEqual,
  GreaterGreater,
  GreaterGreaterEqual,
  AmpAmp,
  AmpersandEqual,
  PipePipe,
  PipeEqual,
  Caret,
  CaretEqual,
  Tilde,
  String,
  Character,
  ColonColon,
  FatArrow,
  DotDot,
  DotDotEqual,
  Question,
  At,
  Lifetime,
  Unknown,
}

public enum DiagnosticCode {
  None,
  InvalidByte,
  ExpectedToken,
  ExpectedIdentifier,
  TooManyItems,
  UnknownName,
  DuplicateName,
  UnknownType,
  WrongArgumentCount,
  MissingReturn,
  InvalidMove,
  UseAfterMove,
  BorrowConflict,
  AmbiguousName,
}

public struct Token {
  TokenKind kind;
  i64 offset;
  i64 length;
}

public struct Diagnostic {
  DiagnosticCode code;
  i64 offset;
}

public struct Source {
  i64 bytes;
  i64 length;
}

public struct Lexer {
  Source input;
  i64 offset;
  Diagnostic last_error;
}

public struct ModuleSyntax {
  i64 function_count;
  i64 parameter_count;
  i64 local_count;
  i64 expression_count;
  i64 diagnostic_count;
  DiagnosticCode diagnostic_code;
  i64 diagnostic_offset;
  i64 complex_source_mode;
  i64 function_name_offsets;
  i64 function_name_lengths;
  i64 function_parameter_starts;
  i64 function_parameter_counts;
  i64 function_statement_counts;
  i64 function_return_type_offsets;
  i64 function_return_type_lengths;
  i64 function_return_reference;
  i64 function_return_mutable;
  i64 function_has_return_type;
  i64 function_is_extern;
  i64 parameter_type_offsets;
  i64 parameter_type_lengths;
  i64 parameter_name_offsets;
  i64 parameter_name_lengths;
  i64 parameter_reference;
  i64 parameter_mutable;
  i64 local_name_offsets;
  i64 local_name_lengths;
  i64 local_function_indices;
}

