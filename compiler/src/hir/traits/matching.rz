namespace raz_compiler_hir_traits_matching;
public import raz_compiler_hir_query_identity;
import raz_compiler_hir_generics_type_instantiation;

fn hir_generic_trait_pattern_parameter(
HirBuilder&mut builder,
Token& current,
i64 parameter_count,
i64 parameter_offsets,
i64 parameter_lengths,
) -> i64 {
  i64 index = 0;

  while (index < parameter_count) {
    if (
    token_same(
    &builder.scan.input,
    raz_compiler_rt_arena_get(parameter_offsets, index),
    raz_compiler_rt_arena_get(parameter_lengths, index),
    current.offset,
    current.length,
    )
    ) {
      return index;
    }
    index += 1;
  }
  return -1;
}

fn hir_match_generic_trait_pattern_type(
HirBuilder&mut builder,
Lexer&mut scan,
Token&mut current,
i64 concrete_structure,
i64 concrete_type,
i64 parameter_count,
i64 parameter_offsets,
i64 parameter_lengths,
i64 parameter_kinds,
i64 capture_structures,
i64 capture_types,
i64 capture_flags,
) -> bool {
  if (current.kind == TokenKind::Integer) {
    if (concrete_structure != -2 || concrete_type != parse_integer_value(&builder.scan.input, current)) {
      return false;
    }
    next_token(scan, current);
    return true;
  }
  if (current.kind != TokenKind::Identifier) {
    return false;
  }
  i64 parameter = hir_generic_trait_pattern_parameter(
  builder,
  current,
  parameter_count,
  parameter_offsets,
  parameter_lengths,
  );
  if (parameter >= 0) {
    i64 parameter_kind = raz_compiler_rt_arena_get(parameter_kinds, parameter);

    if (parameter_kind == 2 && concrete_structure != -2) {
      return false;
    }
    if (parameter_kind == 0 && concrete_structure == -2) {
      return false;
    }
    if (raz_compiler_rt_arena_get(capture_flags, parameter) != 0) {
      if (
      raz_compiler_rt_arena_get(capture_structures, parameter) != concrete_structure ||
      raz_compiler_rt_arena_get(capture_types, parameter) != concrete_type
      ) {
        return false;
      }
    } else {
      raz_compiler_rt_arena_set(capture_flags, parameter, 1);
      raz_compiler_rt_arena_set(capture_structures, parameter, concrete_structure);
      raz_compiler_rt_arena_set(capture_types, parameter, concrete_type);
    }
    next_token(scan, current);
    return true;
  }

  i64 generic_structure = hir_find_generic_struct(builder, current.offset, current.length);

  if (generic_structure >= 0) {
    if (
    concrete_structure < 0 ||
    raz_compiler_rt_arena_get(
    builder.module.struct_generic_template_indices,
    concrete_structure,
    ) != generic_structure
    ) {
      return false;
    }
    next_token(scan, current);
    if (current.kind != TokenKind::Less) {
      return false;
    }
    next_token(scan, current);
    i64 argument_start = raz_compiler_rt_arena_get(
    builder.module.struct_generic_argument_starts,
    concrete_structure,
    );
    i64 argument_count = raz_compiler_rt_arena_get(
    builder.module.struct_generic_argument_counts,
    concrete_structure,
    );

    i64 argument = 0;

    while (argument < argument_count) {
      if (
      !hir_match_generic_trait_pattern_type(
      builder,
      scan,
      current,
      raz_compiler_rt_arena_get(
      builder.module.struct_generic_argument_type_structs,
      argument_start + argument,
      ),
      raz_compiler_rt_arena_get(
      builder.module.struct_generic_argument_types,
      argument_start + argument,
      ),
      parameter_count,
      parameter_offsets,
      parameter_lengths,
      parameter_kinds,
      capture_structures,
      capture_types,
      capture_flags,
      )
      ) {
        return false;
      }
      argument += 1;
      if (argument < argument_count) {
        if (current.kind != TokenKind::Comma) {
          return false;
        }
        next_token(scan, current);
      }
    }
    if (current.kind != TokenKind::Greater) {
      return false;
    }
    next_token(scan, current);
    return true;
  }

  i64 named_structure = hir_find_struct(builder, current.offset, current.length);

  if (named_structure >= 0) {
    if (concrete_structure != named_structure) {
      return false;
    }
    next_token(scan, current);
    return true;
  }
  if (token_is_scalar_type(&builder.scan.input, current.offset, current.length)) {
    if (
    concrete_structure >= 0 ||
    concrete_structure == -2 ||
    concrete_type != primitive_type_kind(&builder.scan.input, current.offset, current.length)
    ) {
      return false;
    }
    next_token(scan, current);
    return true;
  }
  return false;
}

fn hir_generic_trait_impl_applies(
HirBuilder&mut builder,
i64 generic_trait,
i64 structure,
i64&mut primary_structure,
i64&mut primary_type,
) -> bool {
  *primary_structure = -1;
  *primary_type = 0;
  if (generic_trait < 0 || generic_trait >= builder.module.generic_trait_impl_count || structure < 0) {
    return false;
  }

  i64 parameter_offsets = raz_compiler_rt_arena_create(8);
  i64 parameter_lengths = raz_compiler_rt_arena_create(8);
  i64 parameter_kinds = raz_compiler_rt_arena_create(8);
  i64 capture_structures = raz_compiler_rt_arena_create(8);
  i64 capture_types = raz_compiler_rt_arena_create(8);
  i64 capture_flags = raz_compiler_rt_arena_create(8);

  if (
  parameter_offsets == 0 ||
  parameter_lengths == 0 ||
  parameter_kinds == 0 ||
  capture_structures == 0 ||
  capture_types == 0 ||
  capture_flags == 0
  ) {
    return false;
  }

  Lexer scan;

  scan.input = builder.scan.input;
  scan.offset = raz_compiler_rt_arena_get(builder.module.generic_trait_source_offsets, generic_trait);
  clear_diagnostic(&mut scan.last_error);

  Token current;

  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::Identifier || !token_is_impl(&builder.scan.input, &current)) {
    return false;
  }
  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::Less) {
    return false;
  }
  next_token(&mut scan, &mut current);

  i64 parameter_count = 0;
  bool parsing_parameters = true;

  while (parsing_parameters) {
    if (parameter_count >= 8) {
      return false;
    }

    i64 kind = 0;

    if (current.kind == TokenKind::Identifier && token_is_const(&builder.scan.input, &current)) {
      kind = 2;
      next_token(&mut scan, &mut current);
      if (current.kind != TokenKind::Identifier) {
        return false;
      }
      next_token(&mut scan, &mut current);
    }
    if (current.kind != TokenKind::Identifier) {
      return false;
    }
    raz_compiler_rt_arena_set(parameter_offsets, parameter_count, current.offset);
    raz_compiler_rt_arena_set(parameter_lengths, parameter_count, current.length);
    raz_compiler_rt_arena_set(parameter_kinds, parameter_count, kind);
    parameter_count += 1;
    next_token(&mut scan, &mut current);
    if (current.kind == TokenKind::Colon) {
      next_token(&mut scan, &mut current);
      while (
      current.kind != TokenKind::Comma &&
      current.kind != TokenKind::Greater &&
      current.kind != TokenKind::End
      ) {
        next_token(&mut scan, &mut current);
      }
    }
    if (current.kind == TokenKind::Comma) {
      next_token(&mut scan, &mut current);
    } else {
      parsing_parameters = false;
    }
  }
  if (current.kind != TokenKind::Greater) {
    return false;
  }
  next_token(&mut scan, &mut current);
  while (
  current.kind != TokenKind::End &&
  !(current.kind == TokenKind::Identifier && token_is_for(&builder.scan.input, &current))
  ) {
    next_token(&mut scan, &mut current);
  }
  if (current.kind == TokenKind::End) {
    return false;
  }
  next_token(&mut scan, &mut current);
  bool matched = hir_match_generic_trait_pattern_type(
  builder,
  &mut scan,
  &mut current,
  structure,
  0,
  parameter_count,
  parameter_offsets,
  parameter_lengths,
  parameter_kinds,
  capture_structures,
  capture_types,
  capture_flags,
  );
  if (matched) {
    i64 primary_offset = raz_compiler_rt_arena_get(
    builder.module.generic_trait_type_name_offsets,
    generic_trait,
    );
    i64 primary_length = raz_compiler_rt_arena_get(
    builder.module.generic_trait_type_name_lengths,
    generic_trait,
    );

    i64 index = 0;
    bool found = false;

    while (index < parameter_count) {
      if (
      token_same(
      &builder.scan.input,
      primary_offset,
      primary_length,
      raz_compiler_rt_arena_get(parameter_offsets, index),
      raz_compiler_rt_arena_get(parameter_lengths, index),
      )
      ) {
        if (raz_compiler_rt_arena_get(capture_flags, index) == 0) {
          matched = false;
        } else {
          *primary_structure = raz_compiler_rt_arena_get(capture_structures, index);
          *primary_type = raz_compiler_rt_arena_get(capture_types, index);
          found = true;
        }
        index = parameter_count;
      } else {
        index += 1;
      }
    }
    if (!found) {
      matched = false;
    }
  }
  raz_compiler_rt_arena_destroy(parameter_offsets);
  raz_compiler_rt_arena_destroy(parameter_lengths);
  raz_compiler_rt_arena_destroy(parameter_kinds);
  raz_compiler_rt_arena_destroy(capture_structures);
  raz_compiler_rt_arena_destroy(capture_types);
  raz_compiler_rt_arena_destroy(capture_flags);
  return matched;
}

fn hir_generic_inherent_signature_type(
HirBuilder&mut builder,
Lexer&mut scan,
Token&mut current,
i64 generic_impl,
i64 concrete_structure,
i64 concrete_child_structure,
i64 concrete_child_type,
i64&mut out_structure,
i64&mut out_type,
i64&mut out_reference,
i64&mut out_slice,
i64&mut out_slice_mutable,
) -> bool {
  *out_structure = -1;
  *out_type = 0;
  *out_reference = 0;
  *out_slice = 0;
  *out_slice_mutable = 0;
  if (current.kind != TokenKind::Identifier) {
    return false;
  }
  i64 type_name_offset = raz_compiler_rt_arena_get(
  builder.module.generic_inherent_type_name_offsets,
  generic_impl,
  );
  i64 type_name_length = raz_compiler_rt_arena_get(
  builder.module.generic_inherent_type_name_lengths,
  generic_impl,
  );
  i64 target_template = raz_compiler_rt_arena_get(
  builder.module.generic_inherent_struct_templates,
  generic_impl,
  );

  i64 target_name_offset = 0;
  i64 target_name_length = 0;

  if (target_template >= 0) {
    target_name_offset = raz_compiler_rt_arena_get(
    builder.module.generic_struct_name_offsets,
    target_template,
    );
    target_name_length = raz_compiler_rt_arena_get(
    builder.module.generic_struct_name_lengths,
    target_template,
    );
  } else {
    i64 generic_enum = -2 - target_template;

    target_name_offset = raz_compiler_rt_arena_get(builder.module.generic_enum_name_offsets, generic_enum);
    target_name_length = raz_compiler_rt_arena_get(builder.module.generic_enum_name_lengths, generic_enum);
  }
  if (token_same(&builder.scan.input, type_name_offset, type_name_length, current.offset, current.length)) {
    *out_structure = concrete_child_structure;
    *out_type = concrete_child_type;
    next_token(scan, current);
  } else if (
  token_same(
  &builder.scan.input,
  target_name_offset,
  target_name_length,
  current.offset,
  current.length,
  )
  ) {
    next_token(scan, current);
    if (current.kind != TokenKind::Less) {
      return false;
    }
    // The receiver names the concrete generic target. Its source pattern may
    // contain multiple, const, or nested arguments (for example
    // Pair<T, i64>, Buffer<T, N>, Wrapper<Pair<T, i64>>). Signature
    // reservation only needs the already-instantiated concrete identity, so
    // consume the balanced source argument list rather than assuming <T>.

    i64 depth = 1;

    next_token(scan, current);
    while (current.kind != TokenKind::End && depth > 0) {
      if (current.kind == TokenKind::Less) {
        depth += 1;
      } else if (current.kind == TokenKind::Greater) {
        depth -= 1;
        if (depth == 0) {
          next_token(scan, current);
          break;
        }
      }
      if (depth > 0) {
        next_token(scan, current);
      }
    }
    if (depth != 0) {
      return false;
    }
    if (concrete_structure >= 0) {
      *out_structure = concrete_structure;
    } else {
      i64 concrete_enum = -2 - concrete_structure;

      *out_structure = -1;
      *out_type = hir_enum_value_type_kind(builder, concrete_enum);
    }
  } else {
    *out_structure = hir_find_struct(builder, current.offset, current.length);
    *out_type = primitive_type_kind(&builder.scan.input, current.offset, current.length);
    if (
    *out_structure < 0 &&
    !token_is_scalar_type(&builder.scan.input, current.offset, current.length)
    ) {
      return false;
    }
    next_token(scan, current);
  }
  if (current.kind == TokenKind::LeftBracket) {
    i64 saved_scan_offset = scan.offset;
    i64 bracket_offset = current.offset;
    i64 bracket_length = current.length;

    next_token(scan, current);
    if (current.kind == TokenKind::RightBracket) {
      *out_slice = 1;
      next_token(scan, current);
      if (current.kind == TokenKind::Identifier && token_is_mut(&builder.scan.input, current)) {
        *out_slice_mutable = 1;
        next_token(scan, current);
      }
    } else {
      scan.offset = saved_scan_offset;
      init_token(current, TokenKind::LeftBracket, bracket_offset, bracket_length);
    }
  }
  if (current.kind == TokenKind::Ampersand) {
    *out_reference = 1;
    next_token(scan, current);
    if (current.kind == TokenKind::Identifier && token_is_mut(&builder.scan.input, current)) {
      next_token(scan, current);
    }
  } else if (current.kind == TokenKind::Star) {
    next_token(scan, current);
    if (current.kind != TokenKind::Identifier) {
      return false;
    }
    if (token_is_const(&builder.scan.input, current)) {
      *out_reference = 2;
    } else if (token_is_mut(&builder.scan.input, current)) {
      *out_reference = 3;
    } else {
      return false;
    }
    next_token(scan, current);
  }
  return true;
}

fn hir_reserve_trait_default_method(HirBuilder&mut builder, i64 structure, i64 trait_method) -> bool {
  if (raz_compiler_rt_arena_get(builder.module.trait_method_default_flags, trait_method) == 0) {
    return true;
  }

  i64 name_offset = raz_compiler_rt_arena_get(builder.module.trait_method_name_offsets, trait_method);
  i64 name_length = raz_compiler_rt_arena_get(builder.module.trait_method_name_lengths, trait_method);

  if (hir_find_inherent_method(builder, structure, name_offset, name_length) >= 0) {
    return true;
  }
  if (
  builder.module.function_count >= 16384 ||
  builder.module.inherent_method_count >= 8192 ||
  builder.module.parameter_count >= 32768
  ) {
    hir_fail(builder, DiagnosticCode::TooManyItems);
    return false;
  }

  Lexer scan;

  scan.input = builder.scan.input;
  scan.offset = raz_compiler_rt_arena_get(builder.module.trait_method_source_offsets, trait_method);
  clear_diagnostic(&mut scan.last_error);

  Token current;

  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::Identifier || !token_is_fn(&builder.scan.input, &current)) {
    return false;
  }
  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::Identifier) {
    return false;
  }
  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::LeftParen) {
    return false;
  }

  i64 function_index = builder.module.function_count;

  builder.module.function_count += 1;
  raz_compiler_rt_arena_set(builder.module.function_name_offsets, function_index, name_offset);
  raz_compiler_rt_arena_set(builder.module.function_name_lengths, function_index, name_length);
  raz_compiler_rt_arena_set(
  builder.module.function_parameter_starts,
  function_index,
  builder.module.parameter_count,
  );
  raz_compiler_rt_arena_set(builder.module.function_parameter_counts, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_local_starts, function_index, builder.module.local_count);
  raz_compiler_rt_arena_set(builder.module.function_local_counts, function_index, 0);
  raz_compiler_rt_arena_set(
  builder.module.function_statement_starts,
  function_index,
  builder.module.statement_count,
  );
  raz_compiler_rt_arena_set(builder.module.function_statement_counts, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_is_extern, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_is_unsafe, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_extern_kinds, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_return_types, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_returns_value, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_return_references, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_return_type_structs, function_index, -1);
  raz_compiler_rt_arena_set(builder.module.function_return_slices, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_return_slice_mutable, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_return_lifetimes, function_index, -1);
  raz_compiler_rt_arena_set(builder.module.function_return_function_types, function_index, -1);
  raz_compiler_rt_arena_set(builder.module.function_drop_structs, function_index, -1);
  raz_compiler_rt_arena_set(builder.module.function_clone_structs, function_index, -1);
  raz_compiler_rt_arena_set(builder.module.function_inherent_structs, function_index, structure);
  raz_compiler_rt_arena_set(
  builder.module.function_inherent_source_offsets,
  function_index,
  raz_compiler_rt_arena_get(builder.module.trait_method_source_offsets, trait_method),
  );
  raz_compiler_rt_arena_set(builder.module.function_inherent_body_parsed, function_index, 0);
  raz_compiler_rt_arena_set(builder.module.function_trait_default_methods, function_index, trait_method + 1);
  raz_compiler_rt_arena_set(
  builder.module.function_generic_template_indices,
  function_index,
  raz_compiler_rt_arena_get(builder.module.struct_generic_template_indices, structure),
  );
  raz_compiler_rt_arena_set(builder.module.function_generic_body_parsed, function_index, 1);
  raz_compiler_rt_arena_set(builder.module.function_defer_starts, function_index, builder.module.defer_count);
  raz_compiler_rt_arena_set(builder.module.function_defer_counts, function_index, 0);
  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::Identifier || !token_is_self_type(&builder.scan.input, &current)) {
    return false;
  }
  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::Ampersand) {
    return false;
  }
  next_token(&mut scan, &mut current);

  i64 reference_mutable = 0;

  if (current.kind == TokenKind::Identifier && token_is_mut(&builder.scan.input, &current)) {
    reference_mutable = 1;
    next_token(&mut scan, &mut current);
  }
  if (current.kind != TokenKind::Identifier) {
    return false;
  }

  i64 parameter = builder.module.parameter_count;

  builder.module.parameter_count += 1;
  raz_compiler_rt_arena_set(builder.module.parameter_name_offsets, parameter, current.offset);
  raz_compiler_rt_arena_set(builder.module.parameter_name_lengths, parameter, current.length);
  raz_compiler_rt_arena_set(builder.module.parameter_function_indices, parameter, function_index);
  raz_compiler_rt_arena_set(builder.module.parameter_type_structs, parameter, structure);
  raz_compiler_rt_arena_set(builder.module.parameter_types, parameter, 0);
  raz_compiler_rt_arena_set(builder.module.parameter_references, parameter, 1);
  raz_compiler_rt_arena_set(builder.module.parameter_reference_mutable, parameter, reference_mutable);
  raz_compiler_rt_arena_set(builder.module.parameter_slices, parameter, 0);
  raz_compiler_rt_arena_set(builder.module.parameter_slice_mutable, parameter, 0);
  raz_compiler_rt_arena_set(builder.module.parameter_function_types, parameter, -1);
  raz_compiler_rt_arena_set(builder.module.function_parameter_counts, function_index, 1);
  next_token(&mut scan, &mut current);
  if (current.kind != TokenKind::RightParen) {
    return false;
  }
  next_token(&mut scan, &mut current);
  if (current.kind == TokenKind::Arrow) {
    next_token(&mut scan, &mut current);
    if (current.kind != TokenKind::Identifier) {
      return false;
    }

    i64 rs = hir_find_struct(builder, current.offset, current.length);
    i64 rt = primitive_type_kind(&builder.scan.input, current.offset, current.length);

    if (rs < 0 && !token_is_scalar_type(&builder.scan.input, current.offset, current.length)) {
      return false;
    }
    raz_compiler_rt_arena_set(builder.module.function_returns_value, function_index, 1);
    raz_compiler_rt_arena_set(builder.module.function_return_type_structs, function_index, rs);
    raz_compiler_rt_arena_set(builder.module.function_return_types, function_index, rt);
    next_token(&mut scan, &mut current);
  }
  if (current.kind != TokenKind::LeftBrace) {
    return false;
  }

  i64 method = builder.module.inherent_method_count;

  builder.module.inherent_method_count += 1;
  raz_compiler_rt_arena_set(builder.module.inherent_method_structures, method, structure);
  raz_compiler_rt_arena_set(builder.module.inherent_method_name_offsets, method, name_offset);
  raz_compiler_rt_arena_set(builder.module.inherent_method_name_lengths, method, name_length);
  raz_compiler_rt_arena_set(builder.module.inherent_method_functions, method, function_index);
  raz_compiler_rt_arena_set(builder.module.inherent_method_receivers, method, 1);
  return true;
}

fn hir_reserve_generic_inherent_methods(HirBuilder&mut builder, i64 structure) -> bool {
  i64 target_template = -1;
  i64 concrete_child_structure = -1;
  i64 concrete_child_type = 0;

  if (structure >= 0) {
    i64 generic_struct = raz_compiler_rt_arena_get(
    builder.module.struct_generic_template_indices,
    structure,
    );
    if (generic_struct < 0) {
      return true;
    }
    target_template = generic_struct;
    concrete_child_structure = raz_compiler_rt_arena_get(
    builder.module.struct_generic_type_structs,
    structure,
    );
    concrete_child_type = raz_compiler_rt_arena_get(builder.module.struct_generic_types, structure);
  } else if (structure <= -2) {
    i64 enumeration = -2 - structure;

    if (enumeration < 0 || enumeration >= builder.module.enum_count) {
      return true;
    }

    i64 generic_enum = raz_compiler_rt_arena_get(builder.module.enum_generic_template_indices, enumeration);

    if (generic_enum < 0) {
      return true;
    }
    target_template = -2 - generic_enum;
    i64 parameter_start = raz_compiler_rt_arena_get(
    builder.module.generic_enum_parameter_starts,
    generic_enum,
    );
    i64 parameter_count = raz_compiler_rt_arena_get(
    builder.module.generic_enum_parameter_counts,
    generic_enum,
    );
    i64 argument_start = raz_compiler_rt_arena_get(
    builder.module.enum_generic_argument_starts,
    enumeration,
    );

    i64 index = 0;

    while (index < parameter_count) {
      if (
      raz_compiler_rt_arena_get(builder.module.generic_parameter_kinds, parameter_start + index) == 0
      ) {
        concrete_child_structure = raz_compiler_rt_arena_get(
        builder.module.enum_generic_argument_type_structs,
        argument_start + index,
        );
        concrete_child_type = raz_compiler_rt_arena_get(
        builder.module.enum_generic_argument_types,
        argument_start + index,
        );
        if (concrete_child_structure < 0 && concrete_child_type == 16) {
          concrete_child_type = 0;
        }
        index = parameter_count;
      } else {
        index += 1;
      }
    }
  } else {
    return true;
  }

  i64 generic_impl = 0;

  while (generic_impl < builder.module.generic_inherent_impl_count) {
    if (
    raz_compiler_rt_arena_get(
    builder.module.generic_inherent_struct_templates,
    generic_impl,
    ) == target_template
    ) {
      i64 generic_trait = -1;
      i64 trait_candidate = 0;

      while (trait_candidate < builder.module.generic_trait_impl_count) {
        if (
        raz_compiler_rt_arena_get(
        builder.module.generic_trait_source_offsets,
        trait_candidate,
        ) == raz_compiler_rt_arena_get(builder.module.generic_inherent_source_offsets, generic_impl)
        ) {
          generic_trait = trait_candidate;
        }
        trait_candidate += 1;
      }
      if (generic_trait >= 0 && structure >= 0) {
        i64 child_structure = -1;
        i64 child_type = 0;

        bool applicable = hir_generic_trait_impl_applies(
        builder,
        generic_trait,
        structure,
        &mut child_structure,
        &mut child_type,
        );
        i64 bound_count = raz_compiler_rt_arena_get(
        builder.module.generic_trait_bound_counts,
        generic_trait,
        );

        i64 bound_index = 0;

        while (applicable && bound_index < bound_count) {
          applicable = hir_type_satisfies_bound(
          builder,
          child_structure,
          child_type,
          raz_compiler_rt_arena_get(
          builder.module.generic_trait_bounds,
          generic_trait * 8 + bound_index,
          ),
          );
          bound_index += 1;
        }
        if (!applicable) {
          generic_impl += 1;
          continue;
        }

        i64 trait_index = raz_compiler_rt_arena_get(builder.module.generic_trait_traits, generic_trait);

        if (hir_find_trait_impl(builder, trait_index, structure) < 0) {
          if (builder.module.trait_impl_count >= 4096) {
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
          }

          i64 concrete_impl = builder.module.trait_impl_count;

          builder.module.trait_impl_count += 1;
          raz_compiler_rt_arena_set(builder.module.trait_impl_traits, concrete_impl, trait_index);
          raz_compiler_rt_arena_set(builder.module.trait_impl_structures, concrete_impl, structure);
          raz_compiler_rt_arena_set(
          builder.module.trait_impl_source_offsets,
          concrete_impl,
          raz_compiler_rt_arena_get(builder.module.generic_trait_source_offsets, generic_trait),
          );
          raz_compiler_rt_arena_set(
          builder.module.trait_impl_generic_indices,
          concrete_impl,
          generic_trait,
          );
        }
      }

      Lexer scan;

      scan.input = builder.scan.input;
      scan.offset = raz_compiler_rt_arena_get(
      builder.module.generic_inherent_source_offsets,
      generic_impl,
      );
      clear_diagnostic(&mut scan.last_error);

      Token current;

      next_token(&mut scan, &mut current);
      while (current.kind != TokenKind::LeftBrace && current.kind != TokenKind::End) {
        next_token(&mut scan, &mut current);
      }
      if (current.kind != TokenKind::LeftBrace) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
      }
      next_token(&mut scan, &mut current);
      while (current.kind != TokenKind::RightBrace) {
        if (
        current.kind == TokenKind::Identifier &&
        (
        token_is_type_keyword(&builder.scan.input, &current) ||
        token_is_const(&builder.scan.input, &current)
        )
        ) {
          while (current.kind != TokenKind::Semicolon && current.kind != TokenKind::End) {
            next_token(&mut scan, &mut current);
          }
          if (current.kind != TokenKind::Semicolon) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
          }
          next_token(&mut scan, &mut current);
          continue;
        }
        if (
        current.kind != TokenKind::Identifier ||
        !token_is_fn(&builder.scan.input, &current) ||
        builder.module.function_count >= 16384 ||
        builder.module.inherent_method_count >= 8192
        ) {
          hir_fail(builder, DiagnosticCode::ExpectedToken);
          return false;
        }

        i64 method_source_offset = current.offset;

        next_token(&mut scan, &mut current);
        if (current.kind != TokenKind::Identifier) {
          hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
          return false;
        }

        i64 name_offset = current.offset;
        i64 name_length = current.length;

        if (hir_find_inherent_method(builder, structure, name_offset, name_length) >= 0) {
          hir_fail(builder, DiagnosticCode::DuplicateName);
          return false;
        }
        next_token(&mut scan, &mut current);
        if (current.kind != TokenKind::LeftParen) {
          hir_fail(builder, DiagnosticCode::ExpectedToken);
          return false;
        }

        i64 function_index = builder.module.function_count;

        builder.module.function_count += 1;
        raz_compiler_rt_arena_set(builder.module.function_name_offsets, function_index, name_offset);
        raz_compiler_rt_arena_set(builder.module.function_name_lengths, function_index, name_length);
        raz_compiler_rt_arena_set(
        builder.module.function_parameter_starts,
        function_index,
        builder.module.parameter_count,
        );
        raz_compiler_rt_arena_set(builder.module.function_parameter_counts, function_index, 0);
        raz_compiler_rt_arena_set(
        builder.module.function_local_starts,
        function_index,
        builder.module.local_count,
        );
        raz_compiler_rt_arena_set(builder.module.function_local_counts, function_index, 0);
        raz_compiler_rt_arena_set(
        builder.module.function_statement_starts,
        function_index,
        builder.module.statement_count,
        );
        raz_compiler_rt_arena_set(builder.module.function_statement_counts, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_is_extern, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_is_unsafe, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_extern_kinds, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_return_types, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_returns_value, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_return_references, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_return_type_structs, function_index, -1);
        raz_compiler_rt_arena_set(builder.module.function_return_slices, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_return_slice_mutable, function_index, 0);
        raz_compiler_rt_arena_set(builder.module.function_return_lifetimes, function_index, -1);
        raz_compiler_rt_arena_set(builder.module.function_return_function_types, function_index, -1);
        raz_compiler_rt_arena_set(builder.module.function_drop_structs, function_index, -1);
        raz_compiler_rt_arena_set(builder.module.function_clone_structs, function_index, -1);
        raz_compiler_rt_arena_set(builder.module.function_inherent_structs, function_index, structure);
        raz_compiler_rt_arena_set(
        builder.module.function_inherent_source_offsets,
        function_index,
        method_source_offset,
        );
        raz_compiler_rt_arena_set(builder.module.function_inherent_body_parsed, function_index, 0);

        i64 function_template = target_template;

        if (function_template < 0) {
          function_template = -2 - function_template;
        }
        raz_compiler_rt_arena_set(
        builder.module.function_generic_template_indices,
        function_index,
        function_template,
        );
        raz_compiler_rt_arena_set(
        builder.module.function_generic_type_structs,
        function_index,
        concrete_child_structure,
        );
        raz_compiler_rt_arena_set(
        builder.module.function_generic_types,
        function_index,
        concrete_child_type,
        );
        raz_compiler_rt_arena_set(builder.module.function_generic_body_parsed, function_index, 1);
        raz_compiler_rt_arena_set(
        builder.module.function_defer_starts,
        function_index,
        builder.module.defer_count,
        );
        raz_compiler_rt_arena_set(builder.module.function_defer_counts, function_index, 0);
        next_token(&mut scan, &mut current);
        if (current.kind != TokenKind::RightParen) {
          bool parameters = true;

          while (parameters) {
            i64 parameter_structure = -1;
            i64 parameter_type = 0;
            i64 parameter_reference = 0;
            i64 parameter_slice = 0;
            i64 parameter_slice_mutable = 0;

            if (
            !hir_generic_inherent_signature_type(
            builder,
            &mut scan,
            &mut current,
            generic_impl,
            structure,
            concrete_child_structure,
            concrete_child_type,
            &mut parameter_structure,
            &mut parameter_type,
            &mut parameter_reference,
            &mut parameter_slice,
            &mut parameter_slice_mutable,
            )
            ) {
              hir_fail(builder, DiagnosticCode::UnknownType);
              return false;
            }
            if (current.kind != TokenKind::Identifier || builder.module.parameter_count >= 32768) {
              hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
              return false;
            }

            i64 parameter = builder.module.parameter_count;

            builder.module.parameter_count += 1;
            raz_compiler_rt_arena_set(
            builder.module.parameter_name_offsets,
            parameter,
            current.offset,
            );
            raz_compiler_rt_arena_set(
            builder.module.parameter_name_lengths,
            parameter,
            current.length,
            );
            raz_compiler_rt_arena_set(
            builder.module.parameter_function_indices,
            parameter,
            function_index,
            );
            raz_compiler_rt_arena_set(
            builder.module.parameter_type_structs,
            parameter,
            parameter_structure,
            );
            raz_compiler_rt_arena_set(builder.module.parameter_types, parameter, parameter_type);
            raz_compiler_rt_arena_set(
            builder.module.parameter_references,
            parameter,
            parameter_reference,
            );
            raz_compiler_rt_arena_set(builder.module.parameter_slices, parameter, parameter_slice);
            raz_compiler_rt_arena_set(
            builder.module.parameter_slice_mutable,
            parameter,
            parameter_slice_mutable,
            );
            raz_compiler_rt_arena_set(builder.module.parameter_function_types, parameter, -1);
            raz_compiler_rt_arena_set(
            builder.module.function_parameter_counts,
            function_index,
            raz_compiler_rt_arena_get(
            builder.module.function_parameter_counts,
            function_index,
            ) + 1,
            );
            next_token(&mut scan, &mut current);
            if (current.kind == TokenKind::Comma) {
              next_token(&mut scan, &mut current);
            } else {
              parameters = false;
            }
          }
        }
        if (current.kind != TokenKind::RightParen) {
          hir_fail(builder, DiagnosticCode::ExpectedToken);
          return false;
        }
        next_token(&mut scan, &mut current);
        if (current.kind == TokenKind::Arrow) {
          next_token(&mut scan, &mut current);
          raz_compiler_rt_arena_set(builder.module.function_returns_value, function_index, 1);

          i64 return_structure = -1;
          i64 return_type = 0;
          i64 return_reference = 0;
          i64 return_slice = 0;
          i64 return_slice_mutable = 0;

          if (
          !hir_generic_inherent_signature_type(
          builder,
          &mut scan,
          &mut current,
          generic_impl,
          structure,
          concrete_child_structure,
          concrete_child_type,
          &mut return_structure,
          &mut return_type,
          &mut return_reference,
          &mut return_slice,
          &mut return_slice_mutable,
          )
          ) {
            hir_fail(builder, DiagnosticCode::UnknownType);
            return false;
          }
          raz_compiler_rt_arena_set(
          builder.module.function_return_type_structs,
          function_index,
          return_structure,
          );
          raz_compiler_rt_arena_set(
          builder.module.function_return_types,
          function_index,
          return_type,
          );
          raz_compiler_rt_arena_set(
          builder.module.function_return_references,
          function_index,
          return_reference,
          );
          raz_compiler_rt_arena_set(
          builder.module.function_return_slices,
          function_index,
          return_slice,
          );
          raz_compiler_rt_arena_set(
          builder.module.function_return_slice_mutable,
          function_index,
          return_slice_mutable,
          );
        }
        if (current.kind != TokenKind::LeftBrace) {
          hir_fail(builder, DiagnosticCode::ExpectedToken);
          return false;
        }

        i64 method = builder.module.inherent_method_count;

        builder.module.inherent_method_count += 1;
        raz_compiler_rt_arena_set(builder.module.inherent_method_structures, method, structure);
        raz_compiler_rt_arena_set(builder.module.inherent_method_name_offsets, method, name_offset);
        raz_compiler_rt_arena_set(builder.module.inherent_method_name_lengths, method, name_length);
        raz_compiler_rt_arena_set(builder.module.inherent_method_functions, method, function_index);

        i64 receiver = 0;

        if (raz_compiler_rt_arena_get(builder.module.function_parameter_counts, function_index) > 0) {
          i64 first_parameter = raz_compiler_rt_arena_get(
          builder.module.function_parameter_starts,
          function_index,
          );
          bool receiver_type_matches = raz_compiler_rt_arena_get(
          builder.module.parameter_type_structs,
          first_parameter,
          ) == structure;
          if (structure <= -2) {
            i64 enumeration = -2 - structure;

            receiver_type_matches =
            raz_compiler_rt_arena_get(
            builder.module.parameter_type_structs,
            first_parameter,
            ) < 0 &&
            raz_compiler_rt_arena_get(
            builder.module.parameter_types,
            first_parameter,
            ) == hir_enum_value_type_kind(builder, enumeration);
          }
          if (
          receiver_type_matches &&
          raz_compiler_rt_arena_get(builder.module.parameter_references, first_parameter) != 0
          ) {
            receiver = 1;
          }
        }
        raz_compiler_rt_arena_set(builder.module.inherent_method_receivers, method, receiver);

        i64 depth = 0;

        while (current.kind != TokenKind::End) {
          if (current.kind == TokenKind::LeftBrace) {
            depth += 1;
          } else if (current.kind == TokenKind::RightBrace) {
            depth -= 1;
          }
          next_token(&mut scan, &mut current);
          if (depth == 0) {
            break;
          }
        }
      }
      if (generic_trait >= 0 && structure >= 0) {
        i64 trait_index = raz_compiler_rt_arena_get(builder.module.generic_trait_traits, generic_trait);
        i64 trait_method = raz_compiler_rt_arena_get(builder.module.trait_method_starts, trait_index);

        i64 trait_method_end =
        trait_method +
        raz_compiler_rt_arena_get(builder.module.trait_method_counts, trait_index);
        while (trait_method < trait_method_end) {
          if (!hir_reserve_trait_default_method(builder, structure, trait_method)) {
            return false;
          }
          trait_method += 1;
        }
      }
    }
    generic_impl += 1;
  }
  return true;
}
