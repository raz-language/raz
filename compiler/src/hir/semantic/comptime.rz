                }
            } else if (kind == 5) {
                i64 ignored = 0;

                if (
                    !hir_eval_const_engine(
                        hir,
                        0,
                        raz_compiler_rt_arena_get(hir.statement_a, statement),
                        0,
                        locals,
                        parameters,
                        steps,
                        depth + 1,
                        0,
                        &mut ignored,
                    )
                ) {
