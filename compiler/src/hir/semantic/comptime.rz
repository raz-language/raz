                                1,
                                raz_compiler_rt_arena_get(hir.block_statement_starts, block),
                                raz_compiler_rt_arena_get(hir.block_statement_counts, block),
                                locals,
                                parameters,
                                steps,
                                depth + 1,
                                context,
                                &mut ignored,
                            )
                        ) {
                            return false;
                        }

                        i64 nested_flow = raz_compiler_rt_arena_get(context, 4);

                        if (nested_flow == 1) {
                            raz_compiler_rt_arena_set(context, 4, 0);
                            running = false;
                        } else if (nested_flow == 2) {
                            raz_compiler_rt_arena_set(context, 4, 0);
                        } else if (nested_flow == 3) {
                            return true;
                        }
                        value += 1;
                    }
                }
            } else if (kind == 11) {
                raz_compiler_rt_arena_set(context, 4, 1);
                return true;
            } else if (kind == 12) {
                raz_compiler_rt_arena_set(context, 4, 2);
                return true;
            } else {
                return false;
            }
            statement += 1;
        }
        raz_compiler_rt_arena_set(context, 4, 0);
        *out = 0;
        return true;
    }
    return false;
}

fn hir_eval_constexpr_node(
    HirModule& hir,
    i64 node,
    i64 locals,
    i64 parameters,
    i64 steps,
    i64 depth,
    i64&mut out,
) -> bool {
    return hir_eval_const_engine(hir, 0, node, 0, locals, parameters, steps, depth, 0, out);
}

fn hir_execute_const_statements(HirModule& hir, i64 start, i64 count, i64 context) -> bool {
    i64 locals = raz_compiler_rt_arena_get(context, 0);
    i64 parameters = raz_compiler_rt_arena_get(context, 1);
    i64 steps = raz_compiler_rt_arena_get(context, 2);
    i64 ignored = 0;

    return hir_eval_const_engine(hir, 1, start, count, locals, parameters, steps, 0, context, &mut ignored);
}

fn hir_fold_constants(HirModule&mut hir) -> bool {
    i64 steps = raz_compiler_rt_arena_create(1);

    if (steps == 0) {
        return false;
    }
    raz_compiler_rt_arena_set(steps, 0, 0);

    i64 index = 0;
    bool ok = true;

    while (ok && index < hir.constant_count) {
        // Only top-level constants are folded here; local constants remain ordinary HIR values.
        if (raz_compiler_rt_arena_get(hir.constant_function_indices, index) < 0) {
            i64 node = raz_compiler_rt_arena_get(hir.constant_nodes, index);
            i64 value = 0;
            i64 node_kind = raz_compiler_rt_arena_get(hir.node_kinds, node);

            bool aggregate_constant =
                node_kind == 33 ||
                node_kind == 34 ||
                node_kind == 53 ||
                raz_compiler_rt_arena_get(hir.node_type_structs, node) >= 0 ||
                raz_compiler_rt_arena_get(hir.node_array_extents, node) >= 0;
            if (aggregate_constant) {
                // Runtime aggregate constants retain their construction HIR so MIR
                // can materialize complete storage rather than a scalar placeholder.
            } else if (!hir_eval_constexpr_node(hir, node, 0, 0, steps, 0, &mut value)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(hir.node_kinds, node, 1);
                raz_compiler_rt_arena_set(hir.node_a, node, 0);
                raz_compiler_rt_arena_set(hir.node_b, node, 0);
                raz_compiler_rt_arena_set(hir.node_c, node, 0);
                raz_compiler_rt_arena_set(hir.node_values, node, value);
            }
        }
        index += 1;
    }
    raz_compiler_rt_arena_destroy(steps);
    return ok;
}

fn hir_parse_comptime_block(HirBuilder&mut builder) -> bool {
    hir_advance(builder);

    i64 saved_function = builder.current_function;
    i64 saved_block = builder.current_block;
    i64 saved_loop_depth = builder.loop_depth;
    i64 saved_comptime = builder.comptime_mode;
    i64 sentinel = 16383;

    raz_compiler_rt_arena_set(builder.module.function_local_starts, sentinel, builder.module.local_count);
    raz_compiler_rt_arena_set(builder.module.function_local_counts, sentinel, 0);
    raz_compiler_rt_arena_set(
        builder.module.function_statement_starts,
        sentinel,
        builder.module.statement_count,
    );
    raz_compiler_rt_arena_set(builder.module.function_statement_counts, sentinel, 0);
    builder.current_function = sentinel;
    builder.current_block = -1;
    builder.loop_depth = 0;
    builder.comptime_mode = 1;

    i64 block_start = 0;
    i64 block_end = 0;
    i64 block = -1;

    if (!hir_capture_block(builder, &mut block_start, &mut block_end, &mut block)) {
        builder.current_function = saved_function;
        builder.current_block = saved_block;
        builder.loop_depth = saved_loop_depth;
        builder.comptime_mode = saved_comptime;
        return false;
    }

    i64 parse_block = block;

    while (parse_block < builder.module.block_count) {
        if (
            raz_compiler_rt_arena_get(builder.module.block_function_indices, parse_block) == sentinel &&
            raz_compiler_rt_arena_get(builder.module.block_statement_counts, parse_block) == 0
        ) {
            if (!hir_parse_block_statements(builder, parse_block)) {
                builder.current_function = saved_function;
                builder.current_block = saved_block;
                builder.loop_depth = saved_loop_depth;
                builder.comptime_mode = saved_comptime;
                return false;
            }
        }
        parse_block += 1;
    }
    if (
        block_start < block_end &&
        raz_compiler_rt_arena_get(builder.module.block_statement_counts, block) == 0
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    builder.current_function = saved_function;
    builder.current_block = saved_block;
    builder.loop_depth = saved_loop_depth;
    builder.comptime_mode = saved_comptime;
    if (builder.module.comptime_block_count >= 256) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    raz_compiler_rt_arena_set(builder.module.comptime_blocks, builder.module.comptime_block_count, block);
    builder.module.comptime_block_count += 1;
    return true;
}

fn hir_clear_pending_attributes(HirBuilder&mut builder) {
    builder.pending_abi_kind = 0;
    builder.pending_link_name_offset = 0;
    builder.pending_link_name_length = 0;
    builder.pending_target_feature_offset = 0;
    builder.pending_target_feature_length = 0;
    builder.pending_effect_flags = 0;
    builder.pending_derive_copy = 0;
    builder.pending_derive_clone = 0;
    builder.pending_derive_trait_count = 0;
    builder.pending_struct_packed = 0;
    builder.pending_struct_repr_c = 0;
    builder.pending_struct_alignment = 0;
    builder.pending_struct_attribute_count = 0;
}

fn hir_parse_pending_attributes(HirBuilder&mut builder) -> bool {
    hir_clear_pending_attributes(builder);
    while (builder.current.kind == TokenKind::At) {
        hir_advance(builder);
        if (builder.current.kind != TokenKind::Identifier) {
            hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
            return false;
        }

        bool abi = token_is_abi(&builder.scan.input, &builder.current);
        bool link_name = token_is_link_name(&builder.scan.input, &builder.current);
        bool target_feature = token_is_target_feature(&builder.scan.input, &builder.current);
        bool derive = token_is_derive(&builder.scan.input, &builder.current);

        bool repr =
            builder.current.length == 4 &&
            source_byte(&builder.scan.input, builder.current.offset) == 114 &&
            source_byte(&builder.scan.input, builder.current.offset + 1) == 101 &&
            source_byte(&builder.scan.input, builder.current.offset + 2) == 112 &&
            source_byte(&builder.scan.input, builder.current.offset + 3) == 114;
        bool packed =
            builder.current.length == 6 &&
            source_byte(&builder.scan.input, builder.current.offset) == 112 &&
            source_byte(&builder.scan.input, builder.current.offset + 1) == 97 &&
            source_byte(&builder.scan.input, builder.current.offset + 2) == 99 &&
            source_byte(&builder.scan.input, builder.current.offset + 3) == 107 &&
            source_byte(&builder.scan.input, builder.current.offset + 4) == 101 &&
            source_byte(&builder.scan.input, builder.current.offset + 5) == 100;
        bool align =
            builder.current.length == 5 &&
            source_byte(&builder.scan.input, builder.current.offset) == 97 &&
            source_byte(&builder.scan.input, builder.current.offset + 1) == 108 &&
            source_byte(&builder.scan.input, builder.current.offset + 2) == 105 &&
            source_byte(&builder.scan.input, builder.current.offset + 3) == 103 &&
            source_byte(&builder.scan.input, builder.current.offset + 4) == 110;
        bool pure =
            builder.current.length == 4 &&
            source_byte(&builder.scan.input, builder.current.offset) == 112 &&
            source_byte(&builder.scan.input, builder.current.offset + 1) == 117 &&
            source_byte(&builder.scan.input, builder.current.offset + 2) == 114 &&
            source_byte(&builder.scan.input, builder.current.offset + 3) == 101;
        bool no_panic =
            builder.current.length == 8 &&
            source_byte(&builder.scan.input, builder.current.offset) == 110 &&
            source_byte(&builder.scan.input, builder.current.offset + 1) == 111 &&
            source_byte(&builder.scan.input, builder.current.offset + 2) == 95 &&
            source_byte(&builder.scan.input, builder.current.offset + 3) == 112 &&
            source_byte(&builder.scan.input, builder.current.offset + 4) == 97 &&
            source_byte(&builder.scan.input, builder.current.offset + 5) == 110 &&
            source_byte(&builder.scan.input, builder.current.offset + 6) == 105 &&
            source_byte(&builder.scan.input, builder.current.offset + 7) == 99;
        bool no_alloc =
            builder.current.length == 8 &&
            source_byte(&builder.scan.input, builder.current.offset) == 110 &&
            source_byte(&builder.scan.input, builder.current.offset + 1) == 111 &&
            source_byte(&builder.scan.input, builder.current.offset + 2) == 95 &&
            source_byte(&builder.scan.input, builder.current.offset + 3) == 97 &&
            source_byte(&builder.scan.input, builder.current.offset + 4) == 108 &&
            source_byte(&builder.scan.input, builder.current.offset + 5) == 108 &&
            source_byte(&builder.scan.input, builder.current.offset + 6) == 111 &&
            source_byte(&builder.scan.input, builder.current.offset + 7) == 99;
        bool deterministic =
            builder.current.length == 13 &&
            source_byte(&builder.scan.input, builder.current.offset) == 100 &&
            source_byte(&builder.scan.input, builder.current.offset + 1) == 101 &&
            source_byte(&builder.scan.input, builder.current.offset + 2) == 116 &&
            source_byte(&builder.scan.input, builder.current.offset + 3) == 101 &&
            source_byte(&builder.scan.input, builder.current.offset + 4) == 114 &&
            source_byte(&builder.scan.input, builder.current.offset + 5) == 109 &&
            source_byte(&builder.scan.input, builder.current.offset + 6) == 105 &&
            source_byte(&builder.scan.input, builder.current.offset + 7) == 110 &&
            source_byte(&builder.scan.input, builder.current.offset + 8) == 105 &&
            source_byte(&builder.scan.input, builder.current.offset + 9) == 115 &&
            source_byte(&builder.scan.input, builder.current.offset + 10) == 116 &&
            source_byte(&builder.scan.input, builder.current.offset + 11) == 105 &&
            source_byte(&builder.scan.input, builder.current.offset + 12) == 99;
        if (
            !abi &&
            !link_name &&
            !target_feature &&
            !derive &&
            !repr &&
            !packed &&
            !align &&
            !pure &&
            !no_panic &&
            !no_alloc &&
            !deterministic
        ) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        hir_advance(builder);
        if (pure || no_panic || no_alloc || deterministic) {
            if (pure) {
                builder.pending_effect_flags |= 1;
            }
            if (no_panic) {
                builder.pending_effect_flags |= 2;
            }
            if (no_alloc) {
                builder.pending_effect_flags |= 4;
            }
            if (deterministic) {
                builder.pending_effect_flags |= 8;
            }
            continue;
        }
        if (packed) {
            builder.pending_struct_packed = 1;
            builder.pending_struct_attribute_count += 1;
            continue;
        }
        if (!hir_expect(builder, TokenKind::LeftParen)) {
            return false;
        }
        if (align) {
            if (builder.current.kind != TokenKind::Integer) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }

            i64 requested_alignment = parse_integer_value(&builder.scan.input, &builder.current);

            if (requested_alignment <= 0 || (requested_alignment&(requested_alignment - 1)) != 0) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            builder.pending_struct_alignment = requested_alignment;
            builder.pending_struct_attribute_count += 1;
            hir_advance(builder);
            if (!hir_expect(builder, TokenKind::RightParen)) {
                return false;
            }
            continue;
        }
        if (builder.current.kind != TokenKind::Identifier) {
            hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
            return false;
        }
        if (repr) {
            if (
                !(
                    builder.current.length == 1 &&
                    source_byte(&builder.scan.input, builder.current.offset) == 67
                )
            ) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            builder.pending_struct_repr_c = 1;
            builder.pending_struct_attribute_count += 1;
            hir_advance(builder);
            if (!hir_expect(builder, TokenKind::RightParen)) {
                return false;
            }
            continue;
        }
        if (derive) {
            bool parsing_derives = true;

            while (parsing_derives) {
                if (builder.current.kind != TokenKind::Identifier) {
                    hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
                    return false;
                }
                if (token_is_copy_trait(&builder.scan.input, &builder.current)) {
                    builder.pending_derive_copy = 1;
                } else if (token_is_clone_trait(&builder.scan.input, &builder.current)) {
                    builder.pending_derive_clone = 1;
                } else {
                    i64 trait_index = hir_find_trait(builder, builder.current.offset, builder.current.length);

                    if (
                        trait_index < 0 ||
                        raz_compiler_rt_arena_get(builder.module.trait_method_counts, trait_index) != 0 ||
                        raz_compiler_rt_arena_get(
                            builder.module.trait_associated_type_counts,
                            trait_index,
                        ) != 0 ||
                        raz_compiler_rt_arena_get(
                            builder.module.trait_associated_const_counts,
                            trait_index,
                        ) != 0
                    ) {
                        hir_fail(builder, DiagnosticCode::ExpectedToken);
                        return false;
                    }
                    if (builder.pending_derive_trait_count >= 32) {
                        hir_fail(builder, DiagnosticCode::TooManyItems);
                        return false;
                    }
                    raz_compiler_rt_arena_set(
                        builder.pending_derive_traits,
                        builder.pending_derive_trait_count,
                        trait_index,
                    );
                    builder.pending_derive_trait_count += 1;
                }
                hir_advance(builder);
                if (builder.current.kind == TokenKind::Comma) {
                    hir_advance(builder);
                } else {
                    parsing_derives = false;
                }
            }
            if (!hir_expect(builder, TokenKind::RightParen)) {
                return false;
            }
            continue;
        }
        if (abi) {
            if (token_is_abi_c(&builder.scan.input, &builder.current)) {
                builder.pending_abi_kind = 1;
            } else if (token_is_abi_system(&builder.scan.input, &builder.current)) {
                builder.pending_abi_kind = 2;
            } else if (token_is_abi_raz(&builder.scan.input, &builder.current)) {
                builder.pending_abi_kind = 3;
            } else {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
        } else if (link_name) {
            builder.pending_link_name_offset = builder.current.offset;
            builder.pending_link_name_length = builder.current.length;
        } else {
            if (!token_is_supported_target_feature(&builder.scan.input, &builder.current)) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            builder.pending_target_feature_offset = builder.current.offset;
            builder.pending_target_feature_length = builder.current.length;
        }
        hir_advance(builder);
        if (!hir_expect(builder, TokenKind::RightParen)) {
            return false;
        }
    }
    return true;
}

fn hir_header_is_type_generic(HirBuilder&mut builder) -> bool {
    if (builder.current.kind != TokenKind::Less) {
        return false;
    }

    i64 saved_scan_offset = builder.scan.offset;
    TokenKind saved_kind = builder.current.kind;
    i64 saved_offset = builder.current.offset;
    i64 saved_length = builder.current.length;

    hir_advance(builder);

    bool type_generic = builder.current.kind != TokenKind::Lifetime;

    builder.scan.offset = saved_scan_offset;
    init_token(&mut builder.current, saved_kind, saved_offset, saved_length);
    return type_generic;
}

fn hir_predeclare_skip_declaration(HirBuilder&mut builder) -> bool {
    i64 brace_depth = 0;
    i64 paren_depth = 0;
    i64 bracket_depth = 0;
    bool saw_body = false;

    while (builder.current.kind != TokenKind::End) {
        TokenKind kind = builder.current.kind;

        if (kind == TokenKind::LeftBrace) {
            brace_depth += 1;
            saw_body = true;
        } else if (kind == TokenKind::RightBrace) {
            if (brace_depth <= 0) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            brace_depth -= 1;
        } else if (kind == TokenKind::LeftParen) {
            paren_depth += 1;
        } else if (kind == TokenKind::RightParen && paren_depth > 0) {
            paren_depth -= 1;
        } else if (kind == TokenKind::LeftBracket) {
            bracket_depth += 1;
        } else if (kind == TokenKind::RightBracket && bracket_depth > 0) {
            bracket_depth -= 1;
        }

        bool body_done = saw_body && kind == TokenKind::RightBrace && brace_depth == 0;
        bool declaration_done =
            !saw_body && kind == TokenKind::Semicolon &&
            brace_depth == 0 && paren_depth == 0 && bracket_depth == 0;

        hir_advance(builder);
        if (body_done || declaration_done) {
            return true;
        }
    }
    hir_fail(builder, DiagnosticCode::ExpectedToken);
    return false;
}

fn hir_predeclare_struct_name(HirBuilder&mut builder) -> bool {
    hir_advance(builder);
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }

    i64 name_offset = builder.current.offset;
    i64 name_length = builder.current.length;

    hir_advance(builder);
    if (builder.current.kind == TokenKind::Less) {
        // Generic aggregate templates need their complete parameter metadata
        // before instantiation, so their normal semantic declaration remains
        // authoritative. Concrete aggregate names are the forward-reference
        // problem this phase solves.
        return hir_predeclare_skip_declaration(builder);
    }
    if (builder.module.struct_count >= 256) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    if (hir_namespace_has_top_level_name(builder, name_offset, name_length)) {
        hir_fail(builder, DiagnosticCode::DuplicateName);
        return false;
    }

    i64 structure = builder.module.struct_count;

    builder.module.struct_count += 1;
    raz_compiler_rt_arena_set(builder.module.struct_name_offsets, structure, name_offset);
    raz_compiler_rt_arena_set(builder.module.struct_name_lengths, structure, name_length);
    // -1 is the explicit predeclaration marker. The real declaration replaces
    // it with the field start while preserving this stable structure identity.
    raz_compiler_rt_arena_set(builder.module.struct_field_starts, structure, -1);
    raz_compiler_rt_arena_set(builder.module.struct_field_counts, structure, 0);
    raz_compiler_rt_arena_set(builder.module.struct_drop_functions, structure, -1);
    raz_compiler_rt_arena_set(builder.module.struct_clone_functions, structure, -1);
    raz_compiler_rt_arena_set(builder.module.struct_generic_template_indices, structure, -1);
    raz_compiler_rt_arena_set(builder.module.struct_generic_type_structs, structure, -1);
    return hir_predeclare_skip_declaration(builder);
}

fn hir_predeclare_enum_body(HirBuilder&mut builder, i64 enumeration) -> bool {
    i64 brace_depth = 0;

    while (builder.current.kind != TokenKind::End) {
        TokenKind kind = builder.current.kind;

        if (kind == TokenKind::LeftBrace) {
            brace_depth += 1;
        } else if (kind == TokenKind::RightBrace) {
            if (brace_depth <= 0) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            brace_depth -= 1;
        } else if (kind == TokenKind::LeftParen && brace_depth == 1) {
            // Payload-bearing enums have aggregate ABI identity. Record this
            // before earlier function signatures are lowered.
            raz_compiler_rt_arena_set(builder.module.enum_has_payload, enumeration, 1);
        }

        bool done = kind == TokenKind::RightBrace && brace_depth == 0;

        hir_advance(builder);
        if (done) {
            return true;
        }
    }
    hir_fail(builder, DiagnosticCode::ExpectedToken);
    return false;
}

fn hir_predeclare_enum_name(HirBuilder&mut builder) -> bool {
    hir_advance(builder);
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }

    i64 name_offset = builder.current.offset;
    i64 name_length = builder.current.length;

    hir_advance(builder);
    if (builder.current.kind == TokenKind::Less) {
        return hir_predeclare_skip_declaration(builder);
    }
    if (builder.module.enum_count >= 256) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    if (hir_namespace_has_top_level_name(builder, name_offset, name_length)) {
        hir_fail(builder, DiagnosticCode::DuplicateName);
        return false;
    }

    i64 enumeration = builder.module.enum_count;

    builder.module.enum_count += 1;
    raz_compiler_rt_arena_set(builder.module.enum_name_offsets, enumeration, name_offset);
    raz_compiler_rt_arena_set(builder.module.enum_name_lengths, enumeration, name_length);
    raz_compiler_rt_arena_set(builder.module.enum_member_starts, enumeration, -1);
    raz_compiler_rt_arena_set(builder.module.enum_member_counts, enumeration, 0);
    raz_compiler_rt_arena_set(builder.module.enum_has_payload, enumeration, 0);
    raz_compiler_rt_arena_set(builder.module.enum_generic_template_indices, enumeration, -1);
    return hir_predeclare_enum_body(builder, enumeration);
}

fn hir_predeclare_is_graph_directive(HirBuilder&mut builder) -> bool {
    return
        token_is_raz_package(&builder.scan.input, &builder.current) ||
        token_is_raz_module(&builder.scan.input, &builder.current) ||
        token_is_raz_dependency(&builder.scan.input, &builder.current) ||
        token_is_namespace(&builder.scan.input, &builder.current) ||
        token_is_import(&builder.scan.input, &builder.current);
}

fn hir_predeclare_aggregate_step(HirBuilder&mut builder) -> bool {
    if (builder.current.kind == TokenKind::RightBrace && builder.namespace_scope_count > 0) {
        i64 namespace_end = builder.current.offset;

        hir_advance(builder);
        return hir_pop_namespace(builder, namespace_end);
    }

    i64 saved_scan_offset = builder.scan.offset;
    TokenKind saved_kind = builder.current.kind;
    i64 saved_offset = builder.current.offset;
    i64 saved_length = builder.current.length;

    if (!hir_parse_pending_attributes(builder)) {
        return false;
    }

    bool public_symbol = false;
    bool private_symbol = false;

    if (builder.current.kind == TokenKind::Identifier && token_is_public(&builder.scan.input, &builder.current)) {
        public_symbol = true;
        hir_advance(builder);
    } else if (builder.current.kind == TokenKind::Identifier && token_is_private(&builder.scan.input, &builder.current)) {
        private_symbol = true;
        hir_advance(builder);
    }
    if (builder.current.kind == TokenKind::End) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }

    i64 visibility = 0;

    if (public_symbol) {
        visibility = 1;
    } else if (private_symbol) {
        visibility = 2;
    }
    if (!hir_record_declaration_visibility(builder, builder.current.offset, visibility)) {
        return false;
    }

    if (hir_predeclare_is_graph_directive(builder)) {
        // Reuse the canonical package/module/namespace/import parser. Segment,
        // import, dependency, and visibility insertion are replay-idempotent.
        builder.scan.offset = saved_scan_offset;
        init_token(&mut builder.current, saved_kind, saved_offset, saved_length);
        return hir_skip_top_level_declaration(builder);
    }
    if (token_is_struct(&builder.scan.input, &builder.current)) {
        bool parsed = hir_predeclare_struct_name(builder);
        hir_clear_pending_attributes(builder);
        return parsed;
    }
    if (token_is_enum(&builder.scan.input, &builder.current)) {
        bool parsed = hir_predeclare_enum_name(builder);
        hir_clear_pending_attributes(builder);
        return parsed;
    }

    bool skipped = hir_predeclare_skip_declaration(builder);

    hir_clear_pending_attributes(builder);
    return skipped;
}

fn hir_predeclare_aggregate_graph(HirBuilder&mut builder, Source input) -> bool {
    while (builder.current.kind != TokenKind::End) {
        if (!hir_predeclare_aggregate_step(builder)) {
            return false;
        }
    }
    if (builder.namespace_scope_count != 0) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }

    init_lexer(&mut builder.scan, input);
    hir_advance(builder);
    builder.current_namespace_hash = 0;
    builder.current_package_hash = 0;
    builder.current_module_id = 0;
    builder.namespace_scope_count = 0;
    builder.namespace_lookup_target_hash = -1;
    builder.namespace_lookup_target_package_hash = -1;
    hir_clear_pending_attributes(builder);
    return true;
}

fn hir_skip_top_level_declaration(HirBuilder&mut builder) -> bool {
    if (!hir_parse_pending_attributes(builder)) {
        return false;
    }
    if (builder.current.kind == TokenKind::RightBrace && builder.namespace_scope_count > 0) {
        i64 namespace_end = builder.current.offset;

        hir_advance(builder);
        return hir_pop_namespace(builder, namespace_end);
    }

    i64 saved_scan_offset = builder.scan.offset;
    TokenKind saved_current_kind = builder.current.kind;
    i64 saved_current_offset = builder.current.offset;
    i64 saved_current_length = builder.current.length;
    bool public_symbol = false;
    bool private_symbol = false;

    if (
        builder.current.kind == TokenKind::Identifier &&
        token_is_public(&builder.scan.input, &builder.current)
    ) {
        public_symbol = true;
        hir_advance(builder);
    } else if (
        builder.current.kind == TokenKind::Identifier &&
        token_is_private(&builder.scan.input, &builder.current)
    ) {
        private_symbol = true;
        hir_advance(builder);
    }
    if (builder.current.kind != TokenKind::Identifier) {
        builder.scan.offset = saved_scan_offset;
        init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
        return false;
    }

    i64 declaration_visibility = 0;

    if (public_symbol) {
        declaration_visibility = 1;
    } else if (private_symbol) {
        declaration_visibility = 2;
    }
    if (!hir_record_declaration_visibility(builder, builder.current.offset, declaration_visibility)) {
        return false;
    }
    // Module storage is backend-neutral: Forge and LLVM consume the same HIR/MIR declarations.
    if (
        token_is_global(&builder.scan.input, &builder.current) ||
        token_is_static(&builder.scan.input, &builder.current)
    ) {
        return hir_parse_global_declaration(builder, public_symbol, false, false, false);
    }
    if (token_is_thread_local(&builder.scan.input, &builder.current)) {
        hir_advance(builder);
        if (
            builder.current.kind == TokenKind::Identifier &&
            (
                token_is_global(&builder.scan.input, &builder.current) ||
                token_is_static(&builder.scan.input, &builder.current)
            )
        ) {
            return hir_parse_global_declaration(builder, public_symbol, false, true, false);
        }
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    if (token_is_extern(&builder.scan.input, &builder.current)) {
        i64 extern_scan_offset = builder.scan.offset;
        TokenKind extern_current_kind = builder.current.kind;
        i64 extern_current_offset = builder.current.offset;
        i64 extern_current_length = builder.current.length;

        hir_advance(builder);

        bool extern_tls = false;

        if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_thread_local(&builder.scan.input, &builder.current)
        ) {
            extern_tls = true;
            hir_advance(builder);
        }
        if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_global(&builder.scan.input, &builder.current)
        ) {
            return hir_parse_global_declaration(builder, public_symbol, true, extern_tls, false);
        }
        builder.scan.offset = extern_scan_offset;
        init_token(&mut builder.current, extern_current_kind, extern_current_offset, extern_current_length);
    }
    if (
        token_is_async(&builder.scan.input, &builder.current) ||
        token_is_unsafe(&builder.scan.input, &builder.current)
    ) {
        bool scanning_prefixes = true;

        while (scanning_prefixes && builder.current.kind == TokenKind::Identifier) {
            if (
                token_is_async(&builder.scan.input, &builder.current) ||
                token_is_unsafe(&builder.scan.input, &builder.current)
            ) {
                hir_advance(builder);
            } else {
                scanning_prefixes = false;
            }
        }
        if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_fn(&builder.scan.input, &builder.current)
        ) {
            hir_advance(builder);
            if (builder.current.kind == TokenKind::Identifier) {
                hir_advance(builder);

                bool generic_prefixed_function = hir_header_is_type_generic(builder);

                builder.scan.offset = saved_scan_offset;
                init_token(
                    &mut builder.current,
                    saved_current_kind,
                    saved_current_offset,
                    saved_current_length,
                );
                if (generic_prefixed_function) {
                    return hir_parse_generic_function_template(builder);
                }
            }
        }
        builder.scan.offset = saved_scan_offset;
        init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
        return hir_parse_function(builder);
    }
    if (token_is_fn(&builder.scan.input, &builder.current)) {
        i64 function_scan_offset = builder.scan.offset;
        TokenKind function_current_kind = builder.current.kind;
        i64 function_current_offset = builder.current.offset;
        i64 function_current_length = builder.current.length;

        hir_advance(builder);
        if (builder.current.kind == TokenKind::Identifier) {
            hir_advance(builder);

            bool generic_function = hir_header_is_type_generic(builder);

            builder.scan.offset = saved_scan_offset;
            init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
            if (generic_function) {
                return hir_parse_generic_function_template(builder);
            }
        } else {
            builder.scan.offset = function_scan_offset;
            init_token(
                &mut builder.current,
                function_current_kind,
                function_current_offset,
                function_current_length,
            );
        }
    }
    if (token_is_comptime(&builder.scan.input, &builder.current)) {
        return hir_parse_comptime_block(builder);
    }
    if (token_is_const(&builder.scan.input, &builder.current)) {
        i64 const_scan_offset = builder.scan.offset;
        TokenKind const_current_kind = builder.current.kind;
        i64 const_current_offset = builder.current.offset;
        i64 const_current_length = builder.current.length;

        hir_advance(builder);
        if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_fn(&builder.scan.input, &builder.current)
        ) {
            i64 function_index = builder.module.function_count;

            if (!hir_parse_function(builder)) {
                return false;
            }
            raz_compiler_rt_arena_set(builder.module.function_is_const, function_index, 1);
            return true;
        }
        builder.scan.offset = const_scan_offset;
        init_token(&mut builder.current, const_current_kind, const_current_offset, const_current_length);

        i64 saved_top_function = builder.current_function;
        i64 saved_top_block = builder.current_block;

        builder.current_function = -1;
        builder.current_block = -1;

        bool parsed_top_const = hir_parse_const_declaration(builder);

        builder.current_function = saved_top_function;
        builder.current_block = saved_top_block;
        return parsed_top_const;
    }
    if (token_is_raz_package(&builder.scan.input, &builder.current)) {
        i64 package_offset = builder.current.offset;

        hir_advance(builder);

        i64 package_hash = 0;

        if (
            !hir_parse_namespace_path(builder, &mut package_hash) ||
            !hir_expect(builder, TokenKind::Semicolon)
        ) {
            return false;
        }
        return hir_begin_package(builder, package_offset, package_hash);
    }
    if (token_is_raz_module(&builder.scan.input, &builder.current)) {
        i64 module_offset = builder.current.offset;

        hir_advance(builder);
        if (!hir_expect(builder, TokenKind::Semicolon)) {
            return false;
        }
        return hir_begin_module(builder, module_offset);
    }
    if (token_is_raz_dependency(&builder.scan.input, &builder.current)) {
        hir_advance(builder);
        if (builder.current.kind != TokenKind::Identifier) {
            hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
            return false;
        }

        i64 dependency_alias = 17;

        dependency_alias = hir_namespace_hash_token(builder, dependency_alias, &builder.current);
        hir_advance(builder);

        i64 dependency_package = 0;

        if (
            !hir_parse_namespace_path(builder, &mut dependency_package) ||
            !hir_expect(builder, TokenKind::Semicolon)
        ) {
            return false;
        }
        return hir_add_package_dependency(
            builder,
            builder.current_package_hash,
            dependency_alias,
            dependency_package,
        );
    }
    if (token_is_namespace(&builder.scan.input, &builder.current)) {
        i64 namespace_offset = builder.current.offset;

        hir_advance(builder);

        i64 namespace_hash = 0;

        if (!hir_parse_namespace_path(builder, &mut namespace_hash)) {
            return false;
        }
        if (builder.current.kind == TokenKind::Semicolon) {
            if (builder.namespace_scope_count != 0) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            hir_advance(builder);
            return hir_begin_namespace(builder, namespace_offset, namespace_hash);
        }
        if (builder.current.kind == TokenKind::LeftBrace) {
            hir_advance(builder);
            return hir_push_namespace(builder, namespace_offset, namespace_hash);
        }
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    if (token_is_import(&builder.scan.input, &builder.current)) {
        hir_advance(builder);

        i64 import_package = 0;
        i64 import_hash = 0;

        if (!hir_parse_import_path(builder, &mut import_package, &mut import_hash)) {
            return false;
        }

        i64 import_alias = import_hash;
        bool qualified_only = false;

        if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_as(&builder.scan.input, &builder.current)
        ) {
            hir_advance(builder);
            if (builder.current.kind != TokenKind::Identifier) {
                hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
                return false;
            }
            import_alias = 17;
            import_alias = hir_namespace_hash_token(builder, import_alias, &builder.current);
            qualified_only = true;
            hir_advance(builder);
        }
        if (!hir_expect(builder, TokenKind::Semicolon)) {
            return false;
        }
        return hir_add_namespace_import(
            builder,
            builder.current_package_hash,
            builder.current_namespace_hash,
            import_package,
            import_hash,
            import_alias,
            qualified_only,
            public_symbol,
        );
    }
    if (token_is_trait(&builder.scan.input, &builder.current)) {
        return hir_parse_trait_declaration(builder);
    }
    if (token_is_struct(&builder.scan.input, &builder.current)) {
        i64 struct_scan_offset = builder.scan.offset;
        TokenKind struct_current_kind = builder.current.kind;
        i64 struct_current_offset = builder.current.offset;
        i64 struct_current_length = builder.current.length;

        hir_advance(builder);
        if (builder.current.kind == TokenKind::Identifier) {
            hir_advance(builder);

            bool generic_structure = builder.current.kind == TokenKind::Less;

            builder.scan.offset = struct_scan_offset;
            init_token(
                &mut builder.current,
                struct_current_kind,
                struct_current_offset,
                struct_current_length,
            );
            if (generic_structure) {
                return hir_parse_generic_struct_template(builder);
            }
        } else {
            builder.scan.offset = struct_scan_offset;
            init_token(
                &mut builder.current,
                struct_current_kind,
                struct_current_offset,
                struct_current_length,
            );
        }
        return hir_parse_struct_declaration(builder);
    }
    if (token_is_enum(&builder.scan.input, &builder.current)) {
        return hir_parse_enum_declaration(builder);
    }
    if (token_is_impl(&builder.scan.input, &builder.current)) {
        i64 impl_scan_offset = builder.scan.offset;
        TokenKind impl_current_kind = builder.current.kind;
        i64 impl_current_offset = builder.current.offset;
        i64 impl_current_length = builder.current.length;

        hir_advance(builder);

        bool generic_impl = builder.current.kind == TokenKind::Less;
        bool generic_drop_impl = false;
        bool generic_clone_impl = false;
        bool generic_copy_impl = false;
        bool generic_trait_impl = false;

        if (generic_impl) {
            i64 generic_depth = 0;

            while (builder.current.kind != TokenKind::End) {
                if (builder.current.kind == TokenKind::Less) {
                    generic_depth += 1;
                } else if (builder.current.kind == TokenKind::Greater) {
                    generic_depth -= 1;
                    if (generic_depth == 0) {
                        hir_advance(builder);
                        break;
                    }
                }
                hir_advance(builder);
            }
            generic_drop_impl =
                builder.current.kind == TokenKind::Identifier &&
                token_is_drop_trait(&builder.scan.input, &builder.current);
            generic_clone_impl =
                builder.current.kind == TokenKind::Identifier &&
                token_is_clone_trait(&builder.scan.input, &builder.current);
            generic_copy_impl =
                builder.current.kind == TokenKind::Identifier &&
                token_is_copy_trait(&builder.scan.input, &builder.current);
            generic_trait_impl =
                builder.current.kind == TokenKind::Identifier &&
                hir_find_trait(builder, builder.current.offset, builder.current.length) >= 0;
        }
        builder.scan.offset = saved_scan_offset;
        init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
        if (generic_impl) {
            if (generic_drop_impl) {
                return hir_parse_generic_drop_impl_template(builder);
            }
            if (generic_clone_impl) {
                return hir_parse_generic_clone_impl_template(builder);
            }
            if (generic_copy_impl) {
                return hir_parse_generic_copy_impl_template(builder);
            }
            if (generic_trait_impl) {
                return hir_parse_generic_trait_impl_template(builder);
            }
            return hir_parse_generic_inherent_impl_template(builder);
        }
        builder.scan.offset = impl_scan_offset;
        init_token(&mut builder.current, impl_current_kind, impl_current_offset, impl_current_length);
        hir_advance(builder);
        bool copy_impl =
            builder.current.kind == TokenKind::Identifier &&
            token_is_copy_trait(&builder.scan.input, &builder.current);
        bool clone_impl =
            builder.current.kind == TokenKind::Identifier &&
            token_is_clone_trait(&builder.scan.input, &builder.current);
        bool drop_impl =
            builder.current.kind == TokenKind::Identifier &&
            token_is_drop_trait(&builder.scan.input, &builder.current);
        bool trait_impl =
            builder.current.kind == TokenKind::Identifier &&
            hir_find_trait(builder, builder.current.offset, builder.current.length) >= 0;
        builder.scan.offset = impl_scan_offset;
        init_token(&mut builder.current, impl_current_kind, impl_current_offset, impl_current_length);
        if (copy_impl) {
            return hir_parse_copy_impl(builder);
        }
        if (clone_impl) {
            return hir_parse_clone_impl(builder);
        }
        if (drop_impl) {
            return hir_parse_drop_impl(builder);
        }
        if (trait_impl) {
            return hir_parse_trait_impl(builder);
        }
        return hir_parse_inherent_impl(builder);
    }
    if (token_is_extern(&builder.scan.input, &builder.current)) {
        return hir_parse_extern_function(builder);
    }
    builder.scan.offset = saved_scan_offset;
    init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
    return false;
}

fn hir_materialize_generic_drop_impl(HirBuilder&mut builder, i64 structure) -> bool {
    if (
        structure < 0 ||
        structure >= builder.module.struct_count ||
        raz_compiler_rt_arena_get(builder.module.struct_drop_functions, structure) >= 0
    ) {
        return true;
    }
    i64 generic_structure = raz_compiler_rt_arena_get(
        builder.module.struct_generic_template_indices,
        structure,
    );
    if (generic_structure < 0) {
        return true;
    }

    i64 generic_drop = 0;

    while (
        generic_drop < builder.module.generic_drop_impl_count &&
        raz_compiler_rt_arena_get(
            builder.module.generic_drop_struct_templates,
            generic_drop,
        ) != generic_structure
    ) {
        generic_drop += 1;
    }
    if (generic_drop >= builder.module.generic_drop_impl_count) {
        return true;
    }
    if (raz_compiler_rt_arena_get(builder.module.generic_drop_requires_drop, generic_drop) != 0) {
        i64 child_structure = raz_compiler_rt_arena_get(
            builder.module.struct_generic_type_structs,
            structure,
        );
        if (
            child_structure < 0 ||
            raz_compiler_rt_arena_get(builder.module.struct_drop_functions, child_structure) < 0
        ) {
            return true;
        }
    }

    i64 saved_scan_offset = builder.scan.offset;
    TokenKind saved_current_kind = builder.current.kind;
    i64 saved_current_offset = builder.current.offset;
    i64 saved_current_length = builder.current.length;
    i64 saved_function = builder.current_function;
    i64 saved_block = builder.current_block;
    i64 saved_loop_depth = builder.loop_depth;
    i64 saved_generic_active = builder.generic_active;
    i64 saved_generic_template = builder.generic_template_index;
    i64 saved_generic_name_offset = builder.generic_type_name_offset;
    i64 saved_generic_name_length = builder.generic_type_name_length;
    i64 saved_generic_structure = builder.generic_type_structure;
    i64 saved_generic_type = builder.generic_type_kind;
    i64 saved_signature_only = builder.generic_signature_only;
    i64 saved_reparse = builder.generic_reparse_function_index;
    i64 saved_substitution_name_offsets = raz_compiler_rt_arena_create(32);
    i64 saved_substitution_name_lengths = raz_compiler_rt_arena_create(32);
    i64 saved_substitution_type_structures = raz_compiler_rt_arena_create(32);
    i64 saved_substitution_types = raz_compiler_rt_arena_create(32);

    if (
        saved_substitution_name_offsets == 0 ||
        saved_substitution_name_lengths == 0 ||
        saved_substitution_type_structures == 0 ||
        saved_substitution_types == 0
    ) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    i64 saved_substitution_count = hir_save_generic_substitutions(
        builder,
        saved_substitution_name_offsets,
        saved_substitution_name_lengths,
        saved_substitution_type_structures,
        saved_substitution_types,
    );
    builder.scan.offset = raz_compiler_rt_arena_get(builder.module.generic_drop_source_offsets, generic_drop);
    next_token(&mut builder.scan, &mut builder.current);
    // Skip `impl<...> Drop for Box<T> {` to the method declaration.
    while (builder.current.kind != TokenKind::LeftBrace && builder.current.kind != TokenKind::End) {
        hir_advance(builder);
    }
    if (builder.current.kind != TokenKind::LeftBrace) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    hir_advance(builder);
    builder.generic_active = 1;
    builder.generic_template_index = -1;
    builder.generic_type_name_offset = raz_compiler_rt_arena_get(
        builder.module.generic_drop_type_name_offsets,
        generic_drop,
    );
    builder.generic_type_name_length = raz_compiler_rt_arena_get(
        builder.module.generic_drop_type_name_lengths,
        generic_drop,
    );
    builder.generic_type_structure = raz_compiler_rt_arena_get(
        builder.module.struct_generic_type_structs,
        structure,
    );
    builder.generic_type_kind = raz_compiler_rt_arena_get(builder.module.struct_generic_types, structure);
    if (!hir_install_struct_generic_arguments(builder, generic_structure, structure)) {
        hir_restore_generic_substitutions(
            builder,
            saved_substitution_count,
            saved_substitution_name_offsets,
            saved_substitution_name_lengths,
            saved_substitution_type_structures,
            saved_substitution_types,
        );
        raz_compiler_rt_arena_destroy(saved_substitution_name_offsets);
        raz_compiler_rt_arena_destroy(saved_substitution_name_lengths);
        raz_compiler_rt_arena_destroy(saved_substitution_type_structures);
        raz_compiler_rt_arena_destroy(saved_substitution_types);
        return false;
    }
    builder.generic_signature_only = 0;
    builder.generic_reparse_function_index = -1;

    i64 function_index = builder.module.function_count;
    bool parsed = hir_parse_impl_method_function(builder);

    if (parsed) {
        i64 name_offset = raz_compiler_rt_arena_get(builder.module.function_name_offsets, function_index);

        parsed =
            raz_compiler_rt_arena_get(builder.module.function_name_lengths, function_index) == 4 &&
            source_byte(&builder.scan.input, name_offset) == 100 &&
            source_byte(&builder.scan.input, name_offset + 1) == 114 &&
            source_byte(&builder.scan.input, name_offset + 2) == 111 &&
            source_byte(&builder.scan.input, name_offset + 3) == 112;
    }
    if (parsed) {
        parsed = raz_compiler_rt_arena_get(builder.module.function_parameter_counts, function_index) == 1;
    }
    if (parsed) {
        i64 parameter = raz_compiler_rt_arena_get(builder.module.function_parameter_starts, function_index);

        parsed =
            raz_compiler_rt_arena_get(builder.module.parameter_type_structs, parameter) == structure &&
            raz_compiler_rt_arena_get(builder.module.parameter_references, parameter) != 0;
    }
    if (parsed) {
        raz_compiler_rt_arena_set(builder.module.struct_drop_functions, structure, function_index);
        raz_compiler_rt_arena_set(builder.module.function_drop_structs, function_index, structure);
        builder.module.drop_impl_count += 1;
    } else if (builder.module.diagnostic_code == DiagnosticCode::None) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
    }
    builder.scan.offset = saved_scan_offset;
    init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
    builder.current_function = saved_function;
    builder.current_block = saved_block;
    builder.loop_depth = saved_loop_depth;
    builder.generic_active = saved_generic_active;
    builder.generic_template_index = saved_generic_template;
    builder.generic_type_name_offset = saved_generic_name_offset;
    builder.generic_type_name_length = saved_generic_name_length;
    builder.generic_type_structure = saved_generic_structure;
    builder.generic_type_kind = saved_generic_type;
    hir_restore_generic_substitutions(
        builder,
        saved_substitution_count,
        saved_substitution_name_offsets,
        saved_substitution_name_lengths,
        saved_substitution_type_structures,
        saved_substitution_types,
    );
    raz_compiler_rt_arena_destroy(saved_substitution_name_offsets);
    raz_compiler_rt_arena_destroy(saved_substitution_name_lengths);
    raz_compiler_rt_arena_destroy(saved_substitution_type_structures);
    raz_compiler_rt_arena_destroy(saved_substitution_types);
    builder.generic_signature_only = saved_signature_only;
    builder.generic_reparse_function_index = saved_reparse;
    return parsed;
}

fn hir_materialize_generic_clone_impl(HirBuilder&mut builder, i64 structure) -> bool {
    if (
        structure < 0 ||
        structure >= builder.module.struct_count ||
        raz_compiler_rt_arena_get(builder.module.struct_clone_functions, structure) >= 0
    ) {
        return true;
    }
    i64 generic_structure = raz_compiler_rt_arena_get(
        builder.module.struct_generic_template_indices,
        structure,
    );
    if (generic_structure < 0) {
        return true;
    }

    i64 generic_clone = 0;

    while (
        generic_clone < builder.module.generic_clone_impl_count &&
        raz_compiler_rt_arena_get(
            builder.module.generic_clone_struct_templates,
            generic_clone,
        ) != generic_structure
    ) {
        generic_clone += 1;
    }
    if (generic_clone >= builder.module.generic_clone_impl_count) {
        return true;
    }
    if (raz_compiler_rt_arena_get(builder.module.generic_clone_requires_clone, generic_clone) != 0) {
        i64 child_structure = raz_compiler_rt_arena_get(
            builder.module.struct_generic_type_structs,
            structure,
        );
        if (
            child_structure >= 0 &&
            raz_compiler_rt_arena_get(builder.module.struct_clone_functions, child_structure) < 0
        ) {
            return true;
        }
    }

    i64 saved_scan_offset = builder.scan.offset;
    TokenKind saved_current_kind = builder.current.kind;
    i64 saved_current_offset = builder.current.offset;
    i64 saved_current_length = builder.current.length;
    i64 saved_function = builder.current_function;
    i64 saved_block = builder.current_block;
    i64 saved_loop_depth = builder.loop_depth;
    i64 saved_generic_active = builder.generic_active;
    i64 saved_generic_template = builder.generic_template_index;
    i64 saved_generic_name_offset = builder.generic_type_name_offset;
    i64 saved_generic_name_length = builder.generic_type_name_length;
    i64 saved_generic_structure = builder.generic_type_structure;
    i64 saved_generic_type = builder.generic_type_kind;
    i64 saved_signature_only = builder.generic_signature_only;
    i64 saved_reparse = builder.generic_reparse_function_index;
    i64 saved_substitution_name_offsets = raz_compiler_rt_arena_create(32);
    i64 saved_substitution_name_lengths = raz_compiler_rt_arena_create(32);
    i64 saved_substitution_type_structures = raz_compiler_rt_arena_create(32);
    i64 saved_substitution_types = raz_compiler_rt_arena_create(32);

    if (
        saved_substitution_name_offsets == 0 ||
        saved_substitution_name_lengths == 0 ||
        saved_substitution_type_structures == 0 ||
        saved_substitution_types == 0
    ) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    i64 saved_substitution_count = hir_save_generic_substitutions(
        builder,
        saved_substitution_name_offsets,
        saved_substitution_name_lengths,
        saved_substitution_type_structures,
        saved_substitution_types,
    );
    builder.scan.offset = raz_compiler_rt_arena_get(
        builder.module.generic_clone_source_offsets,
        generic_clone,
    );
    next_token(&mut builder.scan, &mut builder.current);
    while (builder.current.kind != TokenKind::LeftBrace && builder.current.kind != TokenKind::End) {
        hir_advance(builder);
    }
    if (builder.current.kind != TokenKind::LeftBrace) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    hir_advance(builder);
    builder.generic_active = 1;
    builder.generic_template_index = -1;
    builder.generic_type_name_offset = raz_compiler_rt_arena_get(
        builder.module.generic_clone_type_name_offsets,
        generic_clone,
    );
    builder.generic_type_name_length = raz_compiler_rt_arena_get(
        builder.module.generic_clone_type_name_lengths,
        generic_clone,
    );
    builder.generic_type_structure = raz_compiler_rt_arena_get(
        builder.module.struct_generic_type_structs,
        structure,
    );
    builder.generic_type_kind = raz_compiler_rt_arena_get(builder.module.struct_generic_types, structure);
    if (!hir_install_struct_generic_arguments(builder, generic_structure, structure)) {
        hir_restore_generic_substitutions(
            builder,
            saved_substitution_count,
            saved_substitution_name_offsets,
            saved_substitution_name_lengths,
            saved_substitution_type_structures,
            saved_substitution_types,
        );
        raz_compiler_rt_arena_destroy(saved_substitution_name_offsets);
        raz_compiler_rt_arena_destroy(saved_substitution_name_lengths);
        raz_compiler_rt_arena_destroy(saved_substitution_type_structures);
        raz_compiler_rt_arena_destroy(saved_substitution_types);
        return false;
    }
    builder.generic_signature_only = 0;
    builder.generic_reparse_function_index = -1;

    i64 function_index = builder.module.function_count;
    bool parsed = hir_parse_impl_method_function(builder);

    if (parsed) {
        i64 name_offset = raz_compiler_rt_arena_get(builder.module.function_name_offsets, function_index);

        parsed = token_is_clone_function(
            &builder.scan.input,
            name_offset,
            raz_compiler_rt_arena_get(builder.module.function_name_lengths, function_index),
        );
    }
    if (parsed) {
        parsed = raz_compiler_rt_arena_get(builder.module.function_parameter_counts, function_index) == 1;
    }
    if (parsed) {
        i64 parameter = raz_compiler_rt_arena_get(builder.module.function_parameter_starts, function_index);

        parsed =
            raz_compiler_rt_arena_get(builder.module.parameter_type_structs, parameter) == structure &&
            raz_compiler_rt_arena_get(builder.module.parameter_references, parameter) != 0;
    }
    if (parsed) {
        parsed =
            raz_compiler_rt_arena_get(
                builder.module.function_return_type_structs,
                function_index,
            ) == structure &&
            raz_compiler_rt_arena_get(builder.module.function_return_slices, function_index) == 0;
    }
    if (parsed) {
        raz_compiler_rt_arena_set(builder.module.struct_clone_functions, structure, function_index);
        raz_compiler_rt_arena_set(builder.module.function_clone_structs, function_index, structure);
        builder.module.clone_impl_count += 1;
    } else if (builder.module.diagnostic_code == DiagnosticCode::None) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
    }
    builder.scan.offset = saved_scan_offset;
    init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
    builder.current_function = saved_function;
    builder.current_block = saved_block;
    builder.loop_depth = saved_loop_depth;
    builder.generic_active = saved_generic_active;
    builder.generic_template_index = saved_generic_template;
    builder.generic_type_name_offset = saved_generic_name_offset;
    builder.generic_type_name_length = saved_generic_name_length;
    builder.generic_type_structure = saved_generic_structure;
    builder.generic_type_kind = saved_generic_type;
    hir_restore_generic_substitutions(
        builder,
        saved_substitution_count,
        saved_substitution_name_offsets,
        saved_substitution_name_lengths,
        saved_substitution_type_structures,
        saved_substitution_types,
    );
    raz_compiler_rt_arena_destroy(saved_substitution_name_offsets);
    raz_compiler_rt_arena_destroy(saved_substitution_name_lengths);
    raz_compiler_rt_arena_destroy(saved_substitution_type_structures);
    raz_compiler_rt_arena_destroy(saved_substitution_types);
    builder.generic_signature_only = saved_signature_only;
    builder.generic_reparse_function_index = saved_reparse;
    return parsed;
}

fn hir_prepare_closure_blocks(HirBuilder&mut builder, i64&mut next_function) -> bool {
    while (*next_function < builder.module.function_count) {
        i64 function_index = *next_function;

        *next_function += 1;
        if (
            raz_compiler_rt_arena_get(builder.module.function_closure_ids, function_index) < 0 ||
            raz_compiler_rt_arena_get(builder.module.function_closure_body_parsed, function_index) != 0
        ) {
            continue;
        }
        i64 body_start = raz_compiler_rt_arena_get(
            builder.module.function_closure_body_starts,
            function_index,
        );

        i64 body_end = raz_compiler_rt_arena_get(builder.module.function_closure_body_ends, function_index);

        if (body_start < 0 || body_end < body_start) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }

        i64 saved_function = builder.current_function;
        i64 saved_block = builder.current_block;
        i64 saved_loop = builder.loop_depth;

        builder.current_function = function_index;
        builder.current_block = -1;
        builder.loop_depth = 0;
        raz_compiler_rt_arena_set(
            builder.module.function_local_starts,
            function_index,
            builder.module.local_count,
        );
        raz_compiler_rt_arena_set(builder.module.function_local_counts, function_index, 0);
        raz_compiler_rt_arena_set(
            builder.module.function_statement_starts,
            function_index,
            builder.module.statement_count,
        );
        raz_compiler_rt_arena_set(builder.module.function_statement_counts, function_index, 0);
        raz_compiler_rt_arena_set(
            builder.module.function_defer_starts,
            function_index,
            builder.module.defer_count,
        );
        raz_compiler_rt_arena_set(builder.module.function_defer_counts, function_index, 0);

        i64 root_block = -1;

        if (!hir_add_block(builder, body_start, body_end, &mut root_block)) {
            return false;
        }
        raz_compiler_rt_arena_set(builder.module.function_closure_root_blocks, function_index, root_block);
        raz_compiler_rt_arena_set(builder.module.function_closure_body_parsed, function_index, 1);
        builder.current_function = saved_function;
        builder.current_block = saved_block;
        builder.loop_depth = saved_loop;
    }
    return true;
}

fn hir_finalize_closure_functions(HirBuilder&mut builder) -> bool {
    i64 function_index = 0;

    while (function_index < builder.module.function_count) {
        i64 root_block = raz_compiler_rt_arena_get(
            builder.module.function_closure_root_blocks,
            function_index,
        );
        if (root_block >= 0) {
            i64 start = raz_compiler_rt_arena_get(builder.module.block_statement_starts, root_block);
            i64 count = raz_compiler_rt_arena_get(builder.module.block_statement_counts, root_block);

            raz_compiler_rt_arena_set(builder.module.function_statement_starts, function_index, start);
            raz_compiler_rt_arena_set(builder.module.function_statement_counts, function_index, count);

            i64 statement = start;

            while (statement < start + count) {
                raz_compiler_rt_arena_set(builder.module.statement_block_indices, statement, -1);
                statement += 1;
            }

            i64 local = 0;

            while (local < builder.module.local_count) {
                if (
                    raz_compiler_rt_arena_get(builder.module.local_function_indices, local) == function_index &&
                    raz_compiler_rt_arena_get(builder.module.local_block_indices, local) == root_block
                ) {
                    raz_compiler_rt_arena_set(builder.module.local_block_indices, local, -1);
                }
                local += 1;
            }
        }
        function_index += 1;
    }
    return true;
}

fn hir_incremental_check_prepare(
    HirBuilder&mut builder,
    Source& input,
    HirIncrementalCheckHints&mut hints,
) -> bool {
    if (hints.enabled == 0) {
        return true;
    }
    if (!hir_query_record_module_fingerprints(builder, input)) {
        hints.enabled = 0;
        return true;
    }
    if (builder.query_module_fingerprint_count != hints.module_count) {
        i64 reset = 1;

        while (reset <= hints.module_count && reset <= 4096) {
            raz_compiler_rt_arena_set(hints.affected_modules, reset, 2);
            reset += 1;
        }
        hints.enabled = 0;
        return true;
    }

    i64 index = 0;

    while (index < builder.query_module_fingerprint_count) {
        i64 module_id = raz_compiler_rt_arena_get(builder.query_module_fingerprint_ids, index);

        if (
            module_id <= 0 ||
            module_id > 4096 ||
            raz_compiler_rt_arena_get(hints.old_present, module_id) == 0
        ) {
            hints.enabled = 0;
            return true;
        }

        i64 current_source = raz_compiler_rt_arena_get(builder.query_module_source_fingerprints, index);
        i64 current_interface = raz_compiler_rt_arena_get(builder.query_module_interface_fingerprints, index);
        i64 kind = 0;

        if (raz_compiler_rt_arena_get(hints.old_sources, module_id) != current_source) {
            kind = 1;
            if (raz_compiler_rt_arena_get(hints.old_interfaces, module_id) != current_interface) {
                kind = 2;
            }
        }
        raz_compiler_rt_arena_set(hints.affected_modules, module_id, kind);
        index += 1;
    }

    bool propagated = true;

    while (propagated) {
        propagated = false;

        i64 edge = 0;

        while (edge < hints.edge_count) {
            i64 owner = raz_compiler_rt_arena_get(hints.edge_owners, edge);
            i64 target = raz_compiler_rt_arena_get(hints.edge_targets, edge);
            i64 target_kind = raz_compiler_rt_arena_get(hints.affected_modules, target);

            if (
                (target_kind == 2 || target_kind == 3) &&
                raz_compiler_rt_arena_get(hints.affected_modules, owner) == 0
            ) {
                raz_compiler_rt_arena_set(hints.affected_modules, owner, 3);
                propagated = true;
            }
            edge += 1;
        }
    }
    return true;
}

fn hir_incremental_check_function_clean(
    HirBuilder&mut builder,
    HirIncrementalCheckHints& hints,
    i64 function_index,
) -> bool {
    if (hints.enabled == 0 || function_index < 0 || function_index >= builder.module.function_count) {
        return false;
    }
    if (
        raz_compiler_rt_arena_get(builder.module.function_generic_template_indices, function_index) >= 0 ||
        raz_compiler_rt_arena_get(builder.module.function_inherent_structs, function_index) != -1 ||
        raz_compiler_rt_arena_get(builder.module.function_closure_ids, function_index) >= 0
    ) {
        return false;
    }

    i64 declaration = raz_compiler_rt_arena_get(builder.module.function_declaration_offsets, function_index);
    i64 module_id = hir_module_at_offset(builder, declaration);

    if (module_id <= 0 || module_id > hints.module_count) {
        return false;
    }
    return raz_compiler_rt_arena_get(hints.affected_modules, module_id) == 0;
}

fn build_hir_with_check_hints(Source input, HirIncrementalCheckHints&mut hints, HirModule&mut out) -> bool {
    if (!init_hir(out)) {
        return false;
    }

    HirBuilder builder;

    init_hir_builder(&mut builder, input, out);

    bool success = hir_predeclare_aggregate_graph(&mut builder, input);

    // Phase 1 declares ordinary function signatures while parsing all other
    // top-level declarations normally. This mirrors the native frontend's
    // declaration pass and makes function order semantically irrelevant.
    while (success && builder.current.kind != TokenKind::End) {
        if (!hir_skip_top_level_declaration(&mut builder)) {
            if (builder.last_error.code != DiagnosticCode::None) {
                success = false;
            } else {
                i64 saved_signature_only = builder.generic_signature_only;

                builder.generic_signature_only = 1;
                if (!hir_parse_function(&mut builder)) {
                    success = false;
                }
                builder.generic_signature_only = saved_signature_only;
            }
        }
    }
    if (success && builder.namespace_scope_count != 0) {
        hir_fail(&mut builder, DiagnosticCode::ExpectedToken);
        success = false;
    }
    if (success) {
        hir_query_sync_inputs(&mut builder);
    }
    if (success && !hir_incremental_check_prepare(&mut builder, &input, hints)) {
        success = false;
    }
    // Phase 2 lowers the bodies of the predeclared ordinary functions. Calls in
    // any body can now resolve every module-level function signature.

    i64 declared_function = 0;

    while (success && declared_function < out.function_count) {
        if (
            raz_compiler_rt_arena_get(out.function_generic_body_parsed, declared_function) == 0 &&
            raz_compiler_rt_arena_get(out.function_inherent_structs, declared_function) == -1 &&
            raz_compiler_rt_arena_get(out.function_generic_template_indices, declared_function) < 0 &&
            !hir_incremental_check_function_clean(&mut builder, hints, declared_function)
        ) {
            i64 saved_scan_offset = builder.scan.offset;
            TokenKind saved_current_kind = builder.current.kind;
            i64 saved_current_offset = builder.current.offset;
            i64 saved_current_length = builder.current.length;
            i64 saved_reparse = builder.generic_reparse_function_index;
            i64 saved_signature_only = builder.generic_signature_only;

            builder.scan.offset = raz_compiler_rt_arena_get(
                out.function_declaration_offsets,
                declared_function,
            );
            next_token(&mut builder.scan, &mut builder.current);
            builder.generic_reparse_function_index = declared_function;
            builder.generic_signature_only = 0;
            if (!hir_parse_function(&mut builder)) {
                success = false;
            }
            builder.scan.offset = saved_scan_offset;
            init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
            builder.generic_reparse_function_index = saved_reparse;
            builder.generic_signature_only = saved_signature_only;
        }
        declared_function += 1;
    }
    if (success) {
        hir_query_sync_inputs(&mut builder);
    }

    i64 generic_function = 0;

    while (success && generic_function < out.function_count) {
        if (!hir_materialize_generic_function(&mut builder, generic_function)) {
            success = false;
        }
        generic_function += 1;
        if (generic_function % 128 == 0) {}
    }
    if (success) {
        hir_query_sync_inputs(&mut builder);
    }

    i64 closure_function = 0;
    i64 closure_block = 0;
    bool closure_work = true;

    while (success && closure_work) {
        closure_work = false;

        i64 before_function = closure_function;

        if (!hir_prepare_closure_blocks(&mut builder, &mut closure_function)) {
            success = false;
        }
        if (closure_function > before_function) {
            closure_work = true;
        }
        while (success && closure_block < out.block_count) {
            if (!hir_parse_block_statements(&mut builder, closure_block)) {
                success = false;
            }
            closure_block += 1;
            closure_work = true;
        }
        if (closure_function < out.function_count) {
            closure_work = true;
        }
    }
    if (success && !hir_finalize_closure_functions(&mut builder)) {
        success = false;
    }
    if (success) {
        hir_query_sync_inputs(&mut builder);
    }
    // Concrete generic aggregates reserve inherent method signatures as soon as
    // their layout exists. Materialize those method bodies only after ordinary
    // blocks have instantiated the complete first wave of concrete types. Nested
    // method blocks may instantiate further generic aggregates, so drain both
    // queues to a fixed point.

    i64 inherent_function = 0;
    i64 inherent_block = out.block_count;
    bool inherent_work = true;

    while (success && inherent_work) {
        inherent_work = false;
        while (success && inherent_function < out.function_count) {
            if (!hir_materialize_generic_inherent_function(&mut builder, inherent_function)) {
                success = false;
            }
            inherent_function += 1;
            inherent_work = true;
        }
        while (success && inherent_block < out.block_count) {
            if (!hir_parse_block_statements(&mut builder, inherent_block)) {
                success = false;
            }
            inherent_block += 1;
            if (inherent_block % 256 == 0) {}
            inherent_work = true;
        }
    }
    if (success) {
        hir_query_sync_inputs(&mut builder);
    }
    // Deferred lexical blocks can instantiate generic aggregate layouts. Only
    // after those blocks are populated do we know the complete set of concrete
    // structures that may need generic Clone/Drop implementations.

    i64 generic_trait_block_start = out.block_count;
    i64 generic_clone_structure = 0;

    while (success && generic_clone_structure < out.struct_count) {
        if (!hir_materialize_generic_clone_impl(&mut builder, generic_clone_structure)) {
            success = false;
        }
        generic_clone_structure += 1;
    }

    i64 generic_drop_structure = 0;

    while (success && generic_drop_structure < out.struct_count) {
        if (!hir_materialize_generic_drop_impl(&mut builder, generic_drop_structure)) {
            success = false;
        }
        generic_drop_structure += 1;
    }

    i64 generic_trait_block = generic_trait_block_start;

    while (success && generic_trait_block < out.block_count) {
        if (!hir_parse_block_statements(&mut builder, generic_trait_block)) {
            success = false;
        }
        generic_trait_block += 1;
    }
    if (success) {
        hir_query_sync_inputs(&mut builder);
    }
    if (success && !hir_validate_control_flow_moves(&mut builder)) {
        success = false;
    }
    if (success && !hir_validate_reference_returns(&mut builder)) {
        success = false;
    }
    if (success) {}
    if (success && !hir_fold_constants(out)) {
        hir_fail(&mut builder, DiagnosticCode::ExpectedToken);
        success = false;
    }
    if (success) {}
    i64 deferred_comptime = 0;

    while (success && deferred_comptime < out.comptime_block_count) {
        i64 comptime_locals = raz_compiler_rt_arena_create(8192);
        i64 comptime_steps = raz_compiler_rt_arena_create(1);

        if (comptime_locals == 0 || comptime_steps == 0) {
            if (comptime_locals != 0) {
                raz_compiler_rt_arena_destroy(comptime_locals);
            }
            if (comptime_steps != 0) {
                raz_compiler_rt_arena_destroy(comptime_steps);
            }
            hir_fail(&mut builder, DiagnosticCode::TooManyItems);
            success = false;
        } else {
            raz_compiler_rt_arena_set(comptime_steps, 0, 0);

            i64 comptime_flow = 0;
            i64 comptime_block = raz_compiler_rt_arena_get(out.comptime_blocks, deferred_comptime);

            if (
                !hir_execute_comptime_block(
                    out,
                    comptime_block,
                    comptime_locals,
                    comptime_steps,
                    &mut comptime_flow,
                ) ||
                comptime_flow != 0
            ) {
                hir_fail(&mut builder, DiagnosticCode::ExpectedToken);
                success = false;
            }
            raz_compiler_rt_arena_destroy(comptime_locals);
            raz_compiler_rt_arena_destroy(comptime_steps);
        }
        deferred_comptime += 1;
    }
    if (success) {
        i64 ownership_local = 0;

        while (ownership_local < out.local_count) {
            raz_compiler_rt_arena_set(
                out.local_final_moved,
                ownership_local,
                raz_compiler_rt_arena_get(builder.local_moved, ownership_local),
            );
            ownership_local += 1;
        }

        i64 ownership_parameter = 0;

        while (ownership_parameter < out.parameter_count) {
            raz_compiler_rt_arena_set(
                out.parameter_final_moved,
                ownership_parameter,
                raz_compiler_rt_arena_get(builder.parameter_moved, ownership_parameter),
            );
            ownership_parameter += 1;
        }

        i64 moved_index = 0;

        while (moved_index < builder.moved_path_count) {
            i64 moved_path = raz_compiler_rt_arena_get(builder.moved_paths, moved_index);

            if (moved_path >= 0) {
                i64 destination = out.final_moved_path_count;

                out.final_moved_path_count += 1;
                raz_compiler_rt_arena_set(
                    out.final_moved_path_root_kinds,
                    destination,
                    raz_compiler_rt_arena_get(builder.moved_path_root_kinds, moved_index),
                );
                raz_compiler_rt_arena_set(
                    out.final_moved_path_root_indices,
                    destination,
                    raz_compiler_rt_arena_get(builder.moved_path_root_indices, moved_index),
                );
                raz_compiler_rt_arena_set(out.final_moved_paths, destination, moved_path);
            }
            moved_index += 1;
        }
    }
    if (success) {}
    if (success && !hir_query_record_module_fingerprints(&mut builder, &input)) {
        hir_fail(&mut builder, DiagnosticCode::TooManyItems);
        success = false;
    }
    if (success) {
        out.incremental_module_fingerprint_count = builder.query_module_fingerprint_count;

        i64 fingerprint_index = 0;

        while (fingerprint_index < builder.query_module_fingerprint_count) {
            raz_compiler_rt_arena_set(
                out.incremental_module_ids,
                fingerprint_index,
                raz_compiler_rt_arena_get(builder.query_module_fingerprint_ids, fingerprint_index),
            );
            raz_compiler_rt_arena_set(
                out.incremental_module_source_fingerprints,
                fingerprint_index,
                raz_compiler_rt_arena_get(builder.query_module_source_fingerprints, fingerprint_index),
            );
            raz_compiler_rt_arena_set(
                out.incremental_module_interface_fingerprints,
                fingerprint_index,
                raz_compiler_rt_arena_get(builder.query_module_interface_fingerprints, fingerprint_index),
            );
            fingerprint_index += 1;
        }

        i64 incremental_function = 0;

        while (incremental_function < out.function_count) {
            i64 function_offset = raz_compiler_rt_arena_get(out.function_name_offsets, incremental_function);

            raz_compiler_rt_arena_set(
                out.incremental_function_module_ids,
                incremental_function,
                hir_module_at_offset(&mut builder, function_offset),
            );
            incremental_function += 1;
        }

        i64 module_function_cursor = 0;
        i64 module_index = 0;

        while (module_index < out.incremental_module_fingerprint_count) {
            i64 module_id = raz_compiler_rt_arena_get(out.incremental_module_ids, module_index);
            i64 module_function_start = module_function_cursor;
            i64 candidate = 0;

            while (candidate < out.function_count) {
                if (raz_compiler_rt_arena_get(out.incremental_function_module_ids, candidate) == module_id) {
                    raz_compiler_rt_arena_set(
                        out.incremental_module_function_indices,
                        module_function_cursor,
                        candidate,
                    );
                    module_function_cursor += 1;
                }
                candidate += 1;
            }
            raz_compiler_rt_arena_set(
                out.incremental_module_function_starts,
                module_index,
                module_function_start,
            );
            raz_compiler_rt_arena_set(
                out.incremental_module_function_counts,
                module_index,
                module_function_cursor - module_function_start,
            );
            module_index += 1;
        }
        if (!hir_query_export_incremental_module_graph(&mut builder, out, &input)) {
            hir_fail(&mut builder, DiagnosticCode::TooManyItems);
            success = false;
        }
    }
    if (!success) {
        out.diagnostic_offset = builder.last_error.offset;
        out.diagnostic_code = builder.last_error.code;
    }
    out.profile_generic_cache_hits = builder.generic_cache_hits;
    out.profile_generic_cache_misses = builder.generic_cache_misses;
    out.profile_trait_query_cache_hits = builder.trait_query_cache_hits;
    out.profile_trait_query_cache_misses = builder.trait_query_cache_misses;
    out.profile_resolution_cache_hits = builder.resolution_cache_hits;
    out.profile_resolution_cache_misses = builder.resolution_cache_misses;
    out.profile_symbol_cache_hits = builder.symbol_cache_hits;
    out.profile_symbol_cache_misses = builder.symbol_cache_misses;
    out.profile_layout_cache_hits = builder.layout_cache_hits;
    out.profile_layout_cache_misses = builder.layout_cache_misses;
    out.profile_scope_cache_hits = builder.scope_cache_hits;
    out.profile_scope_cache_misses = builder.scope_cache_misses;
    destroy_hir_builder(&mut builder);
    // A valid Raz module may contain only types, constants, traits, or other
    // declarations. Executable entry-point validation belongs to native/FIR
    // emission, not to the language front-end or --check mode.
    return success;
}

fn build_hir(Source input, HirModule&mut out) -> bool {
    HirIncrementalCheckHints hints;

    hints.enabled = 0;
    hints.module_count = 0;
    hints.old_sources = 0;
    hints.old_interfaces = 0;
    hints.old_present = 0;
    hints.affected_modules = 0;
    hints.edge_owners = 0;
    hints.edge_targets = 0;
    hints.edge_count = 0;
    return build_hir_with_check_hints(input, &mut hints, out);
}
