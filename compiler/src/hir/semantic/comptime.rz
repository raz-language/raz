            } else if (kind == 8 || kind == 10 || kind == 1) {
                i64 value = 0;

                if (
                    !hir_eval_const_engine(
                        hir,
                        0,
                        raz_compiler_rt_arena_get(hir.statement_b, statement),
                        0,
                        locals,
                        parameters,
                        steps,
                        depth + 1,
                        0,
                        &mut value,
