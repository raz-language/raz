    } else if (local_value) {
        // Lexical bindings shadow module-level function names in value position.
        // A parameter such as `capacity` must remain the parameter even when a
        // helper function named `capacity` exists in the same module.
        if (!hir_add_node(builder, kind, slot, 0, 0, 0, &mut base)) {
            return false;
        }
        hir_apply_name_type(builder, kind, slot, base);
        // Closure borrow captures are passed as runtime reference handles.  They
        // behave like the captured place inside the closure body, so insert the
        // implicit dereference only for synthesized capture parameters.  Normal
        // source-level reference parameters continue to use their existing ABI.
        i64 active_closure_kind = raz_compiler_rt_arena_get(
            builder.module.function_closure_kinds,
            builder.current_function,
        );
        if (
            kind == 2 &&
            raz_compiler_rt_arena_get(builder.module.function_closure_ids, builder.current_function) >= 0 &&
            slot >= raz_compiler_rt_arena_get(
                builder.module.function_closure_explicit_parameter_counts,
                builder.current_function,
            ) &&
            raz_compiler_rt_arena_get(builder.module.node_references, base) != 0 &&
            active_closure_kind != 2 &&
            active_closure_kind != 3
        ) {
            i64 capture_value = -1;

            if (!hir_add_node(builder, 21, base, 0, 0, 0, &mut capture_value)) {
                return false;
            }
            hir_copy_node_type(builder, capture_value, base);
            raz_compiler_rt_arena_set(builder.module.node_references, capture_value, 0);
            base = capture_value;
        }
    } else if (global_value >= 0) {
        if (!hir_add_node(builder, 54, global_value, 0, 0, 0, &mut base)) {
            return false;
        }
        raz_compiler_rt_arena_set(
            builder.module.node_type_structs,
            base,
            raz_compiler_rt_arena_get(builder.module.global_type_structs, global_value),
        );
        hir_set_node_type(
            builder,
            base,
            raz_compiler_rt_arena_get(builder.module.global_types, global_value)
        );
        raz_compiler_rt_arena_set(
            builder.module.node_array_extents,
            base,
            raz_compiler_rt_arena_get(builder.module.global_array_extents, global_value),
        );
        raz_compiler_rt_arena_set(
            builder.module.node_function_types,
            base,
            raz_compiler_rt_arena_get(builder.module.global_function_types, global_value),
        );
    } else if (function_value >= 0) {
        if (!hir_add_node(builder, 47, function_value, 0, 0, 0, &mut base)) {
            return false;
        }
        hir_set_node_type(builder, base, 14);
        raz_compiler_rt_arena_set(
            builder.module.node_function_types,
            base,
            hir_function_pointer_signature(builder, function_value),
        );
    } else if (builder.current.kind == TokenKind::Dot || builder.current.kind == TokenKind::ColonColon) {
        i64 namespace_marker = resolved_generic_structure;

        if (namespace_marker < 0) {
            builder.namespace_lookup_target_hash = qualified_namespace;
            builder.namespace_lookup_target_package_hash = qualified_package;
            namespace_marker = hir_find_struct(builder, offset, length);
