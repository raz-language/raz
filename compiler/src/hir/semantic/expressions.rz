namespace raz_compiler_hir_semantic_expressions;

public import raz_compiler_hir_semantic_reflection;
import raz_compiler_hir_semantic_statements;

// Expression lowering into typed HIR, including calls, operators, indexing,
// closures, await, casts, and the other value-producing language forms.
// Primitive associated constants are compiler intrinsics rather than ordinary
// namespace symbols. Resolve them before general qualified-name lookup so a
// hot expression such as `i64::MAX` never falls through package, generic-trait,
// global, and function scans. Besides making the intent explicit, this avoids
// pathological semantic work when the constant participates in larger binary
// expressions (for example `(i64::MAX - digit) / radix`).
fn hir_primitive_integer_constant(
    HirBuilder&mut builder,
    i64 type_offset,
    i64 type_length,
    i64 name_offset,
    i64 name_length,
    i64&mut out_type,
    i64&mut out_value,
) -> bool {
    if (!token_is_numeric_type(&builder.scan.input, type_offset, type_length)) {
        return false;
    }

    i64 type_kind = primitive_type_kind(&builder.scan.input, type_offset, type_length);

    if (!primitive_type_is_integer(type_kind)) {
        return false;
    }
    bool is_max =
        name_length == 3 &&
        source_byte(&builder.scan.input, name_offset) == 77 &&
        source_byte(&builder.scan.input, name_offset + 1) == 65 &&
        source_byte(&builder.scan.input, name_offset + 2) == 88;
    bool is_min =
        name_length == 3 &&
        source_byte(&builder.scan.input, name_offset) == 77 &&
        source_byte(&builder.scan.input, name_offset + 1) == 73 &&
        source_byte(&builder.scan.input, name_offset + 2) == 78;
    if (!is_max && !is_min) {
        return false;
    }

    i64 width = primitive_type_width(type_kind);
    bool unsigned_type = primitive_type_is_unsigned(type_kind);

    if (is_min) {
        if (unsigned_type) {
            *out_value = 0;
        } else if (width == 8) {
            *out_value = -128;
        } else if (width == 16) {
            *out_value = -32768;
        } else if (width == 32) {
            *out_value = -2147483648;
        } else {
            *out_value = -9223372036854775807;
            *out_value -= 1;
        }
        *out_type = type_kind;
        return true;
    }
    if (width == 8) {
        if (unsigned_type) {
            *out_value = 255;
        } else {
            *out_value = 127;
        }
    } else if (width == 16) {
        if (unsigned_type) {
            *out_value = 65535;
        } else {
            *out_value = 32767;
        }
    } else if (width == 32) {
        if (unsigned_type) {
            *out_value = 4294967295;
        } else {
            *out_value = 2147483647;
        }
    } else {
        // HIR scalar constants are stored in an i64 arena slot. Signed 64-bit
        // MAX is therefore directly representable; u64::MAX is deliberately
        // left to a future wide-constant representation rather than silently
        // truncating it here.
        if (unsigned_type) {
            return false;
        }
        *out_value = 9223372036854775807;
    }
    *out_type = type_kind;
    return true;
}

fn hir_parse_named_struct_literal(HirBuilder&mut builder, i64 structure, i64&mut out) -> bool {
    if (
        structure < 0 ||
        structure >= builder.module.struct_count ||
        builder.current.kind != TokenKind::LeftBrace
    ) {
        return false;
    }

    i64 field_start = raz_compiler_rt_arena_get(builder.module.struct_field_starts, structure);
    i64 field_count = raz_compiler_rt_arena_get(builder.module.struct_field_counts, structure);
    i64 pending_arguments = raz_compiler_rt_arena_create(field_count + 1);

    if (pending_arguments == 0) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 index = 0;

    hir_advance(builder);
    while (index < field_count) {
        if (builder.current.kind != TokenKind::Identifier) {
            raz_compiler_rt_arena_destroy(pending_arguments);
            hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
            return false;
        }

        i64 field = field_start + index;

        if (
            !token_same(
                &builder.scan.input,
                raz_compiler_rt_arena_get(builder.module.struct_field_name_offsets, field),
                raz_compiler_rt_arena_get(builder.module.struct_field_name_lengths, field),
                builder.current.offset,
                builder.current.length,
            )
        ) {
            raz_compiler_rt_arena_destroy(pending_arguments);
            hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
            return false;
        }

        i64 name_offset = builder.current.offset;
        i64 name_length = builder.current.length;

        hir_advance(builder);

        i64 value = -1;

        if (builder.current.kind == TokenKind::Colon) {
            hir_advance(builder);
            if (!hir_parse_expression(builder, &mut value)) {
                raz_compiler_rt_arena_destroy(pending_arguments);
                return false;
            }
        } else {
            i64 kind = 0;
            i64 slot = -1;

            if (!hir_find_name(builder, name_offset, name_length, &mut kind, &mut slot)) {
                raz_compiler_rt_arena_destroy(pending_arguments);
                hir_fail(builder, DiagnosticCode::UnknownName);
                return false;
            }
            if (!hir_add_node(builder, kind, slot, 0, 0, 0, &mut value)) {
                raz_compiler_rt_arena_destroy(pending_arguments);
                return false;
            }
            hir_apply_name_type(builder, kind, slot, value);
        }
        raz_compiler_rt_arena_set(pending_arguments, index, value);
        index += 1;
        if (index < field_count) {
            if (!hir_expect(builder, TokenKind::Comma)) {
                raz_compiler_rt_arena_destroy(pending_arguments);
                return false;
            }
        } else if (builder.current.kind == TokenKind::Comma) {
            hir_advance(builder);
        }
    }
    if (!hir_expect(builder, TokenKind::RightBrace)) {
        raz_compiler_rt_arena_destroy(pending_arguments);
        return false;
    }
    if (builder.module.argument_count + field_count >= 262144) {
        raz_compiler_rt_arena_destroy(pending_arguments);
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    // Nested struct literals may append their own arguments while this literal
    // is being parsed. Stage the parent arguments privately and commit them only
    // after the complete literal has been parsed so its argument range remains
    // contiguous and stable.

    i64 argument_start = builder.module.argument_count;

    index = 0;
    while (index < field_count) {
        raz_compiler_rt_arena_set(
            builder.module.arguments,
            builder.module.argument_count,
            raz_compiler_rt_arena_get(pending_arguments, index),
        );
        builder.module.argument_count += 1;
        index += 1;
    }
    raz_compiler_rt_arena_destroy(pending_arguments);

    i64 constructed = -1;

    if (!hir_add_node(builder, 34, structure, argument_start, field_count, 0, &mut constructed)) {
        return false;
    }
    raz_compiler_rt_arena_set(builder.module.node_type_structs, constructed, structure);
    *out = constructed;
    return true;
}

fn hir_parse_primary(HirBuilder&mut builder, i64&mut out) -> bool {
    if (
        builder.current.kind == TokenKind::Identifier &&
        token_is_await(&builder.scan.input, &builder.current)
    ) {
        if (
            builder.current_function < 0 ||
            raz_compiler_rt_arena_get(builder.module.function_is_async, builder.current_function) == 0
        ) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        // Async suspension may outlive the current stack frame. A reference
        // whose provenance is a local stack binding cannot remain live across
        // that suspension; parameter-origin references are permitted.
        if (hir_has_live_local_reference_to_local_storage(builder)) {
            hir_fail(builder, DiagnosticCode::BorrowConflict);
            return false;
        }
        hir_advance(builder);

        i64 operand = -1;

        if (!hir_parse_primary(builder, &mut operand)) {
            return false;
        }

        i64 awaited = -1;

        if (!hir_add_node(builder, 44, operand, 0, 0, 0, &mut awaited)) {
            return false;
        }
        hir_set_node_type(builder, awaited, 0);
        *out = awaited;
        return true;
    }
    if (
        builder.current.kind == TokenKind::Identifier &&
        token_is_spawn(&builder.scan.input, &builder.current)
    ) {
        // Spawning is an async effect. Keep the restriction in the authoritative
        // HIR parser so the compact preflight parser cannot accidentally weaken it.
        if (
            builder.current_function < 0 ||
            raz_compiler_rt_arena_get(builder.module.function_is_async, builder.current_function) == 0
        ) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        hir_advance(builder);

        i64 operand = -1;

        if (!hir_parse_primary(builder, &mut operand)) {
            return false;
        }

        i64 spawned = -1;

        if (!hir_add_node(builder, 45, operand, 0, 0, 0, &mut spawned)) {
            return false;
        }
        hir_copy_node_type(builder, spawned, operand);
        *out = spawned;
        return true;
    }
    if (
        builder.comptime_mode != 0 &&
        builder.current.kind == TokenKind::Identifier &&
        token_is_assert(&builder.scan.input, &builder.current)
    ) {
        hir_advance(builder);
        if (!hir_expect(builder, TokenKind::LeftParen)) {
            return false;
        }

        i64 condition = -1;

        if (!hir_parse_expression(builder, &mut condition) || !hir_expect(builder, TokenKind::RightParen)) {
            return false;
        }

        i64 assertion = -1;

        if (!hir_add_node(builder, 43, condition, 0, 0, 0, &mut assertion)) {
            return false;
        }
        hir_set_node_type(builder, assertion, 0);
        *out = assertion;
        return true;
    }

    i64 closure_kind = 0;
    i64 closure_prefix_offset = builder.current.offset;

    if (builder.current.kind == TokenKind::Identifier && token_is_fn(&builder.scan.input, &builder.current)) {
        closure_kind = 1;
    } else if (
        builder.current.kind == TokenKind::Identifier &&
        (
            token_is_ref(&builder.scan.input, &builder.current) ||
            token_is_mut(&builder.scan.input, &builder.current) ||
            token_is_move(&builder.scan.input, &builder.current)
        )
    ) {
        i64 saved_scan_offset = builder.scan.offset;
        TokenKind saved_kind = builder.current.kind;
        i64 saved_offset = builder.current.offset;
        i64 saved_length = builder.current.length;

        if (token_is_ref(&builder.scan.input, &builder.current)) {
            closure_kind = 2;
        } else if (token_is_mut(&builder.scan.input, &builder.current)) {
            closure_kind = 3;
        } else {
            closure_kind = 4;
        }
        hir_advance(builder);
        if (
            builder.current.kind != TokenKind::Identifier ||
            !token_is_fn(&builder.scan.input, &builder.current)
        ) {
            builder.scan.offset = saved_scan_offset;
            init_token(&mut builder.current, saved_kind, saved_offset, saved_length);
            closure_kind = 0;
        }
    }
    if (closure_kind != 0) {
        if (!token_is_fn(&builder.scan.input, &builder.current)) {
            hir_advance(builder);
        }

        i64 fn_offset = builder.current.offset;

        hir_advance(builder);
        return hir_parse_immediate_closure(builder, fn_offset, closure_kind, out);
    }
    if (
        builder.current.kind == TokenKind::Identifier &&
        token_is_move(&builder.scan.input, &builder.current)
    ) {
        hir_advance(builder);

        i64 operand = -1;

        if (!hir_parse_primary(builder, &mut operand)) {
            return false;
        }
        // Raw-pointer storage has no lexical ownership root. In an explicit
        // unsafe context, moving through a dereference transfers the value out
        // of that storage without poisoning the integer/pointer variable that
        // happened to carry its address. Safe lexical moves keep using the
        // normal path-based ownership machinery below.

        bool raw_storage_move = false;

        if (raz_compiler_rt_arena_get(builder.module.node_kinds, operand) == 21) {
            i64 raw_pointer = raz_compiler_rt_arena_get(builder.module.node_a, operand);
            i64 raw_pointer_kind = raz_compiler_rt_arena_get(builder.module.node_references, raw_pointer);

            raw_storage_move = builder.unsafe_depth > 0 && (raw_pointer_kind == 2 || raw_pointer_kind == 3);
        }

        i64 root_kind = 0;
        i64 root_index = -1;
        i64 path = 0;

        if (
            !raw_storage_move &&
            !hir_node_path(builder, operand, &mut root_kind, &mut root_index, &mut path)
        ) {
            hir_fail(builder, DiagnosticCode::InvalidMove);
            return false;
        }
        if (!raw_storage_move && hir_path_is_moved(builder, root_kind, root_index, path)) {
            hir_fail(builder, DiagnosticCode::UseAfterMove);
            return false;
        }
        if (!raw_storage_move && hir_has_active_borrow(builder, root_kind, root_index, path, 2)) {
            hir_fail(builder, DiagnosticCode::BorrowConflict);
            return false;
        }
        if (!raw_storage_move && path != 0) {
            i64 root_structure = -1;

            if (root_kind == 3) {
                root_structure = raz_compiler_rt_arena_get(builder.module.local_type_structs, root_index);
            } else if (root_kind == 2) {
                root_structure = raz_compiler_rt_arena_get(builder.module.parameter_type_structs, root_index);
            }
            if (
                root_structure >= 0 &&
                raz_compiler_rt_arena_get(builder.module.struct_drop_functions, root_structure) >= 0
            ) {
                hir_fail(builder, DiagnosticCode::InvalidMove);
                return false;
            }
        }
        // Moving a Copy aggregate has copy semantics: the source remains
        // initialized.  host compiler diagnoses this as a warning rather than
        // consuming the binding, so do not poison ownership state here.

        i64 moved_structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, operand);
        bool consumes_source = true;

        if (
            path == 0 &&
            moved_structure >= 0 &&
            raz_compiler_rt_arena_get(builder.module.struct_copy_flags, moved_structure) != 0
        ) {
            consumes_source = false;
        }
        if (
            consumes_source &&
            !raw_storage_move &&
            !hir_mark_path_moved(builder, root_kind, root_index, path)
        ) {
            return false;
        }

        i64 moved = -1;

        if (!hir_add_node(builder, 39, operand, 0, 0, 0, &mut moved)) {
            return false;
        }
        hir_copy_node_type(builder, moved, operand);
        *out = moved;
        return true;
    }
    if (builder.current.kind == TokenKind::LeftBracket) {
        // Fixed-array literals are first-class expressions. Keeping them in HIR
        // makes postfix indexing, tuple/struct nesting, const evaluation and
        // runtime aggregate constants share one representation.
        hir_advance(builder);

        i64 argument_start = builder.module.argument_count;
        i64 count = 0;
        i64 element_structure = -1;
        i64 element_type = 0;

        while (builder.current.kind != TokenKind::RightBracket) {
            if (count >= 1024 || builder.module.argument_count >= 262144) {
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }

            i64 element = -1;

            if (!hir_parse_expression(builder, &mut element)) {
                return false;
            }

            i64 current_structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, element);
            i64 current_type = raz_compiler_rt_arena_get(builder.module.node_types, element);

            if (count == 0) {
                element_structure = current_structure;
                element_type = current_type;
            } else if (element_structure >= 0) {
                if (current_structure != element_structure) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            } else if (
                current_structure >= 0 ||
                !hir_require_value_type(builder, &mut element, element_type)
            ) {
                return false;
            }
            raz_compiler_rt_arena_set(builder.module.arguments, builder.module.argument_count, element);
            builder.module.argument_count += 1;
            count += 1;
            if (builder.current.kind == TokenKind::Comma) {
                hir_advance(builder);
            } else if (builder.current.kind != TokenKind::RightBracket) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
        }
        if (!hir_expect(builder, TokenKind::RightBracket) || count == 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }

        i64 array = -1;

        if (!hir_add_node(builder, 53, argument_start, count, 0, 0, &mut array)) {
            return false;
        }
        raz_compiler_rt_arena_set(builder.module.node_type_structs, array, element_structure);
        hir_set_node_type(builder, array, element_type);
        raz_compiler_rt_arena_set(builder.module.node_array_extents, array, count);

        i64 base = array;

        while (builder.current.kind == TokenKind::LeftBracket) {
            hir_advance(builder);

            i64 index = -1;

            if (!hir_parse_expression(builder, &mut index) || !hir_expect(builder, TokenKind::RightBracket)) {
                return false;
            }
            if (raz_compiler_rt_arena_get(builder.module.node_kinds, index) == 1) {
                i64 constant_index = raz_compiler_rt_arena_get(builder.module.node_values, index);

                if (constant_index < 0 || constant_index >= count) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            }

            i64 indexed = -1;

            if (!hir_add_node(builder, 22, base, index, 0, 0, &mut indexed)) {
                return false;
            }
            hir_copy_node_type(builder, indexed, base);
            raz_compiler_rt_arena_set(builder.module.node_array_extents, indexed, -1);
            base = indexed;
        }
        *out = base;
        return true;
    }
    if (builder.current.kind == TokenKind::LeftParen) {
        hir_advance(builder);

        i64 first_value = -1;

        if (!hir_parse_expression(builder, &mut first_value)) {
            return false;
        }
        if (builder.current.kind != TokenKind::Comma) {
            if (!hir_expect(builder, TokenKind::RightParen)) {
                return false;
            }
            // Grouping does not terminate postfix expressions. Preserve the
            // common enum numeric-payload projection for `(value).0` so a
            // parenthesized aggregate behaves exactly like the ungrouped value.
            if (
                builder.current.kind == TokenKind::Dot &&
                hir_type_is_enum(raz_compiler_rt_arena_get(builder.module.node_types, first_value))
            ) {
                hir_advance(builder);
                if (builder.current.kind != TokenKind::Integer) {
                    hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
                    return false;
                }

                i64 enumeration = hir_type_enum_index(raz_compiler_rt_arena_get(builder.module.node_types, first_value));
                i64 payload_index = parse_integer_value(&builder.scan.input, &builder.current);
                i64 selected_payload = -1;
                i64 member = raz_compiler_rt_arena_get(builder.module.enum_member_starts, enumeration);

                i64 member_end =
                    member +
                    raz_compiler_rt_arena_get(builder.module.enum_member_counts, enumeration);
                while (member < member_end && selected_payload < 0) {
                    i64 payload_count = raz_compiler_rt_arena_get(
                        builder.module.enum_member_payload_counts,
                        member,
                    );
                    if (payload_index >= 0 && payload_index < payload_count) {
                        selected_payload =
                            raz_compiler_rt_arena_get(builder.module.enum_member_payload_starts, member) +
                            payload_index;
                    }
                    member += 1;
                }
                if (selected_payload < 0) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }

                i64 projected = -1;

                if (!hir_add_node(builder, 16, first_value, payload_index + 1, 0, 0, &mut projected)) {
                    return false;
                }
                raz_compiler_rt_arena_set(
                    builder.module.node_type_structs,
                    projected,
                    raz_compiler_rt_arena_get(builder.module.enum_payload_type_structs, selected_payload),
                );
                hir_set_node_type(
                    builder,
                    projected,
                    raz_compiler_rt_arena_get(builder.module.enum_payload_types, selected_payload),
                );
                raz_compiler_rt_arena_set(
                    builder.module.node_array_extents,
                    projected,
                    raz_compiler_rt_arena_get(builder.module.enum_payload_array_extents, selected_payload),
                );
                hir_advance(builder);
                first_value = projected;
            }
            *out = first_value;
            return true;
        }

        i64 values = raz_compiler_rt_arena_create(64);
        i64 structures = raz_compiler_rt_arena_create(64);
        i64 types = raz_compiler_rt_arena_create(64);
        i64 references = raz_compiler_rt_arena_create(64);
        i64 slices = raz_compiler_rt_arena_create(64);
        i64 slice_mutables = raz_compiler_rt_arena_create(64);
        i64 array_extents = raz_compiler_rt_arena_create(64);

        if (
            values == 0 ||
            structures == 0 ||
            types == 0 ||
            references == 0 ||
            slices == 0 ||
            slice_mutables == 0 ||
            array_extents == 0
        ) {
            raz_compiler_rt_arena_destroy(values);
            raz_compiler_rt_arena_destroy(structures);
            raz_compiler_rt_arena_destroy(types);
            raz_compiler_rt_arena_destroy(references);
            raz_compiler_rt_arena_destroy(slices);
            raz_compiler_rt_arena_destroy(slice_mutables);
            raz_compiler_rt_arena_destroy(array_extents);
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
        }

        i64 count = 1;

        raz_compiler_rt_arena_set(values, 0, first_value);
        raz_compiler_rt_arena_set(
            structures,
            0,
            raz_compiler_rt_arena_get(builder.module.node_type_structs, first_value),
        );
        raz_compiler_rt_arena_set(
            types,
            0,
            raz_compiler_rt_arena_get(builder.module.node_types, first_value)
        );
        raz_compiler_rt_arena_set(
            references,
            0,
            raz_compiler_rt_arena_get(builder.module.node_references, first_value),
        );
        raz_compiler_rt_arena_set(
            slices,
            0,
            raz_compiler_rt_arena_get(builder.module.node_slices, first_value)
        );
        raz_compiler_rt_arena_set(
            slice_mutables,
            0,
            raz_compiler_rt_arena_get(builder.module.node_slice_mutable, first_value),
        );
        raz_compiler_rt_arena_set(
            array_extents,
            0,
            raz_compiler_rt_arena_get(builder.module.node_array_extents, first_value),
        );
        while (builder.current.kind == TokenKind::Comma) {
            hir_advance(builder);
            if (builder.current.kind == TokenKind::RightParen) {
                break;
            }
            if (count >= 64) {
                raz_compiler_rt_arena_destroy(values);
                raz_compiler_rt_arena_destroy(structures);
                raz_compiler_rt_arena_destroy(types);
                raz_compiler_rt_arena_destroy(references);
                raz_compiler_rt_arena_destroy(slices);
                raz_compiler_rt_arena_destroy(slice_mutables);
                raz_compiler_rt_arena_destroy(array_extents);
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }

            i64 value = -1;

            if (!hir_parse_expression(builder, &mut value)) {
                raz_compiler_rt_arena_destroy(values);
                raz_compiler_rt_arena_destroy(structures);
                raz_compiler_rt_arena_destroy(types);
                raz_compiler_rt_arena_destroy(references);
                raz_compiler_rt_arena_destroy(slices);
                raz_compiler_rt_arena_destroy(slice_mutables);
                raz_compiler_rt_arena_destroy(array_extents);
                return false;
            }
            raz_compiler_rt_arena_set(values, count, value);
            raz_compiler_rt_arena_set(
                structures,
                count,
                raz_compiler_rt_arena_get(builder.module.node_type_structs, value),
            );
            raz_compiler_rt_arena_set(
                types,
                count,
                raz_compiler_rt_arena_get(builder.module.node_types, value)
            );
            raz_compiler_rt_arena_set(
                references,
                count,
                raz_compiler_rt_arena_get(builder.module.node_references, value),
            );
            raz_compiler_rt_arena_set(
                slices,
                count,
                raz_compiler_rt_arena_get(builder.module.node_slices, value),
            );
            raz_compiler_rt_arena_set(
                slice_mutables,
                count,
                raz_compiler_rt_arena_get(builder.module.node_slice_mutable, value),
            );
