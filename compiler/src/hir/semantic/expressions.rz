        raz_compiler_rt_arena_destroy(structures);
        raz_compiler_rt_arena_destroy(types);
        raz_compiler_rt_arena_destroy(references);
        raz_compiler_rt_arena_destroy(slices);
        raz_compiler_rt_arena_destroy(slice_mutables);
