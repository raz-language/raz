                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }

            i64 return_enumeration = hir_type_enum_index(return_type);

            i64 payload = raz_compiler_rt_arena_get(
                builder.module.enum_member_payload_starts,
                success_member
