                            i64 argument_structure = raz_compiler_rt_arena_get(
                                builder.module.node_type_structs,
                                argument,
                            );
                            i64 payload_array_extent = raz_compiler_rt_arena_get(
                                builder.module.enum_payload_array_extents,
                                payload,
