                    builder.module.enum_member_payload_starts,
                    projected_member,
                );
                i64 projected_payload_count = raz_compiler_rt_arena_get(
                    builder.module.enum_member_payload_counts,
                    projected_member,
                );
                if (builder.current.kind == TokenKind::Integer) {
                    i64 payload_index = parse_integer_value(&builder.scan.input, &builder.current);

