                        builder.module.node_type_structs,
                        member,
                        raz_compiler_rt_arena_get(builder.module.enum_payload_type_structs, payload),
                    );
                    hir_set_node_type(
                        builder,
                        member,
                        raz_compiler_rt_arena_get(builder.module.enum_payload_types, payload),
                    );
                    raz_compiler_rt_arena_set(
                        builder.module.node_array_extents,
                        member,
                        raz_compiler_rt_arena_get(builder.module.enum_payload_array_extents, payload),
