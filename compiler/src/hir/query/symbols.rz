namespace raz_compiler_hir_query_symbols;
public import raz_compiler_hir_query_engine;
// Intern exact semantic names. Hashes accelerate the scan, but exact bytes
// define identity, so source offsets and fingerprint collisions are irrelevant
// to query correctness.
fn hir_query_intern_symbol(HirBuilder&mut builder, i64 offset, i64 length) -> i64 {
  i64 hash = raz_rt_stage1_arena_range_hash(builder.scan.input.bytes, offset, length, 17);

  if (hash < 0) {
    hash = 0 - hash;
  }

  i64 symbol = 0;

  while (symbol < builder.query_symbol_count) {
    if (
    raz_rt_stage1_arena_get(builder.query_symbol_hashes, symbol) == hash &&
    raz_rt_stage1_arena_get(builder.query_symbol_lengths, symbol) == length &&
    token_same(
    &builder.scan.input,
    raz_rt_stage1_arena_get(builder.query_symbol_offsets, symbol),
    length,
    offset,
    length,
    )
    ) {
      return symbol;
    }
    symbol += 1;
  }
  if (builder.query_symbol_count >= 8192) {
    return -1;
  }
  symbol = builder.query_symbol_count;
  builder.query_symbol_count += 1;
  raz_rt_stage1_arena_set(builder.query_symbol_hashes, symbol, hash);
  raz_rt_stage1_arena_set(builder.query_symbol_offsets, symbol, offset);
  raz_rt_stage1_arena_set(builder.query_symbol_lengths, symbol, length);
  return symbol;
}

fn hir_query_symbol_same(HirBuilder&mut builder, i64 symbol, i64 offset, i64 length) -> bool {
  if (symbol < 0 || symbol >= builder.query_symbol_count) {
    return false;
  }
  if (raz_rt_stage1_arena_get(builder.query_symbol_lengths, symbol) != length) {
    return false;
  }
  return token_same(
  &builder.scan.input,
  raz_rt_stage1_arena_get(builder.query_symbol_offsets, symbol),
  length,
  offset,
  length,
  );
}
