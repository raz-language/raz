namespace raz_compiler_hir_query_types;
public import raz_compiler_hir_query_symbols;
// Canonical HIR type identity used by semantic queries. Exact structural fields
// define identity; the returned integer is stable for the lifetime of the HIR
// semantic database and independent of source location.
fn hir_query_intern_type(
HirBuilder&mut builder,
i64 structure,
i64 type_kind,
i64 reference,
i64 reference_mutable,
i64 slice,
i64 slice_mutable,
i64 array_extent,
i64 function_signature,
i64 trait_object,
) -> i64 {
  i64 type_id = 0;

  while (type_id < builder.query_type_count) {
    if (
    raz_compiler_rt_arena_get(builder.query_type_structures, type_id) == structure &&
    raz_compiler_rt_arena_get(builder.query_type_kinds, type_id) == type_kind &&
    raz_compiler_rt_arena_get(builder.query_type_references, type_id) == reference &&
    raz_compiler_rt_arena_get(builder.query_type_reference_mutable, type_id) == reference_mutable &&
    raz_compiler_rt_arena_get(builder.query_type_slices, type_id) == slice &&
    raz_compiler_rt_arena_get(builder.query_type_slice_mutable, type_id) == slice_mutable &&
    raz_compiler_rt_arena_get(builder.query_type_array_extents, type_id) == array_extent &&
    raz_compiler_rt_arena_get(builder.query_type_function_signatures, type_id) == function_signature &&
    raz_compiler_rt_arena_get(builder.query_type_trait_objects, type_id) == trait_object
    ) {
      return type_id;
    }
    type_id += 1;
  }
  if (builder.query_type_count >= 8192) {
    return -1;
  }
  type_id = builder.query_type_count;
  builder.query_type_count += 1;
  raz_compiler_rt_arena_set(builder.query_type_structures, type_id, structure);
  raz_compiler_rt_arena_set(builder.query_type_kinds, type_id, type_kind);
  raz_compiler_rt_arena_set(builder.query_type_references, type_id, reference);
  raz_compiler_rt_arena_set(builder.query_type_reference_mutable, type_id, reference_mutable);
  raz_compiler_rt_arena_set(builder.query_type_slices, type_id, slice);
  raz_compiler_rt_arena_set(builder.query_type_slice_mutable, type_id, slice_mutable);
  raz_compiler_rt_arena_set(builder.query_type_array_extents, type_id, array_extent);
  raz_compiler_rt_arena_set(builder.query_type_function_signatures, type_id, function_signature);
  raz_compiler_rt_arena_set(builder.query_type_trait_objects, type_id, trait_object);
  return type_id;
}

fn hir_query_intern_value_type(HirBuilder&mut builder, i64 structure, i64 type_kind) -> i64 {
  return hir_query_intern_type(builder, structure, type_kind, 0, 0, 0, 0, -1, -1, -1);
}
