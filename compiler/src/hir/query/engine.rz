namespace raz_compiler_hir_query_engine;
public import raz_compiler_hir_query_invalidation;
// Shared semantic query runtime. Cache validity is controlled by semantic
// input invalidation and reverse dependency propagation, so unrelated semantic
// mutations do not flush otherwise reusable query results.
fn hir_query_same(HirBuilder&mut builder, i64 index, i64 kind, i64 a, i64 b, i64 c) -> bool {
  return (
  raz_rt_stage1_arena_get(builder.query_active_kinds, index) == kind &&
  raz_rt_stage1_arena_get(builder.query_active_a, index) == a &&
  raz_rt_stage1_arena_get(builder.query_active_b, index) == b &&
  raz_rt_stage1_arena_get(builder.query_active_c, index) == c
  );
}

fn hir_query_record_dependency(HirBuilder&mut builder, i64 kind, i64 a, i64 b, i64 c) {
  if (builder.query_active_count == 0 || builder.query_dependency_count >= 16384) {
    return;
  }

  i64 parent = builder.query_active_count - 1;

  if (hir_query_same(builder, parent, kind, a, b, c)) {
    return;
  }

  i64 dependency = builder.query_dependency_count;

  raz_rt_stage1_arena_set(
  builder.query_dependency_parent_kinds,
  dependency,
  raz_rt_stage1_arena_get(builder.query_active_kinds, parent),
  );
  raz_rt_stage1_arena_set(
  builder.query_dependency_parent_a,
  dependency,
  raz_rt_stage1_arena_get(builder.query_active_a, parent),
  );
  raz_rt_stage1_arena_set(
  builder.query_dependency_parent_b,
  dependency,
  raz_rt_stage1_arena_get(builder.query_active_b, parent),
  );
  raz_rt_stage1_arena_set(
  builder.query_dependency_parent_c,
  dependency,
  raz_rt_stage1_arena_get(builder.query_active_c, parent),
  );
  raz_rt_stage1_arena_set(builder.query_dependency_child_kinds, dependency, kind);
  raz_rt_stage1_arena_set(builder.query_dependency_child_a, dependency, a);
  raz_rt_stage1_arena_set(builder.query_dependency_child_b, dependency, b);
  raz_rt_stage1_arena_set(builder.query_dependency_child_c, dependency, c);
  builder.query_dependency_count += 1;
}

fn hir_query_lookup(
HirBuilder&mut builder,
i64 kind,
i64 a,
i64 b,
i64 c,
i64 epoch0,
i64 epoch1,
i64&mut out_result0,
i64&mut out_result1,
) -> bool {
  hir_query_record_dependency(builder, kind, a, b, c);

  i64 slot = hir_query_slot(kind, a, b, c);

  if (
  raz_rt_stage1_arena_get(builder.query_cache_states, slot) != 0 &&
  raz_rt_stage1_arena_get(builder.query_cache_kinds, slot) == kind &&
  raz_rt_stage1_arena_get(builder.query_cache_a, slot) == a &&
  raz_rt_stage1_arena_get(builder.query_cache_b, slot) == b &&
  raz_rt_stage1_arena_get(builder.query_cache_c, slot) == c &&
  raz_rt_stage1_arena_get(builder.query_cache_epoch0, slot) == epoch0 &&
  raz_rt_stage1_arena_get(builder.query_cache_epoch1, slot) == epoch1
  ) {
    *out_result0 = raz_rt_stage1_arena_get(builder.query_cache_result0, slot);
    *out_result1 = raz_rt_stage1_arena_get(builder.query_cache_result1, slot);
    builder.query_cache_hits += 1;
    return true;
  }
  builder.query_cache_misses += 1;
  return false;
}

fn hir_query_begin(HirBuilder&mut builder, i64 kind, i64 a, i64 b, i64 c) -> bool {
  hir_query_record_dependency(builder, kind, a, b, c);

  i64 active = 0;

  while (active < builder.query_active_count) {
    if (hir_query_same(builder, active, kind, a, b, c)) {
      builder.query_cycle_count += 1;
      return false;
    }
    active += 1;
  }
  if (builder.query_active_count >= 128) {
    builder.query_cycle_count += 1;
    return false;
  }

  i64 index = builder.query_active_count;

  raz_rt_stage1_arena_set(builder.query_active_kinds, index, kind);
  raz_rt_stage1_arena_set(builder.query_active_a, index, a);
  raz_rt_stage1_arena_set(builder.query_active_b, index, b);
  raz_rt_stage1_arena_set(builder.query_active_c, index, c);
  builder.query_active_count += 1;
  return true;
}

fn hir_query_end(
HirBuilder&mut builder,
i64 kind,
i64 a,
i64 b,
i64 c,
i64 epoch0,
i64 epoch1,
i64 result0,
i64 result1,
bool cache_result,
) {
  if (builder.query_active_count > 0) {
    builder.query_active_count -= 1;
  }
  if (!cache_result) {
    return;
  }

  i64 slot = hir_query_slot(kind, a, b, c);

  raz_rt_stage1_arena_set(builder.query_cache_kinds, slot, kind);
  raz_rt_stage1_arena_set(builder.query_cache_a, slot, a);
  raz_rt_stage1_arena_set(builder.query_cache_b, slot, b);
  raz_rt_stage1_arena_set(builder.query_cache_c, slot, c);
  raz_rt_stage1_arena_set(builder.query_cache_epoch0, slot, epoch0);
  raz_rt_stage1_arena_set(builder.query_cache_epoch1, slot, epoch1);
  raz_rt_stage1_arena_set(builder.query_cache_result0, slot, result0);
  raz_rt_stage1_arena_set(builder.query_cache_result1, slot, result1);
  raz_rt_stage1_arena_set(builder.query_cache_revisions, slot, builder.query_revision);
  raz_rt_stage1_arena_set(builder.query_cache_states, slot, 1);
}
