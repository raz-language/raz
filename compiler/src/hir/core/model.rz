namespace raz_compiler_hir_core_model;

public import raz_compiler_frontend_parser;

// Core HIR storage and metadata. These tables are shared by semantic analysis,
// ownership checking, MIR lowering, and compile-time evaluation.
public struct HirModule {
    i64 function_count;
    i64 diagnostic_offset;
    DiagnosticCode diagnostic_code;
    i64 parameter_count;
    i64 local_count;
    i64 node_count;
    i64 statement_count;
    i64 argument_count;
    i64 block_count;
    i64 struct_count;
    i64 drop_impl_count;
    i64 clone_impl_count;
    i64 generic_function_count;
    i64 generic_struct_count;

    // Generic templates own a packed list of type parameters. The legacy
    // single-parameter fields below remain as mirrors of parameter 0 while
    // older lowering helpers are migrated to the packed representation.

    i64 generic_parameter_count;
    i64 generic_parameter_name_offsets;
    i64 generic_parameter_name_lengths;

    // 0 = type parameter, 1 = named lifetime, 2 = const value parameter.

    i64 generic_parameter_kinds;
    i64 generic_parameter_const_types;
    i64 generic_parameter_bound_starts;
    i64 generic_parameter_bound_counts;
    i64 generic_parameter_bound_count;
    i64 generic_parameter_bounds;
    i64 generic_function_parameter_starts;
    i64 generic_function_parameter_counts;
    i64 generic_struct_parameter_starts;
    i64 generic_struct_parameter_counts;

    // Interned function-pointer signatures. Function values keep pointer ABI
    // representation while semantic compatibility uses these records.

    i64 function_type_count;
    i64 function_type_parameter_count;
    i64 function_type_parameter_starts;
    i64 function_type_parameter_counts;
    i64 function_type_parameter_type_structs;
    i64 function_type_parameter_types;
    i64 function_type_parameter_references;
    i64 function_type_parameter_slices;
    i64 function_type_parameter_slice_mutable;
    i64 function_type_parameter_function_types;
    i64 function_type_return_type_structs;
    i64 function_type_return_types;
    i64 function_type_return_references;
    i64 function_type_return_slices;
    i64 function_type_return_slice_mutable;
    i64 function_type_return_function_types;
    i64 generic_drop_impl_count;
    i64 generic_clone_impl_count;
    i64 generic_inherent_impl_count;
    i64 inherent_method_count;
    i64 trait_count;
    i64 trait_name_offsets;
    i64 trait_name_lengths;

    // Object-safety is computed from the declared trait surface. dyn Trait
    // parsing rejects traits that require associated types or object-unsafe methods.

    i64 trait_object_safe_flags;

    // Distinguish `trait Alias = A + B;` from ordinary marker traits with supertraits.

    i64 trait_alias_flags;

    // Object-safe trait methods retain declaration order and names so a dyn
    // object can use stable vtable slots without reparsing the trait later.

    i64 trait_method_count;
    i64 trait_method_starts;
    i64 trait_method_counts;
    i64 trait_method_trait_indices;
    i64 trait_method_name_offsets;
    i64 trait_method_name_lengths;
    i64 trait_method_source_offsets;

    // Whether the trait declaration supplied a default body for this method.

    i64 trait_method_default_flags;

    // Effect contracts retained on trait declarations (bit 0 pure, 1 no_panic, 2 no_alloc, 3 deterministic).

    i64 trait_method_effect_flags;
    i64 trait_associated_type_count;
    i64 trait_associated_const_count;
    i64 trait_associated_type_starts;
    i64 trait_associated_type_counts;
    i64 trait_associated_const_starts;
    i64 trait_associated_const_counts;
    i64 trait_associated_type_name_offsets;
    i64 trait_associated_type_name_lengths;
    i64 trait_associated_const_name_offsets;
    i64 trait_associated_const_name_lengths;
    i64 trait_associated_const_type_offsets;
    i64 trait_associated_const_type_lengths;

    // Supertraits are packed per trait. Built-in trait IDs use the same
    // negative encoding as generic bounds (-2 Clone, -3 Drop, -4 Copy).

    i64 trait_supertrait_count;
    i64 trait_supertrait_starts;
    i64 trait_supertrait_counts;
    i64 trait_supertraits;
    i64 trait_impl_count;
    i64 trait_impl_traits;
    i64 trait_impl_structures;

    // Source provenance retained for implementation reflection. A generic index
    // of -1 denotes a concrete/non-template implementation.

    i64 trait_impl_source_offsets;
    i64 trait_impl_generic_indices;
    i64 generic_trait_impl_count;
    i64 generic_trait_source_offsets;
    i64 generic_trait_traits;
    i64 generic_trait_struct_templates;
    i64 generic_trait_type_name_offsets;
    i64 generic_trait_type_name_lengths;
    i64 generic_trait_bound_counts;
    i64 generic_trait_bounds;
    i64 struct_field_count;
    i64 enum_count;
    i64 enum_member_count;
    i64 generic_enum_count;
    i64 generic_enum_name_offsets;
    i64 generic_enum_name_lengths;
    i64 generic_enum_source_offsets;
    i64 generic_enum_parameter_starts;
    i64 generic_enum_parameter_counts;
    i64 generic_enum_derive_copy_flags;
    i64 generic_enum_derive_clone_flags;
    i64 constant_count;

    // Backend-neutral module storage. Globals/statics are real addressable
    // storage visible to MIR and every backend; TLS and external declarations
    // are properties of the declaration, not LLVM-only escape hatches.

    i64 global_count;
    i64 global_name_offsets;
    i64 global_name_lengths;
    i64 global_type_structs;
    i64 global_types;
    i64 global_array_extents;
    i64 global_function_types;
    i64 global_mutable_flags;
    i64 global_extern_flags;
    i64 global_tls_flags;
    i64 global_internal_flags;
    i64 global_public_flags;
    i64 global_initializer_nodes;
    i64 constant_name_offsets;
    i64 constant_name_lengths;
    i64 constant_nodes;
    i64 constant_types;
    i64 constant_function_indices;
    i64 constant_block_indices;
    i64 constant_source_offsets;
    i64 struct_name_offsets;
    i64 struct_name_lengths;
    i64 struct_field_starts;
    i64 struct_field_counts;
    i64 struct_tuple_flags;

    // Retained source layout attributes for reflection and ABI-stable layout.

    i64 struct_packed_flags;
    i64 struct_repr_c_flags;
    i64 struct_explicit_alignments;
    i64 struct_attribute_counts;
    i64 struct_drop_functions;
    i64 struct_clone_functions;

    // Structural Clone derives that do not require a handwritten clone function.

    i64 struct_derived_clone_flags;
    i64 struct_copy_flags;
    i64 struct_generic_template_indices;
    i64 struct_generic_type_structs;
    i64 struct_generic_types;
    i64 struct_generic_argument_starts;
    i64 struct_generic_argument_counts;
    i64 struct_generic_argument_count;
    i64 struct_generic_argument_type_structs;
    i64 struct_generic_argument_types;
    i64 generic_struct_name_offsets;
    i64 generic_struct_name_lengths;
    i64 generic_struct_source_offsets;
    i64 generic_struct_type_name_offsets;
    i64 generic_struct_type_name_lengths;
    i64 generic_struct_derive_copy_flags;
    i64 generic_struct_derive_clone_flags;
    i64 generic_drop_source_offsets;
    i64 generic_drop_struct_templates;
    i64 generic_drop_type_name_offsets;
    i64 generic_drop_type_name_lengths;
    i64 generic_drop_requires_drop;
    i64 generic_clone_source_offsets;
    i64 generic_clone_struct_templates;
    i64 generic_clone_type_name_offsets;
    i64 generic_clone_type_name_lengths;
    i64 generic_clone_requires_clone;
    i64 generic_inherent_source_offsets;
    i64 generic_inherent_struct_templates;
    i64 generic_inherent_type_name_offsets;
    i64 generic_inherent_type_name_lengths;
    i64 inherent_method_structures;
    i64 inherent_method_name_offsets;
    i64 inherent_method_name_lengths;
    i64 inherent_method_functions;
    i64 inherent_method_receivers;
    i64 function_inherent_structs;
    i64 function_inherent_source_offsets;
    i64 function_inherent_body_parsed;

    // 0 for ordinary functions; trait method index + 1 for a concrete
    // materialization of a trait-provided default method.

    i64 function_trait_default_methods;
    i64 struct_field_name_offsets;
    i64 struct_field_name_lengths;
    i64 struct_field_type_offsets;
    i64 struct_field_type_lengths;
    i64 struct_field_type_structs;
    i64 struct_field_types;
    i64 struct_field_references;
    i64 struct_field_slices;
    i64 struct_field_slice_mutable;

    // -1 = scalar/non-array field; non-negative values are fixed-array extents.

    i64 struct_field_array_extents;
    i64 struct_field_function_types;
    i64 enum_name_offsets;
    i64 enum_name_lengths;
    i64 enum_member_starts;
    i64 enum_member_counts;
    i64 enum_member_name_offsets;
    i64 enum_member_name_lengths;
    i64 enum_member_values;
    i64 enum_member_payload_starts;
    i64 enum_member_payload_counts;
    i64 enum_has_payload;

    // Built-in value-trait derivation retained per concrete enum. Payload enums
    // are not scalar merely because their HIR type identity is numeric.

    i64 enum_copy_flags;
    i64 enum_derived_clone_flags;

    // User marker traits derived directly on concrete enums.

    i64 enum_marker_trait_count;
    i64 enum_marker_trait_starts;
    i64 enum_marker_trait_counts;
    i64 enum_marker_traits;
    i64 enum_payload_count;
    i64 enum_generic_template_indices;
    i64 enum_generic_argument_starts;
    i64 enum_generic_argument_counts;
    i64 enum_generic_argument_count;
    i64 enum_generic_argument_type_structs;
    i64 enum_generic_argument_types;
    i64 enum_payload_types;
    i64 enum_payload_type_structs;
    i64 enum_payload_array_extents;
    i64 match_arm_count;
    i64 match_binding_count;
    i64 match_arm_values;
    i64 match_arm_blocks;
    i64 match_arm_wildcards;
    i64 match_arm_enum_indices;
    i64 match_arm_member_indices;
    i64 match_arm_binding_starts;
    i64 match_arm_binding_counts;
    i64 match_binding_local_slots;
    i64 function_name_offsets;
    i64 function_name_lengths;
    i64 function_declaration_offsets;
    i64 function_parameter_starts;
    i64 function_parameter_counts;
    i64 function_local_starts;
    i64 function_local_counts;
    i64 function_last_locals;
    i64 function_statement_starts;
    i64 function_statement_counts;
    i64 function_is_extern;
    i64 function_is_const;
    i64 function_is_async;
    i64 function_is_unsafe;
    i64 function_root_statement_counts;
    i64 function_extern_kinds;
    i64 function_return_types;
    i64 function_returns_value;
    i64 function_return_references;
    i64 function_return_reference_mutable;
    i64 function_return_type_structs;
    i64 function_return_slices;
    i64 function_return_slice_mutable;
    i64 function_return_lifetimes;
    i64 function_return_function_types;
    i64 function_pointer_signatures;
    i64 function_lifetime_parameter_starts;
    i64 function_lifetime_parameter_counts;
    i64 lifetime_parameter_count;
    i64 lifetime_name_offsets;
    i64 lifetime_name_lengths;

    // Function declaration attributes retained for ABI/backend lowering.

    i64 function_abi_kinds;
    i64 function_link_name_offsets;
    i64 function_link_name_lengths;
    i64 function_target_feature_offsets;
    i64 function_target_feature_lengths;

    // Source-level effect contracts: pure/no_panic/no_alloc/deterministic.

    i64 function_effect_flags;
    i64 function_drop_structs;
    i64 function_clone_structs;
    i64 function_closure_ids;
    i64 function_closure_kinds;
    i64 function_closure_body_starts;
    i64 function_closure_body_ends;
    i64 function_closure_root_blocks;
    i64 function_closure_body_parsed;
    i64 function_closure_parent_functions;
    i64 function_closure_parent_blocks;
    i64 function_closure_explicit_parameter_counts;
    i64 function_closure_capture_starts;
    i64 function_closure_capture_counts;
    i64 closure_count;
    i64 closure_capture_count;
    i64 comptime_block_count;
    i64 comptime_blocks;
    i64 closure_capture_root_kinds;
    i64 closure_capture_root_indices;
    i64 function_generic_template_indices;
    i64 function_generic_type_structs;
    i64 function_generic_types;
    i64 function_generic_argument_starts;
    i64 function_generic_argument_counts;
    i64 function_generic_argument_count;
    i64 function_generic_argument_type_structs;
    i64 function_generic_argument_types;
    i64 function_generic_body_parsed;
    i64 generic_function_name_offsets;
    i64 generic_function_name_lengths;
    i64 generic_function_source_offsets;
    i64 generic_function_type_name_offsets;
    i64 generic_function_type_name_lengths;
    i64 generic_function_bound_counts;
    i64 generic_function_bounds;
    i64 function_defer_starts;
    i64 function_defer_counts;
    i64 parameter_name_offsets;
    i64 parameter_name_lengths;
    i64 parameter_function_indices;
    i64 parameter_type_structs;
    i64 parameter_types;
    i64 parameter_references;
    i64 parameter_reference_mutable;
    i64 parameter_lifetimes;
    i64 parameter_slices;
    i64 parameter_slice_mutable;

    // Fixed-array parameters preserve their compile-time extent separately from slices.

    i64 parameter_array_extents;
    i64 parameter_mutated;
    i64 parameter_function_types;
    i64 local_name_offsets;
    i64 local_name_lengths;
    i64 local_slots;
    i64 local_previous_function_locals;
    i64 local_function_indices;
    i64 local_block_indices;
    i64 local_type_structs;
    i64 local_types;
    i64 local_references;
    i64 local_reference_mutable;
    i64 local_lifetimes;
    i64 local_slices;
    i64 local_slice_mutable;
    i64 local_array_extents;
    i64 local_array_element_starts;
    i64 local_array_element_counts;
    i64 local_final_moved;
    i64 local_callable_functions;
    i64 local_callable_kinds;
    i64 local_callable_capture_starts;
    i64 local_callable_capture_counts;
    i64 local_callable_consumed;
    i64 local_function_types;
    i64 callable_capture_local_count;
    i64 callable_capture_locals;
    i64 parameter_final_moved;
    i64 final_moved_path_count;
    i64 final_moved_path_root_kinds;
    i64 final_moved_path_root_indices;
    i64 final_moved_paths;
    i64 array_element_count;
    i64 array_elements;
    i64 node_kinds;
    i64 node_a;
    i64 node_b;
    i64 node_c;
    i64 node_values;
    i64 node_type_structs;
    i64 node_types;
    i64 node_references;
    i64 node_reference_mutable;
    i64 node_lifetimes;
    i64 node_slices;
    i64 node_slice_mutable;
    i64 node_array_extents;
    i64 node_function_types;
    i64 arguments;
    i64 block_starts;
    i64 block_ends;
    i64 block_statement_starts;
    i64 block_statement_counts;
    i64 block_function_indices;
    i64 block_parent_indices;
    i64 block_loop_depths;
    i64 block_unsafe_depths;
    i64 block_defer_starts;
    i64 block_defer_counts;
    i64 block_defer_contexts;
    i64 defer_count;
    i64 defer_blocks;
    i64 statement_kinds;
    i64 statement_block_indices;
    i64 statement_function_indices;
    i64 statement_a;
    i64 statement_b;
    i64 statement_c;
    i64 statement_predrop_structures;
    i64 statement_predrop_root_kinds;
    i64 statement_predrop_root_indices;
    i64 statement_predrop_paths;
    i64 statement_predrop_moved_starts;
    i64 statement_predrop_moved_counts;
    i64 predrop_moved_path_count;
    i64 predrop_moved_paths;

    // Pass Z: persisted semantic-query counters. These are copied from the
    // transient HirBuilder before it is destroyed so --profile-queries can
    // report optimization effectiveness without keeping frontend scratch state.

    i64 profile_generic_cache_hits;
    i64 profile_generic_cache_misses;
    i64 profile_trait_query_cache_hits;
    i64 profile_trait_query_cache_misses;
    i64 profile_resolution_cache_hits;
    i64 profile_resolution_cache_misses;
    i64 profile_symbol_cache_hits;
    i64 profile_symbol_cache_misses;
    i64 profile_layout_cache_hits;
    i64 profile_layout_cache_misses;
    i64 profile_scope_cache_hits;
    i64 profile_scope_cache_misses;

    // Persistent incremental-build fingerprints exported from the semantic
    // builder. These survive builder destruction so the driver can persist
    // module implementation/interface state across compiler processes.

    i64 incremental_module_fingerprint_count;
    i64 incremental_module_ids;
    i64 incremental_module_source_fingerprints;
    i64 incremental_module_interface_fingerprints;
    i64 incremental_module_package_hashes;
    i64 incremental_module_namespace_hashes;
    i64 incremental_function_module_ids;
    i64 incremental_module_function_starts;
    i64 incremental_module_function_counts;
    i64 incremental_module_function_indices;
    i64 incremental_module_dependency_count;
    i64 incremental_module_dependency_owners;
    i64 incremental_module_dependency_targets;
    i64 incremental_module_dirty_kinds;
    i64 incremental_module_hir_fingerprints;
    i64 incremental_module_cached_mir_fingerprints;
    i64 incremental_module_cache_kinds;
    i64 incremental_module_cache_hit_count;
    i64 incremental_dirty_module_count;
    i64 incremental_interface_dirty_module_count;
    i64 incremental_affected_module_count;
}

public struct HirIncrementalCheckHints {
    i64 enabled;
    i64 module_count;
    i64 old_sources;
    i64 old_interfaces;
    i64 old_present;
    i64 affected_modules;
    i64 edge_owners;
    i64 edge_targets;
    i64 edge_count;
}

public struct HirBuilder {
    Lexer scan;
    Token current;
    Diagnostic last_error;
    HirModule&mut module;
    i64 current_function;
    i64 current_block;
    i64 loop_depth;
    i64 parameter_moved;
    i64 local_moved;
    i64 local_borrow_kinds;
    i64 local_borrow_source_kinds;
    i64 local_borrow_source_indices;
    i64 local_borrow_source_paths;
    i64 local_reference_last_uses;
    i64 moved_path_count;
    i64 moved_path_root_kinds;
    i64 moved_path_root_indices;
    i64 moved_paths;
    i64 allow_moved_name;
    i64 comptime_mode;
    i64 generic_active;
    i64 generic_template_index;
    i64 generic_type_name_offset;
    i64 generic_type_name_length;
    i64 generic_type_structure;
    i64 generic_type_kind;

    // Active generic substitutions used while reparsing a concrete template.
    // Keeping these in arenas lets one parser context represent T, U, ...
    // without hard-coding a fixed number of fields into HirBuilder.

    i64 generic_substitution_count;
    i64 generic_substitution_name_offsets;
    i64 generic_substitution_name_lengths;
    i64 generic_substitution_type_structs;
    i64 generic_substitution_types;
    i64 generic_signature_only;
    i64 generic_reparse_function_index;

    // Impl methods live in type/trait method namespaces and may reuse names
    // such as clone/drop across unrelated receiver types.

    i64 allow_function_name_reuse;
    i64 unsafe_depth;
    i64 last_type_lifetime;
    i64 last_type_reference_mutable;
    i64 last_type_function_signature;

    // -1 for ordinary types, otherwise the trait index for a parsed dyn Trait.

    i64 last_type_trait_object;
    i64 pending_abi_kind;
    i64 pending_link_name_offset;
    i64 pending_link_name_length;
    i64 pending_target_feature_offset;
    i64 pending_target_feature_length;
    i64 pending_effect_flags;

    // Pending derive list for the next aggregate declaration. Copy and Clone
    // are tracked explicitly; user marker traits are stored as trait IDs.

    i64 pending_derive_copy;
    i64 pending_derive_clone;
    i64 pending_derive_trait_count;
    i64 pending_struct_packed;
    i64 pending_struct_repr_c;
    i64 pending_struct_alignment;
    i64 pending_struct_attribute_count;
    i64 pending_derive_traits;

    // Frontend-only module provenance. Source declarations keep their compact
    // HIR layout and recover module ownership from source offsets.

    i64 namespace_segment_count;
    i64 namespace_segment_offsets;
    i64 namespace_segment_hashes;
    i64 current_namespace_hash;

    // Project composition preserves package provenance independently from a
    // module's source namespace so default visibility survives namespace changes.

    i64 package_segment_count;
    i64 package_segment_offsets;
    i64 package_segment_hashes;
    i64 current_package_hash;

    // Physical module provenance is separate from source namespaces.

    i64 module_segment_count;
    i64 module_segment_offsets;
    i64 module_segment_ids;
    i64 current_module_id;

    // Manifest dependency aliases map a package-local prefix to a target package.

    i64 package_dependency_count;
    i64 package_dependency_owner_packages;
    i64 package_dependency_aliases;
    i64 package_dependency_targets;

    // One visibility segment is recorded for every top-level declaration.
    // 0 = package, 1 = public, 2 = private.

    i64 declaration_visibility_count;
    i64 declaration_visibility_offsets;
    i64 declaration_visibility_values;
    i64 namespace_import_count;
    i64 namespace_import_owner_packages;
    i64 namespace_import_owners;
    i64 namespace_import_target_packages;
    i64 namespace_import_targets;
    i64 namespace_import_aliases;

    // Bit 0: qualified-only alias import. Bit 1: public re-export.

    i64 namespace_import_flags;

    // Owner-indexed import chains. Bucket heads and next links store index + 1
    // so zero remains the empty sentinel.

    i64 namespace_import_bucket_heads;
    i64 namespace_import_next;

    // Direct-mapped memoization for transitive public re-export reachability.
    // The import count is the epoch because imports are append-only while HIR is built.

    i64 namespace_reexport_cache_owner_packages;
    i64 namespace_reexport_cache_owners;
    i64 namespace_reexport_cache_target_packages;
    i64 namespace_reexport_cache_targets;
    i64 namespace_reexport_cache_epochs;
    i64 namespace_reexport_cache_results;
    i64 namespace_scope_count;
    i64 namespace_scope_hashes;

    // -1 means ordinary local/import lookup. A non-negative value constrains
    // name lookup to an explicitly qualified namespace.

    i64 namespace_lookup_target_hash;
    i64 namespace_lookup_target_package_hash;

    // Pass AC: epoch-aware cache for ordinary top-level symbol resolution.

    i64 symbol_cache_kinds;
    i64 symbol_cache_packages;
    i64 symbol_cache_namespaces;
    i64 symbol_cache_modules;
    i64 symbol_cache_name_offsets;
    i64 symbol_cache_name_lengths;
    i64 symbol_cache_epochs;
    i64 symbol_cache_results;
    i64 symbol_cache_hits;
    i64 symbol_cache_misses;
    i64 top_level_name_used;
    i64 top_level_name_packages;
    i64 top_level_name_namespaces;
    i64 top_level_name_hashes;
    i64 top_level_name_offsets;
    i64 top_level_name_lengths;

    // Pass AG: direct-mapped caches for lexical name and struct-field lookup.
    // Lexical entries are keyed by function, block, exact name bytes, and the
    // current parameter/local counts so a later declaration invalidates stale
    // hits or misses without requiring explicit cache clearing.

    i64 lexical_cache_functions;
    i64 lexical_cache_blocks;
    i64 lexical_cache_name_offsets;
    i64 lexical_cache_name_lengths;
    i64 lexical_cache_parameter_epochs;
    i64 lexical_cache_local_epochs;
    i64 lexical_cache_kinds;
    i64 lexical_cache_slots;

    // Pass AH: closure/name lookups and slot-to-local resolution caches.

    i64 function_name_cache_functions;
    i64 function_name_cache_blocks;
    i64 function_name_cache_before_offsets;
    i64 function_name_cache_name_offsets;
    i64 function_name_cache_name_lengths;
    i64 function_name_cache_parameter_epochs;
    i64 function_name_cache_local_epochs;
    i64 function_name_cache_kinds;
    i64 function_name_cache_indices;
    i64 slot_local_cache_functions;
    i64 slot_local_cache_slots;
    i64 slot_local_cache_local_epochs;
    i64 slot_local_cache_results;
    i64 field_name_cache_structures;
    i64 field_name_cache_name_offsets;
    i64 field_name_cache_name_lengths;
    i64 field_name_cache_field_epochs;
    i64 field_name_cache_results;
    i64 scope_cache_hits;
    i64 scope_cache_misses;

    // Phase 3: generic monomorphization now uses the unified semantic query runtime.
    // Profile counters are retained for compiler telemetry.

    i64 generic_cache_hits;
    i64 generic_cache_misses;

    // Phase 3: unified semantic query runtime. Every semantic subsystem uses
    // the same key/cache/epoch/cycle/dependency machinery instead of growing
    // a new direct-mapped cache and recursion guard for each feature.

    i64 query_cache_hashes;
    i64 query_cache_kinds;
    i64 query_cache_a;
    i64 query_cache_b;
    i64 query_cache_c;
    i64 query_cache_epoch0;
    i64 query_cache_epoch1;
    i64 query_cache_result0;
    i64 query_cache_result1;
    i64 query_cache_states;
    i64 query_cache_revisions;
    i64 query_revision;

    // Semantic-input fingerprints drive targeted invalidation. Cache entries
    // remain valid across unrelated database mutations; invalidation walks
    // reverse query dependencies from the affected semantic roots.

    i64 query_input_traits_fingerprint;
    i64 query_input_methods_fingerprint;
    i64 query_input_aggregates_fingerprint;
    i64 query_input_generics_fingerprint;
    i64 query_input_functions_fingerprint;
    i64 query_input_associated_fingerprint;
    i64 query_invalidation_hashes;
    i64 query_invalidation_kinds;
    i64 query_invalidation_a;
    i64 query_invalidation_b;
    i64 query_invalidation_c;
    i64 query_invalidation_count;
    i64 query_invalidation_total;
    i64 query_active_hashes;
    i64 query_active_kinds;
    i64 query_active_a;
    i64 query_active_b;
    i64 query_active_c;
    i64 query_active_count;
    i64 query_dependency_count;
    i64 query_dependency_parent_hashes;
    i64 query_dependency_parent_kinds;
    i64 query_dependency_parent_a;
    i64 query_dependency_parent_b;
    i64 query_dependency_parent_c;
    i64 query_dependency_child_hashes;
    i64 query_dependency_child_kinds;
    i64 query_dependency_child_a;
    i64 query_dependency_child_b;
    i64 query_dependency_child_c;
    i64 query_dependency_buckets;
    i64 query_dependency_next;
    i64 query_cache_hits;
    i64 query_cache_misses;
    i64 query_cycle_count;

    // Canonical semantic identities for monomorphization requests. These are
    // not result caches: they intern the exact template/entity/argument tuple
    // so query keys and cycle detection never depend on a fingerprint alone.

    i64 query_monomorph_count;
    i64 query_monomorph_entity_kinds;
    i64 query_monomorph_templates;
    i64 query_monomorph_argument_counts;
    i64 query_monomorph_hashes;
    i64 query_monomorph_argument_starts;
    i64 query_monomorph_argument_count;
    i64 query_monomorph_argument_structures;
    i64 query_monomorph_argument_types;
    i64 query_monomorph_buckets;
    i64 query_monomorph_next;

    // Canonical semantic symbols. IDs are interned from exact source bytes, so
    // query identity never depends on a source offset or a hash alone.

    i64 query_symbol_count;
    i64 query_symbol_hashes;
    i64 query_symbol_offsets;
    i64 query_symbol_lengths;
    i64 query_symbol_buckets;
    i64 query_symbol_next;

    // Canonical semantic type identities. A type ID captures the complete HIR
    // type shape used by semantic queries rather than packing ad-hoc pieces
    // directly into each query key.

    i64 query_type_count;
    i64 query_type_structures;
    i64 query_type_kinds;
    i64 query_type_references;
    i64 query_type_reference_mutable;
    i64 query_type_slices;
    i64 query_type_slice_mutable;
    i64 query_type_array_extents;
    i64 query_type_function_signatures;
    i64 query_type_trait_objects;
    i64 query_type_hashes;
    i64 query_type_buckets;
    i64 query_type_next;

    // Per-module fingerprints separate implementation changes from exported
    // semantic-interface changes. They are compiler-local identities used by
    // incremental project compilation and cache invalidation.

    i64 query_module_fingerprint_count;
    i64 query_module_fingerprint_ids;
    i64 query_module_source_fingerprints;
    i64 query_module_interface_fingerprints;

    // Compatibility profile counters retained while trait queries migrate onto
    // the unified engine. They now mirror trait traffic through that engine.

    i64 trait_query_cache_hits;
    i64 trait_query_cache_misses;

    // Resolution query profile counters remain stable across query-engine migration.

    i64 resolution_cache_hits;
    i64 resolution_cache_misses;

    // Query-engine layout profile counters. Layout and field-offset results now
    // share the semantic query cache and dependency graph.

    i64 layout_cache_hits;
    i64 layout_cache_misses;
}

// Canonical hash for a monomorphization request. The hash is deliberately
// independent of source offsets: two syntactically separate uses of Vec<i64>
// produce the same key. Exact packed arguments are still compared on hits.
fn hir_generic_argument_hash(
    i64 generic,
    i64 argument_count,
    i64 argument_structures,
    i64 argument_types,
) -> i64 {
    i64 hash = (generic + 17) % 281474976710597;

    hash = (hash * 131 + argument_count + 1) % 281474976710597;

    i64 index = 0;

    while (index < argument_count) {
        i64 structure = raz_compiler_rt_arena_get(argument_structures, index);
        i64 type_kind = raz_compiler_rt_arena_get(argument_types, index);

        hash = (hash * 131 + structure + 2) % 281474976710597;
        hash = (hash * 131 + type_kind + 2) % 281474976710597;
        index += 1;
    }
    if (hash < 0) {
        hash = 0 - hash;
    }
    return hash;
}

