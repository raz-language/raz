    raz_rt_stage1_arena_destroy(out.field_name_cache_structures);
    raz_rt_stage1_arena_destroy(out.field_name_cache_name_offsets);
    raz_rt_stage1_arena_destroy(out.field_name_cache_name_lengths);
    raz_rt_stage1_arena_destroy(out.field_name_cache_field_epochs);
    raz_rt_stage1_arena_destroy(out.field_name_cache_results);
    raz_rt_stage1_arena_destroy(out.query_cache_kinds);
    raz_rt_stage1_arena_destroy(out.query_cache_a);
    raz_rt_stage1_arena_destroy(out.query_cache_b);
    raz_rt_stage1_arena_destroy(out.query_cache_c);
    raz_rt_stage1_arena_destroy(out.query_cache_epoch0);
    raz_rt_stage1_arena_destroy(out.query_cache_epoch1);
    raz_rt_stage1_arena_destroy(out.query_cache_result0);
    raz_rt_stage1_arena_destroy(out.query_cache_result1);
    raz_rt_stage1_arena_destroy(out.query_cache_states);
    raz_rt_stage1_arena_destroy(out.query_cache_revisions);
