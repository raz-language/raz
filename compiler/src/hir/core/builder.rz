namespace raz_compiler_hir_core_builder;
public import raz_compiler_hir_core_model;
// Type resolution, signatures, generics, and the first semantic passes over HIR.
// Most errors here are about what a program means rather than how it was written.
fn hir_fail(HirBuilder&mut builder, DiagnosticCode code) {
    if (builder.last_error.code == DiagnosticCode::None) {
        set_diagnostic(&mut builder.last_error, code, builder.current.offset);
    }
}

fn hir_advance(HirBuilder&mut builder) {
    next_token(&mut builder.scan, &mut builder.current);
}

fn init_hir_builder(HirBuilder&mut out, Source input, HirModule&mut module) {
    init_lexer(&mut out.scan, input);
    clear_diagnostic(&mut out.last_error);
    out.module = module;
    out.current_function = -1;
    out.current_block = -1;
    out.loop_depth = 0;
    out.parameter_moved = raz_rt_stage1_arena_create(32768);
    out.local_moved = raz_rt_stage1_arena_create(32768);
    out.local_borrow_kinds = raz_rt_stage1_arena_create(32768);
    out.local_borrow_source_kinds = raz_rt_stage1_arena_create(32768);
    out.local_borrow_source_indices = raz_rt_stage1_arena_create(32768);
    out.local_borrow_source_paths = raz_rt_stage1_arena_create(32768);
    out.local_reference_last_uses = raz_rt_stage1_arena_create(32768);
    out.moved_path_count = 0;
    out.moved_path_root_kinds = raz_rt_stage1_arena_create(16384);
    out.moved_path_root_indices = raz_rt_stage1_arena_create(16384);
    out.moved_paths = raz_rt_stage1_arena_create(16384);
    out.allow_moved_name = 0;
    out.comptime_mode = 0;
    out.generic_active = 0;
    out.generic_template_index = -1;
    out.generic_type_name_offset = 0;
    out.generic_type_name_length = 0;
    out.generic_type_structure = -1;
    out.generic_type_kind = 0;
    out.generic_substitution_count = 0;
    out.generic_substitution_name_offsets = raz_rt_stage1_arena_create(32);
    out.generic_substitution_name_lengths = raz_rt_stage1_arena_create(32);
    out.generic_substitution_type_structs = raz_rt_stage1_arena_create(32);
    out.generic_substitution_types = raz_rt_stage1_arena_create(32);
    out.generic_signature_only = 0;
    out.generic_reparse_function_index = -1;
    out.allow_function_name_reuse = 0;
    out.unsafe_depth = 0;
    out.last_type_lifetime = -1;
    out.last_type_function_signature = -1;
    out.last_type_trait_object = -1;
    out.pending_abi_kind = 0;
    out.pending_link_name_offset = 0;
    out.pending_link_name_length = 0;
    out.pending_target_feature_offset = 0;
    out.pending_target_feature_length = 0;
    out.pending_effect_flags = 0;
    out.pending_derive_copy = 0;
    out.pending_derive_clone = 0;
    out.pending_derive_trait_count = 0;
    out.pending_derive_traits = raz_rt_stage1_arena_create(32);
    out.namespace_segment_count = 0;
    out.namespace_segment_offsets = raz_rt_stage1_arena_create(4096);
    out.namespace_segment_hashes = raz_rt_stage1_arena_create(4096);
    out.current_namespace_hash = 0;
    out.package_segment_count = 0;
    out.package_segment_offsets = raz_rt_stage1_arena_create(4096);
    out.package_segment_hashes = raz_rt_stage1_arena_create(4096);
    out.current_package_hash = 0;
    out.module_segment_count = 0;
    out.module_segment_offsets = raz_rt_stage1_arena_create(4096);
    out.module_segment_ids = raz_rt_stage1_arena_create(4096);
    out.current_module_id = 0;
    out.package_dependency_count = 0;
    out.package_dependency_owner_packages = raz_rt_stage1_arena_create(4096);
    out.package_dependency_aliases = raz_rt_stage1_arena_create(4096);
    out.package_dependency_targets = raz_rt_stage1_arena_create(4096);
    out.declaration_visibility_count = 0;
    out.declaration_visibility_offsets = raz_rt_stage1_arena_create(16384);
    out.declaration_visibility_values = raz_rt_stage1_arena_create(16384);
    out.namespace_import_count = 0;
    out.namespace_import_owner_packages = raz_rt_stage1_arena_create(4096);
    out.namespace_import_owners = raz_rt_stage1_arena_create(4096);
    out.namespace_import_target_packages = raz_rt_stage1_arena_create(4096);
    out.namespace_import_targets = raz_rt_stage1_arena_create(4096);
    out.namespace_import_aliases = raz_rt_stage1_arena_create(4096);
    out.namespace_import_flags = raz_rt_stage1_arena_create(4096);
    out.namespace_reexport_cache_owner_packages = raz_rt_stage1_arena_create(4096);
    out.namespace_reexport_cache_owners = raz_rt_stage1_arena_create(4096);
    out.namespace_reexport_cache_target_packages = raz_rt_stage1_arena_create(4096);
    out.namespace_reexport_cache_targets = raz_rt_stage1_arena_create(4096);
    out.namespace_reexport_cache_epochs = raz_rt_stage1_arena_create(4096);
    out.namespace_reexport_cache_results = raz_rt_stage1_arena_create(4096);

    i64 reexport_cache_slot = 0;

    while (reexport_cache_slot < 4096) {
        raz_rt_stage1_arena_set(out.namespace_reexport_cache_epochs, reexport_cache_slot, -1);
        raz_rt_stage1_arena_set(out.namespace_reexport_cache_results, reexport_cache_slot, 0);
        reexport_cache_slot += 1;
    }
    out.namespace_scope_count = 0;
    out.namespace_scope_hashes = raz_rt_stage1_arena_create(256);
    out.namespace_lookup_target_hash = -1;
    out.namespace_lookup_target_package_hash = -1;
    out.symbol_cache_kinds = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_packages = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_namespaces = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_modules = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_name_offsets = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_name_lengths = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_epochs = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_results = raz_rt_stage1_arena_create(2048);
    out.symbol_cache_hits = 0;
    out.symbol_cache_misses = 0;
    out.lexical_cache_functions = raz_rt_stage1_arena_create(1024);
    out.lexical_cache_blocks = raz_rt_stage1_arena_create(1024);
    out.lexical_cache_name_offsets = raz_rt_stage1_arena_create(1024);
    out.lexical_cache_name_lengths = raz_rt_stage1_arena_create(1024);
    out.lexical_cache_parameter_epochs = raz_rt_stage1_arena_create(1024);
    out.lexical_cache_local_epochs = raz_rt_stage1_arena_create(1024);
    out.lexical_cache_kinds = raz_rt_stage1_arena_create(1024);
    out.lexical_cache_slots = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_functions = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_blocks = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_before_offsets = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_name_offsets = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_name_lengths = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_parameter_epochs = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_local_epochs = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_kinds = raz_rt_stage1_arena_create(1024);
    out.function_name_cache_indices = raz_rt_stage1_arena_create(1024);
    out.slot_local_cache_functions = raz_rt_stage1_arena_create(1024);
    out.slot_local_cache_slots = raz_rt_stage1_arena_create(1024);
    out.slot_local_cache_local_epochs = raz_rt_stage1_arena_create(1024);
    out.slot_local_cache_results = raz_rt_stage1_arena_create(1024);
    out.field_name_cache_structures = raz_rt_stage1_arena_create(1024);
    out.field_name_cache_name_offsets = raz_rt_stage1_arena_create(1024);
    out.field_name_cache_name_lengths = raz_rt_stage1_arena_create(1024);
    out.field_name_cache_field_epochs = raz_rt_stage1_arena_create(1024);
    out.field_name_cache_results = raz_rt_stage1_arena_create(1024);
    out.scope_cache_hits = 0;
    out.scope_cache_misses = 0;

    i64 scope_cache_slot = 0;

    while (scope_cache_slot < 1024) {
        raz_rt_stage1_arena_set(out.lexical_cache_functions, scope_cache_slot, -1);
        raz_rt_stage1_arena_set(out.lexical_cache_kinds, scope_cache_slot, -1);
        raz_rt_stage1_arena_set(out.function_name_cache_functions, scope_cache_slot, -1);
        raz_rt_stage1_arena_set(out.function_name_cache_kinds, scope_cache_slot, -1);
        raz_rt_stage1_arena_set(out.slot_local_cache_functions, scope_cache_slot, -1);
        raz_rt_stage1_arena_set(out.slot_local_cache_results, scope_cache_slot, -1);
        raz_rt_stage1_arena_set(out.field_name_cache_structures, scope_cache_slot, -1);
        raz_rt_stage1_arena_set(out.field_name_cache_results, scope_cache_slot, -2);
        scope_cache_slot += 1;
    }

    i64 symbol_cache_slot = 0;

    while (symbol_cache_slot < 2048) {
        raz_rt_stage1_arena_set(out.symbol_cache_kinds, symbol_cache_slot, -1);
        raz_rt_stage1_arena_set(out.symbol_cache_results, symbol_cache_slot, -1);
        symbol_cache_slot += 1;
    }
    out.generic_cache_hits = 0;
    out.generic_cache_misses = 0;
    out.query_cache_kinds = raz_rt_stage1_arena_create(1024);
    out.query_cache_a = raz_rt_stage1_arena_create(1024);
    out.query_cache_b = raz_rt_stage1_arena_create(1024);
    out.query_cache_c = raz_rt_stage1_arena_create(1024);
