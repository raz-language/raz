    out.query_invalidation_a = raz_rt_stage1_arena_create(4096);
    out.query_invalidation_b = raz_rt_stage1_arena_create(4096);
    out.query_invalidation_c = raz_rt_stage1_arena_create(4096);
    out.query_invalidation_count = 0;
    out.query_invalidation_total = 0;
    out.query_active_kinds = raz_rt_stage1_arena_create(128);
    out.query_active_a = raz_rt_stage1_arena_create(128);
    out.query_active_b = raz_rt_stage1_arena_create(128);
    out.query_active_c = raz_rt_stage1_arena_create(128);
    out.query_active_count = 0;
    out.query_dependency_count = 0;
    out.query_dependency_parent_kinds = raz_rt_stage1_arena_create(16384);
    out.query_dependency_parent_a = raz_rt_stage1_arena_create(16384);
    out.query_dependency_parent_b = raz_rt_stage1_arena_create(16384);
    out.query_dependency_parent_c = raz_rt_stage1_arena_create(16384);
    out.query_dependency_child_kinds = raz_rt_stage1_arena_create(16384);
    out.query_dependency_child_a = raz_rt_stage1_arena_create(16384);
    out.query_dependency_child_b = raz_rt_stage1_arena_create(16384);
    out.query_dependency_child_c = raz_rt_stage1_arena_create(16384);
    out.query_cache_hits = 0;
    out.query_cache_misses = 0;
    out.query_cycle_count = 0;
    out.query_monomorph_count = 0;
    out.query_monomorph_entity_kinds = raz_rt_stage1_arena_create(4096);
    out.query_monomorph_templates = raz_rt_stage1_arena_create(4096);
    out.query_monomorph_argument_counts = raz_rt_stage1_arena_create(4096);
    out.query_monomorph_hashes = raz_rt_stage1_arena_create(4096);
    out.query_monomorph_argument_starts = raz_rt_stage1_arena_create(4096);
    out.query_monomorph_argument_count = 0;
    out.query_monomorph_argument_structures = raz_rt_stage1_arena_create(32768);
    out.query_monomorph_argument_types = raz_rt_stage1_arena_create(32768);
    out.query_symbol_count = 0;
    out.query_symbol_hashes = raz_rt_stage1_arena_create(8192);
    out.query_symbol_offsets = raz_rt_stage1_arena_create(8192);
    out.query_symbol_lengths = raz_rt_stage1_arena_create(8192);
    out.query_type_count = 0;
    out.query_type_structures = raz_rt_stage1_arena_create(8192);
    out.query_type_kinds = raz_rt_stage1_arena_create(8192);
    out.query_type_references = raz_rt_stage1_arena_create(8192);
    out.query_type_reference_mutable = raz_rt_stage1_arena_create(8192);
    out.query_type_slices = raz_rt_stage1_arena_create(8192);
    out.query_type_slice_mutable = raz_rt_stage1_arena_create(8192);
    out.query_type_array_extents = raz_rt_stage1_arena_create(8192);
    out.query_type_function_signatures = raz_rt_stage1_arena_create(8192);
    out.query_type_trait_objects = raz_rt_stage1_arena_create(8192);
    out.query_module_fingerprint_count = 0;
    out.query_module_fingerprint_ids = raz_rt_stage1_arena_create(4096);
    out.query_module_source_fingerprints = raz_rt_stage1_arena_create(4096);
    out.query_module_interface_fingerprints = raz_rt_stage1_arena_create(4096);
    out.trait_query_cache_hits = 0;
    out.trait_query_cache_misses = 0;
    out.resolution_cache_hits = 0;
    out.resolution_cache_misses = 0;
    out.layout_cache_hits = 0;
    out.layout_cache_misses = 0;

    i64 query_cache_slot = 0;

    while (query_cache_slot < 1024) {
        raz_rt_stage1_arena_set(out.query_cache_states, query_cache_slot, 0);
        raz_rt_stage1_arena_set(out.query_cache_kinds, query_cache_slot, -1);
        query_cache_slot += 1;
    }
    hir_advance(out);
}

fn destroy_hir_builder(HirBuilder&mut out) {
    raz_rt_stage1_arena_destroy(out.parameter_moved);
    raz_rt_stage1_arena_destroy(out.local_moved);
    raz_rt_stage1_arena_destroy(out.local_borrow_kinds);
    raz_rt_stage1_arena_destroy(out.local_borrow_source_kinds);
    raz_rt_stage1_arena_destroy(out.local_borrow_source_indices);
    raz_rt_stage1_arena_destroy(out.local_borrow_source_paths);
    raz_rt_stage1_arena_destroy(out.local_reference_last_uses);
    raz_rt_stage1_arena_destroy(out.moved_path_root_kinds);
    raz_rt_stage1_arena_destroy(out.moved_path_root_indices);
