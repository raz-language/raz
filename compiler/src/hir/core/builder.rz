    raz_rt_stage1_arena_destroy(out.generic_substitution_name_offsets);
    raz_rt_stage1_arena_destroy(out.generic_substitution_name_lengths);
    raz_rt_stage1_arena_destroy(out.generic_substitution_type_structs);
    raz_rt_stage1_arena_destroy(out.generic_substitution_types);
    raz_rt_stage1_arena_destroy(out.pending_derive_traits);
    raz_rt_stage1_arena_destroy(out.namespace_segment_offsets);
    raz_rt_stage1_arena_destroy(out.namespace_segment_hashes);
    raz_rt_stage1_arena_destroy(out.package_segment_offsets);
    raz_rt_stage1_arena_destroy(out.package_segment_hashes);
    raz_rt_stage1_arena_destroy(out.module_segment_offsets);
    raz_rt_stage1_arena_destroy(out.module_segment_ids);
    raz_rt_stage1_arena_destroy(out.package_dependency_owner_packages);
    raz_rt_stage1_arena_destroy(out.package_dependency_aliases);
    raz_rt_stage1_arena_destroy(out.package_dependency_targets);
    raz_rt_stage1_arena_destroy(out.declaration_visibility_offsets);
    raz_rt_stage1_arena_destroy(out.declaration_visibility_values);
    raz_rt_stage1_arena_destroy(out.namespace_import_owner_packages);
    raz_rt_stage1_arena_destroy(out.namespace_import_owners);
    raz_rt_stage1_arena_destroy(out.namespace_import_target_packages);
    raz_rt_stage1_arena_destroy(out.namespace_import_targets);
    raz_rt_stage1_arena_destroy(out.namespace_import_aliases);
    raz_rt_stage1_arena_destroy(out.namespace_import_flags);
    raz_rt_stage1_arena_destroy(out.namespace_reexport_cache_owner_packages);
    raz_rt_stage1_arena_destroy(out.namespace_reexport_cache_owners);
    raz_rt_stage1_arena_destroy(out.namespace_reexport_cache_target_packages);
    raz_rt_stage1_arena_destroy(out.namespace_reexport_cache_targets);
    raz_rt_stage1_arena_destroy(out.namespace_reexport_cache_epochs);
    raz_rt_stage1_arena_destroy(out.namespace_reexport_cache_results);
    raz_rt_stage1_arena_destroy(out.namespace_scope_hashes);
    raz_rt_stage1_arena_destroy(out.symbol_cache_kinds);
    raz_rt_stage1_arena_destroy(out.symbol_cache_packages);
    raz_rt_stage1_arena_destroy(out.symbol_cache_namespaces);
    raz_rt_stage1_arena_destroy(out.symbol_cache_modules);
    raz_rt_stage1_arena_destroy(out.symbol_cache_name_offsets);
    raz_rt_stage1_arena_destroy(out.symbol_cache_name_lengths);
    raz_rt_stage1_arena_destroy(out.symbol_cache_epochs);
    raz_rt_stage1_arena_destroy(out.symbol_cache_results);
    raz_rt_stage1_arena_destroy(out.lexical_cache_functions);
    raz_rt_stage1_arena_destroy(out.lexical_cache_blocks);
    raz_rt_stage1_arena_destroy(out.lexical_cache_name_offsets);
    raz_rt_stage1_arena_destroy(out.lexical_cache_name_lengths);
    raz_rt_stage1_arena_destroy(out.lexical_cache_parameter_epochs);
    raz_rt_stage1_arena_destroy(out.lexical_cache_local_epochs);
    raz_rt_stage1_arena_destroy(out.lexical_cache_kinds);
