    raz_rt_stage1_arena_destroy(out.query_invalidation_a);
    raz_rt_stage1_arena_destroy(out.query_invalidation_b);
    raz_rt_stage1_arena_destroy(out.query_invalidation_c);
    raz_rt_stage1_arena_destroy(out.query_active_kinds);
