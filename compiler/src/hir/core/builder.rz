    raz_rt_stage1_arena_destroy(out.function_name_cache_name_offsets);
    raz_rt_stage1_arena_destroy(out.function_name_cache_name_lengths);
    raz_rt_stage1_arena_destroy(out.function_name_cache_parameter_epochs);
    raz_rt_stage1_arena_destroy(out.function_name_cache_local_epochs);
