    raz_rt_stage1_arena_destroy(out.query_type_references);
    raz_rt_stage1_arena_destroy(out.query_type_reference_mutable);
    raz_rt_stage1_arena_destroy(out.query_type_slices);
    raz_rt_stage1_arena_destroy(out.query_type_slice_mutable);
    raz_rt_stage1_arena_destroy(out.query_type_array_extents);
    raz_rt_stage1_arena_destroy(out.query_type_function_signatures);
    raz_rt_stage1_arena_destroy(out.query_type_trait_objects);
    raz_rt_stage1_arena_destroy(out.query_module_fingerprint_ids);
    raz_rt_stage1_arena_destroy(out.query_module_source_fingerprints);
    raz_rt_stage1_arena_destroy(out.query_module_interface_fingerprints);
}

// Namespace paths use a deterministic 48-bit modular rolling hash. The large
// modulus keeps collision probability negligible while avoiding signed overflow
// on every backend supported by the self-host compiler.
fn hir_namespace_hash_byte(i64 hash, i64 value) -> i64 {
    return (hash * 131 + value + 1) % 281474976710597;
}

fn hir_namespace_hash_token(HirBuilder&mut builder, i64 hash, Token& token) -> i64 {
    return raz_rt_stage1_arena_range_hash(builder.scan.input.bytes, token.offset, token.length, hash);
}

// Parse and consume a namespace path such as `alloc::vec`.
fn hir_parse_namespace_path(HirBuilder&mut builder, i64&mut out_hash) -> bool {
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }

    i64 hash = 17;
    bool more = true;

    while (more) {
        hash = hir_namespace_hash_token(builder, hash, &builder.current);
        hir_advance(builder);
        if (builder.current.kind == TokenKind::ColonColon) {
            hash = hir_namespace_hash_byte(hash, 58);
            hash = hir_namespace_hash_byte(hash, 58);
            hir_advance(builder);
            if (builder.current.kind != TokenKind::Identifier) {
                hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
                return false;
            }
        } else {
            more = false;
        }
    }
    *out_hash = hash;
    return true;
}

// Consume the remainder of a qualified source name after its first identifier.
// builder.current must be the first `::`; the namespace hash covers every
// component except the final symbol name.
fn hir_parse_qualified_name_tail(
    HirBuilder&mut builder,
    i64 first_offset,
    i64 first_length,
    i64&mut out_namespace_hash,
    i64&mut out_name_offset,
    i64&mut out_name_length,
) -> bool {
    if (builder.current.kind != TokenKind::ColonColon) {
        return false;
    }

    i64 hash = raz_rt_stage1_arena_range_hash(builder.scan.input.bytes, first_offset, first_length, 17);
    bool parsing = true;

    while (parsing) {
        hir_advance(builder);
        if (builder.current.kind != TokenKind::Identifier) {
            hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
            return false;
        }

        i64 component_offset = builder.current.offset;
        i64 component_length = builder.current.length;

        hir_advance(builder);
        if (builder.current.kind == TokenKind::ColonColon) {
            hash = hir_namespace_hash_byte(hash, 58);
            hash = hir_namespace_hash_byte(hash, 58);
            hash = raz_rt_stage1_arena_range_hash(
                builder.scan.input.bytes,
                component_offset,
                component_length,
                hash,
            );
        } else {
            *out_namespace_hash = hash;
            *out_name_offset = component_offset;
            *out_name_length = component_length;
            parsing = false;
        }
    }
    return true;
}

fn hir_begin_namespace(HirBuilder&mut builder, i64 source_offset, i64 namespace_hash) -> bool {
    if (builder.namespace_segment_count >= 4096) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 segment = builder.namespace_segment_count;

    builder.namespace_segment_count += 1;
    raz_rt_stage1_arena_set(builder.namespace_segment_offsets, segment, source_offset);
    raz_rt_stage1_arena_set(builder.namespace_segment_hashes, segment, namespace_hash);
    builder.current_namespace_hash = namespace_hash;
    return true;
}

fn hir_push_namespace(HirBuilder&mut builder, i64 source_offset, i64 namespace_hash) -> bool {
    if (builder.namespace_scope_count >= 256) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    raz_rt_stage1_arena_set(
        builder.namespace_scope_hashes,
        builder.namespace_scope_count,
        builder.current_namespace_hash,
    );
    builder.namespace_scope_count += 1;
    return hir_begin_namespace(builder, source_offset, namespace_hash);
}

fn hir_pop_namespace(HirBuilder&mut builder, i64 source_offset) -> bool {
    if (builder.namespace_scope_count <= 0) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    builder.namespace_scope_count -= 1;

    i64 parent = raz_rt_stage1_arena_get(builder.namespace_scope_hashes, builder.namespace_scope_count);

    return hir_begin_namespace(builder, source_offset, parent);
}

fn hir_namespace_at_offset(HirBuilder&mut builder, i64 source_offset) -> i64 {
    i64 low = 0;
    i64 high = builder.namespace_segment_count;

    while (low < high) {
        i64 middle = low + (high - low) / 2;

        if (raz_rt_stage1_arena_get(builder.namespace_segment_offsets, middle) <= source_offset) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if (low <= 0) {
        return 0;
    }
    return raz_rt_stage1_arena_get(builder.namespace_segment_hashes, low - 1);
}

fn hir_begin_package(HirBuilder&mut builder, i64 source_offset, i64 package_hash) -> bool {
    if (builder.package_segment_count >= 4096) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 segment = builder.package_segment_count;

    builder.package_segment_count += 1;
    raz_rt_stage1_arena_set(builder.package_segment_offsets, segment, source_offset);
    raz_rt_stage1_arena_set(builder.package_segment_hashes, segment, package_hash);
    builder.current_package_hash = package_hash;
    return true;
}

fn hir_package_at_offset(HirBuilder&mut builder, i64 source_offset) -> i64 {
    i64 low = 0;
    i64 high = builder.package_segment_count;

    while (low < high) {
        i64 middle = low + (high - low) / 2;

        if (raz_rt_stage1_arena_get(builder.package_segment_offsets, middle) <= source_offset) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if (low <= 0) {
        return 0;
    }
    return raz_rt_stage1_arena_get(builder.package_segment_hashes, low - 1);
}

fn hir_begin_module(HirBuilder&mut builder, i64 source_offset) -> bool {
    if (builder.module_segment_count >= 4096) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 segment = builder.module_segment_count;

    builder.module_segment_count += 1;

    i64 module_id = segment + 1;

    raz_rt_stage1_arena_set(builder.module_segment_offsets, segment, source_offset);
    raz_rt_stage1_arena_set(builder.module_segment_ids, segment, module_id);
    builder.current_module_id = module_id;
    return true;
}

fn hir_module_at_offset(HirBuilder&mut builder, i64 source_offset) -> i64 {
    i64 low = 0;
    i64 high = builder.module_segment_count;

    while (low < high) {
        i64 middle = low + (high - low) / 2;

        if (raz_rt_stage1_arena_get(builder.module_segment_offsets, middle) <= source_offset) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if (low <= 0) {
        return 0;
    }
    return raz_rt_stage1_arena_get(builder.module_segment_ids, low - 1);
}
