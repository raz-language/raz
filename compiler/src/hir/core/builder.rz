    raz_rt_stage1_arena_destroy(out.query_active_b);
    raz_rt_stage1_arena_destroy(out.query_active_c);
    raz_rt_stage1_arena_destroy(out.query_dependency_parent_kinds);
    raz_rt_stage1_arena_destroy(out.query_dependency_parent_a);
    raz_rt_stage1_arena_destroy(out.query_dependency_parent_b);
    raz_rt_stage1_arena_destroy(out.query_dependency_parent_c);
    raz_rt_stage1_arena_destroy(out.query_dependency_child_kinds);
    raz_rt_stage1_arena_destroy(out.query_dependency_child_a);
    raz_rt_stage1_arena_destroy(out.query_dependency_child_b);
    raz_rt_stage1_arena_destroy(out.query_dependency_child_c);
    raz_rt_stage1_arena_destroy(out.query_monomorph_entity_kinds);
    raz_rt_stage1_arena_destroy(out.query_monomorph_templates);
    raz_rt_stage1_arena_destroy(out.query_monomorph_argument_counts);
    raz_rt_stage1_arena_destroy(out.query_monomorph_hashes);
    raz_rt_stage1_arena_destroy(out.query_monomorph_argument_starts);
    raz_rt_stage1_arena_destroy(out.query_monomorph_argument_structures);
    raz_rt_stage1_arena_destroy(out.query_monomorph_argument_types);
    raz_rt_stage1_arena_destroy(out.query_symbol_hashes);
    raz_rt_stage1_arena_destroy(out.query_symbol_offsets);
    raz_rt_stage1_arena_destroy(out.query_symbol_lengths);
    raz_rt_stage1_arena_destroy(out.query_type_structures);
