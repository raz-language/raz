namespace raz_driver::path;

public import raz_driver::incremental;

// Shared compiler-driver path and registry-store resolution primitives.
// Kept separate from project graph loading so project.rz stays focused on
// manifests, module discovery, feature selection, and source assembly.

public fn project_registry_cache_path(i64 output, i64 capacity) -> i64 {
    if (output == 0 || capacity < 16) {
        return -1;
    }

    string canonical = "target/raz.cache";
    i64 target_dir = raz_compiler_rt_arena_create(6);
    i64 r16 = raz_compiler_rt_arena_create(16);
    i64 legacy = raz_compiler_rt_arena_create(12);

    if (target_dir == 0 || r16 == 0 || legacy == 0) {
        return -1;
    }

    i64 i = 0;

    while (i < 16) {
        raz_compiler_rt_arena_set(output, i, compiler_literal_byte(canonical, i));
        i += 1;
    }

    string target_bytes = "target";

    i = 0;
    while (i < 6) {
        raz_compiler_rt_arena_set(target_dir, i, compiler_literal_byte(target_bytes, i));
        i += 1;
    }
    if (raz_compiler_rt_create_dir_ascii(target_dir, 6) != 0) {
        return -1;
    }

    string r16_bytes = "./.raz/raz.cache";

    i = 0;
    while (i < 16) {
        raz_compiler_rt_arena_set(r16, i, compiler_literal_byte(r16_bytes, i));
        i += 1;
    }

    string legacy_bytes = "./.raz.cache";

    i = 0;
    while (i < 12) {
        raz_compiler_rt_arena_set(legacy, i, compiler_literal_byte(legacy_bytes, i));
        i += 1;
    }
    if (raz_compiler_rt_path_exists_ascii(output, 16) == 0) {
        if (raz_compiler_rt_path_exists_ascii(r16, 16) != 0) {
            if (raz_compiler_rt_copy_file_ascii(r16, 16, output, 16) < 0) {
                return -1;
            }
        } else if (raz_compiler_rt_path_exists_ascii(legacy, 12) != 0) {
            if (raz_compiler_rt_copy_file_ascii(legacy, 12, output, 16) < 0) {
                return -1;
            }
        }
    }
    if (raz_compiler_rt_path_exists_ascii(r16, 16) != 0) {
        raz_compiler_rt_remove_path_ascii(r16, 16);
    }
    if (raz_compiler_rt_path_exists_ascii(legacy, 12) != 0) {
        raz_compiler_rt_remove_path_ascii(legacy, 12);
    }
    raz_compiler_rt_arena_destroy(target_dir);
    raz_compiler_rt_arena_destroy(r16);
    raz_compiler_rt_arena_destroy(legacy);
    return 16;
}

public fn path_is_check_option(i64 path, i64 length) -> bool {
    if (path == 0 || length != 7) {
        return false;
    }

    string expected = "--check";
    i64 index = 0;

    while (index < 7) {
        if (raz_compiler_rt_arena_get(path, index) != compiler_literal_byte(expected, index)) {
            return false;
        }
        index += 1;
    }
    return true;
}

public fn path_has_rz_extension(i64 path, i64 length) -> bool {
    if (path == 0 || length < 3) {
        return false;
    }
    return (
        raz_compiler_rt_arena_get(path, length - 3) == 46 &&
        raz_compiler_rt_arena_get(path, length - 2) == 114 &&
        raz_compiler_rt_arena_get(path, length - 1) == 122
    );
}

public fn path_range_has_rz_extension(i64 path, i64 start, i64 length) -> bool {
    if (path == 0 || length < 3) {
        return false;
    }
    return (
        raz_compiler_rt_arena_get(path, start + length - 3) == 46 &&
        raz_compiler_rt_arena_get(path, start + length - 2) == 114 &&
        raz_compiler_rt_arena_get(path, start + length - 1) == 122
    );
}

public fn path_has_toml_extension(i64 path, i64 length) -> bool {
    if (path == 0 || length < 5) {
        return false;
    }
    return (
        raz_compiler_rt_arena_get(path, length - 5) == 46 &&
        raz_compiler_rt_arena_get(path, length - 4) == 116 &&
        raz_compiler_rt_arena_get(path, length - 3) == 111 &&
        raz_compiler_rt_arena_get(path, length - 2) == 109 &&
        raz_compiler_rt_arena_get(path, length - 1) == 108
    );
}

public fn ascii_is_space(i64 value) -> bool {
    return value == 32 || value == 9 || value == 13;
}

public fn path_dirname(i64 path, i64 length, i64 output, i64 capacity) -> i64 {
    if (path == 0 || output == 0 || length <= 0 || capacity <= 0) {
        return -1;
    }

    i64 end = length;

    while (
        end > 0 &&
        raz_compiler_rt_arena_get(path, end - 1) != 47 &&
        raz_compiler_rt_arena_get(path, end - 1) != 92
    ) {
        end -= 1;
    }
    if (end == 0) {
        if (capacity < 1) {
            return -1;
        }
        raz_compiler_rt_arena_set(output, 0, 46);
        return 1;
    }

    i64 count = end - 1;

    if (count <= 0) {
        count = 1;
    }
    if (count > capacity) {
        return -1;
    }

    i64 index = 0;

    while (index < count) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(path, index));
        index += 1;
    }
    return count;
}

public fn path_vendor_active() -> bool {
    i64 marker = raz_compiler_rt_arena_create(13);

    if (marker == 0) {
        return false;
    }

    string bytes = "./.raz-vendor";
    i64 i = 0;

    while (i < 13) {
        raz_compiler_rt_arena_set(marker, i, compiler_literal_byte(bytes, i));
        i += 1;
    }

    bool active = raz_compiler_rt_path_exists_ascii(marker, 13) != 0;

    raz_compiler_rt_arena_destroy(marker);
    return active;
}

public fn path_vendor_git(i64 right, i64 start, i64 count, i64 output, i64 capacity) -> i64 {
    if (!path_vendor_active() || output == 0 || right == 0) {
        return 0;
    }

    string prefix_a = "./target/git/";
    string prefix_b = "target/git/";
    string legacy_a = "./.raz/git/";
    string legacy_b = ".raz/git/";
    i64 prefix_length = 0;
    bool matched = count > 13;
    i64 i = 0;

    while (matched && i < 13) {
        if (raz_compiler_rt_arena_get(right, start + i) != compiler_literal_byte(prefix_a, i)) {
            matched = false;
        }
        i += 1;
    }
    if (matched) {
        prefix_length = 13;
    } else {
        matched = count > 11;
        i = 0;
        while (matched && i < 11) {
            if (raz_compiler_rt_arena_get(right, start + i) != compiler_literal_byte(prefix_b, i)) {
                matched = false;
            }
            i += 1;
        }
        if (matched) {
            prefix_length = 11;
        } else {
            matched = count > 11;
            i = 0;
            while (matched && i < 11) {
                if (raz_compiler_rt_arena_get(right, start + i) != compiler_literal_byte(legacy_a, i)) {
                    matched = false;
                }
                i += 1;
            }
            if (matched) {
                prefix_length = 11;
            } else {
                matched = count > 9;
                i = 0;
                while (matched && i < 9) {
                    if (raz_compiler_rt_arena_get(right, start + i) != compiler_literal_byte(legacy_b, i)) {
                        matched = false;
                    }
                    i += 1;
                }
                if (matched) {
                    prefix_length = 9;
                }
            }
        }
    }
    if (prefix_length == 0) {
        return 0;
    }

    string base = "./vendor/git/";
    i64 tail = count - prefix_length;

    if (13 + tail > capacity) {
        return -1;
    }
    i = 0;
    while (i < 13) {
        raz_compiler_rt_arena_set(output, i, compiler_literal_byte(base, i));
        i += 1;
    }
    i = 0;
    while (i < tail) {
        raz_compiler_rt_arena_set(
            output,
            13 + i,
            raz_compiler_rt_arena_get(right, start + prefix_length + i),
        );
        i += 1;
    }
    return 13 + tail;
}

public fn path_registry_store_root(i64 output, i64 capacity) -> i64 {
    if (output == 0 || capacity <= 0) {
        return -1;
    }
    if (path_vendor_active()) {
        string vendor = "./vendor/registry";

        if (capacity < 17) {
            return -1;
        }

        i64 vi = 0;

        while (vi < 17) {
            raz_compiler_rt_arena_set(output, vi, compiler_literal_byte(vendor, vi));
            vi += 1;
        }
        return 17;
    }

    i64 key = raz_compiler_rt_arena_create(32);
    i64 home = raz_compiler_rt_arena_create(8192);

    if (key == 0 || home == 0) {
        return -1;
    }

    string store_key = "RAZ_PACKAGE_STORE";
    i64 i = 0;

    while (i < 17) {
        raz_compiler_rt_arena_set(key, i, compiler_literal_byte(store_key, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_env_get_ascii(key, 17, output, capacity);

    if (length > 0) {
        raz_compiler_rt_arena_destroy(key);
        raz_compiler_rt_arena_destroy(home);
        return length;
    }

    string raz_home = "RAZ_HOME";

    i = 0;
    while (i < 8) {
        raz_compiler_rt_arena_set(key, i, compiler_literal_byte(raz_home, i));
        i += 1;
    }

    i64 home_length = raz_compiler_rt_env_get_ascii(key, 8, home, 8192);
    i64 suffix_length = 6;
    string suffix = "/store";

    if (home_length <= 0) {
        string home_key = "HOME";

        i = 0;
        while (i < 4) {
            raz_compiler_rt_arena_set(key, i, compiler_literal_byte(home_key, i));
            i += 1;
        }
        home_length = raz_compiler_rt_env_get_ascii(key, 4, home, 8192);
        suffix_length = 11;
    }
    if (home_length <= 0) {
        string profile_key = "USERPROFILE";

        i = 0;
        while (i < 11) {
            raz_compiler_rt_arena_set(key, i, compiler_literal_byte(profile_key, i));
            i += 1;
        }
        home_length = raz_compiler_rt_env_get_ascii(key, 11, home, 8192);
        suffix_length = 11;
    }
    if (home_length > 0) {
        if (home_length + suffix_length > capacity) {
            raz_compiler_rt_arena_destroy(key);
            raz_compiler_rt_arena_destroy(home);
            return -1;
        }
        i = 0;
        while (i < home_length) {
            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(home, i));
            i += 1;
        }
        if (suffix_length == 6) {
            i = 0;
            while (i < 6) {
                raz_compiler_rt_arena_set(output, home_length + i, compiler_literal_byte(suffix, i));
                i += 1;
            }
        } else {
            i64 user_suffix[12] = [47, 46, 114, 97, 122, 47, 115, 116, 111, 114, 101, 0];

            i = 0;
            while (i < 11) {
                raz_compiler_rt_arena_set(output, home_length + i, user_suffix[i]);
                i += 1;
            }
            suffix_length = 11;
        }
        raz_compiler_rt_arena_destroy(key);
        raz_compiler_rt_arena_destroy(home);
        return home_length + suffix_length;
    }

    string fallback = "./target/store";

    if (capacity < 14) {
        raz_compiler_rt_arena_destroy(key);
        raz_compiler_rt_arena_destroy(home);
        return -1;
    }
    i = 0;
    while (i < 14) {
        raz_compiler_rt_arena_set(output, i, compiler_literal_byte(fallback, i));
        i += 1;
    }
    raz_compiler_rt_arena_destroy(key);
    raz_compiler_rt_arena_destroy(home);
    return 14;
}

public fn path_registry_decl(i64 right, i64 start, i64 count) -> bool {
    if (count <= 10) {
        return false;
    }

    string prefix = "registry:";
    i64 i = 0;

    while (i < 9) {
        if (raz_compiler_rt_arena_get(right, start + i) != compiler_literal_byte(prefix, i)) {
            return false;
        }
        i += 1;
    }
    // Content hashes contain no '@'. Human registry declarations do.
    while (i < count) {
        if (raz_compiler_rt_arena_get(right, start + i) == 64) {
            return i > 9 && i + 1 < count;
        }
        i += 1;
    }
    return false;
}

public fn path_registry_locked_checksum(i64 right, i64 start, i64 count, i64 output, i64 capacity) -> i64 {
    i64 at = 9;

    while (at < count && raz_compiler_rt_arena_get(right, start + at) != 64) {
        at += 1;
    }
    if (at <= 9 || at >= count || at - 9 > 4096) {
        return -1;
    }

    i64 name_length = at - 9;
    i64 lock_path = raz_compiler_rt_arena_create(16);
    i64 data = raz_compiler_rt_arena_create(2097152);

    if (lock_path == 0 || data == 0) {
        return -1;
    }

    string lp = "./raz.lock";
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(lock_path, i, compiler_literal_byte(lp, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_read_ascii(lock_path, 10, data, 2097152);

    raz_compiler_rt_arena_destroy(lock_path);
    if (length > 0) {
        i64 cursor = 0;
        bool in_package = false;
        bool name_match = false;

        while (cursor < length) {
            i64 line_start = cursor;

            while (
                cursor < length &&
                raz_compiler_rt_arena_get(data, cursor) != 10 &&
                raz_compiler_rt_arena_get(data, cursor) != 13
            ) {
                cursor += 1;
            }

            i64 line_end = cursor;

            while (
                cursor < length &&
                (
                    raz_compiler_rt_arena_get(data, cursor) == 10 ||
                    raz_compiler_rt_arena_get(data, cursor) == 13
                )
            ) {
                cursor += 1;
            }
            if (line_end - line_start == 11) {
                string hdr = "[[package]]";
                bool same = true;

                i = 0;
                while (i < 11) {
                    if (raz_compiler_rt_arena_get(data, line_start + i) != compiler_literal_byte(hdr, i)) {
                        same = false;
                    }
                    i += 1;
                }
                if (same) {
                    in_package = true;
                    name_match = false;
                    continue;
                }
            }
            if (!in_package) {
                continue;
            }
            // name = "..."
            if (
                line_end - line_start >= 9 &&
                raz_compiler_rt_arena_get(data, line_start) == 110 &&
                raz_compiler_rt_arena_get(data, line_start + 1) == 97 &&
                raz_compiler_rt_arena_get(data, line_start + 2) == 109 &&
                raz_compiler_rt_arena_get(data, line_start + 3) == 101
            ) {
                i64 q = line_start;

                while (q < line_end && raz_compiler_rt_arena_get(data, q) != 34) {
                    q += 1;
                }
                if (q < line_end) {
                    i64 e = q + 1;

                    while (e < line_end && raz_compiler_rt_arena_get(data, e) != 34) {
                        e += 1;
                    }
                    name_match = e - q - 1 == name_length;
                    i = 0;
                    while (name_match && i < name_length) {
                        if (
                            raz_compiler_rt_arena_get(
                                data,
                                q + 1 + i,
                            ) != raz_compiler_rt_arena_get(right, start + 9 + i)
                        ) {
                            name_match = false;
                        }
                        i += 1;
                    }
                }
                continue;
            }
            // checksum = "..." on the matching registry package entry.
            if (
                name_match &&
                line_end - line_start >= 13 &&
                raz_compiler_rt_arena_get(data, line_start) == 99 &&
                raz_compiler_rt_arena_get(data, line_start + 1) == 104 &&
                raz_compiler_rt_arena_get(data, line_start + 2) == 101 &&
                raz_compiler_rt_arena_get(data, line_start + 3) == 99 &&
                raz_compiler_rt_arena_get(data, line_start + 4) == 107
            ) {
                i64 q = line_start;

                while (q < line_end && raz_compiler_rt_arena_get(data, q) != 34) {
                    q += 1;
                }
                if (q < line_end) {
                    i64 e = q + 1;

                    while (e < line_end && raz_compiler_rt_arena_get(data, e) != 34) {
                        e += 1;
                    }

                    i64 n = e - q - 1;

                    if (n > 0 && n <= capacity) {
                        i = 0;
                        while (i < n) {
                            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(data, q + 1 + i));
                            i += 1;
                        }
                        raz_compiler_rt_arena_destroy(data);
                        return n;
                    }
                }
            }
        }
    }
    raz_compiler_rt_arena_destroy(data);
    // During `raz add`, the new exact resolution exists in the transient cache
    // before raz.lock is regenerated. Use it only as a bootstrap fallback.

    i64 cache_path = raz_compiler_rt_arena_create(20);
    i64 cache = raz_compiler_rt_arena_create(1048576);

    if (cache_path == 0 || cache == 0) {
        return -1;
    }

    i64 cache_path_length = project_registry_cache_path(cache_path, 20);

    if (cache_path_length <= 0) {
        raz_compiler_rt_arena_destroy(cache_path);
        raz_compiler_rt_arena_destroy(cache);
        return -1;
    }

    i64 cache_length = raz_compiler_rt_read_ascii(cache_path, cache_path_length, cache, 1048576);

    raz_compiler_rt_arena_destroy(cache_path);
    if (cache_length > 0) {
        i64 pos = 0;

        while (pos < cache_length) {
            i64 ls = pos;

            while (pos < cache_length && raz_compiler_rt_arena_get(cache, pos) != 10) {
                pos += 1;
            }

            i64 le = pos;

            if (pos < cache_length) {
                pos += 1;
            }

            i64 token = 0;
            i64 ts = ls;
            i64 tl = 0;

            while (token <= 4) {
                while (ts < le && raz_compiler_rt_arena_get(cache, ts) == 32) {
                    ts += 1;
                }

                i64 te = ts;

                while (te < le && raz_compiler_rt_arena_get(cache, te) != 32) {
                    te += 1;
                }
                if (token == 1) {
                    tl = te - ts;

                    bool same = tl == name_length;

                    i = 0;
                    while (same && i < name_length) {
                        if (
                            raz_compiler_rt_arena_get(
                                cache,
                                ts + i,
                            ) != raz_compiler_rt_arena_get(right, start + 9 + i)
                        ) {
                            same = false;
                        }
                        i += 1;
                    }
                    if (!same) {
                        break;
                    }
                }
                if (token == 4) {
                    i64 n = te - ts;

                    if (n > 0 && n <= capacity) {
                        i = 0;
                        while (i < n) {
                            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(cache, ts + i));
                            i += 1;
                        }
                        raz_compiler_rt_arena_destroy(cache);
                        return n;
                    }
                }
                ts = te + 1;
                token += 1;
            }
        }
    }
    raz_compiler_rt_arena_destroy(cache);
    return -1;
}

public fn path_registry_virtual(i64 right, i64 start, i64 count) -> bool {
    if (count <= 9) {
        return false;
    }

    string prefix = "registry:";
    i64 i = 0;

    while (i < 9) {
        if (raz_compiler_rt_arena_get(right, start + i) != compiler_literal_byte(prefix, i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

public fn path_join(i64 left, i64 left_length, i64 right, i64 right_length, i64 output, i64 capacity) -> i64 {
    if (left == 0 || right == 0 || output == 0 || left_length < 0 || right_length < 0) {
        return -1;
    }

    i64 right_start = 0;
    i64 right_count = right_length;

    if (
        right_length >= 2 &&
        raz_compiler_rt_arena_get(right, 0) == 34 &&
        raz_compiler_rt_arena_get(right, right_length - 1) == 34
    ) {
        right_start = 1;
        right_count = right_length - 2;
    }
    if (path_registry_decl(right, right_start, right_count)) {
        i64 checksum = raz_compiler_rt_arena_create(128);

        if (checksum == 0) {
            return -1;
        }

        i64 checksum_length = path_registry_locked_checksum(right, right_start, right_count, checksum, 128);
        i64 root_length = path_registry_store_root(output, capacity);

        if (checksum_length <= 0 || root_length <= 0 || root_length + 1 + checksum_length > capacity) {
            raz_compiler_rt_arena_destroy(checksum);
            return -1;
        }
        raz_compiler_rt_arena_set(output, root_length, 47);

        i64 ri = 0;

        while (ri < checksum_length) {
            raz_compiler_rt_arena_set(output, root_length + 1 + ri, raz_compiler_rt_arena_get(checksum, ri));
            ri += 1;
        }
        raz_compiler_rt_arena_destroy(checksum);
        return root_length + 1 + checksum_length;
    }
    if (path_registry_virtual(right, right_start, right_count)) {
        i64 root_length = path_registry_store_root(output, capacity);
        i64 checksum_length = right_count - 9;

        if (root_length <= 0 || checksum_length <= 0 || root_length + 1 + checksum_length > capacity) {
            return -1;
        }
        raz_compiler_rt_arena_set(output, root_length, 47);

        i64 virtual_index = 0;

        while (virtual_index < checksum_length) {
            raz_compiler_rt_arena_set(
                output,
                root_length + 1 + virtual_index,
                raz_compiler_rt_arena_get(right, right_start + 9 + virtual_index),
            );
            virtual_index += 1;
        }
        return root_length + 1 + checksum_length;
    }

    i64 vendored_git_length = path_vendor_git(right, right_start, right_count, output, capacity);

    if (vendored_git_length != 0) {
        return vendored_git_length;
    }
    bool right_absolute =
        right_count > 0 &&
        (
            raz_compiler_rt_arena_get(right, right_start) == 47 ||
            raz_compiler_rt_arena_get(right, right_start) == 92
        );
    if (!right_absolute && right_count >= 2) {
        i64 drive = raz_compiler_rt_arena_get(right, right_start);
        i64 colon = raz_compiler_rt_arena_get(right, right_start + 1);

        right_absolute = ((drive >= 65 && drive <= 90) || (drive >= 97 && drive <= 122)) && colon == 58;
    }
    if (right_absolute) {
        if (right_count > capacity) {
            return -1;
        }

        i64 absolute_index = 0;

        while (absolute_index < right_count) {
            raz_compiler_rt_arena_set(
                output,
                absolute_index,
                raz_compiler_rt_arena_get(right, right_start + absolute_index),
            );
            absolute_index += 1;
        }
        return right_count;
    }
    bool separator =
        left_length > 0 &&
        raz_compiler_rt_arena_get(left, left_length - 1) != 47 &&
        raz_compiler_rt_arena_get(left, left_length - 1) != 92;
    i64 total = left_length + right_count;

    if (separator) {
        total += 1;
    }
    if (total > capacity) {
        return -1;
    }

    i64 index = 0;

    while (index < left_length) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(left, index));
        index += 1;
    }
    if (separator) {
        raz_compiler_rt_arena_set(output, index, 47);
        index += 1;
    }

    i64 right_index = 0;

    while (right_index < right_count) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(right, right_start + right_index));
        index += 1;
        right_index += 1;
    }
    return index;
}
