namespace raz_driver::cli_support;

public import raz_driver::project;

// Shared CLI output and argv primitives. Keep presentation mechanics separate
// from command/help policy and build/run execution.

fn cli_write_stream(i64 stream, i64[]text, i64 length) {
    if (length <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, text[i]);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(stream, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

public fn cli_write_literal_stream(i64 stream, string text) {
    i64 length = compiler_literal_length(text);
    if (length <= 0) { return; }
    i64 buffer = raz_compiler_rt_arena_create(length);
    if (buffer == 0) { return; }
    i64 i = 0;
    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, compiler_literal_byte(text, i));
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(stream, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_write_literal(string text) { cli_write_literal_stream(1, text); }

fn cli_write(i64[]text, i64 length) {
    if (length <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, text[i]);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_write_arena_stream(i64 stream, i64 value, i64 length) {
    if (value == 0 || length <= 0) {
        return;
    }
    raz_compiler_rt_stdio_write_ascii(stream, value, length);
}

fn cli_write_packed(i64[]words, i64 word_count, i64 length) {
    if (length <= 0 || word_count <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        i64 word_index = i / 7;
        i64 byte_index = i % 7;
        i64 value = (words[word_index] >> (byte_index * 8)) & 255;

        raz_compiler_rt_arena_set(buffer, i, value);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_arg_equals(i64 value, i64 length, i64[]expected, i64 expected_length) -> bool {
    if (value == 0 || length != expected_length) {
        return false;
    }

    i64 i = 0;

    while (i < expected_length) {
        if (raz_compiler_rt_arena_get(value, i) != expected[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn cli_arg_equals_literal(i64 value, i64 length, string expected) -> bool {
    i64 expected_length = compiler_literal_length(expected);
    if (value == 0 || length != expected_length) { return false; }
    i64 i = 0;
    while (i < expected_length) {
        if (raz_compiler_rt_arena_get(value, i) != compiler_literal_byte(expected, i)) { return false; }
        i += 1;
    }
    return true;
}

fn cli_load_arg(i64 index, i64 buffer, i64 capacity) -> i64 {
    if (buffer == 0 || capacity <= 0) {
        return -1;
    }
    return raz_compiler_rt_process_arg(index, buffer, capacity);
}


