fn cli_print_targets() {
    

    cli_write_literal("Supported targets:\n  Forge native/object:\n    x86_64-pc-windows-msvc\n    x86_64-unknown-linux-gnu\n    aarch64-unknown-linux-gnu\n    arm64-apple-macos\n  LLVM native:\n    x86_64-pc-windows-msvc\n    x86_64-unknown-linux-gnu\n    aarch64-unknown-linux-gnu\n    arm64-apple-macos\n  Portable:\n    wasm32-unknown-unknown\n    rxe-v1\n\nForge supports deterministic x86-64 and AArch64 object generation; final native linking depends on the host runtime/linker support.\n");
}

