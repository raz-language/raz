fn cli_print_package_commands() {
    cli_write_literal("Package commands:\n");
    cli_write_literal("  add          Add/update a path, Git, or registry dependency\n");
    cli_write_literal("  remove       Remove a dependency and refresh raz.lock\n");
    cli_write_literal("  update       Re-resolve tracked registry dependencies\n");
    cli_write_literal("  fetch        Fetch exact locked dependencies\n");
    cli_write_literal("  lock         Write deterministic raz.lock\n");
    cli_write_literal("  metadata     Print recursive package metadata\n");
    cli_write_literal("  graph        Print the dependency graph\n");
    cli_write_literal("  tree         Print the recursive dependency tree\n");
    cli_write_literal("  search       Search official Raz packages\n");
    cli_write_literal("  info         Show package versions and metadata\n");
    cli_write_literal("  outdated     Show registry dependency upgrades\n");
    cli_write_literal("  install      Install a package executable\n");
    cli_write_literal("  uninstall    Remove an installed package executable\n");
    cli_write_literal("  vendor       Vendor exact locked dependencies locally\n");
    cli_write_literal("  pack         Create a deterministic .dpk archive\n");
    cli_write_literal("  publish      Publish the current package\n");
    cli_write_literal("  registry     Inspect/administer the package registry\n");
    cli_write_literal("  login        Save registry credentials\n");
    cli_write_literal("  logout       Remove saved registry credentials\n");
    cli_write_literal("  keygen       Generate Ed25519 package-signing keys\n");
    cli_write_literal("  cache        Inspect or clean the shared package cache\n");
}

fn cli_print_project_command_help(i64 command) {
    if (command == 12) {
        

        cli_write_literal("Usage: raz run [options] <input>\nRuns main.\n");
    } else if (command == 13) {
        

        cli_write_literal("Usage: raz clean\nRemoves the build directory.\n");
    } else if (command == 14) {
        

        cli_write_literal("Usage: raz init\nCreates raz.toml and src/main.rz.\n");
    } else if (command == 16) {
        

        cli_write_literal("Usage: raz test [--filter=<text>] <input>\nRuns zero-argument test_ functions and prints per-test results.\n");
    } else if (command == 18) {
        

        cli_write_literal("Usage: raz fmt [--check] <file.rz>\nFormat Raz source.\n");
    } else if (command == 19) {
        

        cli_write_literal("Usage: raz doc <file.rz> [output.md]\nGenerate API documentation.\n");
    } else if (command == 20) {
        

        cli_write_literal("Usage: raz add <package>[@<constraint>] [--dev|--build|--optional|--target=<os>]\n       raz add <alias> <path|registry:name@constraint|git:url#commit> [--dev|--build|--optional|--target=<os>]\nAdd an official, registry, Git, or local dependency and rewrite raz.lock. Git revisions must be 40-character commit SHAs.\n");
    } else if (command == 21) {
        

        cli_write_literal("Usage: raz remove <alias>\nRemove a dependency and rewrite raz.lock.\n");
    } else if (command == 22) {
        

        cli_write_literal("Usage: raz update\nRe-resolve tracked registry constraints and update raz.lock.\n");
    } else if (command == 23) {
        

        cli_write_literal("Usage: raz lock\nWrite the deterministic dependency lockfile.\n");
    } else if (command == 24) {
        

        cli_write_literal("Usage: raz metadata\nPrint recursive package metadata.\n");
    } else if (command == 25) {
        

        cli_write_literal("Usage: raz graph\nPrint the recursive dependency graph.\n");
    } else if (command == 26) {
        

        cli_write_literal("Usage: raz registry <status|owner-add|owner-remove|yank|unyank> [package] [value]\nManage and inspect the GitHub-backed Raz registry.\n");
    } else if (command == 27) {
        

        cli_write_literal("Usage: raz pack [output.dpk]\nCreate a deterministic Raz package archive.\n");
    } else if (command == 28) {
        

        cli_write_literal("Usage: raz publish\nPublish the current package using RAZ_REGISTRY_URL or RAZ_REGISTRY_PUBLISH_DIR.\n");
    } else if (command == 29) {
        

        cli_write_literal("Usage: raz keygen [prefix]\nGenerate an Ed25519 private/public package-signing key pair.\n");
    } else if (command == 30) {
        

        cli_write_literal("Usage: raz fetch\nFetch the exact registry packages recorded in raz.lock without upgrading.\n");
    } else if (command == 31) {
        

        cli_write_literal("Usage: raz search <query>\nSearch official package names, descriptions, and owners.\n");
    } else if (command == 32) {
        

        cli_write_literal("Usage: raz info <package>\nShow a package's latest and published versions.\n");
    } else if (command == 33) {
        

        cli_write_literal("Usage: raz outdated\nShow registry dependencies with newer published versions.\n");
    } else if (command == 34) {
        

        cli_write_literal("Usage: raz tree\nPrint the recursive dependency tree.\n");
    } else if (command == 35) {
        

        cli_write_literal("Usage: raz install [--force|--update] [--bin=<name>] <package>[@<constraint>]\n       raz install --list\nInstall and manage package executables from the official registry.\nPackages may expose additional Cargo-style [[bin]] entries selected with --bin=<name>.\n");
    } else if (command == 36) {
        

        cli_write_literal("Usage: raz uninstall <package>\nRemove an installed package executable.\n");
    } else if (command == 37) {
        

        cli_write_literal("Usage: raz vendor [--check]\nVendor exact locked registry and Git dependencies into ./vendor.\n");
    } else if (command == 38) {
        

        cli_write_literal("Usage: raz login [token]\nSave a GitHub registry credential.\n");
    } else if (command == 39) {
        

        cli_write_literal("Usage: raz logout\nRemove the saved registry credential.\n");
    } else if (command == 40) {
        

        cli_write_literal("Usage: raz bench [--iterations=N] [input]\nRun zero-argument bench_ functions and report ns/op.\n");
    } else if (command == 41) {
        

        cli_write_literal("Usage: raz cache [status|clean]\nInspect or clean the shared Raz registry/package cache.\n");
    } else if (command == 42) {
        

        cli_write_literal("Usage: raz lsp\nRun the production Raz language server over stdio.\n");
    } else if (command == 43) {
        

        cli_write_literal("Usage: raz bindgen <header.h> [--target-abi=windows|unix] [output.rz]\nGenerate Raz FFI declarations from a C header.\n");
    } else if (command == 44) {
        

        cli_write_literal("Usage: raz c-header <source.rz> [output.h]\nGenerate a C header from explicit public Raz C-ABI declarations.\n");
    } else if (command == 45) {
        cli_write_literal("Usage: raz dev [--host=<host>] [--port=<port>] [raz.toml]\nBuild and serve a web project in development mode, watch for changes, and reload the browser.\n");
    } else if (command == 46) {
        cli_write_literal("Usage: raz diagnostics [--json]\nList stable diagnostic codes and categories.\n");
    } else if (command == 47) {
        cli_write_literal("Usage: raz completions <bash|zsh|fish|powershell>\nGenerate a shell completion script on stdout.\n");
    } else {
        cli_print_general_help();
    }
}

fn cli_print_build_help() {
    cli_write_literal("Compile a package and its dependencies.\n\n");
    cli_write_literal("Usage:\n  raz build [path] [options]\n\n");
    cli_write_literal("Package options:\n");
    cli_write_literal("  --profile <debug|release>      Select a manifest build profile\n");
    cli_write_literal("  --release                      Shorthand for --profile release\n");
    cli_write_literal("  --force                        Rebuild instead of reusing incremental artifacts\n");
    cli_write_literal("  --workspace                    Build every workspace member\n");
    cli_write_literal("  --features=<a,b>               Enable named features\n");
    cli_write_literal("  --all-features                 Enable all features\n");
    cli_write_literal("  --no-default-features          Disable default features\n\n");
    cli_write_literal("Backend options:\n");
    cli_write_literal("  --backend=forge | --forge      Use Forge\n");
    cli_write_literal("  --backend=llvm  | --llvm       Use LLVM\n");
    cli_write_literal("  --opt=0|1|2|3|s|z             Optimization level\n");
    cli_write_literal("  --target=<triple>              Select an explicit target\n\n");
    cli_write_literal("Diagnostics/output:\n");
    cli_write_literal("  --diagnostic-format=<format>   human, short, or json\n");
    cli_write_literal("  --allow|--warn|--deny <code>   Apply ordered warning policy\n");
    cli_write_literal("  --deny-warnings                Treat warnings as errors\n");
    cli_write_literal("  --color=<auto|always|never>    Control terminal color\n");
    cli_write_literal("  --quiet                        Suppress status output\n\n");
    cli_write_literal("Project builds write executables under target/debug/bin; release builds use target/release/bin.\n");
    cli_write_literal("For target=web, --release --analyze writes the finalized web bundle analysis.\n");
}

