    string candidate_lsp = "lsp";

    distance = cli_edit_distance_literal(value, length, candidate_lsp);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 42;
    }

    bool close = best_distance <= 1;

    if (length >= 4 && best_distance <= 2) {
        close = true;
    }
    if (length >= 8 && best_distance <= 3) {
        close = true;
    }
    if (!close || best_kind <= 0) {
        return;
    }

    
    

    cli_write_literal_stream(2, "  help: a similar command exists: '");
    cli_write_command_name(2, best_kind);
    cli_write_literal_stream(2, "'\n");
}

fn cli_print_unknown_command_at(i64 argc, i64 index) {
    if (index >= argc) {
        return;
    }

    i64 arg = raz_compiler_rt_arena_create(4096);

    if (arg == 0) {
        return;
    }

    i64 length = cli_load_arg(index, arg, 4096);

    if (length > 0) {
        
        
        

        cli_write_literal_stream(2, "error: no such command: '");
        cli_write_arena_stream(2, arg, length);
        cli_write_literal_stream(2, "'\n");
        cli_print_command_suggestion(arg, length);
        cli_write_literal_stream(2, "  help: view all commands with 'raz --help'\n");
    }
    raz_compiler_rt_arena_destroy(arg);
}

fn cli_known_command_specific_option(i64 value, i64 length) -> bool {
    if (cli_arg_equals_literal(value, length, "--iterations") || cli_arg_equals_literal(value, length, "--filter")) { return true; }
    if (cli_arg_equals_literal(value, length, "--host") || cli_arg_equals_literal(value, length, "--port")) { return true; }
    string iterations = "--iterations=";
    string filter = "--filter=";
    string host = "--host=";
    string port = "--port=";
    i64 i = 0;
    if (length > 13) { bool matches = true; i = 0; while (i < 13) { if (raz_compiler_rt_arena_get(value,i) != compiler_literal_byte(iterations,i)) { matches = false; } i += 1; } if (matches) { return true; } }
    if (length > 9) { bool matches = true; i = 0; while (i < 9) { if (raz_compiler_rt_arena_get(value,i) != compiler_literal_byte(filter,i)) { matches = false; } i += 1; } if (matches) { return true; } }
    if (length > 7) { bool matches = true; i = 0; while (i < 7) { if (raz_compiler_rt_arena_get(value,i) != compiler_literal_byte(host,i)) { matches = false; } i += 1; } if (matches) { return true; } }
    if (length > 7) { bool matches = true; i = 0; while (i < 7) { if (raz_compiler_rt_arena_get(value,i) != compiler_literal_byte(port,i)) { matches = false; } i += 1; } if (matches) { return true; } }
    return false;
}

fn cli_print_option_not_valid_for_command(i64 value, i64 length, i64 command) {
    cli_write_literal_stream(2, "error: option '");
    cli_write_arena_stream(2, value, length);
    cli_write_literal_stream(2, "' is not valid for command '");
    cli_write_command_name(2, command);
    cli_write_literal_stream(2, "'\n");
    cli_write_literal_stream(2, "  help: run 'raz ");
    cli_write_command_name(2, command);
    cli_write_literal_stream(2, " --help' for usage\n");
}

fn cli_print_unknown_option(i64 value, i64 length) {
    cli_write_literal_stream(2, "error: unexpected argument '");
    cli_write_arena_stream(2, value, length);
    cli_write_literal_stream(2, "'\n");
    i64 best = 1000;
    i64 kind = 0;
    i64 d = cli_edit_distance_literal(value, length, "--release"); if (d < best) { best = d; kind = 1; }
    d = cli_edit_distance_literal(value, length, "--profile"); if (d < best) { best = d; kind = 2; }
    d = cli_edit_distance_literal(value, length, "--backend"); if (d < best) { best = d; kind = 3; }
    d = cli_edit_distance_literal(value, length, "--diagnostic-format"); if (d < best) { best = d; kind = 4; }
    d = cli_edit_distance_literal(value, length, "--color"); if (d < best) { best = d; kind = 5; }
    d = cli_edit_distance_literal(value, length, "--features"); if (d < best) { best = d; kind = 6; }
    d = cli_edit_distance_literal(value, length, "--force"); if (d < best) { best = d; kind = 7; }
    bool close = best <= 1 || (length >= 8 && best <= 2);
    if (close && kind > 0) {
        cli_write_literal_stream(2, "  help: a similar option exists: '");
        if (kind == 1) { cli_write_literal_stream(2, "--release"); }
        else if (kind == 2) { cli_write_literal_stream(2, "--profile"); }
        else if (kind == 3) { cli_write_literal_stream(2, "--backend"); }
        else if (kind == 4) { cli_write_literal_stream(2, "--diagnostic-format"); }
        else if (kind == 5) { cli_write_literal_stream(2, "--color"); }
        else if (kind == 6) { cli_write_literal_stream(2, "--features"); }
        else if (kind == 7) { cli_write_literal_stream(2, "--force"); }
        cli_write_literal_stream(2, "'\n");
    }
    cli_write_literal_stream(2, "  help: run 'raz <command> --help' for usage\n");
}

fn cli_print_invalid_arguments() {
    
    

    cli_write_literal_stream(2, "error: invalid command-line arguments\n");
    cli_write_literal_stream(2, "  help: run 'raz <command> --help' for usage\n");
}

fn cli_print_missing_input() {
    
    

    cli_write_literal_stream(2, "error: no input was provided and no raz.toml was found\n");
    cli_write_literal_stream(2, "  help: pass a .rz file or run the command in a Raz project\n");
}

fn cli_print_dev_requires_web() {
    cli_write_literal_stream(2, "error: raz dev requires a web project\n");
    cli_write_literal_stream(2, "  help: set [build] target = \"web\" in raz.toml\n");
}

fn cli_print_missing_path(i64 path, i64 length) {
    
    

    cli_write_literal_stream(2, "error: input path does not exist: '");
    cli_write_arena_stream(2, path, length);
    cli_write_literal_stream(2, "'\n");
}

fn cli_arg_starts_with_dash(i64 value, i64 length) -> bool {
    return value != 0 && length > 0 && raz_compiler_rt_arena_get(value, 0) == 45;
}

fn cli_argument_starts_with_dash_at(i64 argc, i64 index) -> bool {
    if (index >= argc) {
        return false;
    }

    i64 arg = raz_compiler_rt_arena_create(64);

    if (arg == 0) {
        return false;
    }

    i64 length = cli_load_arg(index, arg, 64);
    bool result = cli_arg_starts_with_dash(arg, length);

    raz_compiler_rt_arena_destroy(arg);
    return result;
}

fn cli_argument_looks_like_path(i64 argc, i64 index) -> bool {
    if (index >= argc) {
        return false;
    }

    i64 arg = raz_compiler_rt_arena_create(4096);

    if (arg == 0) {
        return false;
    }

    i64 length = cli_load_arg(index, arg, 4096);

    if (length <= 0) {
        raz_compiler_rt_arena_destroy(arg);
        return false;
    }
    if (raz_compiler_rt_path_exists_ascii(arg, length) != 0) {
        raz_compiler_rt_arena_destroy(arg);
        return true;
    }

    i64 i = 0;

    while (i < length) {
        i64 ch = raz_compiler_rt_arena_get(arg, i);

        if (ch == 46 || ch == 47 || ch == 92) {
            raz_compiler_rt_arena_destroy(arg);
            return true;
        }
        i += 1;
    }
    raz_compiler_rt_arena_destroy(arg);
    return false;
}

fn cli_command_kind(i64 value, i64 length) -> i64 {
        if (cli_arg_equals_literal(value, length, "help")) {
        return 1;
    }

        if (cli_arg_equals_literal(value, length, "--help")) {
        return 1;
    }

        if (cli_arg_equals_literal(value, length, "-h")) {
        return 1;
    }

        if (cli_arg_equals_literal(value, length, "version")) {
        return 2;
    }

        if (cli_arg_equals_literal(value, length, "--version")) {
        return 2;
    }

        if (cli_arg_equals_literal(value, length, "-V")) {
        return 2;
    }

        if (cli_arg_equals_literal(value, length, "build")) {
        return 3;
    }

        if (cli_arg_equals_literal(value, length, "check")) {
        return 4;
    }

        if (cli_arg_equals_literal(value, length, "forge")) {
        return 5;
    }

        if (cli_arg_equals_literal(value, length, "llvm")) {
        return 6;
    }

        if (cli_arg_equals_literal(value, length, "backends")) {
        return 7;
    }

        if (cli_arg_equals_literal(value, length, "targets")) {
        return 8;
    }

        if (cli_arg_equals_literal(value, length, "doctor")) {
        return 9;
    }

        if (cli_arg_equals_literal(value, length, "emit")) {
        return 10;
    }

        if (cli_arg_equals_literal(value, length, "profile")) {
        return 11;
    }

        if (cli_arg_equals_literal(value, length, "run")) {
        return 12;
    }

        if (cli_arg_equals_literal(value, length, "clean")) {
        return 13;
    }

        if (cli_arg_equals_literal(value, length, "init")) {
        return 14;
    }

        if (cli_arg_equals_literal(value, length, "new")) {
        return 15;
    }

        if (cli_arg_equals_literal(value, length, "test")) {
        return 16;
    }

        if (cli_arg_equals_literal(value, length, "lint")) {
        return 17;
    }

        if (cli_arg_equals_literal(value, length, "fmt")) {
        return 18;
    }

        if (cli_arg_equals_literal(value, length, "doc")) {
        return 19;
    }

        if (cli_arg_equals_literal(value, length, "add")) {
        return 20;
    }

        if (cli_arg_equals_literal(value, length, "remove")) {
        return 21;
    }

        if (cli_arg_equals_literal(value, length, "update")) {
        return 22;
    }

        if (cli_arg_equals_literal(value, length, "fetch")) {
        return 30;
    }

        if (cli_arg_equals_literal(value, length, "lock")) {
