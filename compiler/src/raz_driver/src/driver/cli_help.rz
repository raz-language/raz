fn cli_print_command_help(i64 command) {
    if (command == 3) {
        cli_print_build_help();
    } else if (command == 4) {
        cli_print_check_help();
    } else if (command == 5) {
        cli_print_forge_help();
    } else if (command == 6) {
        cli_print_llvm_help();
    } else if (command == 10) {
        cli_print_emit_help();
    } else if (command == 11) {
        cli_print_profile_help();
    } else if (command == 7) {
        cli_print_backends();
    } else if (command == 8) {
        cli_print_targets();
    } else if (command >= 12 && command <= 47) {
        cli_print_project_command_help(command);
    } else {
        cli_print_general_help();
    }
    if (
        command == 3 ||
        command == 4 ||
        command == 16 ||
        command == 22 ||
        command == 23 ||
        command == 24 ||
        command == 25 ||
        command == 30 ||
        command == 34
    ) {
        

        cli_write_literal("\nWorkspace: add --workspace at the workspace root for build, check, test, update, fetch, lock, metadata, graph, or tree.\n");
    }
}

