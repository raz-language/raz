namespace raz_driver::cli_help;

public import raz_driver::cli_support;
public import raz_driver::project;

// Command recognition, suggestions, help text, and CLI-facing argument errors.
// Build/run execution and diagnostics remain in cli.rz.

fn cli_edit_distance(i64 value, i64 length, i64[]expected, i64 expected_length) -> i64 {
    if (value == 0 || length < 0 || expected_length < 0 || length >= 32 || expected_length >= 32) {
        return 99;
    }

    i64 previous[32];
    i64 current[32];
    i64 j = 0;

    while (j <= expected_length) {
        previous[j] = j;
        j += 1;
    }

    i64 i = 1;

    while (i <= length) {
        current[0] = i;
        j = 1;
        while (j <= expected_length) {
            i64 deletion = previous[j] + 1;
            i64 insertion = current[j - 1] + 1;
            i64 substitution = previous[j - 1];

            if (raz_compiler_rt_arena_get(value, i - 1) != expected[j - 1]) {
                substitution += 1;
            }

            i64 best = deletion;

            if (insertion < best) {
                best = insertion;
            }
            if (substitution < best) {
                best = substitution;
            }
            current[j] = best;
            j += 1;
        }
        j = 0;
        while (j <= expected_length) {
            previous[j] = current[j];
            j += 1;
        }
        i += 1;
    }
    return previous[expected_length];
}

fn cli_edit_distance_literal(i64 value, i64 length, string expected) -> i64 {
    i64 expected_length = compiler_literal_length(expected);
    if (value == 0 || length < 0 || expected_length < 0 || length >= 32 || expected_length >= 32) { return 99; }
    i64 previous[32];
    i64 current[32];
    i64 j = 0;
    while (j <= expected_length) { previous[j] = j; j += 1; }
    i64 i = 1;
    while (i <= length) {
        current[0] = i;
        j = 1;
        while (j <= expected_length) {
            i64 deletion = previous[j] + 1;
            i64 insertion = current[j - 1] + 1;
            i64 substitution = previous[j - 1];
            if (raz_compiler_rt_arena_get(value, i - 1) != compiler_literal_byte(expected, j - 1)) { substitution += 1; }
            i64 best = deletion;
            if (insertion < best) { best = insertion; }
            if (substitution < best) { best = substitution; }
            current[j] = best;
            j += 1;
        }
        j = 0;
        while (j <= expected_length) { previous[j] = current[j]; j += 1; }
        i += 1;
    }
    return previous[expected_length];
}


