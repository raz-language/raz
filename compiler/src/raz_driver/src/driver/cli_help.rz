fn cli_detect_command(i64 argc) -> i64 {
    if (argc <= 1) {
        return 1;
    }

    i64 arg = raz_compiler_rt_arena_create(4096);

    if (arg == 0) {
        return 0;
    }

    i64 length = cli_load_arg(1, arg, 4096);
    i64 kind = 0;

    if (length > 0) {
        kind = cli_command_kind(arg, length);
    }
    raz_compiler_rt_arena_destroy(arg);
    return kind;
}

fn cli_command_help_requested(i64 argc, i64 command) -> bool {
    if (command < 3 || argc <= 2) {
        return false;
    }

    i64 arg = raz_compiler_rt_arena_create(64);

    if (arg == 0) {
        return false;
    }

            i64 index = 2;

    while (index < argc) {
        i64 length = cli_load_arg(index, arg, 64);

        if (
            length > 0 &&
            (cli_arg_equals_literal(arg, length, "--help") || cli_arg_equals_literal(arg, length, "-h"))
        ) {
            raz_compiler_rt_arena_destroy(arg);
            return true;
        }
        index += 1;
    }
    raz_compiler_rt_arena_destroy(arg);
    return false;
}

fn cli_help_topic(i64 argc) -> i64 {
    if (argc <= 2) {
        return 0;
    }

    i64 arg = raz_compiler_rt_arena_create(64);

    if (arg == 0) {
        return 0;
    }

    i64 length = cli_load_arg(2, arg, 64);
    i64 result = 0;

    if (length > 0) {
        result = cli_command_kind(arg, length);
    }
    raz_compiler_rt_arena_destroy(arg);
    return result;
}

fn cli_print_general_help() {
    cli_write_literal("Raz 1.0.0\nHigh-performance native programming language compiler\n\n");
    cli_write_literal("Usage:\n  raz <command> [options] [input] [output]\n\n");
    cli_write_literal("Compiler commands:\n");
    cli_write_literal("  build        Compile a package and its dependencies\n");
    cli_write_literal("  check        Parse, resolve, and type-check without linking\n");
    cli_write_literal("  run          Build and run an executable package\n");
    cli_write_literal("  test         Discover and run test_ functions\n");
    cli_write_literal("  bench        Run zero-argument bench_ functions\n");
    cli_write_literal("  emit         Emit backend IR/object/executable artifacts\n");
    cli_write_literal("  forge        Compile explicitly with the Forge backend\n");
    cli_write_literal("  llvm         Compile explicitly with the LLVM backend\n");
    cli_write_literal("  profile      Check and write semantic-query profiling data\n");
    cli_write_literal("  backends     List compiler backends and capabilities\n");
    cli_write_literal("  targets      List supported compilation targets\n\n");
    cli_write_literal("Project tooling:\n");
    cli_write_literal("  new          Create a new Raz project\n");
    cli_write_literal("  init         Initialize an existing directory\n");
    cli_write_literal("  clean        Remove generated build state\n");
    cli_write_literal("  fmt          Format Raz source files/directories\n");
    cli_write_literal("  lint         Statically validate Raz source\n");
    cli_write_literal("  doc          Generate Markdown API documentation\n");
    cli_write_literal("  dev          Build/serve a web project with live reload\n");
    cli_write_literal("  lsp          Run the production language server over stdio\n");
    cli_write_literal("  bindgen      Generate Raz FFI declarations from a C header\n");
    cli_write_literal("  c-header     Generate a C header from public Raz C-ABI APIs\n\n");
    cli_print_package_commands();
    cli_write_literal("\nToolchain commands:\n");
    cli_write_literal("  doctor       Diagnose compiler, linker, runtime, and project state\n");
    cli_write_literal("  diagnostics  List stable diagnostic codes/categories\n");
    cli_write_literal("  completions  Generate shell completion scripts\n");
    cli_write_literal("  version      Show compiler/toolchain version\n");
    cli_write_literal("  help         Show help for Raz or a command\n\n");
    cli_write_literal("Global options:\n");
    cli_write_literal("  --backend=forge|llvm|wasm|rxe  Select backend\n");
    cli_write_literal("  --opt=0|1|2|3|s|z             Select optimization level\n");
    cli_write_literal("  --release                      Use the release profile\n");
    cli_write_literal("  -h, --help                     Show help\n");
    cli_write_literal("  -V, --version                  Show version\n\n");
    cli_write_literal("Examples:\n  raz new hello\n  raz run\n  raz build --release\n  raz check --workspace\n  raz completions powershell\n");
}

