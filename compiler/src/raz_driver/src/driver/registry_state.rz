namespace raz_driver::registry_state;

public import raz_driver::host_support;
import frontend::parser;
public fn registry_project_state_path(i64 kind, i64 output, i64 capacity) -> i64 {
    if (output == 0) {
        return -1;
    }
    if (kind == 0) {
        if (capacity < 16) {
            return -1;
        }

        string bytes = "target/raz.cache";
        i64 i = 0;

        while (i < 16) {
            raz_compiler_rt_arena_set(output, i, compiler_literal_byte(bytes, i));
            i += 1;
        }
        return 16;
    }
    if (kind == 1) {
        if (capacity < 19) {
            return -1;
        }

        string bytes = "target/raz.registry";
        i64 i = 0;

        while (i < 19) {
            raz_compiler_rt_arena_set(output, i, compiler_literal_byte(bytes, i));
            i += 1;
        }
        return 19;
    }
    return -1;
}

public fn registry_project_state_prepare(i64 kind, i64 output, i64 capacity) -> i64 {
    i64 length = registry_project_state_path(kind, output, capacity);

    if (length <= 0) {
        return -1;
    }

    i64 target_dir = raz_compiler_rt_arena_create(6);
    i64 r16 = raz_compiler_rt_arena_create(24);
    i64 root_legacy = raz_compiler_rt_arena_create(16);

    if (target_dir == 0 || r16 == 0 || root_legacy == 0) {
        return -1;
    }

    string target_bytes = "target";
    i64 i = 0;

    while (i < 6) {
        raz_compiler_rt_arena_set(target_dir, i, compiler_literal_byte(target_bytes, i));
        i += 1;
    }
    if (raz_compiler_rt_create_dir_ascii(target_dir, 6) != 0) {
        raz_compiler_rt_arena_destroy(target_dir);
        raz_compiler_rt_arena_destroy(r16);
        raz_compiler_rt_arena_destroy(root_legacy);
        return -1;
    }

    i64 r16_length = 0;
    i64 root_length = 0;

    if (kind == 0) {
        string r16_bytes = "./.raz/raz.cache";

        i = 0;
        while (i < 16) {
            raz_compiler_rt_arena_set(r16, i, compiler_literal_byte(r16_bytes, i));
            i += 1;
        }
        r16_length = 16;

        string root_bytes = "./.raz.cache";

        i = 0;
        while (i < 12) {
            raz_compiler_rt_arena_set(root_legacy, i, compiler_literal_byte(root_bytes, i));
            i += 1;
        }
        root_length = 12;
    } else if (kind == 1) {
        string r16_bytes = "./.raz/raz.registry";

        i = 0;
        while (i < 19) {
            raz_compiler_rt_arena_set(r16, i, compiler_literal_byte(r16_bytes, i));
            i += 1;
        }
        r16_length = 19;

        string root_bytes = "./.raz.registry";

        i = 0;
        while (i < 15) {
            raz_compiler_rt_arena_set(root_legacy, i, compiler_literal_byte(root_bytes, i));
            i += 1;
        }
        root_length = 15;
    }
    if (raz_compiler_rt_path_exists_ascii(output, length) == 0) {
        if (r16_length > 0 && raz_compiler_rt_path_exists_ascii(r16, r16_length) != 0) {
            if (raz_compiler_rt_copy_file_ascii(r16, r16_length, output, length) < 0) {
                return -1;
            }
        } else if (root_length > 0 && raz_compiler_rt_path_exists_ascii(root_legacy, root_length) != 0) {
            if (raz_compiler_rt_copy_file_ascii(root_legacy, root_length, output, length) < 0) {
                return -1;
            }
        }
    }
    if (r16_length > 0 && raz_compiler_rt_path_exists_ascii(r16, r16_length) != 0) {
        raz_compiler_rt_remove_path_ascii(r16, r16_length);
    }
    if (root_length > 0 && raz_compiler_rt_path_exists_ascii(root_legacy, root_length) != 0) {
        raz_compiler_rt_remove_path_ascii(root_legacy, root_length);
    }
    raz_compiler_rt_arena_destroy(target_dir);
    raz_compiler_rt_arena_destroy(r16);
    raz_compiler_rt_arena_destroy(root_legacy);
    return length;
}
