namespace raz_driver::web_diagnostics;

public import raz_driver::cli_support;

// Keep web pipeline failures consistent and stage-oriented. Lower layers may
// still print a more specific diagnostic (for example a bundle-budget breach),
// but the driver always identifies the web stage that returned failure.
public fn web_build_error(string detail) {
    cli_write_literal_stream(2, "error: web build ");
    cli_write_literal_stream(2, detail);
    cli_write_literal_stream(2, "\n");
}
