// Registry index resolution, semantic-version selection, integrity validation,
// and deterministic resolution-cache support for the compilered package manager.
// Registry transport is intentionally abstract: RAZ_REGISTRY_INDEX points at a
// materialized index, so HTTP/git/custom transports can populate it externally
// without changing resolution or lockfile semantics.
extern fn raz_rt_task_spawn_callable_i64(FnOnce() -> i64 operation) -> i8*mut;
extern fn raz_rt_task_join_i64(i8*mut task) -> i64;

// Resolve a registry dependency alias through the derived resolution cache.
// target/raz.cache rows are: alias name version store-path checksum. The manifest
// remains authoritative for the requested constraint; the cache only supplies
// the checksum needed to reconstruct the verified content-addressed store path.
public fn registry_cached_root(i64 alias, i64 alias_length, i64 output, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(20);
    i64 data = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || data == 0 || output == 0 || alias_length <= 0) {
        return -1;
    }

    i64 path_length = registry_project_state_prepare(0, path, 20);

    if (path_length <= 0) {
        raz_compiler_rt_arena_destroy(path);
        raz_compiler_rt_arena_destroy(data);
        return -1;
    }

    i64 i = 0;
    i64 length = raz_compiler_rt_read_ascii(path, path_length, data, 1048576);

    raz_compiler_rt_arena_destroy(path);
    if (length <= 0) {
        raz_compiler_rt_arena_destroy(data);
        return -1;
    }

    i64 pos = 0;

    while (pos < length) {
        i64 start = pos;

        while (pos < length && raz_compiler_rt_arena_get(data, pos) != 10) {
            pos += 1;
        }

        i64 end = pos;

        if (pos < length) {
            pos += 1;
        }

        i64 cursor = start;
        i64 ordinal = 0;
        i64 alias_start = 0;
        i64 alias_len = 0;
        i64 checksum_start = 0;
        i64 checksum_len = 0;

        while (cursor < end) {
            while (cursor < end && ascii_is_space(raz_compiler_rt_arena_get(data, cursor))) {
                cursor += 1;
            }
            if (cursor >= end) {
                break;
            }

            i64 token_start = cursor;

            while (cursor < end && !ascii_is_space(raz_compiler_rt_arena_get(data, cursor))) {
                cursor += 1;
            }
            if (ordinal == 0) {
                alias_start = token_start;
                alias_len = cursor - token_start;
            } else if (ordinal == 4) {
                checksum_start = token_start;
                checksum_len = cursor - token_start;
            }
            ordinal += 1;
        }

        bool same = alias_len == alias_length;

        i = 0;
        while (same && i < alias_length) {
            if (raz_compiler_rt_arena_get(data, alias_start + i) != raz_compiler_rt_arena_get(alias, i)) {
                same = false;
            }
            i += 1;
        }
        if (same && checksum_len> 0) {
            i64 checksum = raz_compiler_rt_arena_create(checksum_len);

            if (checksum == 0) {
                raz_compiler_rt_arena_destroy(data);
                return -1;
            }
            i = 0;
            while (i < checksum_len) {
                raz_compiler_rt_arena_set(checksum, i, raz_compiler_rt_arena_get(data, checksum_start + i));
                i += 1;
            }

            i64 store_length = registry_store_path(checksum, checksum_len, output, capacity);

            raz_compiler_rt_arena_destroy(checksum);
            raz_compiler_rt_arena_destroy(data);
            return store_length;
        }
    }
    raz_compiler_rt_arena_destroy(data);
    return -1;
}

// All project-local generated package-manager state lives beneath target/.
// This keeps the project root limited to durable metadata (raz.toml / raz.lock)
// and user sources, and gives `raz clean` one complete generated-state root.
// kind 0 = target/raz.cache, kind 1 = target/raz.registry.

// Migrate both historical project-state layouts on first access:
//   pre-R16: .raz.cache / .raz.registry
//   R16-R18: .raz/raz.cache / .raz/raz.registry
// The canonical target/ copy wins if more than one exists. Legacy files are
// removed after migration; the remaining .raz/ directory is purely legacy and
// is deleted by `raz clean`.

fn registry_report_status(i64 status) -> i64 {
    if (status == 0) {
        return 0;
    }
    if (status == 40) {

        cli_write_literal_stream(2, "error: package operation ran out of internal resources\n");
        return status;
    }
    if (status == 55) {

        cli_write_literal_stream(2, "error: invalid package command arguments or dependency specification\n  help: run 'raz <command> --help' for usage\n");
        return status;
    }
    if (status == 56) {

        cli_write_literal_stream(2, "error: could not write package metadata or lockfile\n");
        return status;
    }
    if (status == 57) {

        cli_write_literal_stream(2, "error: package manifest is missing or invalid\n");
        return status;
    }
    if (status == 58) {

        cli_write_literal_stream(2, "error: dependency graph is cyclic or exceeds the supported depth\n");
        return status;
    }
    if (status == 59) {

        cli_write_literal_stream(2, "error: dependency alias was not found in this package\n  help: run 'raz tree' to inspect the current dependency graph\n");
        return status;
    }
    if (status == 60) {

        cli_write_literal_stream(2, "error: registry index is unavailable\n  help: check the registry configuration or use a populated offline cache\n");
        return status;
    }
    if (status == 61) {

        cli_write_literal_stream(2, "error: no package version satisfies the requested constraint\n");
        return status;
    }
    if (status == 62) {

        cli_write_literal_stream(2, "error: package checksum does not match the registry or lockfile\n");
        return status;
    }
    if (status == 63) {

        cli_write_literal_stream(2, "error: cached package content failed integrity verification\n  help: remove the corrupt store entry and run raz fetch again\n");
        return status;
    }
    if (status == 64) {

        cli_write_literal_stream(2, "error: required package content is unavailable in offline mode\n");
        return status;
    }
    if (status == 65) {

        cli_write_literal_stream(2, "error: package archive or store operation failed\n");
        return status;
    }
    if (status == 66) {

        cli_write_literal_stream(2, "error: registry transport returned an invalid response\n");
        return status;
    }
    if (status == 67) {

        cli_write_literal_stream(2, "error: package transport or publication failed\n");
        return status;
    }
    if (status == 68) {

        cli_write_literal_stream(2, "error: package source or signature could not be trusted or materialized\n");
        return status;
    }
    if (status == 69) {

        cli_write_literal_stream(2, "error: package signing failed\n");
        return status;
    }
    if (status == 72) {

        cli_write_literal_stream(2, "error: package is not publishable: metadata or dependency paths are non-portable\n  help: use registry dependencies or paths vendored inside the package\n");
        return status;
    }
    if (status == 73) {

        cli_write_literal_stream(2, "error: dependency graph contains conflicting package identities\n  help: align versions so each package name resolves to one package\n");
        return status;
    }
    if (status == 74) {

        cli_write_literal_stream(2, "error: raz.lock does not satisfy raz.toml dependency constraints\n  help: run 'raz update' to resolve the new constraints\n");
        return status;
    }
    if (status == 78) {

        cli_write_literal_stream(2, "error: vendored dependency tree is missing or failed integrity verification\n  help: run 'raz vendor' to refresh vendor/ from raz.lock\n");
        return status;
    }

    cli_write_literal_stream(2, "error: package command failed\n");
    return status;
}

// Returns 0 success. Registry transport errors use 60-76.
fn registry_print_resolution(i64 name, i64 nl, i64 constraint, i64 cl) -> i64 {
    i64 v = raz_compiler_rt_arena_create(256);
    i64 p = raz_compiler_rt_arena_create(8192);
    i64 c = raz_compiler_rt_arena_create(64);

    if (v == 0 || p == 0 || c == 0) {
        return 40;
    }

    i64 s = registry_resolve(name, nl, constraint, cl, v, 256, p, 8192, c, 64);

    if (s == 0) {
        cli_write_arena(name, nl);

        cli_write_literal("@");

        i64 vl = 0;

        while (vl<256 && raz_compiler_rt_arena_get(v, vl) != 0) {
            vl += 1;
        }
        cli_write_arena(v, vl);

        cli_write_literal(" -> ");

        i64 pl = 0;

        while (pl<8192 && raz_compiler_rt_arena_get(p, pl) != 0) {
            pl += 1;
        }
        cli_write_arena(p, pl);

        cli_write_literal("\n");
    }
    raz_compiler_rt_arena_destroy(v);
    raz_compiler_rt_arena_destroy(p);
    raz_compiler_rt_arena_destroy(c);
    return s;
}

fn registry_search_index_fallback(i64 argc) -> i64 {
    if (argc != 3) {
        return 55;
    }

    i64 query = raz_compiler_rt_arena_create(4096);
    i64 data = raz_compiler_rt_arena_create(2097152);
    i64 base = raz_compiler_rt_arena_create(8192);
    i64 latest = raz_compiler_rt_arena_create(256);
    i64 any = raz_compiler_rt_arena_create(8);

    if (query == 0 || data == 0 || base == 0 || latest == 0 || any == 0) {
        return 40;
    }

    i64 ql = raz_compiler_rt_process_arg(2, query, 4096);

    if (ql <= 0) {
        return 55;
    }

    string any_bytes = ">=0.0.0";
    i64 i = 0;

    while (i < 7) {
        raz_compiler_rt_arena_set(any, i, compiler_literal_byte(any_bytes, i));
        i += 1;
    }

    i64 base_length = 0;
    i64 length = registry_load_index(data, 2097152, base, 8192, &mut base_length);

    if (length <= 0) {
        return 60;
    }

    i64 cursor = 0;
    i64 matches = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(data, cursor) != 10 &&
            raz_compiler_rt_arena_get(data, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (raz_compiler_rt_arena_get(data, cursor) == 10 || raz_compiler_rt_arena_get(data, cursor) == 13)
        ) {
            cursor += 1;
        }

        i64 ns = 0;
        i64 nl = 0;

        if (
            registry_token(data, start, end, 0, &mut ns, &mut nl) &&
            registry_contains_folded(data, ns, nl, query, ql) &&
            !registry_name_seen_before(data, start, ns, nl)
        ) {
            i64 name = raz_compiler_rt_arena_create(nl);

            if (name == 0) {
                return 40;
            }
            i = 0;
            while (i < nl) {
                raz_compiler_rt_arena_set(name, i, raz_compiler_rt_arena_get(data, ns + i));
                i += 1;
            }

            i64 ll = registry_latest_index_version(data, length, name, nl, any, 7, latest, 256);

            if (ll> 0) {
                registry_print_name_version(name, 0, nl, latest, ll);
                matches += 1;
            }
            raz_compiler_rt_arena_destroy(name);
        }
    }
    if (matches == 0) {
        string none = "No packages found.\n";

        cli_write_literal(none);
    }
    raz_compiler_rt_arena_destroy(query);
    raz_compiler_rt_arena_destroy(data);
    raz_compiler_rt_arena_destroy(base);
    raz_compiler_rt_arena_destroy(latest);
    raz_compiler_rt_arena_destroy(any);
    return 0;
}

fn registry_tab_field(
    i64 data,
    i64 start,
    i64 end,
    i64 ordinal,
    i64&mut out_start,
    i64&mut out_length
) -> bool {
    i64 field = 0;
    i64 cursor = start;
    i64 fs = start;

    while (cursor <= end) {
        bool boundary = cursor == end;

        if (!boundary) {
            boundary = raz_compiler_rt_arena_get(data, cursor) == 9;
        }
        if (boundary) {
            if (field == ordinal) {
                *out_start = fs;
                *out_length = cursor - fs;
                return true;
            }
            field += 1;
            fs = cursor + 1;
        }
        cursor += 1;
    }
    return false;
}

fn registry_write_slice(i64 data, i64 start, i64 length) {
    if (length <= 0) {
        return;
    }

    i64 temp = raz_compiler_rt_arena_create(length);

    if (temp == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(temp, i, raz_compiler_rt_arena_get(data, start + i));
        i += 1;
    }
    cli_write_arena(temp, length);
    raz_compiler_rt_arena_destroy(temp);
}

fn registry_cache_print_path_literal(string label, i64 path, i64 path_length) {
    cli_write_literal(label);
    cli_write_arena(path, path_length);
    if (raz_compiler_rt_path_exists_ascii(path, path_length) != 0) { cli_write_literal(" [present]"); }
    else { cli_write_literal(" [missing]"); }
    cli_write_literal("\n");
}

fn registry_cache_print_path(i64[]label, i64 label_length, i64 path, i64 path_length) {
    cli_write(label, label_length);
    cli_write_arena(path, path_length);

    if (raz_compiler_rt_path_exists_ascii(path, path_length) != 0) {
        cli_write_literal(" [present]");
    } else {
        cli_write_literal(" [missing]");
    }

    cli_write_literal("\n");
}

fn registry_cache_command(i64 argc) -> i64 {
    if (argc < 2 || argc> 3) {
        return 55;
    }

    bool clean = false;

    if (argc == 3) {
        i64 action = raz_compiler_rt_arena_create(32);

        if (action == 0) {
            return 40;
        }

        i64 length = raz_compiler_rt_process_arg(2, action, 32);
        string clean_word = "clean";
        string status_word = "status";

        if (cli_arg_equals_literal(action, length, clean_word)) {
            clean = true;
        } else if (!cli_arg_equals_literal(action, length, status_word)) {
            raz_compiler_rt_arena_destroy(action);
            return 55;
        }
        raz_compiler_rt_arena_destroy(action);
    }

    i64 index = raz_compiler_rt_arena_create(8192);
    i64 store = raz_compiler_rt_arena_create(8192);

    if (index == 0 || store == 0) {
        return 40;
    }

    i64 il = registry_index_cache_path(index, 8192);
    i64 sl = registry_store_root(store, 8192);

    if (il <= 0 || sl <= 0) {
        return 70;
    }
    if (clean) {
        raz_compiler_rt_remove_path_ascii(index, il);
        raz_compiler_rt_remove_path_ascii(store, sl);

        cli_write_literal("Cleaned Raz registry and package cache\n");
    } else {
        string index_label = "registry index: ";
        string store_label = "package store: ";

        registry_cache_print_path_literal(index_label, index, il);
        registry_cache_print_path_literal(store_label, store, sl);
    }
    raz_compiler_rt_arena_destroy(index);
    raz_compiler_rt_arena_destroy(store);
    return 0;
}

fn registry_search_command(i64 argc) -> i64 {
    if (argc != 3) {
        return 55;
    }

    i64 query = raz_compiler_rt_arena_create(4096);
    i64 resolver = raz_compiler_rt_arena_create(2097152);
    i64 base = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(2097152);
    i64 url = raz_compiler_rt_arena_create(16384);

    if (query == 0 || resolver == 0 || base == 0 || data == 0 || url == 0) {
        return 40;
    }

    i64 ql = raz_compiler_rt_process_arg(2, query, 4096);

    if (ql <= 0) {
        return 55;
    }

    i64 base_length = 0;
    i64 resolver_length = registry_load_index(resolver, 2097152, base, 8192, &mut base_length);

    if (resolver_length <= 0) {
        return 60;
    }
    // Local/private index layouts are not required to ship the richer search
    // projection. Fall back to the resolver index in that case.
    if (base_length <= 0 || registry_offline()) {
        raz_compiler_rt_arena_destroy(query);
        raz_compiler_rt_arena_destroy(resolver);
        raz_compiler_rt_arena_destroy(base);
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(url);
        return registry_search_index_fallback(argc);
    }

    i64 suffix = raz_compiler_rt_arena_create(10);

    if (suffix == 0) {
        return 40;
    }

    string sb = "search.txt";
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(suffix, i, compiler_literal_byte(sb, i));
        i += 1;
    }

    i64 ul = registry_join_url(base, base_length, suffix, 0, 10, url, 16384);
    i64 length = registry_http_get(url, ul, data, 2097152);

    raz_compiler_rt_arena_destroy(suffix);
    if (length <= 0) {
        raz_compiler_rt_arena_destroy(query);
        raz_compiler_rt_arena_destroy(resolver);
        raz_compiler_rt_arena_destroy(base);
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(url);
        return registry_search_index_fallback(argc);
    }

    i64 cursor = 0;
    i64 matches = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(data, cursor) != 10 &&
            raz_compiler_rt_arena_get(data, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (raz_compiler_rt_arena_get(data, cursor) == 10 || raz_compiler_rt_arena_get(data, cursor) == 13)
        ) {
            cursor += 1;
        }

        i64 ns = 0;
        i64 nl = 0;
        i64 vs = 0;
        i64 vl = 0;
        i64 os = 0;
        i64 ol = 0;
        i64 ds = 0;
        i64 dl = 0;

        if (
            registry_tab_field(data, start, end, 0, &mut ns, &mut nl) &&
            registry_tab_field(data, start, end, 1, &mut vs, &mut vl) &&
            registry_tab_field(data, start, end, 2, &mut os, &mut ol) &&
            registry_tab_field(data, start, end, 3, &mut ds, &mut dl) &&
            (
                registry_contains_folded(data, ns, nl, query, ql) ||
                registry_contains_folded(data, os, ol, query, ql) ||
                registry_contains_folded(data, ds, dl, query, ql)
            )
        ) {
            registry_write_slice(data, ns, nl);

            cli_write_literal("@");
            registry_write_slice(data, vs, vl);
            if (dl> 0) {

                cli_write_literal("  -");

                cli_write_literal(" ");
                registry_write_slice(data, ds, dl);
            }
            if (ol> 0) {

                cli_write_literal("  [owners:");

                cli_write_literal(" ");
                registry_write_slice(data, os, ol);

                cli_write_literal("]");
            }

            cli_write_literal("\n");
            matches += 1;
        }
    }
    if (matches == 0) {

        cli_write_literal("No packages found.\n");
    }
    raz_compiler_rt_arena_destroy(query);
    raz_compiler_rt_arena_destroy(resolver);
    raz_compiler_rt_arena_destroy(base);
    raz_compiler_rt_arena_destroy(data);
    raz_compiler_rt_arena_destroy(url);
    return 0;
}

fn registry_info_command(i64 argc) -> i64 {
    if (argc != 3) {
        return 55;
    }

    i64 name = raz_compiler_rt_arena_create(4096);
    i64 data = raz_compiler_rt_arena_create(2097152);
    i64 base = raz_compiler_rt_arena_create(8192);
    i64 latest = raz_compiler_rt_arena_create(256);
    i64 any = raz_compiler_rt_arena_create(8);

    if (name == 0 || data == 0 || base == 0 || latest == 0 || any == 0) {
        return 40;
    }

    i64 nl = raz_compiler_rt_process_arg(2, name, 4096);

    if (nl <= 0) {
        return 55;
    }

    string any_bytes = ">=0.0.0";
    i64 i = 0;

    while (i < 7) {
        raz_compiler_rt_arena_set(any, i, compiler_literal_byte(any_bytes, i));
        i += 1;
    }

    i64 base_length = 0;
    i64 length = registry_load_index(data, 2097152, base, 8192, &mut base_length);

    if (length <= 0) {
        return 60;
    }

    i64 ll = registry_latest_index_version(data, length, name, nl, any, 7, latest, 256);

    if (ll <= 0) {
        return 61;
    }

    cli_write_literal("name: ");
    cli_write_arena(name, nl);

    cli_write_literal("\nlatest: ");
    cli_write_arena(latest, ll);

    cli_write_literal("\nversions:\n");

    i64 cursor = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(data, cursor) != 10 &&
            raz_compiler_rt_arena_get(data, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (raz_compiler_rt_arena_get(data, cursor) == 10 || raz_compiler_rt_arena_get(data, cursor) == 13)
        ) {
            cursor += 1;
        }

        i64 ns = 0;
        i64 row_nl = 0;
        i64 vs = 0;
        i64 vl = 0;

        if (
            registry_token(data, start, end, 0, &mut ns, &mut row_nl) &&
            registry_token(data, start, end, 1, &mut vs, &mut vl) &&
            registry_bytes_equal(data, ns, row_nl, name, 0, nl)
        ) {

            cli_write_literal("  ");
            // cli_write_arena reads from offset zero, so copy this token first.

            i64 token = raz_compiler_rt_arena_create(vl);

            if (token == 0) {
                return 40;
            }
            i = 0;
            while (i < vl) {
                raz_compiler_rt_arena_set(token, i, raz_compiler_rt_arena_get(data, vs + i));
                i += 1;
            }
            cli_write_arena(token, vl);

            cli_write_literal("\n");
            raz_compiler_rt_arena_destroy(token);
        }
    }
    raz_compiler_rt_arena_destroy(name);
    raz_compiler_rt_arena_destroy(data);
    raz_compiler_rt_arena_destroy(base);
    raz_compiler_rt_arena_destroy(latest);
    raz_compiler_rt_arena_destroy(any);
    return 0;
}

fn registry_root_dependency_path(i64 alias, i64 alias_length, i64 output, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(11);
    i64 manifest = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || manifest == 0) {
        return -1;
    }

    string p = "./raz.toml";
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(path, i, compiler_literal_byte(p, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_read_ascii(path, 10, manifest, 1048576);

    raz_compiler_rt_arena_destroy(path);
    if (length <= 0) {
        raz_compiler_rt_arena_destroy(manifest);
        return -1;
    }

    i64 section = 0;
    i64 cursor = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }

        i64 dependency_section = package_dependency_section_kind(manifest, start, end);

        if (dependency_section >= 2 && dependency_section <= 8) {
            section = dependency_section;
        } else if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) {
            section = 0;
        } else if (section >= 2 && section <= 8) {
            i64 equal = start;

            while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) {
                equal += 1;
            }
            if (equal < end && package_key_equals(manifest, start, equal, alias, alias_length)) {
                i64 result = copy_quoted_value(manifest, equal + 1, end, output, capacity);

                raz_compiler_rt_arena_destroy(manifest);
                return result;
            }
        }
    }
    raz_compiler_rt_arena_destroy(manifest);
    return -1;
}

fn registry_dependency_version(i64 alias, i64 alias_length, i64 output, i64 capacity) -> i64 {
    i64 dependency = raz_compiler_rt_arena_create(8192);
    i64 root = raz_compiler_rt_arena_create(8192);
    i64 manifest_path = raz_compiler_rt_arena_create(8192);
    i64 manifest = raz_compiler_rt_arena_create(65536);
    i64 full = raz_compiler_rt_arena_create(8192);

    if (dependency == 0 || root == 0 || manifest_path == 0 || manifest == 0 || full == 0) {
        return -1;
    }
    // Registry dependencies are represented in raz.toml by a semantic version
    // constraint (for example, ">=0.0.0"), not by a filesystem directory.
    // Resolve the dependency alias through the derived cache first so ordinary
    // build/check validation reads the exact verified package that raz.lock
    // names in the shared content-addressed store. Path dependencies retain the
    // original manifest-path fallback below.

    i64 rl = registry_cached_root(alias, alias_length, root, 8192);

    if (rl <= 0) {
        i64 dl = registry_root_dependency_path(alias, alias_length, dependency, 8192);

        if (dl <= 0) {
            raz_compiler_rt_arena_destroy(dependency);
            raz_compiler_rt_arena_destroy(root);
            raz_compiler_rt_arena_destroy(manifest_path);
            raz_compiler_rt_arena_destroy(manifest);
            raz_compiler_rt_arena_destroy(full);
            return -1;
        }
        raz_compiler_rt_arena_set(root, 0, 46);
        rl = path_join(root, 1, dependency, dl, manifest_path, 8192);
        if (rl <= 0) {
            raz_compiler_rt_arena_destroy(dependency);
            raz_compiler_rt_arena_destroy(root);
            raz_compiler_rt_arena_destroy(manifest_path);
            raz_compiler_rt_arena_destroy(manifest);
            raz_compiler_rt_arena_destroy(full);
            return -1;
        }

        i64 i = 0;

        while (i < rl) {
            raz_compiler_rt_arena_set(root, i, raz_compiler_rt_arena_get(manifest_path, i));
            i += 1;
        }
    }

    i64 ml = package_manifest_path_from_root(root, rl, full, 8192);
    i64 length = raz_compiler_rt_read_ascii(full, ml, manifest, 65536);

    if (length <= 0) {
        raz_compiler_rt_arena_destroy(dependency);
        raz_compiler_rt_arena_destroy(root);
        raz_compiler_rt_arena_destroy(manifest_path);
        raz_compiler_rt_arena_destroy(manifest);
        raz_compiler_rt_arena_destroy(full);
        return -1;
    }

    string vk = "version";
    i64 result = package_manifest_field_literal(manifest, length, vk, output, capacity);

    raz_compiler_rt_arena_destroy(dependency);
    raz_compiler_rt_arena_destroy(root);
    raz_compiler_rt_arena_destroy(manifest_path);
    raz_compiler_rt_arena_destroy(full);
    raz_compiler_rt_arena_destroy(manifest);
    return result;
}

fn registry_outdated_command() -> i64 {
    i64 sync_status = registry_sync_tracking_from_manifest();

    if (sync_status != 0) {
        return sync_status;
    }

    i64 tracking_path = raz_compiler_rt_arena_create(20);
    i64 tracking = raz_compiler_rt_arena_create(1048576);
    i64 data = raz_compiler_rt_arena_create(2097152);
    i64 base = raz_compiler_rt_arena_create(8192);

    if (tracking_path == 0 || tracking == 0 || data == 0 || base == 0) {
        return 40;
    }

    i64 tracking_path_length = registry_project_state_prepare(1, tracking_path, 20);

    if (tracking_path_length <= 0) {
        return 56;
    }

    i64 tracking_length = raz_compiler_rt_read_ascii(tracking_path, tracking_path_length, tracking, 1048576);
    i64 i = 0;

    if (tracking_length <= 0) {

        cli_write_literal("No registry dependencies.\n");
        return 0;
    }

    i64 base_length = 0;
    i64 index_length = registry_load_index(data, 2097152, base, 8192, &mut base_length);

    if (index_length <= 0) {
        return 60;
    }

    i64 cursor = 0;
    i64 outdated = 0;

    while (cursor < tracking_length) {
        i64 start = cursor;

        while (cursor < tracking_length && raz_compiler_rt_arena_get(tracking, cursor) != 10) {
            cursor += 1;
        }

        i64 end = cursor;

        if (cursor < tracking_length) {
            cursor += 1;
        }

        i64 equal = start;

        while (equal < end && raz_compiler_rt_arena_get(tracking, equal) != 61) {
            equal += 1;
        }
        if (equal >= end) {
            continue;
        }

        i64 alias = raz_compiler_rt_arena_create(4096);
        i64 spec = raz_compiler_rt_arena_create(4096);
        i64 name = raz_compiler_rt_arena_create(4096);
        i64 constraint = raz_compiler_rt_arena_create(256);
        i64 current = raz_compiler_rt_arena_create(256);
        i64 latest = raz_compiler_rt_arena_create(256);
        i64 any = raz_compiler_rt_arena_create(8);

        if (
            alias == 0 ||
            spec == 0 ||
            name == 0 ||
            constraint == 0 ||
            current == 0 ||
            latest == 0 ||
            any == 0
        ) {
            return 40;
        }

        i64 al = package_copy_key(tracking, start, equal, alias, 4096);
        i64 sl = copy_quoted_value(tracking, equal + 1, end, spec, 4096);
        i64 nl = 0;
        i64 cl = 0;
        i64 section_kind = 2;

        if (
            !registry_tracking_spec_parse(
                spec,
                sl,
                name,
                4096,
                &mut nl,
                constraint,
                256,
                &mut cl,
                &mut section_kind,
            )
        ) {
            return 55;
        }

        string any_bytes = ">=0.0.0";

        i = 0;
        while (i < 7) {
            raz_compiler_rt_arena_set(any, i, compiler_literal_byte(any_bytes, i));
            i += 1;
        }

        i64 cvl = registry_dependency_version(alias, al, current, 256);
        i64 lvl = registry_latest_index_version(data, index_length, name, nl, any, 7, latest, 256);

        if (cvl> 0 && lvl> 0 && registry_version_greater(latest, 0, lvl, current, 0, cvl)) {
            cli_write_arena(alias, al);

            cli_write_literal("  ");
            cli_write_arena(current, cvl);

            cli_write_literal(" -> ");
            cli_write_arena(latest, lvl);

            i64 compatible = raz_compiler_rt_arena_create(256);

            if (compatible == 0) {
                return 40;
            }
            i64 col = registry_latest_index_version(
                data,
                index_length,
                name,
                nl,
                constraint,
                cl,
                compatible,
                256,
            );
            if (col> 0 && registry_version_greater(compatible, 0, col, current, 0, cvl)) {

                cli_write_literal(" (compatible ");
                cli_write_arena(compatible, col);

                cli_write_literal(")");
            }

            cli_write_literal("\n");
            raz_compiler_rt_arena_destroy(compatible);
            outdated += 1;
        }
        raz_compiler_rt_arena_destroy(alias);
        raz_compiler_rt_arena_destroy(spec);
        raz_compiler_rt_arena_destroy(name);
        raz_compiler_rt_arena_destroy(constraint);
        raz_compiler_rt_arena_destroy(current);
        raz_compiler_rt_arena_destroy(latest);
        raz_compiler_rt_arena_destroy(any);
    }
    if (outdated == 0) {
        string ok = "All registry dependencies are up to date.\n";

        cli_write_literal(ok);
    }
    raz_compiler_rt_arena_destroy(tracking_path);
    raz_compiler_rt_arena_destroy(tracking);
    raz_compiler_rt_arena_destroy(data);
    raz_compiler_rt_arena_destroy(base);
    return 0;
}

fn registry_admin_safe(i64 value, i64 length, bool version) -> bool {
    if (value == 0 || length <= 0 || length> 128) {
        return false;
    }

    i64 i = 0;

    while (i < length) {
        i64 ch = raz_compiler_rt_arena_get(value, i);

        bool ok =
            (ch >= 48 && ch <= 57) ||
            (ch >= 65 && ch <= 90) ||
            (ch >= 97 && ch <= 122) ||
            ch == 45 ||
            ch == 95;
        if (version) {
            ok = ok || ch == 46 || ch == 43;
        }
        if (!ok) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn registry_status_command() -> i64 {

    cli_write_literal("registry: raz-language/packages (GitHub)\nauth: ");

    i64 token = raz_compiler_rt_arena_create(8192);
    i64 tl = 0;

    if (token != 0) {
        tl = registry_publish_token(token, 8192, true);
    }
    if (tl > 0) {
        string yes = "yes\n";

        cli_write_literal(yes);
    } else {
        string no = "no\n";

        cli_write_literal(no);
    }
    if (token != 0) {
        raz_compiler_rt_arena_destroy(token);
    }

    cli_write_literal("offline: ");
    if (registry_offline()) {
        string yes = "yes\n";

        cli_write_literal(yes);
    } else {
        string no = "no\n";

        cli_write_literal(no);
    }

    cli_write_literal("cache: ");

    i64 cache_path = raz_compiler_rt_arena_create(8192);
    bool cached = false;

    if (cache_path != 0) {
        i64 cl = registry_index_cache_path(cache_path, 8192);

        cached = cl > 0 && raz_compiler_rt_path_exists_ascii(cache_path, cl) != 0;
        raz_compiler_rt_arena_destroy(cache_path);
    }
    if (cached) {

        cli_write_literal("yes\n");
    } else {

        cli_write_literal("no\n");
    }
    return 0;
}

fn registry_admin_command(i64 argc) -> i64 {
    if (argc != 5) {
        return 55;
    }

    i64 action = raz_compiler_rt_arena_create(32);
    i64 package_name = raz_compiler_rt_arena_create(256);
    i64 value = raz_compiler_rt_arena_create(256);

    if (action == 0 || package_name == 0 || value == 0) {
        return 40;
    }

    i64 al = raz_compiler_rt_process_arg(2, action, 32);
    i64 pl = raz_compiler_rt_process_arg(3, package_name, 256);
    i64 vl = raz_compiler_rt_process_arg(4, value, 256);
    string owner_add = "owner-add";
    string owner_remove = "owner-remove";
    string yank = "yank";
    string unyank = "unyank";

    bool owner_action =
        cli_arg_equals_literal(action, al, owner_add) ||
        cli_arg_equals_literal(action, al, owner_remove);
    bool version_action = cli_arg_equals_literal(action, al, yank) || cli_arg_equals_literal(action, al, unyank);

    if (
        (!owner_action && !version_action) ||
        !registry_admin_safe(package_name, pl, false) ||
        !registry_admin_safe(value, vl, version_action)
    ) {
        return 55;
    }

    i64 status = registry_github_admin_dispatch(action, al, package_name, pl, value, vl);

    if (status <= 0) {
        return 67;
    }

    cli_write_literal("Queued registry update on ");
    cli_write_arena(package_name, pl);

    cli_write_literal(" via GitHub.\n");
    raz_compiler_rt_arena_destroy(action);
    raz_compiler_rt_arena_destroy(package_name);
    raz_compiler_rt_arena_destroy(value);
    return 0;
}

fn registry_command(i64 argc) -> i64 {
    if (argc == 3) {
        i64 sub = raz_compiler_rt_arena_create(32);

        if (sub == 0) {
            return 40;
        }

        i64 sl = raz_compiler_rt_process_arg(2, sub, 32);
        string status_word = "status";
        bool status = cli_arg_equals_literal(sub, sl, status_word);

        raz_compiler_rt_arena_destroy(sub);
        if (status) {
            return registry_status_command();
        }
        return 55;
    }
    if (argc == 5) {
        return registry_admin_command(argc);
    }
    if (argc != 4) {
        return 55;
    }

    i64 n = raz_compiler_rt_arena_create(4096);
    i64 c = raz_compiler_rt_arena_create(256);

    if (n == 0 || c == 0) {
        return 40;
    }

    i64 nl = raz_compiler_rt_process_arg(2, n, 4096);
    i64 cl = raz_compiler_rt_process_arg(3, c, 256);
    i64 s = registry_print_resolution(n, nl, c, cl);

    raz_compiler_rt_arena_destroy(n);
    raz_compiler_rt_arena_destroy(c);
    return s;
}






fn registry_virtual_path(i64 checksum, i64 checksum_length, i64 output, i64 capacity) -> i64 {
    if (checksum == 0 || output == 0 || checksum_length <= 0 || 9 + checksum_length> capacity) {
        return -1;
    }

    string prefix = "registry:";
    i64 i = 0;

    while (i < 9) {
        raz_compiler_rt_arena_set(output, i, compiler_literal_byte(prefix, i));
        i += 1;
    }
    i = 0;
    while (i < checksum_length) {
        raz_compiler_rt_arena_set(output, 9 + i, raz_compiler_rt_arena_get(checksum, i));
        i += 1;
    }
    return 9 + checksum_length;
}

fn registry_manifest_spec(
    i64 name,
    i64 name_length,
    i64 constraint,
    i64 constraint_length,
    i64 output,
    i64 capacity,
) -> i64 {
    if (name == 0 || constraint == 0 || output == 0 || name_length <= 0 || constraint_length <= 0) {
        return -1;
    }
    if (9 + name_length + 1 + constraint_length> capacity) {
        return -1;
    }

    string prefix = "registry:";
    i64 i = 0;

    while (i < 9) {
        raz_compiler_rt_arena_set(output, i, compiler_literal_byte(prefix, i));
        i += 1;
    }
    i = 0;
    while (i < name_length) {
        raz_compiler_rt_arena_set(output, 9 + i, raz_compiler_rt_arena_get(name, i));
        i += 1;
    }
    raz_compiler_rt_arena_set(output, 9 + name_length, 64);
    i = 0;
    while (i < constraint_length) {
        raz_compiler_rt_arena_set(output, 10 + name_length + i, raz_compiler_rt_arena_get(constraint, i));
        i += 1;
    }
    return 10 + name_length + constraint_length;
}

fn registry_rebuild_lock_from_resolved_cache() -> i64 {
    i64 path = raz_compiler_rt_arena_create(16);
    i64 old = raz_compiler_rt_arena_create(2097152);
    i64 empty = raz_compiler_rt_arena_create(1);

    if (path == 0 || old == 0 || empty == 0) {
        return 40;
    }

    string lp = "./raz.lock";
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(path, i, compiler_literal_byte(lp, i));
        i += 1;
    }

    i64 old_length = raz_compiler_rt_read_ascii(path, 10, old, 2097152);

    if (old_length < 0) {
        old_length = 0;
    }
    // During an explicit resolution transaction, hide the previous lock so
    // registry declarations map through the freshly resolved cache. If lock
    // construction fails, restore the old lock atomically from our backup.
    if (raz_compiler_rt_write_ascii(path, 10, empty, 0) != 0) {
        return 56;
    }

    i64 status = package_lock_command();

    if (status != 0 && old_length > 0) {
        if (raz_compiler_rt_write_ascii(path, 10, old, old_length) != old_length) {
            status = 56;
        }
    }
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(old);
    raz_compiler_rt_arena_destroy(empty);
    return status;
}

fn registry_resolve_and_apply(
    i64 alias,
    i64 al,
    i64 name,
    i64 nl,
    i64 con,
    i64 cl,
    i64 section_kind,
    bool track,
) -> i64 {
    i64 v = raz_compiler_rt_arena_create(256);
    i64 p = raz_compiler_rt_arena_create(8192);
    i64 h = raz_compiler_rt_arena_create(64);

    if (v == 0 || p == 0 || h == 0) {
        return 40;
    }

    i64 s = registry_resolve(name, nl, con, cl, v, 256, p, 8192, h, 64);

    if (s == 0) {
        i64 vl = 0;

        while (vl<256 && raz_compiler_rt_arena_get(v, vl) != 0) {
            vl += 1;
        }

        i64 pl = 0;

        while (pl<8192 && raz_compiler_rt_arena_get(p, pl) != 0) {
            pl += 1;
        }

        i64 hl = 0;

        while (hl<64 && raz_compiler_rt_arena_get(h, hl) != 0) {
            hl += 1;
        }

        i64 manifest_spec = raz_compiler_rt_arena_create(8192);

        if (manifest_spec == 0) {
            s = 40;
        } else {
            bool same_name = al == nl;
            i64 ni = 0;

            while (same_name && ni < al) {
                if (raz_compiler_rt_arena_get(alias, ni) != raz_compiler_rt_arena_get(name, ni)) {
                    same_name = false;
                }
                ni += 1;
            }

            i64 manifest_length = 0;

            if (same_name) {
                if (cl> 8192) {
                    s = 40;
                } else {
                    ni = 0;
                    while (ni < cl) {
                        raz_compiler_rt_arena_set(manifest_spec, ni, raz_compiler_rt_arena_get(con, ni));
                        ni += 1;
                    }
                    manifest_length = cl;
                }
            } else {
                manifest_length = registry_manifest_spec(name, nl, con, cl, manifest_spec, 8192);
            }
            if (s == 0 && manifest_length <= 0) {
                s = 40;
            } else if (s == 0) {
                s = package_rewrite_dependency_in_section(
                    alias,
                    al,
                    manifest_spec,
                    manifest_length,
                    section_kind,
                    false,
                );
            }
            raz_compiler_rt_arena_destroy(manifest_spec);
        }
        // target/raz.registry is retained only as a derived acceleration file for the
        // existing parallel updater. raz.toml is authoritative for user intent.
        if (s == 0 && track) {
            s = registry_write_tracking(alias, al, name, nl, con, cl, section_kind);
        }
        if (s == 0) {
            s = registry_write_cache(alias, al, name, nl, v, vl, p, pl, h, hl);
        }
        if (s == 0) {
            s = registry_rebuild_lock_from_resolved_cache();
        }
    }
    raz_compiler_rt_arena_destroy(v);
    raz_compiler_rt_arena_destroy(p);
    raz_compiler_rt_arena_destroy(h);
    return s;
}

fn package_add_official_registry_command(i64 spec, i64 sl, i64 section_kind) -> i64 {
    if (sl <= 0) {
        return 55;
    }

    i64 name = raz_compiler_rt_arena_create(4096);
    i64 constraint = raz_compiler_rt_arena_create(256);

    if (name == 0 || constraint == 0) {
        return 40;
    }

    i64 at = 0;

    while (at < sl && raz_compiler_rt_arena_get(spec, at) != 64) {
        at += 1;
    }

    i64 nl = at;
    i64 cl = 0;

    if (nl <= 0 || nl> 4096) {
        return 55;
    }

    i64 i = 0;

    while (i < nl) {
        raz_compiler_rt_arena_set(name, i, raz_compiler_rt_arena_get(spec, i));
        i += 1;
    }
    if (at < sl) {
        cl = sl - at - 1;
        if (cl <= 0 || cl> 256) {
            return 55;
        }
        i = 0;
        while (i < cl) {
            raz_compiler_rt_arena_set(constraint, i, raz_compiler_rt_arena_get(spec, at + 1 + i));
            i += 1;
        }
    } else {
        // No version means latest stable version accepted by the v1 resolver.

        string any = ">=0.0.0";

        cl = 7;
        i = 0;
        while (i < cl) {
            raz_compiler_rt_arena_set(constraint, i, compiler_literal_byte(any, i));
            i += 1;
        }
    }

    i64 result = registry_resolve_and_apply(name, nl, name, nl, constraint, cl, section_kind, true);

    raz_compiler_rt_arena_destroy(name);
    raz_compiler_rt_arena_destroy(constraint);
    return result;
}

fn package_add_registry_command(i64 alias, i64 al, i64 spec, i64 sl, i64 section_kind) -> i64 {
    i64 n = raz_compiler_rt_arena_create(4096);
    i64 c = raz_compiler_rt_arena_create(256);

    if (n == 0 || c == 0) {
        return 40;
    }

    i64 nl = 0;
    i64 cl = 0;

    if (!registry_spec_parse(spec, sl, n, 4096, &mut nl, c, 256, &mut cl)) {
        return 55;
    }

    i64 s = registry_resolve_and_apply(alias, al, n, nl, c, cl, section_kind, true);

    raz_compiler_rt_arena_destroy(n);
    raz_compiler_rt_arena_destroy(c);
    return s;
}

fn registry_resolve_job(i64 name, i64 nl, i64 con, i64 cl, i64 version, i64 path, i64 checksum) -> i64 {
    return registry_resolve(name, nl, con, cl, version, 256, path, 8192, checksum, 64);
}

fn registry_resolve_context_job(i64 context) -> i64 {
    if (context == 0) {
        return 40;
    }
    return registry_resolve_job(
        raz_compiler_rt_arena_get(context, 0),
        raz_compiler_rt_arena_get(context, 1),
        raz_compiler_rt_arena_get(context, 2),
        raz_compiler_rt_arena_get(context, 3),
        raz_compiler_rt_arena_get(context, 4),
        raz_compiler_rt_arena_get(context, 5),
        raz_compiler_rt_arena_get(context, 6),
    );
}

fn package_registry_update_finish(i64 status) -> i64 {
    if (status == 0) { cli_print_status_literal(6, "dependency update"); }
    return status;
}

fn package_registry_update_command() -> i64 {
    cli_print_status_literal(9, "registry dependencies");
    i64 sync_status = registry_sync_tracking_from_manifest();

    if (sync_status != 0) {
        return sync_status;
    }

    i64 fp = raz_compiler_rt_arena_create(20);
    i64 data = raz_compiler_rt_arena_create(1048576);

    if (fp == 0 || data == 0) {
        return 40;
    }

    i64 path_length = registry_project_state_prepare(1, fp, 20);

    if (path_length <= 0) {
        return 56;
    }

    i64 i = 0;
    i64 len = raz_compiler_rt_read_ascii(fp, path_length, data, 1048576);

    if (len < 0) {
        raz_compiler_rt_arena_destroy(fp);
        raz_compiler_rt_arena_destroy(data);

        i64 git_status = package_git_fetch_tracked();

        if (git_status != 0) {
            return git_status;
        }
        return package_registry_update_finish(package_lock_command());
    }
    // Resolve all tracked dependencies concurrently, but defer manifest/cache/
    // lockfile mutation until every worker has joined.  This keeps network and
    // archive work parallel while preserving deterministic filesystem updates.

    i64 max_jobs = 1024;
    i64 aliases = raz_compiler_rt_arena_create(max_jobs);
    i64 alias_lengths = raz_compiler_rt_arena_create(max_jobs);
    i64 names = raz_compiler_rt_arena_create(max_jobs);
    i64 name_lengths = raz_compiler_rt_arena_create(max_jobs);
    i64 constraints = raz_compiler_rt_arena_create(max_jobs);
    i64 constraint_lengths = raz_compiler_rt_arena_create(max_jobs);
    i64 section_kinds = raz_compiler_rt_arena_create(max_jobs);
    i64 versions = raz_compiler_rt_arena_create(max_jobs);
    i64 paths = raz_compiler_rt_arena_create(max_jobs);
    i64 checksums = raz_compiler_rt_arena_create(max_jobs);
    i64 contexts = raz_compiler_rt_arena_create(max_jobs);
    i64 tasks = raz_compiler_rt_arena_create(max_jobs);

    if (
        aliases == 0 ||
        alias_lengths == 0 ||
        names == 0 ||
        name_lengths == 0 ||
        constraints == 0 ||
        constraint_lengths == 0 ||
        section_kinds == 0 ||
        versions == 0 ||
        paths == 0 ||
        checksums == 0 ||
        contexts == 0 ||
        tasks == 0
    ) {
        return 40;
    }

    i64 job_count = 0;
    i64 pos = 0;

    while (pos < len) {
        i64 s = pos;

        while (pos < len && raz_compiler_rt_arena_get(data, pos) != 10) {
            pos += 1;
        }

        i64 e = pos;

        if (pos < len) {
            pos += 1;
        }

        i64 eq = s;

        while (eq < e && raz_compiler_rt_arena_get(data, eq) != 61) {
            eq += 1;
        }
        if (eq >= e) {
            continue;
        }
        if (job_count >= max_jobs) {
            return 55;
        }

        i64 alias = raz_compiler_rt_arena_create(4096);
        i64 spec = raz_compiler_rt_arena_create(4096);
        i64 name = raz_compiler_rt_arena_create(4096);
        i64 con = raz_compiler_rt_arena_create(256);
        i64 version = raz_compiler_rt_arena_create(256);
        i64 path = raz_compiler_rt_arena_create(8192);
        i64 checksum = raz_compiler_rt_arena_create(64);

        if (alias == 0 || spec == 0 || name == 0 || con == 0 || version == 0 || path == 0 || checksum == 0) {
            return 40;
        }

        i64 al = package_copy_key(data, s, eq, alias, 4096);
        i64 sl = copy_quoted_value(data, eq + 1, e, spec, 4096);
        i64 nl = 0;
        i64 cl = 0;
        i64 section_kind = 2;

        if (
            !registry_tracking_spec_parse(spec, sl, name, 4096, &mut nl, con, 256, &mut cl, &mut section_kind)
        ) {
            return 55;
        }
        raz_compiler_rt_arena_destroy(spec);
        raz_compiler_rt_arena_set(aliases, job_count, alias);
        raz_compiler_rt_arena_set(alias_lengths, job_count, al);
        raz_compiler_rt_arena_set(names, job_count, name);
        raz_compiler_rt_arena_set(name_lengths, job_count, nl);
        raz_compiler_rt_arena_set(constraints, job_count, con);
        raz_compiler_rt_arena_set(constraint_lengths, job_count, cl);
        raz_compiler_rt_arena_set(section_kinds, job_count, section_kind);
        raz_compiler_rt_arena_set(versions, job_count, version);
        raz_compiler_rt_arena_set(paths, job_count, path);
        raz_compiler_rt_arena_set(checksums, job_count, checksum);

        i64 context = raz_compiler_rt_arena_create(7);

        if (context == 0) {
            return 40;
        }
        raz_compiler_rt_arena_set(context, 0, name);
        raz_compiler_rt_arena_set(context, 1, nl);
        raz_compiler_rt_arena_set(context, 2, con);
        raz_compiler_rt_arena_set(context, 3, cl);
        raz_compiler_rt_arena_set(context, 4, version);
        raz_compiler_rt_arena_set(context, 5, path);
        raz_compiler_rt_arena_set(context, 6, checksum);
        raz_compiler_rt_arena_set(contexts, job_count, context);

        i64 captured_context = context;

        auto task = raz_rt_task_spawn_callable_i64(move fn() -> i64 {
            return registry_resolve_context_job(captured_context);
        }
        );

        usize task_value = 0;

        unsafe {
            task_value = task as usize;
        }
        if (task_value == 0) {
            return 40;
        }
        raz_compiler_rt_arena_set(tasks, job_count, task_value as i64);
        job_count += 1;
    }
    if (job_count == 0) {
        return package_registry_update_finish(package_lock_command());
    }

    i64 status = 0;

    i = 0;
    while (i < job_count) {
        i64 task_value = raz_compiler_rt_arena_get(tasks, i);
        i64 st = 40;

        if (task_value != 0) {
            unsafe {
                st = raz_rt_task_join_i64(task_value as i8*mut);
            }
        }
        if (status == 0 && st != 0) {
            status = st;
        }
        i += 1;
    }
    // Apply successful resolutions in tracking-file order for deterministic
    // manifests, cache metadata, and lockfiles.
    if (status == 0) {
        i = 0;
        while (i < job_count) {
            i64 alias = raz_compiler_rt_arena_get(aliases, i);
            i64 al = raz_compiler_rt_arena_get(alias_lengths, i);
            i64 name = raz_compiler_rt_arena_get(names, i);
            i64 nl = raz_compiler_rt_arena_get(name_lengths, i);
            i64 version = raz_compiler_rt_arena_get(versions, i);
            i64 path = raz_compiler_rt_arena_get(paths, i);
            i64 checksum = raz_compiler_rt_arena_get(checksums, i);
            i64 section_kind = raz_compiler_rt_arena_get(section_kinds, i);
            i64 vl = 0;

            while (vl < 256 && raz_compiler_rt_arena_get(version, vl) != 0) {
                vl += 1;
            }

            i64 pl = 0;

            while (pl < 8192 && raz_compiler_rt_arena_get(path, pl) != 0) {
                pl += 1;
            }

            i64 hl = 0;

            while (hl < 64 && raz_compiler_rt_arena_get(checksum, hl) != 0) {
                hl += 1;
            }
            cli_print_status_name_version(11, name, nl, version, vl);
            // The manifest already contains the human registry declaration. Update
            // only exact resolved state and the lockfile; never rewrite user intent.
            if (status == 0) {
                status = registry_write_cache(alias, al, name, nl, version, vl, path, pl, checksum, hl);
            }
            if (status != 0) {
                break;
            }
            i += 1;
        }
    }
    if (status == 0) {
        status = package_git_fetch_tracked();
    }
    if (status == 0) {
        status = registry_rebuild_lock_from_resolved_cache();
    }
    i = 0;
    while (i < job_count) {
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(aliases, i));
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(names, i));
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(constraints, i));
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(versions, i));
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(paths, i));
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(checksums, i));
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(contexts, i));
        i += 1;
    }
    raz_compiler_rt_arena_destroy(aliases);
    raz_compiler_rt_arena_destroy(alias_lengths);
    raz_compiler_rt_arena_destroy(names);
    raz_compiler_rt_arena_destroy(name_lengths);
    raz_compiler_rt_arena_destroy(constraints);
    raz_compiler_rt_arena_destroy(constraint_lengths);
    raz_compiler_rt_arena_destroy(section_kinds);
    raz_compiler_rt_arena_destroy(versions);
    raz_compiler_rt_arena_destroy(paths);
    raz_compiler_rt_arena_destroy(checksums);
    raz_compiler_rt_arena_destroy(contexts);
    raz_compiler_rt_arena_destroy(tasks);
    raz_compiler_rt_arena_destroy(fp);
    raz_compiler_rt_arena_destroy(data);
    return package_registry_update_finish(status);
}

// Rebuild derived target/raz.cache rows from an exact lockfile entry and the
// tracking map reconstructed from raz.toml. This is what makes target/ fully
// disposable: after `raz clean`, an ordinary build can restore alias -> package
// mappings without re-resolving constraints or changing locked versions.
fn registry_validate_manifest_lock_constraints() -> i64 {
    i64 sync_status = registry_sync_tracking_from_manifest();

    if (sync_status != 0) {
        return sync_status;
    }

    i64 path = raz_compiler_rt_arena_create(20);
    i64 tracking = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || tracking == 0) {
        return 40;
    }

    i64 path_length = registry_project_state_prepare(1, path, 20);

    if (path_length <= 0) {
        return 56;
    }

    i64 i = 0;
    i64 length = raz_compiler_rt_read_ascii(path, path_length, tracking, 1048576);

    raz_compiler_rt_arena_destroy(path);
    if (length <= 0) {
        raz_compiler_rt_arena_destroy(tracking);
        return 0;
    }

    i64 cursor = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (cursor < length && raz_compiler_rt_arena_get(tracking, cursor) != 10) {
            cursor += 1;
        }

        i64 end = cursor;

        if (cursor < length) {
            cursor += 1;
        }

        i64 equal = start;

        while (equal < end && raz_compiler_rt_arena_get(tracking, equal) != 61) {
            equal += 1;
        }
        if (equal >= end) {
            continue;
        }

        i64 alias = raz_compiler_rt_arena_create(4096);
        i64 spec = raz_compiler_rt_arena_create(4096);
        i64 name = raz_compiler_rt_arena_create(4096);
        i64 constraint = raz_compiler_rt_arena_create(256);
        i64 current = raz_compiler_rt_arena_create(256);

        if (alias == 0 || spec == 0 || name == 0 || constraint == 0 || current == 0) {
            return 40;
        }

        i64 al = package_copy_key(tracking, start, equal, alias, 4096);
        i64 sl = copy_quoted_value(tracking, equal + 1, end, spec, 4096);
        i64 nl = 0;
        i64 cl = 0;
        i64 section_kind = 2;

        if (
            !registry_tracking_spec_parse(
                spec,
                sl,
                name,
                4096,
                &mut nl,
                constraint,
                256,
                &mut cl,
                &mut section_kind,
            )
        ) {
            return 55;
        }

        i64 cvl = registry_dependency_version(alias, al, current, 256);

        if (cvl <= 0 || !registry_constraint_matches(current, 0, cvl, constraint, cl)) {
            raz_compiler_rt_arena_destroy(alias);
            raz_compiler_rt_arena_destroy(spec);
            raz_compiler_rt_arena_destroy(name);
            raz_compiler_rt_arena_destroy(constraint);
            raz_compiler_rt_arena_destroy(current);
            raz_compiler_rt_arena_destroy(tracking);
            // Lockfile no longer satisfies raz.toml. `raz update` is the explicit
            // operation that is allowed to re-resolve dependency intent.
            return 74;
        }
        raz_compiler_rt_arena_destroy(alias);
        raz_compiler_rt_arena_destroy(spec);
        raz_compiler_rt_arena_destroy(name);
        raz_compiler_rt_arena_destroy(constraint);
        raz_compiler_rt_arena_destroy(current);
    }
    raz_compiler_rt_arena_destroy(tracking);
    return 0;
}

// Prepare exact locked registry dependencies for an ordinary build without
// re-resolving version constraints or rewriting raz.lock.  This is the normal
// Cargo/Go-style build preflight: a clean checkout containing raz.toml and
// raz.lock can build immediately, while cached packages make the operation a
// local integrity check.  The manifest path may be relative or absolute.
fn registry_vendor_active() -> bool {
    i64 marker = raz_compiler_rt_arena_create(13);

    if (marker == 0) {
        return false;
    }

    string bytes = "./.raz-vendor";
    i64 i = 0;

    while (i < 13) {
        raz_compiler_rt_arena_set(marker, i, compiler_literal_byte(bytes, i));
        i += 1;
    }

    bool active = raz_compiler_rt_path_exists_ascii(marker, 13) != 0;

    raz_compiler_rt_arena_destroy(marker);
    return active;
}

fn registry_vendor_path(i64 checksum, i64 checksum_length, i64 output, i64 capacity) -> i64 {
    string prefix = "./vendor/registry/";

    if (output == 0 || checksum == 0 || checksum_length <= 0 || 18 + checksum_length > capacity) {
        return -1;
    }

    i64 i = 0;

    while (i < 18) {
        raz_compiler_rt_arena_set(output, i, compiler_literal_byte(prefix, i));
        i += 1;
    }
    i = 0;
    while (i < checksum_length) {
        raz_compiler_rt_arena_set(output, 18 + i, raz_compiler_rt_arena_get(checksum, i));
        i += 1;
    }
    return 18 + checksum_length;
}

fn registry_vendor_verify_lock_data(i64 data, i64 length) -> i64 {
    i64 checksum = raz_compiler_rt_arena_create(128);
    i64 source = raz_compiler_rt_arena_create(64);

    if (data == 0 || length < 0 || checksum == 0 || source == 0) {
        return 40;
    }

    i64 checksum_length = 0;
    bool registry_source = false;
    i64 pos = 0;

    while (pos < length) {
        i64 start = pos;

        while (
            pos < length &&
            raz_compiler_rt_arena_get(data, pos) != 10 &&
            raz_compiler_rt_arena_get(data, pos) != 13
        ) {
            pos += 1;
        }

        i64 end = pos;

        while (
            pos < length &&
            (raz_compiler_rt_arena_get(data, pos) == 10 || raz_compiler_rt_arena_get(data, pos) == 13)
        ) {
            pos += 1;
        }

        string package_header = "[[package]]";
        bool header = end - start == 11;
        i64 i = 0;

        while (header && i < 11) {
            if (raz_compiler_rt_arena_get(data, start + i) != compiler_literal_byte(package_header, i)) {
                header = false;
            }
            i += 1;
        }
        if (header) {
            if (registry_source) {
                i64 vendored = raz_compiler_rt_arena_create(8192);

                if (vendored == 0) {
                    return 40;
                }

                i64 vl = registry_vendor_path(checksum, checksum_length, vendored, 8192);

                if (vl <= 0 || !registry_store_verify(vendored, vl, checksum, checksum_length)) {
                    return 78;
                }
                raz_compiler_rt_arena_destroy(vendored);
            }
            checksum_length = 0;
            registry_source = false;
            continue;
        }

        i64 equal = start;

        while (equal < end && raz_compiler_rt_arena_get(data, equal) != 61) {
            equal += 1;
        }
        if (equal >= end) {
            continue;
        }

        string source_key = "source";
        string checksum_key = "checksum";

        if (registry_lock_key_equals_literal(data, start, equal, checksum_key)) {
            checksum_length = copy_quoted_value(data, equal + 1, end, checksum, 128);
        } else if (registry_lock_key_equals_literal(data, start, equal, source_key)) {
            i64 sl = copy_quoted_value(data, equal + 1, end, source, 64);
            string expected = "registry";

            registry_source = sl == 8;
            i = 0;
            while (registry_source && i < 8) {
                if (raz_compiler_rt_arena_get(source, i) != compiler_literal_byte(expected, i)) {
                    registry_source = false;
                }
                i += 1;
            }
        }
    }
    if (registry_source) {
        i64 vendored = raz_compiler_rt_arena_create(8192);

        if (vendored == 0) {
            return 40;
        }

        i64 vl = registry_vendor_path(checksum, checksum_length, vendored, 8192);

        if (vl <= 0 || !registry_store_verify(vendored, vl, checksum, checksum_length)) {
            return 78;
        }
        raz_compiler_rt_arena_destroy(vendored);
    }
    raz_compiler_rt_arena_destroy(checksum);
    raz_compiler_rt_arena_destroy(source);
    return 0;
}

fn package_registry_prepare_build(i64 manifest_path, i64 manifest_length) -> i64 {
    if (manifest_path == 0 || manifest_length <= 0) {
        return 0;
    }

    i64 root = raz_compiler_rt_arena_create(8192);
    i64 lock_path = raz_compiler_rt_arena_create(8192);
    i64 lock_data = raz_compiler_rt_arena_create(2097152);

    if (root == 0 || lock_path == 0 || lock_data == 0) {
        return 40;
    }
    // Find the manifest directory.  A bare `raz.toml` uses the current project
    // root, represented as `.` so package-store virtual paths retain existing
    // path-join behavior.

    i64 split = manifest_length;

    while (split > 0) {
        i64 b = raz_compiler_rt_arena_get(manifest_path, split - 1);

        if (b == 47 || b == 92) {
            break;
        }
        split -= 1;
    }

    i64 root_length = 0;

    if (split == 0) {
        raz_compiler_rt_arena_set(root, 0, 46);
        root_length = 1;
    } else {
        root_length = split;

        i64 i = 0;

        while (i < root_length) {
            raz_compiler_rt_arena_set(root, i, raz_compiler_rt_arena_get(manifest_path, i));
            i += 1;
        }
        while (root_length > 1) {
            i64 tail = raz_compiler_rt_arena_get(root, root_length - 1);

            if (tail != 47 && tail != 92) {
                break;
            }
            root_length -= 1;
        }
    }

    i64 lock_length = 0;

    // Construct <root>/raz.lock directly so explicit manifest paths work too.
    if (root_length + 9 >= 8192) {
        raz_compiler_rt_arena_destroy(root);
        raz_compiler_rt_arena_destroy(lock_path);
        raz_compiler_rt_arena_destroy(lock_data);
        return 40;
    }

    i64 cursor = 0;

    while (cursor < root_length) {
        raz_compiler_rt_arena_set(lock_path, cursor, raz_compiler_rt_arena_get(root, cursor));
        cursor += 1;
    }
    if (cursor > 0) {
        i64 tail = raz_compiler_rt_arena_get(lock_path, cursor - 1);

        if (tail != 47 && tail != 92) {
            raz_compiler_rt_arena_set(lock_path, cursor, 47);
            cursor += 1;
        }
    }

    string suffix = "raz.lock";
    i64 j = 0;

    while (j < 8) {
        raz_compiler_rt_arena_set(lock_path, cursor + j, compiler_literal_byte(suffix, j));
        j += 1;
    }
    lock_length = cursor + 8;

    i64 data_length = raz_compiler_rt_read_ascii(lock_path, lock_length, lock_data, 2097152);
    i64 status = 0;

    if (data_length >= 0) {
        // Recreate target/raz.registry from raz.toml first. Exact lock hydration
        // below then rebuilds target/raz.cache without changing dependency intent.
        status = registry_sync_tracking_from_manifest();
        if (status != 0) {
            raz_compiler_rt_arena_destroy(root);
            raz_compiler_rt_arena_destroy(lock_path);
            raz_compiler_rt_arena_destroy(lock_data);
            return status;
        }
        if (registry_vendor_active()) {
            status = registry_vendor_verify_lock_data(lock_data, data_length);
            if (status == 0) {
                status = package_git_vendor_verify_tracked();
            }
        } else {
            status = registry_fetch_lock_data(lock_data, data_length);
            if (status == 0) {
                // target/git is generated cache state. Rehydrate commit-pinned
                // Git dependencies automatically after `raz clean`, just like
                // locked registry packages are restored from the shared store.
                status = package_git_fetch_tracked();
            }
        }
        if (status == 0) {
            status = registry_validate_manifest_lock_constraints();
        }
    }
    raz_compiler_rt_arena_destroy(root);
    raz_compiler_rt_arena_destroy(lock_path);
    raz_compiler_rt_arena_destroy(lock_data);
    return status;
}

fn package_registry_fetch_command() -> i64 {
    i64 lock_path = raz_compiler_rt_arena_create(16);
    i64 data = raz_compiler_rt_arena_create(2097152);

    if (lock_path == 0 || data == 0) {
        return 40;
    }

    string lp = "./raz.lock";
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(lock_path, i, compiler_literal_byte(lp, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_read_ascii(lock_path, 10, data, 2097152);

    if (length < 0) {
        raz_compiler_rt_arena_destroy(lock_path);
        raz_compiler_rt_arena_destroy(data);
        return package_registry_update_command();
    }

    i64 status = registry_sync_tracking_from_manifest();

    if (status == 0) {
        status = registry_fetch_lock_data(data, length);
    }
    if (status == 0) {
        status = package_git_fetch_tracked();
    }
    if (status == 0) {
        status = package_lock_command();
    }
    raz_compiler_rt_arena_destroy(lock_path);
    raz_compiler_rt_arena_destroy(data);
    return status;
}

fn registry_remove_tracking(i64 alias, i64 al) -> i64 {
    i64 path = raz_compiler_rt_arena_create(20);
    i64 old = raz_compiler_rt_arena_create(1048576);
    i64 out = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || old == 0 || out == 0) {
        return 40;
    }

    i64 path_length = registry_project_state_prepare(1, path, 20);

    if (path_length <= 0) {
        return 56;
    }

    i64 i = 0;
    i64 ol = raz_compiler_rt_read_ascii(path, path_length, old, 1048576);

    if (ol<0) {
        raz_compiler_rt_arena_destroy(path);
        raz_compiler_rt_arena_destroy(old);
        raz_compiler_rt_arena_destroy(out);
        return 0;
    }

    i64 cursor = 0;
    i64 pos = 0;

    while (pos<ol) {
        i64 s = pos;

        while (pos<ol && raz_compiler_rt_arena_get(old, pos) != 10) {
            pos += 1;
        }

        i64 e = pos;

        if (pos<ol) {
            pos += 1;
        }

        i64 eq = s;

        while (eq<e && raz_compiler_rt_arena_get(old, eq) != 61) {
            eq += 1;
        }
        if (eq >= e || !package_key_equals(old, s, eq, alias, al)) {
            package_append(out, 1048576, &mut cursor, old, s, e - s);

            package_append_string_literal(out, 1048576, &mut cursor, "\n");
        }
    }

    i64 w = raz_compiler_rt_write_ascii(path, path_length, out, cursor);

    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(old);
    raz_compiler_rt_arena_destroy(out);
    if (w == cursor) {
        return 0;
    }
    return 56;
}

// Package creation and publishing. Archives are deterministic DPK1 payloads and
// registry metadata always names the full package-tree content hash.
fn registry_current_identity(
    i64 name,
    i64 name_cap,
    i64&mut nl,
    i64 version,
    i64 version_cap,
    i64&mut vl,
) -> i64 {
    i64 mp = raz_compiler_rt_arena_create(11);
    i64 manifest = raz_compiler_rt_arena_create(65536);

    if (mp == 0 || manifest == 0) {
        return 40;
    }

    string p = "./raz.toml";
    i64 i = 0;

    while (i<10) {
        raz_compiler_rt_arena_set(mp, i, compiler_literal_byte(p, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_read_ascii(mp, 10, manifest, 65536);

    if (length <= 0) {
        return 57;
    }

    string nk = "name";
    string vk = "version";

    *nl = package_manifest_field_literal(manifest, length, nk, name, name_cap);
    *vl = package_manifest_field_literal(manifest, length, vk, version, version_cap);
    raz_compiler_rt_arena_destroy(mp);
    raz_compiler_rt_arena_destroy(manifest);
    if (*nl <= 0 || *vl <= 0) {
        return 57;
    }
    return 0;
}

fn registry_hash_hex(i64 value, i64 output, i64 capacity) -> i64 {
    if (capacity<16) {
        return -1;
    }

    i64 shift = 60;
    i64 i = 0;

    while (shift >= 0) {
        i64 nib = (value >> shift)&15;

        raz_compiler_rt_arena_set(output, i, registry_hex_digit(nib));
        i += 1;
        shift -= 4;
    }
    return 16;
}

fn registry_default_archive_path(i64 name, i64 nl, i64 version, i64 vl, i64 output, i64 capacity) -> i64 {
    i64 c = 0;

    // `raz pack` is a distributable/release operation. Keep the default archive
    // with the rest of the release-profile artifacts instead of leaving a .dpk
    // in the project root. An explicit output argument still wins unchanged.
    package_append_string_literal(output, capacity, &mut c, "target/release/packages/");
    package_append(output, capacity, &mut c, name, 0, nl);
    package_append_string_literal(output, capacity, &mut c, "-");
    package_append(output, capacity, &mut c, version, 0, vl);
    package_append_string_literal(output, capacity, &mut c, ".dpk");
    return c;
}

fn registry_dependency_path_publishable(i64 path, i64 length) -> bool {
    if (path == 0 || length <= 0) {
        return false;
    }

    string registry_prefix = "registry:";

    if (length> 9 && registry_path_prefix_literal(path, length, registry_prefix)) {
        return true;
    }

    i64 first = raz_compiler_rt_arena_get(path, 0);

    if (first == 47 || first == 92) {
        return false;
    }
    if (length >= 2 && raz_compiler_rt_arena_get(path, 1) == 58) {
        return false;
    }

    string local_cache = ".raz/";

    if (registry_path_prefix_literal(path, length, local_cache)) {
        return false;
    }

    string target_cache = "target/";
    string target_cache_dot = "./target/";

    if (
        registry_path_prefix_literal(path, length, target_cache) ||
        registry_path_prefix_literal(path, length, target_cache_dot)
    ) {
        return false;
    }

    i64 segment = 0;
    i64 i = 0;

    while (i <= length) {
        bool boundary = i == length;

        if (!boundary) {
            i64 ch = raz_compiler_rt_arena_get(path, i);

            boundary = ch == 47 || ch == 92;
        }
        if (boundary) {
            i64 segment_length = i - segment;

            if (
                segment_length == 2 &&
                raz_compiler_rt_arena_get(path, segment) == 46 &&
                raz_compiler_rt_arena_get(path, segment + 1) == 46
            ) {
                return false;
            }
            segment = i + 1;
        }
        i += 1;
    }
    return true;
}

fn registry_package_dependencies_publishable() -> i64 {
    i64 path = raz_compiler_rt_arena_create(16);
    i64 manifest = raz_compiler_rt_arena_create(1048576);
    i64 dependency = raz_compiler_rt_arena_create(8192);

    if (path == 0 || manifest == 0 || dependency == 0) {
        return 40;
    }

    string mp = "./raz.toml";
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(path, i, compiler_literal_byte(mp, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_read_ascii(path, 10, manifest, 1048576);

    if (length <= 0) {
        return 57;
    }

    i64 section = 0;
    i64 pos = 0;

    while (pos < length) {
        i64 start = pos;

        while (
            pos < length &&
            raz_compiler_rt_arena_get(manifest, pos) != 10 &&
            raz_compiler_rt_arena_get(manifest, pos) != 13
        ) {
            pos += 1;
        }

        i64 end = pos;

        while (
            pos < length &&
            (raz_compiler_rt_arena_get(manifest, pos) == 10 || raz_compiler_rt_arena_get(manifest, pos) == 13)
        ) {
            pos += 1;
        }

        i64 dependency_section = package_dependency_section_kind(manifest, start, end);

        if (dependency_section != 0) {
            section = dependency_section;
            continue;
        }
        if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) {
            section = 0;
            continue;
        }
        if (section < 2 || section> 8) {
            continue;
        }

        i64 equal = start;

        while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) {
            equal += 1;
        }
        if (equal >= end) {
            continue;
        }

        i64 dependency_length = copy_quoted_value(manifest, equal + 1, end, dependency, 8192);

        if (!registry_dependency_path_publishable(dependency, dependency_length)) {
            raz_compiler_rt_arena_destroy(path);
            raz_compiler_rt_arena_destroy(manifest);
            raz_compiler_rt_arena_destroy(dependency);
            return 72;
        }
    }
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(manifest);
    raz_compiler_rt_arena_destroy(dependency);
    return 0;
}

fn package_pack_command(i64 argc) -> i64 {
    if (argc> 3) {
        return 55;
    }

    i64 name = raz_compiler_rt_arena_create(4096);
    i64 version = raz_compiler_rt_arena_create(256);
    i64 output = raz_compiler_rt_arena_create(8192);
    i64 archive = raz_compiler_rt_arena_create_width(67108864, 1);
    i64 root = raz_compiler_rt_arena_create(1);

    if (name == 0 || version == 0 || output == 0 || archive == 0 || root == 0) {
        return 40;
    }

    i64 nl = 0;
    i64 vl = 0;
    i64 s = registry_current_identity(name, 4096, &mut nl, version, 256, &mut vl);

    if (s != 0) {
        return s;
    }
    s = registry_package_dependencies_publishable();
    if (s != 0) {
        return s;
    }

    i64 ol = 0;

    if (argc == 3) {
        ol = raz_compiler_rt_process_arg(2, output, 8192);
    } else {
        i64 package_dir = raz_compiler_rt_arena_create(24);
        if (package_dir == 0) { return 40; }
        string package_dir_text = "target/release/packages";
        i64 package_dir_length = compiler_literal_length(package_dir_text);
        i64 package_dir_index = 0;
        while (package_dir_index < package_dir_length) {
            raz_compiler_rt_arena_set(
                package_dir,
                package_dir_index,
                compiler_literal_byte(package_dir_text, package_dir_index),
            );
            package_dir_index += 1;
        }
        if (raz_compiler_rt_create_dir_ascii(package_dir, package_dir_length) != 0) {
            raz_compiler_rt_arena_destroy(package_dir);
            return 65;
        }
        raz_compiler_rt_arena_destroy(package_dir);
        ol = registry_default_archive_path(name, nl, version, vl, output, 8192);
    }
    raz_compiler_rt_remove_path_ascii(output, ol);
    raz_compiler_rt_arena_set(root, 0, 46);

    i64 hash = registry_tree_hash(root, 1);

    if (hash == 0) {
        return 65;
    }

    i64 al = registry_pack_tree(root, 1, archive, 67108864);

    if (al <= 0) {
        return -al;
    }
    if (raz_compiler_rt_write_ascii(output, ol, archive, al) != al) {
        return 65;
    }

    i64 hex = raz_compiler_rt_arena_create(16);

    registry_hash_hex(hash, hex, 16);

    cli_write_literal("Packed ");
    cli_write_arena(output, ol);

    cli_write_literal(" hash ");
    cli_write_arena(hex, 16);

    cli_write_literal("\n");
    raz_compiler_rt_arena_destroy(name);
    raz_compiler_rt_arena_destroy(version);
    raz_compiler_rt_arena_destroy(output);
    raz_compiler_rt_arena_destroy(archive);
    raz_compiler_rt_arena_destroy(root);
    raz_compiler_rt_arena_destroy(hex);
    return 0;
}

fn registry_publish_index_local(
    i64 directory,
    i64 dl,
    i64 name,
    i64 nl,
    i64 version,
    i64 vl,
    i64 checksum,
    i64 cl,
    i64 key_id,
    i64 kidl,
    i64 signature,
    i64 sl,
) -> i64 {
    i64 index = raz_compiler_rt_arena_create(8192);
    i64 old = raz_compiler_rt_arena_create(4194304);
    i64 out = raz_compiler_rt_arena_create(4194304);

    if (index == 0 || old == 0 || out == 0) {
        return 40;
    }

    i64 c = 0;

    package_append(index, 8192, &mut c, directory, 0, dl);
    if (
        c> 0 &&
        raz_compiler_rt_arena_get(index, c - 1) != 47 &&
        raz_compiler_rt_arena_get(index, c - 1) != 92
    ) {

        package_append_string_literal(index, 8192, &mut c, "/");
    }

    package_append_string_literal(index, 8192, &mut c, "index.txt");

    i64 oldl = raz_compiler_rt_read_ascii(index, c, old, 4194304);

    if (oldl<0) {
        oldl = 0;
    }

    i64 oc = 0;
    i64 pos = 0;

    while (pos<oldl) {
        i64 st = pos;

        while (pos<oldl && raz_compiler_rt_arena_get(old, pos) != 10) {
            pos += 1;
        }

        i64 en = pos;

        if (pos<oldl) {
            pos += 1;
        }

        i64 ns = 0;
        i64 nlen = 0;
        i64 vs = 0;
        i64 vlen = 0;
        bool same = false;

        if (
            registry_token(old, st, en, 0, &mut ns, &mut nlen) &&
            registry_token(old, st, en, 1, &mut vs, &mut vlen)
        ) {
            same =
                registry_bytes_equal(old, ns, nlen, name, 0, nl) &&
                registry_bytes_equal(old, vs, vlen, version, 0, vl);
        }
        if (!same) {
            package_append(out, 4194304, &mut oc, old, st, en - st);

            package_append_string_literal(out, 4194304, &mut oc, "\n");
        }
    }
    package_append(out, 4194304, &mut oc, name, 0, nl);

    package_append_string_literal(out, 4194304, &mut oc, " ");
    package_append(out, 4194304, &mut oc, version, 0, vl);
    package_append_string_literal(out, 4194304, &mut oc, " ");
    package_append(out, 4194304, &mut oc, directory, 0, dl);
    if (
        dl> 0 &&
        raz_compiler_rt_arena_get(directory, dl - 1) != 47 &&
        raz_compiler_rt_arena_get(directory, dl - 1) != 92
    ) {

        package_append_string_literal(out, 4194304, &mut oc, "/");
    }

    package_append_string_literal(out, 4194304, &mut oc, "packages/");
    package_append(out, 4194304, &mut oc, name, 0, nl);

    package_append_string_literal(out, 4194304, &mut oc, "/");
    package_append(out, 4194304, &mut oc, version, 0, vl);

    package_append_string_literal(out, 4194304, &mut oc, ".dpk");
    package_append_string_literal(out, 4194304, &mut oc, " ");
    package_append(out, 4194304, &mut oc, checksum, 0, cl);
    if (kidl> 0 && sl> 0) {
        package_append_string_literal(out, 4194304, &mut oc, " ");
        package_append(out, 4194304, &mut oc, key_id, 0, kidl);
        package_append_string_literal(out, 4194304, &mut oc, " ");
        package_append(out, 4194304, &mut oc, signature, 0, sl);
    }

    package_append_string_literal(out, 4194304, &mut oc, "\n");

    i64 wr = raz_compiler_rt_write_ascii(index, c, out, oc);

    raz_compiler_rt_arena_destroy(index);
    raz_compiler_rt_arena_destroy(old);
    raz_compiler_rt_arena_destroy(out);
    if (wr != oc) {
        return 65;
    }
    return 0;
}

fn registry_official_publish_requested() -> bool {
    i64 value = raz_compiler_rt_arena_create(8192);

    if (value == 0) {
        return false;
    }

    string publish_key = "RAZ_REGISTRY_PUBLISH_DIR";
    string registry_key = "RAZ_REGISTRY_URL";
    i64 local = registry_env_ascii_literal(publish_key, value, 8192);
    i64 remote = registry_env_ascii_literal(registry_key, value, 8192);

    raz_compiler_rt_arena_destroy(value);
    return local <= 0 && remote <= 0;
}

fn registry_official_publish_metadata() -> i64 {
    i64 manifest_path = raz_compiler_rt_arena_create(11);
    i64 manifest = raz_compiler_rt_arena_create(65536);
    i64 kind = raz_compiler_rt_arena_create(64);
    i64 description = raz_compiler_rt_arena_create(256);
    i64 license = raz_compiler_rt_arena_create(128);

    if (manifest_path == 0 || manifest == 0 || kind == 0 || description == 0 || license == 0) {
        return 40;
    }

    string mp = "./raz.toml";
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(manifest_path, i, compiler_literal_byte(mp, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_read_ascii(manifest_path, 10, manifest, 65536);

    if (length <= 0) {
        return 57;
    }

    string kk = "kind";
    string dk = "description";
    string lk = "license";
    i64 kl = package_manifest_field_literal(manifest, length, kk, kind, 64);
    i64 dl = package_manifest_field_literal(manifest, length, dk, description, 256);
    i64 ll = package_manifest_field_literal(manifest, length, lk, license, 128);
    string library = "library";
    bool library_kind = kl == 7;

    i = 0;
    while (library_kind && i < 7) {
        if (raz_compiler_rt_arena_get(kind, i) != compiler_literal_byte(library, i)) {
            library_kind = false;
        }
        i += 1;
    }
    if (!library_kind || dl <= 0 || dl> 200 || ll <= 0 || ll> 80) {
        return 72;
    }

    i64 readme = raz_compiler_rt_arena_create(12);
    i64 license_path = raz_compiler_rt_arena_create(10);

    if (readme == 0 || license_path == 0) {
        return 40;
    }

    string rb = "./README.md";

    i = 0;
    while (i < 11) {
        raz_compiler_rt_arena_set(readme, i, compiler_literal_byte(rb, i));
        i += 1;
    }

    string lb = "./LICENSE";

    i = 0;
    while (i < 9) {
        raz_compiler_rt_arena_set(license_path, i, compiler_literal_byte(lb, i));
        i += 1;
    }
    if (
        raz_compiler_rt_path_exists_ascii(readme, 11) == 0 ||
        raz_compiler_rt_path_exists_ascii(license_path, 9) == 0
    ) {
        return 72;
    }
    raz_compiler_rt_arena_destroy(manifest_path);
    raz_compiler_rt_arena_destroy(manifest);
    raz_compiler_rt_arena_destroy(kind);
    raz_compiler_rt_arena_destroy(description);
    raz_compiler_rt_arena_destroy(license);
    raz_compiler_rt_arena_destroy(readme);
    raz_compiler_rt_arena_destroy(license_path);
    return 0;
}

fn package_publish_command() -> i64 {
    if (registry_offline()) {
        return 64;
    }
    if (registry_official_publish_requested()) {
        i64 metadata_status = registry_official_publish_metadata();

        if (metadata_status != 0) {
            return metadata_status;
        }
    }

    i64 name = raz_compiler_rt_arena_create(4096);
    i64 version = raz_compiler_rt_arena_create(256);
    i64 archive = raz_compiler_rt_arena_create_width(67108864, 1);
    i64 root = raz_compiler_rt_arena_create(1);
    i64 checksum = raz_compiler_rt_arena_create(16);
    i64 key_id = raz_compiler_rt_arena_create(16);
    i64 signature = raz_compiler_rt_arena_create(128);

    if (
        name == 0 ||
        version == 0 ||
        archive == 0 ||
        root == 0 ||
        checksum == 0 ||
        key_id == 0 ||
        signature == 0
    ) {
        return 40;
    }

    i64 nl = 0;
    i64 vl = 0;
    i64 s = registry_current_identity(name, 4096, &mut nl, version, 256, &mut vl);

    if (s != 0) {
        return s;
    }
    s = registry_package_dependencies_publishable();
    if (s != 0) {
        return s;
    }
    raz_compiler_rt_arena_set(root, 0, 46);

    i64 previous = raz_compiler_rt_arena_create(8192);
    i64 previous_length = registry_default_archive_path(name, nl, version, vl, previous, 8192);

    raz_compiler_rt_remove_path_ascii(previous, previous_length);
    raz_compiler_rt_arena_destroy(previous);

    i64 hash = registry_tree_hash(root, 1);

    if (hash == 0) {
        return 65;
    }
    registry_hash_hex(hash, checksum, 16);

    i64 signed_state = signing_sign_metadata(name, nl, version, vl, checksum, 16, key_id, 16, signature, 128);

    if (signed_state<0) {
        return 69;
    }

    i64 kidl = 0;
    i64 sl = 0;

    if (signed_state> 0) {
        kidl = 16;
        sl = 128;
    }

    i64 al = registry_pack_tree(root, 1, archive, 67108864);

    if (al <= 0) {
        return -al;
    }

    i64 local = raz_compiler_rt_arena_create(8192);
    string lkey = "RAZ_REGISTRY_PUBLISH_DIR";
    i64 ll = registry_env_ascii_literal(lkey, local, 8192);
    bool prepared_submission = false;
    bool github_publish = false;

    // The official registry is hosted entirely by GitHub.  With a GitHub (or
    // Raz registry) token, publish the immutable archive through the GitHub
    // Contents API and let registry CI regenerate the static index/API. Without
    // credentials, preserve the contribution-friendly repository-shaped staging
    // tree so any user can submit the same archive in a pull request.
    if (ll <= 0) {
        i64 remote = raz_compiler_rt_arena_create(8192);
        string rkey = "RAZ_REGISTRY_URL";
        i64 rl = registry_env_ascii_literal(rkey, remote, 8192);

        raz_compiler_rt_arena_destroy(remote);
        if (rl <= 0) {
            i64 publish_token = raz_compiler_rt_arena_create(8192);
            i64 token_length = 0;

            if (publish_token != 0) {
                token_length = registry_publish_token(publish_token, 8192, true);
                raz_compiler_rt_arena_destroy(publish_token);
            }
            if (token_length > 0) {
                github_publish = true;
            } else {
                string staging = "target/publish";
                i64 si = 0;

                while (si < 14) {
                    raz_compiler_rt_arena_set(local, si, compiler_literal_byte(staging, si));
                    si += 1;
                }
                ll = 14;
                prepared_submission = true;
                if (raz_compiler_rt_create_dir_ascii(local, ll) != 0) {
                    return 65;
                }
            }
        }
    }
    if (github_publish) {
        i64 github_status = registry_github_publish_archive(name, nl, version, vl, archive, al);

        if (github_status <= 0) {
            // A valid GitHub token does not imply direct write access to the
            // official registry. Fall back to a PR-ready tree instead of
            // turning that ordinary contributor case into a publish failure.

            string staging = "target/publish";
            i64 si = 0;

            while (si < 14) {
                raz_compiler_rt_arena_set(local, si, compiler_literal_byte(staging, si));
                si += 1;
            }
            ll = 14;
            prepared_submission = true;
            github_publish = false;
            if (raz_compiler_rt_create_dir_ascii(local, ll) != 0) {
                return 65;
            }
        }
    }
    if (!github_publish && ll > 0) {
        i64 package_dir = raz_compiler_rt_arena_create(8192);
        i64 target = raz_compiler_rt_arena_create(8192);
        i64 pc = 0;

        package_append(package_dir, 8192, &mut pc, local, 0, ll);
        if (
            pc > 0 &&
            raz_compiler_rt_arena_get(package_dir, pc - 1) != 47 &&
            raz_compiler_rt_arena_get(package_dir, pc - 1) != 92
        ) {

            package_append_string_literal(package_dir, 8192, &mut pc, "/");
        }

        package_append_string_literal(package_dir, 8192, &mut pc, "packages/");
        package_append(package_dir, 8192, &mut pc, name, 0, nl);
        if (raz_compiler_rt_create_dir_ascii(package_dir, pc) != 0) {
            return 65;
        }

        i64 tc = 0;

        package_append(target, 8192, &mut tc, package_dir, 0, pc);

        package_append_string_literal(target, 8192, &mut tc, "/");
        package_append(target, 8192, &mut tc, version, 0, vl);

        string ext = ".dpk";

        package_append_string_literal(target, 8192, &mut tc, ext);
        if (raz_compiler_rt_write_ascii(target, tc, archive, al) != al) {
            return 65;
        }
        s = registry_publish_index_local(
            local,
            ll,
            name,
            nl,
            version,
            vl,
            checksum,
            16,
            key_id,
            kidl,
            signature,
            sl,
        );
        raz_compiler_rt_arena_destroy(package_dir);
        raz_compiler_rt_arena_destroy(target);
        if (s != 0) {
            return s;
        }
    } else if (!github_publish) {
        i64 base = raz_compiler_rt_arena_create(8192);
        string key = "RAZ_REGISTRY_URL";
        i64 bl = registry_env_ascii_literal(key, base, 8192);

        if (bl <= 0) {
            return 60;
        }

        i64 suffix = raz_compiler_rt_arena_create(8192);
        i64 url = raz_compiler_rt_arena_create(16384);
        i64 sc = 0;
        string pp = "packages/";

        package_append_string_literal(suffix, 8192, &mut sc, pp);
        package_append(suffix, 8192, &mut sc, name, 0, nl);

        package_append_string_literal(suffix, 8192, &mut sc, "/");
        package_append(suffix, 8192, &mut sc, version, 0, vl);

        string ext = ".dpk";

        package_append_string_literal(suffix, 8192, &mut sc, ext);

        i64 ul = registry_join_url(base, bl, suffix, 0, sc, url, 16384);
        i64 ct = raz_compiler_rt_arena_create(24);
        string ctb = "application/x-raz-dpk1";
        i64 i = 0;

        while (i<22) {
            raz_compiler_rt_arena_set(ct, i, compiler_literal_byte(ctb, i));
            i += 1;
        }
        if (registry_http_put(url, ul, archive, al, ct, 22) < 0) {
            return 67;
        }
        sc = 0;

        package_append_string_literal(suffix, 8192, &mut sc, "entries/");
        package_append(suffix, 8192, &mut sc, name, 0, nl);
        package_append_string_literal(suffix, 8192, &mut sc, "/");
        package_append(suffix, 8192, &mut sc, version, 0, vl);
        ul = registry_join_url(base, bl, suffix, 0, sc, url, 16384);

        i64 entry = raz_compiler_rt_arena_create(16384);
        i64 ec = 0;

        package_append(entry, 16384, &mut ec, name, 0, nl);

        package_append_string_literal(entry, 16384, &mut ec, " ");
        package_append(entry, 16384, &mut ec, version, 0, vl);
        package_append_string_literal(entry, 16384, &mut ec, " ");
        package_append_string_literal(entry, 16384, &mut ec, pp);
        package_append(entry, 16384, &mut ec, name, 0, nl);
        package_append_string_literal(entry, 16384, &mut ec, "/");
        package_append(entry, 16384, &mut ec, version, 0, vl);
        package_append_string_literal(entry, 16384, &mut ec, ext);
        package_append_string_literal(entry, 16384, &mut ec, " ");
        package_append(entry, 16384, &mut ec, checksum, 0, 16);
        if (kidl> 0 && sl > 0) {
            package_append_string_literal(entry, 16384, &mut ec, " ");
            package_append(entry, 16384, &mut ec, key_id, 0, kidl);
            package_append_string_literal(entry, 16384, &mut ec, " ");
            package_append(entry, 16384, &mut ec, signature, 0, sl);
        }

        i64 textct = raz_compiler_rt_arena_create(10);
        string tx = "text/plain";

        i = 0;
        while (i<10) {
            raz_compiler_rt_arena_set(textct, i, compiler_literal_byte(tx, i));
            i += 1;
        }
        if (registry_http_put(url, ul, entry, ec, textct, 10) < 0) {
            return 67;
        }
        raz_compiler_rt_arena_destroy(base);
        raz_compiler_rt_arena_destroy(suffix);
        raz_compiler_rt_arena_destroy(url);
        raz_compiler_rt_arena_destroy(ct);
        raz_compiler_rt_arena_destroy(entry);
        raz_compiler_rt_arena_destroy(textct);
    }
    if (prepared_submission) {

        cli_write_literal("Prepared ");
    } else {

        cli_write_literal("Published ");
    }
    cli_write_arena(name, nl);

    cli_write_literal("@");
    cli_write_arena(version, vl);

    cli_write_literal(" ");
    cli_write_arena(checksum, 16);

    cli_write_literal("\n");
    raz_compiler_rt_arena_destroy(name);
    raz_compiler_rt_arena_destroy(version);
    raz_compiler_rt_arena_destroy(archive);
    raz_compiler_rt_arena_destroy(root);
    raz_compiler_rt_arena_destroy(checksum);
    raz_compiler_rt_arena_destroy(key_id);
    raz_compiler_rt_arena_destroy(signature);
    raz_compiler_rt_arena_destroy(local);
    return 0;
}
