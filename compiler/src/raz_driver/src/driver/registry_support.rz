namespace raz_driver::registry_support;

public import raz_driver::path;
import frontend::parser;
public fn registry_token(i64 data, i64 start, i64 end, i64 ordinal, i64&mut out_start, i64&mut out_length) -> bool {
    i64 cursor = start;
    i64 n = 0;

    while (cursor<end) {
        while (cursor<end && ascii_is_space(raz_compiler_rt_arena_get(data, cursor))) {
            cursor += 1;
        }
        if (cursor >= end) {
            break;
        }

        i64 ts = cursor;

        while (cursor<end && !ascii_is_space(raz_compiler_rt_arena_get(data, cursor))) {
            cursor += 1;
        }
        if (n == ordinal) {
            *out_start = ts;
            *out_length = cursor - ts;
            return true;
        }
        n += 1;
    }
    return false;
}

public fn registry_bytes_equal(i64 a, i64 as_, i64 al, i64 b, i64 bs, i64 bl) -> bool {
    if (al != bl) {
        return false;
    }

    i64 i = 0;

    while (i<al) {
        if (raz_compiler_rt_arena_get(a, as_ + i) != raz_compiler_rt_arena_get(b, bs + i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

