namespace raz_driver::registry_semver;

import frontend::parser;
fn registry_digit(i64 value) -> bool {
    return value >= 48 && value <= 57;
}

fn registry_parse_u64(i64 data, i64 start, i64 end, i64&mut cursor) -> i64 {
    if (*cursor >= end || !registry_digit(raz_compiler_rt_arena_get(data, *cursor))) {
        return -1;
    }

    i64 value = 0;

    while (*cursor < end && registry_digit(raz_compiler_rt_arena_get(data, *cursor))) {
        value = value * 10 + (raz_compiler_rt_arena_get(data, *cursor) - 48);
        *cursor += 1;
    }
    return value;
}

public fn registry_parse_semver(
    i64 data,
    i64 start,
    i64 length,
    i64&mut major,
    i64&mut minor,
    i64&mut patch,
) -> bool {
    i64 cursor = start;
    i64 end = start + length;

    *major = registry_parse_u64(data, start, end, &mut cursor);
    if (*major < 0 || cursor >= end || raz_compiler_rt_arena_get(data, cursor) != 46) {
        return false;
    }
    cursor += 1;
    *minor = registry_parse_u64(data, start, end, &mut cursor);
    if (*minor < 0 || cursor >= end || raz_compiler_rt_arena_get(data, cursor) != 46) {
        return false;
    }
    cursor += 1;
    *patch = registry_parse_u64(data, start, end, &mut cursor);
    if (*patch < 0) {
        return false;
    }
    // Prerelease/build suffixes are accepted but do not participate in this v1 ordering.
    return (
        cursor == end ||
        raz_compiler_rt_arena_get(data, cursor) == 45 ||
        raz_compiler_rt_arena_get(data, cursor) == 43
    );
}

public fn registry_semver_has_prerelease(i64 data, i64 start, i64 length) -> bool {
    i64 i = 0;

    while (i < length) {
        i64 ch = raz_compiler_rt_arena_get(data, start + i);

        if (ch == 45) {
            return true;
        }
        if (ch == 43) {
            return false;
        }
        i += 1;
    }
    return false;
}

public fn registry_semver_compare(i64 a0, i64 a1, i64 a2, i64 b0, i64 b1, i64 b2) -> i64 {
    if (a0<b0) {
        return -1;
    }
    if (a0> b0) {
        return 1;
    }
    if (a1<b1) {
        return -1;
    }
    if (a1> b1) {
        return 1;
    }
    if (a2<b2) {
        return -1;
    }
    if (a2> b2) {
        return 1;
    }
    return 0;
}

public fn registry_constraint_matches(
    i64 version,
    i64 version_start,
    i64 version_length,
    i64 constraint,
    i64 constraint_length,
) -> bool {
    i64 vm = 0;
    i64 vn = 0;
    i64 vp = 0;

    if (!registry_parse_semver(version, version_start, version_length, &mut vm, &mut vn, &mut vp)) {
        return false;
    }
    if (constraint_length <= 0) {
        return true;
    }

    i64 offset = 0;
    i64 mode = 0;
    i64 first = raz_compiler_rt_arena_get(constraint, 0);

    if (first == 94) {
        mode = 1;
        offset = 1;
    }
    // ^
    else if (first == 126) {
        mode = 2;
        offset = 1;
    }
    // ~
    else if (first == 62 && constraint_length > 1 && raz_compiler_rt_arena_get(constraint, 1) == 61) {
        mode = 3;
        offset = 2;
    }
    // >=

    i64 cm = 0;
    i64 cn = 0;
    i64 cp = 0;

    if (!registry_parse_semver(constraint, offset, constraint_length - offset, &mut cm, &mut cn, &mut cp)) {
        return false;
    }

    bool version_prerelease = registry_semver_has_prerelease(version, version_start, version_length);

    bool constraint_prerelease = registry_semver_has_prerelease(
        constraint,
        offset,
        constraint_length - offset,
    );
    if (version_prerelease && !constraint_prerelease) {
        return false;
    }

    i64 cmp = registry_semver_compare(vm, vn, vp, cm, cn, cp);

    if (mode == 0) {
        if (cmp != 0) {
            return false;
        }
        if (constraint_prerelease) {
            if (version_length != constraint_length - offset) {
                return false;
            }

            i64 exact_index = 0;

            while (exact_index < version_length) {
                if (
                    raz_compiler_rt_arena_get(
                        version,
                        version_start + exact_index,
                    ) != raz_compiler_rt_arena_get(constraint, offset + exact_index)
                ) {
                    return false;
                }
                exact_index += 1;
            }
        }
        return true;
    }
    if (mode == 3) {
        return cmp >= 0;
    }
    if (mode == 2) {
        return cmp >= 0 && vm == cm && vn == cn;
    }
    if (cmp<0) {
        return false;
    }
    if (cm> 0) {
        return vm == cm;
    }
    if (cn > 0) {
        return vm == 0 && vn == cn;
    }
    return vm == 0 && vn == 0 && vp == cp;
}

