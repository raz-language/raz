namespace raz_driver::incremental;

public import raz_driver::host_support;

// Persistent incremental-build state is deliberately conservative. Exact
// whole-source/backend matches may reuse a completed backend artifact. Module
// source/interface fingerprints are persisted independently so later frontend
// work can make HIR/MIR reuse module-granular without changing this format.
fn incremental_cache_schema() -> i64 {
    return 8;
}

fn incremental_semantic_epoch() -> i64 {
    return 1;
}

fn incremental_path_dirname(i64 path, i64 length, i64 output, i64 capacity) -> i64 {
    if (path == 0 || output == 0 || length <= 0 || capacity <= 0) {
        return -1;
    }

    i64 end = length;

    while (
        end > 0 &&
        raz_compiler_rt_arena_get(path, end - 1) != 47 &&
        raz_compiler_rt_arena_get(path, end - 1) != 92
    ) {
        end -= 1;
    }
    if (end == 0) {
        raz_compiler_rt_arena_set(output, 0, 46);
        return 1;
    }

    i64 count = end - 1;

    if (count <= 0) {
        count = 1;
    }
    if (count > capacity) {
        return -1;
    }

    i64 index = 0;

    while (index < count) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(path, index));
        index += 1;
    }
    return count;
}

fn incremental_append_ascii(i64 output, i64&mut cursor, i64 capacity, i64[]text, i64 length) -> bool {
    if (*cursor + length > capacity) {
        return false;
    }

    i64 index = 0;

    while (index < length) {
        raz_compiler_rt_arena_set(output, *cursor, text[index]);
        *cursor += 1;
        index += 1;
    }
    return true;
}

fn incremental_append_literal(i64 output, i64&mut cursor, i64 capacity, string text) -> bool {
    i64 length = compiler_literal_length(text);
    if (*cursor + length > capacity) { return false; }
    i64 index = 0;
    while (index < length) {
        raz_compiler_rt_arena_set(output, *cursor, compiler_literal_byte(text, index));
        *cursor += 1;
        index += 1;
    }
    return true;
}

public fn incremental_cache_path(
    i64 manifest_path,
    i64 manifest_length,
    i64 leaf_kind,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 cursor = incremental_path_dirname(manifest_path, manifest_length, output, capacity);

    if (cursor <= 0) {
        return -1;
    }

    if (!incremental_append_literal(output, &mut cursor, capacity, "/target/cache")) {
        return -1;
    }
    if (leaf_kind == 0) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/build.key")) {
            return -1;
        }
    } else if (leaf_kind == 1) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/artifact.bin")) {
            return -1;
        }
    } else if (leaf_kind == 2) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/modules.dbg")) {
            return -1;
        }
    } else if (leaf_kind == 3) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/mir.state")) {
            return -1;
        }
    } else if (leaf_kind == 4) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/check.key")) {
            return -1;
        }
    } else if (leaf_kind == 5) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/project.meta")) {
            return -1;
        }
    } else if (leaf_kind == 6) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/project.source")) {
            return -1;
        }
    } else if (leaf_kind == 7) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/artifact.semantic.key")) {
            return -1;
        }
    } else if (leaf_kind == 8) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/artifact.options.key")) {
            return -1;
        }
    } else if (leaf_kind == 9) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/packages.state")) {
            return -1;
        }
    } else if (leaf_kind == 10) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/frontend.state")) {
            return -1;
        }
    } else if (leaf_kind == 11) {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/mir.units")) {
            return -1;
        }
    } else {

    if (!incremental_append_literal(output, &mut cursor, capacity, "/artifact.integrity")) {
            return -1;
        }
    }
    return cursor;
}

fn incremental_cache_dir(i64 manifest_path, i64 manifest_length, i64 output, i64 capacity) -> i64 {
    i64 length = incremental_path_dirname(manifest_path, manifest_length, output, capacity);

    if (length <= 0) {
        return -1;
    }

    if (!incremental_append_literal(output, &mut length, capacity, "/target/cache")) {
        return -1;
    }
    return length;
}

fn incremental_mix(i64 value, i64 next) -> i64 {
    i64 mixed = (value * 131 + next + 4099) % 281474976710597;

    if (mixed < 0) {
        mixed = 0 - mixed;
    }
    return mixed;
}

fn incremental_artifact_options_key(
    i64 backend,
    i64 llvm_emit_kind,
    i64 backend_options_key,
    bool forge_native,
    bool forge_structured_only,
    bool release_profile,
) -> i64 {
    i64 key = incremental_cache_schema();

    key = incremental_mix(key, backend);
    key = incremental_mix(key, llvm_emit_kind);
    key = incremental_mix(key, backend_options_key);
    key = incremental_mix(key, raz_compiler_rt_host_platform());
    key = incremental_mix(key, raz_compiler_rt_host_arch());
    if (forge_native) { key = incremental_mix(key, 1); } else { key = incremental_mix(key, 0); }
    if (forge_structured_only) { key = incremental_mix(key, 1); } else { key = incremental_mix(key, 0); }
    if (release_profile) { key = incremental_mix(key, 1); } else { key = incremental_mix(key, 0); }
    return key;
}

fn incremental_semantic_source_hash(Source& source) -> i64 {
    if (source.bytes == 0 || source.length <= 0) { return 17; }
    i64 hash = 146959810393466;
    i64 cursor = 0;
    bool have_significant = false;
    bool pending_separator = false;

    while (cursor < source.length) {
        i64 byte = raz_compiler_rt_arena_get(source.bytes, cursor);
        bool spacing = byte == 32 || byte == 9 || byte == 10 || byte == 13;
        bool line_comment = byte == 47 && cursor + 1 < source.length &&
            raz_compiler_rt_arena_get(source.bytes, cursor + 1) == 47;
        bool block_comment = byte == 47 && cursor + 1 < source.length &&
            raz_compiler_rt_arena_get(source.bytes, cursor + 1) == 42;

        if (spacing || line_comment || block_comment) {
            pending_separator = have_significant;
            if (line_comment) {
                cursor += 2;
                while (cursor < source.length && raz_compiler_rt_arena_get(source.bytes, cursor) != 10) {
                    cursor += 1;
                }
            } else if (block_comment) {
                cursor += 2;
                i64 depth = 1;
                while (cursor < source.length && depth > 0) {
                    if (
                        cursor + 1 < source.length &&
                        raz_compiler_rt_arena_get(source.bytes, cursor) == 47 &&
                        raz_compiler_rt_arena_get(source.bytes, cursor + 1) == 42
                    ) {
                        depth += 1;
                        cursor += 2;
                    } else if (
                        cursor + 1 < source.length &&
                        raz_compiler_rt_arena_get(source.bytes, cursor) == 42 &&
                        raz_compiler_rt_arena_get(source.bytes, cursor + 1) == 47
                    ) {
                        depth -= 1;
                        cursor += 2;
                    } else {
                        cursor += 1;
                    }
                }
            } else {
                cursor += 1;
            }
            continue;
        }

        if (pending_separator && have_significant) {
            hash = incremental_mix(hash, 257);
            pending_separator = false;
        }

        // Quoted literals are copied byte-for-byte so comment-looking text and
        // whitespace inside strings/chars can never be normalized away.
        if (byte == 34 || byte == 39) {
            i64 quote = byte;
            bool escaped = false;
            while (cursor < source.length) {
                i64 literal_byte = raz_compiler_rt_arena_get(source.bytes, cursor);
                hash = incremental_mix(hash, literal_byte);
                cursor += 1;
                if (escaped) {
                    escaped = false;
                } else if (literal_byte == 92) {
                    escaped = true;
                } else if (literal_byte == quote && cursor > 1) {
                    break;
                }
            }
        } else {
            hash = incremental_mix(hash, byte);
            cursor += 1;
        }
        have_significant = true;
    }
    return hash;
}

fn incremental_build_key(
    Source& source,
    i64 backend,
    i64 llvm_emit_kind,
    i64 backend_options_key,
    bool forge_native,
    bool forge_structured_only,
    bool release_profile,
) -> i64 {
    i64 key = raz_compiler_rt_arena_range_hash(source.bytes, 0, source.length, 146959810393466);

    key = incremental_mix(key, incremental_cache_schema());
    key = incremental_mix(key, backend);
    key = incremental_mix(key, llvm_emit_kind);
    key = incremental_mix(key, backend_options_key);
    if (forge_native) {
        key = incremental_mix(key, 1);
    } else {
        key = incremental_mix(key, 0);
    }
    if (forge_structured_only) {
        key = incremental_mix(key, 1);
    } else {
        key = incremental_mix(key, 0);
    }
    // The profile selects the optimization level, so a debug artifact must not
    // satisfy a release build. Without this the first `raz build` populates the
    // cache and a later `raz build --release` silently ships that same
    // unoptimized image.
    if (release_profile) {
        key = incremental_mix(key, 1);
    } else {
        key = incremental_mix(key, 0);
    }
    return key;
}

fn incremental_check_key(Source& source) -> i64 {
    i64 key = raz_compiler_rt_arena_range_hash(source.bytes, 0, source.length, 146959810393466);

    key = incremental_mix(key, incremental_cache_schema());
    key = incremental_mix(key, incremental_semantic_epoch());
    key = incremental_mix(key, raz_compiler_rt_host_platform());
    key = incremental_mix(key, raz_compiler_rt_host_arch());
    return key;
}

fn incremental_try_restore_check(i64 manifest_path, i64 manifest_length, Source& source) -> bool {
    if (manifest_path == 0 || manifest_length <= 0) {
        return false;
    }

    i64 check_path = raz_compiler_rt_arena_create(8192);
    i64 check_data = raz_compiler_rt_arena_create(128);

    if (check_path == 0 || check_data == 0) {
        if (check_path != 0) {
            raz_compiler_rt_arena_destroy(check_path);
        }
        if (check_data != 0) {
            raz_compiler_rt_arena_destroy(check_data);
        }
        return false;
    }

    i64 check_length = incremental_cache_path(manifest_path, manifest_length, 4, check_path, 8192);
    bool restored = false;

    if (check_length > 0 && raz_compiler_rt_path_exists_ascii(check_path, check_length) != 0) {
        i64 read = raz_compiler_rt_read_ascii(check_path, check_length, check_data, 128);

        if (read > 0 && incremental_parse_decimal(check_data, read) == incremental_check_key(source)) {
            restored = true;
        }
    }
    raz_compiler_rt_arena_destroy(check_path);
    raz_compiler_rt_arena_destroy(check_data);
    return restored;
}

fn incremental_restore_kind(
    bool check_only,
    bool profile_queries,
    bool test_after_build,
    bool run_after_build,
    i64 manifest_path,
    i64 manifest_length,
    Source& source,
    i64 backend,
    i64 llvm_emit_kind,
    i64 backend_options_key,
    bool forge_native,
    bool forge_structured_only,
    bool release_profile,
    i64 output_path,
    i64 output_length,
) -> i64 {
    // `run` links the same artifact `build` does, so a cached one is just as
    // good; it is executed rather than interpreted once restored.
    if (
        !check_only &&
        !test_after_build &&
        output_path != 0 &&
        incremental_try_restore_artifact(
            manifest_path,
            manifest_length,
            source,
            backend,
            llvm_emit_kind,
            backend_options_key,
            forge_native,
            forge_structured_only,
            release_profile,
            output_path,
            output_length,
        )
    ) {
        return 1;
    }
    if (
        check_only &&
        !profile_queries &&
        !test_after_build &&
        !run_after_build &&
        incremental_try_restore_check(manifest_path, manifest_length, source)
    ) {
        return 2;
    }
    return 0;
}

fn incremental_store_check(i64 manifest_path, i64 manifest_length, Source& source) {
    if (manifest_path == 0 || manifest_length <= 0) {
        return;
    }

    i64 cache_dir = raz_compiler_rt_arena_create(8192);
    i64 check_path = raz_compiler_rt_arena_create(8192);

    if (cache_dir == 0 || check_path == 0) {
        if (cache_dir != 0) {
            raz_compiler_rt_arena_destroy(cache_dir);
        }
        if (check_path != 0) {
            raz_compiler_rt_arena_destroy(check_path);
        }
        return;
    }

    i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
    i64 check_length = incremental_cache_path(manifest_path, manifest_length, 4, check_path, 8192);

    if (
        cache_dir_length > 0 &&
        check_length > 0 &&
        raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) == 0
    ) {
        ForgeWriter writer;

        writer.capacity = 128;
        writer.data = raz_compiler_rt_arena_create(writer.capacity);
        writer.length = 0;
        writer.failed = writer.data == 0;
        if (!writer.failed) {
            writer_decimal(&mut writer, incremental_check_key(source));
            writer_newline(&mut writer);
            raz_compiler_rt_write_ascii(check_path, check_length, writer.data, writer.length);
        }
        writer_destroy(&mut writer);
    }
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(check_path);
}

fn incremental_project_context_key(
    i64 manifest_path,
    i64 manifest_path_length,
    i64 include_dev_dependencies,
    i64 platform,
    i64 include_all_features,
    i64 requested_features,
    i64 requested_features_length,
    i64 include_default_features,
) -> i64 {
    i64 key = incremental_cache_schema();

    if (manifest_path != 0 && manifest_path_length > 0) {
        // Cache snapshots may be copied together with target/.  A relative
        // manifest spelling such as `raz.toml` is identical in every working
        // directory, so hashing it directly lets a relocated project restore
        // project.source that still names the old absolute source files.  Bind
        // project snapshots to the normalized manifest location instead.
        i64 normalized_manifest = raz_compiler_rt_arena_create(8192);
        i64 normalized_length = -1;

        if (normalized_manifest != 0) {
            normalized_length = raz_compiler_rt_normalize_path(
                manifest_path,
                manifest_path_length,
                normalized_manifest,
                8192,
            );
        }
        if (normalized_length > 0) {
            key = incremental_mix(
                key,
                raz_compiler_rt_arena_range_hash(normalized_manifest, 0, normalized_length, 65537),
            );
        } else {
            key = incremental_mix(
                key,
                raz_compiler_rt_arena_range_hash(manifest_path, 0, manifest_path_length, 65537),
            );
        }
        if (normalized_manifest != 0) {
            raz_compiler_rt_arena_destroy(normalized_manifest);
        }
    }
    key = incremental_mix(key, include_dev_dependencies);
    key = incremental_mix(key, platform);
    key = incremental_mix(key, include_all_features);
    key = incremental_mix(key, include_default_features);
    if (requested_features != 0 && requested_features_length > 0) {
        key = incremental_mix(
            key,
            raz_compiler_rt_arena_range_hash(requested_features, 0, requested_features_length, 65537),
        );
    }
    return key;
}

fn incremental_metadata_tick(i64 metadata) -> i64 {
    i64 tick = raz_compiler_rt_arena_get(metadata, 6);

    if (tick < 0) {
        tick = 0 - tick;
    }
    return tick;
}

// Project snapshot validation must not trust metadata alone. Editors, archive
// extraction, source generators, and copy tools can preserve both file size and
// modification time while replacing the bytes. Hashing the recorded inputs is
// still substantially cheaper than reparsing/reassembling the full package graph
// and makes cache correctness independent of filesystem timestamp resolution.
public fn incremental_input_content_hash(i64 path, i64 path_length, i64 expected_size) -> i64 {
    if (path == 0 || path_length <= 0 || expected_size < 0) {
        return -1;
    }

    i64 capacity = expected_size + 1;
    if (capacity <= 0) {
        capacity = 1;
    }
    i64 data = raz_compiler_rt_arena_create_width(capacity, 1);
    if (data == 0) {
        return -1;
    }

    i64 read = raz_compiler_rt_read_ascii(path, path_length, data, expected_size);
    i64 hash = -1;
    if (read == expected_size) {
        hash = raz_compiler_rt_arena_range_hash(data, 0, read, 146959810393466);
        if (hash < 0) {
            hash = 0 - hash;
        }
    }
    raz_compiler_rt_arena_destroy(data);
    return hash;
}

fn incremental_project_validate_inputs(i64 data, i64 cursor, i64 length) -> bool {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 metadata = raz_compiler_rt_arena_create(7);

    if (path == 0 || metadata == 0) {
        if (path != 0) {
            raz_compiler_rt_arena_destroy(path);
        }
        if (metadata != 0) {
            raz_compiler_rt_arena_destroy(metadata);
        }
        return false;
    }
    while (cursor < length) {
        i64 line_end = cursor;

        while (
            line_end < length &&
            raz_compiler_rt_arena_get(data, line_end) != 10 &&
            raz_compiler_rt_arena_get(data, line_end) != 13
        ) {
            line_end += 1;
        }
        if (line_end <= cursor) {
            cursor += 1;
        } else {
            i64 field = cursor;
            i64 expected_size = incremental_state_next_decimal(data, &mut field, line_end);
            i64 expected_modified = incremental_state_next_decimal(data, &mut field, line_end);
            i64 expected_content = incremental_state_next_decimal(data, &mut field, line_end);

            while (field < line_end && raz_compiler_rt_arena_get(data, field) == 32) {
                field += 1;
            }

            i64 path_length = line_end - field;

            if (
                expected_size < 0 ||
                expected_modified < 0 ||
                expected_content < 0 ||
                path_length <= 0 ||
                path_length > 8192
            ) {
                raz_compiler_rt_arena_destroy(path);
                raz_compiler_rt_arena_destroy(metadata);
                return false;
            }

            i64 index = 0;

            while (index < path_length) {
                raz_compiler_rt_arena_set(path, index, raz_compiler_rt_arena_get(data, field + index));
                index += 1;
            }
            if (
                raz_compiler_rt_fs_metadata_ascii(path, path_length, metadata) == 0 ||
                raz_compiler_rt_arena_get(metadata, 5) == 0 ||
                raz_compiler_rt_arena_get(metadata, 1) != expected_size ||
                incremental_metadata_tick(metadata) != expected_modified ||
                incremental_input_content_hash(path, path_length, expected_size) != expected_content
            ) {
                raz_compiler_rt_arena_destroy(path);
                raz_compiler_rt_arena_destroy(metadata);
                return false;
            }
            cursor = line_end;
            while (
                cursor < length &&
                (
                    raz_compiler_rt_arena_get(data, cursor) == 10 ||
                    raz_compiler_rt_arena_get(data, cursor) == 13
                )
            ) {
                cursor += 1;
            }
        }
    }
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(metadata);
    return true;
}

fn incremental_try_restore_project(
    i64 manifest_path,
    i64 manifest_length,
    i64 context_key,
    i64 source,
    i64 source_capacity,
    i64&mut source_length,
    i64&mut module_count,
) -> bool {
    if (manifest_path == 0 || manifest_length <= 0 || source == 0 || source_capacity <= 0) {
        return false;
    }

    i64 meta_path = raz_compiler_rt_arena_create(8192);
    i64 source_path = raz_compiler_rt_arena_create(8192);
    i64 meta_data = raz_compiler_rt_arena_create(4194304);

    if (meta_path == 0 || source_path == 0 || meta_data == 0) {
        return false;
    }

    i64 meta_path_length = incremental_cache_path(manifest_path, manifest_length, 5, meta_path, 8192);
    i64 source_path_length = incremental_cache_path(manifest_path, manifest_length, 6, source_path, 8192);
    bool restored = false;

    if (
        meta_path_length > 0 &&
        source_path_length > 0 &&
        raz_compiler_rt_path_exists_ascii(meta_path, meta_path_length) != 0 &&
        raz_compiler_rt_path_exists_ascii(source_path, source_path_length) != 0
    ) {
        i64 meta_length = raz_compiler_rt_read_ascii(meta_path, meta_path_length, meta_data, 4194304);

        if (meta_length > 0) {
            i64 header_end = 0;

            while (
                header_end < meta_length &&
                raz_compiler_rt_arena_get(meta_data, header_end) != 10 &&
                raz_compiler_rt_arena_get(meta_data, header_end) != 13
            ) {
                header_end += 1;
            }

            i64 field = 0;
            i64 schema = incremental_state_next_decimal(meta_data, &mut field, header_end);
            i64 stored_context = incremental_state_next_decimal(meta_data, &mut field, header_end);
            i64 stored_modules = incremental_state_next_decimal(meta_data, &mut field, header_end);
            i64 stored_length = incremental_state_next_decimal(meta_data, &mut field, header_end);
            i64 inputs = header_end;

            while (
                inputs < meta_length &&
                (
                    raz_compiler_rt_arena_get(meta_data, inputs) == 10 ||
                    raz_compiler_rt_arena_get(meta_data, inputs) == 13
                )
            ) {
                inputs += 1;
            }
            if (
                schema == incremental_cache_schema() &&
                stored_context == context_key &&
                stored_modules > 0 &&
                stored_length > 0 &&
                stored_length < source_capacity &&
                incremental_project_validate_inputs(meta_data, inputs, meta_length)
            ) {
                i64 read = raz_compiler_rt_read_ascii(
                    source_path,
                    source_path_length,
                    source,
                    source_capacity,
                );
                if (read == stored_length) {
                    *source_length = read;
                    *module_count = stored_modules;
                    restored = true;
                }
            }
        }
    }
    raz_compiler_rt_arena_destroy(meta_path);
    raz_compiler_rt_arena_destroy(source_path);
    raz_compiler_rt_arena_destroy(meta_data);
    return restored;
}

fn incremental_store_project(
    i64 manifest_path,
    i64 manifest_length,
    i64 context_key,
    i64 source,
    i64 source_length,
    i64 module_count,
    i64 inputs,
    i64 inputs_length,
) {
    if (
        manifest_path == 0 ||
        manifest_length <= 0 ||
        source == 0 ||
        source_length <= 0 ||
        module_count <= 0 ||
        inputs == 0 ||
        inputs_length <= 0
    ) {
        return;
    }

    i64 cache_dir = raz_compiler_rt_arena_create(8192);
    i64 meta_path = raz_compiler_rt_arena_create(8192);
    i64 source_path = raz_compiler_rt_arena_create(8192);

    if (cache_dir == 0 || meta_path == 0 || source_path == 0) {
        return;
    }

    i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
    i64 meta_path_length = incremental_cache_path(manifest_path, manifest_length, 5, meta_path, 8192);
    i64 source_path_length = incremental_cache_path(manifest_path, manifest_length, 6, source_path, 8192);

    if (
        cache_dir_length > 0 &&
        meta_path_length > 0 &&
        source_path_length > 0 &&
        raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) == 0
    ) {
        ForgeWriter writer;

        writer.capacity = inputs_length + 256;
        writer.data = raz_compiler_rt_arena_create(writer.capacity);
        writer.length = 0;
        writer.failed = writer.data == 0;
        if (!writer.failed) {
            writer_decimal(&mut writer, incremental_cache_schema());
            writer_space(&mut writer);
            writer_decimal(&mut writer, context_key);
            writer_space(&mut writer);
            writer_decimal(&mut writer, module_count);
            writer_space(&mut writer);
            writer_decimal(&mut writer, source_length);
            writer_newline(&mut writer);
            if (
                !writer.failed &&
                raz_compiler_rt_arena_copy(
                    writer.data,
                    writer.length,
                    inputs,
                    0,
                    inputs_length,
                ) == inputs_length
            ) {
                writer.length += inputs_length;
                raz_compiler_rt_write_ascii(meta_path, meta_path_length, writer.data, writer.length);
                raz_compiler_rt_write_ascii(source_path, source_path_length, source, source_length);
            }
        }
        writer_destroy(&mut writer);
    }
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(meta_path);
    raz_compiler_rt_arena_destroy(source_path);
}

fn incremental_parse_decimal(i64 data, i64 length) -> i64 {
    if (data == 0 || length <= 0) {
        return -1;
    }

    i64 value = 0;
    i64 index = 0;

    while (index < length) {
        i64 byte = raz_compiler_rt_arena_get(data, index);

        if (byte == 10 || byte == 13 || byte == 32 || byte == 9) {
            index += 1;
        } else {
            if (byte < 48 || byte > 57) {
                return -1;
            }
            value = value * 10 + byte - 48;
            index += 1;
        }
    }
    return value;
}

fn incremental_artifact_integrity_matches(i64 manifest_path, i64 manifest_length, i64 artifact_path, i64 artifact_length) -> bool {
    i64 integrity_path = raz_compiler_rt_arena_create(8192);
    i64 integrity_data = raz_compiler_rt_arena_create(128);
    i64 metadata = raz_compiler_rt_arena_create(7);
    if (integrity_path == 0 || integrity_data == 0 || metadata == 0) { return false; }
    i64 integrity_length = incremental_cache_path(manifest_path, manifest_length, 12, integrity_path, 8192);
    i64 read = -1;
    if (integrity_length > 0) { read = raz_compiler_rt_read_ascii(integrity_path, integrity_length, integrity_data, 128); }
    bool valid = false;
    if (read > 0 && raz_compiler_rt_fs_metadata_ascii(artifact_path, artifact_length, metadata) != 0) {
        i64 cursor = 0;
        i64 expected_size = incremental_state_next_decimal(integrity_data, &mut cursor, read);
        i64 expected_hash = incremental_state_next_decimal(integrity_data, &mut cursor, read);
        if (expected_size >= 0 && expected_hash >= 0 && raz_compiler_rt_arena_get(metadata, 1) == expected_size) {
            valid = incremental_input_content_hash(artifact_path, artifact_length, expected_size) == expected_hash;
        }
    }
    raz_compiler_rt_arena_destroy(integrity_path);
    raz_compiler_rt_arena_destroy(integrity_data);
    raz_compiler_rt_arena_destroy(metadata);
    return valid;
}

fn incremental_try_restore_artifact(
    i64 manifest_path,
    i64 manifest_length,
    Source& source,
    i64 backend,
    i64 llvm_emit_kind,
    i64 backend_options_key,
    bool forge_native,
    bool forge_structured_only,
    bool release_profile,
    i64 output_path,
    i64 output_length,
) -> bool {
    if (manifest_path == 0 || manifest_length <= 0 || output_path == 0 || output_length <= 0) {
        return false;
    }

    i64 key_path = raz_compiler_rt_arena_create(8192);
    i64 artifact_path = raz_compiler_rt_arena_create(8192);
    i64 key_data = raz_compiler_rt_arena_create(128);
    i64 semantic_path = raz_compiler_rt_arena_create(8192);
    i64 options_path = raz_compiler_rt_arena_create(8192);

    if (key_path == 0 || artifact_path == 0 || key_data == 0 || semantic_path == 0 || options_path == 0) {
        return false;
    }

    i64 key_length = incremental_cache_path(manifest_path, manifest_length, 0, key_path, 8192);
    i64 artifact_length = incremental_cache_path(manifest_path, manifest_length, 1, artifact_path, 8192);
    i64 semantic_path_length = incremental_cache_path(manifest_path, manifest_length, 7, semantic_path, 8192);
    i64 options_path_length = incremental_cache_path(manifest_path, manifest_length, 8, options_path, 8192);
    bool restored = false;

    if (
        key_length > 0 &&
        artifact_length > 0 &&
        raz_compiler_rt_path_exists_ascii(artifact_path, artifact_length) != 0 &&
        incremental_artifact_integrity_matches(manifest_path, manifest_length, artifact_path, artifact_length)
    ) {
        i64 read = raz_compiler_rt_read_ascii(key_path, key_length, key_data, 128);

        if (
            read > 0 &&
            incremental_parse_decimal(
                key_data,
                read,
            ) == incremental_build_key(
                source,
                backend,
                llvm_emit_kind,
                backend_options_key,
                forge_native,
                forge_structured_only,
                release_profile,
            ) &&
            raz_compiler_rt_copy_file_ascii(artifact_path, artifact_length, output_path, output_length) > 0 &&
            raz_compiler_rt_path_exists_ascii(output_path, output_length) != 0
        ) {
            restored = true;
        }
    }
    // If only layout/comments changed, the normalized token stream is identical.
    // Reuse is still gated by backend/target/profile options and by the exact
    // artifact snapshot written together with the cached executable.
    if (
        !restored &&
        semantic_path_length > 0 &&
        options_path_length > 0 &&
        artifact_length > 0 &&
        raz_compiler_rt_path_exists_ascii(semantic_path, semantic_path_length) != 0 &&
        raz_compiler_rt_path_exists_ascii(options_path, options_path_length) != 0 &&
        raz_compiler_rt_path_exists_ascii(artifact_path, artifact_length) != 0 &&
        incremental_artifact_integrity_matches(manifest_path, manifest_length, artifact_path, artifact_length)
    ) {
        i64 options_read = raz_compiler_rt_read_ascii(options_path, options_path_length, key_data, 128);
        if (
            options_read > 0 &&
            incremental_parse_decimal(key_data, options_read) == incremental_artifact_options_key(
                backend,
                llvm_emit_kind,
                backend_options_key,
                forge_native,
                forge_structured_only,
                release_profile,
            )
        ) {
            i64 semantic_read = raz_compiler_rt_read_ascii(semantic_path, semantic_path_length, key_data, 128);
            i64 new_semantic_hash = incremental_semantic_source_hash(source);
            if (
                semantic_read > 0 &&
                incremental_parse_decimal(key_data, semantic_read) == new_semantic_hash &&
                raz_compiler_rt_copy_file_ascii(artifact_path, artifact_length, output_path, output_length) > 0 &&
                raz_compiler_rt_path_exists_ascii(output_path, output_length) != 0
            ) {
                restored = true;
            }
        }
    }
    raz_compiler_rt_arena_destroy(key_path);
    raz_compiler_rt_arena_destroy(artifact_path);
    raz_compiler_rt_arena_destroy(key_data);
    raz_compiler_rt_arena_destroy(semantic_path);
    raz_compiler_rt_arena_destroy(options_path);
    return restored;
}

fn incremental_store_artifact(
    i64 manifest_path,
    i64 manifest_length,
    Source& source,
    i64 backend,
    i64 llvm_emit_kind,
    i64 backend_options_key,
    bool forge_native,
    bool forge_structured_only,
    bool release_profile,
    i64 output_path,
    i64 output_length,
) {
    if (manifest_path == 0 || manifest_length <= 0 || output_path == 0 || output_length <= 0) {
        return;
    }

    i64 cache_dir = raz_compiler_rt_arena_create(8192);
    i64 key_path = raz_compiler_rt_arena_create(8192);
    i64 artifact_path = raz_compiler_rt_arena_create(8192);
    i64 semantic_path = raz_compiler_rt_arena_create(8192);
    i64 options_path = raz_compiler_rt_arena_create(8192);
    i64 integrity_path = raz_compiler_rt_arena_create(8192);
    i64 metadata = raz_compiler_rt_arena_create(7);

    if (cache_dir == 0 || key_path == 0 || artifact_path == 0 || semantic_path == 0 || options_path == 0 || integrity_path == 0 || metadata == 0) {
        return;
    }

    i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
    i64 key_length = incremental_cache_path(manifest_path, manifest_length, 0, key_path, 8192);
    i64 artifact_length = incremental_cache_path(manifest_path, manifest_length, 1, artifact_path, 8192);
    i64 semantic_path_length = incremental_cache_path(manifest_path, manifest_length, 7, semantic_path, 8192);
    i64 options_path_length = incremental_cache_path(manifest_path, manifest_length, 8, options_path, 8192);
    i64 integrity_path_length = incremental_cache_path(manifest_path, manifest_length, 12, integrity_path, 8192);

    if (
        cache_dir_length > 0 &&
        key_length > 0 &&
        artifact_length > 0 &&
        semantic_path_length > 0 &&
        options_path_length > 0 &&
        integrity_path_length > 0 &&
        raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) == 0 &&
        raz_compiler_rt_path_exists_ascii(output_path, output_length) != 0 &&
        raz_compiler_rt_copy_file_ascii(output_path, output_length, artifact_path, artifact_length) > 0 &&
        raz_compiler_rt_path_exists_ascii(artifact_path, artifact_length) != 0
    ) {
        ForgeWriter writer;

        writer.capacity = 128;
        writer.data = raz_compiler_rt_arena_create(writer.capacity);
        writer.length = 0;
        writer.failed = writer.data == 0;
        if (!writer.failed) {
            writer_decimal(
                &mut writer,
                incremental_build_key(
                    source,
                    backend,
                    llvm_emit_kind,
                    backend_options_key,
                    forge_native,
                    forge_structured_only,
                    release_profile,
                ),
            );
            writer_newline(&mut writer);
            raz_compiler_rt_write_ascii(key_path, key_length, writer.data, writer.length);
            writer.length = 0;
            writer.failed = false;
            writer_decimal(&mut writer, incremental_semantic_source_hash(source));
            writer_newline(&mut writer);
            raz_compiler_rt_write_ascii(semantic_path, semantic_path_length, writer.data, writer.length);
            writer.length = 0;
            writer.failed = false;
            writer_decimal(
                &mut writer,
                incremental_artifact_options_key(
                    backend,
                    llvm_emit_kind,
                    backend_options_key,
                    forge_native,
                    forge_structured_only,
                    release_profile,
                ),
            );
            writer_newline(&mut writer);
            raz_compiler_rt_write_ascii(options_path, options_path_length, writer.data, writer.length);
            if (raz_compiler_rt_fs_metadata_ascii(artifact_path, artifact_length, metadata) != 0) {
                i64 artifact_size = raz_compiler_rt_arena_get(metadata, 1);
                i64 artifact_hash = incremental_input_content_hash(artifact_path, artifact_length, artifact_size);
                writer.length = 0;
                writer.failed = false;
                writer_decimal(&mut writer, artifact_size);
                writer_space(&mut writer);
                writer_decimal(&mut writer, artifact_hash);
                writer_newline(&mut writer);
                raz_compiler_rt_write_ascii(integrity_path, integrity_path_length, writer.data, writer.length);
            }
        }
        writer_destroy(&mut writer);
    }
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(key_path);
    raz_compiler_rt_arena_destroy(artifact_path);
    raz_compiler_rt_arena_destroy(semantic_path);
    raz_compiler_rt_arena_destroy(options_path);
    raz_compiler_rt_arena_destroy(integrity_path);
    raz_compiler_rt_arena_destroy(metadata);
}

public fn incremental_state_next_decimal(i64 data, i64&mut cursor, i64 end) -> i64 {
    while (*cursor < end) {
        i64 byte = raz_compiler_rt_arena_get(data, *cursor);

        if (byte == 32 || byte == 9) {
            *cursor += 1;
        } else {
            break;
        }
    }
    if (*cursor >= end) {
        return -1;
    }

    i64 value = 0;
    bool found = false;

    while (*cursor < end) {
        i64 byte = raz_compiler_rt_arena_get(data, *cursor);

        if (byte < 48 || byte > 57) {
            break;
        }
        value = value * 10 + byte - 48;
        *cursor += 1;
        found = true;
    }
    if (!found) {
        return -1;
    }
    return value;
}


public fn incremental_package_name_hash(i64 name, i64 length) -> i64 {
    i64 hash = 17;
    i64 index = 0;
    while (name != 0 && index < length) {
        hash = incremental_mix(hash, raz_compiler_rt_arena_get(name, index));
        index += 1;
    }
    return hash;
}

fn incremental_package_source_hash(Source& source, i64 name, i64 name_length) -> i64 {
    if (source.bytes == 0 || name == 0 || name_length <= 0) { return -1; }
    string marker = "__raz_package ";
    i64 marker_length = compiler_literal_length(marker);
    i64 cursor = 0;
    i64 hash = 17;
    bool active = false;
    bool seen = false;
    while (cursor < source.length) {
        bool matches = cursor == 0 || raz_compiler_rt_arena_get(source.bytes, cursor - 1) == 10;
        i64 part = 0;
        while (matches && part < marker_length) {
            if (cursor + part >= source.length || raz_compiler_rt_arena_get(source.bytes, cursor + part) != compiler_literal_byte(marker, part)) { matches = false; }
            part += 1;
        }
        if (matches) {
            i64 start = cursor + marker_length;
            i64 end = start;
            while (end < source.length && raz_compiler_rt_arena_get(source.bytes, end) != 59 && raz_compiler_rt_arena_get(source.bytes, end) != 10) { end += 1; }
            active = end - start == name_length;
            part = 0;
            while (active && part < name_length) {
                if (raz_compiler_rt_arena_get(source.bytes, start + part) != raz_compiler_rt_arena_get(name, part)) { active = false; }
                part += 1;
            }
            if (active) { seen = true; }
            cursor = end;
        } else {
            if (active) { hash = incremental_mix(hash, raz_compiler_rt_arena_get(source.bytes, cursor)); }
            cursor += 1;
        }
    }
    if (!seen) { return -1; }
    return hash;
}

public fn incremental_package_is_fresh(i64 manifest_path, i64 manifest_length, Source& source, i64 name, i64 name_length) -> bool {
    i64 current = incremental_package_source_hash(source, name, name_length);
    if (current < 0 || manifest_path == 0 || manifest_length <= 0) { return false; }
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(262144);
    if (path == 0 || data == 0) { return false; }
    i64 path_length = incremental_cache_path(manifest_path, manifest_length, 9, path, 8192);
    i64 length = -1;
    if (path_length > 0) { length = raz_compiler_rt_read_ascii(path, path_length, data, 262144); }
    i64 wanted = incremental_package_name_hash(name, name_length);
    bool fresh = false;
    i64 cursor = 0;
    while (length > 0 && cursor < length && !fresh) {
        i64 end = cursor;
        while (end < length && raz_compiler_rt_arena_get(data, end) != 10) { end += 1; }
        i64 field = cursor;
        fresh = incremental_state_next_decimal(data, &mut field, end) == wanted && incremental_state_next_decimal(data, &mut field, end) == current;
        cursor = end + 1;
    }
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(data);
    return fresh;
}

public fn incremental_persist_package_state(i64 manifest_path, i64 manifest_length, Source& source) {
    if (manifest_path == 0 || manifest_length <= 0 || source.bytes == 0) { return; }
    i64 dir = raz_compiler_rt_arena_create(8192);
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 seen = raz_compiler_rt_arena_create(256);
    if (dir == 0 || path == 0 || seen == 0) { return; }
    i64 dir_length = incremental_cache_dir(manifest_path, manifest_length, dir, 8192);
    i64 path_length = incremental_cache_path(manifest_path, manifest_length, 9, path, 8192);
    if (dir_length <= 0 || path_length <= 0 || raz_compiler_rt_create_dir_ascii(dir, dir_length) != 0) { return; }
    ForgeWriter writer;
    writer.capacity = 262144;
    writer.data = raz_compiler_rt_arena_create(writer.capacity);
    writer.length = 0;
    writer.failed = writer.data == 0;
    string marker = "__raz_package ";
    i64 marker_length = compiler_literal_length(marker);
    i64 cursor = 0;
    i64 seen_count = 0;
    while (!writer.failed && cursor + marker_length < source.length) {
        bool matches = cursor == 0 || raz_compiler_rt_arena_get(source.bytes, cursor - 1) == 10;
        i64 part = 0;
        while (matches && part < marker_length) {
            if (raz_compiler_rt_arena_get(source.bytes, cursor + part) != compiler_literal_byte(marker, part)) { matches = false; }
            part += 1;
        }
        if (!matches) { cursor += 1; continue; }
        i64 start = cursor + marker_length;
        i64 end = start;
        while (end < source.length && raz_compiler_rt_arena_get(source.bytes, end) != 59 && raz_compiler_rt_arena_get(source.bytes, end) != 10) { end += 1; }
        i64 name_length = end - start;
        if (name_length > 0 && name_length < 4096) {
            i64 name = raz_compiler_rt_arena_create(name_length);
            if (name != 0) {
                part = 0;
                while (part < name_length) { raz_compiler_rt_arena_set(name, part, raz_compiler_rt_arena_get(source.bytes, start + part)); part += 1; }
                i64 name_hash = incremental_package_name_hash(name, name_length);
                bool duplicate = false;
                part = 0;
                while (part < seen_count) { if (raz_compiler_rt_arena_get(seen, part) == name_hash) { duplicate = true; } part += 1; }
                if (!duplicate && seen_count < 256) {
                    raz_compiler_rt_arena_set(seen, seen_count, name_hash);
                    seen_count += 1;
                    writer_decimal(&mut writer, name_hash);
                    writer_space(&mut writer);
                    writer_decimal(&mut writer, incremental_package_source_hash(source, name, name_length));
                    writer_newline(&mut writer);
                }
                raz_compiler_rt_arena_destroy(name);
            }
        }
        cursor = end + 1;
    }
    if (!writer.failed) { raz_compiler_rt_write_ascii(path, path_length, writer.data, writer.length); }
    writer_destroy(&mut writer);
    raz_compiler_rt_arena_destroy(dir);
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(seen);
}

fn incremental_init_check_hints(HirIncrementalCheckHints&mut hints) {
    hints.enabled = 0;
    hints.module_count = 0;
    hints.old_sources = 0;
    hints.old_interfaces = 0;
    hints.old_present = 0;
    hints.affected_modules = 0;
    hints.package_body_coherent = 0;
    hints.edge_owners = 0;
    hints.edge_targets = 0;
    hints.edge_count = 0;
}

fn incremental_destroy_check_hints(HirIncrementalCheckHints&mut hints) {
    if (hints.old_sources != 0) {
        raz_compiler_rt_arena_destroy(hints.old_sources);
    }
    if (hints.old_interfaces != 0) {
        raz_compiler_rt_arena_destroy(hints.old_interfaces);
    }
    if (hints.old_present != 0) {
        raz_compiler_rt_arena_destroy(hints.old_present);
    }
    if (hints.affected_modules != 0) {
        raz_compiler_rt_arena_destroy(hints.affected_modules);
    }
    if (hints.edge_owners != 0) {
        raz_compiler_rt_arena_destroy(hints.edge_owners);
    }
    if (hints.edge_targets != 0) {
        raz_compiler_rt_arena_destroy(hints.edge_targets);
    }
    incremental_init_check_hints(hints);
}

fn incremental_load_check_hints(
    i64 manifest_path,
    i64 manifest_length,
    HirIncrementalCheckHints&mut hints,
) -> bool {
    incremental_init_check_hints(hints);
    if (manifest_path == 0 || manifest_length <= 0) {
        return false;
    }
    hints.old_sources = raz_compiler_rt_arena_create(4097);
    hints.old_interfaces = raz_compiler_rt_arena_create(4097);
    hints.old_present = raz_compiler_rt_arena_create(4097);
    hints.affected_modules = raz_compiler_rt_arena_create(4097);
    hints.edge_owners = raz_compiler_rt_arena_create(16384);
    hints.edge_targets = raz_compiler_rt_arena_create(16384);
    if (
        hints.old_sources == 0 ||
        hints.old_interfaces == 0 ||
        hints.old_present == 0 ||
        hints.affected_modules == 0 ||
        hints.edge_owners == 0 ||
        hints.edge_targets == 0
    ) {
        incremental_destroy_check_hints(hints);
        return false;
    }

    i64 clear = 0;

    while (clear < 4097) {
        raz_compiler_rt_arena_set(hints.old_sources, clear, 0);
        raz_compiler_rt_arena_set(hints.old_interfaces, clear, 0);
        raz_compiler_rt_arena_set(hints.old_present, clear, 0);
        raz_compiler_rt_arena_set(hints.affected_modules, clear, 1);
        clear += 1;
    }

    i64 state_path = raz_compiler_rt_arena_create(8192);
    i64 state_data = raz_compiler_rt_arena_create(524288);

    if (state_path == 0 || state_data == 0) {
        if (state_path != 0) {
            raz_compiler_rt_arena_destroy(state_path);
        }
        if (state_data != 0) {
            raz_compiler_rt_arena_destroy(state_data);
        }
        incremental_destroy_check_hints(hints);
        return false;
    }

    // Pass 60 gives frontend semantic state its own durable artifact.  Older
    // workspaces may only have modules.dbg, so keep that as a one-generation
    // compatibility fallback while the new cache warms.
    i64 state_length = incremental_cache_path(manifest_path, manifest_length, 10, state_path, 8192);
    i64 read = -1;

    if (state_length > 0) {
        read = raz_compiler_rt_read_ascii(state_path, state_length, state_data, 524288);
    }
    if (read <= 0) {
        state_length = incremental_cache_path(manifest_path, manifest_length, 2, state_path, 8192);
        if (state_length > 0) {
            read = raz_compiler_rt_read_ascii(state_path, state_length, state_data, 524288);
        }
    }
    if (read <= 0) {
        raz_compiler_rt_arena_destroy(state_path);
        raz_compiler_rt_arena_destroy(state_data);
        incremental_destroy_check_hints(hints);
        return false;
    }

    i64 cursor = 0;
    i64 modules = 0;
    i64 edges = 0;

    while (cursor < read) {
        i64 start = cursor;

        while (cursor < read && raz_compiler_rt_arena_get(state_data, cursor) != 10) {
            cursor += 1;
        }

        i64 end = cursor;

        if (cursor < read) {
            cursor += 1;
        }
        if (end <= start) {
            continue;
        }

        i64 marker = raz_compiler_rt_arena_get(state_data, start);

        if (marker == 77 && start + 2 < end) {
            i64 field = start + 2;
            i64 module_id = incremental_state_next_decimal(state_data, &mut field, end);
            i64 source_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);
            i64 interface_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);

            if (module_id > 0 && module_id <= 4096 && source_fingerprint >= 0 && interface_fingerprint >= 0) {
                raz_compiler_rt_arena_set(hints.old_sources, module_id, source_fingerprint);
                raz_compiler_rt_arena_set(hints.old_interfaces, module_id, interface_fingerprint);
                raz_compiler_rt_arena_set(hints.old_present, module_id, 1);
                if (module_id > modules) {
                    modules = module_id;
                }
            }
        } else if (marker == 69 && start + 2 < end && edges < 16384) {
            i64 field = start + 2;
            i64 owner = incremental_state_next_decimal(state_data, &mut field, end);
            i64 target = incremental_state_next_decimal(state_data, &mut field, end);

            if (owner > 0 && owner <= 4096 && target > 0 && target <= 4096) {
                raz_compiler_rt_arena_set(hints.edge_owners, edges, owner);
                raz_compiler_rt_arena_set(hints.edge_targets, edges, target);
                edges += 1;
            }
        }
    }
    raz_compiler_rt_arena_destroy(state_path);
    raz_compiler_rt_arena_destroy(state_data);
    if (modules <= 0) {
        incremental_destroy_check_hints(hints);
        return false;
    }
    hints.module_count = modules;
    hints.edge_count = edges;
    hints.enabled = 1;
    return true;
}

fn incremental_classify_module_changes(i64 manifest_path, i64 manifest_length, HirModule&mut hir) {
    hir.incremental_dirty_module_count = 0;
    hir.incremental_interface_dirty_module_count = 0;
    hir.incremental_affected_module_count = 0;

    i64 index = 0;

    while (index < hir.incremental_module_fingerprint_count) {
        raz_compiler_rt_arena_set(hir.incremental_module_dirty_kinds, index, 2);
        index += 1;
    }
    if (manifest_path == 0 || manifest_length <= 0) {
        hir.incremental_dirty_module_count = hir.incremental_module_fingerprint_count;
        hir.incremental_interface_dirty_module_count = hir.incremental_module_fingerprint_count;
        hir.incremental_affected_module_count = hir.incremental_module_fingerprint_count;
        return;
    }

    i64 state_path = raz_compiler_rt_arena_create(8192);
    i64 state_data = raz_compiler_rt_arena_create(524288);
    i64 old_sources = raz_compiler_rt_arena_create(4096);
    i64 old_interfaces = raz_compiler_rt_arena_create(4096);
    i64 old_packages = raz_compiler_rt_arena_create(4096);
    i64 old_namespaces = raz_compiler_rt_arena_create(4096);
    i64 old_index_by_id = raz_compiler_rt_arena_create(4097);
    i64 affected = raz_compiler_rt_arena_create(4096);

    if (
        state_path == 0 ||
        state_data == 0 ||
        old_sources == 0 ||
        old_interfaces == 0 ||
        old_packages == 0 ||
        old_namespaces == 0 ||
        old_index_by_id == 0 ||
        affected == 0
    ) {
        hir.incremental_dirty_module_count = hir.incremental_module_fingerprint_count;
        hir.incremental_interface_dirty_module_count = hir.incremental_module_fingerprint_count;
        hir.incremental_affected_module_count = hir.incremental_module_fingerprint_count;
        return;
    }

    i64 state_length = incremental_cache_path(manifest_path, manifest_length, 2, state_path, 8192);
    i64 read = -1;

    if (state_length > 0) {
        read = raz_compiler_rt_read_ascii(state_path, state_length, state_data, 524288);
    }

    i64 old_count = 0;

    if (read > 0) {
        i64 cursor = 0;

        while (cursor < read) {
            i64 start = cursor;

            while (cursor < read && raz_compiler_rt_arena_get(state_data, cursor) != 10) {
                cursor += 1;
            }

            i64 end = cursor;

            if (cursor < read) {
                cursor += 1;
            }
            if (end > start && raz_compiler_rt_arena_get(state_data, start) == 77 && old_count < 4096) {
                i64 field = start + 1;
                i64 old_id = incremental_state_next_decimal(state_data, &mut field, end);
                i64 old_source = incremental_state_next_decimal(state_data, &mut field, end);
                i64 old_interface = incremental_state_next_decimal(state_data, &mut field, end);
                i64 old_package = incremental_state_next_decimal(state_data, &mut field, end);
                i64 old_namespace = incremental_state_next_decimal(state_data, &mut field, end);

                if (
                    old_id > 0 &&
                    old_id <= 4096 &&
                    old_source >= 0 &&
                    old_interface >= 0 &&
                    old_package >= 0 &&
                    old_namespace >= 0
                ) {
                    raz_compiler_rt_arena_set(old_sources, old_count, old_source);
                    raz_compiler_rt_arena_set(old_interfaces, old_count, old_interface);
                    raz_compiler_rt_arena_set(old_packages, old_count, old_package);
                    raz_compiler_rt_arena_set(old_namespaces, old_count, old_namespace);
                    raz_compiler_rt_arena_set(old_index_by_id, old_id, old_count + 1);
                    old_count += 1;
                }
            }
        }
    }
    // Dense module ids make classification O(modules), replacing a linear scan
    // of all previous modules for every current module.
    index = 0;
    while (index < hir.incremental_module_fingerprint_count) {
        i64 module_id = raz_compiler_rt_arena_get(hir.incremental_module_ids, index);
        i64 package_hash = raz_compiler_rt_arena_get(hir.incremental_module_package_hashes, index);
        i64 namespace_hash = raz_compiler_rt_arena_get(hir.incremental_module_namespace_hashes, index);
        i64 mapped = 0;

        if (module_id > 0 && module_id <= 4096) {
            mapped = raz_compiler_rt_arena_get(old_index_by_id, module_id);
        }

        i64 matched_index = mapped - 1;

        if (
            matched_index >= 0 &&
            (
                raz_compiler_rt_arena_get(old_packages, matched_index) != package_hash ||
                raz_compiler_rt_arena_get(old_namespaces, matched_index) != namespace_hash
            )
        ) {
            matched_index = -1;
        }

        i64 kind = 2;

        if (matched_index >= 0) {
            i64 source_fingerprint = raz_compiler_rt_arena_get(
                hir.incremental_module_source_fingerprints,
                index,
            );
            i64 interface_fingerprint = raz_compiler_rt_arena_get(
                hir.incremental_module_interface_fingerprints,
                index,
            );
            if (raz_compiler_rt_arena_get(old_sources, matched_index) == source_fingerprint) {
                kind = 0;
            } else if (raz_compiler_rt_arena_get(old_interfaces, matched_index) == interface_fingerprint) {
                kind = 1;
            }
        }
        raz_compiler_rt_arena_set(hir.incremental_module_dirty_kinds, index, kind);
        if (kind != 0) {
            hir.incremental_dirty_module_count += 1;
            raz_compiler_rt_arena_set(affected, index, 1);
        }
        if (kind == 2) {
            hir.incremental_interface_dirty_module_count += 1;
        }
        index += 1;
    }
    // Propagate API-impact through the reverse dependency graph to a fixed point.
    // Owner/target ids are dense, so no per-edge module searches are required.

    bool changed = true;

    while (changed) {
        changed = false;

        i64 edge = 0;

        while (edge < hir.incremental_module_dependency_count) {
            i64 owner_id = raz_compiler_rt_arena_get(hir.incremental_module_dependency_owners, edge);
            i64 target_id = raz_compiler_rt_arena_get(hir.incremental_module_dependency_targets, edge);
            i64 owner_index = owner_id - 1;
            i64 target_index = target_id - 1;

            if (
                owner_index >= 0 &&
                owner_index < hir.incremental_module_fingerprint_count &&
                target_index >= 0 &&
                target_index < hir.incremental_module_fingerprint_count &&
                raz_compiler_rt_arena_get(affected, target_index) != 0 &&
                (
                    raz_compiler_rt_arena_get(hir.incremental_module_dirty_kinds, target_index) == 2 ||
                    raz_compiler_rt_arena_get(hir.incremental_module_dirty_kinds, target_index) == 3
                ) &&
                raz_compiler_rt_arena_get(affected, owner_index) == 0
            ) {
                raz_compiler_rt_arena_set(affected, owner_index, 1);
                // 3 means source-clean but invalidated by an upstream API change.
                raz_compiler_rt_arena_set(hir.incremental_module_dirty_kinds, owner_index, 3);
                changed = true;
            }
            edge += 1;
        }
    }
    index = 0;
    while (index < hir.incremental_module_fingerprint_count) {
        if (raz_compiler_rt_arena_get(affected, index) != 0) {
            hir.incremental_affected_module_count += 1;
        }
        index += 1;
    }
    raz_compiler_rt_arena_destroy(state_path);
    raz_compiler_rt_arena_destroy(state_data);
    raz_compiler_rt_arena_destroy(old_sources);
    raz_compiler_rt_arena_destroy(old_interfaces);
    raz_compiler_rt_arena_destroy(old_packages);
    raz_compiler_rt_arena_destroy(old_namespaces);
    raz_compiler_rt_arena_destroy(old_index_by_id);
    raz_compiler_rt_arena_destroy(affected);
}

fn incremental_hir_module_fingerprint(HirModule& hir, i64 module_index) -> i64 {
    i64 fingerprint = 17;
    i64 start = raz_compiler_rt_arena_get(hir.incremental_module_function_starts, module_index);
    i64 count = raz_compiler_rt_arena_get(hir.incremental_module_function_counts, module_index);
    i64 cursor = 0;

    fingerprint = incremental_mix(fingerprint, count);
    while (cursor < count) {
        i64 function_index = raz_compiler_rt_arena_get(
            hir.incremental_module_function_indices,
            start + cursor,
        );
        fingerprint = incremental_mix(
            fingerprint,
            raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index),
        );
        fingerprint = incremental_mix(
            fingerprint,
            raz_compiler_rt_arena_get(hir.function_local_counts, function_index),
        );
        fingerprint = incremental_mix(
            fingerprint,
            raz_compiler_rt_arena_get(hir.function_statement_counts, function_index),
        );
        fingerprint = incremental_mix(
            fingerprint,
            raz_compiler_rt_arena_get(hir.function_return_types, function_index),
        );
        fingerprint = incremental_mix(
            fingerprint,
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index),
        );
        cursor += 1;
    }
    return fingerprint;
}

fn incremental_load_module_cache_state(i64 manifest_path, i64 manifest_length, HirModule&mut hir) {
    hir.incremental_module_cache_hit_count = 0;

    i64 index = 0;

    while (index < hir.incremental_module_fingerprint_count) {
        raz_compiler_rt_arena_set(
            hir.incremental_module_hir_fingerprints,
            index,
            incremental_hir_module_fingerprint(hir, index),
        );
        raz_compiler_rt_arena_set(hir.incremental_module_cached_mir_fingerprints, index, 0);
        raz_compiler_rt_arena_set(hir.incremental_module_cache_kinds, index, 0);
        index += 1;
    }
    if (manifest_path == 0 || manifest_length <= 0) {
        return;
    }

    i64 state_path = raz_compiler_rt_arena_create(8192);
    i64 state_data = raz_compiler_rt_arena_create(524288);

    if (state_path == 0 || state_data == 0) {
        return;
    }

    i64 state_length = incremental_cache_path(manifest_path, manifest_length, 3, state_path, 8192);
    i64 read = -1;

    if (state_length > 0) {
        read = raz_compiler_rt_read_ascii(state_path, state_length, state_data, 524288);
    }
    if (read > 0) {
        i64 cursor = 0;

        while (cursor < read) {
            i64 start = cursor;

            while (cursor < read && raz_compiler_rt_arena_get(state_data, cursor) != 10) {
                cursor += 1;
            }

            i64 end = cursor;

            if (cursor < read) {
                cursor += 1;
            }
            if (
                end > start &&
                raz_compiler_rt_arena_get(state_data, start) >= 48 &&
                raz_compiler_rt_arena_get(state_data, start) <= 57
            ) {
                i64 field = start;
                i64 module_id = incremental_state_next_decimal(state_data, &mut field, end);
                i64 source_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);
                i64 interface_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);
                i64 hir_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);
                i64 mir_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);

                if (
                    module_id >= 0 &&
                    source_fingerprint >= 0 &&
                    interface_fingerprint >= 0 &&
                    hir_fingerprint >= 0 &&
                    mir_fingerprint >= 0
                ) {
                    i64 module_index = 0;

                    while (
                        module_index < hir.incremental_module_fingerprint_count &&
                        raz_compiler_rt_arena_get(hir.incremental_module_ids, module_index) != module_id
                    ) {
                        module_index += 1;
                    }
                    if (
                        module_index < hir.incremental_module_fingerprint_count &&
                        raz_compiler_rt_arena_get(hir.incremental_module_dirty_kinds, module_index) == 0 &&
                        raz_compiler_rt_arena_get(
                            hir.incremental_module_source_fingerprints,
                            module_index,
                        ) == source_fingerprint &&
                        raz_compiler_rt_arena_get(
                            hir.incremental_module_interface_fingerprints,
                            module_index,
                        ) == interface_fingerprint &&
                        raz_compiler_rt_arena_get(
                            hir.incremental_module_hir_fingerprints,
                            module_index,
                        ) == hir_fingerprint
                    ) {
                        raz_compiler_rt_arena_set(
                            hir.incremental_module_cached_mir_fingerprints,
                            module_index,
                            mir_fingerprint,
                        );
                        raz_compiler_rt_arena_set(hir.incremental_module_cache_kinds, module_index, 1);
                        hir.incremental_module_cache_hit_count += 1;
                    }
                }
            }
        }
    }
    raz_compiler_rt_arena_destroy(state_path);
    raz_compiler_rt_arena_destroy(state_data);
}

fn incremental_persist_module_fingerprints(i64 manifest_path, i64 manifest_length, HirModule& hir) {
    if (manifest_path == 0 || manifest_length <= 0) {
        return;
    }

    i64 cache_dir = raz_compiler_rt_arena_create(8192);
    i64 state_path = raz_compiler_rt_arena_create(8192);

    if (cache_dir == 0 || state_path == 0) {
        return;
    }

    i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
    i64 state_length = incremental_cache_path(manifest_path, manifest_length, 10, state_path, 8192);

    if (
        cache_dir_length <= 0 ||
        state_length <= 0 ||
        raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) != 0
    ) {
        raz_compiler_rt_arena_destroy(cache_dir);
        raz_compiler_rt_arena_destroy(state_path);
        return;
    }

    ForgeWriter writer;

    writer.capacity = 524288;
    writer.data = raz_compiler_rt_arena_create(writer.capacity);
    writer.length = 0;
    writer.failed = writer.data == 0;
    if (!writer.failed) {
        

        writer_literal(&mut writer, "RAZINC 2\n");

        i64 index = 0;

        while (index < hir.incremental_module_fingerprint_count) {
            

            writer_literal(&mut writer, "M");
            writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_ids, index));
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_source_fingerprints, index),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_interface_fingerprints, index),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_package_hashes, index),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_namespace_hashes, index),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_function_starts, index),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_function_counts, index),
            );
            writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_dirty_kinds, index));
            writer_newline(&mut writer);
            index += 1;
        }

        i64 edge = 0;

        while (edge < hir.incremental_module_dependency_count) {
            

            writer_literal(&mut writer, "E");
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_dependency_owners, edge),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_dependency_targets, edge),
            );
            writer_newline(&mut writer);
            edge += 1;
        }
        raz_compiler_rt_write_ascii(state_path, state_length, writer.data, writer.length);

        // Keep modules.dbg during the transition because qualification/debug
        // tooling reads it directly.  frontend.state is the compiler-owned
        // semantic artifact used to skip clean function bodies on `raz check`.
        i64 legacy_length = incremental_cache_path(manifest_path, manifest_length, 2, state_path, 8192);
        if (legacy_length > 0) {
            raz_compiler_rt_write_ascii(state_path, legacy_length, writer.data, writer.length);
        }
    }
    writer_destroy(&mut writer);
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(state_path);
}

fn incremental_mir_module_fingerprint(MirModule& mir, i64 module_id) -> i64 {
    i64 fingerprint = 17;
    i64 function_index = 0;

    while (function_index < mir.function_count) {
        if (raz_compiler_rt_arena_get(mir.function_module_ids, function_index) == module_id) {
            i64 instruction = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);

            i64 end =
                instruction +
                raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
            fingerprint = incremental_mix(
                fingerprint,
                raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index),
            );
            fingerprint = incremental_mix(
                fingerprint,
                raz_compiler_rt_arena_get(mir.function_local_counts, function_index),
            );
            while (instruction < end) {
                fingerprint = incremental_mix(
                    fingerprint,
                    raz_compiler_rt_arena_get(mir.opcodes, instruction),
                );
                fingerprint = incremental_mix(
                    fingerprint,
                    raz_compiler_rt_arena_get(mir.op_types, instruction),
                );
                fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_a, instruction));
                fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_b, instruction));
                fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_c, instruction));
                fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_d, instruction));
                instruction += 1;
            }
        }
        function_index += 1;
    }
    return fingerprint;
}

fn incremental_persist_module_mir_state(
    i64 manifest_path,
    i64 manifest_length,
    HirModule& hir,
    MirModule& mir,
) {
    if (manifest_path == 0 || manifest_length <= 0) {
        return;
    }

    i64 cache_dir = raz_compiler_rt_arena_create(8192);
    i64 state_path = raz_compiler_rt_arena_create(8192);

    if (cache_dir == 0 || state_path == 0) {
        return;
    }

    i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
    i64 state_length = incremental_cache_path(manifest_path, manifest_length, 3, state_path, 8192);

    if (
        cache_dir_length <= 0 ||
        state_length <= 0 ||
        raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) != 0
    ) {
        raz_compiler_rt_arena_destroy(cache_dir);
        raz_compiler_rt_arena_destroy(state_path);
        return;
    }

    ForgeWriter writer;

    writer.capacity = 262144;
    writer.data = raz_compiler_rt_arena_create(writer.capacity);
    writer.length = 0;
    writer.failed = writer.data == 0;
    if (!writer.failed) {
        

        writer_literal(&mut writer, "RAZMIR 2\n");

        i64 index = 0;

        while (index < hir.incremental_module_fingerprint_count) {
            i64 module_id = raz_compiler_rt_arena_get(hir.incremental_module_ids, index);
            i64 mir_fingerprint = incremental_mir_module_fingerprint(mir, module_id);

            writer_decimal(&mut writer, module_id);
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_source_fingerprints, index),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_interface_fingerprints, index),
            );
            writer_space(&mut writer);
            writer_decimal(
                &mut writer,
                raz_compiler_rt_arena_get(hir.incremental_module_hir_fingerprints, index),
            );
            writer_space(&mut writer);
            writer_decimal(&mut writer, mir_fingerprint);
            writer_newline(&mut writer);
            index += 1;
        }
        raz_compiler_rt_write_ascii(state_path, state_length, writer.data, writer.length);
    }
    writer_destroy(&mut writer);
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(state_path);
}


// Persistent executable MIR image.  This deliberately records the canonical
// MIR lanes rather than backend-specific Forge/LLVM data so one cache format can
// serve every native backend.  Pass 61 writes and validates this image; later
// passes can restore clean module bodies from it once instruction relocation is
// proven for every opcode class.
fn incremental_persist_mir_units(
    i64 manifest_path,
    i64 manifest_length,
    HirModule& hir,
    MirModule& mir,
) {
    if (manifest_path == 0 || manifest_length <= 0) { return; }

    i64 cache_dir = raz_compiler_rt_arena_create(8192);
    i64 state_path = raz_compiler_rt_arena_create(8192);
    if (cache_dir == 0 || state_path == 0) {
        if (cache_dir != 0) { raz_compiler_rt_arena_destroy(cache_dir); }
        if (state_path != 0) { raz_compiler_rt_arena_destroy(state_path); }
        return;
    }
    i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
    i64 state_length = incremental_cache_path(manifest_path, manifest_length, 11, state_path, 8192);
    if (
        cache_dir_length <= 0 || state_length <= 0 ||
        raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) != 0
    ) {
        raz_compiler_rt_arena_destroy(cache_dir);
        raz_compiler_rt_arena_destroy(state_path);
        return;
    }

    ForgeWriter writer;
    writer.capacity = 8388608;
    writer.data = raz_compiler_rt_arena_create(writer.capacity);
    writer.length = 0;
    writer.failed = writer.data == 0;
    if (!writer.failed) {
        writer_literal(&mut writer, "RAZMIRUNITS 2\n");
        writer_literal(&mut writer, "S ");
        writer_decimal(&mut writer, incremental_cache_schema()); writer_space(&mut writer);
        writer_decimal(&mut writer, mir.function_count); writer_space(&mut writer);
        writer_decimal(&mut writer, mir.instruction_count); writer_space(&mut writer);
        writer_decimal(&mut writer, mir.global_count); writer_space(&mut writer);
        writer_decimal(&mut writer, mir.call_argument_count); writer_newline(&mut writer);

        writer_literal(&mut writer, "MC ");
        writer_decimal(&mut writer, hir.incremental_module_fingerprint_count); writer_newline(&mut writer);
        i64 module_index = 0;
        while (module_index < hir.incremental_module_fingerprint_count && !writer.failed) {
            i64 module_id = raz_compiler_rt_arena_get(hir.incremental_module_ids, module_index);
            writer_literal(&mut writer, "M ");
            writer_decimal(&mut writer, module_id); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_source_fingerprints, module_index)); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_interface_fingerprints, module_index)); writer_space(&mut writer);
            writer_decimal(&mut writer, incremental_mir_module_fingerprint(mir, module_id)); writer_newline(&mut writer);
            module_index += 1;
        }

        writer_literal(&mut writer, "GC ");
        writer_decimal(&mut writer, mir.global_count); writer_newline(&mut writer);
        i64 global_index = 0;
        while (global_index < mir.global_count && !writer.failed) {
            writer_literal(&mut writer, "G ");
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.global_values, global_index)); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.global_extern_flags, global_index)); writer_newline(&mut writer);
            global_index += 1;
        }

        writer_literal(&mut writer, "AC ");
        writer_decimal(&mut writer, mir.call_argument_count); writer_newline(&mut writer);
        i64 argument_index = 0;
        while (argument_index < mir.call_argument_count && !writer.failed) {
            writer_literal(&mut writer, "A ");
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.call_arguments, argument_index)); writer_newline(&mut writer);
            argument_index += 1;
        }

        writer_literal(&mut writer, "FC ");
        writer_decimal(&mut writer, mir.function_count); writer_newline(&mut writer);
        i64 function_index = 0;
        while (function_index < mir.function_count && !writer.failed) {
            i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
            i64 count = raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
            writer_literal(&mut writer, "F ");
            writer_decimal(&mut writer, function_index); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.function_module_ids, function_index)); writer_space(&mut writer);
            writer_decimal(&mut writer, count); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index)); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.function_local_counts, function_index)); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.function_is_extern, function_index)); writer_space(&mut writer);
            writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.function_extern_kinds, function_index)); writer_newline(&mut writer);

            i64 instruction = start;
            i64 end = start + count;
            while (instruction < end && !writer.failed) {
                writer_literal(&mut writer, "I ");
                writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.opcodes, instruction)); writer_space(&mut writer);
                writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.op_types, instruction)); writer_space(&mut writer);
                writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.op_a, instruction)); writer_space(&mut writer);
                writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.op_b, instruction)); writer_space(&mut writer);
                writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.op_c, instruction)); writer_space(&mut writer);
                writer_decimal(&mut writer, raz_compiler_rt_arena_get(mir.op_d, instruction)); writer_newline(&mut writer);
                instruction += 1;
            }
            function_index += 1;
        }
        if (!writer.failed) {
            raz_compiler_rt_write_ascii(state_path, state_length, writer.data, writer.length);
        }
    }
    writer_destroy(&mut writer);
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(state_path);
}
