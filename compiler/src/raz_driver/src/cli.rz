    i64 words[65] = [32760384526971472, 31069370053518112, 32123469327659876, 9042521604779637, 29683799421886496, 28560293087896684, 32123763065692274, 9118698554027637, 30787916450984560, 32777976875589642, 9042521604759584, 33336520180581408, 9117624493437541, 32481171756447090, 27987473197981556, 9018690145053044, 9121975517930016, 23116270440292384, 31369502581091957, 28549323661926701, 27987404411401326, 27987473197981544, 9018690145053044, 9042883695438880, 23397745417003040, 30506377083642228, 29674038404086124, 27393371835490660, 27991871400910970, 33607045888346725, 17562969016515616, 32758185635029024, 33607045892612197, 32211432139477536, 9018694254815855, 9042883611879712, 20582995649896480, 29674038191483246, 27393371762877818, 28545999541641338, 30508287112410211, 9042521609888101, 31364004351844384, 29117685486871926, 32138863060153445, 31069038246328929, 28266697867796580, 28826396480577583, 9042428513510241, 9042521610284390, 31320826206756896, 27393372085906802, 27991871400910970, 32481138620899429, 32760384660792367, 9018689993667183, 9042522734027808, 20020045696475168, 28556934527676005, 31354135058140448, 9087808293596791, 32200436905897828, 9059078955363695, 32772479205076835, 658035];

