fn cli_print_command_suggestion(i64 value, i64 length) {
    if (value == 0 || length <= 0 || length >= 32) {
        return;
    }

    i64 best_kind = 0;
    i64 best_distance = 99;
    i64 distance = 99;
    string candidate_1 = "help";

    distance = cli_edit_distance_literal(value, length, candidate_1);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 1;
    }

    string candidate_2 = "version";

    distance = cli_edit_distance_literal(value, length, candidate_2);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 2;
    }

    string candidate_3 = "build";

    distance = cli_edit_distance_literal(value, length, candidate_3);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 3;
    }

    string candidate_4 = "check";

    distance = cli_edit_distance_literal(value, length, candidate_4);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 4;
    }

    string candidate_5 = "forge";

    distance = cli_edit_distance_literal(value, length, candidate_5);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 5;
    }

    string candidate_6 = "llvm";

    distance = cli_edit_distance_literal(value, length, candidate_6);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 6;
    }

    string candidate_7 = "backends";

    distance = cli_edit_distance_literal(value, length, candidate_7);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 7;
    }

    string candidate_8 = "targets";

    distance = cli_edit_distance_literal(value, length, candidate_8);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 8;
    }

    string candidate_9 = "doctor";

    distance = cli_edit_distance_literal(value, length, candidate_9);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 9;
    }

    string candidate_10 = "emit";

    distance = cli_edit_distance_literal(value, length, candidate_10);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 10;
    }

    string candidate_11 = "profile";

    distance = cli_edit_distance_literal(value, length, candidate_11);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 11;
    }

    string candidate_12 = "run";

    distance = cli_edit_distance_literal(value, length, candidate_12);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 12;
    }

    string candidate_13 = "clean";

    distance = cli_edit_distance_literal(value, length, candidate_13);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 13;
    }

    string candidate_14 = "init";

    distance = cli_edit_distance_literal(value, length, candidate_14);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 14;
    }

    string candidate_15 = "new";

    distance = cli_edit_distance_literal(value, length, candidate_15);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 15;
    }

    string candidate_16 = "test";

    distance = cli_edit_distance_literal(value, length, candidate_16);
    if (distance < best_distance) {
        best_distance = distance;
