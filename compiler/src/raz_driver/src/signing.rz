namespace raz_driver::signing;

public import raz_driver::package_support;

// Ed25519 package signing and trust policy. Cryptographic primitives are a
// permanent OpenSSL-backed runtime boundary; key policy and metadata stay in Raz.
fn raz_compiler_rt_ed25519_keygen_ascii(
    i64 private_key,
    i64 private_capacity,
    i64 public_key,
    i64 public_capacity,
) -> i64 {
    if (private_capacity < 32 || public_capacity < 32) {
        return -1;
    }

    usize private_bytes = raz_rt_alloc_aligned(32, 8);
    usize public_bytes = raz_rt_alloc_aligned(32, 8);

    if (private_bytes == 0 || public_bytes == 0) {
        if (private_bytes != 0) {
            raz_rt_dealloc_aligned(private_bytes, 8);
        }
        if (public_bytes != 0) {
            raz_rt_dealloc_aligned(public_bytes, 8);
        }
        return -1;
    }

    i64 result = raz_rt_ed25519_keygen(private_bytes, 32, public_bytes, 32);

    if (result == 32) {
        if (
            !compiler_ascii_unpack(private_key, 0, private_bytes, 32) ||
            !compiler_ascii_unpack(public_key, 0, public_bytes, 32)
        ) {
            result = -1;
        }
    }
    raz_rt_dealloc_aligned(private_bytes, 8);
    raz_rt_dealloc_aligned(public_bytes, 8);
    return result;
}

fn raz_compiler_rt_ed25519_public_ascii(
    i64 private_key,
    i64 private_length,
    i64 public_key,
    i64 public_capacity,
) -> i64 {
    if (private_length != 32 || public_capacity < 32) {
        return -1;
    }

    usize private_bytes = compiler_ascii_pack(private_key, 0, private_length);
    usize public_bytes = raz_rt_alloc_aligned(32, 8);

    if (private_bytes == 0 || public_bytes == 0) {
        if (private_bytes != 0) {
            raz_rt_dealloc_aligned(private_bytes, 8);
        }
        if (public_bytes != 0) {
            raz_rt_dealloc_aligned(public_bytes, 8);
        }
        return -1;
    }

    i64 result = raz_rt_ed25519_public(private_bytes, private_length, public_bytes, 32);

    if (result == 32 && !compiler_ascii_unpack(public_key, 0, public_bytes, 32)) {
        result = -1;
    }
    raz_rt_dealloc_aligned(private_bytes, 8);
    raz_rt_dealloc_aligned(public_bytes, 8);
    return result;
}

fn raz_compiler_rt_ed25519_sign_ascii(
    i64 private_key,
    i64 private_length,
    i64 message,
    i64 message_length,
    i64 signature,
    i64 signature_capacity,
) -> i64 {
    if (private_length != 32 || message_length < 0 || signature_capacity < 64) {
        return -1;
    }

    usize private_bytes = compiler_ascii_pack(private_key, 0, private_length);
    usize message_bytes = compiler_ascii_pack(message, 0, message_length);
    usize signature_bytes = raz_rt_alloc_aligned(64, 8);

    if (private_bytes == 0 || message_bytes == 0 || signature_bytes == 0) {
        if (private_bytes != 0) {
            raz_rt_dealloc_aligned(private_bytes, 8);
        }
        if (message_bytes != 0) {
            raz_rt_dealloc_aligned(message_bytes, 8);
        }
        if (signature_bytes != 0) {
            raz_rt_dealloc_aligned(signature_bytes, 8);
        }
        return -1;
    }
    i64 result = raz_rt_ed25519_sign(
        private_bytes,
        private_length,
        message_bytes,
        message_length,
        signature_bytes,
        64,
    );
    if (result == 64 && !compiler_ascii_unpack(signature, 0, signature_bytes, 64)) {
        result = -1;
    }
    raz_rt_dealloc_aligned(private_bytes, 8);
    raz_rt_dealloc_aligned(message_bytes, 8);
    raz_rt_dealloc_aligned(signature_bytes, 8);
    return result;
}

fn raz_compiler_rt_ed25519_verify_ascii(
    i64 public_key,
    i64 public_length,
    i64 message,
    i64 message_length,
    i64 signature,
    i64 signature_length,
) -> i64 {
    if (public_length != 32 || signature_length != 64 || message_length < 0) {
        return -1;
    }

    usize public_bytes = compiler_ascii_pack(public_key, 0, public_length);
    usize message_bytes = compiler_ascii_pack(message, 0, message_length);
    usize signature_bytes = compiler_ascii_pack(signature, 0, signature_length);

    if (public_bytes == 0 || message_bytes == 0 || signature_bytes == 0) {
        if (public_bytes != 0) {
            raz_rt_dealloc_aligned(public_bytes, 8);
        }
        if (message_bytes != 0) {
            raz_rt_dealloc_aligned(message_bytes, 8);
        }
        if (signature_bytes != 0) {
            raz_rt_dealloc_aligned(signature_bytes, 8);
        }
        return -1;
    }
    i64 result = raz_rt_ed25519_verify(
        public_bytes,
        public_length,
        message_bytes,
        message_length,
        signature_bytes,
        signature_length,
    );
    raz_rt_dealloc_aligned(public_bytes, 8);
    raz_rt_dealloc_aligned(message_bytes, 8);
    raz_rt_dealloc_aligned(signature_bytes, 8);
    return result;
}

fn signing_hex_digit(i64 value) -> i64 {
    if (value < 10) {
        return 48 + value;
    }
    return 87 + value;
}

fn signing_hex_value(i64 value) -> i64 {
    if (value >= 48 && value <= 57) {
        return value - 48;
    }
    if (value >= 97 && value <= 102) {
        return value - 87;
    }
    if (value >= 65 && value <= 70) {
        return value - 55;
    }
    return -1;
}

fn signing_encode_hex(i64 input, i64 length, i64 output, i64 capacity) -> i64 {
    if (input == 0 || output == 0 || length < 0 || length * 2 > capacity) {
        return -1;
    }

    i64 i = 0;

    while (i < length) {
        i64 value = raz_compiler_rt_arena_get(input, i) & 255;

        raz_compiler_rt_arena_set(output, i * 2, signing_hex_digit((value >> 4) & 15));
        raz_compiler_rt_arena_set(output, i * 2 + 1, signing_hex_digit(value & 15));
        i += 1;
    }
    return length * 2;
}

fn signing_decode_hex(i64 input, i64 length, i64 output, i64 capacity) -> i64 {
    if (input == 0 || output == 0 || length <= 0 || (length & 1) != 0 || length / 2 > capacity) {
        return -1;
    }

    i64 i = 0;

    while (i < length) {
        i64 high = signing_hex_value(raz_compiler_rt_arena_get(input, i));
        i64 low = signing_hex_value(raz_compiler_rt_arena_get(input, i + 1));

        if (high < 0 || low < 0) {
            return -1;
        }
        raz_compiler_rt_arena_set(output, i / 2, high * 16 + low);
        i += 2;
    }
    return length / 2;
}

fn signing_env(string key, i64 output, i64 capacity) -> i64 {
    i64 key_length = compiler_literal_length(key);
    i64 name = raz_compiler_rt_arena_create(key_length);

    if (name == 0) {
        return -1;
    }

    i64 i = 0;

    while (i < key_length) {
        raz_compiler_rt_arena_set(name, i, compiler_literal_byte(key, i));
        i += 1;
    }

    i64 length = raz_compiler_rt_env_get_ascii(name, key_length, output, capacity);

    raz_compiler_rt_arena_destroy(name);
    return length;
}

fn signing_key_id(i64 public_key, i64 public_length, i64 output, i64 capacity) -> i64 {
    if (public_length != 32 || capacity < 16) {
        return -1;
    }

    i64 hash = 1469598103934665603;
    i64 prime = 1099511628211;
    i64 i = 0;

    while (i < public_length) {
        hash = (hash ^ (raz_compiler_rt_arena_get(public_key, i) & 255)) * prime;
        i += 1;
    }

    i64 shift = 60;

    i = 0;
    while (shift >= 0) {
        raz_compiler_rt_arena_set(output, i, signing_hex_digit((hash >> shift) & 15));
        i += 1;
        shift -= 4;
    }
    return 16;
}

fn signing_metadata_message(
    i64 name,
    i64 nl,
    i64 version,
    i64 vl,
    i64 checksum,
    i64 cl,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 needed = nl + vl + cl + 3;

    if (needed > capacity) {
        return -1;
    }

    i64 cursor = 0;
    i64 i = 0;

    while (i<nl) {
        raz_compiler_rt_arena_set(output, cursor, raz_compiler_rt_arena_get(name, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(output, cursor, 10);
    cursor += 1;
    i = 0;
    while (i<vl) {
        raz_compiler_rt_arena_set(output, cursor, raz_compiler_rt_arena_get(version, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(output, cursor, 10);
    cursor += 1;
    i = 0;
    while (i<cl) {
        raz_compiler_rt_arena_set(output, cursor, raz_compiler_rt_arena_get(checksum, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(output, cursor, 10);
    cursor += 1;
    return cursor;
}

fn signing_load_private(i64 output, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 text = raz_compiler_rt_arena_create(256);

    if (path == 0 || text == 0) {
        return -1;
    }
    i64 pl = signing_env("RAZ_SIGNING_KEY", path, 8192);

    if (pl <= 0) {
        raz_compiler_rt_arena_destroy(path);
        raz_compiler_rt_arena_destroy(text);
        return 0;
    }

    i64 tl = raz_compiler_rt_read_ascii(path, pl, text, 256);

    raz_compiler_rt_arena_destroy(path);
    if (tl <= 0) {
        raz_compiler_rt_arena_destroy(text);
        return -1;
    }
    while (
        tl> 0 &&
        (
            raz_compiler_rt_arena_get(text, tl - 1) == 10 ||
            raz_compiler_rt_arena_get(text, tl - 1) == 13 ||
            raz_compiler_rt_arena_get(text, tl - 1) == 32
        )
    ) {
        tl -= 1;
    }

    i64 result = signing_decode_hex(text, tl, output, capacity);

    raz_compiler_rt_arena_destroy(text);
    if (result != 32) {
        return -1;
    }
    return result;
}

fn signing_sign_metadata(
    i64 name,
    i64 nl,
    i64 version,
    i64 vl,
    i64 checksum,
    i64 cl,
    i64 key_id,
    i64 key_id_capacity,
    i64 signature_hex,
    i64 signature_capacity,
) -> i64 {
    i64 private_key = raz_compiler_rt_arena_create(32);
    i64 public_key = raz_compiler_rt_arena_create(32);
    i64 message = raz_compiler_rt_arena_create(16384);
    i64 signature = raz_compiler_rt_arena_create(64);

    if (private_key == 0 || public_key == 0 || message == 0 || signature == 0) {
        return -1;
    }

    i64 loaded = signing_load_private(private_key, 32);

    if (loaded == 0) {
        return 0;
    }
    if (loaded != 32) {
        return -1;
    }
    if (raz_compiler_rt_ed25519_public_ascii(private_key, 32, public_key, 32) != 32) {
        return -1;
    }

    i64 ml = signing_metadata_message(name, nl, version, vl, checksum, cl, message, 16384);

    if (ml <= 0) {
        return -1;
    }
    if (raz_compiler_rt_ed25519_sign_ascii(private_key, 32, message, ml, signature, 64) != 64) {
        return -1;
    }

    i64 kid = signing_key_id(public_key, 32, key_id, key_id_capacity);
    i64 sl = signing_encode_hex(signature, 64, signature_hex, signature_capacity);

    raz_compiler_rt_arena_destroy(private_key);
    raz_compiler_rt_arena_destroy(public_key);
    raz_compiler_rt_arena_destroy(message);
    raz_compiler_rt_arena_destroy(signature);
    if (kid != 16 || sl != 128) {
        return -1;
    }
    return 1;
}

fn signing_find_trusted_key(i64 key_id, i64 key_id_length, i64 public_key, i64 public_capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || data == 0) {
        return -1;
    }
    i64 pl = signing_env("RAZ_TRUSTED_KEYS", path, 8192);

    if (pl <= 0) {
        return 0;
    }

    i64 dl = raz_compiler_rt_read_ascii(path, pl, data, 1048576);

    if (dl <= 0) {
        return 0;
    }

    i64 pos = 0;

    while (pos<dl) {
        i64 st = pos;

        while (
            pos<dl &&
            raz_compiler_rt_arena_get(data, pos) != 10 &&
            raz_compiler_rt_arena_get(data, pos) != 13
        ) {
            pos += 1;
        }

        i64 en = pos;

        while (
            pos<dl &&
            (raz_compiler_rt_arena_get(data, pos) == 10 || raz_compiler_rt_arena_get(data, pos) == 13)
        ) {
            pos += 1;
        }
        if (en <= st) {
            continue;
        }

        i64 sep = st;

        while (
            sep<en &&
            raz_compiler_rt_arena_get(data, sep) != 32 &&
            raz_compiler_rt_arena_get(data, sep) != 9
        ) {
            sep += 1;
        }
        if (sep - st != key_id_length) {
            continue;
        }

        bool same = true;
        i64 i = 0;

        while (i<key_id_length) {
            if (raz_compiler_rt_arena_get(data, st + i) != raz_compiler_rt_arena_get(key_id, i)) {
                same = false;
            }
            i += 1;
        }
        if (!same) {
            continue;
        }
        while (
            sep<en &&
            (raz_compiler_rt_arena_get(data, sep) == 32 || raz_compiler_rt_arena_get(data, sep) == 9)
        ) {
            sep += 1;
        }

        i64 hex_length = en - sep;

        if (hex_length != 64) {
            return -1;
        }

        i64 hex = raz_compiler_rt_arena_create(64);

        if (hex == 0) {
            return -1;
        }

        i64 j = 0;

        while (j<hex_length) {
            raz_compiler_rt_arena_set(hex, j, raz_compiler_rt_arena_get(data, sep + j));
            j += 1;
        }

        i64 decoded = signing_decode_hex(hex, hex_length, public_key, public_capacity);

        raz_compiler_rt_arena_destroy(hex);
        raz_compiler_rt_arena_destroy(path);
        raz_compiler_rt_arena_destroy(data);
        if (decoded == 32) {
            return 32;
        }
        return -1;
    }
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(data);
    return 0;
}

fn signing_require_signatures() -> bool {
    i64 value = raz_compiler_rt_arena_create(16);

    if (value == 0) {
        return false;
    }
    i64 len = signing_env("RAZ_REQUIRE_SIGNATURES", value, 16);
    bool result = false;

    if (len> 0) {
        i64 c = raz_compiler_rt_arena_get(value, 0);

        result = c == 49 || c == 116 || c == 84 || c == 121 || c == 89;
    }
    raz_compiler_rt_arena_destroy(value);
    return result;
}

fn signing_verify_metadata(
    i64 name,
    i64 nl,
    i64 version,
    i64 vl,
    i64 checksum,
    i64 cl,
    i64 key_id,
    i64 kidl,
    i64 signature_hex,
    i64 sl,
) -> i64 {
    if (kidl <= 0 || sl <= 0) {
        if (signing_require_signatures()) {
            return 0;
        }
        return 1;
    }
    if (kidl != 16 || sl != 128) {
        return 0;
    }

    i64 public_key = raz_compiler_rt_arena_create(32);
    i64 signature = raz_compiler_rt_arena_create(64);
    i64 message = raz_compiler_rt_arena_create(16384);

    if (public_key == 0 || signature == 0 || message == 0) {
        return -1;
    }

    i64 trusted = signing_find_trusted_key(key_id, kidl, public_key, 32);

    if (trusted != 32) {
        return 0;
    }
    if (signing_decode_hex(signature_hex, sl, signature, 64) != 64) {
        return 0;
    }

    i64 ml = signing_metadata_message(name, nl, version, vl, checksum, cl, message, 16384);

    if (ml <= 0) {
        return -1;
    }

    i64 verified = raz_compiler_rt_ed25519_verify_ascii(public_key, 32, message, ml, signature, 64);

    raz_compiler_rt_arena_destroy(public_key);
    raz_compiler_rt_arena_destroy(signature);
    raz_compiler_rt_arena_destroy(message);
    if (verified == 1) {
        return 1;
    }
    return 0;
}

fn signing_keygen_command(i64 argc) -> i64 {
    if (argc> 3) {
        return 55;
    }

    i64 prefix = raz_compiler_rt_arena_create(4096);
    i64 private_path = raz_compiler_rt_arena_create(8192);
    i64 public_path = raz_compiler_rt_arena_create(8192);
    i64 private_key = raz_compiler_rt_arena_create(32);
    i64 public_key = raz_compiler_rt_arena_create(32);
    i64 private_hex = raz_compiler_rt_arena_create(65);
    i64 public_hex = raz_compiler_rt_arena_create(65);

    if (
        prefix == 0 ||
        private_path == 0 ||
        public_path == 0 ||
        private_key == 0 ||
        public_key == 0 ||
        private_hex == 0 ||
        public_hex == 0
    ) {
        return 40;
    }

    i64 pl = 0;

    if (argc == 3) {
        pl = raz_compiler_rt_process_arg(2, prefix, 4096);
    } else {
        string d = "raz";
        i64 i = 0;

        while (i<3) {
            raz_compiler_rt_arena_set(prefix, i, compiler_literal_byte(d, i));
            i += 1;
        }
        pl = 3;
    }

    i64 i = 0;

    while (i<pl) {
        raz_compiler_rt_arena_set(private_path, i, raz_compiler_rt_arena_get(prefix, i));
        raz_compiler_rt_arena_set(public_path, i, raz_compiler_rt_arena_get(prefix, i));
        i += 1;
    }

    string priv_tail = ".private.key";

    i = 0;
    while (i<12) {
        raz_compiler_rt_arena_set(private_path, pl + i, compiler_literal_byte(priv_tail, i));
        i += 1;
    }

    string pub_tail = ".public.key";

    i = 0;
    while (i<11) {
        raz_compiler_rt_arena_set(public_path, pl + i, compiler_literal_byte(pub_tail, i));
        i += 1;
    }
    if (raz_compiler_rt_ed25519_keygen_ascii(private_key, 32, public_key, 32) != 32) {
        return 69;
    }
    signing_encode_hex(private_key, 32, private_hex, 65);
    signing_encode_hex(public_key, 32, public_hex, 65);
    raz_compiler_rt_arena_set(private_hex, 64, 10);
    raz_compiler_rt_arena_set(public_hex, 64, 10);
    if (
        raz_compiler_rt_write_ascii(private_path, pl + 12, private_hex, 65) != 65 ||
        raz_compiler_rt_write_ascii(public_path, pl + 11, public_hex, 65) != 65
    ) {
        return 65;
    }

    cli_write_literal("Generated Ed25519 ");
    cli_write_arena(public_path, pl + 11);

    cli_write_literal("\n");
    return 0;
}
