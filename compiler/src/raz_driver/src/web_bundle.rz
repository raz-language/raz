namespace raz_driver::web_bundle;

public import raz_driver::path;

extern fn raz_rt_hash_bytes(usize data, i64 length) -> i64;

fn web_bundle_hex_digit(i64 value) -> i64 {
    if (value < 10) { return 48 + value; }
    return 87 + value;
}

/// Deterministic 64-bit content fingerprint rendered as 16 lowercase hex bytes.
/// The name is intentionally independent of timestamps, absolute paths, and
/// build-machine state so identical web inputs produce identical asset names.
public fn web_bundle_fingerprint(i64 data, i64 length, i64 output, i64 capacity) -> i64 {
    if (data == 0 || length < 0 || output == 0 || capacity < 16) { return 0; }
    i64 hash = raz_rt_hash_bytes(data, length);
    i64 i = 0;
    while (i < 16) {
        i64 shift = (15 - i) * 4;
        i64 nibble = (hash >> shift) & 15;
        raz_compiler_rt_arena_set(output, i, web_bundle_hex_digit(nibble));
        i += 1;
    }
    return 16;
}

/// Build `stem.<fingerprint>.<extension>` into output.
public fn web_bundle_asset_name(i64 stem, i64 stem_length, i64 content, i64 content_length, i64 extension, i64 extension_length, i64 destination, i64 capacity) -> i64 {
    if (stem == 0 || stem_length <= 0 || extension == 0 || extension_length <= 0 || destination == 0) { return 0; }
    if (capacity < stem_length + extension_length + 18) { return 0; }
    i64 fingerprint = raz_compiler_rt_arena_create(16);
    if (fingerprint == 0) { return 0; }
    i64 fp = web_bundle_fingerprint(content, content_length, fingerprint, 16);
    if (fp != 16) { raz_compiler_rt_arena_destroy(fingerprint); return 0; }
    i64 cursor = 0;
    i64 i = 0;
    while (i < stem_length) { raz_compiler_rt_arena_set(destination, cursor, raz_compiler_rt_arena_get(stem, i)); cursor += 1; i += 1; }
    raz_compiler_rt_arena_set(destination, cursor, 46); cursor += 1;
    i = 0;
    while (i < 16) { raz_compiler_rt_arena_set(destination, cursor, raz_compiler_rt_arena_get(fingerprint, i)); cursor += 1; i += 1; }
    raz_compiler_rt_arena_set(destination, cursor, 46); cursor += 1;
    i = 0;
    while (i < extension_length) { raz_compiler_rt_arena_set(destination, cursor, raz_compiler_rt_arena_get(extension, i)); cursor += 1; i += 1; }
    raz_compiler_rt_arena_destroy(fingerprint);
    return cursor;
}

/// Conservative CSS whitespace compactor for generated release CSS. It only
/// removes redundant ASCII whitespace outside strings/comments-sensitive
/// regions; author CSS remains semantically CSS rather than a compiler DSL.
public fn web_bundle_minify_css(i64 input, i64 length, i64 output, i64 capacity) -> i64 {
    if (input == 0 || length < 0 || output == 0 || capacity <= 0) { return 0; }
    i64 i = 0; i64 o = 0; bool space = false; i64 quote = 0;
    while (i < length) {
        i64 c = raz_compiler_rt_arena_get(input, i);
        if (quote != 0) {
            if (o >= capacity) { return 0; }
            raz_compiler_rt_arena_set(output, o, c); o += 1;
            if (c == quote && (i == 0 || raz_compiler_rt_arena_get(input, i - 1) != 92)) { quote = 0; }
            i += 1; continue;
        }
        if (c == 34 || c == 39) {
            if (space && o > 0 && o < capacity) { raz_compiler_rt_arena_set(output, o, 32); o += 1; }
            space = false; quote = c;
            if (o >= capacity) { return 0; }
            raz_compiler_rt_arena_set(output, o, c); o += 1; i += 1; continue;
        }
        if (c == 32 || c == 9 || c == 10 || c == 13) { space = true; i += 1; continue; }
        bool tight = c == 123 || c == 125 || c == 58 || c == 59 || c == 44 || c == 62;
        if (space && !tight && o > 0) {
            i64 prev = raz_compiler_rt_arena_get(output, o - 1);
            bool prev_tight = prev == 123 || prev == 125 || prev == 58 || prev == 59 || prev == 44 || prev == 62;
            if (!prev_tight) { if (o >= capacity) { return 0; } raz_compiler_rt_arena_set(output, o, 32); o += 1; }
        }
        space = false;
        if (o >= capacity) { return 0; }
        raz_compiler_rt_arena_set(output, o, c); o += 1; i += 1;
    }
    return o;
}

// Production finalization is deliberately a driver concern. Web generators
// write predictable canonical names first; release bundling fingerprints those
// bytes afterward and rewrites references without changing page/component APIs.

fn web_bundle_byte_eq(i64 data, i64 offset, string literal) -> bool {
    i64 length = compiler_literal_length(literal);
    i64 i = 0;
    while (i < length) {
        if (raz_compiler_rt_arena_get(data, offset + i) != compiler_literal_byte(literal, i)) { return false; }
        i += 1;
    }
    return true;
}

fn web_bundle_replace_literal(
    i64 input,
    i64 input_length,
    string needle,
    i64 replacement,
    i64 replacement_length,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 needle_length = compiler_literal_length(needle);
    if (input == 0 || input_length < 0 || needle_length <= 0 || output == 0 || capacity <= 0) { return -1; }
    i64 i = 0;
    i64 o = 0;
    while (i < input_length) {
        bool matches = i + needle_length <= input_length && web_bundle_byte_eq(input, i, needle);
        if (matches) {
            if (o + replacement_length > capacity) { return -1; }
            i64 r = 0;
            while (r < replacement_length) {
                raz_compiler_rt_arena_set(output, o, raz_compiler_rt_arena_get(replacement, r));
                o += 1;
                r += 1;
            }
            i += needle_length;
        } else {
            if (o >= capacity) { return -1; }
            raz_compiler_rt_arena_set(output, o, raz_compiler_rt_arena_get(input, i));
            o += 1;
            i += 1;
        }
    }
    return o;
}

fn web_bundle_make_literal(i64 output, i64 capacity, string value) -> i64 {
    i64 length = compiler_literal_length(value);
    if (output == 0 || length > capacity) { return -1; }
    i64 i = 0;
    while (i < length) {
        raz_compiler_rt_arena_set(output, i, compiler_literal_byte(value, i));
        i += 1;
    }
    return length;
}

fn web_bundle_write_fingerprinted(
    i64 original_path,
    i64 original_length,
    i64 destination_directory,
    i64 destination_directory_length,
    string stem,
    string extension,
    bool minify_css,
    i64 hashed_name,
    i64 hashed_name_capacity,
) -> i64 {
    if (raz_compiler_rt_path_exists_ascii(original_path, original_length) == 0) { return 0; }
    i64 data = raz_compiler_rt_arena_create_width(16777216, 1);
    i64 transformed = raz_compiler_rt_arena_create_width(16777216, 1);
    i64 destination = raz_compiler_rt_arena_create(8192);
    i64 directory = raz_compiler_rt_arena_create(8192);
    i64 stem_bytes = raz_compiler_rt_arena_create(64);
    i64 extension_bytes = raz_compiler_rt_arena_create(16);
    if (data == 0 || transformed == 0 || destination == 0 || directory == 0 || stem_bytes == 0 || extension_bytes == 0) { return -1; }
    i64 length = raz_compiler_rt_read_ascii(original_path, original_length, data, 16777216);
    i64 content = data;
    i64 content_length = length;
    if (length >= 0 && minify_css) {
        content_length = web_bundle_minify_css(data, length, transformed, 16777216);
        content = transformed;
    }
    i64 stem_length = web_bundle_make_literal(stem_bytes, 64, stem);
    i64 extension_length = web_bundle_make_literal(extension_bytes, 16, extension);
    i64 name_length = 0;
    if (content_length >= 0 && stem_length > 0 && extension_length > 0) {
        name_length = web_bundle_asset_name(
            stem_bytes, stem_length, content, content_length,
            extension_bytes, extension_length,
            hashed_name, hashed_name_capacity,
        );
    }
    i64 destination_length = -1;
    if (name_length > 0 && destination_directory != 0 && destination_directory_length > 0) {
        destination_length = path_join(destination_directory, destination_directory_length, hashed_name, name_length, destination, 8192);
    }
    bool ok = destination_length > 0 && raz_compiler_rt_write_ascii(destination, destination_length, content, content_length) == content_length;
    raz_compiler_rt_arena_destroy(data);
    raz_compiler_rt_arena_destroy(transformed);
    raz_compiler_rt_arena_destroy(destination);
    raz_compiler_rt_arena_destroy(directory);
    raz_compiler_rt_arena_destroy(stem_bytes);
    raz_compiler_rt_arena_destroy(extension_bytes);
    if (!ok) { return -1; }
    return name_length;
}
fn web_bundle_rewrite_file(i64 path, i64 path_length, string needle, i64 replacement, i64 replacement_length) -> bool {
    if (raz_compiler_rt_path_exists_ascii(path, path_length) == 0) { return true; }
    i64 input = raz_compiler_rt_arena_create_width(16777216, 1);
    i64 output = raz_compiler_rt_arena_create_width(16777216, 1);
    if (input == 0 || output == 0) { return false; }
    i64 length = raz_compiler_rt_read_ascii(path, path_length, input, 16777216);
    i64 rewritten = -1;
    if (length >= 0) {
        rewritten = web_bundle_replace_literal(input, length, needle, replacement, replacement_length, output, 16777216);
    }
    bool ok = rewritten >= 0;
    if (ok && rewritten != length) { ok = raz_compiler_rt_write_ascii(path, path_length, output, rewritten) == rewritten; }
    raz_compiler_rt_arena_destroy(input);
    raz_compiler_rt_arena_destroy(output);
    return ok;
}



fn web_bundle_line_has_suffix(i64 data, i64 start, i64 length, string suffix) -> bool {
    i64 suffix_length = compiler_literal_length(suffix);
    if (length < suffix_length) { return false; }
    i64 i = 0;
    while (i < suffix_length) {
        if (raz_compiler_rt_arena_get(data, start + length - suffix_length + i) != compiler_literal_byte(suffix, i)) { return false; }
        i += 1;
    }
    return true;
}

fn web_bundle_replace_bytes(
    i64 input,
    i64 input_length,
    i64 needle,
    i64 needle_length,
    i64 replacement,
    i64 replacement_length,
    i64 output,
    i64 capacity,
) -> i64 {
    if (input == 0 || input_length < 0 || needle == 0 || needle_length <= 0 || output == 0 || capacity <= 0) { return -1; }
    i64 i = 0;
    i64 o = 0;
    while (i < input_length) {
        bool matches = i + needle_length <= input_length;
        i64 n = 0;
        while (matches && n < needle_length) {
            if (raz_compiler_rt_arena_get(input, i + n) != raz_compiler_rt_arena_get(needle, n)) { matches = false; }
            n += 1;
        }
        if (matches) {
            if (o + replacement_length > capacity) { return -1; }
            n = 0;
            while (n < replacement_length) {
                raz_compiler_rt_arena_set(output, o, raz_compiler_rt_arena_get(replacement, n));
                o += 1;
                n += 1;
            }
            i += needle_length;
        } else {
            if (o >= capacity) { return -1; }
            raz_compiler_rt_arena_set(output, o, raz_compiler_rt_arena_get(input, i));
            o += 1;
            i += 1;
        }
    }
    return o;
}

fn web_bundle_rewrite_file_bytes(i64 path, i64 path_length, i64 needle, i64 needle_length, i64 replacement, i64 replacement_length) -> bool {
    if (raz_compiler_rt_path_exists_ascii(path, path_length) == 0) { return true; }
    i64 input = raz_compiler_rt_arena_create_width(16777216, 1);
    i64 output = raz_compiler_rt_arena_create_width(16777216, 1);
    if (input == 0 || output == 0) { return false; }
    i64 length = raz_compiler_rt_read_ascii(path, path_length, input, 16777216);
    i64 rewritten = -1;
    if (length >= 0) {
        rewritten = web_bundle_replace_bytes(input, length, needle, needle_length, replacement, replacement_length, output, 16777216);
    }
    bool ok = rewritten >= 0;
    if (ok && rewritten != length) { ok = raz_compiler_rt_write_ascii(path, path_length, output, rewritten) == rewritten; }
    raz_compiler_rt_arena_destroy(input);
    raz_compiler_rt_arena_destroy(output);
    return ok;
}

fn web_bundle_line_has_prefix(i64 data, i64 start, i64 length, string prefix) -> bool {
    i64 prefix_length = compiler_literal_length(prefix);
    if (length < prefix_length) { return false; }
    i64 i = 0;
    while (i < prefix_length) {
        if (raz_compiler_rt_arena_get(data, start + i) != compiler_literal_byte(prefix, i)) { return false; }
        i += 1;
    }
    return true;
}

fn web_bundle_line_is_text_asset(i64 data, i64 start, i64 length) -> bool {
    return web_bundle_line_has_suffix(data, start, length, ".css") ||
        web_bundle_line_has_suffix(data, start, length, ".js") ||
        web_bundle_line_has_suffix(data, start, length, ".mjs");
}

fn web_bundle_asset_parts(i64 relative, i64 relative_length, i64 stem, i64 stem_capacity, i64 extension, i64 extension_capacity, i64&mut stem_length, i64&mut extension_length) -> bool {
    i64 slash = -1;
    i64 dot = -1;
    i64 i = 0;
    while (i < relative_length) {
        i64 c = raz_compiler_rt_arena_get(relative, i);
        if (c == 47 || c == 92) { slash = i; dot = -1; }
        else if (c == 46) { dot = i; }
        i += 1;
    }
    if (dot <= slash + 1 || dot >= relative_length - 1) { return false; }
    *stem_length = dot - slash - 1;
    *extension_length = relative_length - dot - 1;
    if (*stem_length <= 0 || *extension_length <= 0 || *stem_length > stem_capacity || *extension_length > extension_capacity) { return false; }
    i = 0;
    while (i < *stem_length) { raz_compiler_rt_arena_set(stem, i, raz_compiler_rt_arena_get(relative, slash + 1 + i)); i += 1; }
    i = 0;
    while (i < *extension_length) { raz_compiler_rt_arena_set(extension, i, raz_compiler_rt_arena_get(relative, dot + 1 + i)); i += 1; }
    return true;
}

fn web_bundle_write_public_asset(
    i64 full,
    i64 full_length,
    i64 relative,
    i64 relative_length,
    bool minify_css,
    i64 hashed_name,
    i64 hashed_capacity,
) -> i64 {
    i64 data = raz_compiler_rt_arena_create_width(16777216, 1);
    i64 transformed = raz_compiler_rt_arena_create_width(16777216, 1);
    i64 directory = raz_compiler_rt_arena_create(8192);
    i64 destination = raz_compiler_rt_arena_create(8192);
    i64 stem = raz_compiler_rt_arena_create(512);
    i64 extension = raz_compiler_rt_arena_create(128);
    if (data == 0 || transformed == 0 || directory == 0 || destination == 0 || stem == 0 || extension == 0) { return -1; }
    i64 length = raz_compiler_rt_read_ascii(full, full_length, data, 16777216);
    i64 content = data;
    i64 content_length = length;
    if (length >= 0 && minify_css) { content_length = web_bundle_minify_css(data, length, transformed, 16777216); content = transformed; }
    i64 stem_length = 0;
    i64 extension_length = 0;
    bool parts = web_bundle_asset_parts(relative, relative_length, stem, 512, extension, 128, &mut stem_length, &mut extension_length);
    i64 name_length = 0;
    if (parts && content_length >= 0) { name_length = web_bundle_asset_name(stem, stem_length, content, content_length, extension, extension_length, hashed_name, hashed_capacity); }
    i64 dl = path_dirname(full, full_length, directory, 8192);
    i64 destination_length = -1;
    if (name_length > 0) { destination_length = path_join(directory, dl, hashed_name, name_length, destination, 8192); }
    bool ok = destination_length > 0 && raz_compiler_rt_write_ascii(destination, destination_length, content, content_length) == content_length;
    raz_compiler_rt_arena_destroy(data); raz_compiler_rt_arena_destroy(transformed); raz_compiler_rt_arena_destroy(directory);
    raz_compiler_rt_arena_destroy(destination); raz_compiler_rt_arena_destroy(stem); raz_compiler_rt_arena_destroy(extension);
    if (!ok) { return -1; }
    return name_length;
}

fn web_bundle_public_asset_replacement(i64 relative, i64 relative_length, i64 hashed_name, i64 hashed_length, i64 output, i64 capacity) -> i64 {
    i64 slash = -1;
    i64 i = 0;
    while (i < relative_length) { i64 c = raz_compiler_rt_arena_get(relative, i); if (c == 47 || c == 92) { slash = i; } i += 1; }
    if (slash < 0 || slash + 1 + hashed_length > capacity) { return -1; }
    i = 0;
    while (i <= slash) { raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(relative, i)); i += 1; }
    i64 cursor = slash + 1;
    i = 0;
    while (i < hashed_length) { raz_compiler_rt_arena_set(output, cursor, raz_compiler_rt_arena_get(hashed_name, i)); cursor += 1; i += 1; }
    return cursor;
}

fn web_bundle_rewrite_text_tree(i64 dist, i64 dist_length, i64 files, i64 files_length, i64 needle, i64 needle_length, i64 replacement, i64 replacement_length) -> bool {
    i64 relative = raz_compiler_rt_arena_create(8192);
    i64 full = raz_compiler_rt_arena_create(8192);
    if (relative == 0 || full == 0) { return false; }
    i64 line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        bool text = web_bundle_line_has_suffix(files, line_start, line_length, ".html") || web_bundle_line_has_suffix(files, line_start, line_length, ".css") || web_bundle_line_has_suffix(files, line_start, line_length, ".js") || web_bundle_line_has_suffix(files, line_start, line_length, ".mjs");
        if (text) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            if (fl <= 0 || !web_bundle_rewrite_file_bytes(full, fl, needle, needle_length, replacement, replacement_length)) { return false; }
        }
        line_start = line_end + 1;
    }
    raz_compiler_rt_arena_destroy(relative); raz_compiler_rt_arena_destroy(full);
    return true;
}


fn web_bundle_append_manifest_entry(
    i64 output, i64 capacity, i64 cursor,
    i64 logical, i64 logical_length,
    i64 hashed, i64 hashed_length,
) -> i64 {
    if (cursor + logical_length + hashed_length + 8 > capacity) { return -1; }
    raz_compiler_rt_arena_set(output, cursor, 34); cursor += 1;
    i64 i = 0;
    while (i < logical_length) { raz_compiler_rt_arena_set(output, cursor, raz_compiler_rt_arena_get(logical, i)); cursor += 1; i += 1; }
    raz_compiler_rt_arena_set(output, cursor, 34); cursor += 1;
    raz_compiler_rt_arena_set(output, cursor, 58); cursor += 1;
    raz_compiler_rt_arena_set(output, cursor, 34); cursor += 1;
    i = 0;
    while (i < hashed_length) { raz_compiler_rt_arena_set(output, cursor, raz_compiler_rt_arena_get(hashed, i)); cursor += 1; i += 1; }
    raz_compiler_rt_arena_set(output, cursor, 34); cursor += 1;
    return cursor;
}


/// Analyze the finalized deployable tree. Filesystem walking/stat/report
/// formatting is host support; the compiler decides when analysis is valid.
public fn web_bundle_analyze_dist(i64 dist, i64 dist_length, i64 manifest_path, i64 manifest_length) -> bool {
    return raz_compiler_rt_web_bundle_analyze_ascii(dist, dist_length, manifest_path, manifest_length) == 0;
}

/// Finalize a generated `dist/` tree for release delivery. The operation is
/// deterministic and idempotent for freshly generated output: canonical assets
/// become content-addressed, references are rewritten, and asset-manifest.json
/// is sorted by the already-deterministic recursive file listing.
public fn web_bundle_finalize_dist(i64 dist, i64 dist_length, bool release_profile) -> bool {
    if (dist == 0 || dist_length <= 0) { return false; }
    if (!release_profile) { return true; }

    i64 files = raz_compiler_rt_arena_create_width(4194304, 1);
    i64 relative = raz_compiler_rt_arena_create(8192);
    i64 full = raz_compiler_rt_arena_create(8192);
    i64 sibling = raz_compiler_rt_arena_create(8192);
    i64 directory = raz_compiler_rt_arena_create(8192);
    i64 assets = raz_compiler_rt_arena_create(8192);
    i64 hashed = raz_compiler_rt_arena_create(256);
    i64 replacement = raz_compiler_rt_arena_create(512);
    i64 manifest_value = raz_compiler_rt_arena_create(512);
    i64 literal_name = raz_compiler_rt_arena_create(32);
    i64 manifest = raz_compiler_rt_arena_create_width(1048576, 1);
    i64 manifest_path = raz_compiler_rt_arena_create(8192);
    if (files == 0 || relative == 0 || full == 0 || sibling == 0 || directory == 0 || assets == 0 || hashed == 0 || replacement == 0 || manifest_value == 0 || literal_name == 0 || manifest == 0 || manifest_path == 0) { return false; }

    i64 assets_name_length = web_bundle_make_literal(literal_name, 32, "assets");
    i64 assets_length = path_join(dist, dist_length, literal_name, assets_name_length, assets, 8192);
    if (assets_length <= 0 || raz_compiler_rt_create_dir_ascii(assets, assets_length) != 0) { return false; }

    i64 files_length = raz_compiler_rt_tree_list_ascii(dist, dist_length, files, 4194304);
    if (files_length < 0) { return false; }

    // Public files are stable by default. Files explicitly placed under
    // public/assets/ opt into the release content-addressed pipeline. Binary
    // assets are fingerprinted first so CSS/JS can be rewritten before their
    // own content hashes are computed.
    i64 public_replacement = raz_compiler_rt_arena_create(8192);
    if (public_replacement == 0) { return false; }
    i64 public_phase = 0;
    while (public_phase < 2) {
        i64 public_line_start = 0;
        while (public_line_start < files_length) {
            i64 public_line_end = public_line_start;
            while (public_line_end < files_length && raz_compiler_rt_arena_get(files, public_line_end) != 10) { public_line_end += 1; }
            i64 public_line_length = public_line_end - public_line_start;
            bool under_assets = web_bundle_line_has_prefix(files, public_line_start, public_line_length, "assets/");
            bool generated = web_bundle_line_has_suffix(files, public_line_start, public_line_length, "app.js") || web_bundle_line_has_suffix(files, public_line_start, public_line_length, "app.css") || web_bundle_line_has_suffix(files, public_line_start, public_line_length, "app.wasm");
            bool text_asset = web_bundle_line_is_text_asset(files, public_line_start, public_line_length);
            bool selected = under_assets && !generated && ((public_phase == 0 && !text_asset) || (public_phase == 1 && text_asset));
            if (selected) {
                i64 i = 0; while (i < public_line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, public_line_start + i)); i += 1; }
                i64 fl = path_join(dist, dist_length, relative, public_line_length, full, 8192);
                bool css_asset = web_bundle_line_has_suffix(files, public_line_start, public_line_length, ".css");
                i64 hashed_length = web_bundle_write_public_asset(full, fl, relative, public_line_length, css_asset, hashed, 256);
                if (hashed_length <= 0) { return false; }
                i64 replacement_length = web_bundle_public_asset_replacement(relative, public_line_length, hashed, hashed_length, public_replacement, 8192);
                if (replacement_length <= 0 || !web_bundle_rewrite_text_tree(dist, dist_length, files, files_length, relative, public_line_length, public_replacement, replacement_length)) { return false; }
            }
            public_line_start = public_line_end + 1;
        }
        public_phase += 1;
    }

    // 1. Fingerprint WASM first into the one release asset directory. JS
    // fingerprints must include the final WASM URL.
    i64 line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        if (web_bundle_line_has_suffix(files, line_start, line_length, "app.wasm")) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            if (web_bundle_write_fingerprinted(full, fl, assets, assets_length, "app", "wasm", false, hashed, 256) <= 0) { return false; }
        }
        line_start = line_end + 1;
    }

    // 2. Rewrite each canonical JS module to the fingerprinted WASM, then
    // fingerprint the final JS bytes into dist/assets/. Relative WASM imports
    // remain sibling-relative because both shipped files live in assets/.
    line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        if (web_bundle_line_has_suffix(files, line_start, line_length, "app.js")) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            i64 dl = path_dirname(full, fl, directory, 8192);
            i64 wasm_name_length = web_bundle_make_literal(literal_name, 32, "app.wasm");
            i64 sibling_length = path_join(directory, dl, literal_name, wasm_name_length, sibling, 8192);
            i64 hashed_length = 0;
            if (sibling_length > 0 && raz_compiler_rt_path_exists_ascii(sibling, sibling_length) != 0) {
                hashed_length = web_bundle_write_fingerprinted(sibling, sibling_length, assets, assets_length, "app", "wasm", false, hashed, 256);
            } else {
                i64 root_wasm_length = path_join(dist, dist_length, literal_name, wasm_name_length, sibling, 8192);
                if (root_wasm_length > 0 && raz_compiler_rt_path_exists_ascii(sibling, root_wasm_length) != 0) {
                    hashed_length = web_bundle_write_fingerprinted(sibling, root_wasm_length, assets, assets_length, "app", "wasm", false, hashed, 256);
                } else {
                    i64 canonical_assets_wasm = path_join(assets, assets_length, literal_name, wasm_name_length, sibling, 8192);
                    if (canonical_assets_wasm > 0 && raz_compiler_rt_path_exists_ascii(sibling, canonical_assets_wasm) != 0) {
                        hashed_length = web_bundle_write_fingerprinted(sibling, canonical_assets_wasm, assets, assets_length, "app", "wasm", false, hashed, 256);
                    }
                }
            }
            if (hashed_length > 0) {
                i64 r = 0;
                raz_compiler_rt_arena_set(replacement, r, 46); r += 1;
                raz_compiler_rt_arena_set(replacement, r, 47); r += 1;
                i = 0; while (i < hashed_length) { raz_compiler_rt_arena_set(replacement, r, raz_compiler_rt_arena_get(hashed, i)); r += 1; i += 1; }
                if (!web_bundle_rewrite_file(full, fl, "./app.wasm", replacement, r)) { return false; }

                r = 0;
                raz_compiler_rt_arena_set(replacement, r, 47); r += 1;
                i64 asset_literal_length = web_bundle_make_literal(literal_name, 32, "assets");
                i = 0; while (i < asset_literal_length) { raz_compiler_rt_arena_set(replacement, r, raz_compiler_rt_arena_get(literal_name, i)); r += 1; i += 1; }
                raz_compiler_rt_arena_set(replacement, r, 47); r += 1;
                i = 0; while (i < hashed_length) { raz_compiler_rt_arena_set(replacement, r, raz_compiler_rt_arena_get(hashed, i)); r += 1; i += 1; }
                if (!web_bundle_rewrite_file(full, fl, "/app.wasm", replacement, r)) { return false; }
            }
            if (web_bundle_write_fingerprinted(full, fl, assets, assets_length, "app", "js", false, hashed, 256) <= 0) { return false; }
        }
        line_start = line_end + 1;
    }

    // 3. Minify generated CSS before fingerprinting it into dist/assets/.
    line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        if (web_bundle_line_has_suffix(files, line_start, line_length, "app.css")) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            if (web_bundle_write_fingerprinted(full, fl, assets, assets_length, "app", "css", true, hashed, 256) <= 0) { return false; }
        }
        line_start = line_end + 1;
    }

    // 4. Rewrite HTML. If the canonical asset was generated beside the page,
    // add an `assets/` path segment while preserving its existing route prefix
    // (`./`, `../`, `/`). Reactive HTML already carries `assets/app.*`, so only
    // the basename changes there.
    line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        if (web_bundle_line_has_suffix(files, line_start, line_length, ".html")) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            i64 dl = path_dirname(full, fl, directory, 8192);

            i64 hashed_length = 0;
            bool source_in_assets = false;
            i64 js_name_length = web_bundle_make_literal(literal_name, 32, "app.js");
            i64 sibling_length = path_join(directory, dl, literal_name, js_name_length, sibling, 8192);
            if (sibling_length > 0 && raz_compiler_rt_path_exists_ascii(sibling, sibling_length) != 0) {
                hashed_length = web_bundle_write_fingerprinted(sibling, sibling_length, assets, assets_length, "app", "js", false, hashed, 256);
            } else {
                sibling_length = path_join(assets, assets_length, literal_name, js_name_length, sibling, 8192);
                if (sibling_length > 0 && raz_compiler_rt_path_exists_ascii(sibling, sibling_length) != 0) {
                    source_in_assets = true;
                    hashed_length = web_bundle_write_fingerprinted(sibling, sibling_length, assets, assets_length, "app", "js", false, hashed, 256);
                }
            }
            if (hashed_length > 0) {
                i64 r = 0;
                if (!source_in_assets) {
                    i64 asset_literal_length = web_bundle_make_literal(literal_name, 32, "assets");
                    i = 0; while (i < asset_literal_length) { raz_compiler_rt_arena_set(replacement, r, raz_compiler_rt_arena_get(literal_name, i)); r += 1; i += 1; }
                    raz_compiler_rt_arena_set(replacement, r, 47); r += 1;
                }
                i = 0; while (i < hashed_length) { raz_compiler_rt_arena_set(replacement, r, raz_compiler_rt_arena_get(hashed, i)); r += 1; i += 1; }
                if (!web_bundle_rewrite_file(full, fl, "app.js", replacement, r)) { return false; }
            }

            source_in_assets = false;
            i64 css_name_length = web_bundle_make_literal(literal_name, 32, "app.css");
            dl = path_dirname(full, fl, directory, 8192);
            sibling_length = path_join(directory, dl, literal_name, css_name_length, sibling, 8192);
            if (sibling_length > 0 && raz_compiler_rt_path_exists_ascii(sibling, sibling_length) != 0) {
                hashed_length = web_bundle_write_fingerprinted(sibling, sibling_length, assets, assets_length, "app", "css", true, hashed, 256);
            } else {
                sibling_length = path_join(assets, assets_length, literal_name, css_name_length, sibling, 8192);
                if (sibling_length > 0 && raz_compiler_rt_path_exists_ascii(sibling, sibling_length) != 0) {
                    source_in_assets = true;
                    hashed_length = web_bundle_write_fingerprinted(sibling, sibling_length, assets, assets_length, "app", "css", true, hashed, 256);
                } else { hashed_length = 0; }
            }
            if (hashed_length > 0) {
                i64 r = 0;
                if (!source_in_assets) {
                    i64 asset_literal_length = web_bundle_make_literal(literal_name, 32, "assets");
                    i = 0; while (i < asset_literal_length) { raz_compiler_rt_arena_set(replacement, r, raz_compiler_rt_arena_get(literal_name, i)); r += 1; i += 1; }
                    raz_compiler_rt_arena_set(replacement, r, 47); r += 1;
                }
                i = 0; while (i < hashed_length) { raz_compiler_rt_arena_set(replacement, r, raz_compiler_rt_arena_get(hashed, i)); r += 1; i += 1; }
                if (!web_bundle_rewrite_file(full, fl, "app.css", replacement, r)) { return false; }
            }
        }
        line_start = line_end + 1;
    }

    // 5. Deterministic manifest from the original sorted canonical asset list.
    // Every shipped generated runtime asset now lives under `assets/`.
    i64 manifest_cursor = 0;
    raz_compiler_rt_arena_set(manifest, manifest_cursor, 123); manifest_cursor += 1;
    raz_compiler_rt_arena_set(manifest, manifest_cursor, 10); manifest_cursor += 1;
    bool first_manifest = true;
    // Public content-addressed assets participate in the same deterministic
    // manifest as generated runtime assets. The original logical path is the
    // key; the final fingerprinted relative path is the value.
    line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        bool under_assets = web_bundle_line_has_prefix(files, line_start, line_length, "assets/");
        bool generated = web_bundle_line_has_suffix(files, line_start, line_length, "app.js") || web_bundle_line_has_suffix(files, line_start, line_length, "app.css") || web_bundle_line_has_suffix(files, line_start, line_length, "app.wasm");
        if (under_assets && !generated) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            bool css_asset = web_bundle_line_has_suffix(files, line_start, line_length, ".css");
            i64 hashed_length = web_bundle_write_public_asset(full, fl, relative, line_length, css_asset, hashed, 256);
            i64 value_cursor = web_bundle_public_asset_replacement(relative, line_length, hashed, hashed_length, manifest_value, 512);
            if (hashed_length <= 0 || value_cursor <= 0) { return false; }
            if (!first_manifest) { raz_compiler_rt_arena_set(manifest, manifest_cursor, 44); manifest_cursor += 1; raz_compiler_rt_arena_set(manifest, manifest_cursor, 10); manifest_cursor += 1; }
            manifest_cursor = web_bundle_append_manifest_entry(manifest, 1048576, manifest_cursor, relative, line_length, manifest_value, value_cursor);
            if (manifest_cursor < 0) { return false; }
            first_manifest = false;
        }
        line_start = line_end + 1;
    }

    line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        bool js = web_bundle_line_has_suffix(files, line_start, line_length, "app.js");
        bool css = web_bundle_line_has_suffix(files, line_start, line_length, "app.css");
        bool wasm = web_bundle_line_has_suffix(files, line_start, line_length, "app.wasm");
        if (js || css || wasm) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            i64 hashed_length = 0;
            if (js) { hashed_length = web_bundle_write_fingerprinted(full, fl, assets, assets_length, "app", "js", false, hashed, 256); }
            else if (css) { hashed_length = web_bundle_write_fingerprinted(full, fl, assets, assets_length, "app", "css", true, hashed, 256); }
            else { hashed_length = web_bundle_write_fingerprinted(full, fl, assets, assets_length, "app", "wasm", false, hashed, 256); }
            if (hashed_length <= 0) { return false; }
            if (!first_manifest) { raz_compiler_rt_arena_set(manifest, manifest_cursor, 44); manifest_cursor += 1; raz_compiler_rt_arena_set(manifest, manifest_cursor, 10); manifest_cursor += 1; }
            i64 value_cursor = 0;
            i64 asset_literal_length = web_bundle_make_literal(literal_name, 32, "assets");
            i = 0; while (i < asset_literal_length) { raz_compiler_rt_arena_set(manifest_value, value_cursor, raz_compiler_rt_arena_get(literal_name, i)); value_cursor += 1; i += 1; }
            raz_compiler_rt_arena_set(manifest_value, value_cursor, 47); value_cursor += 1;
            i = 0; while (i < hashed_length) { raz_compiler_rt_arena_set(manifest_value, value_cursor, raz_compiler_rt_arena_get(hashed, i)); value_cursor += 1; i += 1; }
            manifest_cursor = web_bundle_append_manifest_entry(manifest, 1048576, manifest_cursor, relative, line_length, manifest_value, value_cursor);
            if (manifest_cursor < 0) { return false; }
            first_manifest = false;
        }
        line_start = line_end + 1;
    }
    raz_compiler_rt_arena_set(manifest, manifest_cursor, 10); manifest_cursor += 1;
    raz_compiler_rt_arena_set(manifest, manifest_cursor, 125); manifest_cursor += 1;
    raz_compiler_rt_arena_set(manifest, manifest_cursor, 10); manifest_cursor += 1;
    i64 manifest_name_length = web_bundle_make_literal(literal_name, 32, "asset-manifest.json");
    i64 mpl = path_join(dist, dist_length, literal_name, manifest_name_length, manifest_path, 8192);
    if (mpl <= 0 || raz_compiler_rt_write_ascii(manifest_path, mpl, manifest, manifest_cursor) != manifest_cursor) { return false; }

    // 6. Canonical names are build intermediates; only fingerprinted assets ship.
    line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        if (web_bundle_line_has_suffix(files, line_start, line_length, "app.js") || web_bundle_line_has_suffix(files, line_start, line_length, "app.css") || web_bundle_line_has_suffix(files, line_start, line_length, "app.wasm")) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            if (raz_compiler_rt_path_exists_ascii(full, fl) != 0 && raz_compiler_rt_remove_path_ascii(full, fl) != 0) { return false; }
        }
        line_start = line_end + 1;
    }

    // public/assets/ is an opt-in content-addressed namespace in release
    // builds. Canonical logical files are intermediates; only their
    // fingerprinted siblings ship.
    line_start = 0;
    while (line_start < files_length) {
        i64 line_end = line_start;
        while (line_end < files_length && raz_compiler_rt_arena_get(files, line_end) != 10) { line_end += 1; }
        i64 line_length = line_end - line_start;
        bool under_assets = web_bundle_line_has_prefix(files, line_start, line_length, "assets/");
        bool generated = web_bundle_line_has_suffix(files, line_start, line_length, "app.js") || web_bundle_line_has_suffix(files, line_start, line_length, "app.css") || web_bundle_line_has_suffix(files, line_start, line_length, "app.wasm");
        if (under_assets && !generated) {
            i64 i = 0; while (i < line_length) { raz_compiler_rt_arena_set(relative, i, raz_compiler_rt_arena_get(files, line_start + i)); i += 1; }
            i64 fl = path_join(dist, dist_length, relative, line_length, full, 8192);
            if (raz_compiler_rt_path_exists_ascii(full, fl) != 0 && raz_compiler_rt_remove_path_ascii(full, fl) != 0) { return false; }
        }
        line_start = line_end + 1;
    }

    raz_compiler_rt_arena_destroy(files);
    raz_compiler_rt_arena_destroy(relative);
    raz_compiler_rt_arena_destroy(full);
    raz_compiler_rt_arena_destroy(sibling);
    raz_compiler_rt_arena_destroy(directory);
    raz_compiler_rt_arena_destroy(assets);
    raz_compiler_rt_arena_destroy(hashed);
    raz_compiler_rt_arena_destroy(replacement);
    raz_compiler_rt_arena_destroy(manifest_value);
    raz_compiler_rt_arena_destroy(literal_name);
    raz_compiler_rt_arena_destroy(manifest);
    raz_compiler_rt_arena_destroy(manifest_path);
    raz_compiler_rt_arena_destroy(public_replacement);
    return true;
}
