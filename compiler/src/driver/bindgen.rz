}

fn bindgen_command(i64 argc) -> i64 {
    if(argc<3 || argc>5){ cli_print_invalid_arguments(); return 2; }
    i64 path=raz_compiler_rt_arena_create(4096); i64 out_path=raz_compiler_rt_arena_create(4096); i64 input=raz_compiler_rt_arena_create(8388608); i64 output=raz_compiler_rt_arena_create(16777216);
    if (path == 0 || out_path == 0 || input == 0 || output == 0) { return 40; }
    i64 pl = cli_load_arg(2, path, 4096);
    if (pl <= 0) { return 2; }
    bool windows_abi=raz_compiler_rt_host_platform()==1; i64 output_index=3;
    if(argc>3){ i64 option=raz_compiler_rt_arena_create(128); i64 ol=cli_load_arg(3,option,128); string win = "--target-abi=windows"; string unix = "--target-abi=unix"; if(cli_arg_equals_literal(option, ol, win)){windows_abi=true;output_index=4;} else if(cli_arg_equals_literal(option, ol, unix)){windows_abi=false;output_index=4;} raz_compiler_rt_arena_destroy(option); }
    i64 il = raz_compiler_rt_read_ascii(path, pl, input, 8388608);
    if (il < 0) { cli_print_invalid_arguments(); return 2; }
    i64 generated = bindgen_generate(input, il, output, 16777216, windows_abi);
    if (generated < 0) { return 40; }
    i64 status=0;
    if (output_index < argc) {
        i64 opl = cli_load_arg(output_index, out_path, 4096);
        if (opl <= 0 || raz_compiler_rt_write_ascii(out_path, opl, output, generated) != generated) { status = 2; }
    }
    else {
        cli_write_arena_stream(1, output, generated);
    }
    raz_compiler_rt_arena_destroy(path); raz_compiler_rt_arena_destroy(out_path); raz_compiler_rt_arena_destroy(input); raz_compiler_rt_arena_destroy(output); return status;
}
