                    string struct_word = "struct"; string union_word = "union"; string enum_word = "enum";
                    i64 k=a; string typedef_word = "typedef";
                    if (b - a >= 7 && bindgen_equal_string(input, a, a + 7, typedef_word)) { k = bindgen_skip_space(input, a + 7, b); }
                    i64 kw_end = bindgen_find_byte(input, k, brace, 32);
                    if (kw_end < 0) { kw_end = brace; }
                    i64 kind = 0;
                    if (bindgen_equal_string(input, k, kw_end, struct_word)) { kind = 1; } else if (bindgen_equal_string(input, k, kw_end, union_word)) { kind = 2; } else if (bindgen_equal_string(input, k, kw_end, enum_word)) { kind = 3; }
                    if(kind>0) {
