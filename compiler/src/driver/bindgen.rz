                        i64 body=bindgen_skip_space(input,a+7,b-1); i64 ne=bindgen_trim_end(input,body,b-1); i64 ns=ne; while (ns>body && bindgen_is_ident(raz_compiler_rt_arena_get(input,ns-1))) { ns-=1; }
                        if (ns < ne) {
