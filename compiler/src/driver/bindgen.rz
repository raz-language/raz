namespace raz_compiler_driver_bindgen;

public import raz_compiler_driver_tooling;

// C header -> Raz FFI source generator.  This deliberately implements the
// stable declaration subset directly in Raz so bindgen does not depend on a C
// compiler frontend.  The parser is line-oriented for declarations and uses a
// small declarator normalizer for pointers/arrays/function prototypes.  Unknown
// named C types are preserved by spelling; bindgen never invents their layout.

fn bindgen_is_space(i64 ch) -> bool {
    return ch == 32 || ch == 9 || ch == 10 || ch == 13;
}

fn bindgen_is_ident(i64 ch) -> bool {
    return (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95;
}

fn bindgen_skip_space(i64 data, i64 cursor, i64 end) -> i64 {
    while (cursor < end && bindgen_is_space(raz_compiler_rt_arena_get(data, cursor))) {
        cursor += 1;
    }
    return cursor;
}

fn bindgen_trim_end(i64 data, i64 start, i64 end) -> i64 {
    while (end > start && bindgen_is_space(raz_compiler_rt_arena_get(data, end - 1))) {
        end -= 1;
    }
    return end;
}

fn bindgen_append_byte(i64 out, i64 cap, i64 cursor, i64 ch) -> i64 {
    if (cursor < 0 || cursor >= cap) {
        return -1;
    }
    raz_compiler_rt_arena_set(out, cursor, ch);
    return cursor + 1;
}

fn bindgen_append_range(i64 out, i64 cap, i64 cursor, i64 data, i64 start, i64 end) -> i64 {
    i64 i = start;
    while (i < end) {
        cursor = bindgen_append_byte(out, cap, cursor, raz_compiler_rt_arena_get(data, i));
        if (cursor < 0) {
            return -1;
        }
        i += 1;
    }
    return cursor;
}

fn bindgen_append_string_literal(i64 out, i64 cap, i64 cursor, string text) -> i64 {
    i64 length = compiler_literal_length(text);
    i64 i = 0;
    while (i < length) {
        cursor = bindgen_append_byte(out, cap, cursor, compiler_literal_byte(text, i));
        if (cursor < 0) { return -1; }
        i += 1;
    }
    return cursor;
}

fn bindgen_equal_string(i64 data, i64 start, i64 end, string text) -> bool {
    i64 length = compiler_literal_length(text);
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);
    if (end - start != length) { return false; }
    i64 i = 0;
    while (i < length) {
        if (raz_compiler_rt_arena_get(data, start + i) != compiler_literal_byte(text, i)) { return false; }
        i += 1;
    }
    return true;
}

fn bindgen_append_literal(i64 out, i64 cap, i64 cursor, i64[] text, i64 length) -> i64 {
    i64 i = 0;
    while (i < length) {
        cursor = bindgen_append_byte(out, cap, cursor, text[i]);
        if (cursor < 0) {
            return -1;
        }
        i += 1;
    }
    return cursor;
}

fn bindgen_equal_ascii(i64 data, i64 start, i64 end, i64[] text, i64 length) -> bool {
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);
    if (end - start != length) {
        return false;
    }
    i64 i = 0;
    while (i < length) {
        if (raz_compiler_rt_arena_get(data, start + i) != text[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn bindgen_find_byte(i64 data, i64 start, i64 end, i64 ch) -> i64 {
    i64 i = start;
    while (i < end) {
        if (raz_compiler_rt_arena_get(data, i) == ch) {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn bindgen_find_last_byte(i64 data, i64 start, i64 end, i64 ch) -> i64 {
    i64 i = end;
    while (i > start) {
        i -= 1;
        if (raz_compiler_rt_arena_get(data, i) == ch) {
            return i;
        }
    }
    return -1;
}

fn bindgen_type_word_string(i64 data, i64 start, i64 end, string word) -> bool {
    return bindgen_equal_string(data, start, end, word);
}

fn bindgen_type_word(i64 data, i64 start, i64 end, i64[] word, i64 length) -> bool {
    return bindgen_equal_ascii(data, start, end, word, length);
}


public struct BindgenAliasTable {
    i64 records;
    i64 count;
}

fn bindgen_alias_table_init(BindgenAliasTable&mut aliases) -> bool {
    aliases.records = raz_compiler_rt_arena_create(4096);
    aliases.count = 0;
    return aliases.records != 0;
}

fn bindgen_alias_table_destroy(BindgenAliasTable&mut aliases) {
    if (aliases.records != 0) {
        raz_compiler_rt_arena_destroy(aliases.records);
    }
    aliases.records = 0;
    aliases.count = 0;
}

fn bindgen_alias_add(BindgenAliasTable&mut aliases, i64 name_start, i64 name_end, i64 type_start, i64 type_end) -> bool {
    if (aliases.records == 0 || aliases.count >= 128 || name_end <= name_start || type_end <= type_start) {
        return false;
    }
    i64 base = aliases.count * 4;
    raz_compiler_rt_arena_set(aliases.records, base, name_start);
    raz_compiler_rt_arena_set(aliases.records, base + 1, name_end);
    raz_compiler_rt_arena_set(aliases.records, base + 2, type_start);
    raz_compiler_rt_arena_set(aliases.records, base + 3, type_end);
    aliases.count += 1;
    return true;
}

fn bindgen_ranges_equal(i64 data, i64 left_start, i64 left_end, i64 right_start, i64 right_end) -> bool {
    left_start = bindgen_skip_space(data, left_start, left_end);
    left_end = bindgen_trim_end(data, left_start, left_end);
    right_start = bindgen_skip_space(data, right_start, right_end);
    right_end = bindgen_trim_end(data, right_start, right_end);
    if (left_end - left_start != right_end - right_start) {
        return false;
    }
    i64 i = 0;
    while (left_start + i < left_end) {
        if (raz_compiler_rt_arena_get(data, left_start + i) != raz_compiler_rt_arena_get(data, right_start + i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn bindgen_alias_find(BindgenAliasTable& aliases, i64 data, i64 start, i64 end) -> i64 {
    i64 index = aliases.count;
    while (index > 0) {
        index -= 1;
        i64 base = index * 4;
        i64 name_start = raz_compiler_rt_arena_get(aliases.records, base);
        i64 name_end = raz_compiler_rt_arena_get(aliases.records, base + 1);
        if (bindgen_ranges_equal(data, start, end, name_start, name_end)) {
            return index;
        }
    }
    return -1;
}



public struct BindgenMacroTable {
    i64 records;
    i64 count;
}

fn bindgen_macro_table_init(BindgenMacroTable&mut macros) -> bool {
    macros.records = raz_compiler_rt_arena_create(2048);
    macros.count = 0;
    return macros.records != 0;
}

fn bindgen_macro_table_destroy(BindgenMacroTable&mut macros) {
    if (macros.records != 0) { raz_compiler_rt_arena_destroy(macros.records); }
    macros.records = 0;
    macros.count = 0;
}

fn bindgen_macro_defined(BindgenMacroTable& macros, i64 data, i64 start, i64 end) -> bool {
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);
    i64 index = macros.count;
    while (index > 0) {
        index -= 1;
        i64 base = index * 2;
        if (bindgen_ranges_equal(data, start, end, raz_compiler_rt_arena_get(macros.records, base), raz_compiler_rt_arena_get(macros.records, base + 1))) { return true; }
    }
    return false;
}

fn bindgen_macro_add(BindgenMacroTable&mut macros, i64 data, i64 start, i64 end) -> bool {
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);
    if (start >= end || macros.records == 0) { return false; }
    if (bindgen_macro_defined(macros, data, start, end)) { return true; }
    if (macros.count >= 128) { return false; }
    i64 base = macros.count * 2;
    raz_compiler_rt_arena_set(macros.records, base, start);
    raz_compiler_rt_arena_set(macros.records, base + 1, end);
    macros.count += 1;
    return true;
}

fn bindgen_pp_eval(i64 data, i64 start, i64 end, BindgenMacroTable& macros) -> i64 {
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);
    if (start >= end) { return -1; }
    if (end - start == 1 && raz_compiler_rt_arena_get(data, start) == 48) { return 0; }
    if (end - start == 1 && raz_compiler_rt_arena_get(data, start) == 49) { return 1; }
    bool negate = false;
    if (raz_compiler_rt_arena_get(data, start) == 33) { negate = true; start = bindgen_skip_space(data, start + 1, end); }
        if (end - start >= 7 && bindgen_equal_string(data, start, start + 7, "defined")) {
        i64 n = bindgen_skip_space(data, start + 7, end);
        if (n < end && raz_compiler_rt_arena_get(data, n) == 40) {
            n = bindgen_skip_space(data, n + 1, end);
            i64 close = bindgen_find_byte(data, n, end, 41);
            if (close < 0) { return -1; }
            bool present = bindgen_macro_defined(macros, data, n, close);
            if (negate) { if (present) { return 0; } return 1; }
            if (present) { return 1; }
            return 0;
        }
        i64 ne = n; while (ne < end && bindgen_is_ident(raz_compiler_rt_arena_get(data, ne))) { ne += 1; }
        if (ne == n) { return -1; }
        bool present = bindgen_macro_defined(macros, data, n, ne);
        if (negate) { if (present) { return 0; } return 1; }
        if (present) { return 1; }
        return 0;
    }
    return -1;
}
fn bindgen_emit_function_pointer_type(i64 out, i64 cap, i64 cursor, i64 data, i64 start, i64 end, bool windows_abi, BindgenAliasTable& aliases) -> i64 {
    i64 first_open = bindgen_find_byte(data, start, end, 40);
    if (first_open < 0) { return -1; }
    i64 star = bindgen_find_byte(data, first_open + 1, end, 42);
    if (star < 0) { return -1; }
    i64 first_close = bindgen_find_byte(data, star + 1, end, 41);
    if (first_close < 0) { return -1; }
    i64 params_open = bindgen_find_byte(data, first_close + 1, end, 40);
    i64 params_close = bindgen_find_last_byte(data, params_open + 1, end, 41);
    if (params_open < 0 || params_close < params_open) { return -1; }

        cursor = bindgen_append_string_literal(out, cap, cursor, "fn(");
    i64 item_start = params_open + 1;
    i64 p = item_start;
    i64 index = 0;
    i64 depth = 0;
    while (p <= params_close) {
        i64 ch = 0;
        if (p < params_close) { ch = raz_compiler_rt_arena_get(data, p); }
        if (ch == 40) { depth += 1; }
        else if (ch == 41 && depth > 0) { depth -= 1; }
        bool boundary = p == params_close || (ch == 44 && depth == 0);
        if (boundary) {
            i64 a = bindgen_skip_space(data, item_start, p);
            i64 b = bindgen_trim_end(data, a, p);
                        if (b > a && !bindgen_equal_string(data, a, b, "void")) {
                if (index > 0) {
                                        cursor = bindgen_append_string_literal(out, cap, cursor, ", ");
                }
                i64 name_end = b;
                i64 name_start = name_end;
                while (name_start > a && bindgen_is_ident(raz_compiler_rt_arena_get(data, name_start - 1))) {
                    name_start -= 1;
                }
                if (name_start > a && name_start < name_end) {
                    cursor = bindgen_emit_decl_type(out, cap, cursor, data, a, b, name_start, windows_abi, aliases);
                } else {
                    // Callback parameters generated by `raz c-header` are unnamed
                    // C declarators.  Use the end of the declarator as the
                    // synthetic name boundary so pointer stars remain part of
                    // the type instead of being mistaken for a missing name.
                    cursor = bindgen_emit_decl_type(out, cap, cursor, data, a, b, b, windows_abi, aliases);
                }
                index += 1;
            }
            item_start = p + 1;
        }
        p += 1;
    }
    cursor = bindgen_append_byte(out, cap, cursor, 41);
        if (!bindgen_equal_string(data, start, first_open, "void")) {
                cursor = bindgen_append_string_literal(out, cap, cursor, " -> ");
        cursor = bindgen_emit_base_type(out, cap, cursor, data, start, first_open, windows_abi, aliases);
    }
    return cursor;
}

// Emit a Raz type for the simple C type spelling in [start,end).  pointer_depth
// is handled separately by the declarator parser.  Windows ABI uses 32-bit
// long; Unix x86-64 uses 64-bit long.  size_t/ptrdiff_t follow pointer width.
fn bindgen_emit_base_type(i64 out, i64 cap, i64 cursor, i64 data, i64 start, i64 end, bool windows_abi, BindgenAliasTable& aliases) -> i64 {
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);

    // Strip common declaration qualifiers from the base spelling.
    string const_word = "const ";
    if (end - start >= 6) {
        bool pref = true;
        i64 q = 0;
        while (q < 6) {
            if (raz_compiler_rt_arena_get(data, start + q) != compiler_literal_byte(const_word, q)) { pref = false; }
            q += 1;
        }
        if (pref) { start = bindgen_skip_space(data, start + 6, end); }
    }

    i64 alias_index = bindgen_alias_find(aliases, data, start, end);
    if (alias_index >= 0) {
        i64 alias_base = alias_index * 4;
        i64 alias_type_start = raz_compiler_rt_arena_get(aliases.records, alias_base + 2);
        i64 alias_type_end = raz_compiler_rt_arena_get(aliases.records, alias_base + 3);
        i64 alias_open = bindgen_find_byte(data, alias_type_start, alias_type_end, 40);
        i64 alias_star = bindgen_find_byte(data, alias_type_start, alias_type_end, 42);
        if (alias_open >= 0 && alias_star > alias_open) {
            return bindgen_emit_function_pointer_type(out, cap, cursor, data, alias_type_start, alias_type_end, windows_abi, aliases);
        }

        // A pointer typedef is a type in its own right: later declarations such
        // as `typedef const char *cstr; cstr name(void);` do not contain a `*`
        // for the declarator parser to see.  Lower the pointer suffix while the
        // alias spelling is still available instead of emitting an unsupported
        // top-level Raz alias or silently losing pointer indirection.
        if (alias_star >= 0) {
            i64 alias_base_start = bindgen_skip_space(data, alias_type_start, alias_star);
            i64 alias_base_end = bindgen_trim_end(data, alias_base_start, alias_star);
            bool alias_pointee_const = false;
                        i64 alias_space = bindgen_find_byte(data, alias_base_start, alias_base_end, 32);
            if (alias_space >= 0 && bindgen_equal_string(data, alias_base_start, alias_space, "const")) {
                alias_pointee_const = true;
            }
            cursor = bindgen_emit_base_type(out, cap, cursor, data, alias_base_start, alias_base_end, windows_abi, aliases);
            i64 pointer = alias_star;
            while (cursor >= 0 && pointer >= 0 && pointer < alias_type_end) {
                if (alias_pointee_const) {
                                        cursor = bindgen_append_string_literal(out, cap, cursor, "*const");
                    alias_pointee_const = false;
                } else {
                                        cursor = bindgen_append_string_literal(out, cap, cursor, "*mut");
                }
                pointer = bindgen_find_byte(data, pointer + 1, alias_type_end, 42);
            }
            return cursor;
        }
        return bindgen_emit_base_type(out, cap, cursor, data, alias_type_start, alias_type_end, windows_abi, aliases);
    }

    string w_void = "void";
    string w_char = "char";
    string w_schar = "signed char";
    string w_uchar = "unsigned char";
    string w_short = "short";
    string w_ushort = "unsigned short";
    string w_int = "int";
    string w_uint = "unsigned int";
    string w_long = "long";
    string w_ulong = "unsigned long";
    string w_ll = "long long";
    string w_ull = "unsigned long long";
    string w_float = "float";
    string w_double = "double";
    string w_bool = "_Bool";
    string w_size = "size_t";
    string w_ssize = "ssize_t";
    string w_ptrdiff = "ptrdiff_t";
    string w_int8 = "int8_t"; string w_uint8 = "uint8_t";
    string w_int16 = "int16_t"; string w_uint16 = "uint16_t";
    string w_int32 = "int32_t"; string w_uint32 = "uint32_t";
    string w_int64 = "int64_t"; string w_uint64 = "uint64_t";
    string w_intptr = "intptr_t"; string w_uintptr = "uintptr_t";
        string t_i8 = "i8"; string t_u8 = "u8";
    string t_i16 = "i16"; string t_u16 = "u16";
    string t_i32 = "i32"; string t_u32 = "u32";
    string t_i64 = "i64"; string t_u64 = "u64";
    string t_f32 = "f32"; string t_f64 = "f64";
    string t_bool = "bool"; string t_usize = "usize"; string t_isize = "isize";

    if (bindgen_type_word_string(data, start, end, w_void)) { return bindgen_append_string_literal(out, cap, cursor, "void"); }
    if (bindgen_type_word_string(data, start, end, w_int8)) { return bindgen_append_string_literal(out, cap, cursor, t_i8); }
    if (bindgen_type_word_string(data, start, end, w_uint8)) { return bindgen_append_string_literal(out, cap, cursor, t_u8); }
    if (bindgen_type_word_string(data, start, end, w_int16)) { return bindgen_append_string_literal(out, cap, cursor, t_i16); }
    if (bindgen_type_word_string(data, start, end, w_uint16)) { return bindgen_append_string_literal(out, cap, cursor, t_u16); }
    if (bindgen_type_word_string(data, start, end, w_int32)) { return bindgen_append_string_literal(out, cap, cursor, t_i32); }
    if (bindgen_type_word_string(data, start, end, w_uint32)) { return bindgen_append_string_literal(out, cap, cursor, t_u32); }
    if (bindgen_type_word_string(data, start, end, w_int64)) { return bindgen_append_string_literal(out, cap, cursor, t_i64); }
    if (bindgen_type_word_string(data, start, end, w_uint64)) { return bindgen_append_string_literal(out, cap, cursor, t_u64); }
    if (bindgen_type_word_string(data, start, end, w_intptr)) { return bindgen_append_string_literal(out, cap, cursor, t_isize); }
    if (bindgen_type_word_string(data, start, end, w_uintptr)) { return bindgen_append_string_literal(out, cap, cursor, t_usize); }
    if (bindgen_type_word_string(data, start, end, w_char) || bindgen_type_word_string(data, start, end, w_schar)) { return bindgen_append_string_literal(out, cap, cursor, t_i8); }
    if (bindgen_type_word_string(data, start, end, w_uchar)) { return bindgen_append_string_literal(out, cap, cursor, t_u8); }
    if (bindgen_type_word_string(data, start, end, w_short)) { return bindgen_append_string_literal(out, cap, cursor, t_i16); }
    if (bindgen_type_word_string(data, start, end, w_ushort)) { return bindgen_append_string_literal(out, cap, cursor, t_u16); }
    if (bindgen_type_word_string(data, start, end, w_int)) { return bindgen_append_string_literal(out, cap, cursor, t_i32); }
    if (bindgen_type_word_string(data, start, end, w_uint)) { return bindgen_append_string_literal(out, cap, cursor, t_u32); }
    if (bindgen_type_word_string(data, start, end, w_long)) {
        if (windows_abi) { return bindgen_append_string_literal(out, cap, cursor, t_i32); }
        return bindgen_append_string_literal(out, cap, cursor, t_i64);
    }
    if (bindgen_type_word_string(data, start, end, w_ulong)) {
        if (windows_abi) { return bindgen_append_string_literal(out, cap, cursor, t_u32); }
        return bindgen_append_string_literal(out, cap, cursor, t_u64);
    }
    if (bindgen_type_word_string(data, start, end, w_ll)) { return bindgen_append_string_literal(out, cap, cursor, t_i64); }
    if (bindgen_type_word_string(data, start, end, w_ull)) { return bindgen_append_string_literal(out, cap, cursor, t_u64); }
    if (bindgen_type_word_string(data, start, end, w_float)) { return bindgen_append_string_literal(out, cap, cursor, t_f32); }
    if (bindgen_type_word_string(data, start, end, w_double)) { return bindgen_append_string_literal(out, cap, cursor, t_f64); }
    if (bindgen_type_word_string(data, start, end, w_bool)) { return bindgen_append_string_literal(out, cap, cursor, t_bool); }
    if (bindgen_type_word_string(data, start, end, w_size)) { return bindgen_append_string_literal(out, cap, cursor, t_usize); }
    if (bindgen_type_word_string(data, start, end, w_ssize) || bindgen_type_word_string(data, start, end, w_ptrdiff)) { return bindgen_append_string_literal(out, cap, cursor, t_isize); }

    // Preserve a named type, but remove leading struct/union/enum keywords.
    i64 k = start;
    i64 kw_end = bindgen_find_byte(data,k,end,32);
    if (kw_end > k) {
                                if (bindgen_equal_string(data,k,kw_end, "struct") || bindgen_equal_string(data,k,kw_end, "union") || bindgen_equal_string(data,k,kw_end, "enum")) {
            k = bindgen_skip_space(data,kw_end,end);
        }
    }
    return bindgen_append_range(out,cap,cursor,data,k,end);
}


fn bindgen_parse_positive_integer(i64 data, i64 start, i64 end) -> i64 {
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);
    if (start >= end) {
        return -1;
    }
    i64 value = 0;
    i64 i = start;
    while (i < end) {
        i64 ch = raz_compiler_rt_arena_get(data, i);
        if (ch < 48 || ch > 57) {
            return -1;
        }
        value = value * 10 + ch - 48;
        if (value > 1048576) {
            return -1;
        }
        i += 1;
    }
    return value;
}

fn bindgen_base_size_align(i64 data, i64 start, i64 end, bool windows_abi, i64&mut size, i64&mut alignment) -> bool {
    start = bindgen_skip_space(data, start, end);
    end = bindgen_trim_end(data, start, end);
        if (end - start >= 5 && bindgen_equal_string(data, start, start + 5, "const")) {
        start = bindgen_skip_space(data, start + 5, end);
    }
                                                                    if (bindgen_equal_string(data,start,end, "char") || bindgen_equal_string(data,start,end, "signed char") || bindgen_equal_string(data,start,end, "unsigned char") || bindgen_equal_string(data,start,end, "_Bool")) {
        *size = 1; *alignment = 1; return true;
    }
    if (bindgen_equal_string(data,start,end, "short") || bindgen_equal_string(data,start,end, "unsigned short")) {
        *size = 2; *alignment = 2; return true;
    }
    if (bindgen_equal_string(data,start,end, "int") || bindgen_equal_string(data,start,end, "unsigned int") || bindgen_equal_string(data,start,end, "float")) {
        *size = 4; *alignment = 4; return true;
    }
    if (bindgen_equal_string(data,start,end, "long") || bindgen_equal_string(data,start,end, "unsigned long")) {
