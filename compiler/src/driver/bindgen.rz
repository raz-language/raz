                                if(b-a>7 && bindgen_equal_string(input,a,a+7, "#define")) {
                    i64 n=bindgen_skip_space(input,a+7,b); i64 ne=n; while (ne<b && bindgen_is_ident(raz_compiler_rt_arena_get(input,ne))) { ne+=1; }
