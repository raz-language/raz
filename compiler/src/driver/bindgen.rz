                        i64 width_end=b;if(width_end>a&&raz_compiler_rt_arena_get(input,width_end-1)==59){width_end-=1;}i64 width=bindgen_parse_decimal(input,colon+1,width_end);if(width<0){bindgen_alias_table_destroy(&mut aliases);return -1;}
                        i64 before=bindgen_trim_end(input,a,colon);i64 field_name_start=before;while(field_name_start>a&&bindgen_is_ident(raz_compiler_rt_arena_get(input,field_name_start-1))){field_name_start-=1;}if(field_name_start==before){bindgen_alias_table_destroy(&mut aliases);return -1;}i64 type_end=bindgen_trim_end(input,a,field_name_start);i64 unit=bindgen_bitfield_capacity(input,a,type_end,windows_abi);if(unit<=0||width>unit){bindgen_alias_table_destroy(&mut aliases);return -1;}
                        if(width==0){block_bitfield_used=0;block_bitfield_capacity=0;block_bitfield_type_start=0;block_bitfield_type_end=0;}else{bool same_type=block_bitfield_type_end>block_bitfield_type_start&&bindgen_ranges_equal(input,a,type_end,block_bitfield_type_start,block_bitfield_type_end);if(block_bitfield_capacity!=unit||!same_type||block_bitfield_used+width>unit){cursor=bindgen_emit_bitfield_storage(out,cap,cursor,input,a,type_end,windows_abi,&aliases,block_bitfield_index);if(cursor<0){bindgen_alias_table_destroy(&mut aliases);return -1;}block_bitfield_index+=1;block_bitfield_used=0;block_bitfield_capacity=unit;block_bitfield_type_start=a;block_bitfield_type_end=type_end;}block_bitfield_used+=width;}
                    }else{
                        block_bitfield_used=0;block_bitfield_capacity=0;block_bitfield_type_start=0;block_bitfield_type_end=0;
                        i64 inline_open = bindgen_find_byte(input, a, b, 123);
                        i64 inline_close = bindgen_find_last_byte(input, a, b, 125);
                        if (inline_open >= 0 && inline_close > inline_open) {
                            cursor = bindgen_emit_inline_anonymous_aggregate(out, cap, cursor, input, a, b, windows_abi, block_anonymous_index);
                            block_anonymous_index += 1;
                        } else {
                            cursor = bindgen_emit_field(out, cap, cursor, input, a, b, windows_abi, &aliases);
