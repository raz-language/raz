    i64 uc = 0;
    i64 endpoint[98] = [104, 116, 116, 112, 115, 58, 47, 47, 97, 112, 105, 46, 103, 105, 116, 104, 117, 98, 46, 99, 111, 109, 47, 114, 101, 112, 111, 115, 47, 114, 97, 122, 45, 108, 97, 110, 103, 117, 97, 103, 101, 47, 112, 97, 99, 107, 97, 103, 101, 115, 47, 97, 99, 116, 105, 111, 110, 115, 47, 119, 111, 114, 107, 102, 108, 111, 119, 115, 47, 114, 101, 103, 105, 115, 116, 114, 121, 45, 97, 100, 109, 105, 110, 46, 121, 109, 108, 47, 100, 105, 115, 112, 97, 116, 99, 104, 101, 115];

    package_append_literal(url, 16384, &mut uc, &endpoint, 98);

    i64 bc = 0;
    i64 open[34] = [123, 34, 114, 101, 102, 34, 58, 34, 109, 97, 105, 110, 34, 44, 34, 105, 110, 112, 117, 116, 115, 34, 58, 123, 34, 97, 99, 116, 105, 111, 110, 34, 58, 34];

    package_append_literal(body, 32768, &mut bc, &open, 34);
    package_append(body, 32768, &mut bc, action, 0, action_length);

    i64 mid1[13] = [34, 44, 34, 112, 97, 99, 107, 97, 103, 101, 34, 58, 34];

    package_append_literal(body, 32768, &mut bc, &mid1, 13);
    package_append(body, 32768, &mut bc, package_name, 0, package_length);

    i64 mid2[11] = [34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34];

    package_append_literal(body, 32768, &mut bc, &mid2, 11);
    package_append(body, 32768, &mut bc, value, 0, value_length);

    i64 close[3] = [34, 125, 125];

    package_append_literal(body, 32768, &mut bc, &close, 3);

    i64 ct[16] = [97, 112, 112, 108, 105, 99, 97, 116, 105, 111, 110, 47, 106, 115, 111, 110];
    i64 i = 0;

    while (i < 16) {
        raz_compiler_rt_arena_set(content_type, i, ct[i]);
        i += 1;
