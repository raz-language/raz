namespace raz_compiler_driver_registry_transport;
public import raz_compiler_driver_signing;
// Registry transport and deterministic package-archive handling. Network policy,
// HTTP framing, TLS pumping, mirror fallback, and archive extraction live in Raz;
// the runtime exports only socket/TLS/filesystem ABI primitives.
fn registry_env_ascii(i64[]key, i64 key_length, i64 output, i64 capacity) -> i64 {
  i64 name = raz_rt_stage1_arena_create(key_length);

  if (name == 0) {
    return -1;
  }

  i64 i = 0;

  while (i<key_length) {
    raz_rt_stage1_arena_set(name, i, key[i]);
    i += 1;
  }

  i64 n = raz_rt_stage1_env_get_ascii(name, key_length, output, capacity);

  raz_rt_stage1_arena_destroy(name);
  return n;
}

fn registry_starts(i64 data, i64 length, i64[]prefix, i64 prefix_length) -> bool {
  if (length<prefix_length) {
    return false;
  }

  i64 i = 0;

  while (i<prefix_length) {
    if (raz_rt_stage1_arena_get(data, i) != prefix[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fn registry_url_parse(
i64 url,
i64 length,
i64 host,
i64 host_capacity,
i64&mut host_length,
i64 path,
i64 path_capacity,
i64&mut path_length,
i64&mut port,
bool&mut secure,
) -> bool {
  i64 http[7] = [104, 116, 116, 112, 58, 47, 47];
  i64 https[8] = [104, 116, 116, 112, 115, 58, 47, 47];
  i64 cursor = 0;

  if (registry_starts(url, length, &https, 8)) {
    *secure = true;
    *port = 443;
    cursor = 8;
  } else if (registry_starts(url, length, &http, 7)) {
    *secure = false;
    *port = 80;
    cursor = 7;
  } else {
    return false;
  }

  i64 hs = cursor;

  while (
  cursor<length &&
  raz_rt_stage1_arena_get(url, cursor) != 47 &&
  raz_rt_stage1_arena_get(url, cursor) != 58
  ) {
    cursor += 1;
  }
  if (cursor <= hs || cursor - hs> host_capacity) {
    return false;
  }
  *host_length = cursor - hs;

  i64 i = 0;

  while (i<*host_length) {
    raz_rt_stage1_arena_set(host, i, raz_rt_stage1_arena_get(url, hs + i));
    i += 1;
  }
  if (cursor<length && raz_rt_stage1_arena_get(url, cursor) == 58) {
    cursor += 1;

    i64 value = 0;
    i64 digits = 0;

    while (
    cursor<length &&
    raz_rt_stage1_arena_get(url, cursor) >= 48 &&
    raz_rt_stage1_arena_get(url, cursor) <= 57
    ) {
      value = value*10 + raz_rt_stage1_arena_get(url, cursor) - 48;
      digits += 1;
      cursor += 1;
    }
    if (digits == 0 || value <= 0 || value> 65535) {
      return false;
    }
    *port = value;
  }
  if (cursor >= length) {
    if (path_capacity<1) {
      return false;
    }
    raz_rt_stage1_arena_set(path, 0, 47);
    *path_length = 1;
    return true;
  }
  if (raz_rt_stage1_arena_get(url, cursor) != 47) {
    return false;
  }
  *path_length = length - cursor;
  if (*path_length> path_capacity) {
    return false;
  }
  i = 0;
  while (i<*path_length) {
    raz_rt_stage1_arena_set(path, i, raz_rt_stage1_arena_get(url, cursor + i));
    i += 1;
  }
  return true;
}

fn registry_tls_flush(i64 tls, i64 socket, i64 scratch, i64 capacity) -> bool {
  while (raz_rt_stage1_tls_pending_encrypted(tls)> 0) {
    i64 count = raz_rt_stage1_tls_drain_ascii(tls, scratch, 0, capacity);

    if (count<0) {
      return false;
    }
    if (count == 0) {
      return true;
    }
    if (raz_rt_stage1_socket_send_ascii(socket, scratch, 0, count) != count) {
      return false;
    }
  }
  return true;
}

fn registry_tls_receive(i64 tls, i64 socket, i64 scratch, i64 capacity) -> i64 {
  i64 count = raz_rt_stage1_socket_receive_ascii(socket, scratch, 0, capacity);

  if (count <= 0) {
    return count;
  }

  i64 used = 0;

  while (used<count) {
    i64 fed = raz_rt_stage1_tls_feed_ascii(tls, scratch, used, count - used);

    if (fed <= 0) {
      return -1;
    }
    used += fed;
  }
  return count;
}

fn registry_tls_connect(i64 host, i64 host_length, i64 socket, i64 scratch, i64 capacity) -> i64 {
  if (raz_rt_stage1_tls_available() != 1) {
    return 0;
  }

  i64 tls = raz_rt_stage1_tls_client_create_ascii(host, host_length);

  if (tls == 0) {
    return 0;
  }
  while (raz_rt_stage1_tls_handshake_finished(tls) != 1) {
    i64 state = raz_rt_stage1_tls_handshake(tls);

    if (!registry_tls_flush(tls, socket, scratch, capacity)) {
      raz_rt_stage1_tls_destroy(tls);
      return 0;
    }
    if (state == 1) {
      return tls;
    }
    if (state<0 || registry_tls_receive(tls, socket, scratch, capacity) <= 0) {
      raz_rt_stage1_tls_destroy(tls);
      return 0;
    }
  }
  return tls;
}

fn registry_transport_request(
i64 host,
i64 host_length,
i64 path,
i64 path_length,
i64 request,
i64 capacity,
) -> i64 {
  i64 cursor = 0;
  i64 a[4] = [71, 69, 84, 32];

  package_append_literal(request, capacity, &mut cursor, &a, 4);
  package_append(request, capacity, &mut cursor, path, 0, path_length);

  i64 b[17] = [32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 72, 111, 115, 116, 58, 32];

  package_append_literal(request, capacity, &mut cursor, &b, 17);
  package_append(request, capacity, &mut cursor, host, 0, host_length);

  i64 c[57] = [13, 10, 85, 115, 101, 114, 45, 65, 103, 101, 110, 116, 58, 32, 82, 97, 122, 47, 49, 46, 48, 13, 10, 65, 99, 99, 101, 112, 116, 58, 32, 42, 47, 42, 13, 10, 67, 111, 110, 110, 101, 99, 116, 105, 111, 110, 58, 32, 99, 108, 111, 115, 101, 13, 10, 13, 10];

  package_append_literal(request, capacity, &mut cursor, &c, 57);
  return cursor;
}

fn registry_http_status(i64 response, i64 length) -> i64 {
  if (length<12) {
    return -1;
  }

  i64 i = 0;

  while (i<length && raz_rt_stage1_arena_get(response, i) != 32) {
    i += 1;
  }
  if (i + 4> length) {
    return -1;
  }
  i += 1;

  i64 status = 0;
  i64 n = 0;

  while (i<length && n<3) {
    i64 ch = raz_rt_stage1_arena_get(response, i);

    if (ch<48 || ch> 57) {
      return -1;
    }
    status = status*10 + ch - 48;
    i += 1;
    n += 1;
  }
  if (n == 3) {
    return status;
  }
  return -1;
}

fn registry_http_body_start(i64 response, i64 length) -> i64 {
  i64 i = 0;

  while (i + 3 < length) {
    if (
    raz_rt_stage1_arena_get(response, i) == 13 &&
    raz_rt_stage1_arena_get(response, i + 1) == 10 &&
    raz_rt_stage1_arena_get(response, i + 2) == 13 &&
    raz_rt_stage1_arena_get(response, i + 3) == 10
    ) {
      return i + 4;
    }
    i += 1;
  }
  return -1;
}

// Fetches a complete HTTP/1.0 response body. Returns body bytes, or a negative error.
fn registry_http_get(i64 url, i64 url_length, i64 output, i64 output_capacity) -> i64 {
  i64 host = raz_rt_stage1_arena_create(2048);
  i64 path = raz_rt_stage1_arena_create(8192);
  i64 request = raz_rt_stage1_arena_create(16384);
  i64 scratch = raz_rt_stage1_arena_create(65536);
  i64 response = raz_rt_stage1_arena_create(output_capacity + 65536);

  if (host == 0 || path == 0 || request == 0 || scratch == 0 || response == 0) {
    return -70;
  }

  i64 hl = 0;
  i64 pl = 0;
  i64 port = 0;
  bool secure = false;

  if (
  !registry_url_parse(url, url_length, host, 2048, &mut hl, path, 8192, &mut pl, &mut port, &mut secure)
  ) {
    return -71;
  }

  i64 socket = raz_rt_stage1_tcp_connect_ascii(host, hl, port);

  if (socket<0) {
    return -72;
  }
  raz_rt_stage1_socket_set_timeout_millis(socket, 10000, 10000);

  i64 tls = 0;

  if (secure) {
    tls = registry_tls_connect(host, hl, socket, scratch, 65536);
    if (tls == 0) {
      raz_rt_stage1_socket_close(socket);
      return -73;
    }
  }

  i64 request_length = registry_transport_request(host, hl, path, pl, request, 16384);

  if (request_length <= 0) {
    return -70;
  }
  if (secure) {
    i64 sent = 0;

    while (sent<request_length) {
      i64 n = raz_rt_stage1_tls_write_plain_ascii(tls, request, sent, request_length - sent);

      if (n<0) {
        return -74;
      }
      if (!registry_tls_flush(tls, socket, scratch, 65536)) {
        return -74;
      }
      if (n> 0) {
        sent += n;
      } else if (registry_tls_receive(tls, socket, scratch, 65536) <= 0) {
        return -74;
      }
    }
  } else if (raz_rt_stage1_socket_send_ascii(socket, request, 0, request_length) != request_length) {
    raz_rt_stage1_socket_close(socket);
    return -74;
  }

  i64 total = 0;
  bool done = false;

  while (!done && total<output_capacity + 65536) {
    i64 available = output_capacity + 65536 - total;

    if (available> 65536) {
      available = 65536;
    }

    i64 n = 0;

    if (secure) {
      n = raz_rt_stage1_tls_read_plain_ascii(tls, response, total, available);
      if (n> 0) {
        total += n;
        continue;
      }
      if (n == -2) {
        break;
      }
      if (n<0) {
        break;
      }

      i64 encrypted = registry_tls_receive(tls, socket, scratch, 65536);

      if (encrypted <= 0) {
        done = true;
      }
    } else {
      n = raz_rt_stage1_socket_receive_ascii(socket, response, total, available);
      if (n> 0) {
        total += n;
      } else {
        done = true;
      }
    }
  }
  if (secure) {
    raz_rt_stage1_tls_shutdown(tls);
    registry_tls_flush(tls, socket, scratch, 65536);
    raz_rt_stage1_tls_destroy(tls);
  }
  raz_rt_stage1_socket_close(socket);

  i64 status = registry_http_status(response, total);
  i64 body = registry_http_body_start(response, total);

  if (status<200 || status >= 300 || body<0) {
    return -75;
  }

  i64 body_length = total - body;

  if (body_length> output_capacity) {
    return -76;
  }

  i64 i = 0;

  while (i<body_length) {
    raz_rt_stage1_arena_set(output, i, raz_rt_stage1_arena_get(response, body + i));
    i += 1;
  }
  raz_rt_stage1_arena_destroy(host);
  raz_rt_stage1_arena_destroy(path);
  raz_rt_stage1_arena_destroy(request);
  raz_rt_stage1_arena_destroy(scratch);
  raz_rt_stage1_arena_destroy(response);
  return body_length;
}

fn registry_join_url(
i64 base,
i64 base_length,
i64 suffix,
i64 suffix_start,
i64 suffix_length,
i64 output,
i64 capacity,
) -> i64 {
  i64 cursor = 0;

  package_append(output, capacity, &mut cursor, base, 0, base_length);
  if (cursor> 0 && raz_rt_stage1_arena_get(output, cursor - 1) == 47) {
    if (suffix_length> 0 && raz_rt_stage1_arena_get(suffix, suffix_start) == 47) {
      suffix_start += 1;
      suffix_length -= 1;
    }
  } else if (suffix_length == 0 || raz_rt_stage1_arena_get(suffix, suffix_start) != 47) {
    i64 slash[1] = [47];

    package_append_literal(output, capacity, &mut cursor, &slash, 1);
  }
  package_append(output, capacity, &mut cursor, suffix, suffix_start, suffix_length);
  return cursor;
}

fn registry_fetch_base_index(i64 base, i64 base_length, i64 output, i64 capacity) -> i64 {
  i64 url = raz_rt_stage1_arena_create(8192);

  if (url == 0) {
    return -70;
  }

  i64 suffix[9] = [105, 110, 100, 101, 120, 46, 116, 120, 116];
  i64 sl = 9;
  i64 tmp = raz_rt_stage1_arena_create(9);
  i64 i = 0;

  while (i<9) {
    raz_rt_stage1_arena_set(tmp, i, suffix[i]);
    i += 1;
  }

  i64 ul = registry_join_url(base, base_length, tmp, 0, sl, url, 8192);
  i64 n = registry_http_get(url, ul, output, capacity);

  raz_rt_stage1_arena_destroy(tmp);
  raz_rt_stage1_arena_destroy(url);
  return n;
}

fn registry_index_cache_path(i64 output, i64 capacity) -> i64 {
  i64 p[21] = [46, 47, 46, 114, 97, 122, 46, 114, 101, 103, 105, 115, 116, 114, 121, 45, 105, 110, 100, 101, 120];

  if (capacity<21) {
    return -1;
  }

  i64 i = 0;

  while (i<21) {
    raz_rt_stage1_arena_set(output, i, p[i]);
    i += 1;
  }
  return 21;
}

fn registry_cache_index(i64 data, i64 length) -> i64 {
  i64 path = raz_rt_stage1_arena_create(22);

  if (path == 0) {
    return -1;
  }

  i64 pl = registry_index_cache_path(path, 22);
  i64 n = raz_rt_stage1_write_ascii(path, pl, data, length);

  raz_rt_stage1_arena_destroy(path);
  return n;
}

fn registry_read_cached_index(i64 output, i64 capacity) -> i64 {
  i64 path = raz_rt_stage1_arena_create(22);

  if (path == 0) {
    return -1;
  }

  i64 pl = registry_index_cache_path(path, 22);
  i64 n = raz_rt_stage1_read_ascii(path, pl, output, capacity);

  raz_rt_stage1_arena_destroy(path);
  return n;
}

// Returns index length and writes the base URL that supplied it. Local index mode writes base length 0.
fn registry_load_index(i64 output, i64 capacity, i64 base, i64 base_capacity, i64&mut base_length) -> i64 {
  i64 local = raz_rt_stage1_arena_create(8192);

  if (local == 0) {
    return -70;
  }

  i64 local_len = registry_index_path(local, 8192);

  if (local_len> 0) {
    i64 n = raz_rt_stage1_read_ascii(local, local_len, output, capacity);

    raz_rt_stage1_arena_destroy(local);
    *base_length = 0;
    return n;
  }
  raz_rt_stage1_arena_destroy(local);
  if (registry_offline()) {
    i64 cached = registry_read_cached_index(output, capacity);

    *base_length = 0;
    if (cached> 0) {
      return cached;
    }
    return -60;
  }

  i64 primary = raz_rt_stage1_arena_create(8192);
  i64 mirrors = raz_rt_stage1_arena_create(32768);

  if (primary == 0 || mirrors == 0) {
    return -70;
  }

  i64 pkey[16] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 85, 82, 76];
  i64 plen = registry_env_ascii(&pkey, 16, primary, 8192);

  if (plen> 0) {
    i64 n = registry_fetch_base_index(primary, plen, output, capacity);

    if (n> 0) {
      if (plen> base_capacity) {
        return -70;
      }

      i64 i = 0;

      while (i<plen) {
        raz_rt_stage1_arena_set(base, i, raz_rt_stage1_arena_get(primary, i));
        i += 1;
      }
      *base_length = plen;
      registry_cache_index(output, n);
      return n;
    }
  }

  i64 mkey[20] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 77, 73, 82, 82, 79, 82, 83];
  i64 ml = registry_env_ascii(&mkey, 20, mirrors, 32768);
  i64 pos = 0;

  while (ml> 0 && pos<ml) {
    while (
    pos<ml &&
    (
    raz_rt_stage1_arena_get(mirrors, pos) == 59 ||
    ascii_is_space(raz_rt_stage1_arena_get(mirrors, pos))
    )
    ) {
      pos += 1;
    }

    i64 start = pos;

    while (pos<ml && raz_rt_stage1_arena_get(mirrors, pos) != 59) {
      pos += 1;
    }

    i64 end = pos;

    while (end> start && ascii_is_space(raz_rt_stage1_arena_get(mirrors, end - 1))) {
      end -= 1;
    }
    if (end> start) {
      i64 n = 0;
      i64 candidate = raz_rt_stage1_arena_create(8192);
      i64 i = 0;

      while (i<end - start) {
        raz_rt_stage1_arena_set(candidate, i, raz_rt_stage1_arena_get(mirrors, start + i));
        i += 1;
      }
      n = registry_fetch_base_index(candidate, end - start, output, capacity);
      if (n> 0) {
        if (end - start> base_capacity) {
          return -70;
        }
        i = 0;
        while (i<end - start) {
          raz_rt_stage1_arena_set(base, i, raz_rt_stage1_arena_get(candidate, i));
          i += 1;
        }
        *base_length = end - start;
        registry_cache_index(output, n);
        raz_rt_stage1_arena_destroy(candidate);
        return n;
      }
      raz_rt_stage1_arena_destroy(candidate);
    }
    if (pos<ml) {
      pos += 1;
    }
  }
  raz_rt_stage1_arena_destroy(primary);
  raz_rt_stage1_arena_destroy(mirrors);
  return -60;
}

fn registry_safe_archive_path(i64 path, i64 length) -> bool {
  if (length <= 0) {
    return false;
  }

  i64 first = raz_rt_stage1_arena_get(path, 0);

  if (first == 47 || first == 92) {
    return false;
  }

  i64 i = 0;
  i64 component = 0;

  while (i <= length) {
    if (i == length || raz_rt_stage1_arena_get(path, i) == 47) {
      if (
      i - component == 2 &&
      raz_rt_stage1_arena_get(path, component) == 46 &&
      raz_rt_stage1_arena_get(path, component + 1) == 46
      ) {
        return false;
      }
      if (i == component) {
        return false;
      }
      component = i + 1;
    } else {
      if (raz_rt_stage1_arena_get(path, i) == 92 || raz_rt_stage1_arena_get(path, i) == 58) {
        return false;
      }
    }
    i += 1;
  }
  return true;
}

fn registry_decode_hex(i64 source, i64 start, i64 length, i64 output, i64 capacity) -> i64 {
  if ((length&1) != 0 || length / 2> capacity) {
    return -1;
  }

  i64 i = 0;

  while (i<length) {
    i64 a = registry_hex_value(raz_rt_stage1_arena_get(source, start + i));
    i64 b = registry_hex_value(raz_rt_stage1_arena_get(source, start + i + 1));

    if (a<0 || b<0) {
      return -1;
    }
    raz_rt_stage1_arena_set(output, i / 2, a*16 + b);
    i += 2;
  }
  return length / 2;
}

fn registry_extract_archive(i64 archive, i64 length, i64 destination, i64 destination_length) -> i64 {
  i64 header[8] = [82, 65, 90, 80, 75, 71, 49, 10];

  if (length<8) {
    return 66;
  }

  i64 i = 0;

  while (i<8) {
    if (raz_rt_stage1_arena_get(archive, i) != header[i]) {
      return 66;
    }
    i += 1;
  }
  raz_rt_stage1_remove_path_ascii(destination, destination_length);
  if (raz_rt_stage1_create_dir_ascii(destination, destination_length) != 0) {
    return 65;
  }

  i64 pos = 8;

  while (pos<length) {
    i64 start = pos;

    while (pos<length && raz_rt_stage1_arena_get(archive, pos) != 10) {
      pos += 1;
    }

    i64 end = pos;

    if (pos<length) {
      pos += 1;
    }
    if (start == end) {
      continue;
    }
    if (
    end - start<4 ||
    raz_rt_stage1_arena_get(archive, start) != 70 ||
    raz_rt_stage1_arena_get(archive, start + 1) != 32
    ) {
      return 66;
    }

    i64 sep = start + 2;

    while (sep<end && raz_rt_stage1_arena_get(archive, sep) != 32) {
      sep += 1;
    }
    if (sep >= end) {
      return 66;
    }

    i64 path = raz_rt_stage1_arena_create(4096);
    i64 data = raz_rt_stage1_arena_create((end - sep) / 2 + 1);
    i64 full = raz_rt_stage1_arena_create(8192);

    if (path == 0 || data == 0 || full == 0) {
      return 40;
    }

    i64 pl = registry_decode_hex(archive, start + 2, sep - (start + 2), path, 4096);
    i64 dl = registry_decode_hex(archive, sep + 1, end - (sep + 1), data, (end - sep) / 2 + 1);

    if (pl <= 0 || dl<0 || !registry_safe_archive_path(path, pl)) {
      return 66;
    }

    i64 cursor = 0;

    package_append(full, 8192, &mut cursor, destination, 0, destination_length);

    i64 slash[1] = [47];

    package_append_literal(full, 8192, &mut cursor, &slash, 1);
    package_append(full, 8192, &mut cursor, path, 0, pl);

    i64 parent = cursor - 1;

    while (parent >= 0 && raz_rt_stage1_arena_get(full, parent) != 47) {
      parent -= 1;
    }
    if (parent> 0 && raz_rt_stage1_create_dir_ascii(full, parent) != 0) {
      return 65;
    }
    if (raz_rt_stage1_write_ascii(full, cursor, data, dl) != dl) {
      return 65;
    }
    raz_rt_stage1_arena_destroy(path);
    raz_rt_stage1_arena_destroy(data);
    raz_rt_stage1_arena_destroy(full);
  }
  return 0;
}

fn registry_store_materialize_archive(
i64 url,
i64 url_length,
i64 checksum,
i64 checksum_length,
i64 output,
i64 capacity,
) -> i64 {
  i64 store_length = registry_store_path(checksum, checksum_length, output, capacity);

  if (store_length <= 0) {
    return 40;
  }
  if (raz_rt_stage1_path_exists_ascii(output, store_length) != 0) {
    if (registry_store_verify(output, store_length, checksum, checksum_length)) {
      return store_length;
    }
    if (registry_offline()) {
      return -63;
    }
  }
  if (registry_offline()) {
    return -64;
  }

  i64 archive = raz_rt_stage1_arena_create(33554432);

  if (archive == 0) {
    return -70;
  }

  i64 n = registry_http_get(url, url_length, archive, 33554432);

  if (n <= 0) {
    raz_rt_stage1_arena_destroy(archive);
    return -67;
  }

  i64 unpack = registry_extract_archive(archive, n, output, store_length);

  raz_rt_stage1_arena_destroy(archive);
  if (unpack != 0) {
    return -unpack;
  }
  if (!registry_store_verify(output, store_length, checksum, checksum_length)) {
    raz_rt_stage1_remove_path_ascii(output, store_length);
    return -62;
  }
  return store_length;
}

// Publishing/packing support. Directory enumeration is a permanent filesystem ABI
// boundary; archive encoding and HTTP publishing policy remain in Raz.
fn registry_hex_digit(i64 value) -> i64 {
  if (value<10) {
    return 48 + value;
  }
  return 87 + value;
}

fn registry_append_hex_bytes(
i64 output,
i64 capacity,
i64&mut cursor,
i64 data,
i64 start,
i64 length,
) -> bool {
  if (*cursor + length*2> capacity) {
    return false;
  }

  i64 i = 0;

  while (i<length) {
    i64 b = raz_rt_stage1_arena_get(data, start + i)&255;

    raz_rt_stage1_arena_set(output, *cursor, registry_hex_digit((b >> 4)&15));
    *cursor += 1;
    raz_rt_stage1_arena_set(output, *cursor, registry_hex_digit(b&15));
    *cursor += 1;
    i += 1;
  }
  return true;
}

fn registry_append_decimal(i64 output, i64 capacity, i64&mut cursor, i64 value) -> bool {
  i64 digits = raz_rt_stage1_arena_create(32);

  if (digits == 0) {
    return false;
  }

  i64 count = 0;

  if (value == 0) {
    raz_rt_stage1_arena_set(digits, count, 48);
    count += 1;
  } else {
    while (value> 0 && count<32) {
      raz_rt_stage1_arena_set(digits, count, 48 + (value % 10));
      count += 1;
      value /= 10;
    }
  }
  if (*cursor + count> capacity) {
    raz_rt_stage1_arena_destroy(digits);
    return false;
  }
  while (count> 0) {
    count -= 1;
    raz_rt_stage1_arena_set(output, *cursor, raz_rt_stage1_arena_get(digits, count));
    *cursor += 1;
  }
  raz_rt_stage1_arena_destroy(digits);
  return true;
}

fn registry_pack_tree(i64 root, i64 root_length, i64 archive, i64 archive_capacity) -> i64 {
  i64 listing = raz_rt_stage1_arena_create(4194304);

  if (listing == 0) {
    return -40;
  }

  i64 ll = raz_rt_stage1_tree_list_ascii(root, root_length, listing, 4194304);

  if (ll<0) {
    raz_rt_stage1_arena_destroy(listing);
    return -65;
  }

  i64 cursor = 0;
  i64 header[8] = [82, 65, 90, 80, 75, 71, 49, 10];

  if (!package_append_literal(archive, archive_capacity, &mut cursor, &header, 8)) {
    return -40;
  }

  i64 pos = 0;

  while (pos<ll) {
    i64 start = pos;

    while (pos<ll && raz_rt_stage1_arena_get(listing, pos) != 10) {
      pos += 1;
    }

    i64 pl = pos - start;

    if (pos<ll) {
      pos += 1;
    }
    if (pl <= 0) {
      continue;
    }

    i64 rel = raz_rt_stage1_arena_create(pl);

    if (rel == 0) {
      return -40;
    }

    i64 r = 0;

    while (r<pl) {
      raz_rt_stage1_arena_set(rel, r, raz_rt_stage1_arena_get(listing, start + r));
      r += 1;
    }

    bool ignored = registry_package_path_ignored(rel, pl);

    raz_rt_stage1_arena_destroy(rel);
    if (ignored) {
      continue;
    }

    i64 full = raz_rt_stage1_arena_create(8192);
    i64 data = raz_rt_stage1_arena_create(33554432);

    if (full == 0 || data == 0) {
      return -40;
    }

    i64 fc = 0;

    package_append(full, 8192, &mut fc, root, 0, root_length);
    if (
    fc> 0 &&
    raz_rt_stage1_arena_get(full, fc - 1) != 47 &&
    raz_rt_stage1_arena_get(full, fc - 1) != 92
    ) {
      i64 slash[1] = [47];

      package_append_literal(full, 8192, &mut fc, &slash, 1);
    }
    package_append(full, 8192, &mut fc, listing, start, pl);

    i64 dl = raz_rt_stage1_read_ascii(full, fc, data, 33554432);

    if (dl<0) {
      return -65;
    }

    i64 f[2] = [70, 32];

    if (
    !package_append_literal(archive, archive_capacity, &mut cursor, &f, 2) ||
    !registry_append_hex_bytes(archive, archive_capacity, &mut cursor, listing, start, pl)
    ) {
      return -40;
    }

    i64 sp[1] = [32];

    package_append_literal(archive, archive_capacity, &mut cursor, &sp, 1);
    if (!registry_append_hex_bytes(archive, archive_capacity, &mut cursor, data, 0, dl)) {
      return -40;
    }

    i64 nl[1] = [10];

    package_append_literal(archive, archive_capacity, &mut cursor, &nl, 1);
    raz_rt_stage1_arena_destroy(full);
    raz_rt_stage1_arena_destroy(data);
  }
  raz_rt_stage1_arena_destroy(listing);
  return cursor;
}

fn registry_http_put(
i64 url,
i64 url_length,
i64 body,
i64 body_length,
i64 content_type,
i64 content_type_length,
) -> i64 {
  i64 host = raz_rt_stage1_arena_create(2048);
  i64 path = raz_rt_stage1_arena_create(8192);
  i64 request = raz_rt_stage1_arena_create(body_length + 32768);
  i64 scratch = raz_rt_stage1_arena_create(65536);
  i64 response = raz_rt_stage1_arena_create(131072);

  if (host == 0 || path == 0 || request == 0 || scratch == 0 || response == 0) {
    return -70;
  }

  i64 hl = 0;
  i64 pl = 0;
  i64 port = 0;
  bool secure = false;

  if (
  !registry_url_parse(url, url_length, host, 2048, &mut hl, path, 8192, &mut pl, &mut port, &mut secure)
  ) {
    return -71;
  }

  i64 socket = raz_rt_stage1_tcp_connect_ascii(host, hl, port);

  if (socket<0) {
    return -72;
  }
  raz_rt_stage1_socket_set_timeout_millis(socket, 15000, 15000);

  i64 tls = 0;

  if (secure) {
    tls = registry_tls_connect(host, hl, socket, scratch, 65536);
    if (tls == 0) {
      raz_rt_stage1_socket_close(socket);
      return -73;
    }
  }

  i64 cursor = 0;
  i64 a[4] = [80, 85, 84, 32];

  package_append_literal(request, body_length + 32768, &mut cursor, &a, 4);
  package_append(request, body_length + 32768, &mut cursor, path, 0, pl);

  i64 b[17] = [32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 72, 111, 115, 116, 58, 32];

  package_append_literal(request, body_length + 32768, &mut cursor, &b, 17);
  package_append(request, body_length + 32768, &mut cursor, host, 0, hl);

  i64 ct[16] = [13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 84, 121, 112, 101, 58, 32];

  package_append_literal(request, body_length + 32768, &mut cursor, &ct, 16);
  package_append(request, body_length + 32768, &mut cursor, content_type, 0, content_type_length);

  i64 clh[18] = [13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 76, 101, 110, 103, 116, 104, 58, 32];

  package_append_literal(request, body_length + 32768, &mut cursor, &clh, 18);
  registry_append_decimal(request, body_length + 32768, &mut cursor, body_length);

  i64 token = raz_rt_stage1_arena_create(8192);
  i64 tkey[18] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 84, 79, 75, 69, 78];
  i64 tl = registry_env_ascii(&tkey, 18, token, 8192);

  if (tl> 0) {
    i64 ah[24] = [13, 10, 65, 117, 116, 104, 111, 114, 105, 122, 97, 116, 105, 111, 110, 58, 32, 66, 101, 97, 114, 101, 114, 32];

    package_append_literal(request, body_length + 32768, &mut cursor, &ah, 24);
    package_append(request, body_length + 32768, &mut cursor, token, 0, tl);
  }
  raz_rt_stage1_arena_destroy(token);
  // Optional detached-signature hook for private registries. Raz does not
  // prescribe a signing algorithm here; CI/release tooling may provide a
  // precomputed signature and the registry decides how to verify it.

  i64 signature = raz_rt_stage1_arena_create(8192);
  i64 skey[22] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 83, 73, 71, 78, 65, 84, 85, 82, 69];
  i64 sl = registry_env_ascii(&skey, 22, signature, 8192);

  if (sl> 0) {
    i64 sh[19] = [13, 10, 88, 45, 82, 97, 122, 45, 83, 105, 103, 110, 97, 116, 117, 114, 101, 58, 32];

    package_append_literal(request, body_length + 32768, &mut cursor, &sh, 19);
    package_append(request, body_length + 32768, &mut cursor, signature, 0, sl);
  }
  raz_rt_stage1_arena_destroy(signature);

  i64 tail[23] = [13, 10, 67, 111, 110, 110, 101, 99, 116, 105, 111, 110, 58, 32, 99, 108, 111, 115, 101, 13, 10, 13, 10];

  package_append_literal(request, body_length + 32768, &mut cursor, &tail, 23);
  package_append(request, body_length + 32768, &mut cursor, body, 0, body_length);

  i64 sent = 0;

  if (secure) {
    while (sent<cursor) {
      i64 n = raz_rt_stage1_tls_write_plain_ascii(tls, request, sent, cursor - sent);

      if (n<0) {
        return -74;
      }
      if (!registry_tls_flush(tls, socket, scratch, 65536)) {
        return -74;
      }
      if (n> 0) {
        sent += n;
      } else if (registry_tls_receive(tls, socket, scratch, 65536) <= 0) {
        return -74;
      }
    }
  } else {
    while (sent<cursor) {
      i64 n = raz_rt_stage1_socket_send_ascii(socket, request, sent, cursor - sent);

      if (n <= 0) {
        return -74;
      }
      sent += n;
    }
  }

  i64 total = 0;
  bool done = false;

  while (!done && total<131072) {
    i64 n = 0;

    if (secure) {
      n = raz_rt_stage1_tls_read_plain_ascii(tls, response, total, 131072 - total);
      if (n> 0) {
        total += n;
        continue;
      }
      if (n == -2) {
        break;
      }
      if (n<0) {
        break;
      }
      if (registry_tls_receive(tls, socket, scratch, 65536) <= 0) {
        done = true;
      }
    } else {
      n = raz_rt_stage1_socket_receive_ascii(socket, response, total, 131072 - total);
      if (n> 0) {
        total += n;
      } else {
        done = true;
      }
    }
  }
  if (secure) {
    raz_rt_stage1_tls_shutdown(tls);
    registry_tls_flush(tls, socket, scratch, 65536);
    raz_rt_stage1_tls_destroy(tls);
  }
  raz_rt_stage1_socket_close(socket);

  i64 status = registry_http_status(response, total);

  raz_rt_stage1_arena_destroy(host);
  raz_rt_stage1_arena_destroy(path);
  raz_rt_stage1_arena_destroy(request);
  raz_rt_stage1_arena_destroy(scratch);
  raz_rt_stage1_arena_destroy(response);
  if (status<200 || status >= 300) {
    return -75;
  }
  return status;
}

fn registry_ends_dpk(i64 path, i64 length) -> bool {
  if (length<4) {
    return false;
  }

  i64 ext[4] = [46, 100, 112, 107];
  i64 i = 0;

  while (i<4) {
    if (raz_rt_stage1_arena_get(path, length - 4 + i) != ext[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fn registry_store_materialize_local_archive(
i64 source,
i64 source_length,
i64 checksum,
i64 checksum_length,
i64 output,
i64 capacity,
) -> i64 {
  i64 store_length = registry_store_path(checksum, checksum_length, output, capacity);

  if (store_length <= 0) {
    return 40;
  }
  if (raz_rt_stage1_path_exists_ascii(output, store_length) != 0) {
    if (registry_store_verify(output, store_length, checksum, checksum_length)) {
      return store_length;
    }
    if (registry_offline()) {
      return -63;
    }
  }
  if (registry_offline()) {
    return -64;
  }

  i64 archive = raz_rt_stage1_arena_create(67108864);

  if (archive == 0) {
    return -70;
  }

  i64 n = raz_rt_stage1_read_ascii(source, source_length, archive, 67108864);

  if (n <= 0) {
    raz_rt_stage1_arena_destroy(archive);
    return -67;
  }

  i64 unpack = registry_extract_archive(archive, n, output, store_length);

  raz_rt_stage1_arena_destroy(archive);
  if (unpack != 0) {
    return -unpack;
  }
  if (!registry_store_verify(output, store_length, checksum, checksum_length)) {
    raz_rt_stage1_remove_path_ascii(output, store_length);
    return -62;
  }
  return store_length;
}

fn registry_path_prefix(i64 path, i64 length, i64[]prefix, i64 pl) -> bool {
  if (length<pl) {
    return false;
  }

  i64 i = 0;

  while (i<pl) {
    if (raz_rt_stage1_arena_get(path, i) != prefix[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fn registry_package_path_ignored(i64 path, i64 length) -> bool {
  i64 git[5] = [46, 103, 105, 116, 47];

  if (registry_path_prefix(path, length, &git, 5)) {
    return true;
  }

  i64 razd[5] = [46, 114, 97, 122, 47];

  if (registry_path_prefix(path, length, &razd, 5)) {
    return true;
  }

  i64 build[6] = [98, 117, 105, 108, 100, 47];

  if (registry_path_prefix(path, length, &build, 6)) {
    return true;
  }

  i64 target[7] = [116, 97, 114, 103, 101, 116, 47];

  if (registry_path_prefix(path, length, &target, 7)) {
    return true;
  }

  i64 diag[21] = [115, 116, 97, 103, 101, 49, 45, 100, 105, 97, 103, 110, 111, 115, 116, 105, 99, 46, 116, 120, 116];

  if (length == 21) {
    i64 i = 0;
    bool same = true;

    while (i<21) {
      if (raz_rt_stage1_arena_get(path, i) != diag[i]) {
        same = false;
      }
      i += 1;
    }
    if (same) {
      return true;
    }
  }
  if (registry_ends_dpk(path, length)) {
    return true;
  }
  return false;
}

fn registry_tree_hash(i64 root, i64 root_length) -> i64 {
  i64 listing = raz_rt_stage1_arena_create(4194304);

  if (listing == 0) {
    return 0;
  }

  i64 ll = raz_rt_stage1_tree_list_ascii(root, root_length, listing, 4194304);

  if (ll<0) {
    return 0;
  }

  i64 hash = 1469598103934665603;
  i64 prime = 1099511628211;
  i64 pos = 0;

  while (pos<ll) {
    i64 st = pos;

    while (pos<ll && raz_rt_stage1_arena_get(listing, pos) != 10) {
      pos += 1;
    }

    i64 pl = pos - st;

    if (pos<ll) {
      pos += 1;
    }
    if (pl <= 0) {
      continue;
    }

    i64 rel = raz_rt_stage1_arena_create(pl);

    if (rel == 0) {
      return 0;
    }

    i64 ri = 0;

    while (ri<pl) {
      raz_rt_stage1_arena_set(rel, ri, raz_rt_stage1_arena_get(listing, st + ri));
      ri += 1;
    }

    bool ignored = registry_package_path_ignored(rel, pl);

    raz_rt_stage1_arena_destroy(rel);
    if (ignored) {
      continue;
    }

    i64 i = 0;

    while (i<pl) {
      hash = (hash ^ (raz_rt_stage1_arena_get(listing, st + i)&255))*prime;
      i += 1;
    }
    hash = (hash ^ 0)*prime;

    i64 full = raz_rt_stage1_arena_create(8192);
    i64 data = raz_rt_stage1_arena_create(33554432);

    if (full == 0 || data == 0) {
      return 0;
    }

    i64 c = 0;

    package_append(full, 8192, &mut c, root, 0, root_length);
    if (
    c> 0 &&
    raz_rt_stage1_arena_get(full, c - 1) != 47 &&
    raz_rt_stage1_arena_get(full, c - 1) != 92
    ) {
      i64 slash[1] = [47];

      package_append_literal(full, 8192, &mut c, &slash, 1);
    }
    package_append(full, 8192, &mut c, listing, st, pl);

    i64 dl = raz_rt_stage1_read_ascii(full, c, data, 33554432);

    if (dl<0) {
      return 0;
    }
    i = 0;
    while (i<dl) {
      hash = (hash ^ (raz_rt_stage1_arena_get(data, i)&255))*prime;
      i += 1;
    }
    hash = (hash ^ 255)*prime;
    raz_rt_stage1_arena_destroy(full);
    raz_rt_stage1_arena_destroy(data);
  }
  raz_rt_stage1_arena_destroy(listing);
  return hash;
}

// Shared registry environment/store primitives live with transport so the
// registry policy layer can depend on transport without a semantic import cycle.
fn registry_hex_value(i64 value) -> i64 {
  if (value >= 48 && value <= 57) {
    return value - 48;
  }
  if (value >= 97 && value <= 102) {
    return value - 87;
  }
  if (value >= 65 && value <= 70) {
    return value - 55;
  }
  return -1;
}

fn registry_index_path(i64 output, i64 capacity) -> i64 {
  i64 name = raz_rt_stage1_arena_create(19);

  if (name == 0) {
    return -1;
  }

  i64 n[18] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 73, 78, 68, 69, 88];
  i64 i = 0;

  while (i<18) {
    raz_rt_stage1_arena_set(name, i, n[i]);
    i += 1;
  }

  i64 length = raz_rt_stage1_env_get_ascii(name, 18, output, capacity);

  raz_rt_stage1_arena_destroy(name);
  return length;
}

fn registry_env_flag(i64[]key, i64 key_length) -> bool {
  i64 name = raz_rt_stage1_arena_create(key_length);
  i64 value = raz_rt_stage1_arena_create(16);

  if (name == 0 || value == 0) {
    return false;
  }

  i64 i = 0;

  while (i<key_length) {
    raz_rt_stage1_arena_set(name, i, key[i]);
    i += 1;
  }

  i64 length = raz_rt_stage1_env_get_ascii(name, key_length, value, 16);
  bool enabled = false;

  if (length> 0) {
    i64 first = raz_rt_stage1_arena_get(value, 0);

    enabled = first == 49 || first == 116 || first == 84 || first == 121 || first == 89;
  }
  raz_rt_stage1_arena_destroy(name);
  raz_rt_stage1_arena_destroy(value);
  return enabled;
}

fn registry_offline() -> bool {
  i64 key[11] = [82, 65, 90, 95, 79, 70, 70, 76, 73, 78, 69];

  return registry_env_flag(&key, 11);
}

fn registry_store_root(i64 output, i64 capacity) -> i64 {
  i64 store_key[17] = [82, 65, 90, 95, 80, 65, 67, 75, 65, 71, 69, 95, 83, 84, 79, 82, 69];
  i64 length = registry_env_ascii(&store_key, 17, output, capacity);

  if (length> 0) {
    return length;
  }

  i64 home = raz_rt_stage1_arena_create(8192);

  if (home == 0) {
    return -1;
  }

  i64 raz_home_key[8] = [82, 65, 90, 95, 72, 79, 77, 69];
  i64 hl = registry_env_ascii(&raz_home_key, 8, home, 8192);

  if (hl> 0) {
    if (hl + 6> capacity) {
      raz_rt_stage1_arena_destroy(home);
      return -1;
    }

    i64 i = 0;

    while (i<hl) {
      raz_rt_stage1_arena_set(output, i, raz_rt_stage1_arena_get(home, i));
      i += 1;
    }

    i64 tail[6] = [47, 115, 116, 111, 114, 101];

    i = 0;
    while (i<6) {
      raz_rt_stage1_arena_set(output, hl + i, tail[i]);
      i += 1;
    }
    raz_rt_stage1_arena_destroy(home);
    return hl + 6;
  }

  i64 home_key[4] = [72, 79, 77, 69];

  hl = registry_env_ascii(&home_key, 4, home, 8192);
  if (hl <= 0) {
    i64 profile_key[11] = [85, 83, 69, 82, 80, 82, 79, 70, 73, 76, 69];

    hl = registry_env_ascii(&profile_key, 11, home, 8192);
  }
  if (hl> 0) {
    if (hl + 12> capacity) {
      raz_rt_stage1_arena_destroy(home);
      return -1;
    }

    i64 i = 0;

    while (i<hl) {
      raz_rt_stage1_arena_set(output, i, raz_rt_stage1_arena_get(home, i));
      i += 1;
    }

    i64 tail[11] = [47, 46, 114, 97, 122, 47, 115, 116, 111, 114, 101];

    i = 0;
    while (i<11) {
      raz_rt_stage1_arena_set(output, hl + i, tail[i]);
      i += 1;
    }
    raz_rt_stage1_arena_destroy(home);
    return hl + 11;
  }
  raz_rt_stage1_arena_destroy(home);

  i64 fallback[12] = [46, 47, 46, 114, 97, 122, 47, 115, 116, 111, 114, 101];

  if (capacity<12) {
    return -1;
  }

  i64 i = 0;

  while (i<12) {
    raz_rt_stage1_arena_set(output, i, fallback[i]);
    i += 1;
  }
  return 12;
}

fn registry_store_path(i64 checksum, i64 checksum_length, i64 output, i64 capacity) -> i64 {
  i64 root = raz_rt_stage1_arena_create(8192);

  if (root == 0) {
    return -1;
  }

  i64 rl = registry_store_root(root, 8192);

  if (rl <= 0 || rl + 1 + checksum_length> capacity) {
    raz_rt_stage1_arena_destroy(root);
    return -1;
  }

  i64 i = 0;

  while (i<rl) {
    raz_rt_stage1_arena_set(output, i, raz_rt_stage1_arena_get(root, i));
    i += 1;
  }
  raz_rt_stage1_arena_set(output, rl, 47);
  i = 0;
  while (i<checksum_length) {
    raz_rt_stage1_arena_set(output, rl + 1 + i, raz_rt_stage1_arena_get(checksum, i));
    i += 1;
  }

  i64 total = rl + 1 + checksum_length;

  if (total<capacity) {
    raz_rt_stage1_arena_set(output, total, 0);
  }
  raz_rt_stage1_arena_destroy(root);
  return total;
}

fn registry_store_verify(i64 path, i64 path_length, i64 checksum, i64 checksum_length) -> bool {
  i64 hash = registry_tree_hash(path, path_length);

  if (hash == 0) {
    return false;
  }
  return registry_hex64_matches(checksum, 0, checksum_length, hash);
}

fn registry_hex64_matches(i64 data, i64 start, i64 length, i64 value) -> bool {
  if (length != 16) {
    return false;
  }

  i64 shift = 60;
  i64 i = 0;

  while (i<16) {
    i64 nib = registry_hex_value(raz_rt_stage1_arena_get(data, start + i));

    if (nib<0 || nib != ((value >> shift)&15)) {
      return false;
    }
    shift -= 4;
    i += 1;
  }
  return true;
}
