    i64 status = registry_http_post(url, uc, body, bc, content_type, 16);

    raz_compiler_rt_arena_destroy(url);
    raz_compiler_rt_arena_destroy(body);
    raz_compiler_rt_arena_destroy(content_type);
    if (status < 0) {
        return status;
    }
    return 1;
}

fn registry_http_write(
    i64 method,
    i64 url,
    i64 url_length,
    i64 body,
    i64 body_length,
    i64 content_type,
    i64 content_type_length,
) -> i64 {
    i64 host = raz_compiler_rt_arena_create(2048);
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 request = raz_compiler_rt_arena_create(body_length + 32768);
    i64 scratch = raz_compiler_rt_arena_create(65536);
    i64 response = raz_compiler_rt_arena_create(131072);

    if (host == 0 || path == 0 || request == 0 || scratch == 0 || response == 0) {
        return -70;
    }

    i64 hl = 0;
    i64 pl = 0;
    i64 port = 0;
    bool secure = false;

    if (
        !registry_url_parse(url, url_length, host, 2048, &mut hl, path, 8192, &mut pl, &mut port, &mut secure)
    ) {
        return -71;
    }

    i64 socket = raz_compiler_rt_tcp_connect_ascii(host, hl, port);

    if (socket<0) {
        return -72;
    }
    raz_compiler_rt_socket_set_timeout_millis(socket, 15000, 15000);

    i64 tls = 0;

    if (secure) {
        tls = registry_tls_connect(host, hl, socket, scratch, 65536);
        if (tls == 0) {
            raz_compiler_rt_socket_close(socket);
            return -73;
        }
    }

    i64 cursor = 0;

    if (method == 1) {
        i64 post[5] = [80, 79, 83, 84, 32];

        package_append_literal(request, body_length + 32768, &mut cursor, &post, 5);
    } else {
        i64 put[4] = [80, 85, 84, 32];

        package_append_literal(request, body_length + 32768, &mut cursor, &put, 4);
    }
    package_append(request, body_length + 32768, &mut cursor, path, 0, pl);

    i64 b[17] = [32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 72, 111, 115, 116, 58, 32];

    package_append_literal(request, body_length + 32768, &mut cursor, &b, 17);
    package_append(request, body_length + 32768, &mut cursor, host, 0, hl);

    i64 ct[16] = [13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 84, 121, 112, 101, 58, 32];

    package_append_literal(request, body_length + 32768, &mut cursor, &ct, 16);
    package_append(request, body_length + 32768, &mut cursor, content_type, 0, content_type_length);

    i64 clh[18] = [13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 76, 101, 110, 103, 116, 104, 58, 32];

    package_append_literal(request, body_length + 32768, &mut cursor, &clh, 18);
    registry_append_decimal(request, body_length + 32768, &mut cursor, body_length);

    i64 token = raz_compiler_rt_arena_create(8192);
    bool github_api = hl == 14;
    i64 gh_host[14] = [97, 112, 105, 46, 103, 105, 116, 104, 117, 98, 46, 99, 111, 109];
    i64 gh_i = 0;

    while (github_api && gh_i<14) {
        if (raz_compiler_rt_arena_get(host, gh_i) != gh_host[gh_i]) {
            github_api = false;
        }
        gh_i += 1;
    }

    i64 tl = registry_publish_token(token, 8192, github_api);

    if (tl> 0) {
        i64 ah[24] = [13, 10, 65, 117, 116, 104, 111, 114, 105, 122, 97, 116, 105, 111, 110, 58, 32, 66, 101, 97, 114, 101, 114, 32];

        package_append_literal(request, body_length + 32768, &mut cursor, &ah, 24);
        package_append(request, body_length + 32768, &mut cursor, token, 0, tl);
    }
    raz_compiler_rt_arena_destroy(token);
    // Optional detached-signature hook for private registries. Raz does not
    // prescribe a signing algorithm here; CI/release tooling may provide a
    // precomputed signature and the registry decides how to verify it.

    i64 signature = raz_compiler_rt_arena_create(8192);
    i64 skey[22] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 83, 73, 71, 78, 65, 84, 85, 82, 69];
    i64 sl = registry_env_ascii(&skey, 22, signature, 8192);

    if (sl> 0) {
        i64 sh[19] = [13, 10, 88, 45, 82, 97, 122, 45, 83, 105, 103, 110, 97, 116, 117, 114, 101, 58, 32];

        package_append_literal(request, body_length + 32768, &mut cursor, &sh, 19);
        package_append(request, body_length + 32768, &mut cursor, signature, 0, sl);
    }
    raz_compiler_rt_arena_destroy(signature);
    // GitHub requires a User-Agent for REST API requests. These headers are
    // harmless for generic/private registries and let the same transport serve
    // both the static official registry and GitHub Contents publishing.

    i64 api_headers[92] = [13, 10, 85, 115, 101, 114, 45, 65, 103, 101, 110, 116, 58, 32, 82, 97, 122, 47, 49, 46, 48, 13, 10, 65, 99, 99, 101, 112, 116, 58, 32, 97, 112, 112, 108, 105, 99, 97, 116, 105, 111, 110, 47, 118, 110, 100, 46, 103, 105, 116, 104, 117, 98, 43, 106, 115, 111, 110, 13, 10, 88, 45, 71, 105, 116, 72, 117, 98, 45, 65, 112, 105, 45, 86, 101, 114, 115, 105, 111, 110, 58, 32, 50, 48, 50, 54, 45, 48, 51, 45, 49, 48];

    package_append_literal(request, body_length + 32768, &mut cursor, &api_headers, 92);

    i64 tail[23] = [13, 10, 67, 111, 110, 110, 101, 99, 116, 105, 111, 110, 58, 32, 99, 108, 111, 115, 101, 13, 10, 13, 10];

    package_append_literal(request, body_length + 32768, &mut cursor, &tail, 23);
    package_append(request, body_length + 32768, &mut cursor, body, 0, body_length);

    i64 sent = 0;

    if (secure) {
        while (sent<cursor) {
            i64 n = raz_compiler_rt_tls_write_plain_ascii(tls, request, sent, cursor - sent);

            if (n<0) {
                return -74;
            }
            if (!registry_tls_flush(tls, socket, scratch, 65536)) {
                return -74;
            }
            if (n> 0) {
                sent += n;
            } else if (registry_tls_receive(tls, socket, scratch, 65536) <= 0) {
                return -74;
            }
        }
    } else {
        while (sent<cursor) {
            i64 n = raz_compiler_rt_socket_send_ascii(socket, request, sent, cursor - sent);

            if (n <= 0) {
                return -74;
            }
            sent += n;
        }
    }

    i64 total = 0;
    bool done = false;

    while (!done && total<131072) {
        i64 n = 0;

        if (secure) {
            n = raz_compiler_rt_tls_read_plain_ascii(tls, response, total, 131072 - total);
            if (n> 0) {
                total += n;
                continue;
            }
            if (n == -2) {
                break;
            }
            if (n<0) {
                break;
            }
            if (registry_tls_receive(tls, socket, scratch, 65536) <= 0) {
                done = true;
            }
        } else {
            n = raz_compiler_rt_socket_receive_ascii(socket, response, total, 131072 - total);
            if (n> 0) {
                total += n;
            } else {
                done = true;
            }
        }
    }
    if (secure) {
        raz_compiler_rt_tls_shutdown(tls);
        registry_tls_flush(tls, socket, scratch, 65536);
        raz_compiler_rt_tls_destroy(tls);
    }
    raz_compiler_rt_socket_close(socket);

    i64 status = registry_http_status(response, total);

    raz_compiler_rt_arena_destroy(host);
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(request);
    raz_compiler_rt_arena_destroy(scratch);
    raz_compiler_rt_arena_destroy(response);
    if (status<200 || status >= 300) {
        return -75;
    }
    return status;
}

fn registry_http_put(
    i64 url,
    i64 url_length,
    i64 body,
    i64 body_length,
    i64 content_type,
    i64 content_type_length,
) -> i64 {
    return registry_http_write(0, url, url_length, body, body_length, content_type, content_type_length);
}

fn registry_http_post(
    i64 url,
    i64 url_length,
    i64 body,
    i64 body_length,
    i64 content_type,
    i64 content_type_length,
) -> i64 {
    return registry_http_write(1, url, url_length, body, body_length, content_type, content_type_length);
}

fn registry_ends_dpk(i64 path, i64 length) -> bool {
    if (length<4) {
        return false;
    }

    i64 ext[4] = [46, 100, 112, 107];
    i64 i = 0;

    while (i<4) {
        if (raz_compiler_rt_arena_get(path, length - 4 + i) != ext[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn registry_store_materialize_local_archive(
    i64 source,
    i64 source_length,
    i64 checksum,
    i64 checksum_length,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 store_length = registry_store_path(checksum, checksum_length, output, capacity);

    if (store_length <= 0) {
        return 40;
    }
    if (raz_compiler_rt_path_exists_ascii(output, store_length) != 0) {
        if (registry_store_verify(output, store_length, checksum, checksum_length)) {
            return store_length;
        }
        if (registry_offline()) {
            return -63;
        }
    }
    if (registry_offline()) {
        return -64;
    }

    i64 archive = raz_compiler_rt_arena_create(67108864);

    if (archive == 0) {
        return -70;
    }

    i64 n = raz_compiler_rt_read_ascii(source, source_length, archive, 67108864);

    if (n <= 0) {
        raz_compiler_rt_arena_destroy(archive);
        return -67;
    }

    i64 unpack = registry_extract_archive(archive, n, output, store_length);

    raz_compiler_rt_arena_destroy(archive);
    if (unpack != 0) {
        return -unpack;
    }
    if (!registry_store_verify(output, store_length, checksum, checksum_length)) {
        raz_compiler_rt_remove_path_ascii(output, store_length);
        return -62;
    }
    return store_length;
}

fn registry_path_prefix(i64 path, i64 length, i64[]prefix, i64 pl) -> bool {
    if (length<pl) {
        return false;
    }

    i64 i = 0;

    while (i<pl) {
        if (raz_compiler_rt_arena_get(path, i) != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn registry_package_path_ignored(i64 path, i64 length) -> bool {
    i64 git[5] = [46, 103, 105, 116, 47];

    if (registry_path_prefix(path, length, &git, 5)) {
        return true;
    }

    i64 razd[5] = [46, 114, 97, 122, 47];

    if (registry_path_prefix(path, length, &razd, 5)) {
        return true;
    }

    i64 publish[13] = [46, 114, 97, 122, 45, 112, 117, 98, 108, 105, 115, 104, 47];

    if (registry_path_prefix(path, length, &publish, 13)) {
        return true;
    }

    i64 build[6] = [98, 117, 105, 108, 100, 47];

    if (registry_path_prefix(path, length, &build, 6)) {
        return true;
    }

    i64 target[7] = [116, 97, 114, 103, 101, 116, 47];

    if (registry_path_prefix(path, length, &target, 7)) {
        return true;
    }

    i64 diag[21] = [115, 116, 97, 103, 101, 49, 45, 100, 105, 97, 103, 110, 111, 115, 116, 105, 99, 46, 116, 120, 116];

    if (length == 21) {
        i64 i = 0;
        bool same = true;

        while (i<21) {
            if (raz_compiler_rt_arena_get(path, i) != diag[i]) {
                same = false;
            }
            i += 1;
        }
        if (same) {
            return true;
        }
    }

    i64 metadata_cache[10] = [46, 114, 97, 122, 46, 99, 97, 99, 104, 101];
    i64 metadata_registry[13] = [46, 114, 97, 122, 46, 114, 101, 103, 105, 115, 116, 114, 121];
    i64 metadata_index[19] = [46, 114, 97, 122, 46, 114, 101, 103, 105, 115, 116, 114, 121, 45, 105, 110, 100, 101, 120];
    i64 metadata_git[8] = [46, 114, 97, 122, 46, 103, 105, 116];

    if (
        (length == 10 && registry_path_prefix(path, length, &metadata_cache, 10)) ||
        (length == 13 && registry_path_prefix(path, length, &metadata_registry, 13)) ||
        (length == 19 && registry_path_prefix(path, length, &metadata_index, 19)) ||
        (length == 8 && registry_path_prefix(path, length, &metadata_git, 8))
    ) {
        return true;
    }
    if (registry_ends_dpk(path, length)) {
        return true;
    }
    return false;
}

fn registry_tree_hash(i64 root, i64 root_length) -> i64 {
    i64 listing = raz_compiler_rt_arena_create(4194304);

    if (listing == 0) {
        return 0;
    }

    i64 ll = raz_compiler_rt_tree_list_ascii(root, root_length, listing, 4194304);

    if (ll<0) {
        return 0;
    }

    i64 hash = 1469598103934665603;
    i64 prime = 1099511628211;
    i64 pos = 0;

    while (pos<ll) {
        i64 st = pos;

        while (pos<ll && raz_compiler_rt_arena_get(listing, pos) != 10) {
            pos += 1;
        }

        i64 pl = pos - st;

        if (pos<ll) {
            pos += 1;
        }
        if (pl <= 0) {
            continue;
        }

        i64 rel = raz_compiler_rt_arena_create(pl);

        if (rel == 0) {
            return 0;
        }

        i64 ri = 0;

        while (ri<pl) {
            raz_compiler_rt_arena_set(rel, ri, raz_compiler_rt_arena_get(listing, st + ri));
            ri += 1;
        }

        bool ignored = registry_package_path_ignored(rel, pl);

        raz_compiler_rt_arena_destroy(rel);
        if (ignored) {
            continue;
        }

        i64 i = 0;

        while (i<pl) {
            hash = (hash ^ (raz_compiler_rt_arena_get(listing, st + i)&255))*prime;
            i += 1;
        }
        hash = (hash ^ 0)*prime;

        i64 full = raz_compiler_rt_arena_create(8192);
        i64 data = raz_compiler_rt_arena_create(33554432);

        if (full == 0 || data == 0) {
            return 0;
        }

        i64 c = 0;

        package_append(full, 8192, &mut c, root, 0, root_length);
        if (
            c> 0 &&
            raz_compiler_rt_arena_get(full, c - 1) != 47 &&
            raz_compiler_rt_arena_get(full, c - 1) != 92
        ) {
            i64 slash[1] = [47];

            package_append_literal(full, 8192, &mut c, &slash, 1);
        }
        package_append(full, 8192, &mut c, listing, st, pl);

        i64 dl = raz_compiler_rt_read_ascii(full, c, data, 33554432);

        if (dl<0) {
            return 0;
        }
        i = 0;
        while (i<dl) {
            hash = (hash ^ (raz_compiler_rt_arena_get(data, i)&255))*prime;
            i += 1;
        }
        hash = (hash ^ 255)*prime;
        raz_compiler_rt_arena_destroy(full);
        raz_compiler_rt_arena_destroy(data);
    }
    raz_compiler_rt_arena_destroy(listing);
    return hash;
}

// Shared registry environment/store primitives live with transport so the
// registry policy layer can depend on transport without a semantic import cycle.
fn registry_hex_value(i64 value) -> i64 {
    if (value >= 48 && value <= 57) {
        return value - 48;
    }
    if (value >= 97 && value <= 102) {
        return value - 87;
    }
    if (value >= 65 && value <= 70) {
        return value - 55;
    }
    return -1;
}

fn registry_index_path(i64 output, i64 capacity) -> i64 {
    i64 name = raz_compiler_rt_arena_create(19);

    if (name == 0) {
        return -1;
    }

    i64 n[18] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 73, 78, 68, 69, 88];
    i64 i = 0;

    while (i<18) {
        raz_compiler_rt_arena_set(name, i, n[i]);
        i += 1;
    }

    i64 length = raz_compiler_rt_env_get_ascii(name, 18, output, capacity);

    raz_compiler_rt_arena_destroy(name);
    return length;
}

fn registry_env_flag(i64[]key, i64 key_length) -> bool {
    i64 name = raz_compiler_rt_arena_create(key_length);
    i64 value = raz_compiler_rt_arena_create(16);

    if (name == 0 || value == 0) {
        return false;
    }

    i64 i = 0;

    while (i<key_length) {
        raz_compiler_rt_arena_set(name, i, key[i]);
        i += 1;
    }

    i64 length = raz_compiler_rt_env_get_ascii(name, key_length, value, 16);
    bool enabled = false;

    if (length> 0) {
        i64 first = raz_compiler_rt_arena_get(value, 0);

        enabled = first == 49 || first == 116 || first == 84 || first == 121 || first == 89;
    }
    raz_compiler_rt_arena_destroy(name);
    raz_compiler_rt_arena_destroy(value);
    return enabled;
}

fn registry_offline() -> bool {
    i64 key[11] = [82, 65, 90, 95, 79, 70, 70, 76, 73, 78, 69];

    return registry_env_flag(&key, 11);
}

fn registry_store_root(i64 output, i64 capacity) -> i64 {
    i64 store_key[17] = [82, 65, 90, 95, 80, 65, 67, 75, 65, 71, 69, 95, 83, 84, 79, 82, 69];
    i64 length = registry_env_ascii(&store_key, 17, output, capacity);

    if (length> 0) {
        return length;
    }

    i64 home = raz_compiler_rt_arena_create(8192);

    if (home == 0) {
        return -1;
    }

    i64 raz_home_key[8] = [82, 65, 90, 95, 72, 79, 77, 69];
    i64 hl = registry_env_ascii(&raz_home_key, 8, home, 8192);

    if (hl> 0) {
        if (hl + 6> capacity) {
            raz_compiler_rt_arena_destroy(home);
            return -1;
        }

        i64 i = 0;

        while (i<hl) {
            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(home, i));
            i += 1;
        }

        i64 tail[6] = [47, 115, 116, 111, 114, 101];

        i = 0;
        while (i<6) {
            raz_compiler_rt_arena_set(output, hl + i, tail[i]);
            i += 1;
        }
        raz_compiler_rt_arena_destroy(home);
        return hl + 6;
    }

    i64 home_key[4] = [72, 79, 77, 69];

    hl = registry_env_ascii(&home_key, 4, home, 8192);
    if (hl <= 0) {
        i64 profile_key[11] = [85, 83, 69, 82, 80, 82, 79, 70, 73, 76, 69];

        hl = registry_env_ascii(&profile_key, 11, home, 8192);
    }
    if (hl> 0) {
        if (hl + 12> capacity) {
            raz_compiler_rt_arena_destroy(home);
            return -1;
        }

        i64 i = 0;

        while (i<hl) {
            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(home, i));
            i += 1;
        }

        i64 tail[11] = [47, 46, 114, 97, 122, 47, 115, 116, 111, 114, 101];

        i = 0;
        while (i<11) {
            raz_compiler_rt_arena_set(output, hl + i, tail[i]);
            i += 1;
        }
        raz_compiler_rt_arena_destroy(home);
        return hl + 11;
    }
    raz_compiler_rt_arena_destroy(home);

    i64 fallback[14] = [46, 47, 116, 97, 114, 103, 101, 116, 47, 115, 116, 111, 114, 101];

    if (capacity<14) {
        return -1;
    }

    i64 i = 0;

    while (i<14) {
        raz_compiler_rt_arena_set(output, i, fallback[i]);
        i += 1;
    }
    return 14;
}

fn registry_store_path(i64 checksum, i64 checksum_length, i64 output, i64 capacity) -> i64 {
    i64 root = raz_compiler_rt_arena_create(8192);

    if (root == 0) {
        return -1;
    }

    i64 rl = registry_store_root(root, 8192);

    if (rl <= 0 || rl + 1 + checksum_length> capacity) {
        raz_compiler_rt_arena_destroy(root);
        return -1;
    }

    i64 i = 0;

    while (i<rl) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(root, i));
        i += 1;
    }
    raz_compiler_rt_arena_set(output, rl, 47);
    i = 0;
    while (i<checksum_length) {
        raz_compiler_rt_arena_set(output, rl + 1 + i, raz_compiler_rt_arena_get(checksum, i));
        i += 1;
    }

    i64 total = rl + 1 + checksum_length;

    if (total<capacity) {
        raz_compiler_rt_arena_set(output, total, 0);
    }
    raz_compiler_rt_arena_destroy(root);
    return total;
}

fn registry_store_verify(i64 path, i64 path_length, i64 checksum, i64 checksum_length) -> bool {
    i64 hash = registry_tree_hash(path, path_length);

    if (hash == 0) {
        return false;
    }
    return registry_hex64_matches(checksum, 0, checksum_length, hash);
}

fn registry_hex64_matches(i64 data, i64 start, i64 length, i64 value) -> bool {
    if (length != 16) {
        return false;
    }

    i64 shift = 60;
    i64 i = 0;

    while (i<16) {
        i64 nib = registry_hex_value(raz_compiler_rt_arena_get(data, start + i));

        if (nib<0 || nib != ((value >> shift)&15)) {
            return false;
        }
        shift -= 4;
        i += 1;
    }
    return true;
}
