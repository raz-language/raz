    i64 uc = 0;
    i64 prefix[69] = [104, 116, 116, 112, 115, 58, 47, 47, 97, 112, 105, 46, 103, 105, 116, 104, 117, 98, 46, 99, 111, 109, 47, 114, 101, 112, 111, 115, 47, 114, 97, 122, 45, 108, 97, 110, 103, 117, 97, 103, 101, 47, 112, 97, 99, 107, 97, 103, 101, 115, 47, 99, 111, 110, 116, 101, 110, 116, 115, 47, 112, 97, 99, 107, 97, 103, 101, 115, 47];

    package_append_literal(url, 16384, &mut uc, &prefix, 69);
    package_append(url, 16384, &mut uc, name, 0, name_length);

    i64 slash[1] = [47];

    package_append_literal(url, 16384, &mut uc, &slash, 1);
    package_append(url, 16384, &mut uc, version, 0, version_length);

    i64 extension[4] = [46, 100, 112, 107];

    package_append_literal(url, 16384, &mut uc, &extension, 4);

    i64 bc = 0;
    i64 open[20] = [123, 34, 109, 101, 115, 115, 97, 103, 101, 34, 58, 34, 80, 117, 98, 108, 105, 115, 104, 32];

    package_append_literal(body, body_capacity, &mut bc, &open, 20);
    package_append(body, body_capacity, &mut bc, name, 0, name_length);

    i64 at[1] = [64];

    package_append_literal(body, body_capacity, &mut bc, &at, 1);
    package_append(body, body_capacity, &mut bc, version, 0, version_length);

    i64 middle[13] = [34, 44, 34, 99, 111, 110, 116, 101, 110, 116, 34, 58, 34];

    package_append_literal(body, body_capacity, &mut bc, &middle, 13);
    package_append(body, body_capacity, &mut bc, encoded, 0, encoded_length);

    i64 close[18] = [34, 44, 34, 98, 114, 97, 110, 99, 104, 34, 58, 34, 109, 97, 105, 110, 34, 125];

    package_append_literal(body, body_capacity, &mut bc, &close, 18);

    i64 ct[16] = [97, 112, 112, 108, 105, 99, 97, 116, 105, 111, 110, 47, 106, 115, 111, 110];
    i64 i = 0;

    while (i<16) {
        raz_compiler_rt_arena_set(content_type, i, ct[i]);
        i += 1;
