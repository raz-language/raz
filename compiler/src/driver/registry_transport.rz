namespace raz_compiler_driver_registry_transport;

public import raz_compiler_driver_signing;

// Registry transport and deterministic package-archive handling. Network policy,
// HTTP framing, TLS pumping, mirror fallback, and archive extraction live in Raz;
// the runtime exports only socket/TLS/filesystem ABI primitives.
fn registry_env_ascii(i64[]key, i64 key_length, i64 output, i64 capacity) -> i64 {
    i64 name = raz_compiler_rt_arena_create(key_length);

    if (name == 0) {
        return -1;
    }

    i64 i = 0;

    while (i<key_length) {
        raz_compiler_rt_arena_set(name, i, key[i]);
        i += 1;
    }

    i64 n = raz_compiler_rt_env_get_ascii(name, key_length, output, capacity);

    raz_compiler_rt_arena_destroy(name);
    return n;
}

fn registry_starts(i64 data, i64 length, i64[]prefix, i64 prefix_length) -> bool {
    if (length<prefix_length) {
        return false;
    }

    i64 i = 0;

    while (i<prefix_length) {
        if (raz_compiler_rt_arena_get(data, i) != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn registry_url_parse(
    i64 url,
    i64 length,
    i64 host,
    i64 host_capacity,
    i64&mut host_length,
    i64 path,
    i64 path_capacity,
    i64&mut path_length,
    i64&mut port,
    bool&mut secure,
) -> bool {
    i64 http[7] = [104, 116, 116, 112, 58, 47, 47];
    i64 https[8] = [104, 116, 116, 112, 115, 58, 47, 47];
    i64 cursor = 0;

    if (registry_starts(url, length, &https, 8)) {
        *secure = true;
        *port = 443;
        cursor = 8;
    } else if (registry_starts(url, length, &http, 7)) {
        *secure = false;
        *port = 80;
        cursor = 7;
    } else {
        return false;
    }

    i64 hs = cursor;

    while (
        cursor<length &&
        raz_compiler_rt_arena_get(url, cursor) != 47 &&
        raz_compiler_rt_arena_get(url, cursor) != 58
    ) {
        cursor += 1;
    }
    if (cursor <= hs || cursor - hs> host_capacity) {
        return false;
    }
    *host_length = cursor - hs;

    i64 i = 0;

    while (i<*host_length) {
        raz_compiler_rt_arena_set(host, i, raz_compiler_rt_arena_get(url, hs + i));
        i += 1;
    }
    if (cursor<length && raz_compiler_rt_arena_get(url, cursor) == 58) {
        cursor += 1;

        i64 value = 0;
        i64 digits = 0;

        while (
            cursor<length &&
            raz_compiler_rt_arena_get(url, cursor) >= 48 &&
            raz_compiler_rt_arena_get(url, cursor) <= 57
        ) {
            value = value*10 + raz_compiler_rt_arena_get(url, cursor) - 48;
            digits += 1;
            cursor += 1;
        }
        if (digits == 0 || value <= 0 || value> 65535) {
            return false;
        }
        *port = value;
    }
    if (cursor >= length) {
        if (path_capacity<1) {
            return false;
        }
        raz_compiler_rt_arena_set(path, 0, 47);
        *path_length = 1;
        return true;
    }
    if (raz_compiler_rt_arena_get(url, cursor) != 47) {
        return false;
    }
    *path_length = length - cursor;
    if (*path_length> path_capacity) {
        return false;
    }
    i = 0;
    while (i<*path_length) {
        raz_compiler_rt_arena_set(path, i, raz_compiler_rt_arena_get(url, cursor + i));
        i += 1;
    }
    return true;
}

fn registry_tls_flush(i64 tls, i64 socket, i64 scratch, i64 capacity) -> bool {
    while (raz_compiler_rt_tls_pending_encrypted(tls)> 0) {
        i64 count = raz_compiler_rt_tls_drain_ascii(tls, scratch, 0, capacity);

        if (count<0) {
            return false;
        }
        if (count == 0) {
            return true;
        }
        if (raz_compiler_rt_socket_send_ascii(socket, scratch, 0, count) != count) {
            return false;
        }
    }
    return true;
}

fn registry_tls_receive(i64 tls, i64 socket, i64 scratch, i64 capacity) -> i64 {
    i64 count = raz_compiler_rt_socket_receive_ascii(socket, scratch, 0, capacity);

    if (count <= 0) {
        return count;
    }

    i64 used = 0;

    while (used<count) {
        i64 fed = raz_compiler_rt_tls_feed_ascii(tls, scratch, used, count - used);

        if (fed <= 0) {
            return -1;
        }
        used += fed;
    }
    return count;
}

fn registry_tls_connect(i64 host, i64 host_length, i64 socket, i64 scratch, i64 capacity) -> i64 {
    if (raz_compiler_rt_tls_available() != 1) {
        return 0;
    }

    i64 tls = raz_compiler_rt_tls_client_create_ascii(host, host_length);

    if (tls == 0) {
        return 0;
    }
    while (raz_compiler_rt_tls_handshake_finished(tls) != 1) {
        i64 state = raz_compiler_rt_tls_handshake(tls);

        if (!registry_tls_flush(tls, socket, scratch, capacity)) {
            raz_compiler_rt_tls_destroy(tls);
            return 0;
        }
        if (state == 1) {
            return tls;
        }
        if (state<0 || registry_tls_receive(tls, socket, scratch, capacity) <= 0) {
            raz_compiler_rt_tls_destroy(tls);
            return 0;
        }
    }
    return tls;
}

fn registry_transport_request(
    i64 host,
    i64 host_length,
    i64 path,
    i64 path_length,
    i64 request,
    i64 capacity,
) -> i64 {
    i64 cursor = 0;
    i64 a[4] = [71, 69, 84, 32];

    package_append_literal(request, capacity, &mut cursor, &a, 4);
    package_append(request, capacity, &mut cursor, path, 0, path_length);

    i64 b[17] = [32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 72, 111, 115, 116, 58, 32];

    package_append_literal(request, capacity, &mut cursor, &b, 17);
    package_append(request, capacity, &mut cursor, host, 0, host_length);

    i64 c[34] = [13, 10, 85, 115, 101, 114, 45, 65, 103, 101, 110, 116, 58, 32, 82, 97, 122, 47, 49, 46, 48, 13, 10, 65, 99, 99, 101, 112, 116, 58, 32, 42, 47, 42];

    package_append_literal(request, capacity, &mut cursor, &c, 34);

    bool github_api = host_length == 14;
    i64 gh_host[14] = [97, 112, 105, 46, 103, 105, 116, 104, 117, 98, 46, 99, 111, 109];
    i64 gh_i = 0;

    while (github_api && gh_i < 14) {
        if (raz_compiler_rt_arena_get(host, gh_i) != gh_host[gh_i]) {
            github_api = false;
        }
        gh_i += 1;
    }
    if (github_api) {
        i64 token = raz_compiler_rt_arena_create(8192);

        if (token != 0) {
            i64 tl = registry_publish_token(token, 8192, true);

            if (tl> 0) {
                i64 ah[24] = [13, 10, 65, 117, 116, 104, 111, 114, 105, 122, 97, 116, 105, 111, 110, 58, 32, 66, 101, 97, 114, 101, 114, 32];

                package_append_literal(request, capacity, &mut cursor, &ah, 24);
                package_append(request, capacity, &mut cursor, token, 0, tl);
            }
            raz_compiler_rt_arena_destroy(token);
        }

        i64 api[61] = [13, 10, 65, 99, 99, 101, 112, 116, 58, 32, 97, 112, 112, 108, 105, 99, 97, 116, 105, 111, 110, 47, 118, 110, 100, 46, 103, 105, 116, 104, 117, 98, 43, 106, 115, 111, 110, 13, 10, 88, 45, 71, 105, 116, 72, 117, 98, 45, 65, 112, 105, 45, 86, 101, 114, 115, 105, 111, 110, 58, 32];

        package_append_literal(request, capacity, &mut cursor, &api, 61);

        i64 ver[10] = [50, 48, 50, 54, 45, 48, 51, 45, 49, 48];

        package_append_literal(request, capacity, &mut cursor, &ver, 10);
    }

    i64 tail[23] = [13, 10, 67, 111, 110, 110, 101, 99, 116, 105, 111, 110, 58, 32, 99, 108, 111, 115, 101, 13, 10, 13, 10];

    package_append_literal(request, capacity, &mut cursor, &tail, 23);
    return cursor;
}

fn registry_http_status(i64 response, i64 length) -> i64 {
    if (length<12) {
        return -1;
    }

    i64 i = 0;

    while (i<length && raz_compiler_rt_arena_get(response, i) != 32) {
        i += 1;
    }
    if (i + 4> length) {
        return -1;
    }
    i += 1;

    i64 status = 0;
    i64 n = 0;

    while (i<length && n<3) {
        i64 ch = raz_compiler_rt_arena_get(response, i);

        if (ch<48 || ch> 57) {
            return -1;
        }
        status = status*10 + ch - 48;
        i += 1;
        n += 1;
    }
    if (n == 3) {
        return status;
    }
    return -1;
}

fn registry_http_body_start(i64 response, i64 length) -> i64 {
    i64 i = 0;

    while (i + 3 < length) {
        if (
            raz_compiler_rt_arena_get(response, i) == 13 &&
            raz_compiler_rt_arena_get(response, i + 1) == 10 &&
            raz_compiler_rt_arena_get(response, i + 2) == 13 &&
            raz_compiler_rt_arena_get(response, i + 3) == 10
        ) {
            return i + 4;
        }
        i += 1;
    }
    return -1;
}

fn registry_http_location(i64 response, i64 length, i64 output, i64 capacity) -> i64 {
    i64 i = 0;

    // Skip the status line.
    while (i < length && raz_compiler_rt_arena_get(response, i) != 10) {
        i += 1;
    }
    if (i < length) {
        i += 1;
    }

    i64 key[8] = [108, 111, 99, 97, 116, 105, 111, 110];

    while (i < length) {
        i64 start = i;

        while (i < length && raz_compiler_rt_arena_get(response, i) != 10) {
            i += 1;
        }

        i64 end = i;

        if (i < length) {
            i += 1;
        }
        if (end> start && raz_compiler_rt_arena_get(response, end - 1) == 13) {
            end -= 1;
        }
        if (end == start) {
            return 0;
        }

        i64 colon = start;

        while (colon < end && raz_compiler_rt_arena_get(response, colon) != 58) {
            colon += 1;
        }
        if (colon - start == 8) {
            bool same = true;
            i64 k = 0;

            while (same && k < 8) {
                i64 ch = raz_compiler_rt_arena_get(response, start + k);

                if (ch >= 65 && ch <= 90) {
                    ch += 32;
                }
                if (ch != key[k]) {
                    same = false;
                }
                k += 1;
            }
            if (same) {
                i64 value = colon + 1;

                while (
                    value < end &&
                    (
                        raz_compiler_rt_arena_get(response, value) == 32 ||
                        raz_compiler_rt_arena_get(response, value) == 9
                    )
                ) {
                    value += 1;
                }

                i64 value_length = end - value;

                if (value_length <= 0 || value_length> capacity) {
                    return -1;
                }

                i64 n = 0;

                while (n < value_length) {
                    raz_compiler_rt_arena_set(output, n, raz_compiler_rt_arena_get(response, value + n));
                    n += 1;
                }
                return value_length;
            }
        }
    }
    return 0;
}

// Fetches a complete HTTP/1.0 response body. Redirects are followed with a
// small fixed limit because GitHub Release assets resolve through its CDN.
fn registry_http_get_depth(
    i64 url,
    i64 url_length,
    i64 output,
    i64 output_capacity,
    i64 redirect_depth,
) -> i64 {
    i64 host = raz_compiler_rt_arena_create(2048);
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 request = raz_compiler_rt_arena_create(16384);
    i64 scratch = raz_compiler_rt_arena_create(65536);
    i64 response = raz_compiler_rt_arena_create(output_capacity + 65536);

    if (host == 0 || path == 0 || request == 0 || scratch == 0 || response == 0) {
        return -70;
    }

    i64 hl = 0;
    i64 pl = 0;
    i64 port = 0;
    bool secure = false;

    if (
        !registry_url_parse(url, url_length, host, 2048, &mut hl, path, 8192, &mut pl, &mut port, &mut secure)
    ) {
        return -71;
    }

    i64 socket = raz_compiler_rt_tcp_connect_ascii(host, hl, port);

    if (socket<0) {
        return -72;
    }
    raz_compiler_rt_socket_set_timeout_millis(socket, 10000, 10000);

    i64 tls = 0;

    if (secure) {
        tls = registry_tls_connect(host, hl, socket, scratch, 65536);
        if (tls == 0) {
            raz_compiler_rt_socket_close(socket);
            return -73;
        }
    }

    i64 request_length = registry_transport_request(host, hl, path, pl, request, 16384);

    if (request_length <= 0) {
        return -70;
    }
    if (secure) {
        i64 sent = 0;

        while (sent<request_length) {
            i64 n = raz_compiler_rt_tls_write_plain_ascii(tls, request, sent, request_length - sent);

            if (n<0) {
                return -74;
            }
            if (!registry_tls_flush(tls, socket, scratch, 65536)) {
                return -74;
            }
            if (n> 0) {
                sent += n;
            } else if (registry_tls_receive(tls, socket, scratch, 65536) <= 0) {
                return -74;
            }
        }
    } else if (raz_compiler_rt_socket_send_ascii(socket, request, 0, request_length) != request_length) {
        raz_compiler_rt_socket_close(socket);
        return -74;
    }

    i64 total = 0;
    bool done = false;

    while (!done && total<output_capacity + 65536) {
        i64 available = output_capacity + 65536 - total;

        if (available> 65536) {
            available = 65536;
        }

        i64 n = 0;

        if (secure) {
            n = raz_compiler_rt_tls_read_plain_ascii(tls, response, total, available);
            if (n> 0) {
                total += n;
                continue;
            }
            if (n == -2) {
                break;
            }
            if (n<0) {
                break;
            }

            i64 encrypted = registry_tls_receive(tls, socket, scratch, 65536);

            if (encrypted <= 0) {
                done = true;
            }
        } else {
            n = raz_compiler_rt_socket_receive_ascii(socket, response, total, available);
            if (n> 0) {
                total += n;
            } else {
                done = true;
            }
        }
    }
    if (secure) {
        raz_compiler_rt_tls_shutdown(tls);
        registry_tls_flush(tls, socket, scratch, 65536);
        raz_compiler_rt_tls_destroy(tls);
    }
    raz_compiler_rt_socket_close(socket);

    i64 status = registry_http_status(response, total);
    i64 body = registry_http_body_start(response, total);

    if (status >= 300 && status < 400 && body >= 0) {
        if (redirect_depth >= 5) {
            return -77;
        }

        i64 location = raz_compiler_rt_arena_create(16384);

        if (location == 0) {
            return -70;
        }

        i64 location_length = registry_http_location(response, total, location, 16384);

        if (location_length <= 0) {
            raz_compiler_rt_arena_destroy(location);
            return -77;
        }
        raz_compiler_rt_arena_destroy(host);
        raz_compiler_rt_arena_destroy(path);
        raz_compiler_rt_arena_destroy(request);
        raz_compiler_rt_arena_destroy(scratch);
        raz_compiler_rt_arena_destroy(response);
        i64 redirected = registry_http_get_depth(
            location,
            location_length,
            output,
            output_capacity,
            redirect_depth + 1,
        );
        raz_compiler_rt_arena_destroy(location);
        return redirected;
    }
    if (status<200 || status >= 300 || body<0) {
        return -75;
    }

    i64 body_length = total - body;

    if (body_length> output_capacity) {
        return -76;
    }

    i64 i = 0;

    while (i<body_length) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(response, body + i));
        i += 1;
    }
    raz_compiler_rt_arena_destroy(host);
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(request);
    raz_compiler_rt_arena_destroy(scratch);
    raz_compiler_rt_arena_destroy(response);
    return body_length;
}

fn registry_http_get(i64 url, i64 url_length, i64 output, i64 output_capacity) -> i64 {
    return registry_http_get_depth(url, url_length, output, output_capacity, 0);
}

fn registry_join_url(
    i64 base,
    i64 base_length,
    i64 suffix,
    i64 suffix_start,
    i64 suffix_length,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 cursor = 0;

    package_append(output, capacity, &mut cursor, base, 0, base_length);
    if (cursor> 0 && raz_compiler_rt_arena_get(output, cursor - 1) == 47) {
        if (suffix_length> 0 && raz_compiler_rt_arena_get(suffix, suffix_start) == 47) {
            suffix_start += 1;
            suffix_length -= 1;
        }
    } else if (suffix_length == 0 || raz_compiler_rt_arena_get(suffix, suffix_start) != 47) {
        i64 slash[1] = [47];

        package_append_literal(output, capacity, &mut cursor, &slash, 1);
    }
    package_append(output, capacity, &mut cursor, suffix, suffix_start, suffix_length);
    return cursor;
}

fn registry_default_base(i64 output, i64 capacity) -> i64 {
    i64 value[60] = [104, 116, 116, 112, 115, 58, 47, 47, 114, 97, 119, 46, 103, 105, 116, 104, 117, 98, 117, 115, 101, 114, 99, 111, 110, 116, 101, 110, 116, 46, 99, 111, 109, 47, 114, 97, 122, 45, 108, 97, 110, 103, 117, 97, 103, 101, 47, 112, 97, 99, 107, 97, 103, 101, 115, 47, 109, 97, 105, 110];

    if (capacity < 60) {
        return -1;
    }

    i64 i = 0;

    while (i < 60) {
        raz_compiler_rt_arena_set(output, i, value[i]);
        i += 1;
    }
    return 60;
}

fn registry_fetch_base_index(i64 base, i64 base_length, i64 output, i64 capacity) -> i64 {
    i64 url = raz_compiler_rt_arena_create(8192);

    if (url == 0) {
        return -70;
    }

    i64 suffix[9] = [105, 110, 100, 101, 120, 46, 116, 120, 116];
    i64 sl = 9;
    i64 tmp = raz_compiler_rt_arena_create(9);
    i64 i = 0;

    while (i<9) {
        raz_compiler_rt_arena_set(tmp, i, suffix[i]);
        i += 1;
    }

    i64 ul = registry_join_url(base, base_length, tmp, 0, sl, url, 8192);
    i64 n = registry_http_get(url, ul, output, capacity);

    raz_compiler_rt_arena_destroy(tmp);
    raz_compiler_rt_arena_destroy(url);
    return n;
}

fn registry_index_cache_path(i64 output, i64 capacity) -> i64 {
    i64 credentials = raz_compiler_rt_arena_create(8192);
    i64 parent = raz_compiler_rt_arena_create(8192);

    if (credentials == 0 || parent == 0) {
        return -1;
    }

    i64 parent_length = 0;
    i64 credential_length = registry_credentials_path(credentials, 8192, parent, 8192, &mut parent_length);

    if (credential_length <= 0 || parent_length <= 0) {
        raz_compiler_rt_arena_destroy(credentials);
        raz_compiler_rt_arena_destroy(parent);
        return -1;
    }
    if (raz_compiler_rt_create_dir_ascii(parent, parent_length) != 0) {
        raz_compiler_rt_arena_destroy(credentials);
        raz_compiler_rt_arena_destroy(parent);
        return -1;
    }

    i64 cursor = 0;

    package_append(output, capacity, &mut cursor, parent, 0, parent_length);

    i64 registry_dir[9] = [47, 114, 101, 103, 105, 115, 116, 114, 121];

    package_append_literal(output, capacity, &mut cursor, &registry_dir, 9);
    if (raz_compiler_rt_create_dir_ascii(output, cursor) != 0) {
        raz_compiler_rt_arena_destroy(credentials);
        raz_compiler_rt_arena_destroy(parent);
        return -1;
    }

    i64 tail[10] = [47, 105, 110, 100, 101, 120, 46, 116, 120, 116];

    package_append_literal(output, capacity, &mut cursor, &tail, 10);
    raz_compiler_rt_arena_destroy(credentials);
    raz_compiler_rt_arena_destroy(parent);
    return cursor;
}

fn registry_cache_index(i64 data, i64 length) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);

    if (path == 0) {
        return -1;
    }

    i64 pl = registry_index_cache_path(path, 8192);
    i64 n = raz_compiler_rt_write_ascii(path, pl, data, length);

    raz_compiler_rt_arena_destroy(path);
    return n;
}

fn registry_read_cached_index(i64 output, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);

    if (path == 0) {
        return -1;
    }

    i64 pl = registry_index_cache_path(path, 8192);
    i64 n = raz_compiler_rt_read_ascii(path, pl, output, capacity);

    raz_compiler_rt_arena_destroy(path);
    return n;
}

// Returns index length and writes the base URL that supplied it. Local index mode writes base length 0.
fn registry_load_index(i64 output, i64 capacity, i64 base, i64 base_capacity, i64&mut base_length) -> i64 {
    i64 local = raz_compiler_rt_arena_create(8192);

    if (local == 0) {
        return -70;
    }

    i64 local_len = registry_index_path(local, 8192);

    if (local_len> 0) {
        i64 n = raz_compiler_rt_read_ascii(local, local_len, output, capacity);

        raz_compiler_rt_arena_destroy(local);
        if (n <= 0) {
            *base_length = 0;
            return n;
        }
        // A local index is often used as a deterministic resolver snapshot while
        // package archives still live in the remote registry. Preserve an
        // explicit RAZ_REGISTRY_URL as the relative-package base; otherwise use
        // the official GitHub registry base. This keeps local-index tests and
        // offline resolver snapshots from accidentally treating package paths as
        // process-working-directory paths.

        i64 pkey[16] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 85, 82, 76];
        i64 configured = registry_env_ascii(&pkey, 16, base, base_capacity);

        if (configured> 0) {
            *base_length = configured;
        } else {
            i64 fallback = registry_default_base(base, base_capacity);

            if (fallback> 0) {
                *base_length = fallback;
            } else {
                *base_length = 0;
            }
        }
        return n;
    }
    raz_compiler_rt_arena_destroy(local);
    if (registry_offline()) {
        i64 cached = registry_read_cached_index(output, capacity);

        *base_length = 0;
        if (cached> 0) {
            return cached;
        }
        return -60;
    }

    i64 primary = raz_compiler_rt_arena_create(8192);
    i64 mirrors = raz_compiler_rt_arena_create(32768);

    if (primary == 0 || mirrors == 0) {
        return -70;
    }

    i64 pkey[16] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 85, 82, 76];
    i64 plen = registry_env_ascii(&pkey, 16, primary, 8192);

    // The official registry is GitHub-backed. RAZ_REGISTRY_URL still overrides
    // this for private registries, mirrors, and deterministic test fixtures.
    if (plen <= 0) {
        plen = registry_default_base(primary, 8192);
    }
    if (plen> 0) {
        i64 n = registry_fetch_base_index(primary, plen, output, capacity);

        if (n> 0) {
            if (plen> base_capacity) {
                return -70;
            }

            i64 i = 0;

            while (i < plen) {
                raz_compiler_rt_arena_set(base, i, raz_compiler_rt_arena_get(primary, i));
                i += 1;
            }
            *base_length = plen;
            registry_cache_index(output, n);
            return n;
        }
    }

    i64 mkey[20] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 77, 73, 82, 82, 79, 82, 83];
    i64 ml = registry_env_ascii(&mkey, 20, mirrors, 32768);
    i64 pos = 0;

    while (ml> 0 && pos<ml) {
        while (
            pos<ml &&
            (
                raz_compiler_rt_arena_get(mirrors, pos) == 59 ||
                ascii_is_space(raz_compiler_rt_arena_get(mirrors, pos))
            )
        ) {
            pos += 1;
        }

        i64 start = pos;

        while (pos<ml && raz_compiler_rt_arena_get(mirrors, pos) != 59) {
            pos += 1;
        }

        i64 end = pos;

        while (end> start && ascii_is_space(raz_compiler_rt_arena_get(mirrors, end - 1))) {
            end -= 1;
        }
        if (end> start) {
            i64 n = 0;
            i64 candidate = raz_compiler_rt_arena_create(8192);
            i64 i = 0;

            while (i<end - start) {
                raz_compiler_rt_arena_set(candidate, i, raz_compiler_rt_arena_get(mirrors, start + i));
                i += 1;
            }
            n = registry_fetch_base_index(candidate, end - start, output, capacity);
            if (n> 0) {
                if (end - start> base_capacity) {
                    return -70;
                }
                i = 0;
                while (i<end - start) {
                    raz_compiler_rt_arena_set(base, i, raz_compiler_rt_arena_get(candidate, i));
                    i += 1;
                }
                *base_length = end - start;
                registry_cache_index(output, n);
                raz_compiler_rt_arena_destroy(candidate);
                return n;
            }
            raz_compiler_rt_arena_destroy(candidate);
        }
        if (pos<ml) {
            pos += 1;
        }
    }
    // Network/mirror failure falls back to the last verified index snapshot.
    // This is deliberately a failure fallback rather than a cache-first policy:
    // normal online resolution still observes newly published/yanked versions,
    // while transient GitHub outages do not make an already-used registry unusable.

    i64 cached = registry_read_cached_index(output, capacity);

    if (cached> 0) {
        i64 fallback_base = registry_default_base(base, base_capacity);

        if (fallback_base> 0) {
            *base_length = fallback_base;
        } else {
            *base_length = 0;
        }
        raz_compiler_rt_arena_destroy(primary);
        raz_compiler_rt_arena_destroy(mirrors);
        return cached;
    }
    raz_compiler_rt_arena_destroy(primary);
    raz_compiler_rt_arena_destroy(mirrors);
    return -60;
}

fn registry_safe_archive_path(i64 path, i64 length) -> bool {
    if (length <= 0) {
        return false;
    }

    i64 first = raz_compiler_rt_arena_get(path, 0);

    if (first == 47 || first == 92) {
        return false;
    }

    i64 i = 0;
    i64 component = 0;

    while (i <= length) {
        if (i == length || raz_compiler_rt_arena_get(path, i) == 47) {
            if (
                i - component == 2 &&
                raz_compiler_rt_arena_get(path, component) == 46 &&
                raz_compiler_rt_arena_get(path, component + 1) == 46
            ) {
                return false;
            }
            if (i == component) {
                return false;
            }
            component = i + 1;
        } else {
            if (raz_compiler_rt_arena_get(path, i) == 92 || raz_compiler_rt_arena_get(path, i) == 58) {
                return false;
            }
        }
        i += 1;
    }
    return true;
}

fn registry_decode_hex(i64 source, i64 start, i64 length, i64 output, i64 capacity) -> i64 {
    if ((length&1) != 0 || length / 2> capacity) {
        return -1;
    }

    i64 i = 0;

    while (i<length) {
        i64 a = registry_hex_value(raz_compiler_rt_arena_get(source, start + i));
        i64 b = registry_hex_value(raz_compiler_rt_arena_get(source, start + i + 1));

        if (a<0 || b<0) {
            return -1;
        }
        raz_compiler_rt_arena_set(output, i / 2, a*16 + b);
        i += 2;
    }
    return length / 2;
}

fn registry_extract_archive(i64 archive, i64 length, i64 destination, i64 destination_length) -> i64 {
    i64 header[8] = [82, 65, 90, 80, 75, 71, 49, 10];

    if (length<8) {
        return 66;
    }

    i64 i = 0;

    while (i<8) {
        if (raz_compiler_rt_arena_get(archive, i) != header[i]) {
            return 66;
        }
        i += 1;
    }
    raz_compiler_rt_remove_path_ascii(destination, destination_length);
    if (raz_compiler_rt_create_dir_ascii(destination, destination_length) != 0) {
        return 65;
    }

    i64 pos = 8;

    while (pos<length) {
        i64 start = pos;

        while (pos<length && raz_compiler_rt_arena_get(archive, pos) != 10) {
            pos += 1;
        }

        i64 end = pos;

        if (pos<length) {
            pos += 1;
        }
        if (start == end) {
            continue;
        }
        if (
            end - start<4 ||
            raz_compiler_rt_arena_get(archive, start) != 70 ||
            raz_compiler_rt_arena_get(archive, start + 1) != 32
        ) {
            return 66;
        }

        i64 sep = start + 2;

        while (sep<end && raz_compiler_rt_arena_get(archive, sep) != 32) {
            sep += 1;
        }
        if (sep >= end) {
            return 66;
        }

        i64 path = raz_compiler_rt_arena_create(4096);
        i64 data = raz_compiler_rt_arena_create((end - sep) / 2 + 1);
        i64 full = raz_compiler_rt_arena_create(8192);

        if (path == 0 || data == 0 || full == 0) {
            return 40;
        }

        i64 pl = registry_decode_hex(archive, start + 2, sep - (start + 2), path, 4096);
        i64 dl = registry_decode_hex(archive, sep + 1, end - (sep + 1), data, (end - sep) / 2 + 1);

        if (pl <= 0 || dl<0 || !registry_safe_archive_path(path, pl)) {
            return 66;
        }

        i64 cursor = 0;

        package_append(full, 8192, &mut cursor, destination, 0, destination_length);

        i64 slash[1] = [47];

        package_append_literal(full, 8192, &mut cursor, &slash, 1);
        package_append(full, 8192, &mut cursor, path, 0, pl);

        i64 parent = cursor - 1;

        while (parent >= 0 && raz_compiler_rt_arena_get(full, parent) != 47) {
            parent -= 1;
        }
        if (parent> 0 && raz_compiler_rt_create_dir_ascii(full, parent) != 0) {
            return 65;
        }
        if (raz_compiler_rt_write_ascii(full, cursor, data, dl) != dl) {
            return 65;
        }
        raz_compiler_rt_arena_destroy(path);
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(full);
    }
    return 0;
}

fn registry_store_materialize_archive(
    i64 url,
    i64 url_length,
    i64 checksum,
    i64 checksum_length,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 store_length = registry_store_path(checksum, checksum_length, output, capacity);

    if (store_length <= 0) {
        return 40;
    }
    if (raz_compiler_rt_path_exists_ascii(output, store_length) != 0) {
        if (registry_store_verify(output, store_length, checksum, checksum_length)) {
            return store_length;
        }
        if (registry_offline()) {
            return -63;
        }
    }
    if (registry_offline()) {
        return -64;
    }

    i64 archive = raz_compiler_rt_arena_create(33554432);

    if (archive == 0) {
        return -70;
    }

    i64 n = registry_http_get(url, url_length, archive, 33554432);

    if (n <= 0) {
        raz_compiler_rt_arena_destroy(archive);
        return -67;
    }

    i64 unpack = registry_extract_archive(archive, n, output, store_length);

    raz_compiler_rt_arena_destroy(archive);
    if (unpack != 0) {
        return -unpack;
    }
    if (!registry_store_verify(output, store_length, checksum, checksum_length)) {
        raz_compiler_rt_remove_path_ascii(output, store_length);
        return -62;
    }
    return store_length;
}

// Publishing/packing support. Directory enumeration is a permanent filesystem ABI
// boundary; archive encoding and HTTP publishing policy remain in Raz.
fn registry_hex_digit(i64 value) -> i64 {
    if (value<10) {
        return 48 + value;
    }
    return 87 + value;
}

fn registry_append_hex_bytes(
    i64 output,
    i64 capacity,
    i64&mut cursor,
    i64 data,
    i64 start,
    i64 length,
) -> bool {
    if (*cursor + length*2> capacity) {
        return false;
    }

    i64 i = 0;

    while (i<length) {
        i64 b = raz_compiler_rt_arena_get(data, start + i)&255;

        raz_compiler_rt_arena_set(output, *cursor, registry_hex_digit((b >> 4)&15));
        *cursor += 1;
        raz_compiler_rt_arena_set(output, *cursor, registry_hex_digit(b&15));
        *cursor += 1;
        i += 1;
    }
    return true;
}

fn registry_append_decimal(i64 output, i64 capacity, i64&mut cursor, i64 value) -> bool {
    i64 digits = raz_compiler_rt_arena_create(32);

    if (digits == 0) {
        return false;
    }

    i64 count = 0;

    if (value == 0) {
        raz_compiler_rt_arena_set(digits, count, 48);
        count += 1;
    } else {
        while (value> 0 && count<32) {
            raz_compiler_rt_arena_set(digits, count, 48 + (value % 10));
            count += 1;
            value /= 10;
        }
    }
    if (*cursor + count> capacity) {
        raz_compiler_rt_arena_destroy(digits);
        return false;
    }
    while (count> 0) {
        count -= 1;
        raz_compiler_rt_arena_set(output, *cursor, raz_compiler_rt_arena_get(digits, count));
        *cursor += 1;
    }
    raz_compiler_rt_arena_destroy(digits);
    return true;
}

fn registry_pack_tree(i64 root, i64 root_length, i64 archive, i64 archive_capacity) -> i64 {
    i64 listing = raz_compiler_rt_arena_create(4194304);

    if (listing == 0) {
        return -40;
    }

    i64 ll = raz_compiler_rt_tree_list_ascii(root, root_length, listing, 4194304);

    if (ll<0) {
        raz_compiler_rt_arena_destroy(listing);
        return -65;
    }

    i64 cursor = 0;
    i64 header[8] = [82, 65, 90, 80, 75, 71, 49, 10];

    if (!package_append_literal(archive, archive_capacity, &mut cursor, &header, 8)) {
        return -40;
    }

    i64 pos = 0;

    while (pos<ll) {
        i64 start = pos;

        while (pos<ll && raz_compiler_rt_arena_get(listing, pos) != 10) {
            pos += 1;
        }

        i64 pl = pos - start;

        if (pos<ll) {
            pos += 1;
        }
        if (pl <= 0) {
            continue;
        }

        i64 rel = raz_compiler_rt_arena_create(pl);

        if (rel == 0) {
            return -40;
        }

        i64 r = 0;

        while (r<pl) {
            raz_compiler_rt_arena_set(rel, r, raz_compiler_rt_arena_get(listing, start + r));
            r += 1;
        }

        bool ignored = registry_package_path_ignored(rel, pl);

        raz_compiler_rt_arena_destroy(rel);
        if (ignored) {
            continue;
        }

        i64 full = raz_compiler_rt_arena_create(8192);
        i64 data = raz_compiler_rt_arena_create(33554432);

        if (full == 0 || data == 0) {
            return -40;
        }

        i64 fc = 0;

        package_append(full, 8192, &mut fc, root, 0, root_length);
        if (
            fc> 0 &&
            raz_compiler_rt_arena_get(full, fc - 1) != 47 &&
            raz_compiler_rt_arena_get(full, fc - 1) != 92
        ) {
            i64 slash[1] = [47];

            package_append_literal(full, 8192, &mut fc, &slash, 1);
        }
        package_append(full, 8192, &mut fc, listing, start, pl);

        i64 dl = raz_compiler_rt_read_ascii(full, fc, data, 33554432);

        if (dl<0) {
            return -65;
        }

        i64 f[2] = [70, 32];

        if (
            !package_append_literal(archive, archive_capacity, &mut cursor, &f, 2) ||
            !registry_append_hex_bytes(archive, archive_capacity, &mut cursor, listing, start, pl)
        ) {
            return -40;
        }

        i64 sp[1] = [32];

        package_append_literal(archive, archive_capacity, &mut cursor, &sp, 1);
        if (!registry_append_hex_bytes(archive, archive_capacity, &mut cursor, data, 0, dl)) {
            return -40;
        }

        i64 nl[1] = [10];

        package_append_literal(archive, archive_capacity, &mut cursor, &nl, 1);
        raz_compiler_rt_arena_destroy(full);
        raz_compiler_rt_arena_destroy(data);
    }
    raz_compiler_rt_arena_destroy(listing);
    return cursor;
}

fn registry_credentials_path(
    i64 output,
    i64 capacity,
    i64 parent,
    i64 parent_capacity,
    i64&mut parent_length
) -> i64 {
    i64 home = raz_compiler_rt_arena_create(8192);

    if (home == 0) {
        return -1;
    }

    i64 raz_home_key[8] = [82, 65, 90, 95, 72, 79, 77, 69];
    i64 hl = registry_env_ascii(&raz_home_key, 8, home, 8192);
    bool explicit_raz_home = hl> 0;

    if (hl <= 0) {
        i64 home_key[4] = [72, 79, 77, 69];

        hl = registry_env_ascii(&home_key, 4, home, 8192);
    }
    if (hl <= 0) {
        i64 profile_key[11] = [85, 83, 69, 82, 80, 82, 79, 70, 73, 76, 69];

        hl = registry_env_ascii(&profile_key, 11, home, 8192);
    }

    i64 cursor = 0;

    if (hl> 0) {
        i64 i = 0;

        while (i < hl) {
            if (cursor >= parent_capacity) {
                raz_compiler_rt_arena_destroy(home);
                return -1;
            }
            raz_compiler_rt_arena_set(parent, cursor, raz_compiler_rt_arena_get(home, i));
            cursor += 1;
            i += 1;
        }
        if (!explicit_raz_home) {
            i64 suffix[5] = [47, 46, 114, 97, 122];

            i = 0;
            while (i < 5) {
                if (cursor >= parent_capacity) {
                    raz_compiler_rt_arena_destroy(home);
                    return -1;
                }
                raz_compiler_rt_arena_set(parent, cursor, suffix[i]);
                cursor += 1;
                i += 1;
            }
        }
    } else {
        i64 fallback[6] = [46, 47, 46, 114, 97, 122];
        i64 i = 0;

        while (i < 6) {
            if (cursor >= parent_capacity) {
                raz_compiler_rt_arena_destroy(home);
                return -1;
            }
            raz_compiler_rt_arena_set(parent, cursor, fallback[i]);
            cursor += 1;
            i += 1;
        }
    }
    *parent_length = cursor;
    if (cursor + 12> capacity) {
        raz_compiler_rt_arena_destroy(home);
        return -1;
    }

    i64 i = 0;

    while (i < cursor) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(parent, i));
        i += 1;
    }

    i64 tail[12] = [47, 99, 114, 101, 100, 101, 110, 116, 105, 97, 108, 115];

    i = 0;
    while (i < 12) {
        raz_compiler_rt_arena_set(output, cursor + i, tail[i]);
        i += 1;
    }
    raz_compiler_rt_arena_destroy(home);
    return cursor + 12;
}

fn registry_read_saved_token(i64 output, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 parent = raz_compiler_rt_arena_create(8192);

    if (path == 0 || parent == 0) {
        return -1;
    }

    i64 parent_length = 0;
    i64 pl = registry_credentials_path(path, 8192, parent, 8192, &mut parent_length);

    if (pl <= 0) {
        return -1;
    }

    i64 n = raz_compiler_rt_read_ascii(path, pl, output, capacity);

    if (n> 0) {
        while (n> 0) {
            i64 ch = raz_compiler_rt_arena_get(output, n - 1);

            if (ch != 10 && ch != 13 && ch != 32 && ch != 9) {
                break;
            }
            n -= 1;
        }
    }
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(parent);
    return n;
}

fn registry_login_command(i64 argc) -> i64 {
    if (argc != 2 && argc != 3) {
        return 55;
    }

    i64 token = raz_compiler_rt_arena_create(8192);
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 parent = raz_compiler_rt_arena_create(8192);
    i64 body = raz_compiler_rt_arena_create(8193);

    if (token == 0 || path == 0 || parent == 0 || body == 0) {
        return 40;
    }

    i64 tl = 0;

    if (argc == 3) {
        tl = raz_compiler_rt_process_arg(2, token, 8192);
    } else {
        tl = registry_publish_token(token, 8192, true);
    }
    if (tl <= 0 || tl >= 8192) {
        return 55;
    }

    i64 parent_length = 0;
    i64 pl = registry_credentials_path(path, 8192, parent, 8192, &mut parent_length);

    if (pl <= 0 || raz_compiler_rt_create_dir_ascii(parent, parent_length) != 0) {
        return 56;
    }

    i64 i = 0;

    while (i < tl) {
        raz_compiler_rt_arena_set(body, i, raz_compiler_rt_arena_get(token, i));
        i += 1;
    }
    raz_compiler_rt_arena_set(body, tl, 10);
    if (raz_compiler_rt_write_ascii(path, pl, body, tl + 1) != tl + 1) {
        return 56;
    }

    i64 message[37] = [83, 97, 118, 101, 100, 32, 82, 97, 122, 32, 114, 101, 103, 105, 115, 116, 114, 121, 32, 99, 114, 101, 100, 101, 110, 116, 105, 97, 108, 115, 46, 10, 0, 0, 0, 0, 0];

    cli_write(&message, 32);
    raz_compiler_rt_arena_destroy(token);
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(parent);
    raz_compiler_rt_arena_destroy(body);
    return 0;
}

fn registry_logout_command(i64 argc) -> i64 {
    if (argc != 2) {
        return 55;
    }

    i64 path = raz_compiler_rt_arena_create(8192);
    i64 parent = raz_compiler_rt_arena_create(8192);

    if (path == 0 || parent == 0) {
        return 40;
    }

    i64 parent_length = 0;
    i64 pl = registry_credentials_path(path, 8192, parent, 8192, &mut parent_length);

    if (pl> 0 && raz_compiler_rt_path_exists_ascii(path, pl) != 0) {
        if (raz_compiler_rt_remove_path_ascii(path, pl) != 0) {
            return 56;
        }
    }

    i64 message[33] = [82, 101, 109, 111, 118, 101, 100, 32, 82, 97, 122, 32, 114, 101, 103, 105, 115, 116, 114, 121, 32, 99, 114, 101, 100, 101, 110, 116, 105, 97, 108, 115, 46];

    cli_write(&message, 33);

    i64 newline[1] = [10];

    cli_write(&newline, 1);
    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(parent);
    return 0;
}

fn registry_publish_token(i64 output, i64 capacity, bool allow_github) -> i64 {
    i64 registry_key[18] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 84, 79, 75, 69, 78];
    i64 length = registry_env_ascii(&registry_key, 18, output, capacity);

    if (length> 0 || !allow_github) {
        return length;
    }
    // GitHub Actions, gh, and normal developer environments conventionally
    // expose this name.  Falling back to it keeps the official registry fully
    // GitHub-backed without making users duplicate the same token into a Raz-
    // specific environment variable.

    i64 github_key[12] = [71, 73, 84, 72, 85, 66, 95, 84, 79, 75, 69, 78];

    length = registry_env_ascii(&github_key, 12, output, capacity);
    if (length> 0) {
        return length;
    }
    return registry_read_saved_token(output, capacity);
}

fn registry_base64_encoded_length(i64 length) -> i64 {
    if (length<0 || length> 805306368) {
        return -1;
    }
    return ((length + 2) / 3)*4;
}

fn registry_base64_digit(i64 value) -> i64 {
    if (value<26) {
        return 65 + value;
    }
    if (value<52) {
        return 97 + value - 26;
    }
    if (value<62) {
        return 48 + value - 52;
    }
    if (value == 62) {
        return 43;
    }
    return 47;
}

fn registry_base64_encode(i64 input, i64 length, i64 output, i64 capacity) -> i64 {
    i64 required = registry_base64_encoded_length(length);

    if (required<0 || required> capacity) {
        return -1;
    }

    i64 src = 0;
    i64 dst = 0;

    while (src + 3 <= length) {
        i64 a = raz_compiler_rt_arena_get(input, src)&255;
        i64 b = raz_compiler_rt_arena_get(input, src + 1)&255;
        i64 c = raz_compiler_rt_arena_get(input, src + 2)&255;

        raz_compiler_rt_arena_set(output, dst, registry_base64_digit((a >> 2)&63));
        raz_compiler_rt_arena_set(output, dst + 1, registry_base64_digit(((a&3) << 4) | ((b >> 4)&15)));
        raz_compiler_rt_arena_set(output, dst + 2, registry_base64_digit(((b&15) << 2) | ((c >> 6)&3)));
        raz_compiler_rt_arena_set(output, dst + 3, registry_base64_digit(c&63));
        src += 3;
        dst += 4;
    }

    i64 remaining = length - src;

    if (remaining == 1) {
        i64 a = raz_compiler_rt_arena_get(input, src)&255;

        raz_compiler_rt_arena_set(output, dst, registry_base64_digit((a >> 2)&63));
        raz_compiler_rt_arena_set(output, dst + 1, registry_base64_digit((a&3) << 4));
        raz_compiler_rt_arena_set(output, dst + 2, 61);
        raz_compiler_rt_arena_set(output, dst + 3, 61);
        dst += 4;
    } else if (remaining == 2) {
        i64 a = raz_compiler_rt_arena_get(input, src)&255;
        i64 b = raz_compiler_rt_arena_get(input, src + 1)&255;

        raz_compiler_rt_arena_set(output, dst, registry_base64_digit((a >> 2)&63));
        raz_compiler_rt_arena_set(output, dst + 1, registry_base64_digit(((a&3) << 4) | ((b >> 4)&15)));
        raz_compiler_rt_arena_set(output, dst + 2, registry_base64_digit((b&15) << 2));
        raz_compiler_rt_arena_set(output, dst + 3, 61);
        dst += 4;
    }
    return dst;
}

fn registry_github_publish_archive(
    i64 name,
    i64 name_length,
    i64 version,
    i64 version_length,
    i64 archive,
    i64 archive_length,
) -> i64 {
    i64 token = raz_compiler_rt_arena_create(8192);

    if (token == 0) {
        return -70;
    }

    i64 token_length = registry_publish_token(token, 8192, true);

    raz_compiler_rt_arena_destroy(token);
    if (token_length <= 0) {
        return 0;
    }

    i64 encoded_length = registry_base64_encoded_length(archive_length);

    if (encoded_length <= 0) {
        return -70;
    }

    i64 encoded = raz_compiler_rt_arena_create(encoded_length);
    i64 body_capacity = encoded_length + name_length + version_length + 512;
    i64 body = raz_compiler_rt_arena_create(body_capacity);
    i64 url = raz_compiler_rt_arena_create(16384);
    i64 content_type = raz_compiler_rt_arena_create(32);

    if (encoded == 0 || body == 0 || url == 0 || content_type == 0) {
        return -70;
    }
    if (registry_base64_encode(archive, archive_length, encoded, encoded_length) != encoded_length) {
        return -70;
