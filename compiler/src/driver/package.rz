namespace raz_compiler_driver_package;
public import raz_compiler_driver_tooling;
import raz_compiler_driver_registry;
// Self-hosted package metadata, path-dependency mutation, dependency graph, and
// deterministic lockfile generation. Registry/network resolution layers on top
// of this path-package core without changing the lockfile contract.
fn cli_write_arena(i64 data, i64 length) {
  if (data == 0 || length <= 0) {
    return;
  }
  raz_rt_stage1_stdio_write_ascii(1, data, length);
}

fn package_append(i64 output, i64 capacity, i64&mut cursor, i64 data, i64 start, i64 length) -> bool {
  if (*cursor + length > capacity) {
    return false;
  }

  i64 i = 0;

  while (i < length) {
    raz_rt_stage1_arena_set(output, *cursor + i, raz_rt_stage1_arena_get(data, start + i));
    i += 1;
  }
  *cursor += length;
  return true;
}

fn package_append_literal(i64 output, i64 capacity, i64&mut cursor, i64[]text, i64 length) -> bool {
  if (*cursor + length > capacity) {
    return false;
  }

  i64 i = 0;

  while (i < length) {
    raz_rt_stage1_arena_set(output, *cursor + i, text[i]);
    i += 1;
  }
  *cursor += length;
  return true;
}

fn package_copy_key(i64 data, i64 start, i64 equal, i64 output, i64 capacity) -> i64 {
  while (start < equal && ascii_is_space(raz_rt_stage1_arena_get(data, start))) {
    start += 1;
  }
  while (equal > start && ascii_is_space(raz_rt_stage1_arena_get(data, equal - 1))) {
    equal -= 1;
  }

  i64 length = equal - start;

  if (length <= 0 || length > capacity) {
    return -1;
  }

  i64 i = 0;

  while (i<length) {
    raz_rt_stage1_arena_set(output, i, raz_rt_stage1_arena_get(data, start + i));
    i += 1;
  }
  return length;
}

fn package_key_equals(i64 data, i64 start, i64 equal, i64 key, i64 key_length) -> bool {
  while (start < equal && ascii_is_space(raz_rt_stage1_arena_get(data, start))) {
    start += 1;
  }
  while (equal> start && ascii_is_space(raz_rt_stage1_arena_get(data, equal - 1))) {
    equal -= 1;
  }
  if (equal - start != key_length) {
    return false;
  }

  i64 i = 0;

  while (i<key_length) {
    if (raz_rt_stage1_arena_get(data, start + i) != raz_rt_stage1_arena_get(key, i)) {
      return false;
    }
    i += 1;
  }
  return true;
}

fn package_manifest_field(
i64 manifest,
i64 length,
i64[]key,
i64 key_length,
i64 output,
i64 capacity,
) -> i64 {
  i64 section = 0;
  i64 cursor = 0;

  while (cursor<length) {
    i64 start = cursor;

    while (
    cursor<length &&
    raz_rt_stage1_arena_get(manifest, cursor) != 10 &&
    raz_rt_stage1_arena_get(manifest, cursor) != 13
    ) {
      cursor += 1;
    }

    i64 end = cursor;

    while (
    cursor<length &&
    (
    raz_rt_stage1_arena_get(manifest, cursor) == 10 ||
    raz_rt_stage1_arena_get(manifest, cursor) == 13
    )
    ) {
      cursor += 1;
    }
    if (line_is_section(manifest, start, end, 1)) {
      section = 1;
    } else if (start<end && raz_rt_stage1_arena_get(manifest, start) == 91) {
      section = 0;
    } else if (section == 1) {
      i64 equal = start;

      while (equal<end && raz_rt_stage1_arena_get(manifest, equal) != 61) {
        equal += 1;
      }
      if (equal<end) {
        i64 ks = start;
        i64 ke = equal;

        while (ks<ke && ascii_is_space(raz_rt_stage1_arena_get(manifest, ks))) {
          ks += 1;
        }
        while (ke> ks && ascii_is_space(raz_rt_stage1_arena_get(manifest, ke - 1))) {
          ke -= 1;
        }
        if (ke - ks == key_length) {
          bool same = true;
          i64 i = 0;

          while (i<key_length) {
            if (raz_rt_stage1_arena_get(manifest, ks + i) != key[i]) {
              same = false;
            }
            i += 1;
          }
          if (same) {
            return copy_quoted_value(manifest, equal + 1, end, output, capacity);
          }
        }
      }
    }
  }
  return -1;
}

fn package_hash_manifest(i64 data, i64 length) -> i64 {
  i64 hash = 1469598103934665603;
  i64 i = 0;

  while (i<length) {
    hash = (hash ^ raz_rt_stage1_arena_get(data, i))*1099511628211;
    i += 1;
  }

  i64 salt[11] = [114, 97, 122, 45, 108, 111, 99, 107, 45, 118, 49];

  i = 0;
  while (i<11) {
    hash = (hash ^ salt[i])*1099511628211;
    i += 1;
  }
  return hash;
}

fn package_append_hex64(i64 output, i64 capacity, i64&mut cursor, i64 value) -> bool {
  if (*cursor + 16> capacity) {
    return false;
  }

  i64 shift = 60;

  while (shift >= 0) {
    i64 nib = (value >> shift)&15;
    i64 b = 0;

    if (nib<10) {
      b = 48 + nib;
    } else {
      b = 87 + nib;
    }
    raz_rt_stage1_arena_set(output, *cursor, b);
    *cursor += 1;
    shift -= 4;
  }
  return true;
}

fn package_manifest_path_from_root(i64 root, i64 root_length, i64 output, i64 capacity) -> i64 {
  i64 name = raz_rt_stage1_arena_create(9);

  if (name == 0) {
    return -1;
  }

  i64 bytes[8] = [114, 97, 122, 46, 116, 111, 109, 108];
  i64 i = 0;

  while (i<8) {
    raz_rt_stage1_arena_set(name, i, bytes[i]);
    i += 1;
  }

  i64 result = path_join(root, root_length, name, 8, output, capacity);

  raz_rt_stage1_arena_destroy(name);
  return result;
}

fn package_print_metadata_manifest(
i64 manifest_path,
i64 manifest_path_length,
i64 depth,
bool graph_mode,
) -> i64 {
  if (depth> 32) {
    return 58;
  }

  i64 manifest = raz_rt_stage1_arena_create(65536);
  i64 root = raz_rt_stage1_arena_create(8192);
  i64 name = raz_rt_stage1_arena_create(4096);
  i64 version = raz_rt_stage1_arena_create(256);
  i64 kind = raz_rt_stage1_arena_create(256);

  if (manifest == 0 || root == 0 || name == 0 || version == 0 || kind == 0) {
    return 40;
  }

  i64 length = raz_rt_stage1_read_ascii(manifest_path, manifest_path_length, manifest, 65536);

  if (length <= 0) {
    return 57;
  }

  i64 root_length = path_dirname(manifest_path, manifest_path_length, root, 8192);
  i64 nk[4] = [110, 97, 109, 101];
  i64 vk[7] = [118, 101, 114, 115, 105, 111, 110];
  i64 kk[4] = [107, 105, 110, 100];
  i64 nl = package_manifest_field(manifest, length, &nk, 4, name, 4096);
  i64 vl = package_manifest_field(manifest, length, &vk, 7, version, 256);
  i64 kl = package_manifest_field(manifest, length, &kk, 4, kind, 256);

  if (nl <= 0) {
    return 57;
  }
  if (vl<0) {
    vl = 0;
  }
  if (kl<0) {
    kl = 0;
  }
  if (graph_mode) {
    i64 s = 0;

    while (s<depth) {
      i64 sp[2] = [32, 32];

      cli_write(&sp, 2);
      s += 1;
    }
    if (depth> 0) {
      i64 branch[3] = [124, 45, 32];

      cli_write(&branch, 3);
    }
    cli_write_arena(name, nl);
    if (vl> 0) {
      i64 at[1] = [64];

      cli_write(&at, 1);
      cli_write_arena(version, vl);
    }

    i64 nlch[1] = [10];

    cli_write(&nlch, 1);
  } else {
    i64 p1[8] = [112, 97, 99, 107, 97, 103, 101, 61];

    cli_write(&p1, 8);
    cli_write_arena(name, nl);

    i64 nlch[1] = [10];

    cli_write(&nlch, 1);

    i64 p2[8] = [118, 101, 114, 115, 105, 111, 110, 61];

    cli_write(&p2, 8);
    cli_write_arena(version, vl);
    cli_write(&nlch, 1);

    i64 p3[5] = [107, 105, 110, 100, 61];

    cli_write(&p3, 5);
    cli_write_arena(kind, kl);
    cli_write(&nlch, 1);
  }

  i64 section = 0;
  i64 cursor = 0;

  while (cursor<length) {
    i64 start = cursor;

    while (
    cursor<length &&
    raz_rt_stage1_arena_get(manifest, cursor) != 10 &&
    raz_rt_stage1_arena_get(manifest, cursor) != 13
    ) {
      cursor += 1;
    }

    i64 end = cursor;

    while (
    cursor<length &&
    (
    raz_rt_stage1_arena_get(manifest, cursor) == 10 ||
    raz_rt_stage1_arena_get(manifest, cursor) == 13
    )
    ) {
      cursor += 1;
    }
    if (line_is_section(manifest, start, end, 2)) {
      section = 2;
    } else if (start<end && raz_rt_stage1_arena_get(manifest, start) == 91) {
      section = 0;
    } else if (section == 2) {
      i64 equal = start;

      while (equal<end && raz_rt_stage1_arena_get(manifest, equal) != 61) {
        equal += 1;
      }
      if (equal<end) {
        i64 alias = raz_rt_stage1_arena_create(4096);
        i64 dep = raz_rt_stage1_arena_create(4096);
        i64 dep_root = raz_rt_stage1_arena_create(8192);
        i64 dep_manifest = raz_rt_stage1_arena_create(8192);

        if (alias == 0 || dep == 0 || dep_root == 0 || dep_manifest == 0) {
          return 40;
        }

        i64 al = package_copy_key(manifest, start, equal, alias, 4096);
        i64 dl = copy_quoted_value(manifest, equal + 1, end, dep, 4096);
        i64 drl = path_join(root, root_length, dep, dl, dep_root, 8192);
        i64 dml = package_manifest_path_from_root(dep_root, drl, dep_manifest, 8192);

        if (!graph_mode) {
          i64 pre[11] = [100, 101, 112, 101, 110, 100, 101, 110, 99, 121, 61];

          cli_write(&pre, 11);
          cli_write_arena(alias, al);

          i64 eq[1] = [61];

          cli_write(&eq, 1);
          cli_write_arena(dep, dl);

          i64 nlch[1] = [10];

          cli_write(&nlch, 1);
        }

        i64 status = package_print_metadata_manifest(dep_manifest, dml, depth + 1, graph_mode);

        if (status != 0) {
          return status;
        }
        raz_rt_stage1_arena_destroy(alias);
        raz_rt_stage1_arena_destroy(dep);
        raz_rt_stage1_arena_destroy(dep_root);
        raz_rt_stage1_arena_destroy(dep_manifest);
      }
    }
  }
  raz_rt_stage1_arena_destroy(manifest);
  raz_rt_stage1_arena_destroy(root);
  raz_rt_stage1_arena_destroy(name);
  raz_rt_stage1_arena_destroy(version);
  raz_rt_stage1_arena_destroy(kind);
  return 0;
}

fn package_lock_collect(
i64 manifest_path,
i64 manifest_path_length,
i64 top_root,
i64 top_root_length,
i64 output,
i64 capacity,
i64&mut out_length,
i64 depth,
) -> i64 {
  if (depth> 32) {
    return 58;
  }

  i64 manifest = raz_rt_stage1_arena_create(65536);
  i64 root = raz_rt_stage1_arena_create(8192);
  i64 name = raz_rt_stage1_arena_create(4096);
  i64 version = raz_rt_stage1_arena_create(256);
  i64 kind = raz_rt_stage1_arena_create(256);

  if (manifest == 0 || root == 0 || name == 0 || version == 0 || kind == 0) {
    return 40;
  }

  i64 length = raz_rt_stage1_read_ascii(manifest_path, manifest_path_length, manifest, 65536);

  if (length <= 0) {
    return 57;
  }

  i64 root_length = path_dirname(manifest_path, manifest_path_length, root, 8192);
  i64 nk[4] = [110, 97, 109, 101];
  i64 vk[7] = [118, 101, 114, 115, 105, 111, 110];
  i64 kk[4] = [107, 105, 110, 100];
  i64 nl = package_manifest_field(manifest, length, &nk, 4, name, 4096);
  i64 vl = package_manifest_field(manifest, length, &vk, 7, version, 256);
  i64 kl = package_manifest_field(manifest, length, &kk, 4, kind, 256);

  if (nl <= 0) {
    return 57;
  }
  if (vl<0) {
    vl = 0;
  }
  if (kl<0) {
    kl = 0;
  }

  i64 a[12] = [91, 91, 112, 97, 99, 107, 97, 103, 101, 93, 93, 10];

  if (!package_append_literal(output, capacity, out_length, &a, 12)) {
    return 40;
  }

  i64 b[8] = [110, 97, 109, 101, 32, 61, 32, 34];

  package_append_literal(output, capacity, out_length, &b, 8);
  package_append(output, capacity, out_length, name, 0, nl);

  i64 qn[2] = [34, 10];

  package_append_literal(output, capacity, out_length, &qn, 2);

  i64 c[11] = [118, 101, 114, 115, 105, 111, 110, 32, 61, 32, 34];

  package_append_literal(output, capacity, out_length, &c, 11);
  package_append(output, capacity, out_length, version, 0, vl);
  package_append_literal(output, capacity, out_length, &qn, 2);

  i64 d[8] = [107, 105, 110, 100, 32, 61, 32, 34];

  package_append_literal(output, capacity, out_length, &d, 8);
  package_append(output, capacity, out_length, kind, 0, kl);
  package_append_literal(output, capacity, out_length, &qn, 2);

  i64 e[8] = [112, 97, 116, 104, 32, 61, 32, 34];

  package_append_literal(output, capacity, out_length, &e, 8);
  if (depth == 0) {
    i64 dot[1] = [46];

    package_append_literal(output, capacity, out_length, &dot, 1);
  } else {
    package_append(output, capacity, out_length, root, 0, root_length);
  }
  package_append_literal(output, capacity, out_length, &qn, 2);

  i64 f[17] = [109, 97, 110, 105, 102, 101, 115, 116, 95, 104, 97, 115, 104, 32, 61, 32, 34];

  package_append_literal(output, capacity, out_length, &f, 17);
  package_append_hex64(output, capacity, out_length, package_hash_manifest(manifest, length));

  i64 endq[3] = [34, 10, 10];

  package_append_literal(output, capacity, out_length, &endq, 3);

  i64 section = 0;
  i64 cursor = 0;

  while (cursor<length) {
    i64 start = cursor;

    while (
    cursor<length &&
    raz_rt_stage1_arena_get(manifest, cursor) != 10 &&
    raz_rt_stage1_arena_get(manifest, cursor) != 13
    ) {
      cursor += 1;
    }

    i64 end = cursor;

    while (
    cursor<length &&
    (
    raz_rt_stage1_arena_get(manifest, cursor) == 10 ||
    raz_rt_stage1_arena_get(manifest, cursor) == 13
    )
    ) {
      cursor += 1;
    }
    if (line_is_section(manifest, start, end, 2)) {
      section = 2;
    } else if (start<end && raz_rt_stage1_arena_get(manifest, start) == 91) {
      section = 0;
    } else if (section == 2) {
      i64 equal = start;

      while (equal<end && raz_rt_stage1_arena_get(manifest, equal) != 61) {
        equal += 1;
      }
      if (equal<end) {
        i64 dep = raz_rt_stage1_arena_create(4096);
        i64 dep_root = raz_rt_stage1_arena_create(8192);
        i64 dep_manifest = raz_rt_stage1_arena_create(8192);

        if (dep == 0 || dep_root == 0 || dep_manifest == 0) {
          return 40;
        }

        i64 dl = copy_quoted_value(manifest, equal + 1, end, dep, 4096);
        i64 drl = path_join(root, root_length, dep, dl, dep_root, 8192);
        i64 dml = package_manifest_path_from_root(dep_root, drl, dep_manifest, 8192);

        i64 status = package_lock_collect(
        dep_manifest,
        dml,
        top_root,
        top_root_length,
        output,
        capacity,
        out_length,
        depth + 1,
        );
        if (status != 0) {
          return status;
        }
        raz_rt_stage1_arena_destroy(dep);
        raz_rt_stage1_arena_destroy(dep_root);
        raz_rt_stage1_arena_destroy(dep_manifest);
      }
    }
  }
  raz_rt_stage1_arena_destroy(manifest);
  raz_rt_stage1_arena_destroy(root);
  raz_rt_stage1_arena_destroy(name);
  raz_rt_stage1_arena_destroy(version);
  raz_rt_stage1_arena_destroy(kind);
  return 0;
}

fn package_lock_command() -> i64 {
  i64 mp = raz_rt_stage1_arena_create(16);
  i64 root = raz_rt_stage1_arena_create(2);
  i64 out = raz_rt_stage1_arena_create(2097152);

  if (mp == 0 || root == 0 || out == 0) {
    return 40;
  }

  i64 m[10] = [46, 47, 114, 97, 122, 46, 116, 111, 109, 108];
  i64 i = 0;

  while (i<10) {
    raz_rt_stage1_arena_set(mp, i, m[i]);
    i += 1;
  }
  raz_rt_stage1_arena_set(root, 0, 46);

  i64 cursor = 0;
  i64 hdr[55] = [35, 32, 71, 101, 110, 101, 114, 97, 116, 101, 100, 32, 98, 121, 32, 82, 97, 122, 46, 32, 68, 111, 32, 110, 111, 116, 32, 101, 100, 105, 116, 32, 109, 97, 110, 117, 97, 108, 108, 121, 46, 10, 118, 101, 114, 115, 105, 111, 110, 32, 61, 32, 49, 10, 10];

  package_append_literal(out, 2097152, &mut cursor, &hdr, 55);

  i64 status = package_lock_collect(mp, 11, root, 1, out, 2097152, &mut cursor, 0);

  if (status == 0) {
    i64 lp[10] = [46, 47, 114, 97, 122, 46, 108, 111, 99, 107];
    i64 lpa = raz_rt_stage1_arena_create(10);

    i = 0;
    while (i<10) {
      raz_rt_stage1_arena_set(lpa, i, lp[i]);
      i += 1;
    }
    if (raz_rt_stage1_write_ascii(lpa, 10, out, cursor) != cursor) {
      status = 56;
    }
    raz_rt_stage1_arena_destroy(lpa);
  }
  raz_rt_stage1_arena_destroy(mp);
  raz_rt_stage1_arena_destroy(root);
  raz_rt_stage1_arena_destroy(out);
  return status;
}

fn package_rewrite_dependency(i64 alias, i64 alias_length, i64 path, i64 path_length, bool remove) -> i64 {
  i64 mp = raz_rt_stage1_arena_create(11);
  i64 manifest = raz_rt_stage1_arena_create(1048576);
  i64 out = raz_rt_stage1_arena_create(2097152);

  if (mp == 0 || manifest == 0 || out == 0) {
    return 40;
  }

  i64 p[10] = [46, 47, 114, 97, 122, 46, 116, 111, 109, 108];
  i64 i = 0;

  while (i<10) {
    raz_rt_stage1_arena_set(mp, i, p[i]);
    i += 1;
  }

  i64 length = raz_rt_stage1_read_ascii(mp, 10, manifest, 1048576);

  if (length <= 0) {
    return 57;
  }

  i64 cursor = 0;
  i64 section = 0;
  bool found_section = false;
  bool replaced = false;
  i64 pos = 0;

  while (pos<length) {
    i64 start = pos;

    while (
    pos<length &&
    raz_rt_stage1_arena_get(manifest, pos) != 10 &&
    raz_rt_stage1_arena_get(manifest, pos) != 13
    ) {
      pos += 1;
    }

    i64 end = pos;

    while (
    pos<length &&
    (raz_rt_stage1_arena_get(manifest, pos) == 10 || raz_rt_stage1_arena_get(manifest, pos) == 13)
    ) {
      pos += 1;
    }
    if (line_is_section(manifest, start, end, 2)) {
      section = 2;
      found_section = true;
      package_append(out, 2097152, &mut cursor, manifest, start, end - start);

      i64 nl[1] = [10];

      package_append_literal(out, 2097152, &mut cursor, &nl, 1);
    } else if (start<end && raz_rt_stage1_arena_get(manifest, start) == 91) {
      if (section == 2 && !replaced && !remove) {
        package_append(out, 2097152, &mut cursor, alias, 0, alias_length);

        i64 mid[4] = [32, 61, 32, 34];

        package_append_literal(out, 2097152, &mut cursor, &mid, 4);
        package_append(out, 2097152, &mut cursor, path, 0, path_length);

        i64 tail[2] = [34, 10];

        package_append_literal(out, 2097152, &mut cursor, &tail, 2);
        replaced = true;
      }
      section = 0;
      package_append(out, 2097152, &mut cursor, manifest, start, end - start);

      i64 nl[1] = [10];

      package_append_literal(out, 2097152, &mut cursor, &nl, 1);
    } else if (section == 2) {
      i64 equal = start;

      while (equal<end && raz_rt_stage1_arena_get(manifest, equal) != 61) {
        equal += 1;
      }
      if (equal<end && package_key_equals(manifest, start, equal, alias, alias_length)) {
        if (!remove) {
          package_append(out, 2097152, &mut cursor, alias, 0, alias_length);

          i64 mid[4] = [32, 61, 32, 34];

          package_append_literal(out, 2097152, &mut cursor, &mid, 4);
          package_append(out, 2097152, &mut cursor, path, 0, path_length);

          i64 tail[2] = [34, 10];

          package_append_literal(out, 2097152, &mut cursor, &tail, 2);
        }
        replaced = true;
      } else {
        package_append(out, 2097152, &mut cursor, manifest, start, end - start);

        i64 nl[1] = [10];

        package_append_literal(out, 2097152, &mut cursor, &nl, 1);
      }
    } else {
      package_append(out, 2097152, &mut cursor, manifest, start, end - start);
      if (pos> start) {
        i64 nl[1] = [10];

        package_append_literal(out, 2097152, &mut cursor, &nl, 1);
      }
    }
  }
  if (found_section && section == 2 && !replaced && !remove) {
    package_append(out, 2097152, &mut cursor, alias, 0, alias_length);

    i64 mid[4] = [32, 61, 32, 34];

    package_append_literal(out, 2097152, &mut cursor, &mid, 4);
    package_append(out, 2097152, &mut cursor, path, 0, path_length);

    i64 tail[2] = [34, 10];

    package_append_literal(out, 2097152, &mut cursor, &tail, 2);
    replaced = true;
  }
  if (!found_section && !remove) {
    i64 sec[16] = [10, 91, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93, 10];

    package_append_literal(out, 2097152, &mut cursor, &sec, 16);
    package_append(out, 2097152, &mut cursor, alias, 0, alias_length);

    i64 mid[4] = [32, 61, 32, 34];

    package_append_literal(out, 2097152, &mut cursor, &mid, 4);
    package_append(out, 2097152, &mut cursor, path, 0, path_length);

    i64 tail[2] = [34, 10];

    package_append_literal(out, 2097152, &mut cursor, &tail, 2);
    replaced = true;
  }
  if (remove && !replaced) {
    return 59;
  }
  if (raz_rt_stage1_write_ascii(mp, 11, out, cursor) != cursor) {
    return 56;
  }
  raz_rt_stage1_arena_destroy(mp);
  raz_rt_stage1_arena_destroy(manifest);
  raz_rt_stage1_arena_destroy(out);
  return 0;
}

fn package_add_command(i64 argc) -> i64 {
  if (argc != 3 && argc != 4) {
    return 55;
  }

  i64 alias = raz_rt_stage1_arena_create(4096);
  i64 path = raz_rt_stage1_arena_create(4096);
  i64 dep_manifest = raz_rt_stage1_arena_create(8192);

  if (alias == 0 || path == 0 || dep_manifest == 0) {
    return 40;
  }

  i64 al = raz_rt_stage1_process_arg(2, alias, 4096);

  if (argc == 3) {
    i64 rs = package_add_official_registry_command(alias, al);

    raz_rt_stage1_arena_destroy(alias);
    raz_rt_stage1_arena_destroy(path);
    raz_rt_stage1_arena_destroy(dep_manifest);
    return rs;
  }

  i64 pl = raz_rt_stage1_process_arg(3, path, 4096);
  i64 rp[9] = [114, 101, 103, 105, 115, 116, 114, 121, 58];
  bool is_registry = pl> 9;
  i64 ri = 0;

  while (is_registry && ri<9) {
    if (raz_rt_stage1_arena_get(path, ri) != rp[ri]) {
      is_registry = false;
    }
    ri += 1;
  }
  if (is_registry) {
    i64 rs = package_add_registry_command(alias, al, path, pl);

    raz_rt_stage1_arena_destroy(alias);
    raz_rt_stage1_arena_destroy(path);
    raz_rt_stage1_arena_destroy(dep_manifest);
    return rs;
  }

  i64 dml = package_manifest_path_from_root(path, pl, dep_manifest, 8192);
  i64 probe = raz_rt_stage1_arena_create(1);

  if (al <= 0 || pl <= 0 || dml <= 0 || raz_rt_stage1_read_ascii(dep_manifest, dml, probe, 1) < 0) {
    return 57;
  }
  raz_rt_stage1_arena_destroy(probe);

  i64 status = package_rewrite_dependency(alias, al, path, pl, false);

  if (status == 0) {
    status = package_lock_command();
  }
  raz_rt_stage1_arena_destroy(alias);
  raz_rt_stage1_arena_destroy(path);
  raz_rt_stage1_arena_destroy(dep_manifest);
  return status;
}

fn package_remove_command(i64 argc) -> i64 {
  if (argc != 3) {
    return 55;
  }

  i64 alias = raz_rt_stage1_arena_create(4096);

  if (alias == 0) {
    return 40;
  }

  i64 al = raz_rt_stage1_process_arg(2, alias, 4096);
  i64 empty = raz_rt_stage1_arena_create(1);
  i64 status = package_rewrite_dependency(alias, al, empty, 0, true);

  if (status == 0) {
    i64 rs = registry_remove_tracking(alias, al);

    if (rs != 0) {
      status = rs;
    }
  }
  if (status == 0) {
    status = package_lock_command();
  }
  raz_rt_stage1_arena_destroy(alias);
  raz_rt_stage1_arena_destroy(empty);
  return status;
}

fn package_metadata_command(bool graph_mode) -> i64 {
  i64 mp = raz_rt_stage1_arena_create(11);

  if (mp == 0) {
    return 40;
  }

  i64 p[10] = [46, 47, 114, 97, 122, 46, 116, 111, 109, 108];
  i64 i = 0;

  while (i<10) {
    raz_rt_stage1_arena_set(mp, i, p[i]);
    i += 1;
  }

  i64 status = package_print_metadata_manifest(mp, 10, 0, graph_mode);

  raz_rt_stage1_arena_destroy(mp);
  return status;
}
