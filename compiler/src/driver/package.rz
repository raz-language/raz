    i64 length = raz_compiler_rt_read_ascii(tracking_path, 10, data, 1048576);

    if (length < 0) {
        raz_compiler_rt_arena_destroy(tracking_path);
        raz_compiler_rt_arena_destroy(data);
        return 0;
    }

    i64 pos = 0;

    while (pos < length) {
        i64 start = pos;

        while (pos < length && raz_compiler_rt_arena_get(data, pos) != 10) {
            pos += 1;
        }

        i64 end = pos;

        if (pos < length) {
            pos += 1;
        }

        i64 equal = start;

        while (equal < end && raz_compiler_rt_arena_get(data, equal) != 61) {
            equal += 1;
