        }

        i64 spec = raz_compiler_rt_arena_create(8192);
        i64 path = raz_compiler_rt_arena_create(8192);
        i64 manifest = raz_compiler_rt_arena_create(8192);

        if (spec == 0 || path == 0 || manifest == 0) {
            return 40;
        }

        i64 spec_length = copy_quoted_value(data, equal + 1, end, spec, 8192);
        i64 pipe = 0;

        while (pipe < spec_length && raz_compiler_rt_arena_get(spec, pipe) != 124) {
