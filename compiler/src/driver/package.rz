        }
    } else if (kind_length == 14) {
        string expected = "static-library";

        is_library = true;

        i64 index = 0;

        while (index < 14) {
            if (raz_compiler_rt_arena_get(kind, index) != compiler_literal_byte(expected, index)) {
                is_library = false;
            }
            index += 1;
        }
    }
    raz_compiler_rt_arena_destroy(manifest_path);
    raz_compiler_rt_arena_destroy(manifest);
    raz_compiler_rt_arena_destroy(kind);
    if (is_library) {
        return 1;
    }
    return 0;
}

fn package_workspace_lock_loaded(i64 members, i64[]offsets, i64[]lengths, i64 count) -> i64 {
    i64 output = raz_compiler_rt_arena_create(4194304);
    i64 manifest_path = raz_compiler_rt_arena_create(8192);
    i64 root = raz_compiler_rt_arena_create(2);
    i64 seen = raz_compiler_rt_arena_create(262144);
    i64 identities = raz_compiler_rt_arena_create(262144);

    if (output == 0 || manifest_path == 0 || root == 0 || seen == 0 || identities == 0) {
        return 40;
    }
    raz_compiler_rt_arena_set(root, 0, 46);

    i64 cursor = 0;
    i64 seen_length = 0;
    i64 identities_length = 0;

    if (!package_append_string_literal(output, 4194304, &mut cursor, "# Generated by Raz workspace. Do not edit manually.\nversion = 1\nworkspace = true\n\n")) {
        return 40;
    }

    i64 member = 0;

    while (member < count) {
        i64 manifest_length = package_workspace_member_manifest(
            members,
            offsets[member],
            lengths[member],
            manifest_path,
            8192,
        );
        if (manifest_length <= 0) {
            return 57;
        }
        i64 status = package_lock_collect(
            manifest_path,
            manifest_length,
            root,
            1,
            output,
            4194304,
            &mut cursor,
            1,
            seen,
            &mut seen_length,
            identities,
            &mut identities_length,
        );
        if (status != 0) {
            return status;
        }
        member += 1;
    }

    i64 lock_path = raz_compiler_rt_arena_create(10);

    if (lock_path == 0) {
        return 40;
    }

    string lp = "./raz.lock";
    i64 index = 0;

    while (index < 10) {
        raz_compiler_rt_arena_set(lock_path, index, compiler_literal_byte(lp, index));
        index += 1;
    }

    i64 status = 0;

    if (raz_compiler_rt_write_ascii(lock_path, 10, output, cursor) != cursor) {
        status = 56;
    }
    raz_compiler_rt_arena_destroy(lock_path);
    raz_compiler_rt_arena_destroy(output);
    raz_compiler_rt_arena_destroy(manifest_path);
    raz_compiler_rt_arena_destroy(root);
    raz_compiler_rt_arena_destroy(seen);
    raz_compiler_rt_arena_destroy(identities);
    return status;
}

fn package_workspace_metadata_loaded(
    i64 members,
    i64[]offsets,
    i64[]lengths,
    i64 count,
    bool graph_mode,
) -> i64 {
    i64 manifest_path = raz_compiler_rt_arena_create(8192);

    if (manifest_path == 0) {
        return 40;
    }

    i64 member = 0;

    while (member < count) {
        package_workspace_print_member(members, offsets[member], lengths[member]);
        i64 manifest_length = package_workspace_member_manifest(
            members,
            offsets[member],
            lengths[member],
            manifest_path,
            8192,
        );
        if (manifest_length <= 0) {
            raz_compiler_rt_arena_destroy(manifest_path);
            return 57;
        }

        i64 status = package_print_metadata_manifest(manifest_path, manifest_length, 0, graph_mode);

        if (status != 0) {
            raz_compiler_rt_arena_destroy(manifest_path);
            return status;
        }
        member += 1;
    }
    raz_compiler_rt_arena_destroy(manifest_path);
    return 0;
}

fn package_workspace_remove_member_lock(i64 members, i64 offset, i64 member_length) {
    i64 path = raz_compiler_rt_arena_create(8192);

    if (path == 0) {
        return;
    }

    i64 index = 0;

    while (index < member_length) {
        raz_compiler_rt_arena_set(path, index, raz_compiler_rt_arena_get(members, offset + index));
        index += 1;
    }

    string suffix = "/raz.lock";
    i64 suffix_index = 0;

    while (suffix_index < 9) {
        raz_compiler_rt_arena_set(path, index, compiler_literal_byte(suffix, suffix_index));
        index += 1;
        suffix_index += 1;
    }
    if (raz_compiler_rt_path_exists_ascii(path, index) == 1) {
        raz_compiler_rt_remove_path_ascii(path, index);
    }
    raz_compiler_rt_arena_destroy(path);
}

fn package_workspace_command(i64 argc, i64 command) -> i64 {
    if (!package_workspace_command_supported(command)) {
        return 55;
    }

    i64 manifest = raz_compiler_rt_arena_create(1048576);
    i64 members = raz_compiler_rt_arena_create(65536);

    if (manifest == 0 || members == 0) {
        return 40;
    }

    i64 offsets[128];
    i64 lengths[128];
    i64 count = 0;

    i64 status = package_workspace_load(
        manifest,
        1048576,
        members,
        65536,
        &mut offsets,
        &mut lengths,
        &mut count,
    );
    if (status != 0) {
        raz_compiler_rt_arena_destroy(manifest);
        raz_compiler_rt_arena_destroy(members);
        return status;
    }
    if (command == 23) {
        status = package_workspace_lock_loaded(members, &offsets, &lengths, count);
        raz_compiler_rt_arena_destroy(manifest);
        raz_compiler_rt_arena_destroy(members);
        return status;
    }
    if (command == 24 || command == 25 || command == 34) {
        status = package_workspace_metadata_loaded(
            members,
            &offsets,
            &lengths,
            count,
            command == 25 || command == 34,
        );
        raz_compiler_rt_arena_destroy(manifest);
        raz_compiler_rt_arena_destroy(members);
        return status;
    }

    i64 program = raz_compiler_rt_arena_create(8192);
    i64 arguments = raz_compiler_rt_arena_create(65536);
    i64 cwd = raz_compiler_rt_arena_create(8192);

    if (program == 0 || arguments == 0 || cwd == 0) {
        return 40;
    }

    i64 program_length = raz_compiler_rt_process_arg(0, program, 8192);

    if (program_length <= 0) {
        return 55;
    }

    i64 arguments_length = 0;
    i64 argument_count = 0;
    i64 member = 0;

    while (member < count) {
        i64 child_command = command;

        if (command == 3) {
            i64 library_kind = package_workspace_member_library_kind(
                members,
                offsets[member],
                lengths[member],
            );
            if (library_kind < 0) {
                status = 57;
                break;
            }
            if (library_kind == 1) {
                child_command = 4;
            }
        }
        status = package_workspace_build_arguments(
            argc,
            command,
            child_command,
            arguments,
            65536,
            &mut arguments_length,
            &mut argument_count,
        );
        if (status != 0) {
            break;
        }
        package_workspace_print_member(members, offsets[member], lengths[member]);

        i64 index = 0;

        while (index < lengths[member]) {
            raz_compiler_rt_arena_set(
                cwd,
                index,
                raz_compiler_rt_arena_get(members, offsets[member] + index),
            );
            index += 1;
        }
        i64 child = raz_compiler_rt_process_run_argv_cwd_ascii(
            program,
            program_length,
            arguments,
            arguments_length,
            argument_count,
            cwd,
            lengths[member],
        );
        if (child != 0) {
            if (child> 0) {
                status = child;
            } else {
                status = 56;
            }
            break;
        }
        if (command == 22 || command == 30) {
            package_workspace_remove_member_lock(members, offsets[member], lengths[member]);
        }
        member += 1;
    }
    if (status == 0 && (command == 22 || command == 30)) {
        status = package_workspace_lock_loaded(members, &offsets, &lengths, count);
    }
    raz_compiler_rt_arena_destroy(program);
    raz_compiler_rt_arena_destroy(arguments);
    raz_compiler_rt_arena_destroy(cwd);
    raz_compiler_rt_arena_destroy(manifest);
    raz_compiler_rt_arena_destroy(members);
    return status;
}
