fn cli_entry_override_option(i64 value, i64 length) -> bool {
    if (value == 0 || length <= 8) {
        return false;
    }

    i64 prefix[8] = [45, 45, 101, 110, 116, 114, 121, 61];
    i64 i = 0;

    while (i < 8) {
        if (raz_compiler_rt_arena_get(value, i) != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn cli_all_features_option(i64 value, i64 length) -> bool {
    i64 word[14] = [45, 45, 97, 108, 108, 45, 102, 101, 97, 116, 117, 114, 101, 115];

    return cli_arg_equals(value, length, &word, 14);
}

fn cli_no_default_features_option(i64 value, i64 length) -> bool {
    i64 word[21] = [45, 45, 110, 111, 45, 100, 101, 102, 97, 117, 108, 116, 45, 102, 101, 97, 116, 117, 114, 101, 115];

    return cli_arg_equals(value, length, &word, 21);
}

fn cli_features_option(i64 value, i64 length, i64 output, i64 capacity) -> i64 {
    i64 prefix[11] = [45, 45, 102, 101, 97, 116, 117, 114, 101, 115, 61];

    if (output == 0) {
        return -1;
    }
    if (length < 11) {
        return 0;
    }

    i64 i = 0;

    while (i < 11) {
        if (raz_compiler_rt_arena_get(value, i) != prefix[i]) {
            return 0;
        }
        i += 1;
    }

    i64 out_length = length - 11;

    if (out_length <= 0 || out_length > capacity) {
        return -1;
    }
    i = 0;
    while (i < out_length) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(value, 11 + i));
        i += 1;
    }
    return out_length;
}

fn cli_backend_shortcut(i64 value, i64 length) -> i64 {
    i64 forge_word[7] = [45, 45, 102, 111, 114, 103, 101];

    if (cli_arg_equals(value, length, &forge_word, 7)) {
        return 0;
    }

    i64 llvm_word[6] = [45, 45, 108, 108, 118, 109];

    if (cli_arg_equals(value, length, &llvm_word, 6)) {
        return 1;
    }

    i64 wasm_word[6] = [45, 45, 119, 97, 115, 109];

    if (cli_arg_equals(value, length, &wasm_word, 6)) {
        return 2;
    }

    i64 rxe_word[5] = [45, 45, 114, 120, 101];

    if (cli_arg_equals(value, length, &rxe_word, 5)) {
        return 3;
    }
    return -1;
}

fn cli_tool_available(i64[]name, i64 length) -> bool {
    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return false;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, name[i]);
        i += 1;
    }

    bool result = raz_compiler_rt_tool_available(buffer, length) > 0;

    raz_compiler_rt_arena_destroy(buffer);
    return result;
}

fn cli_print_status_line(i64[]label, i64 label_length, bool ok) {
    i64 buffer = raz_compiler_rt_arena_create(64);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < label_length) {
        raz_compiler_rt_arena_set(buffer, i, label[i]);
        i += 1;
    }
    while (i < 30) {
        raz_compiler_rt_arena_set(buffer, i, 32);
        i += 1;
    }
    if (ok) {
        i64 word[3] = [79, 75, 10];
        i64 j = 0;

        while (j < 3) {
            raz_compiler_rt_arena_set(buffer, i + j, word[j]);
            j += 1;
        }
        i += 3;
    } else {
        i64 word[8] = [77, 73, 83, 83, 73, 78, 71, 10];
        i64 j = 0;

        while (j < 8) {
            raz_compiler_rt_arena_set(buffer, i + j, word[j]);
            j += 1;
        }
        i += 8;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, i);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_print_doctor() {
    i64 heading[26] = [82, 97, 122, 32, 116, 111, 111, 108, 99, 104, 97, 105, 110, 32, 100, 105, 97, 103, 110, 111, 115, 116, 105, 99, 115, 10];

    cli_write(&heading, 26);

    i64 compiler_label[12] = [82, 97, 122, 32, 99, 111, 109, 112, 105, 108, 101, 114];

    cli_print_status_line(&compiler_label, 12, true);

    i64 forge_label[13] = [70, 111, 114, 103, 101, 32, 98, 97, 99, 107, 101, 110, 100];

    cli_print_status_line(&forge_label, 13, true);

    i64 llvm_label[12] = [76, 76, 86, 77, 32, 98, 97, 99, 107, 101, 110, 100];

    cli_print_status_line(&llvm_label, 12, true);

    i64 clang_name[5] = [99, 108, 97, 110, 103];
    i64 clangxx_name[7] = [99, 108, 97, 110, 103, 43, 43];
    i64 clang_label[19] = [99, 108, 97, 110, 103, 32, 40, 76, 76, 86, 77, 32, 111, 98, 106, 101, 99, 116, 41];

    cli_print_status_line(&clang_label, 19, cli_tool_available(&clang_name, 5));

    i64 clangxx_label[19] = [99, 108, 97, 110, 103, 43, 43, 32, 40, 76, 76, 86, 77, 32, 108, 105, 110, 107, 41];

    cli_print_status_line(&clangxx_label, 19, cli_tool_available(&clangxx_name, 7));

    i64 platform = raz_compiler_rt_host_platform();

    if (platform == 1) {
        i64 p[14] = [72, 111, 115, 116, 58, 32, 87, 105, 110, 100, 111, 119, 115, 10];

        cli_write(&p, 14);
    } else if (platform == 2) {
        i64 p[12] = [72, 111, 115, 116, 58, 32, 76, 105, 110, 117, 120, 10];

        cli_write(&p, 12);
    } else if (platform == 3) {
        i64 p[12] = [72, 111, 115, 116, 58, 32, 109, 97, 99, 79, 83, 10];

        cli_write(&p, 12);
    } else {
        i64 p[14] = [72, 111, 115, 116, 58, 32, 117, 110, 107, 110, 111, 119, 110, 10];

        cli_write(&p, 14);
    }
}

fn cli_write_text(i64[]text, i64 length) {
    cli_write(text, length);
}

fn cli_run_shell(i64[]command, i64 length) -> i64 {
    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return -1;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, command[i]);
        i += 1;
    }

    i64 result = raz_compiler_rt_process_run_ascii(buffer, length);

    raz_compiler_rt_arena_destroy(buffer);
    return result;
}

fn cli_clean_project() -> i64 {
    if (raz_compiler_rt_host_platform() == 1) {
        i64 cmd[31] = [99, 109, 100, 32, 47, 99, 32, 114, 109, 100, 105, 114, 32, 47, 115, 32, 47, 113, 32, 98, 117, 105, 108, 100, 32, 50, 62, 110, 117, 108, 108];
        i64 status = cli_run_shell(&cmd, 31);

        if (status != 0) {
            return status;
        }
    } else {
        i64 cmd[12] = [114, 109, 32, 45, 114, 102, 32, 98, 117, 105, 108, 100];
        i64 status = cli_run_shell(&cmd, 12);

        if (status != 0) {
            return status;
        }
    }

    i64 msg[22] = [82, 101, 109, 111, 118, 101, 100, 32, 98, 117, 105, 108, 100, 32, 97, 114, 116, 105, 102, 97, 99, 116];

    cli_write_text(&msg, 22);

    i64 nl[1] = [10];

    cli_write_text(&nl, 1);
    return 0;
}

fn cli_create_project_files(i64 root, i64 root_length) -> i64 {
    if (root == 0 || root_length <= 0) {
        return 55;
    }

    i64 command = raz_compiler_rt_arena_create(8192);

    if (command == 0) {
        return 40;
    }

    i64 cursor = 0;

    if (raz_compiler_rt_host_platform() == 1) {
        i64 pre[14] = [99, 109, 100, 32, 47, 99, 32, 109, 107, 100, 105, 114, 32, 34];
        i64 i = 0;

        while (i < 14) {
            raz_compiler_rt_arena_set(command, cursor, pre[i]);
            cursor += 1;
            i += 1;
        }
        i = 0;
        while (i < root_length) {
            raz_compiler_rt_arena_set(command, cursor, raz_compiler_rt_arena_get(root, i));
            cursor += 1;
            i += 1;
        }

        i64 suf[5] = [92, 115, 114, 99, 34];

        i = 0;
        while (i < 5) {
            raz_compiler_rt_arena_set(command, cursor, suf[i]);
            cursor += 1;
            i += 1;
        }
    } else {
        i64 pre[10] = [109, 107, 100, 105, 114, 32, 45, 112, 32, 39];
        i64 i = 0;

        while (i < 10) {
            raz_compiler_rt_arena_set(command, cursor, pre[i]);
            cursor += 1;
            i += 1;
        }
        i = 0;
        while (i < root_length) {
            raz_compiler_rt_arena_set(command, cursor, raz_compiler_rt_arena_get(root, i));
            cursor += 1;
            i += 1;
        }

        i64 suf[5] = [47, 115, 114, 99, 39];

        i = 0;
        while (i < 5) {
            raz_compiler_rt_arena_set(command, cursor, suf[i]);
            cursor += 1;
            i += 1;
        }
    }
    if (raz_compiler_rt_process_run_ascii(command, cursor) != 0) {
        raz_compiler_rt_arena_destroy(command);
        return 56;
    }
    raz_compiler_rt_arena_destroy(command);

    i64 manifest_path = raz_compiler_rt_arena_create(root_length + 16);
    i64 source_path = raz_compiler_rt_arena_create(root_length + 20);

    if (manifest_path == 0 || source_path == 0) {
        return 40;
    }

    i64 i = 0;

    while (i < root_length) {
        i64 b = raz_compiler_rt_arena_get(root, i);

        raz_compiler_rt_arena_set(manifest_path, i, b);
        raz_compiler_rt_arena_set(source_path, i, b);
        i += 1;
    }

    i64 mp[9] = [47, 114, 97, 122, 46, 116, 111, 109, 108];

    i = 0;
    while (i < 9) {
        raz_compiler_rt_arena_set(manifest_path, root_length + i, mp[i]);
        i += 1;
    }

    i64 sp[12] = [47, 115, 114, 99, 47, 109, 97, 105, 110, 46, 114, 122];

    i = 0;
    while (i < 12) {
        raz_compiler_rt_arena_set(source_path, root_length + i, sp[i]);
        i += 1;
    }

    i64 manifest[163] = [91, 112, 97, 99, 107, 97, 103, 101, 93, 10, 110, 97, 109, 101, 32, 61, 32, 34, 114, 97, 122, 45, 97, 112, 112, 34, 10, 118, 101, 114, 115, 105, 111, 110, 32, 61, 32, 34, 48, 46, 49, 46, 48, 34, 10, 107, 105, 110, 100, 32, 61, 32, 34, 101, 120, 101, 99, 117, 116, 97, 98, 108, 101, 34, 10, 115, 111, 117, 114, 99, 101, 32, 61, 32, 34, 115, 114, 99, 34, 10, 101, 110, 116, 114, 121, 32, 61, 32, 34, 115, 114, 99, 47, 109, 97, 105, 110, 46, 114, 122, 34, 10, 10, 91, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93, 10, 10, 91, 100, 101, 118, 45, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93, 10, 10, 91, 102, 101, 97, 116, 117, 114, 101, 115, 93, 10, 100, 101, 102, 97, 117, 108, 116, 32, 61, 32, 91, 93, 10];
    i64 manifest_data = raz_compiler_rt_arena_create(163);

    if (manifest_data == 0) {
        return 40;
    }
    i = 0;
    while (i < 163) {
        raz_compiler_rt_arena_set(manifest_data, i, manifest[i]);
        i += 1;
    }
    if (raz_compiler_rt_write_ascii(manifest_path, root_length + 9, manifest_data, 163) < 0) {
        return 56;
    }

    i64 source[35] = [102, 110, 32, 109, 97, 105, 110, 40, 41, 32, 45, 62, 32, 105, 54, 52, 32, 123, 10, 32, 32, 32, 32, 114, 101, 116, 117, 114, 110, 32, 48, 59, 10, 125, 10];
    i64 source_data = raz_compiler_rt_arena_create(35);

    if (source_data == 0) {
        return 40;
    }
    i = 0;
    while (i < 35) {
        raz_compiler_rt_arena_set(source_data, i, source[i]);
        i += 1;
    }
    if (raz_compiler_rt_write_ascii(source_path, root_length + 12, source_data, 35) < 0) {
        return 56;
    }
    raz_compiler_rt_arena_destroy(manifest_path);
    raz_compiler_rt_arena_destroy(source_path);
    raz_compiler_rt_arena_destroy(manifest_data);
    raz_compiler_rt_arena_destroy(source_data);
    return 0;
}

fn cli_init_project() -> i64 {
    i64 root = raz_compiler_rt_arena_create(1);

    if (root == 0) {
        return 40;
    }
    raz_compiler_rt_arena_set(root, 0, 46);

    i64 result = cli_create_project_files(root, 1);

    raz_compiler_rt_arena_destroy(root);
    return result;
}

fn cli_new_project(i64 argc) -> i64 {
    if (argc != 3) {
        cli_print_invalid_arguments();
        return 2;
    }

    i64 root = raz_compiler_rt_arena_create(4096);

    if (root == 0) {
        return 40;
    }

    i64 len = raz_compiler_rt_process_arg(2, root, 4096);

    if (len <= 0) {
        return 55;
    }

    i64 result = cli_create_project_files(root, len);

    raz_compiler_rt_arena_destroy(root);
    return result;
}

fn cli_run_output(i64 output, i64 output_length) -> i64 {
    if (output == 0 || output_length <= 0) {
        return 55;
    }

    i64 command = raz_compiler_rt_arena_create(output_length + 4);

    if (command == 0) {
        return 40;
    }

    i64 cursor = 0;

    if (raz_compiler_rt_host_platform() != 1 && raz_compiler_rt_arena_get(output, 0) != 47) {
        raz_compiler_rt_arena_set(command, cursor, 46);
        cursor += 1;
        raz_compiler_rt_arena_set(command, cursor, 47);
        cursor += 1;
    }

    i64 i = 0;

    while (i < output_length) {
        raz_compiler_rt_arena_set(command, cursor, raz_compiler_rt_arena_get(output, i));
        cursor += 1;
        i += 1;
    }

    i64 status = raz_compiler_rt_process_run_ascii(command, cursor);

    raz_compiler_rt_arena_destroy(command);
    return status;
}
