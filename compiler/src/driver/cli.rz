    cli_write_stream(2, &prefix, 35);
    cli_write_command_name(2, best_kind);
    cli_write_stream(2, &suffix, 2);
}

fn cli_print_unknown_command_at(i64 argc, i64 index) {
    if (index >= argc) {
        return;
    }

    i64 arg = raz_compiler_rt_arena_create(4096);

    if (arg == 0) {
        return;
    }

    i64 length = cli_load_arg(index, arg, 4096);

    if (length > 0) {
        i64 prefix[25] = [101, 114, 114, 111, 114, 58, 32, 110, 111, 32, 115, 117, 99, 104, 32, 99, 111, 109, 109, 97, 110, 100, 58, 32, 39];
        i64 suffix[2] = [39, 10];
        i64 help[44] = [32, 32, 104, 101, 108, 112, 58, 32, 118, 105, 101, 119, 32, 97, 108, 108, 32, 99, 111, 109, 109, 97, 110, 100, 115, 32, 119, 105, 116, 104, 32, 39, 114, 97, 122, 32, 45, 45, 104, 101, 108, 112, 39, 10];

        cli_write_stream(2, &prefix, 25);
        cli_write_arena_stream(2, arg, length);
        cli_write_stream(2, &suffix, 2);
        cli_print_command_suggestion(arg, length);
        cli_write_stream(2, &help, 44);
    }
    raz_compiler_rt_arena_destroy(arg);
}

fn cli_print_unknown_option(i64 value, i64 length) {
    i64 prefix[28] = [101, 114, 114, 111, 114, 58, 32, 117, 110, 101, 120, 112, 101, 99, 116, 101, 100, 32, 97, 114, 103, 117, 109, 101, 110, 116, 32, 39];
    i64 suffix[2] = [39, 10];
    i64 help[45] = [32, 32, 104, 101, 108, 112, 58, 32, 114, 117, 110, 32, 39, 114, 97, 122, 32, 60, 99, 111, 109, 109, 97, 110, 100, 62, 32, 45, 45, 104, 101, 108, 112, 39, 32, 102, 111, 114, 32, 117, 115, 97, 103, 101, 10];

    cli_write_stream(2, &prefix, 28);
    cli_write_arena_stream(2, value, length);
    cli_write_stream(2, &suffix, 2);
    cli_write_stream(2, &help, 45);
}

