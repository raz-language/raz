namespace raz_compiler_driver_cli;
public import raz_compiler_driver_project;
// Human-facing compiler CLI. Keep bootstrap/legacy invocations compatible while
// providing discoverable commands and backend-specific help.
extern fn raz_rt_stdio_is_terminal(i64 stream) -> i64;

fn cli_write_stream(i64 stream, i64[]text, i64 length) {
    if (length <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, text[i]);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(stream, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_write(i64[]text, i64 length) {
    if (length <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, text[i]);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_write_arena_stream(i64 stream, i64 value, i64 length) {
    if (value == 0 || length <= 0) {
        return;
    }
    raz_compiler_rt_stdio_write_ascii(stream, value, length);
}

fn cli_print_status(i64 kind, i64 detail, i64 detail_length) {
    i64 label_length = 0;

    if (kind == 1) {
        i64 label[9] = [67, 111, 109, 112, 105, 108, 105, 110, 103];

        label_length = 9;

        i64 spaces[3] = [32, 32, 32];

        cli_write_stream(1, &spaces, 3);
        cli_write_stream(1, &label, 9);
    } else if (kind == 2) {
        i64 label[8] = [67, 104, 101, 99, 107, 105, 110, 103];

        label_length = 8;

        i64 spaces[4] = [32, 32, 32, 32];

        cli_write_stream(1, &spaces, 4);
        cli_write_stream(1, &label, 8);
    } else if (kind == 3) {
        i64 label[5] = [70, 114, 101, 115, 104];

        label_length = 5;

        i64 spaces[7] = [32, 32, 32, 32, 32, 32, 32];

        cli_write_stream(1, &spaces, 7);
        cli_write_stream(1, &label, 5);
    } else if (kind == 4) {
        i64 label[7] = [82, 117, 110, 110, 105, 110, 103];

        label_length = 7;

        i64 spaces[5] = [32, 32, 32, 32, 32];

        cli_write_stream(1, &spaces, 5);
        cli_write_stream(1, &label, 7);
    } else if (kind == 5) {
        i64 label[7] = [84, 101, 115, 116, 105, 110, 103];

        label_length = 7;

        i64 spaces[5] = [32, 32, 32, 32, 32];

        cli_write_stream(1, &spaces, 5);
        cli_write_stream(1, &label, 7);
    } else if (kind == 6) {
        i64 label[8] = [70, 105, 110, 105, 115, 104, 101, 100];

        label_length = 8;

        i64 spaces[4] = [32, 32, 32, 32];

        cli_write_stream(1, &spaces, 4);
        cli_write_stream(1, &label, 8);
    } else if (kind == 7) {
        i64 label[7] = [67, 104, 101, 99, 107, 101, 100];

        label_length = 7;

        i64 spaces[5] = [32, 32, 32, 32, 32];

        cli_write_stream(1, &spaces, 5);
        cli_write_stream(1, &label, 7);
    } else if (kind == 8) {
        i64 label[6] = [84, 101, 115, 116, 101, 100];

        label_length = 6;

        i64 spaces[6] = [32, 32, 32, 32, 32, 32];

        cli_write_stream(1, &spaces, 6);
        cli_write_stream(1, &label, 6);
    }
    if (label_length <= 0) {
        return;
    }

    i64 space[1] = [32];
    i64 newline[1] = [10];

    cli_write_stream(1, &space, 1);
    cli_write_arena_stream(1, detail, detail_length);
    cli_write_stream(1, &newline, 1);
}

fn cli_print_compile_status(i64 command, i64 detail, i64 detail_length) {
    if (command <= 0) {
        return;
    }
    if (command == 4 || command == 11 || command == 17) {
        cli_print_status(2, detail, detail_length);
    } else {
        cli_print_status(1, detail, detail_length);
    }
}

fn cli_print_completion_status(i64 command, i64 detail, i64 detail_length) {
    if (command <= 0) {
        return;
    }
    if (command == 4 || command == 11 || command == 17) {
        cli_print_status(7, detail, detail_length);
    } else if (command == 16) {
        cli_print_status(8, detail, detail_length);
    } else {
        cli_print_status(6, detail, detail_length);
    }
}

fn cli_edit_distance(i64 value, i64 length, i64[]expected, i64 expected_length) -> i64 {
    if (value == 0 || length < 0 || expected_length < 0 || length >= 32 || expected_length >= 32) {
        return 99;
    }

    i64 previous[32];
    i64 current[32];
    i64 j = 0;

    while (j <= expected_length) {
        previous[j] = j;
        j += 1;
    }

    i64 i = 1;

    while (i <= length) {
        current[0] = i;
        j = 1;
        while (j <= expected_length) {
            i64 deletion = previous[j] + 1;
            i64 insertion = current[j - 1] + 1;
            i64 substitution = previous[j - 1];

            if (raz_compiler_rt_arena_get(value, i - 1) != expected[j - 1]) {
                substitution += 1;
            }

            i64 best = deletion;

            if (insertion < best) {
                best = insertion;
            }
            if (substitution < best) {
                best = substitution;
            }
            current[j] = best;
            j += 1;
        }
        j = 0;
        while (j <= expected_length) {
            previous[j] = current[j];
            j += 1;
        }
        i += 1;
    }
    return previous[expected_length];
}

