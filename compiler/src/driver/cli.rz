    distance = cli_edit_distance(value, length, &candidate_32, 4);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 32;
    }

    i64 candidate_33[8] = [111, 117, 116, 100, 97, 116, 101, 100];

    distance = cli_edit_distance(value, length, &candidate_33, 8);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 33;
    }

    i64 candidate_34[4] = [116, 114, 101, 101];

    distance = cli_edit_distance(value, length, &candidate_34, 4);
    if (distance < best_distance) {
        best_distance = distance;
        best_kind = 34;
    }

    bool close = best_distance <= 1;

    if (length >= 4 && best_distance <= 2) {
        close = true;
    }
    if (length >= 8 && best_distance <= 3) {
        close = true;
    }
    if (!close || best_kind <= 0) {
        return;
    }

    i64 prefix[35] = [32, 32, 104, 101, 108, 112, 58, 32, 97, 32, 115, 105, 109, 105, 108, 97, 114, 32, 99, 111, 109, 109, 97, 110, 100, 32, 101, 120, 105, 115, 116, 115, 58, 32, 39];
