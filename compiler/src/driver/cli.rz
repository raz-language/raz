    } else if (command == 11) {
        cli_print_profile_help();
    } else if (command == 7) {
        cli_print_backends();
    } else if (command == 8) {
        cli_print_targets();
    } else if (command >= 12 && command <= 36) {
        cli_print_project_command_help(command);
    } else {
        cli_print_general_help();
    }
    if (
        command == 3 ||
        command == 4 ||
        command == 16 ||
        command == 22 ||
        command == 23 ||
        command == 24 ||
        command == 25 ||
        command == 30 ||
