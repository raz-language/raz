    cli_write_literal_stream(2, "'\n");
}

fn cli_arg_starts_with_dash(i64 value, i64 length) -> bool {
    return value != 0 && length > 0 && raz_compiler_rt_arena_get(value, 0) == 45;
}

fn cli_argument_starts_with_dash_at(i64 argc, i64 index) -> bool {
    if (index >= argc) {
        return false;
    }

    i64 arg = raz_compiler_rt_arena_create(64);

    if (arg == 0) {
        return false;
    }

    i64 length = cli_load_arg(index, arg, 64);
    bool result = cli_arg_starts_with_dash(arg, length);

    raz_compiler_rt_arena_destroy(arg);
    return result;
}

fn cli_argument_looks_like_path(i64 argc, i64 index) -> bool {
    if (index >= argc) {
        return false;
    }

    i64 arg = raz_compiler_rt_arena_create(4096);

    if (arg == 0) {
        return false;
    }

    i64 length = cli_load_arg(index, arg, 4096);

    if (length <= 0) {
        raz_compiler_rt_arena_destroy(arg);
        return false;
    }
    if (raz_compiler_rt_path_exists_ascii(arg, length) != 0) {
        raz_compiler_rt_arena_destroy(arg);
        return true;
    }

    i64 i = 0;

    while (i < length) {
        i64 ch = raz_compiler_rt_arena_get(arg, i);

        if (ch == 46 || ch == 47 || ch == 92) {
            raz_compiler_rt_arena_destroy(arg);
            return true;
        }
        i += 1;
    }
    raz_compiler_rt_arena_destroy(arg);
    return false;
}

fn cli_write_packed(i64[]words, i64 word_count, i64 length) {
    if (length <= 0 || word_count <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        i64 word_index = i / 7;
        i64 byte_index = i % 7;
        i64 value = (words[word_index] >> (byte_index * 8)) & 255;

        raz_compiler_rt_arena_set(buffer, i, value);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_error_color_enabled() -> bool {
    if (raz_rt_stdio_is_terminal(2) <= 0) {
        return false;
    }

    i64 name = raz_compiler_rt_arena_create(8);
    i64 value = raz_compiler_rt_arena_create(8);

    if (name == 0 || value == 0) {
        return true;
    }

    string chars = "NO_COLOR";
    i64 i = 0;

    while (i < 8) {
        raz_compiler_rt_arena_set(name, i, compiler_literal_byte(chars, i));
        i += 1;
    }

    i64 found = raz_compiler_rt_env_get_ascii(name, 8, value, 8);

    raz_compiler_rt_arena_destroy(name);
    raz_compiler_rt_arena_destroy(value);
    return found < 0;
}

fn cli_write_number(i64 stream, i64 value) {
    i64 digits[24];
    i64 count = 0;

    if (value < 0) {
        

        cli_write_literal_stream(stream, "-");
        value = -value;
    }
    if (value == 0) {
        

        cli_write_literal_stream(stream, "0");
        return;
    }
    while (value > 0 && count < 24) {
        digits[count] = 48 + (value % 10);
        value /= 10;
        count += 1;
    }

    i64 output[24];
    i64 i = 0;

    while (i < count) {
        output[i] = digits[count - 1 - i];
        i += 1;
    }
    cli_write_stream(stream, &output, count);
}

fn cli_frontend_diagnostic_message(DiagnosticCode code) -> i64 {
    if (code == DiagnosticCode::InvalidByte) {
        return 1;
    }
    if (code == DiagnosticCode::ExpectedToken) {
        return 2;
    }
    if (code == DiagnosticCode::ExpectedIdentifier) {
        return 3;
    }
    if (code == DiagnosticCode::TooManyItems) {
        return 4;
    }
    if (code == DiagnosticCode::UnknownName) {
        return 5;
    }
    if (code == DiagnosticCode::DuplicateName) {
        return 6;
    }
    if (code == DiagnosticCode::UnknownType) {
        return 7;
    }
    if (code == DiagnosticCode::WrongArgumentCount) {
        return 8;
    }
    if (code == DiagnosticCode::MissingReturn) {
        return 9;
    }
    if (code == DiagnosticCode::InvalidMove) {
        return 10;
    }
    if (code == DiagnosticCode::UseAfterMove) {
        return 11;
    }
    if (code == DiagnosticCode::BorrowConflict) {
        return 12;
    }
    if (code == DiagnosticCode::AmbiguousName) {
        return 13;
    }
    if (code == DiagnosticCode::UnreachablePattern) {
        return 14;
    }
    if (code == DiagnosticCode::NonExhaustivePattern) {
        return 15;
    }
    if (code == DiagnosticCode::DynTraitMethodUnavailable) {
        return 16;
    }
    return 0;
}

fn cli_find_source_origin(
    Source& input,
    i64 offset,
    i64 path,
    i64 path_capacity,
    i64&mut out_content_start,
) -> i64 {
    string prefix = "// __raz_source ";
    i64 prefix_length = compiler_literal_length(prefix);
    i64 pos = 0;
    i64 found_length = -1;
    *out_content_start = 0;
    while (pos < input.length && pos <= offset) {
        i64 line_start = pos;
        i64 line_end = pos;
        while (line_end < input.length && source_byte(input, line_end) != 10 && source_byte(input, line_end) != 13) { line_end += 1; }
        if (line_start + prefix_length <= line_end && cli_source_matches_literal(input, line_start, prefix)) {
            i64 value_start = line_start + prefix_length;
            i64 value_length = line_end - value_start;
            if (value_length > 0 && value_length <= path_capacity) {
                i64 i = 0;
                while (i < value_length) { raz_compiler_rt_arena_set(path, i, source_byte(input, value_start + i)); i += 1; }
                found_length = value_length;
                i64 next = line_end;
                while (next < input.length && (source_byte(input, next) == 10 || source_byte(input, next) == 13)) { next += 1; }
                *out_content_start = next;
            }
        }
        pos = line_end;
        while (pos < input.length && (source_byte(input, pos) == 10 || source_byte(input, pos) == 13)) { pos += 1; }
    }
    return found_length;
}

fn cli_source_local_line(Source& input, i64 content_start, i64 offset) -> i64 {
    if (content_start < 0 || content_start > offset) { return 1; }
    i64 line = 1;
    i64 i = content_start;
    while (i < offset && i < input.length) {
        if (source_byte(input, i) == 10) { line += 1; }
        i += 1;
    }
    return line;
}

fn cli_render_frontend_diagnostic(Source& input, DiagnosticCode code, i64 offset) {
    i64 message_kind = cli_frontend_diagnostic_message(code);
    bool color = cli_error_color_enabled();

    if (color) {
        i64 red[7] = [27, 91, 49, 59, 51, 49, 109];

        cli_write_stream(2, &red, 7);
    }

    

    cli_write_literal_stream(2, "error");

    

    cli_write_literal_stream(2, "[E");

    i64 numeric = diagnostic_code_value(code);
    i64 zeros = 4;

    if (numeric >= 10) {
        zeros = 3;
    }

    i64 zi = 0;

    while (zi < zeros) {
        

        cli_write_literal_stream(2, "0");
        zi += 1;
    }
    cli_write_number(2, numeric);

    

    cli_write_literal_stream(2, "]: ");
    if (color) {
        i64 reset[4] = [27, 91, 48, 109];

        cli_write_stream(2, &reset, 4);
    }
    if (message_kind == 1) {
        

        cli_write_literal_stream(2, "invalid source byte");
    } else if (message_kind == 2) {
        

        cli_write_literal_stream(2, "expected a different token");
    } else if (message_kind == 3) {
        

        cli_write_literal_stream(2, "expected an identifier");
    } else if (message_kind == 4) {
        

        cli_write_literal_stream(2, "too many items in this scope");
    } else if (message_kind == 5) {
        

        cli_write_literal_stream(2, "unknown name");
    } else if (message_kind == 6) {
        

        cli_write_literal_stream(2, "duplicate name");
    } else if (message_kind == 7) {
        

        cli_write_literal_stream(2, "unknown type");
    } else if (message_kind == 8) {
        

        cli_write_literal_stream(2, "wrong argument count");
    } else if (message_kind == 9) {
        

        cli_write_literal_stream(2, "missing return value");
    } else if (message_kind == 10) {
        

        cli_write_literal_stream(2, "invalid ownership move");
    } else if (message_kind == 11) {
        

        cli_write_literal_stream(2, "use of a moved value");
    } else if (message_kind == 12) {
        

        cli_write_literal_stream(2, "borrow conflict");
    } else if (message_kind == 13) {
        

        cli_write_literal_stream(2, "ambiguous name");
    } else if (message_kind == 14) {
        

        cli_write_literal_stream(2, "unreachable pattern");
    } else if (message_kind == 15) {
        cli_write_literal_stream(2, "non-exhaustive pattern match");
    } else if (message_kind == 16) {
        cli_write_literal_stream(2, "dynamic trait method has no dispatch implementation");
    } else {
        

        cli_write_literal_stream(2, "compilation failed");
    }

        cli_write_literal_stream(2, "\n");
    if (offset < 0) {
        offset = 0;
    }
    if (offset > input.length) {
        offset = input.length;
    }

    i64 line = 1;
    i64 column = 1;
    i64 line_start = 0;
    i64 i = 0;

    while (i < offset) {
        if (source_byte(input, i) == 10) {
            line += 1;
            column = 1;
            line_start = i + 1;
        } else {
            column += 1;
        }
        i += 1;
    }

    i64 line_end = line_start;

    while (
        line_end < input.length &&
        source_byte(input, line_end) != 10 &&
        source_byte(input, line_end) != 13
    ) {
        line_end += 1;
    }

    

    cli_write_literal_stream(2, "  --> ");
    i64 source_path = raz_compiler_rt_arena_create(8192);
    i64 source_content_start = 0;
    i64 source_path_length = -1;
    if (source_path != 0) {
        source_path_length = cli_find_source_origin(input, offset, source_path, 8192, &mut source_content_start);
    }
    i64 display_line = line;
    if (source_path_length > 0) {
        cli_write_arena_stream(2, source_path, source_path_length);
        display_line = cli_source_local_line(input, source_content_start, offset);
    } else {
        cli_write_literal_stream(2, "<input>");
    }
    cli_write_literal_stream(2, ":");
    cli_write_number(2, display_line);
    cli_write_literal_stream(2, ":");
    cli_write_number(2, column);
    cli_write_literal_stream(2, "\n");

        cli_write_literal_stream(2, "   |");
    cli_write_literal_stream(2, "\n");
    cli_write_number(2, display_line);

    

    cli_write_literal_stream(2, " | ");

    i64 cursor = line_start;

    while (cursor < line_end) {
        i64 ch[1] = [source_byte(input, cursor)];

        cli_write_stream(2, &ch, 1);
        cursor += 1;
    }
    cli_write_literal_stream(2, "\n");
    cli_write_literal_stream(2, "   |");

        cli_write_literal_stream(2, " ");

    i64 c = 1;

    while (c < column) {
        cli_write_literal_stream(2, " ");
        c += 1;
    }
    if (color) {
        i64 red2[7] = [27, 91, 49, 59, 51, 49, 109];

        cli_write_stream(2, &red2, 7);
    }

    

    cli_write_literal_stream(2, "^");
    if (color) {
        i64 reset2[4] = [27, 91, 48, 109];

        cli_write_stream(2, &reset2, 4);
    }
    cli_write_literal_stream(2, "\n");
    if (message_kind == 5 || message_kind == 7 || message_kind == 13) {
        cli_write_literal_stream(2, "  = help: check spelling, imports, and namespace qualification\n");
    } else if (message_kind == 16) {
        cli_write_literal_stream(2, "  = note: the member exists on the receiver trait, but no concrete dispatch target is available in the resolved package graph\n");
        cli_write_literal_stream(2, "  = help: run `raz update` to refresh compatible package versions; if resolution is unchanged, inspect the dependency version shown above\n");
    }
    if (source_path != 0) { raz_compiler_rt_arena_destroy(source_path); }
}

fn cli_arg_equals(i64 value, i64 length, i64[]expected, i64 expected_length) -> bool {
    if (value == 0 || length != expected_length) {
        return false;
    }

    i64 i = 0;

    while (i < expected_length) {
        if (raz_compiler_rt_arena_get(value, i) != expected[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn cli_arg_equals_literal(i64 value, i64 length, string expected) -> bool {
    i64 expected_length = compiler_literal_length(expected);
    if (value == 0 || length != expected_length) { return false; }
    i64 i = 0;
    while (i < expected_length) {
        if (raz_compiler_rt_arena_get(value, i) != compiler_literal_byte(expected, i)) { return false; }
        i += 1;
    }
    return true;
}

fn cli_load_arg(i64 index, i64 buffer, i64 capacity) -> i64 {
    if (buffer == 0 || capacity <= 0) {
        return -1;
    }
    return raz_compiler_rt_process_arg(index, buffer, capacity);
}

