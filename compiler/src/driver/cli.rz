    cli_write_stream(2, &message, 38);
    cli_write_stream(2, &help, 45);
}

fn cli_print_missing_input() {
    i64 message[55] = [101, 114, 114, 111, 114, 58, 32, 110, 111, 32, 105, 110, 112, 117, 116, 32, 119, 97, 115, 32, 112, 114, 111, 118, 105, 100, 101, 100, 32, 97, 110, 100, 32, 110, 111, 32, 114, 97, 122, 46, 116, 111, 109, 108, 32, 119, 97, 115, 32, 102, 111, 117, 110, 100, 10];
    i64 help[60] = [32, 32, 104, 101, 108, 112, 58, 32, 112, 97, 115, 115, 32, 97, 32, 46, 114, 122, 32, 102, 105, 108, 101, 32, 111, 114, 32, 114, 117, 110, 32, 116, 104, 101, 32, 99, 111, 109, 109, 97, 110, 100, 32, 105, 110, 32, 97, 32, 82, 97, 122, 32, 112, 114, 111, 106, 101, 99, 116, 10];

    cli_write_stream(2, &message, 55);
    cli_write_stream(2, &help, 60);
}

fn cli_print_missing_path(i64 path, i64 length) {
    i64 prefix[35] = [101, 114, 114, 111, 114, 58, 32, 105, 110, 112, 117, 116, 32, 112, 97, 116, 104, 32, 100, 111, 101, 115, 32, 110, 111, 116, 32, 101, 120, 105, 115, 116, 58, 32, 39];
    i64 suffix[2] = [39, 10];

    cli_write_stream(2, &prefix, 35);
    cli_write_arena_stream(2, path, length);
    cli_write_stream(2, &suffix, 2);
}

fn cli_arg_starts_with_dash(i64 value, i64 length) -> bool {
    return value != 0 && length > 0 && raz_compiler_rt_arena_get(value, 0) == 45;
}

fn cli_argument_starts_with_dash_at(i64 argc, i64 index) -> bool {
    if (index >= argc) {
        return false;
    }

    i64 arg = raz_compiler_rt_arena_create(64);

    if (arg == 0) {
        return false;
    }

    i64 length = cli_load_arg(index, arg, 64);
    bool result = cli_arg_starts_with_dash(arg, length);

    raz_compiler_rt_arena_destroy(arg);
    return result;
}

fn cli_argument_looks_like_path(i64 argc, i64 index) -> bool {
    if (index >= argc) {
        return false;
    }

    i64 arg = raz_compiler_rt_arena_create(4096);

    if (arg == 0) {
        return false;
    }

    i64 length = cli_load_arg(index, arg, 4096);

    if (length <= 0) {
        raz_compiler_rt_arena_destroy(arg);
        return false;
    }
    if (raz_compiler_rt_path_exists_ascii(arg, length) != 0) {
        raz_compiler_rt_arena_destroy(arg);
        return true;
    }

    i64 i = 0;

    while (i < length) {
        i64 ch = raz_compiler_rt_arena_get(arg, i);

        if (ch == 46 || ch == 47 || ch == 92) {
            raz_compiler_rt_arena_destroy(arg);
            return true;
        }
        i += 1;
    }
    raz_compiler_rt_arena_destroy(arg);
    return false;
}

fn cli_write_packed(i64[]words, i64 word_count, i64 length) {
    if (length <= 0 || word_count <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        i64 word_index = i / 7;
        i64 byte_index = i % 7;
        i64 value = (words[word_index] >> (byte_index * 8)) & 255;

        raz_compiler_rt_arena_set(buffer, i, value);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn cli_error_color_enabled() -> bool {
    if (raz_rt_stdio_is_terminal(2) <= 0) {
        return false;
    }

    i64 name = raz_compiler_rt_arena_create(8);
    i64 value = raz_compiler_rt_arena_create(8);

    if (name == 0 || value == 0) {
        return true;
    }

    i64 chars[8] = [78, 79, 95, 67, 79, 76, 79, 82];
    i64 i = 0;

    while (i < 8) {
        raz_compiler_rt_arena_set(name, i, chars[i]);
        i += 1;
    }

    i64 found = raz_compiler_rt_env_get_ascii(name, 8, value, 8);

    raz_compiler_rt_arena_destroy(name);
    raz_compiler_rt_arena_destroy(value);
    return found < 0;
}

fn cli_write_number(i64 stream, i64 value) {
    i64 digits[24];
    i64 count = 0;

    if (value < 0) {
        i64 minus[1] = [45];

        cli_write_stream(stream, &minus, 1);
        value = -value;
    }
    if (value == 0) {
        i64 zero[1] = [48];

        cli_write_stream(stream, &zero, 1);
        return;
    }
    while (value > 0 && count < 24) {
        digits[count] = 48 + (value % 10);
        value /= 10;
        count += 1;
    }

    i64 output[24];
    i64 i = 0;

    while (i < count) {
        output[i] = digits[count - 1 - i];
        i += 1;
    }
    cli_write_stream(stream, &output, count);
}

fn cli_frontend_diagnostic_message(DiagnosticCode code) -> i64 {
    if (code == DiagnosticCode::InvalidByte) {
        return 1;
    }
    if (code == DiagnosticCode::ExpectedToken) {
        return 2;
    }
    if (code == DiagnosticCode::ExpectedIdentifier) {
        return 3;
    }
    if (code == DiagnosticCode::TooManyItems) {
        return 4;
    }
    if (code == DiagnosticCode::UnknownName) {
        return 5;
    }
    if (code == DiagnosticCode::DuplicateName) {
        return 6;
    }
    if (code == DiagnosticCode::UnknownType) {
        return 7;
    }
    if (code == DiagnosticCode::WrongArgumentCount) {
        return 8;
    }
    if (code == DiagnosticCode::MissingReturn) {
        return 9;
    }
    if (code == DiagnosticCode::InvalidMove) {
        return 10;
    }
    if (code == DiagnosticCode::UseAfterMove) {
        return 11;
    }
    if (code == DiagnosticCode::BorrowConflict) {
        return 12;
    }
    if (code == DiagnosticCode::AmbiguousName) {
        return 13;
    }
    return 0;
}

fn cli_render_frontend_diagnostic(Source& input, DiagnosticCode code, i64 offset) {
    i64 message_kind = cli_frontend_diagnostic_message(code);
    bool color = cli_error_color_enabled();

    if (color) {
        i64 red[7] = [27, 91, 49, 59, 51, 49, 109];

        cli_write_stream(2, &red, 7);
    }

    i64 error_word[5] = [101, 114, 114, 111, 114];

    cli_write_stream(2, &error_word, 5);

    i64 open_code[2] = [91, 69];

    cli_write_stream(2, &open_code, 2);

    i64 numeric = diagnostic_code_value(code);
    i64 zeros = 4;

    if (numeric >= 10) {
        zeros = 3;
    }

    i64 zi = 0;

    while (zi < zeros) {
        i64 zero[1] = [48];

        cli_write_stream(2, &zero, 1);
        zi += 1;
    }
    cli_write_number(2, numeric);

    i64 close_code[3] = [93, 58, 32];

    cli_write_stream(2, &close_code, 3);
    if (color) {
        i64 reset[4] = [27, 91, 48, 109];

        cli_write_stream(2, &reset, 4);
    }
    if (message_kind == 1) {
        i64 m[19] = [105, 110, 118, 97, 108, 105, 100, 32, 115, 111, 117, 114, 99, 101, 32, 98, 121, 116, 101];

        cli_write_stream(2, &m, 19);
    } else if (message_kind == 2) {
        i64 m[26] = [101, 120, 112, 101, 99, 116, 101, 100, 32, 97, 32, 100, 105, 102, 102, 101, 114, 101, 110, 116, 32, 116, 111, 107, 101, 110];

        cli_write_stream(2, &m, 26);
    } else if (message_kind == 3) {
        i64 m[22] = [101, 120, 112, 101, 99, 116, 101, 100, 32, 97, 110, 32, 105, 100, 101, 110, 116, 105, 102, 105, 101, 114];

        cli_write_stream(2, &m, 22);
    } else if (message_kind == 4) {
        i64 m[28] = [116, 111, 111, 32, 109, 97, 110, 121, 32, 105, 116, 101, 109, 115, 32, 105, 110, 32, 116, 104, 105, 115, 32, 115, 99, 111, 112, 101];

        cli_write_stream(2, &m, 28);
    } else if (message_kind == 5) {
        i64 m[12] = [117, 110, 107, 110, 111, 119, 110, 32, 110, 97, 109, 101];

        cli_write_stream(2, &m, 12);
    } else if (message_kind == 6) {
        i64 m[14] = [100, 117, 112, 108, 105, 99, 97, 116, 101, 32, 110, 97, 109, 101];

        cli_write_stream(2, &m, 14);
    } else if (message_kind == 7) {
        i64 m[12] = [117, 110, 107, 110, 111, 119, 110, 32, 116, 121, 112, 101];

        cli_write_stream(2, &m, 12);
    } else if (message_kind == 8) {
        i64 m[20] = [119, 114, 111, 110, 103, 32, 97, 114, 103, 117, 109, 101, 110, 116, 32, 99, 111, 117, 110, 116];

        cli_write_stream(2, &m, 20);
    } else if (message_kind == 9) {
        i64 m[20] = [109, 105, 115, 115, 105, 110, 103, 32, 114, 101, 116, 117, 114, 110, 32, 118, 97, 108, 117, 101];

        cli_write_stream(2, &m, 20);
    } else if (message_kind == 10) {
        i64 m[22] = [105, 110, 118, 97, 108, 105, 100, 32, 111, 119, 110, 101, 114, 115, 104, 105, 112, 32, 109, 111, 118, 101];

        cli_write_stream(2, &m, 22);
    } else if (message_kind == 11) {
        i64 m[20] = [117, 115, 101, 32, 111, 102, 32, 97, 32, 109, 111, 118, 101, 100, 32, 118, 97, 108, 117, 101];

        cli_write_stream(2, &m, 20);
    } else if (message_kind == 12) {
        i64 m[15] = [98, 111, 114, 114, 111, 119, 32, 99, 111, 110, 102, 108, 105, 99, 116];

        cli_write_stream(2, &m, 15);
    } else if (message_kind == 13) {
        i64 m[14] = [97, 109, 98, 105, 103, 117, 111, 117, 115, 32, 110, 97, 109, 101];

        cli_write_stream(2, &m, 14);
    } else {
        i64 m[18] = [99, 111, 109, 112, 105, 108, 97, 116, 105, 111, 110, 32, 102, 97, 105, 108, 101, 100];

        cli_write_stream(2, &m, 18);
    }

    i64 newline[1] = [10];

    cli_write_stream(2, &newline, 1);
    if (offset < 0) {
        offset = 0;
    }
    if (offset > input.length) {
        offset = input.length;
    }

    i64 line = 1;
    i64 column = 1;
    i64 line_start = 0;
    i64 i = 0;

    while (i < offset) {
        if (source_byte(input, i) == 10) {
            line += 1;
            column = 1;
            line_start = i + 1;
        } else {
            column += 1;
        }
        i += 1;
    }

    i64 line_end = line_start;

    while (
        line_end < input.length &&
        source_byte(input, line_end) != 10 &&
        source_byte(input, line_end) != 13
    ) {
        line_end += 1;
    }

    i64 arrow[6] = [32, 32, 45, 45, 62, 32];

    cli_write_stream(2, &arrow, 6);

    i64 input_name[7] = [60, 105, 110, 112, 117, 116, 62];

    cli_write_stream(2, &input_name, 7);

    i64 colon[1] = [58];

    cli_write_stream(2, &colon, 1);
    cli_write_number(2, line);
    cli_write_stream(2, &colon, 1);
    cli_write_number(2, column);
    cli_write_stream(2, &newline, 1);

    i64 gutter[4] = [32, 32, 32, 124];

    cli_write_stream(2, &gutter, 4);
    cli_write_stream(2, &newline, 1);
    cli_write_number(2, line);

    i64 bar[3] = [32, 124, 32];

    cli_write_stream(2, &bar, 3);

    i64 cursor = line_start;

    while (cursor < line_end) {
        i64 ch[1] = [source_byte(input, cursor)];

        cli_write_stream(2, &ch, 1);
        cursor += 1;
    }
    cli_write_stream(2, &newline, 1);
    cli_write_stream(2, &gutter, 4);

    i64 space[1] = [32];

    cli_write_stream(2, &space, 1);

    i64 c = 1;

    while (c < column) {
        cli_write_stream(2, &space, 1);
        c += 1;
    }
    if (color) {
        i64 red2[7] = [27, 91, 49, 59, 51, 49, 109];

        cli_write_stream(2, &red2, 7);
    }

    i64 caret[1] = [94];

    cli_write_stream(2, &caret, 1);
    if (color) {
        i64 reset2[4] = [27, 91, 48, 109];

        cli_write_stream(2, &reset2, 4);
    }
    cli_write_stream(2, &newline, 1);
    if (message_kind == 5 || message_kind == 7 || message_kind == 13) {
        i64 help[10] = [32, 32, 61, 32, 104, 101, 108, 112, 58, 32];

        cli_write_stream(2, &help, 10);

        i64 hm[52] = [99, 104, 101, 99, 107, 32, 115, 112, 101, 108, 108, 105, 110, 103, 44, 32, 105, 109, 112, 111, 114, 116, 115, 44, 32, 97, 110, 100, 32, 110, 97, 109, 101, 115, 112, 97, 99, 101, 32, 113, 117, 97, 108, 105, 102, 105, 99, 97, 116, 105, 111, 110];

        cli_write_stream(2, &hm, 52);
        cli_write_stream(2, &newline, 1);
    }
}

fn cli_arg_equals(i64 value, i64 length, i64[]expected, i64 expected_length) -> bool {
    if (value == 0 || length != expected_length) {
        return false;
    }

    i64 i = 0;

    while (i < expected_length) {
        if (raz_compiler_rt_arena_get(value, i) != expected[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn cli_load_arg(i64 index, i64 buffer, i64 capacity) -> i64 {
    if (buffer == 0 || capacity <= 0) {
        return -1;
    }
    return raz_compiler_rt_process_arg(index, buffer, capacity);
}

