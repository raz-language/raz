namespace raz_compiler_driver_project;

public import raz_compiler_driver_incremental;

// Project loading for raz.toml packages, deterministic source ordering, and
// compiler diagnostics used before the frontend begins parsing source text.
fn project_registry_bare_constraint(i64 spec, i64 length) -> bool {
    if (spec == 0 || length <= 0) {
        return false;
    }

    i64 ch = raz_compiler_rt_arena_get(spec, 0);

    return (
        (ch >= 48 && ch <= 57) ||
        ch == 94 ||
        ch == 126 ||
        ch == 62 ||
        ch == 60 ||
        ch == 61 ||
        ch == 42 ||
        ch == 120 ||
        ch == 88
    );
}

fn project_registry_manifest_spec(
    i64 name,
    i64 name_length,
    i64 constraint,
    i64 constraint_length,
    i64 output,
    i64 capacity,
) -> i64 {
    if (name == 0 || constraint == 0 || output == 0 || name_length <= 0 || constraint_length <= 0) {
        return -1;
    }
    if (10 + name_length + constraint_length > capacity) {
        return -1;
    }

    i64 prefix[9] = [114, 101, 103, 105, 115, 116, 114, 121, 58];
    i64 i = 0;

    while (i < 9) {
        raz_compiler_rt_arena_set(output, i, prefix[i]);
        i += 1;
    }
    i = 0;
    while (i < name_length) {
        raz_compiler_rt_arena_set(output, 9 + i, raz_compiler_rt_arena_get(name, i));
        i += 1;
    }
    raz_compiler_rt_arena_set(output, 9 + name_length, 64);
    i = 0;
    while (i < constraint_length) {
        raz_compiler_rt_arena_set(output, 10 + name_length + i, raz_compiler_rt_arena_get(constraint, i));
        i += 1;
    }
    return 10 + name_length + constraint_length;
}

fn write_compiler_diagnostic(i64 phase, i64 code, i64 offset) {
    // Diagnostics are tiny. Do not allocate the normal 8 Mi-entry Forge writer
    // merely to write a three-integer progress record during recursive bootstrap.
    // Keeping this path small also makes the very first production compiler diagnostic useful
    // when debugging generated-code startup.

    ForgeWriter out;

    out.capacity = 128;
    out.data = raz_compiler_rt_arena_create(out.capacity);
    out.length = 0;
    out.failed = out.data == 0;
    if (out.failed) {
        writer_destroy(&mut out);
        return;
    }
    writer_decimal(&mut out, phase);
    writer_space(&mut out);
    writer_decimal(&mut out, code);
    writer_space(&mut out);
    writer_decimal(&mut out, offset);
    writer_newline(&mut out);

    i64 path[21] = [115, 116, 97, 103, 101, 49, 45, 100, 105, 97, 103, 110, 111, 115, 116, 105, 99, 46, 116, 120, 116];

    raz_rt_write_ascii_i64(&mut path[0], 21, out.data, out.length);
    writer_destroy(&mut out);
}

fn path_is_check_option(i64 path, i64 length) -> bool {
    if (path == 0 || length != 7) {
        return false;
    }

    i64 expected[7] = [45, 45, 99, 104, 101, 99, 107];
    i64 index = 0;

    while (index < 7) {
        if (raz_compiler_rt_arena_get(path, index) != expected[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn path_has_rz_extension(i64 path, i64 length) -> bool {
    if (path == 0 || length < 3) {
        return false;
    }
    return (
        raz_compiler_rt_arena_get(path, length - 3) == 46 &&
        raz_compiler_rt_arena_get(path, length - 2) == 114 &&
        raz_compiler_rt_arena_get(path, length - 1) == 122
    );
}

fn path_range_has_rz_extension(i64 path, i64 start, i64 length) -> bool {
    if (path == 0 || length < 3) {
        return false;
    }
    return (
        raz_compiler_rt_arena_get(path, start + length - 3) == 46 &&
        raz_compiler_rt_arena_get(path, start + length - 2) == 114 &&
        raz_compiler_rt_arena_get(path, start + length - 1) == 122
    );
}

fn path_has_toml_extension(i64 path, i64 length) -> bool {
    if (path == 0 || length < 5) {
        return false;
    }
    return (
        raz_compiler_rt_arena_get(path, length - 5) == 46 &&
        raz_compiler_rt_arena_get(path, length - 4) == 116 &&
        raz_compiler_rt_arena_get(path, length - 3) == 111 &&
        raz_compiler_rt_arena_get(path, length - 2) == 109 &&
        raz_compiler_rt_arena_get(path, length - 1) == 108
    );
}

fn ascii_is_space(i64 value) -> bool {
    return value == 32 || value == 9 || value == 13;
}

fn path_dirname(i64 path, i64 length, i64 output, i64 capacity) -> i64 {
    if (path == 0 || output == 0 || length <= 0 || capacity <= 0) {
        return -1;
    }

    i64 end = length;

    while (
        end > 0 &&
        raz_compiler_rt_arena_get(path, end - 1) != 47 &&
        raz_compiler_rt_arena_get(path, end - 1) != 92
    ) {
        end -= 1;
    }
    if (end == 0) {
        if (capacity < 1) {
            return -1;
        }
        raz_compiler_rt_arena_set(output, 0, 46);
        return 1;
    }

    i64 count = end - 1;

    if (count <= 0) {
        count = 1;
    }
    if (count > capacity) {
        return -1;
    }

    i64 index = 0;

    while (index < count) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(path, index));
        index += 1;
    }
    return count;
}

fn path_vendor_active() -> bool {
    i64 marker = raz_compiler_rt_arena_create(13);

    if (marker == 0) {
        return false;
    }

    i64 bytes[13] = [46, 47, 46, 114, 97, 122, 45, 118, 101, 110, 100, 111, 114];
    i64 i = 0;

    while (i < 13) {
        raz_compiler_rt_arena_set(marker, i, bytes[i]);
        i += 1;
    }

    bool active = raz_compiler_rt_path_exists_ascii(marker, 13) != 0;

    raz_compiler_rt_arena_destroy(marker);
    return active;
}

fn path_vendor_git(i64 right, i64 start, i64 count, i64 output, i64 capacity) -> i64 {
    if (!path_vendor_active() || output == 0 || right == 0) {
        return 0;
    }

    i64 prefix_a[11] = [46, 47, 46, 114, 97, 122, 47, 103, 105, 116, 47];
    i64 prefix_b[9] = [46, 114, 97, 122, 47, 103, 105, 116, 47];
    i64 prefix_length = 0;
    bool matched = count > 11;
    i64 i = 0;

    while (matched && i < 11) {
        if (raz_compiler_rt_arena_get(right, start + i) != prefix_a[i]) {
            matched = false;
        }
        i += 1;
    }
    if (matched) {
        prefix_length = 11;
    } else {
        matched = count > 9;
        i = 0;
        while (matched && i < 9) {
            if (raz_compiler_rt_arena_get(right, start + i) != prefix_b[i]) {
                matched = false;
            }
            i += 1;
        }
        if (matched) {
            prefix_length = 9;
        }
    }
    if (prefix_length == 0) {
        return 0;
    }

    i64 base[13] = [46, 47, 118, 101, 110, 100, 111, 114, 47, 103, 105, 116, 47];
    i64 tail = count - prefix_length;

    if (13 + tail > capacity) {
        return -1;
    }
    i = 0;
    while (i < 13) {
        raz_compiler_rt_arena_set(output, i, base[i]);
        i += 1;
    }
    i = 0;
    while (i < tail) {
        raz_compiler_rt_arena_set(
            output,
            13 + i,
            raz_compiler_rt_arena_get(right, start + prefix_length + i),
        );
        i += 1;
    }
    return 13 + tail;
}

fn path_registry_store_root(i64 output, i64 capacity) -> i64 {
    if (output == 0 || capacity <= 0) {
        return -1;
    }
    if (path_vendor_active()) {
        i64 vendor[17] = [46, 47, 118, 101, 110, 100, 111, 114, 47, 114, 101, 103, 105, 115, 116, 114, 121];

        if (capacity < 17) {
            return -1;
        }

        i64 vi = 0;

        while (vi < 17) {
            raz_compiler_rt_arena_set(output, vi, vendor[vi]);
            vi += 1;
        }
        return 17;
    }

    i64 key = raz_compiler_rt_arena_create(32);
    i64 home = raz_compiler_rt_arena_create(8192);

    if (key == 0 || home == 0) {
        return -1;
    }

    i64 store_key[17] = [82, 65, 90, 95, 80, 65, 67, 75, 65, 71, 69, 95, 83, 84, 79, 82, 69];
    i64 i = 0;

    while (i < 17) {
        raz_compiler_rt_arena_set(key, i, store_key[i]);
        i += 1;
    }

    i64 length = raz_compiler_rt_env_get_ascii(key, 17, output, capacity);

    if (length > 0) {
        raz_compiler_rt_arena_destroy(key);
        raz_compiler_rt_arena_destroy(home);
        return length;
    }

    i64 raz_home[8] = [82, 65, 90, 95, 72, 79, 77, 69];

    i = 0;
    while (i < 8) {
        raz_compiler_rt_arena_set(key, i, raz_home[i]);
        i += 1;
    }

    i64 home_length = raz_compiler_rt_env_get_ascii(key, 8, home, 8192);
    i64 suffix_length = 6;
    i64 suffix[6] = [47, 115, 116, 111, 114, 101];

    if (home_length <= 0) {
        i64 home_key[4] = [72, 79, 77, 69];

        i = 0;
        while (i < 4) {
            raz_compiler_rt_arena_set(key, i, home_key[i]);
            i += 1;
        }
        home_length = raz_compiler_rt_env_get_ascii(key, 4, home, 8192);
        suffix_length = 11;
    }
    if (home_length <= 0) {
        i64 profile_key[11] = [85, 83, 69, 82, 80, 82, 79, 70, 73, 76, 69];

        i = 0;
        while (i < 11) {
            raz_compiler_rt_arena_set(key, i, profile_key[i]);
            i += 1;
        }
        home_length = raz_compiler_rt_env_get_ascii(key, 11, home, 8192);
        suffix_length = 11;
    }
    if (home_length > 0) {
        if (home_length + suffix_length > capacity) {
            raz_compiler_rt_arena_destroy(key);
            raz_compiler_rt_arena_destroy(home);
            return -1;
        }
        i = 0;
        while (i < home_length) {
            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(home, i));
            i += 1;
        }
        if (suffix_length == 6) {
            i = 0;
            while (i < 6) {
                raz_compiler_rt_arena_set(output, home_length + i, suffix[i]);
                i += 1;
            }
        } else {
            i64 user_suffix[12] = [47, 46, 114, 97, 122, 47, 115, 116, 111, 114, 101, 0];

            i = 0;
            while (i < 11) {
                raz_compiler_rt_arena_set(output, home_length + i, user_suffix[i]);
                i += 1;
            }
            suffix_length = 11;
        }
        raz_compiler_rt_arena_destroy(key);
        raz_compiler_rt_arena_destroy(home);
        return home_length + suffix_length;
    }

    i64 fallback[12] = [46, 47, 46, 114, 97, 122, 47, 115, 116, 111, 114, 101];

    if (capacity < 12) {
        raz_compiler_rt_arena_destroy(key);
        raz_compiler_rt_arena_destroy(home);
        return -1;
    }
    i = 0;
    while (i < 12) {
        raz_compiler_rt_arena_set(output, i, fallback[i]);
        i += 1;
    }
    raz_compiler_rt_arena_destroy(key);
    raz_compiler_rt_arena_destroy(home);
    return 12;
}

fn path_registry_decl(i64 right, i64 start, i64 count) -> bool {
    if (count <= 10) {
        return false;
    }

    i64 prefix[9] = [114, 101, 103, 105, 115, 116, 114, 121, 58];
    i64 i = 0;

    while (i < 9) {
        if (raz_compiler_rt_arena_get(right, start + i) != prefix[i]) {
            return false;
        }
        i += 1;
    }
    // Content hashes contain no '@'. Human registry declarations do.
    while (i < count) {
        if (raz_compiler_rt_arena_get(right, start + i) == 64) {
            return i > 9 && i + 1 < count;
        }
        i += 1;
    }
    return false;
}

fn path_registry_locked_checksum(i64 right, i64 start, i64 count, i64 output, i64 capacity) -> i64 {
    i64 at = 9;

    while (at < count && raz_compiler_rt_arena_get(right, start + at) != 64) {
        at += 1;
    }
    if (at <= 9 || at >= count || at - 9 > 4096) {
        return -1;
    }

    i64 name_length = at - 9;
    i64 lock_path = raz_compiler_rt_arena_create(16);
    i64 data = raz_compiler_rt_arena_create(2097152);

    if (lock_path == 0 || data == 0) {
        return -1;
    }

    i64 lp[10] = [46, 47, 114, 97, 122, 46, 108, 111, 99, 107];
    i64 i = 0;

    while (i < 10) {
        raz_compiler_rt_arena_set(lock_path, i, lp[i]);
        i += 1;
    }

    i64 length = raz_compiler_rt_read_ascii(lock_path, 10, data, 2097152);

    raz_compiler_rt_arena_destroy(lock_path);
    if (length > 0) {
        i64 cursor = 0;
        bool in_package = false;
        bool name_match = false;

        while (cursor < length) {
            i64 line_start = cursor;

            while (
                cursor < length &&
                raz_compiler_rt_arena_get(data, cursor) != 10 &&
                raz_compiler_rt_arena_get(data, cursor) != 13
            ) {
                cursor += 1;
            }

            i64 line_end = cursor;

            while (
                cursor < length &&
                (
                    raz_compiler_rt_arena_get(data, cursor) == 10 ||
                    raz_compiler_rt_arena_get(data, cursor) == 13
                )
            ) {
                cursor += 1;
            }
            if (line_end - line_start == 11) {
                i64 hdr[11] = [91, 91, 112, 97, 99, 107, 97, 103, 101, 93, 93];
                bool same = true;

                i = 0;
                while (i < 11) {
                    if (raz_compiler_rt_arena_get(data, line_start + i) != hdr[i]) {
                        same = false;
                    }
                    i += 1;
                }
                if (same) {
                    in_package = true;
                    name_match = false;
                    continue;
                }
            }
            if (!in_package) {
                continue;
            }
            // name = "..."
            if (
                line_end - line_start >= 9 &&
                raz_compiler_rt_arena_get(data, line_start) == 110 &&
                raz_compiler_rt_arena_get(data, line_start + 1) == 97 &&
                raz_compiler_rt_arena_get(data, line_start + 2) == 109 &&
                raz_compiler_rt_arena_get(data, line_start + 3) == 101
            ) {
                i64 q = line_start;

                while (q < line_end && raz_compiler_rt_arena_get(data, q) != 34) {
                    q += 1;
                }
                if (q < line_end) {
                    i64 e = q + 1;

                    while (e < line_end && raz_compiler_rt_arena_get(data, e) != 34) {
                        e += 1;
                    }
                    name_match = e - q - 1 == name_length;
                    i = 0;
                    while (name_match && i < name_length) {
                        if (
                            raz_compiler_rt_arena_get(
                                data,
                                q + 1 + i,
                            ) != raz_compiler_rt_arena_get(right, start + 9 + i)
                        ) {
                            name_match = false;
                        }
                        i += 1;
                    }
                }
                continue;
            }
            // checksum = "..." on the matching registry package entry.
            if (
                name_match &&
                line_end - line_start >= 13 &&
                raz_compiler_rt_arena_get(data, line_start) == 99 &&
                raz_compiler_rt_arena_get(data, line_start + 1) == 104 &&
                raz_compiler_rt_arena_get(data, line_start + 2) == 101 &&
                raz_compiler_rt_arena_get(data, line_start + 3) == 99 &&
                raz_compiler_rt_arena_get(data, line_start + 4) == 107
            ) {
                i64 q = line_start;

                while (q < line_end && raz_compiler_rt_arena_get(data, q) != 34) {
                    q += 1;
                }
                if (q < line_end) {
                    i64 e = q + 1;

                    while (e < line_end && raz_compiler_rt_arena_get(data, e) != 34) {
                        e += 1;
                    }

                    i64 n = e - q - 1;

                    if (n > 0 && n <= capacity) {
                        i = 0;
                        while (i < n) {
                            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(data, q + 1 + i));
                            i += 1;
                        }
                        raz_compiler_rt_arena_destroy(data);
                        return n;
                    }
                }
            }
        }
    }
    raz_compiler_rt_arena_destroy(data);
    // During `raz add`, the new exact resolution exists in the transient cache
    // before raz.lock is regenerated. Use it only as a bootstrap fallback.

    i64 cache_path = raz_compiler_rt_arena_create(16);
    i64 cache = raz_compiler_rt_arena_create(1048576);

    if (cache_path == 0 || cache == 0) {
        return -1;
    }

    i64 cp[12] = [46, 47, 46, 114, 97, 122, 46, 99, 97, 99, 104, 101];

    i = 0;
    while (i < 12) {
        raz_compiler_rt_arena_set(cache_path, i, cp[i]);
        i += 1;
    }

    i64 cache_length = raz_compiler_rt_read_ascii(cache_path, 12, cache, 1048576);

    raz_compiler_rt_arena_destroy(cache_path);
    if (cache_length > 0) {
        i64 pos = 0;

        while (pos < cache_length) {
            i64 ls = pos;

            while (pos < cache_length && raz_compiler_rt_arena_get(cache, pos) != 10) {
                pos += 1;
            }

            i64 le = pos;

            if (pos < cache_length) {
                pos += 1;
            }

            i64 token = 0;
            i64 ts = ls;
            i64 tl = 0;

            while (token <= 4) {
                while (ts < le && raz_compiler_rt_arena_get(cache, ts) == 32) {
                    ts += 1;
                }

                i64 te = ts;

                while (te < le && raz_compiler_rt_arena_get(cache, te) != 32) {
                    te += 1;
                }
                if (token == 1) {
                    tl = te - ts;

                    bool same = tl == name_length;

                    i = 0;
                    while (same && i < name_length) {
                        if (
                            raz_compiler_rt_arena_get(
                                cache,
                                ts + i,
                            ) != raz_compiler_rt_arena_get(right, start + 9 + i)
                        ) {
                            same = false;
                        }
                        i += 1;
                    }
                    if (!same) {
                        break;
                    }
                }
                if (token == 4) {
                    i64 n = te - ts;

                    if (n > 0 && n <= capacity) {
                        i = 0;
                        while (i < n) {
                            raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(cache, ts + i));
                            i += 1;
                        }
                        raz_compiler_rt_arena_destroy(cache);
                        return n;
                    }
                }
                ts = te + 1;
                token += 1;
            }
        }
    }
    raz_compiler_rt_arena_destroy(cache);
    return -1;
}

fn path_registry_virtual(i64 right, i64 start, i64 count) -> bool {
    if (count <= 9) {
        return false;
    }

    i64 prefix[9] = [114, 101, 103, 105, 115, 116, 114, 121, 58];
    i64 i = 0;

    while (i < 9) {
        if (raz_compiler_rt_arena_get(right, start + i) != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn path_join(i64 left, i64 left_length, i64 right, i64 right_length, i64 output, i64 capacity) -> i64 {
    if (left == 0 || right == 0 || output == 0 || left_length < 0 || right_length < 0) {
        return -1;
    }

    i64 right_start = 0;
    i64 right_count = right_length;

    if (
        right_length >= 2 &&
        raz_compiler_rt_arena_get(right, 0) == 34 &&
        raz_compiler_rt_arena_get(right, right_length - 1) == 34
    ) {
        right_start = 1;
        right_count = right_length - 2;
    }
    if (path_registry_decl(right, right_start, right_count)) {
        i64 checksum = raz_compiler_rt_arena_create(128);

        if (checksum == 0) {
            return -1;
        }

        i64 checksum_length = path_registry_locked_checksum(right, right_start, right_count, checksum, 128);
        i64 root_length = path_registry_store_root(output, capacity);

        if (checksum_length <= 0 || root_length <= 0 || root_length + 1 + checksum_length > capacity) {
            raz_compiler_rt_arena_destroy(checksum);
            return -1;
        }
        raz_compiler_rt_arena_set(output, root_length, 47);

        i64 ri = 0;

        while (ri < checksum_length) {
            raz_compiler_rt_arena_set(output, root_length + 1 + ri, raz_compiler_rt_arena_get(checksum, ri));
            ri += 1;
        }
        raz_compiler_rt_arena_destroy(checksum);
        return root_length + 1 + checksum_length;
    }
    if (path_registry_virtual(right, right_start, right_count)) {
        i64 root_length = path_registry_store_root(output, capacity);
        i64 checksum_length = right_count - 9;

        if (root_length <= 0 || checksum_length <= 0 || root_length + 1 + checksum_length > capacity) {
            return -1;
        }
        raz_compiler_rt_arena_set(output, root_length, 47);

        i64 virtual_index = 0;

        while (virtual_index < checksum_length) {
            raz_compiler_rt_arena_set(
                output,
                root_length + 1 + virtual_index,
                raz_compiler_rt_arena_get(right, right_start + 9 + virtual_index),
            );
            virtual_index += 1;
        }
        return root_length + 1 + checksum_length;
    }

    i64 vendored_git_length = path_vendor_git(right, right_start, right_count, output, capacity);

    if (vendored_git_length != 0) {
        return vendored_git_length;
    }
    bool right_absolute =
        right_count > 0 &&
        (
            raz_compiler_rt_arena_get(right, right_start) == 47 ||
            raz_compiler_rt_arena_get(right, right_start) == 92
        );
    if (!right_absolute && right_count >= 2) {
        i64 drive = raz_compiler_rt_arena_get(right, right_start);
        i64 colon = raz_compiler_rt_arena_get(right, right_start + 1);

        right_absolute = ((drive >= 65 && drive <= 90) || (drive >= 97 && drive <= 122)) && colon == 58;
    }
    if (right_absolute) {
        if (right_count > capacity) {
            return -1;
        }

        i64 absolute_index = 0;

        while (absolute_index < right_count) {
            raz_compiler_rt_arena_set(
                output,
                absolute_index,
                raz_compiler_rt_arena_get(right, right_start + absolute_index),
            );
            absolute_index += 1;
        }
        return right_count;
    }
    bool separator =
        left_length > 0 &&
        raz_compiler_rt_arena_get(left, left_length - 1) != 47 &&
        raz_compiler_rt_arena_get(left, left_length - 1) != 92;
    i64 total = left_length + right_count;

    if (separator) {
        total += 1;
    }
    if (total > capacity) {
        return -1;
    }

    i64 index = 0;

    while (index < left_length) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(left, index));
        index += 1;
    }
    if (separator) {
        raz_compiler_rt_arena_set(output, index, 47);
        index += 1;
    }

    i64 right_index = 0;

    while (right_index < right_count) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(right, right_start + right_index));
        index += 1;
        right_index += 1;
    }
    return index;
}

fn line_section_equals(i64 data, i64 start, i64 end, i64[]expected, i64 expected_length) -> bool {
    while (start < end && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
        start += 1;
    }
    while (end > start && ascii_is_space(raz_compiler_rt_arena_get(data, end - 1))) {
        end -= 1;
    }
    if (end - start != expected_length) {
        return false;
    }

    i64 i = 0;

    while (i < expected_length) {
        if (raz_compiler_rt_arena_get(data, start + i) != expected[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn line_is_section(i64 data, i64 start, i64 end, i64 kind) -> bool {
    if (kind == 1) {
        i64 expected[9] = [91, 112, 97, 99, 107, 97, 103, 101, 93];

        return line_section_equals(data, start, end, &expected, 9);
    }
    if (kind == 2) {
        i64 expected[14] = [91, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 14);
    }
    if (kind == 3) {
        i64 expected[18] = [91, 100, 101, 118, 45, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 18);
    }
    if (kind == 4) {
        i64 expected[20] = [91, 98, 117, 105, 108, 100, 45, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 20);
    }
    if (kind == 5) {
        i64 expected[23] = [91, 111, 112, 116, 105, 111, 110, 97, 108, 45, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 23);
    }
    if (kind == 6) {
        i64 expected[29] = [91, 116, 97, 114, 103, 101, 116, 46, 119, 105, 110, 100, 111, 119, 115, 46, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 29);
    }
    if (kind == 7) {
        i64 expected[27] = [91, 116, 97, 114, 103, 101, 116, 46, 108, 105, 110, 117, 120, 46, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 27);
    }
    if (kind == 8) {
        i64 expected[27] = [91, 116, 97, 114, 103, 101, 116, 46, 109, 97, 99, 111, 115, 46, 100, 101, 112, 101, 110, 100, 101, 110, 99, 105, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 27);
    }
    if (kind == 9) {
        i64 expected[10] = [91, 102, 101, 97, 116, 117, 114, 101, 115, 93];

        return line_section_equals(data, start, end, &expected, 10);
    }
    if (kind == 10) {
        i64 expected[11] = [91, 119, 111, 114, 107, 115, 112, 97, 99, 101, 93];

        return line_section_equals(data, start, end, &expected, 11);
    }
    return false;
}

fn line_key_is_source(i64 data, i64 start, i64 equal) -> bool {
    while (start < equal && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
        start += 1;
    }
    while (equal > start && ascii_is_space(raz_compiler_rt_arena_get(data, equal - 1))) {
        equal -= 1;
    }
    if (equal - start != 6) {
        return false;
    }

    i64 expected[6] = [115, 111, 117, 114, 99, 101];
    i64 i = 0;

    while (i < 6) {
        if (raz_compiler_rt_arena_get(data, start + i) != expected[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn line_key_is_name(i64 data, i64 start, i64 equal) -> bool {
    while (start < equal && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
        start += 1;
    }
    while (equal > start && ascii_is_space(raz_compiler_rt_arena_get(data, equal - 1))) {
