fn copy_quoted_value(i64 data, i64 start, i64 end, i64 output, i64 capacity) -> i64 {
    while (start < end && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
        start += 1;
    }
    while (end > start && ascii_is_space(raz_compiler_rt_arena_get(data, end - 1))) {
        end -= 1;
    }
    if (
        end - start < 2 ||
        raz_compiler_rt_arena_get(data, start) != 34 ||
        raz_compiler_rt_arena_get(data, end - 1) != 34
    ) {
        return -1;
    }
    start += 1;
    end -= 1;

    i64 length = end - start;

    if (length > capacity) {
        return -1;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(data, start + i));
        i += 1;
    }
    return length;
}

fn manifest_package_name(i64 manifest, i64 length, i64 output, i64 capacity) -> i64 {
    i64 section = 0;
    i64 cursor = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }
        if (line_is_section(manifest, start, end, 1)) {
            section = 1;
        } else if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) {
            section = 0;
        } else if (section == 1) {
            i64 equal = start;

            while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) {
                equal += 1;
            }
            if (equal < end && line_key_is_name(manifest, start, equal)) {
                return copy_quoted_value(manifest, equal + 1, end, output, capacity);
            }
        }
    }
    return -1;
}

fn manifest_source_directory(i64 manifest, i64 length, i64 output, i64 capacity) -> i64 {
    if (capacity < 3) {
        return -1;
    }
    raz_compiler_rt_arena_set(output, 0, 115);
    raz_compiler_rt_arena_set(output, 1, 114);
    raz_compiler_rt_arena_set(output, 2, 99);

    i64 result = 3;
    i64 section = 0;
    i64 cursor = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }
        if (line_is_section(manifest, start, end, 1)) {
            section = 1;
        } else if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) {
            section = 0;
        } else if (section == 1) {
            i64 equal = start;

            while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) {
                equal += 1;
            }
            if (equal < end && line_key_is_source(manifest, start, equal)) {
                i64 value_length = copy_quoted_value(manifest, equal + 1, end, output, capacity);

                if (value_length < 0) {
                    return -1;
                }
                result = value_length;
            }
        }
    }
    return result;
}

fn manifest_entry_override(i64 output, i64 capacity) -> i64 {
    i64 argc = raz_compiler_rt_process_argc();
    i64 index = 1;
    i64 argument = raz_compiler_rt_arena_create(4096);

    if (argument == 0) {
        return -1;
    }

    i64 prefix[8] = [45, 45, 101, 110, 116, 114, 121, 61];

    while (index < argc) {
        i64 length = raz_compiler_rt_process_arg(index, argument, 4096);

        if (length > 8) {
            bool matches = true;
            i64 i = 0;

            while (matches && i < 8) {
                if (raz_compiler_rt_arena_get(argument, i) != prefix[i]) {
                    matches = false;
                }
                i += 1;
            }
            if (matches) {
                i64 value_length = length - 8;

                if (value_length <= 0 || value_length > capacity) {
                    raz_compiler_rt_arena_destroy(argument);
                    return -1;
                }
                i = 0;
                while (i < value_length) {
                    raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(argument, 8 + i));
                    i += 1;
                }
                raz_compiler_rt_arena_destroy(argument);
                return value_length;
            }
        }
        index += 1;
    }
    raz_compiler_rt_arena_destroy(argument);
    return 0;
}

fn manifest_entry_path(i64 manifest, i64 length, i64 output, i64 capacity) -> i64 {
    i64 override_length = manifest_entry_override(output, capacity);

    if (override_length < 0) {
        return -1;
    }
    if (override_length > 0) {
        return override_length;
    }
    if (capacity < 13) {
        return -1;
    }
    raz_compiler_rt_arena_set(output, 0, 115);
    raz_compiler_rt_arena_set(output, 1, 114);
    raz_compiler_rt_arena_set(output, 2, 99);
    raz_compiler_rt_arena_set(output, 3, 47);
    raz_compiler_rt_arena_set(output, 4, 109);
    raz_compiler_rt_arena_set(output, 5, 97);
    raz_compiler_rt_arena_set(output, 6, 105);
    raz_compiler_rt_arena_set(output, 7, 110);
    raz_compiler_rt_arena_set(output, 8, 46);
    raz_compiler_rt_arena_set(output, 9, 120);
    raz_compiler_rt_arena_set(output, 10, 121);
    raz_compiler_rt_arena_set(output, 11, 102);
    raz_compiler_rt_arena_set(output, 12, 116);

    i64 result = 13;
    i64 section = 0;
    i64 cursor = 0;

    while (cursor < length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }
        if (line_is_section(manifest, start, end, 1)) {
            section = 1;
        } else if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) {
            section = 0;
        } else if (section == 1) {
            i64 equal = start;

            while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) {
                equal += 1;
            }
            if (equal < end && line_key_is_entry(manifest, start, equal)) {
                i64 value_length = copy_quoted_value(manifest, equal + 1, end, output, capacity);

                if (value_length < 0) {
                    return -1;
                }
                result = value_length;
            }
        }
    }
    return result;
}

fn append_project_namespace(
    i64 bytes,
    i64&mut length,
    i64 source_capacity,
    i64 package_name,
    i64 package_name_length,
) -> bool {
    // Keep package provenance independent from source namespaces. An explicit
    // `namespace` in the module may replace the default namespace, while the
    // internal package marker continues to govern package visibility.
    if (
        package_name == 0 ||
        package_name_length <= 0 ||
        *length + package_name_length * 2 + 48 >= source_capacity
    ) {
        return false;
    }

    i64 package_prefix[14] = [95, 95, 114, 97, 122, 95, 112, 97, 99, 107, 97, 103, 101, 32];
    i64 i = 0;

    while (i < 14) {
        raz_compiler_rt_arena_set(bytes, *length, package_prefix[i]);
        *length += 1;
        i += 1;
    }
    i = 0;
    while (i < package_name_length) {
        i64 value = raz_compiler_rt_arena_get(package_name, i);

        if (value == 45 || value == 46 || value == 47 || value == 92) {
            value = 95;
        }
        raz_compiler_rt_arena_set(bytes, *length, value);
        *length += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(bytes, *length, 59);
    *length += 1;
    raz_compiler_rt_arena_set(bytes, *length, 10);
    *length += 1;

    i64 module_marker[14] = [95, 95, 114, 97, 122, 95, 109, 111, 100, 117, 108, 101, 59, 10];

    i = 0;
    while (i < 14) {
        raz_compiler_rt_arena_set(bytes, *length, module_marker[i]);
        *length += 1;
        i += 1;
    }

    i64 namespace_prefix[10] = [110, 97, 109, 101, 115, 112, 97, 99, 101, 32];

    i = 0;
    while (i < 10) {
        raz_compiler_rt_arena_set(bytes, *length, namespace_prefix[i]);
        *length += 1;
        i += 1;
    }
    i = 0;
    while (i < package_name_length) {
        i64 value = raz_compiler_rt_arena_get(package_name, i);

        if (value == 45 || value == 46 || value == 47 || value == 92) {
            value = 95;
        }
        raz_compiler_rt_arena_set(bytes, *length, value);
        *length += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(bytes, *length, 59);
    *length += 1;
    raz_compiler_rt_arena_set(bytes, *length, 10);
    *length += 1;
    return true;
}

fn copy_manifest_key(i64 data, i64 start, i64 equal, i64 output, i64 capacity) -> i64 {
    while (start < equal && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
        start += 1;
    }
    while (equal > start && ascii_is_space(raz_compiler_rt_arena_get(data, equal - 1))) {
        equal -= 1;
    }

    i64 length = equal - start;

    if (length <= 0 || length > capacity) {
        return -1;
    }

    i64 index = 0;

    while (index < length) {
        raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(data, start + index));
        index += 1;
    }
    return length;
}

fn append_project_dependency_alias(
    i64 bytes,
    i64&mut length,
    i64 source_capacity,
    i64 package_name,
    i64 package_name_length,
    i64 alias,
    i64 alias_length,
    i64 target_package,
    i64 target_package_length,
) -> bool {
    if (
        alias_length <= 0 ||
        target_package_length <= 0 ||
        *length + package_name_length + alias_length + target_package_length + 48 >= source_capacity
    ) {
        return false;
    }

    i64 package_prefix[14] = [95, 95, 114, 97, 122, 95, 112, 97, 99, 107, 97, 103, 101, 32];
    i64 index = 0;

    while (index < 14) {
        raz_compiler_rt_arena_set(bytes, *length, package_prefix[index]);
        *length += 1;
        index += 1;
    }
    index = 0;
    while (index < package_name_length) {
        i64 value = raz_compiler_rt_arena_get(package_name, index);

        if (value == 45 || value == 46 || value == 47 || value == 92) {
            value = 95;
        }
        raz_compiler_rt_arena_set(bytes, *length, value);
        *length += 1;
        index += 1;
    }
    raz_compiler_rt_arena_set(bytes, *length, 59);
    *length += 1;
    raz_compiler_rt_arena_set(bytes, *length, 10);
    *length += 1;

    i64 dependency_prefix[17] = [95, 95, 114, 97, 122, 95, 100, 101, 112, 101, 110, 100, 101, 110, 99, 121, 32];

    index = 0;
    while (index < 17) {
        raz_compiler_rt_arena_set(bytes, *length, dependency_prefix[index]);
        *length += 1;
        index += 1;
    }
    index = 0;
    while (index < alias_length) {
        raz_compiler_rt_arena_set(bytes, *length, raz_compiler_rt_arena_get(alias, index));
        *length += 1;
        index += 1;
    }
    raz_compiler_rt_arena_set(bytes, *length, 32);
    *length += 1;
    index = 0;
    while (index < target_package_length) {
        i64 value = raz_compiler_rt_arena_get(target_package, index);

        if (value == 45 || value == 46 || value == 47 || value == 92) {
            value = 95;
        }
        raz_compiler_rt_arena_set(bytes, *length, value);
        *length += 1;
        index += 1;
    }
    raz_compiler_rt_arena_set(bytes, *length, 59);
    *length += 1;
    raz_compiler_rt_arena_set(bytes, *length, 10);
    *length += 1;
    return true;
}

fn append_source_path(
    i64 path,
    i64 path_length,
    i64 bytes,
    i64&mut length,
    i64 source_capacity,
    i64 module_capacity,
) -> bool {
    i64 module_bytes = raz_compiler_rt_arena_create(module_capacity);

    if (module_bytes == 0) {
        return false;
    }

    i64 module_length = raz_compiler_rt_read_ascii(path, path_length, module_bytes, module_capacity);

    if (
        module_length <= 0 ||
        module_length >= module_capacity ||
        *length + module_length + 1 >= source_capacity
    ) {
        raz_compiler_rt_arena_destroy(module_bytes);
        return false;
    }
    if (raz_compiler_rt_arena_copy(bytes, *length, module_bytes, 0, module_length) != module_length) {
        raz_compiler_rt_arena_destroy(module_bytes);
        return false;
    }
    *length += module_length;

    i64 final_byte = raz_compiler_rt_arena_get(module_bytes, module_length - 1);

    if (final_byte != 10 && final_byte != 13) {
        raz_compiler_rt_arena_set(bytes, *length, 10);
        *length += 1;
    }
    raz_compiler_rt_arena_destroy(module_bytes);
    return true;
}

fn append_source_cached(
    i64 source,
    i64 source_start,
    i64 source_length,
    i64 bytes,
    i64&mut length,
    i64 source_capacity,
) -> bool {
    if (
        source == 0 ||
        bytes == 0 ||
        source_start < 0 ||
        source_length <= 0 ||
        *length + source_length + 1 >= source_capacity
    ) {
        return false;
    }
    if (raz_compiler_rt_arena_copy(bytes, *length, source, source_start, source_length) != source_length) {
        return false;
    }
    *length += source_length;

    i64 final_byte = raz_compiler_rt_arena_get(source, source_start + source_length - 1);

    if (final_byte != 10 && final_byte != 13) {
        raz_compiler_rt_arena_set(bytes, *length, 10);
        *length += 1;
    }
    return true;
}

fn path_bytes_equal(i64 left, i64 left_length, i64 right, i64 right_length) -> bool {
    i64 left_start = 0;
    i64 right_start = 0;

    if (
        left_length >= 2 &&
        raz_compiler_rt_arena_get(left, 0) == 46 &&
        (raz_compiler_rt_arena_get(left, 1) == 47 || raz_compiler_rt_arena_get(left, 1) == 92)
    ) {
        left_start = 2;
    }
    if (
        right_length >= 2 &&
        raz_compiler_rt_arena_get(right, 0) == 46 &&
        (raz_compiler_rt_arena_get(right, 1) == 47 || raz_compiler_rt_arena_get(right, 1) == 92)
    ) {
        right_start = 2;
    }
    if (left_length - left_start != right_length - right_start) {
        return false;
    }

    i64 i = 0;

    while (i < left_length - left_start) {
        i64 a = raz_compiler_rt_arena_get(left, left_start + i);
        i64 b = raz_compiler_rt_arena_get(right, right_start + i);

        if (a == 92) {
            a = 47;
        }
        if (b == 92) {
            b = 47;
        }
        if (a != b) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn path_list_contains(i64 list, i64 list_length, i64 path, i64 path_length) -> bool {
    i64 cursor = 0;

    while (cursor < list_length) {
        i64 start = cursor;

        while (cursor < list_length && raz_compiler_rt_arena_get(list, cursor) != 10) {
            cursor += 1;
        }

        i64 line_length = cursor - start;

        if (line_length == path_length) {
            i64 i = 0;
            bool same = true;

            while (same && i < path_length) {
                if (raz_compiler_rt_arena_get(list, start + i) != raz_compiler_rt_arena_get(path, i)) {
                    same = false;
                }
                i += 1;
            }
            if (same) {
                return true;
            }
        }
        if (cursor < list_length) {
            cursor += 1;
        }
    }
    return false;
}

fn path_list_append(i64 list, i64&mut list_length, i64 capacity, i64 path, i64 path_length) -> bool {
    if (*list_length + path_length + 1 > capacity) {
        return false;
    }

    i64 i = 0;

    while (i < path_length) {
        raz_compiler_rt_arena_set(list, *list_length, raz_compiler_rt_arena_get(path, i));
        *list_length += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(list, *list_length, 10);
    *list_length += 1;
    return true;
}

fn project_line_starts_with(i64 data, i64 start, i64 end, i64[]text, i64 length) -> bool {
    while (start < end && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
        start += 1;
    }
    if (end - start < length) {
        return false;
    }

    i64 index = 0;

    while (index < length) {
        if (raz_compiler_rt_arena_get(data, start + index) != text[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn project_hash_namespace_range(i64 data, i64 start, i64 end) -> i64 {
    while (start < end && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
        start += 1;
    }
    while (end > start && ascii_is_space(raz_compiler_rt_arena_get(data, end - 1))) {
        end -= 1;
    }
    if (end > start && raz_compiler_rt_arena_get(data, end - 1) == 59) {
        end -= 1;
    }
    while (end > start && ascii_is_space(raz_compiler_rt_arena_get(data, end - 1))) {
        end -= 1;
    }
    if (end <= start) {
        return 0;
    }
    return raz_compiler_rt_arena_range_hash(data, start, end - start, 17);
}

fn project_module_namespace_hash_range(
    i64 data,
    i64 data_start,
    i64 length,
    i64 package_name,
    i64 package_name_length,
) -> i64 {
    i64 cursor = data_start;
    i64 limit = data_start + length;

    while (cursor < limit) {
        i64 start = cursor;

        while (
            cursor < limit &&
            raz_compiler_rt_arena_get(data, cursor) != 10 &&
            raz_compiler_rt_arena_get(data, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < limit &&
            (raz_compiler_rt_arena_get(data, cursor) == 10 || raz_compiler_rt_arena_get(data, cursor) == 13)
        ) {
            cursor += 1;
        }

        i64 namespace_word[10] = [110, 97, 109, 101, 115, 112, 97, 99, 101, 32];

        if (project_line_starts_with(data, start, end, &namespace_word, 10)) {
            while (start < end && ascii_is_space(raz_compiler_rt_arena_get(data, start))) {
                start += 1;
            }
            return project_hash_namespace_range(data, start + 10, end);
        }
    }

    i64 package_copy = raz_compiler_rt_arena_create(package_name_length);

    if (package_copy == 0) {
        return 0;
    }

    i64 index = 0;

    while (index < package_name_length) {
        i64 value = raz_compiler_rt_arena_get(package_name, index);

        if (value == 45 || value == 46 || value == 47 || value == 92) {
            value = 95;
        }
        raz_compiler_rt_arena_set(package_copy, index, value);
        index += 1;
    }

    i64 result = raz_compiler_rt_arena_range_hash(package_copy, 0, package_name_length, 17);

    raz_compiler_rt_arena_destroy(package_copy);
    return result;
}

fn project_module_namespace_hash(i64 data, i64 length, i64 package_name, i64 package_name_length) -> i64 {
    return project_module_namespace_hash_range(data, 0, length, package_name, package_name_length);
}

fn project_metadata_append_decimal(i64 output, i64&mut length, i64 capacity, i64 value) -> bool {
    if (output == 0 || *length >= capacity) {
        return false;
    }
    if (value < 0) {
        if (*length + 1 >= capacity) {
            return false;
        }
        raz_compiler_rt_arena_set(output, *length, 45);
        *length += 1;
        value = 0 - value;
    }

    i64 digits[24];
    i64 count = 0;

    if (value == 0) {
        digits[0] = 48;
        count = 1;
    } else {
        while (value > 0 && count < 24) {
            digits[count] = 48 + (value % 10);
            value /= 10;
            count += 1;
        }
    }
    if (*length + count > capacity) {
        return false;
    }
    while (count > 0) {
        count -= 1;
        raz_compiler_rt_arena_set(output, *length, digits[count]);
        *length += 1;
    }
    return true;
}

fn project_metadata_tick(i64 metadata) -> i64 {
    i64 tick = raz_compiler_rt_arena_get(metadata, 6);

    if (tick < 0) {
        tick = 0 - tick;
    }
    return tick;
}

fn project_record_input(i64 state, i64 path, i64 path_length) -> bool {
    if (state == 0 || raz_compiler_rt_arena_get(state, 18) == 0) {
        return true;
    }

    i64 output = raz_compiler_rt_arena_get(state, 15);
    i64 length = raz_compiler_rt_arena_get(state, 16);
    i64 capacity = raz_compiler_rt_arena_get(state, 17);
    i64 metadata = raz_compiler_rt_arena_create(7);

    if (output == 0 || metadata == 0 || path == 0 || path_length <= 0) {
        if (metadata != 0) {
            raz_compiler_rt_arena_destroy(metadata);
        }
        raz_compiler_rt_arena_set(state, 18, 0);
        return false;
    }
    if (raz_compiler_rt_fs_metadata_ascii(path, path_length, metadata) == 0) {
        raz_compiler_rt_arena_destroy(metadata);
        raz_compiler_rt_arena_set(state, 18, 0);
        return false;
    }
    bool ok = project_metadata_append_decimal(
        output,
        &mut length,
        capacity,
        raz_compiler_rt_arena_get(metadata, 1),
    );
    if (ok && length < capacity) {
        raz_compiler_rt_arena_set(output, length, 32);
        length += 1;
    } else {
        ok = false;
    }
    if (
        ok &&
        !project_metadata_append_decimal(output, &mut length, capacity, project_metadata_tick(metadata))
    ) {
        ok = false;
    }
    if (ok && length < capacity) {
        raz_compiler_rt_arena_set(output, length, 32);
        length += 1;
    } else {
        ok = false;
    }
    if (ok && length + path_length + 1 <= capacity) {
        i64 index = 0;

        while (index < path_length) {
            raz_compiler_rt_arena_set(output, length + index, raz_compiler_rt_arena_get(path, index));
            index += 1;
        }
        length += path_length;
        raz_compiler_rt_arena_set(output, length, 10);
        length += 1;
    } else {
        ok = false;
    }
    raz_compiler_rt_arena_destroy(metadata);
    if (!ok) {
        raz_compiler_rt_arena_set(state, 18, 0);
        return false;
    }
    raz_compiler_rt_arena_set(state, 16, length);
    return true;
}

// A package graph can change while raz.toml stays byte-for-byte identical.  In
// particular `raz update` rewrites raz.lock when a registry dependency advances
// to a new immutable package checksum.  The assembled-project cache therefore
// records the sibling lockfile as an input whenever one exists.  Without this,
// an old content-addressed package can remain a valid *old* cache input and the
// cached combined source can survive a lockfile upgrade.
fn project_record_lock_input(i64 state, i64 root, i64 root_length) -> bool {
    if (state == 0 || root == 0 || root_length <= 0 || raz_compiler_rt_arena_get(state, 18) == 0) {
        return true;
    }

    i64 lock_name[8] = [114, 97, 122, 46, 108, 111, 99, 107];
    i64 lock_path = raz_compiler_rt_arena_create(8192);

    if (lock_path == 0) {
        raz_compiler_rt_arena_set(state, 18, 0);
        return false;
    }

    i64 lock_length = path_join(root, root_length, &lock_name, 8, lock_path, 8192);

    if (lock_length <= 0) {
        raz_compiler_rt_arena_destroy(lock_path);
        raz_compiler_rt_arena_set(state, 18, 0);
        return false;
    }
    // A missing lockfile is valid for path-only/unlocked projects.  raz add
    // changes raz.toml when introducing a registry dependency, so creation of
    // the first lockfile cannot incorrectly preserve an older project cache.
    if (raz_compiler_rt_path_exists_ascii(lock_path, lock_length) == 0) {
        raz_compiler_rt_arena_destroy(lock_path);
        return true;
    }

    bool ok = project_record_input(state, lock_path, lock_length);

    raz_compiler_rt_arena_destroy(lock_path);
    return ok;
}

fn project_path_range_less(
    i64 list,
    i64 left_start,
    i64 left_length,
    i64 right_start,
    i64 right_length,
) -> bool {
    i64 count = left_length;

    if (right_length < count) {
        count = right_length;
    }

    i64 index = 0;

    while (index < count) {
        i64 left = raz_compiler_rt_arena_get(list, left_start + index);
        i64 right = raz_compiler_rt_arena_get(list, right_start + index);

        if (left == 92) {
            left = 47;
        }
        if (right == 92) {
            right = 47;
        }
        if (left < right) {
            return true;
        }
        if (left > right) {
            return false;
        }
        index += 1;
    }
    return left_length < right_length;
}

fn project_topology_cleanup(
    i64 path_starts,
    i64 path_lengths,
    i64 namespace_hashes,
    i64 scheduled,
    i64 dependency_counts,
    i64 edge_owners,
    i64 edge_targets,
    i64 module_sources,
    i64 module_source_lengths,
    i64 module_count,
    i64 module_bytes,
    i64 path,
) {
    if (module_sources != 0) {
        i64 module_index = 0;

        while (module_index < module_count) {
            i64 source = raz_compiler_rt_arena_get(module_sources, module_index);

            if (source != 0) {
                raz_compiler_rt_arena_destroy(source);
            }
            module_index += 1;
        }
    }
    raz_compiler_rt_arena_destroy(path_starts);
    raz_compiler_rt_arena_destroy(path_lengths);
    raz_compiler_rt_arena_destroy(namespace_hashes);
    raz_compiler_rt_arena_destroy(scheduled);
    raz_compiler_rt_arena_destroy(dependency_counts);
    raz_compiler_rt_arena_destroy(edge_owners);
    raz_compiler_rt_arena_destroy(edge_targets);
    raz_compiler_rt_arena_destroy(module_sources);
    raz_compiler_rt_arena_destroy(module_source_lengths);
    raz_compiler_rt_arena_destroy(module_bytes);
    raz_compiler_rt_arena_destroy(path);
}

fn append_project_topological_sources(
    i64 file_list,
    i64 list_length,
    i64 state,
    i64 package_name,
    i64 package_name_length,
    i64 entry_path,
    i64 entry_path_length,
) -> i64 {
    i64 path_starts = raz_compiler_rt_arena_create(4096);
    i64 path_lengths = raz_compiler_rt_arena_create(4096);
    i64 namespace_hashes = raz_compiler_rt_arena_create(4096);
    i64 scheduled = raz_compiler_rt_arena_create(4096);
    i64 dependency_counts = raz_compiler_rt_arena_create(4096);
    i64 edge_owners = raz_compiler_rt_arena_create(16384);
    i64 edge_targets = raz_compiler_rt_arena_create(16384);
    i64 module_sources = raz_compiler_rt_arena_create(4096);
    i64 module_source_lengths = raz_compiler_rt_arena_create(4096);
    i64 module_bytes = raz_compiler_rt_arena_create(raz_compiler_rt_arena_get(state, 3));
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 module_count = 0;

    if (
        path_starts == 0 ||
        path_lengths == 0 ||
        namespace_hashes == 0 ||
        scheduled == 0 ||
        dependency_counts == 0 ||
        edge_owners == 0 ||
        edge_targets == 0 ||
        module_sources == 0 ||
        module_source_lengths == 0 ||
        module_bytes == 0 ||
        path == 0
    ) {
        project_topology_cleanup(
            path_starts,
            path_lengths,
            namespace_hashes,
            scheduled,
            dependency_counts,
            edge_owners,
            edge_targets,
            module_sources,
            module_source_lengths,
            module_count,
            module_bytes,
            path,
        );
        return 0;
    }

    i64 entry_index = -1;
    i64 cursor = 0;

    // Read each module exactly once. The retained source is reused for namespace
    // discovery, import discovery, and final concatenation in topological order.
    while (cursor < list_length && module_count < 4096) {
        i64 start = cursor;

        while (cursor < list_length && raz_compiler_rt_arena_get(file_list, cursor) != 10) {
            cursor += 1;
        }

        i64 end = cursor;

        if (cursor < list_length) {
            cursor += 1;
        }
        if (end > start && path_range_has_rz_extension(file_list, start, end - start)) {
            i64 path_length = end - start;
            i64 index = 0;

            while (index < path_length) {
                raz_compiler_rt_arena_set(path, index, raz_compiler_rt_arena_get(file_list, start + index));
                index += 1;
            }
            i64 read = raz_compiler_rt_read_ascii(
                path,
                path_length,
                module_bytes,
                raz_compiler_rt_arena_get(state, 3),
            );
            if (read <= 0) {
                project_topology_cleanup(
                    path_starts,
                    path_lengths,
                    namespace_hashes,
                    scheduled,
                    dependency_counts,
                    edge_owners,
                    edge_targets,
                    module_sources,
                    module_source_lengths,
                    module_count,
                    module_bytes,
                    path,
                );
                return 0;
            }
            if (!project_record_input(state, path, path_length)) {
                project_topology_cleanup(
                    path_starts,
                    path_lengths,
                    namespace_hashes,
                    scheduled,
                    dependency_counts,
                    edge_owners,
                    edge_targets,
                    module_sources,
                    module_source_lengths,
                    module_count,
                    module_bytes,
                    path,
                );
                return 0;
            }

            i64 retained_source = raz_compiler_rt_arena_create(read);

            if (
                retained_source == 0 ||
                raz_compiler_rt_arena_copy(retained_source, 0, module_bytes, 0, read) != read
            ) {
                if (retained_source != 0) {
                    raz_compiler_rt_arena_destroy(retained_source);
                }
                project_topology_cleanup(
                    path_starts,
                    path_lengths,
                    namespace_hashes,
                    scheduled,
                    dependency_counts,
                    edge_owners,
                    edge_targets,
                    module_sources,
                    module_source_lengths,
                    module_count,
                    module_bytes,
                    path,
                );
                return 0;
            }
            raz_compiler_rt_arena_set(path_starts, module_count, start);
            raz_compiler_rt_arena_set(path_lengths, module_count, path_length);
            raz_compiler_rt_arena_set(module_sources, module_count, retained_source);
            raz_compiler_rt_arena_set(module_source_lengths, module_count, read);
            raz_compiler_rt_arena_set(
                namespace_hashes,
                module_count,
                project_module_namespace_hash(retained_source, read, package_name, package_name_length),
            );
            raz_compiler_rt_arena_set(scheduled, module_count, 0);
            raz_compiler_rt_arena_set(dependency_counts, module_count, 0);
            if (path_bytes_equal(entry_path, entry_path_length, path, path_length)) {
                entry_index = module_count;
            }
            module_count += 1;
        }
    }
    if (module_count <= 0 || entry_index < 0) {
        project_topology_cleanup(
            path_starts,
            path_lengths,
            namespace_hashes,
            scheduled,
            dependency_counts,
            edge_owners,
            edge_targets,
            module_sources,
            module_source_lengths,
            module_count,
            module_bytes,
            path,
        );
        return 0;
    }

    i64 edge_count = 0;
    i64 owner = 0;

    while (owner < module_count) {
        i64 source = raz_compiler_rt_arena_get(module_sources, owner);
        i64 source_length = raz_compiler_rt_arena_get(module_source_lengths, owner);
        i64 line = 0;

        while (line < source_length) {
            i64 start = line;

            while (
                line < source_length &&
                raz_compiler_rt_arena_get(source, line) != 10 &&
                raz_compiler_rt_arena_get(source, line) != 13
            ) {
                line += 1;
            }

            i64 end = line;

            while (
                line < source_length &&
                (
                    raz_compiler_rt_arena_get(source, line) == 10 ||
                    raz_compiler_rt_arena_get(source, line) == 13
                )
            ) {
                line += 1;
            }

            i64 import_word[7] = [105, 109, 112, 111, 114, 116, 32];
            i64 public_import_word[14] = [112, 117, 98, 108, 105, 99, 32, 105, 109, 112, 111, 114, 116, 32];
            i64 import_start = -1;

            if (project_line_starts_with(source, start, end, &public_import_word, 14)) {
                while (start < end && ascii_is_space(raz_compiler_rt_arena_get(source, start))) {
                    start += 1;
                }
                import_start = start + 14;
            } else if (project_line_starts_with(source, start, end, &import_word, 7)) {
                while (start < end && ascii_is_space(raz_compiler_rt_arena_get(source, start))) {
                    start += 1;
                }
                import_start = start + 7;
            }
            if (import_start >= 0) {
                i64 import_hash = project_hash_namespace_range(source, import_start, end);
                i64 target = 0;

                while (target < module_count) {
                    if (
                        target != owner &&
                        import_hash != 0 &&
                        raz_compiler_rt_arena_get(namespace_hashes, target) == import_hash
                    ) {
                        if (edge_count >= 16384) {
                            project_topology_cleanup(
                                path_starts,
                                path_lengths,
                                namespace_hashes,
                                scheduled,
                                dependency_counts,
                                edge_owners,
                                edge_targets,
                                module_sources,
                                module_source_lengths,
                                module_count,
                                module_bytes,
                                path,
                            );
                            return 0;
                        }
                        raz_compiler_rt_arena_set(edge_owners, edge_count, owner);
                        raz_compiler_rt_arena_set(edge_targets, edge_count, target);
                        raz_compiler_rt_arena_set(
                            dependency_counts,
                            owner,
                            raz_compiler_rt_arena_get(dependency_counts, owner) + 1,
                        );
                        edge_count += 1;
                    }
                    target += 1;
                }
            }
        }
        owner += 1;
    }

    i64 scheduled_count = 0;

    while (scheduled_count < module_count - 1) {
        i64 candidate = -1;
        i64 scan = 0;

        while (scan < module_count) {
            if (
                scan != entry_index &&
                raz_compiler_rt_arena_get(scheduled, scan) == 0 &&
                raz_compiler_rt_arena_get(dependency_counts, scan) == 0
            ) {
                if (candidate < 0) {
                    candidate = scan;
                } else if (
                    project_path_range_less(
                        file_list,
                        raz_compiler_rt_arena_get(path_starts, scan),
                        raz_compiler_rt_arena_get(path_lengths, scan),
                        raz_compiler_rt_arena_get(path_starts, candidate),
                        raz_compiler_rt_arena_get(path_lengths, candidate),
                    )
                ) {
                    candidate = scan;
                }
            }
            scan += 1;
        }
        if (candidate < 0) {
            project_topology_cleanup(
                path_starts,
                path_lengths,
                namespace_hashes,
                scheduled,
                dependency_counts,
                edge_owners,
                edge_targets,
                module_sources,
                module_source_lengths,
                module_count,
                module_bytes,
                path,
            );
            return 0;
        }

        i64 current_length = raz_compiler_rt_arena_get(state, 1);

        if (
            !append_project_namespace(
                raz_compiler_rt_arena_get(state, 0),
                &mut current_length,
                raz_compiler_rt_arena_get(state, 2),
                package_name,
                package_name_length,
            ) ||
            !append_source_cached(
                raz_compiler_rt_arena_get(module_sources, candidate),
                0,
                raz_compiler_rt_arena_get(module_source_lengths, candidate),
                raz_compiler_rt_arena_get(state, 0),
                &mut current_length,
                raz_compiler_rt_arena_get(state, 2),
            )
        ) {
            project_topology_cleanup(
                path_starts,
                path_lengths,
                namespace_hashes,
                scheduled,
                dependency_counts,
                edge_owners,
                edge_targets,
                module_sources,
                module_source_lengths,
                module_count,
                module_bytes,
                path,
            );
            return 0;
        }
        raz_compiler_rt_arena_set(state, 1, current_length);
        raz_compiler_rt_arena_set(state, 4, raz_compiler_rt_arena_get(state, 4) + 1);
        raz_compiler_rt_arena_set(scheduled, candidate, 1);

        i64 release_edge = 0;

        while (release_edge < edge_count) {
            if (raz_compiler_rt_arena_get(edge_targets, release_edge) == candidate) {
                i64 dependent = raz_compiler_rt_arena_get(edge_owners, release_edge);
                i64 remaining = raz_compiler_rt_arena_get(dependency_counts, dependent);

                if (remaining > 0) {
                    raz_compiler_rt_arena_set(dependency_counts, dependent, remaining - 1);
                }
            }
            release_edge += 1;
        }
        scheduled_count += 1;
    }

    i64 current_length = raz_compiler_rt_arena_get(state, 1);

    if (
        !append_project_namespace(
            raz_compiler_rt_arena_get(state, 0),
            &mut current_length,
            raz_compiler_rt_arena_get(state, 2),
            package_name,
            package_name_length,
        ) ||
        !append_source_cached(
            raz_compiler_rt_arena_get(module_sources, entry_index),
            0,
            raz_compiler_rt_arena_get(module_source_lengths, entry_index),
            raz_compiler_rt_arena_get(state, 0),
            &mut current_length,
            raz_compiler_rt_arena_get(state, 2),
        )
    ) {
        project_topology_cleanup(
            path_starts,
            path_lengths,
            namespace_hashes,
            scheduled,
            dependency_counts,
            edge_owners,
            edge_targets,
            module_sources,
            module_source_lengths,
            module_count,
            module_bytes,
            path,
        );
        return 0;
    }
    raz_compiler_rt_arena_set(state, 1, current_length);
    raz_compiler_rt_arena_set(state, 4, raz_compiler_rt_arena_get(state, 4) + 1);
    project_topology_cleanup(
        path_starts,
        path_lengths,
        namespace_hashes,
        scheduled,
        dependency_counts,
        edge_owners,
        edge_targets,
        module_sources,
        module_source_lengths,
        module_count,
        module_bytes,
        path,
    );
    return 1;
}

// Optional package source-order.txt overrides physical discovery order when a package requires it.
fn append_project_source_order(
    i64 root,
    i64 root_length,
    i64 state,
    i64 package_name,
    i64 package_name_length,
) -> i64 {
    i64 order_name = raz_compiler_rt_arena_create(16);
    i64 order_path = raz_compiler_rt_arena_create(8192);
    i64 order_data = raz_compiler_rt_arena_create(262144);
    i64 relative = raz_compiler_rt_arena_create(8192);
    i64 full_path = raz_compiler_rt_arena_create(8192);

    if (order_name == 0 || order_path == 0 || order_data == 0 || relative == 0 || full_path == 0) {
        return -1;
    }

    i64 order_codes[16] = [115, 111, 117, 114, 99, 101, 45, 111, 114, 100, 101, 114, 46, 116, 120, 116];
    i64 code_index = 0;

    while (code_index < 16) {
        raz_compiler_rt_arena_set(order_name, code_index, order_codes[code_index]);
        code_index += 1;
    }

    i64 order_path_length = path_join(root, root_length, order_name, 16, order_path, 8192);

    if (order_path_length <= 0) {
        return -1;
    }

    i64 order_length = raz_compiler_rt_read_ascii(order_path, order_path_length, order_data, 262144);

    if (order_length < 0) {
        raz_compiler_rt_arena_destroy(order_name);
        raz_compiler_rt_arena_destroy(order_path);
        raz_compiler_rt_arena_destroy(order_data);
        raz_compiler_rt_arena_destroy(relative);
        raz_compiler_rt_arena_destroy(full_path);
        return 0;
    }

    i64 current_namespace_length = raz_compiler_rt_arena_get(state, 1);

    if (
        !append_project_namespace(
            raz_compiler_rt_arena_get(state, 0),
            &mut current_namespace_length,
            raz_compiler_rt_arena_get(state, 2),
            package_name,
            package_name_length,
        )
    ) {
        return -1;
    }
    raz_compiler_rt_arena_set(state, 1, current_namespace_length);

    i64 cursor = 0;
    i64 source_count = 0;

    while (cursor < order_length) {
        i64 start = cursor;

        while (
            cursor < order_length &&
            raz_compiler_rt_arena_get(order_data, cursor) != 10 &&
            raz_compiler_rt_arena_get(order_data, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < order_length &&
            (
                raz_compiler_rt_arena_get(order_data, cursor) == 10 ||
                raz_compiler_rt_arena_get(order_data, cursor) == 13
            )
        ) {
            cursor += 1;
        }
        while (start < end && ascii_is_space(raz_compiler_rt_arena_get(order_data, start))) {
            start += 1;
        }
        while (end > start && ascii_is_space(raz_compiler_rt_arena_get(order_data, end - 1))) {
            end -= 1;
        }
        if (start >= end || raz_compiler_rt_arena_get(order_data, start) == 35) {
            continue;
        }

        i64 relative_length = end - start;

        if (
            relative_length <= 0 ||
            relative_length > 8192 ||
            !path_range_has_rz_extension(order_data, start, relative_length)
        ) {
            return -1;
        }

        i64 index = 0;

        while (index < relative_length) {
            raz_compiler_rt_arena_set(relative, index, raz_compiler_rt_arena_get(order_data, start + index));
            index += 1;
        }

        i64 full_length = path_join(root, root_length, relative, relative_length, full_path, 8192);

        if (full_length <= 0) {
            return -1;
        }

        i64 current_length = raz_compiler_rt_arena_get(state, 1);

        if (
            !append_source_path(
                full_path,
                full_length,
                raz_compiler_rt_arena_get(state, 0),
                &mut current_length,
                raz_compiler_rt_arena_get(state, 2),
                raz_compiler_rt_arena_get(state, 3),
            )
        ) {
            return -1;
        }
        raz_compiler_rt_arena_set(state, 1, current_length);
        raz_compiler_rt_arena_set(state, 4, raz_compiler_rt_arena_get(state, 4) + 1);
        source_count += 1;
    }
    raz_compiler_rt_arena_destroy(order_name);
    raz_compiler_rt_arena_destroy(order_path);
    raz_compiler_rt_arena_destroy(order_data);
    raz_compiler_rt_arena_destroy(relative);
    raz_compiler_rt_arena_destroy(full_path);
    if (source_count == 0) {
        return -1;
    }
    return 1;
}

fn project_feature_name_equals(i64 data, i64 start, i64 length, i64 name, i64 name_length) -> bool {
    if (length != name_length) {
        return false;
    }

    i64 i = 0;

    while (i < length) {
        if (raz_compiler_rt_arena_get(data, start + i) != raz_compiler_rt_arena_get(name, i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn project_feature_list_contains(i64 list, i64 length, i64 name, i64 name_length) -> bool {
    if (list == 0 || length <= 0 || name_length <= 0) {
        return false;
    }

    i64 cursor = 0;

    while (cursor < length) {
        while (
            cursor < length &&
            (
                raz_compiler_rt_arena_get(list, cursor) == 44 ||
                ascii_is_space(raz_compiler_rt_arena_get(list, cursor))
            )
        ) {
            cursor += 1;
        }

        i64 start = cursor;

        while (cursor < length && raz_compiler_rt_arena_get(list, cursor) != 44) {
            cursor += 1;
        }

        i64 end = cursor;

        while (end > start && ascii_is_space(raz_compiler_rt_arena_get(list, end - 1))) {
            end -= 1;
        }
        if (project_feature_name_equals(list, start, end - start, name, name_length)) {
            return true;
        }
    }
    return false;
}

fn project_feature_token_is_dependency(i64 data, i64 start, i64 length, i64 alias, i64 alias_length) -> bool {
    if (project_feature_name_equals(data, start, length, alias, alias_length)) {
        return true;
    }
    if (length != alias_length + 4) {
        return false;
    }

    i64 prefix[4] = [100, 101, 112, 58];
    i64 i = 0;

    while (i < 4) {
        if (raz_compiler_rt_arena_get(data, start + i) != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return project_feature_name_equals(data, start + 4, alias_length, alias, alias_length);
}

fn project_feature_enables_dependency(
    i64 manifest,
    i64 manifest_length,
    i64 feature,
    i64 feature_length,
    i64 alias,
    i64 alias_length,
    i64 depth,
) -> bool {
    if (depth > 16 || feature_length <= 0) {
        return false;
    }

    i64 section = 0;
    i64 cursor = 0;

    while (cursor < manifest_length) {
        i64 start = cursor;

        while (
            cursor < manifest_length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < manifest_length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }
        if (line_is_section(manifest, start, end, 9)) {
            section = 9;
            continue;
        }
        if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) {
            section = 0;
            continue;
        }
        if (section != 9) {
            continue;
        }

        i64 equal = start;

        while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) {
            equal += 1;
        }
        if (equal >= end) {
            continue;
        }

        i64 key = raz_compiler_rt_arena_create(256);

        if (key == 0) {
            return false;
        }

        i64 key_length = copy_manifest_key(manifest, start, equal, key, 256);

        bool key_matches =
            key_length > 0 &&
            project_feature_name_equals(key, 0, key_length, feature, feature_length);
        raz_compiler_rt_arena_destroy(key);
        if (!key_matches) {
            continue;
        }

        i64 pos = equal + 1;

        while (pos < end) {
            while (pos < end && raz_compiler_rt_arena_get(manifest, pos) != 34) {
                pos += 1;
            }
            if (pos >= end) {
                break;
            }
            pos += 1;

            i64 token_start = pos;

            while (pos < end && raz_compiler_rt_arena_get(manifest, pos) != 34) {
                pos += 1;
            }

            i64 token_length = pos - token_start;

            if (token_length > 0) {
                if (
                    project_feature_token_is_dependency(
                        manifest,
                        token_start,
                        token_length,
                        alias,
                        alias_length,
                    )
                ) {
                    return true;
                }
                // Feature-to-feature edges form a small deterministic closure.

                i64 nested = raz_compiler_rt_arena_create(token_length);

                if (nested == 0) {
                    return false;
                }

                i64 ni = 0;

                while (ni < token_length) {
                    raz_compiler_rt_arena_set(
                        nested,
                        ni,
                        raz_compiler_rt_arena_get(manifest, token_start + ni),
                    );
                    ni += 1;
                }
                bool enabled = project_feature_enables_dependency(
                    manifest,
                    manifest_length,
                    nested,
                    token_length,
                    alias,
                    alias_length,
                    depth + 1,
                );
                raz_compiler_rt_arena_destroy(nested);
                if (enabled) {
                    return true;
                }
            }
            if (pos < end) {
                pos += 1;
            }
        }
        return false;
    }
    return false;
}

fn project_optional_dependency_enabled(
    i64 manifest,
    i64 manifest_length,
    i64 alias,
    i64 alias_length,
    i64 state,
) -> bool {
    if (raz_compiler_rt_arena_get(state, 11) != 0) {
        return true;
    }

    i64 features = raz_compiler_rt_arena_get(state, 12);
    i64 features_length = raz_compiler_rt_arena_get(state, 13);

    if (project_feature_list_contains(features, features_length, alias, alias_length)) {
        return true;
    }
    if (features != 0 && features_length > 0) {
        i64 cursor = 0;

        while (cursor < features_length) {
            while (
                cursor < features_length &&
                (
                    raz_compiler_rt_arena_get(features, cursor) == 44 ||
                    ascii_is_space(raz_compiler_rt_arena_get(features, cursor))
                )
            ) {
                cursor += 1;
            }

            i64 start = cursor;

            while (cursor < features_length && raz_compiler_rt_arena_get(features, cursor) != 44) {
                cursor += 1;
            }

            i64 end = cursor;

            while (end > start && ascii_is_space(raz_compiler_rt_arena_get(features, end - 1))) {
                end -= 1;
            }
            if (end > start) {
                i64 feature = raz_compiler_rt_arena_create(end - start);

                if (feature == 0) {
                    return false;
                }

                i64 i = 0;

                while (i < end - start) {
                    raz_compiler_rt_arena_set(feature, i, raz_compiler_rt_arena_get(features, start + i));
                    i += 1;
                }
                bool enabled = project_feature_enables_dependency(
                    manifest,
                    manifest_length,
                    feature,
                    end - start,
                    alias,
                    alias_length,
                    0,
                );
                raz_compiler_rt_arena_destroy(feature);
                if (enabled) {
                    return true;
                }
            }
        }
    }
    if (raz_compiler_rt_arena_get(state, 14) != 0) {
        i64 default_name[7] = [100, 101, 102, 97, 117, 108, 116];
        i64 feature = raz_compiler_rt_arena_create(7);

        if (feature == 0) {
            return false;
        }

        i64 i = 0;

        while (i < 7) {
            raz_compiler_rt_arena_set(feature, i, default_name[i]);
            i += 1;
        }
        bool enabled = project_feature_enables_dependency(
            manifest,
            manifest_length,
            feature,
            7,
            alias,
            alias_length,
            0,
        );
        raz_compiler_rt_arena_destroy(feature);
        return enabled;
    }
    return false;
}

fn project_dependency_section_active(i64 section, i64 state) -> bool {
    if (section == 2) {
        return true;
    }
    if (section == 3) {
        return raz_compiler_rt_arena_get(state, 9) != 0;
    }
    if (section == 6) {
        return raz_compiler_rt_arena_get(state, 10) == 1;
    }
    if (section == 7) {
        return raz_compiler_rt_arena_get(state, 10) == 2;
    }
    if (section == 8) {
        return raz_compiler_rt_arena_get(state, 10) == 3;
    }
    return false;
}

fn append_project_manifest(i64 manifest_path, i64 manifest_path_length, i64 state, i64 depth) -> bool {
    if (depth > 32) {
        write_compiler_diagnostic(4, 101, depth);
        return false;
    }

    i64 canonical_manifest = raz_compiler_rt_arena_create(8192);

    if (canonical_manifest == 0) {
        write_compiler_diagnostic(4, 102, depth);
        return false;
    }
    i64 canonical_length = raz_compiler_rt_normalize_path(
        manifest_path,
        manifest_path_length,
        canonical_manifest,
        8192,
    );
    if (canonical_length <= 0) {
        write_compiler_diagnostic(4, 103, depth);
        return false;
    }
    if (
        path_list_contains(
            raz_compiler_rt_arena_get(state, 7),
            raz_compiler_rt_arena_get(state, 8),
            canonical_manifest,
            canonical_length,
        )
    ) {
        write_compiler_diagnostic(4, 104, depth);
        return false;
    }
    if (
        path_list_contains(
            raz_compiler_rt_arena_get(state, 5),
            raz_compiler_rt_arena_get(state, 6),
            canonical_manifest,
            canonical_length,
        )
    ) {
        raz_compiler_rt_arena_destroy(canonical_manifest);
        return true;
    }

    i64 active_mark = raz_compiler_rt_arena_get(state, 8);
    i64 active_length = raz_compiler_rt_arena_get(state, 8);
    i64 visited_length = raz_compiler_rt_arena_get(state, 6);

    if (
        !path_list_append(
            raz_compiler_rt_arena_get(state, 7),
            &mut active_length,
            262144,
            canonical_manifest,
            canonical_length,
        ) ||
        !path_list_append(
            raz_compiler_rt_arena_get(state, 5),
            &mut visited_length,
            262144,
            canonical_manifest,
            canonical_length,
        )
    ) {
        write_compiler_diagnostic(4, 105, depth);
        return false;
    }
    raz_compiler_rt_arena_set(state, 8, active_length);
    raz_compiler_rt_arena_set(state, 6, visited_length);

    i64 manifest_capacity = 65536;
    i64 manifest = raz_compiler_rt_arena_create(manifest_capacity);
    i64 root = raz_compiler_rt_arena_create(4096);
    i64 source_name = raz_compiler_rt_arena_create(4096);
    i64 package_name = raz_compiler_rt_arena_create(4096);
    i64 source_root = raz_compiler_rt_arena_create(8192);
    i64 entry_name = raz_compiler_rt_arena_create(4096);
    i64 entry_path = raz_compiler_rt_arena_create(8192);
    i64 file_list = raz_compiler_rt_arena_create(2097152);

    if (
        manifest == 0 ||
        root == 0 ||
        source_name == 0 ||
        package_name == 0 ||
        source_root == 0 ||
        entry_name == 0 ||
        entry_path == 0 ||
        file_list == 0
    ) {
        write_compiler_diagnostic(4, 106, depth);
        return false;
    }
    i64 manifest_length = raz_compiler_rt_read_ascii(
        canonical_manifest,
        canonical_length,
        manifest,
        manifest_capacity,
    );
    if (manifest_length > 0) {
        project_record_input(state, canonical_manifest, canonical_length);
    }

    i64 root_length = path_dirname(canonical_manifest, canonical_length, root, 4096);

    if (root_length > 0 && !project_record_lock_input(state, root, root_length)) {
        write_compiler_diagnostic(4, 105, depth);
        return false;
    }

    i64 source_name_length = manifest_source_directory(manifest, manifest_length, source_name, 4096);
    i64 package_name_length = manifest_package_name(manifest, manifest_length, package_name, 4096);
    i64 entry_name_length = manifest_entry_path(manifest, manifest_length, entry_name, 4096);
    i64 entry_path_length = path_join(root, root_length, entry_name, entry_name_length, entry_path, 8192);

    if (
        manifest_length <= 0 ||
        root_length <= 0 ||
        source_name_length <= 0 ||
        package_name_length <= 0 ||
        entry_name_length <= 0 ||
        entry_path_length <= 0
    ) {
        write_compiler_diagnostic(4, 107, depth);
        return false;
    }

    i64 section = 0;
    i64 cursor = 0;

    while (cursor < manifest_length) {
        i64 start = cursor;

        while (
            cursor < manifest_length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < manifest_length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }
        if (line_is_section(manifest, start, end, 2)) {
            section = 2;
        } else if (line_is_section(manifest, start, end, 3)) {
            section = 3;
        } else if (line_is_section(manifest, start, end, 4)) {
            section = 4;
        } else if (line_is_section(manifest, start, end, 5)) {
            section = 5;
        } else if (line_is_section(manifest, start, end, 6)) {
            section = 6;
        } else if (line_is_section(manifest, start, end, 7)) {
            section = 7;
        } else if (line_is_section(manifest, start, end, 8)) {
            section = 8;
        } else if (line_is_section(manifest, start, end, 9)) {
            section = 9;
        } else if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) {
            section = 0;
        } else if (section >= 2 && section <= 8 && section != 4) {
            i64 equal = start;

            while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) {
                equal += 1;
            }
            if (equal < end) {
                i64 dependency_alias_probe = raz_compiler_rt_arena_create(4096);

                if (dependency_alias_probe == 0) {
                    return false;
                }
                i64 dependency_alias_probe_length = copy_manifest_key(
                    manifest,
                    start,
                    equal,
                    dependency_alias_probe,
                    4096,
                );

                bool dependency_active = project_dependency_section_active(section, state);

                if (section == 5) {
                    dependency_active = project_optional_dependency_enabled(
                        manifest,
                        manifest_length,
                        dependency_alias_probe,
                        dependency_alias_probe_length,
                        state,
                    );
                }
                raz_compiler_rt_arena_destroy(dependency_alias_probe);
                if (!dependency_active) {
                    continue;
                }

                i64 dependency = raz_compiler_rt_arena_create(4096);
                i64 dependency_root = raz_compiler_rt_arena_create(8192);
                i64 dependency_manifest = raz_compiler_rt_arena_create(8192);

                if (dependency == 0 || dependency_root == 0 || dependency_manifest == 0) {
                    write_compiler_diagnostic(4, 108, depth);
                    return false;
                }

                i64 dependency_length = copy_quoted_value(manifest, equal + 1, end, dependency, 4096);
                i64 dependency_join = dependency;
                i64 dependency_join_length = dependency_length;
                i64 registry_decl = 0;

                if (project_registry_bare_constraint(dependency, dependency_length)) {
                    i64 dependency_alias = raz_compiler_rt_arena_create(4096);

                    registry_decl = raz_compiler_rt_arena_create(8192);
                    if (dependency_alias == 0 || registry_decl == 0) {
                        return false;
                    }
                    i64 dependency_alias_length = copy_manifest_key(
                        manifest,
                        start,
                        equal,
                        dependency_alias,
                        4096,
                    );
                    dependency_join_length = project_registry_manifest_spec(
                        dependency_alias,
                        dependency_alias_length,
                        dependency,
                        dependency_length,
                        registry_decl,
                        8192,
                    );
                    raz_compiler_rt_arena_destroy(dependency_alias);
                    if (dependency_join_length <= 0) {
                        raz_compiler_rt_arena_destroy(registry_decl);
                        return false;
                    }
                    dependency_join = registry_decl;
                }
                i64 dependency_root_length = path_join(
                    root,
                    root_length,
                    dependency_join,
                    dependency_join_length,
                    dependency_root,
                    8192,
                );
                if (registry_decl != 0) {
                    raz_compiler_rt_arena_destroy(registry_decl);
                }

                i64 raz_toml = raz_compiler_rt_arena_create(8);

                if (raz_toml == 0) {
                    return false;
                }
                raz_compiler_rt_arena_set(raz_toml, 0, 114);
                raz_compiler_rt_arena_set(raz_toml, 1, 97);
                raz_compiler_rt_arena_set(raz_toml, 2, 122);
                raz_compiler_rt_arena_set(raz_toml, 3, 46);
                raz_compiler_rt_arena_set(raz_toml, 4, 116);
                raz_compiler_rt_arena_set(raz_toml, 5, 111);
                raz_compiler_rt_arena_set(raz_toml, 6, 109);
                raz_compiler_rt_arena_set(raz_toml, 7, 108);
                i64 dependency_manifest_length = path_join(
                    dependency_root,
                    dependency_root_length,
                    raz_toml,
                    8,
                    dependency_manifest,
                    8192,
                );
                raz_compiler_rt_arena_destroy(raz_toml);
                if (
                    dependency_length <= 0 ||
                    dependency_root_length <= 0 ||
                    dependency_manifest_length <= 0 ||
                    !append_project_manifest(
                        dependency_manifest,
                        dependency_manifest_length,
                        state,
                        depth + 1,
                    )
                ) {
                    write_compiler_diagnostic(4, 109, depth);
                    return false;
                }

                i64 dependency_manifest_data = raz_compiler_rt_arena_create(65536);
                i64 dependency_package_name = raz_compiler_rt_arena_create(4096);
                i64 dependency_alias = raz_compiler_rt_arena_create(4096);

                if (dependency_manifest_data == 0 || dependency_package_name == 0 || dependency_alias == 0) {
                    write_compiler_diagnostic(4, 108, depth);
                    return false;
                }
                i64 dependency_manifest_data_length = raz_compiler_rt_read_ascii(
                    dependency_manifest,
                    dependency_manifest_length,
                    dependency_manifest_data,
                    65536,
                );
                i64 dependency_package_name_length = manifest_package_name(
                    dependency_manifest_data,
                    dependency_manifest_data_length,
                    dependency_package_name,
                    4096,
                );
                i64 dependency_alias_length = copy_manifest_key(
                    manifest,
                    start,
                    equal,
                    dependency_alias,
                    4096,
                );

                i64 combined_length = raz_compiler_rt_arena_get(state, 1);

                if (
                    dependency_manifest_data_length <= 0 ||
                    dependency_package_name_length <= 0 ||
                    dependency_alias_length <= 0 ||
                    !append_project_dependency_alias(
                        raz_compiler_rt_arena_get(state, 0),
                        &mut combined_length,
                        raz_compiler_rt_arena_get(state, 2),
                        package_name,
                        package_name_length,
                        dependency_alias,
                        dependency_alias_length,
                        dependency_package_name,
                        dependency_package_name_length,
                    )
                ) {
                    write_compiler_diagnostic(4, 109, depth);
                    return false;
                }
                raz_compiler_rt_arena_set(state, 1, combined_length);
                raz_compiler_rt_arena_destroy(dependency_manifest_data);
                raz_compiler_rt_arena_destroy(dependency_package_name);
                raz_compiler_rt_arena_destroy(dependency_alias);
                raz_compiler_rt_arena_destroy(dependency);
                raz_compiler_rt_arena_destroy(dependency_root);
                raz_compiler_rt_arena_destroy(dependency_manifest);
            }
        }
    }

    i64 source_root_length = path_join(root, root_length, source_name, source_name_length, source_root, 8192);

    if (source_root_length <= 0) {
        write_compiler_diagnostic(4, 110, depth);
        return false;
    }
    i64 ordered_status = append_project_source_order(
        root,
        root_length,
        state,
        package_name,
        package_name_length,
    );
    if (ordered_status < 0) {
        write_compiler_diagnostic(4, 111, depth);
        return false;
    }
    if (ordered_status > 0) {
        raz_compiler_rt_arena_set(state, 18, 0);
        raz_compiler_rt_arena_destroy(manifest);
        raz_compiler_rt_arena_destroy(root);
        raz_compiler_rt_arena_destroy(source_name);
        raz_compiler_rt_arena_destroy(package_name);
        raz_compiler_rt_arena_destroy(source_root);
        raz_compiler_rt_arena_destroy(entry_name);
        raz_compiler_rt_arena_destroy(entry_path);
        raz_compiler_rt_arena_destroy(file_list);
        raz_compiler_rt_arena_set(state, 8, active_mark);
        raz_compiler_rt_arena_destroy(canonical_manifest);
        return true;
    }
    i64 list_length = raz_compiler_rt_list_files_recursive(
        source_root,
        source_root_length,
        file_list,
        2097152,
    );
    if (list_length < 0) {
        write_compiler_diagnostic(4, 111, depth);
        return false;
    }
    i64 topological_status = append_project_topological_sources(
        file_list,
        list_length,
        state,
        package_name,
        package_name_length,
        entry_path,
        entry_path_length,
    );
    if (topological_status > 0) {
        raz_compiler_rt_arena_destroy(manifest);
        raz_compiler_rt_arena_destroy(root);
        raz_compiler_rt_arena_destroy(source_name);
        raz_compiler_rt_arena_destroy(package_name);
        raz_compiler_rt_arena_destroy(source_root);
        raz_compiler_rt_arena_destroy(entry_name);
        raz_compiler_rt_arena_destroy(entry_path);
        raz_compiler_rt_arena_destroy(file_list);
        raz_compiler_rt_arena_set(state, 8, active_mark);
        raz_compiler_rt_arena_destroy(canonical_manifest);
        return true;
    }
    raz_compiler_rt_arena_set(state, 18, 0);

    bool entry_found = false;

    cursor = 0;
    while (cursor < list_length) {
        i64 start = cursor;

        while (cursor < list_length && raz_compiler_rt_arena_get(file_list, cursor) != 10) {
            cursor += 1;
        }

        i64 end = cursor;

        if (cursor < list_length) {
            cursor += 1;
        }
        if (end > start && path_range_has_rz_extension(file_list, start, end - start)) {
            i64 path = raz_compiler_rt_arena_create(end - start);

            if (path == 0) {
                write_compiler_diagnostic(4, 112, depth);
                return false;
            }

            i64 i = 0;

            while (start + i < end) {
                raz_compiler_rt_arena_set(path, i, raz_compiler_rt_arena_get(file_list, start + i));
                i += 1;
            }

            bool is_entry = path_bytes_equal(entry_path, entry_path_length, path, end - start);

            if (is_entry) {
                entry_found = true;
            } else {
                i64 current_length = raz_compiler_rt_arena_get(state, 1);

                if (
                    !append_project_namespace(
                        raz_compiler_rt_arena_get(state, 0),
                        &mut current_length,
                        raz_compiler_rt_arena_get(state, 2),
                        package_name,
                        package_name_length,
                    )
                ) {
                    write_compiler_diagnostic(4, 113, depth);
                    return false;
                }
                if (
                    !append_source_path(
                        path,
                        end - start,
                        raz_compiler_rt_arena_get(state, 0),
                        &mut current_length,
                        raz_compiler_rt_arena_get(state, 2),
                        raz_compiler_rt_arena_get(state, 3),
                    )
                ) {
                    write_compiler_diagnostic(4, 113, depth);
                    return false;
                }
                raz_compiler_rt_arena_set(state, 1, current_length);
                raz_compiler_rt_arena_set(state, 4, raz_compiler_rt_arena_get(state, 4) + 1);
            }
            raz_compiler_rt_arena_destroy(path);
        }
    }
    if (entry_found) {
        i64 entry_length = raz_compiler_rt_arena_get(state, 1);

        if (
            !append_project_namespace(
                raz_compiler_rt_arena_get(state, 0),
                &mut entry_length,
                raz_compiler_rt_arena_get(state, 2),
                package_name,
                package_name_length,
            )
        ) {
            write_compiler_diagnostic(4, 114, depth);
            return false;
        }
        if (
            !append_source_path(
                entry_path,
                entry_path_length,
                raz_compiler_rt_arena_get(state, 0),
                &mut entry_length,
                raz_compiler_rt_arena_get(state, 2),
                raz_compiler_rt_arena_get(state, 3),
            )
        ) {
            write_compiler_diagnostic(4, 114, depth);
            return false;
        }
        raz_compiler_rt_arena_set(state, 1, entry_length);
        raz_compiler_rt_arena_set(state, 4, raz_compiler_rt_arena_get(state, 4) + 1);
    } else if (depth == 0) {
        write_compiler_diagnostic(4, 115, depth);
        return false;
    }
    raz_compiler_rt_arena_destroy(manifest);
    raz_compiler_rt_arena_destroy(root);
    raz_compiler_rt_arena_destroy(source_name);
    raz_compiler_rt_arena_destroy(package_name);
    raz_compiler_rt_arena_destroy(source_root);
    raz_compiler_rt_arena_destroy(entry_name);
    raz_compiler_rt_arena_destroy(entry_path);
    raz_compiler_rt_arena_destroy(file_list);
    raz_compiler_rt_arena_set(state, 8, active_mark);
    raz_compiler_rt_arena_destroy(canonical_manifest);
    return true;
}

fn bootstrap_qualifications_requested() -> bool {
    i64 path = raz_compiler_rt_arena_create(18);
    i64 output = raz_compiler_rt_arena_create(1);

    if (path == 0 || output == 0) {
        raz_compiler_rt_arena_destroy(path);
        raz_compiler_rt_arena_destroy(output);
        return false;
    }
    raz_compiler_rt_arena_set(path, 0, 115);
    raz_compiler_rt_arena_set(path, 1, 116);
    raz_compiler_rt_arena_set(path, 2, 97);
    raz_compiler_rt_arena_set(path, 3, 103);
    raz_compiler_rt_arena_set(path, 4, 101);
    raz_compiler_rt_arena_set(path, 5, 49);
    raz_compiler_rt_arena_set(path, 6, 45);
    raz_compiler_rt_arena_set(path, 7, 113);
    raz_compiler_rt_arena_set(path, 8, 117);
    raz_compiler_rt_arena_set(path, 9, 97);
    raz_compiler_rt_arena_set(path, 10, 108);
    raz_compiler_rt_arena_set(path, 11, 105);
    raz_compiler_rt_arena_set(path, 12, 102);
    raz_compiler_rt_arena_set(path, 13, 121);
    raz_compiler_rt_arena_set(path, 14, 46);
    raz_compiler_rt_arena_set(path, 15, 116);
    raz_compiler_rt_arena_set(path, 16, 120);
    raz_compiler_rt_arena_set(path, 17, 116);

    i64 length = raz_compiler_rt_read_ascii(path, 18, output, 1);

    raz_compiler_rt_arena_destroy(path);
    raz_compiler_rt_arena_destroy(output);
    return length >= 0;
}

fn profile_queries_option(i64 path, i64 length) -> bool {
    if (path == 0 || length != 17) {
        return false;
    }

    i64 expected[17] = [45, 45, 112, 114, 111, 102, 105, 108, 101, 45, 113, 117, 101, 114, 105, 101, 115];
    i64 index = 0;

    while (index < 17) {
        if (raz_compiler_rt_arena_get(path, index) != expected[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn write_query_profile_row(ForgeWriter&mut out, i64 kind, i64 hits, i64 misses) {
    if (kind == 0) {
        i64 text[7] = [103, 101, 110, 101, 114, 105, 99];

        writer_chars(out, &text, 7);
    } else if (kind == 1) {
        i64 text[5] = [116, 114, 97, 105, 116];

        writer_chars(out, &text, 5);
    } else if (kind == 2) {
        i64 text[10] = [114, 101, 115, 111, 108, 117, 116, 105, 111, 110];

        writer_chars(out, &text, 10);
    } else if (kind == 3) {
        i64 text[6] = [115, 121, 109, 98, 111, 108];

        writer_chars(out, &text, 6);
    } else if (kind == 4) {
        i64 text[6] = [108, 97, 121, 111, 117, 116];

        writer_chars(out, &text, 6);
    } else {
        i64 text[5] = [115, 99, 111, 112, 101];

        writer_chars(out, &text, 5);
    }
    writer_space(out);
    writer_decimal(out, hits);
    writer_space(out);
    writer_decimal(out, misses);
    writer_newline(out);
}

fn write_query_profile(HirModule& hir) {
    ForgeWriter out;

    writer_init(&mut out);
    write_query_profile_row(&mut out, 0, hir.profile_generic_cache_hits, hir.profile_generic_cache_misses);
    write_query_profile_row(
        &mut out,
        1,
        hir.profile_trait_query_cache_hits,
        hir.profile_trait_query_cache_misses,
    );
    write_query_profile_row(
        &mut out,
        2,
        hir.profile_resolution_cache_hits,
        hir.profile_resolution_cache_misses,
    );
    write_query_profile_row(&mut out, 3, hir.profile_symbol_cache_hits, hir.profile_symbol_cache_misses);
    write_query_profile_row(&mut out, 4, hir.profile_layout_cache_hits, hir.profile_layout_cache_misses);
    write_query_profile_row(&mut out, 5, hir.profile_scope_cache_hits, hir.profile_scope_cache_misses);
    i64 total_hits =
        hir.profile_generic_cache_hits +
        hir.profile_trait_query_cache_hits +
        hir.profile_resolution_cache_hits +
        hir.profile_symbol_cache_hits +
        hir.profile_layout_cache_hits +
        hir.profile_scope_cache_hits;
    i64 total_misses =
        hir.profile_generic_cache_misses +
        hir.profile_trait_query_cache_misses +
        hir.profile_resolution_cache_misses +
        hir.profile_symbol_cache_misses +
        hir.profile_layout_cache_misses +
        hir.profile_scope_cache_misses;
    i64 total_text[5] = [116, 111, 116, 97, 108];

    writer_chars(&mut out, &total_text, 5);
    writer_space(&mut out);
    writer_decimal(&mut out, total_hits);
    writer_space(&mut out);
    writer_decimal(&mut out, total_misses);
    writer_newline(&mut out);

    i64 path[26] = [99, 111, 109, 112, 105, 108, 101, 114, 45, 113, 117, 101, 114, 121, 45, 112, 114, 111, 102, 105, 108, 101, 46, 116, 120, 116];

    raz_rt_write_ascii_i64(&mut path[0], 26, out.data, out.length);
    writer_destroy(&mut out);
}

fn project_load_sources_incremental(
    i64 manifest_path,
    i64 manifest_length,
    i64 bytes,
    i64 source_capacity,
    i64 module_capacity,
    bool test_after_build,
    bool all_features,
    bool default_features,
    i64 requested_features,
    i64 requested_features_length,
    i64&mut output_length,
    i64&mut output_module_count,
) -> bool {
    i64 visited = raz_compiler_rt_arena_create(262144);
    i64 active = raz_compiler_rt_arena_create(262144);
    i64 project_inputs = raz_compiler_rt_arena_create(source_capacity);
    i64 project_state = raz_compiler_rt_arena_create(19);

    if (visited == 0 || active == 0 || project_inputs == 0 || project_state == 0) {
        if (visited != 0) {
            raz_compiler_rt_arena_destroy(visited);
        }
        if (active != 0) {
            raz_compiler_rt_arena_destroy(active);
        }
        if (project_inputs != 0) {
            raz_compiler_rt_arena_destroy(project_inputs);
        }
        if (project_state != 0) {
            raz_compiler_rt_arena_destroy(project_state);
        }
        return false;
    }

    i64 include_dev_dependencies = 0;
    i64 include_all_features = 0;
    i64 include_default_features = 0;

    if (test_after_build) {
        include_dev_dependencies = 1;
    }
    if (all_features) {
        include_all_features = 1;
    }
    if (default_features) {
        include_default_features = 1;
    }
    raz_compiler_rt_arena_set(project_state, 0, bytes);
    raz_compiler_rt_arena_set(project_state, 1, 0);
    raz_compiler_rt_arena_set(project_state, 2, source_capacity);
    raz_compiler_rt_arena_set(project_state, 3, module_capacity);
    raz_compiler_rt_arena_set(project_state, 4, 0);
    raz_compiler_rt_arena_set(project_state, 5, visited);
    raz_compiler_rt_arena_set(project_state, 6, 0);
    raz_compiler_rt_arena_set(project_state, 7, active);
    raz_compiler_rt_arena_set(project_state, 8, 0);
    raz_compiler_rt_arena_set(project_state, 9, include_dev_dependencies);
    raz_compiler_rt_arena_set(project_state, 10, raz_compiler_rt_host_platform());
    raz_compiler_rt_arena_set(project_state, 11, include_all_features);
    raz_compiler_rt_arena_set(project_state, 12, requested_features);
    raz_compiler_rt_arena_set(project_state, 13, requested_features_length);
    raz_compiler_rt_arena_set(project_state, 14, include_default_features);
    raz_compiler_rt_arena_set(project_state, 15, project_inputs);
    raz_compiler_rt_arena_set(project_state, 16, 0);
    raz_compiler_rt_arena_set(project_state, 17, source_capacity);
    raz_compiler_rt_arena_set(project_state, 18, 1);
    write_compiler_diagnostic(83, 0, 0);
    i64 context_key = incremental_project_context_key(
        include_dev_dependencies,
        raz_compiler_rt_host_platform(),
        include_all_features,
        requested_features,
        requested_features_length,
        include_default_features,
    );
    bool restored = incremental_try_restore_project(
        manifest_path,
        manifest_length,
        context_key,
        bytes,
        source_capacity,
        output_length,
        output_module_count,
    );

    bool loaded = restored;

    if (!restored) {
        loaded =
            manifest_path != 0 &&
            append_project_manifest(manifest_path, manifest_length, project_state, 0);
        if (loaded) {
            *output_length = raz_compiler_rt_arena_get(project_state, 1);
            *output_module_count = raz_compiler_rt_arena_get(project_state, 4);
            if (raz_compiler_rt_arena_get(project_state, 18) != 0) {
                incremental_store_project(
                    manifest_path,
                    manifest_length,
                    context_key,
                    bytes,
                    *output_length,
                    *output_module_count,
                    project_inputs,
                    raz_compiler_rt_arena_get(project_state, 16),
                );
            }
        }
    }
    write_compiler_diagnostic(84, *output_module_count, *output_length);
    raz_compiler_rt_arena_destroy(project_state);
    raz_compiler_rt_arena_destroy(project_inputs);
    raz_compiler_rt_arena_destroy(visited);
    raz_compiler_rt_arena_destroy(active);
    return loaded;
}
