, 111, 107, 101, 110, 115, 80, 114, 111, 118, 105, 100, 101, 114, 34, 58, 123, 34, 108, 101, 103, 101, 110, 100, 34, 58, 123, 34, 116, 111, 107, 101, 110, 84, 121, 112, 101, 115, 34, 58, 91, 34, 107, 101, 121, 119, 111, 114, 100, 34, 44, 34, 102, 117, 110, 99, 116, 105, 111, 110, 34, 44, 34, 116, 121, 112, 101, 34, 44, 34, 118, 97, 114, 105, 97, 98, 108, 101, 34, 44, 34, 112, 97, 114, 97, 109, 101, 116, 101, 114, 34, 44, 34, 112, 114, 111, 112, 101, 114, 116, 121, 34, 44, 34, 101, 110, 117, 109, 77, 101, 109, 98, 101, 114, 34, 44, 34, 110, 97, 109, 101, 115, 112, 97, 99, 101, 34, 93, 44, 34, 116, 111, 107, 101, 110, 77, 111, 100, 105, 102, 105, 101, 114, 115, 34, 58, 91, 93, 125, 44, 34, 102, 117, 108, 108, 34, 58, 116, 114, 117, 101, 125, 44, 34, 99, 111, 100, 101, 65, 99, 116, 105, 111, 110, 80, 114, 111, 118, 105, 100, 101, 114, 34, 58, 123, 34, 99, 111, 100, 101, 65, 99, 116, 105, 111, 110, 75, 105, 110, 100, 115, 34, 58, 91, 34, 113, 117, 105, 99, 107, 102, 105, 120, 34, 44, 34, 115, 111, 117, 114, 99, 101, 46, 102, 105, 120, 65, 108, 108, 46, 114, 97, 122, 34, 93, 125, 44, 34, 105, 110, 108, 97, 121, 72, 105, 110, 116, 80, 114, 111, 118, 105, 100, 101, 114, 34, 58, 116, 114, 117, 101, 44, 34, 102, 111, 108, 100, 105, 110, 103, 82, 97, 110, 103, 101, 80, 114, 111, 118, 105, 100, 101, 114, 34, 58, 116, 114, 117, 101, 44, 34, 100, 111, 99, 117, 109, 101, 110, 116, 72, 105, 103, 104, 108, 105, 103, 104, 116, 80, 114, 111, 118, 105, 100, 101, 114, 34, 58, 116, 114, 117, 101, 44, 34, 115, 101, 108, 101, 99, 116, 105, 111, 110, 82, 97, 110, 103, 101, 80, 114, 111, 118, 105, 100, 101, 114, 34, 58, 116, 114, 117, 101, 125, 125];
    ok = ok && lsp_writer_literal(&mut out, &result, 778) && lsp_writer_byte(&mut out, 125);
    if (ok) { ok = lsp_send(&mut out); }
    lsp_writer_destroy(&mut out);
    return ok;
}

fn lsp_writer_json_array_string(LspWriter&mut writer, i64[]value, i64 length) -> bool {
    if (!lsp_writer_byte(writer, 34)) {
        return false;
    }

    i64 i = 0;

    while (i < length) {
        i64 byte = value[i];

        if (byte == 34 || byte == 92) {
            if (!lsp_writer_byte(writer, 92) || !lsp_writer_byte(writer, byte)) {
                return false;
            }
        } else if (!lsp_writer_byte(writer, byte)) {
            return false;
        }
        i += 1;
    }
    return lsp_writer_byte(writer, 34);
}

// Semantic editor queries reuse the production HIR as the source of identity
// and scope.  The lexer is used only to translate an LSP cursor back to the
// source token the compiler already understands.
struct LspSemanticTarget {
    bool found;
    bool local;
    i64 kind;
    i64 function_index;
    i64 name_offset;
    i64 name_length;
    i64 declaration_offset;
    i64 type_kind;
}

fn lsp_semantic_target_clear(LspSemanticTarget&mut target) {
    target.found = false;
    target.local = false;
    target.kind = 0;
    target.function_index = -1;
    target.name_offset = 0;
    target.name_length = 0;
    target.declaration_offset = 0;
    target.type_kind = -1;
}

fn lsp_offset_from_position(i64 body, i64 body_length, i64 text, i64 text_length) -> i64 {
    i64 position_key[8] = [112, 111, 115, 105, 116, 105, 111, 110];
    i64 line_key[4] = [108, 105, 110, 101];
    i64 character_key[9] = [99, 104, 97, 114, 97, 99, 116, 101, 114];
    i64 position = lsp_json_find_key(body, body_length, &position_key, 8, 0);

    if (position < 0) {
        return 0;
    }

    i64 target_line = lsp_json_integer_field(body, body_length, &line_key, 4, position);
    i64 target_character = lsp_json_integer_field(body, body_length, &character_key, 9, position);

    if (target_line < 0) {
        target_line = 0;
    }
    if (target_character < 0) {
        target_character = 0;
    }

    i64 line = 0;
    i64 character = 0;
    i64 offset = 0;

    while (offset < text_length && line < target_line) {
        if (raz_compiler_rt_arena_get(text, offset) == 10) {
            line += 1;
        }
        offset += 1;
    }
    while (offset < text_length && raz_compiler_rt_arena_get(text, offset) != 10 && character < target_character) {
        i64 width = 1;
        i64 codepoint = lsp_codepoint(text, offset, text_length, &mut width);
        i64 units = 1;

        if (codepoint > 65535) {
            units = 2;
        }
        if (character + units > target_character) {
            break;
        }
        character += units;
        offset += width;
    }
    return offset;
}

fn lsp_identifier_at(i64 text, i64 text_length, i64 offset, i64&mut name_offset, i64&mut name_length) -> bool {
    Source source;
    source.bytes = text;
    source.length = text_length;
    Lexer scan;
    init_lexer(&mut scan, source);
    Token token;
    next_token(&mut scan, &mut token);

    while (token.kind != TokenKind::End) {
        if (token.kind == TokenKind::Identifier && offset >= token.offset && offset <= token.offset + token.length) {
            *name_offset = token.offset;
            *name_length = token.length;
            return true;
        }
        next_token(&mut scan, &mut token);
    }
    return false;
}

fn lsp_name_same(i64 text, i64 left_offset, i64 left_length, i64 right_offset, i64 right_length) -> bool {
    if (left_length != right_length) {
        return false;
    }
    i64 i = 0;
    while (i < left_length) {
        if (raz_compiler_rt_arena_get(text, left_offset + i) != raz_compiler_rt_arena_get(text, right_offset + i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn lsp_function_at(HirModule& hir, i64 offset, i64 text_length) -> i64 {
    i64 best = -1;
    i64 best_offset = -1;
    i64 i = 0;
    while (i < hir.function_count) {
        i64 declaration = raz_compiler_rt_arena_get(hir.function_declaration_offsets, i);
        if (declaration <= offset && declaration >= best_offset && declaration < text_length) {
            best = i;
            best_offset = declaration;
        }
        i += 1;
    }
    return best;
}

fn lsp_function_end(HirModule& hir, i64 function_index, i64 text_length) -> i64 {
    i64 start = raz_compiler_rt_arena_get(hir.function_declaration_offsets, function_index);
    i64 end = text_length;
    i64 i = 0;
    while (i < hir.function_count) {
        i64 candidate = raz_compiler_rt_arena_get(hir.function_declaration_offsets, i);
        if (candidate > start && candidate < end) {
            end = candidate;
        }
        i += 1;
    }
    return end;
}

fn lsp_semantic_resolve_hir(
HirModule& hir,
i64 text,
i64 text_length,
i64 cursor,
i64 name_offset,
i64 name_length,
LspSemanticTarget&mut target,
) -> bool {
    lsp_semantic_target_clear(target);
    i64 function_index = lsp_function_at(hir, cursor, text_length);
    i64 i = 0;

    if (function_index >= 0) {
        while (i < hir.local_count) {
            if (
            raz_compiler_rt_arena_get(hir.local_function_indices, i) == function_index &&
            lsp_name_same(
            text,
            name_offset,
            name_length,
            raz_compiler_rt_arena_get(hir.local_name_offsets, i),
            raz_compiler_rt_arena_get(hir.local_name_lengths, i)
            )
            ) {
                target.found = true;
                target.local = true;
                target.kind = 7;
                target.function_index = function_index;
                target.name_offset = name_offset;
                target.name_length = name_length;
                target.declaration_offset = raz_compiler_rt_arena_get(hir.local_name_offsets, i);
                target.type_kind = raz_compiler_rt_arena_get(hir.local_types, i);
                return true;
            }
            i += 1;
        }
        i = 0;
        while (i < hir.parameter_count) {
            if (
            raz_compiler_rt_arena_get(hir.parameter_function_indices, i) == function_index &&
            lsp_name_same(
            text,
            name_offset,
            name_length,
            raz_compiler_rt_arena_get(hir.parameter_name_offsets, i),
            raz_compiler_rt_arena_get(hir.parameter_name_lengths, i)
            )
            ) {
                target.found = true;
                target.local = true;
                target.kind = 6;
                target.function_index = function_index;
                target.name_offset = name_offset;
                target.name_length = name_length;
                target.declaration_offset = raz_compiler_rt_arena_get(hir.parameter_name_offsets, i);
                target.type_kind = raz_compiler_rt_arena_get(hir.parameter_types, i);
                return true;
            }
            i += 1;
        }
    }

    i = 0;
    while (i < hir.function_count) {
        i64 declared = raz_compiler_rt_arena_get(hir.function_name_offsets, i);
        i64 declared_length = raz_compiler_rt_arena_get(hir.function_name_lengths, i);
        if (lsp_name_same(text, name_offset, name_length, declared, declared_length)) {
            target.found = true;
            target.kind = 1;
            target.function_index = i;
            target.name_offset = name_offset;
            target.name_length = name_length;
            target.declaration_offset = declared;
            target.type_kind = raz_compiler_rt_arena_get(hir.function_return_types, i);
            return true;
        }
        i += 1;
    }

    i = 0;
    while (i < hir.struct_count) {
        i64 declared = raz_compiler_rt_arena_get(hir.struct_name_offsets, i);
        i64 declared_length = raz_compiler_rt_arena_get(hir.struct_name_lengths, i);
        if (lsp_name_same(text, name_offset, name_length, declared, declared_length)) {
            target.found = true; target.kind = 2; target.name_offset = name_offset; target.name_length = name_length;
            target.declaration_offset = declared; return true;
        }
        i += 1;
    }
    i = 0;
    while (i < hir.enum_count) {
        i64 declared = raz_compiler_rt_arena_get(hir.enum_name_offsets, i);
        i64 declared_length = raz_compiler_rt_arena_get(hir.enum_name_lengths, i);
        if (lsp_name_same(text, name_offset, name_length, declared, declared_length)) {
            target.found = true; target.kind = 3; target.name_offset = name_offset; target.name_length = name_length;
            target.declaration_offset = declared; return true;
        }
        i += 1;
    }
    i = 0;
    while (i < hir.trait_count) {
        i64 declared = raz_compiler_rt_arena_get(hir.trait_name_offsets, i);
        i64 declared_length = raz_compiler_rt_arena_get(hir.trait_name_lengths, i);
        if (lsp_name_same(text, name_offset, name_length, declared, declared_length)) {
            target.found = true; target.kind = 4; target.name_offset = name_offset; target.name_length = name_length;
            target.declaration_offset = declared; return true;
        }
        i += 1;
    }
    i = 0;
    while (i < hir.global_count) {
        i64 declared = raz_compiler_rt_arena_get(hir.global_name_offsets, i);
        i64 declared_length = raz_compiler_rt_arena_get(hir.global_name_lengths, i);
        if (lsp_name_same(text, name_offset, name_length, declared, declared_length)) {
            target.found = true; target.kind = 5; target.name_offset = name_offset; target.name_length = name_length;
            target.declaration_offset = declared; target.type_kind = raz_compiler_rt_arena_get(hir.global_types, i); return true;
        }
        i += 1;
    }
    i = 0;
    while (i < hir.constant_count) {
        i64 declared = raz_compiler_rt_arena_get(hir.constant_name_offsets, i);
        i64 declared_length = raz_compiler_rt_arena_get(hir.constant_name_lengths, i);
        if (lsp_name_same(text, name_offset, name_length, declared, declared_length)) {
            target.found = true; target.kind = 8; target.name_offset = name_offset; target.name_length = name_length;
            target.declaration_offset = declared; target.type_kind = raz_compiler_rt_arena_get(hir.constant_types, i); return true;
        }
        i += 1;
    }
    return false;
}

fn lsp_semantic_resolve(
i64 text,
i64 text_length,
i64 cursor,
i64 name_offset,
i64 name_length,
LspSemanticTarget&mut target,
) -> bool {
    Source source;
    source.bytes = text;
    source.length = text_length;
    HirModule hir;
    if (!build_hir(source, &mut hir)) {
        if (hir.diagnostic_code != DiagnosticCode::None) {
            destroy_hir(&mut hir);
        }
        lsp_semantic_target_clear(target);
        return false;
    }
    bool found = lsp_semantic_resolve_hir(&hir, text, text_length, cursor, name_offset, name_length, target);
    destroy_hir(&mut hir);
    return found;
}

fn lsp_writer_type_name(LspWriter&mut out, i64 type_kind) -> bool {
    if (type_kind == 1) { i64 t[3] = [102,54,52]; return lsp_writer_literal(out, &t, 3); }
    if (type_kind == 2) { i64 t[2] = [105,56]; return lsp_writer_literal(out, &t, 2); }
    if (type_kind == 3) { i64 t[3] = [105,49,54]; return lsp_writer_literal(out, &t, 3); }
    if (type_kind == 4) { i64 t[3] = [105,51,50]; return lsp_writer_literal(out, &t, 3); }
    if (type_kind == 5) { i64 t[2] = [117,56]; return lsp_writer_literal(out, &t, 2); }
    if (type_kind == 6) { i64 t[3] = [117,49,54]; return lsp_writer_literal(out, &t, 3); }
    if (type_kind == 7) { i64 t[3] = [117,51,50]; return lsp_writer_literal(out, &t, 3); }
    if (type_kind == 8) { i64 t[3] = [117,54,52]; return lsp_writer_literal(out, &t, 3); }
    if (type_kind == 9) { i64 t[5] = [117,115,105,122,101]; return lsp_writer_literal(out, &t, 5); }
    if (type_kind == 10) { i64 t[4] = [99,104,97,114]; return lsp_writer_literal(out, &t, 4); }
    if (type_kind == 11) { i64 t[3] = [102,51,50]; return lsp_writer_literal(out, &t, 3); }
    if (type_kind == 13) { i64 t[6] = [115,116,114,105,110,103]; return lsp_writer_literal(out, &t, 6); }
    i64 t[3] = [105,54,52];
    return lsp_writer_literal(out, &t, 3);
}

fn lsp_signature_range(i64 text, i64 text_length, i64 name_offset, i64&mut start, i64&mut end) {
    *start = name_offset;
    while (*start > 0) {
        i64 byte = raz_compiler_rt_arena_get(text, *start - 1);
        if (byte == 10 || byte == 13 || byte == 125 || byte == 59) { break; }
        *start -= 1;
    }
    while (*start < name_offset && (raz_compiler_rt_arena_get(text, *start) == 32 || raz_compiler_rt_arena_get(text, *start) == 9)) { *start += 1; }
    *end = name_offset;
    while (*end < text_length) {
        i64 byte = raz_compiler_rt_arena_get(text, *end);
        if (byte == 123 || byte == 59 || byte == 10 || byte == 13) { break; }
        *end += 1;
    }
    while (*end > *start && (raz_compiler_rt_arena_get(text, *end - 1) == 32 || raz_compiler_rt_arena_get(text, *end - 1) == 9)) { *end -= 1; }
}

fn lsp_send_hover(LspDocuments& documents, i64 body, i64 body_length, i64 document_index) -> bool {
    i64 text = raz_compiler_rt_arena_get(documents.texts, document_index);
    i64 text_length = raz_compiler_rt_arena_get(documents.text_lengths, document_index);
    i64 cursor = lsp_offset_from_position(body, body_length, text, text_length);
    i64 name_offset = 0; i64 name_length = 0;
    if (!lsp_identifier_at(text, text_length, cursor, &mut name_offset, &mut name_length)) { return lsp_send_null_result(body, body_length); }
    LspSemanticTarget target;
    bool found = lsp_semantic_resolve(text, text_length, cursor, name_offset, name_length, &mut target);
    if (!found || (target.kind == 1 && target.local)) { return lsp_send_null_result(body, body_length); }
    LspWriter out;
    if (!lsp_writer_init(&mut out, 2048)) { return false; }
    bool ok = lsp_response_result_prefix(&mut out, body, body_length);
    i64 a[43] = [123,34,99,111,110,116,101,110,116,115,34,58,123,34,107,105,110,100,34,58,34,109,97,114,107,100,111,119,110,34,44,34,118,97,108,117,101,34,58,34,96,96,96];
    ok = ok && lsp_writer_literal(&mut out, &a, 43);
    if (target.kind == 1) {
        i64 sig_start = 0; i64 sig_end = 0; lsp_signature_range(text, text_length, target.declaration_offset, &mut sig_start, &mut sig_end);
        i64 razline[5] = [114,97,122,92,110]; ok = ok && lsp_writer_literal(&mut out, &razline, 5);
        ok = ok && lsp_writer_arena(&mut out, text, sig_start, sig_end - sig_start);
    } else {
        ok = ok && lsp_writer_type_name(&mut out, target.type_kind);
        ok = ok && lsp_writer_byte(&mut out, 32) && lsp_writer_arena(&mut out, text, target.declaration_offset, name_length);
    }
    i64 b[9] = [92,110,96,96,96,34,125,125,125];
    ok = ok && lsp_writer_literal(&mut out, &b, 9);
    if (ok) { ok = lsp_send(&mut out); }
    lsp_writer_destroy(&mut out); return ok;
}

fn lsp_write_location(LspWriter&mut out, i64 uri, i64 uri_length, i64 text, i64 text_length, i64 offset, i64 name_length) -> bool {
    i64 a[8] = [123,34,117,114,105,34,58,32];
    bool ok = lsp_writer_literal(out, &a, 7) && lsp_writer_json_string(out, uri, 0, uri_length);
    i64 b[9] = [44,34,114,97,110,103,101,34,58];
    return ok && lsp_writer_literal(out, &b, 9) && lsp_writer_range(out, text, text_length, offset, offset + name_length) && lsp_writer_byte(out, 125);
}

fn lsp_find_global_declaration(
LspDocuments& documents, i64 name_text, i64 name_offset, i64 name_length,
i64&mut out_document, LspSemanticTarget&mut out_target
) -> bool {
    i64 d = 0;
    while (d < documents.count) {
        i64 text = raz_compiler_rt_arena_get(documents.texts, d); i64 text_length = raz_compiler_rt_arena_get(documents.text_lengths, d);
        Source source; source.bytes = text; source.length = text_length; HirModule hir;
        if (build_hir(source, &mut hir)) {
            // Search declarations by matching against the requested spelling copied from another document.
            i64 i = 0;
            while (i < hir.function_count) {
                i64 declared = raz_compiler_rt_arena_get(hir.function_name_offsets, i); i64 dl = raz_compiler_rt_arena_get(hir.function_name_lengths, i);
                if (dl == name_length) {
                    bool same = true; i64 j = 0;
                    while (j < dl) { if (raz_compiler_rt_arena_get(text, declared+j) != raz_compiler_rt_arena_get(name_text, name_offset+j)) { same=false; break; } j+=1; }
                    if (same) { lsp_semantic_target_clear(out_target); out_target.found=true; out_target.kind=1; out_target.function_index=i; out_target.declaration_offset=declared; out_target.name_length=dl; out_target.type_kind=raz_compiler_rt_arena_get(hir.function_return_types,i); *out_document=d; destroy_hir(&mut hir); return true; }
                }
                i += 1;
            }
            destroy_hir(&mut hir);
        } else if (hir.diagnostic_code != DiagnosticCode::None) { destroy_hir(&mut hir); }
        d += 1;
    }
    return false;
}

fn lsp_send_definition(LspDocuments& documents, i64 body, i64 body_length, i64 document_index) -> bool {
    i64 text = raz_compiler_rt_arena_get(documents.texts, document_index); i64 text_length=raz_compiler_rt_arena_get(documents.text_lengths,document_index);
    i64 cursor=lsp_offset_from_position(body,body_length,text,text_length); i64 no=0; i64 nl=0;
    if (!lsp_identifier_at(text,text_length,cursor,&mut no,&mut nl)) { return lsp_send_null_result(body,body_length); }
    LspSemanticTarget target; bool found=lsp_semantic_resolve(text,text_length,cursor,no,nl,&mut target); i64 target_doc=document_index;
    if (!found) { found=lsp_find_global_declaration(documents,text,no,nl,&mut target_doc,&mut target); }
    if (!found) { return lsp_send_null_result(body,body_length); }
    i64 target_text=raz_compiler_rt_arena_get(documents.texts,target_doc); i64 target_len=raz_compiler_rt_arena_get(documents.text_lengths,target_doc);
    LspWriter out; if (!lsp_writer_init(&mut out,512)) { return false; }
    bool ok=lsp_response_result_prefix(&mut out,body,body_length) && lsp_write_location(&mut out,raz_compiler_rt_arena_get(documents.uris,target_doc),raz_compiler_rt_arena_get(documents.uri_lengths,target_doc),target_text,target_len,target.declaration_offset,nl) && lsp_writer_byte(&mut out,125);
    if(ok){ok=lsp_send(&mut out);} lsp_writer_destroy(&mut out); return ok;
}

fn lsp_occurrence_matches_target(HirModule& hir, i64 text, i64 text_length, i64 token_offset, i64 token_length, LspSemanticTarget& target) -> bool {
    LspSemanticTarget resolved;
    if (!lsp_semantic_resolve_hir(hir,text,text_length,token_offset,token_offset,token_length,&mut resolved)) { return false; }
    if (target.local) { return resolved.local && resolved.kind==target.kind && resolved.function_index==target.function_index && resolved.declaration_offset==target.declaration_offset; }
    return !resolved.local && resolved.kind==target.kind;
}

fn lsp_send_references(LspDocuments& documents, i64 body, i64 body_length, i64 document_index, bool highlights) -> bool {
    i64 text = raz_compiler_rt_arena_get(documents.texts, document_index);
    i64 text_length = raz_compiler_rt_arena_get(documents.text_lengths, document_index);
    i64 cursor = lsp_offset_from_position(body, body_length, text, text_length);
    i64 name_offset = 0;
    i64 name_length = 0;
    if (!lsp_identifier_at(text, text_length, cursor, &mut name_offset, &mut name_length)) {
        return lsp_send_null_result(body, body_length);
    }

    LspSemanticTarget target;
    bool found = lsp_semantic_resolve(text, text_length, cursor, name_offset, name_length, &mut target);
    i64 target_document = document_index;
    if (!found) {
        found = lsp_find_global_declaration(documents, text, name_offset, name_length, &mut target_document, &mut target);
    }
    if (!found) {
        return lsp_send_null_result(body, body_length);
    }

    LspWriter out;
    if (!lsp_writer_init(&mut out, 8192)) { return false; }
    bool ok = lsp_response_result_prefix(&mut out, body, body_length) && lsp_writer_byte(&mut out, 91);
    bool first = true;
    i64 d = 0;
    while (ok && d < documents.count) {
        if (target.local && d != target_document) { d += 1; continue; }
        i64 document_text = raz_compiler_rt_arena_get(documents.texts, d);
        i64 document_length = raz_compiler_rt_arena_get(documents.text_lengths, d);
        Source source; source.bytes = document_text; source.length = document_length;
        HirModule hir;
        bool valid = build_hir(source, &mut hir);
        Lexer scan; init_lexer(&mut scan, source); Token token; next_token(&mut scan, &mut token);
        while (ok && token.kind != TokenKind::End) {
            if (token.kind == TokenKind::Identifier && token.length == name_length) {
                bool spelling = true;
                i64 j = 0;
                while (j < name_length) {
                    if (raz_compiler_rt_arena_get(document_text, token.offset + j) != raz_compiler_rt_arena_get(text, name_offset + j)) { spelling = false; break; }
                    j += 1;
                }
                bool matches = false;
                if (spelling && valid) {
                    matches = lsp_occurrence_matches_target(&mut hir, document_text, document_length, token.offset, token.length, &mut target);
                } else if (spelling && !valid && !target.local) {
                    // Workspace-level unresolved globals are still useful editor
                    // references while another open document owns the declaration.
                    matches = true;
                }
                if (matches) {
                    if (!first) { ok = lsp_writer_byte(&mut out, 44); }
                    first = false;
                    if (highlights) {
                        i64 range_key[9] = [123,34,114,97,110,103,101,34,58];
                        ok = ok && lsp_writer_literal(&mut out, &range_key, 9) && lsp_writer_range(&mut out, document_text, document_length, token.offset, token.offset + token.length);
                        i64 kind_key[10] = [44,34,107,105,110,100,34,58,49,125];
                        ok = ok && lsp_writer_literal(&mut out, &kind_key, 10);
                    } else {
                        ok = ok && lsp_write_location(&mut out, raz_compiler_rt_arena_get(documents.uris, d), raz_compiler_rt_arena_get(documents.uri_lengths, d), document_text, document_length, token.offset, token.length);
                    }
                }
            }
            next_token(&mut scan, &mut token);
        }
        if (valid || hir.diagnostic_code != DiagnosticCode::None) { destroy_hir(&mut hir); }
        d += 1;
    }
    ok = ok && lsp_writer_byte(&mut out, 93) && lsp_writer_byte(&mut out, 125);
    if (ok) { ok = lsp_send(&mut out); }
    lsp_writer_destroy(&mut out);
    return ok;
}

fn lsp_valid_identifier(i64 text, i64 length) -> bool {
    if(length<=0){return false;} i64 i=0; while(i<length){i64 b=raz_compiler_rt_arena_get(text,i); bool valid=(b>=97&&b<=122)||(b>=65&&b<=90)||(b>=48&&b<=57)||b==95; if(!valid || (i==0&&b>=48&&b<=57)){return false;}i+=1;} return true;
}

fn lsp_send_rename(LspDocuments& documents, i64 body, i64 body_length, i64 document_index) -> bool {
    i64 replacement = raz_compiler_rt_arena_create(256);
    i64 key[7] = [110,101,119,78,97,109,101];
    i64 replacement_length = lsp_json_string_field(body, body_length, &key, 7, replacement, 256, 0);
    if (replacement_length < 0 || !lsp_valid_identifier(replacement, replacement_length)) {
        raz_compiler_rt_arena_destroy(replacement);
        return lsp_send_null_result(body, body_length);
    }
    i64 text = raz_compiler_rt_arena_get(documents.texts, document_index);
    i64 text_length = raz_compiler_rt_arena_get(documents.text_lengths, document_index);
    i64 cursor = lsp_offset_from_position(body, body_length, text, text_length);
    i64 name_offset = 0; i64 name_length = 0;
    if (!lsp_identifier_at(text, text_length, cursor, &mut name_offset, &mut name_length)) {
        raz_compiler_rt_arena_destroy(replacement); return lsp_send_null_result(body, body_length);
    }
    LspSemanticTarget target;
    bool found = lsp_semantic_resolve(text, text_length, cursor, name_offset, name_length, &mut target);
    i64 target_document = document_index;
    if (!found) { found = lsp_find_global_declaration(documents, text, name_offset, name_length, &mut target_document, &mut target); }
    if (!found) { raz_compiler_rt_arena_destroy(replacement); return lsp_send_null_result(body, body_length); }

    LspWriter out; if (!lsp_writer_init(&mut out, 8192)) { raz_compiler_rt_arena_destroy(replacement); return false; }
    bool ok = lsp_response_result_prefix(&mut out, body, body_length);
    i64 changes_key[12] = [123,34,99,104,97,110,103,101,115,34,58,123];
    ok = ok && lsp_writer_literal(&mut out, &changes_key, 12);
    bool first_document = true;
    i64 d = 0;
    while (ok && d < documents.count) {
        if (target.local && d != target_document) { d += 1; continue; }
        i64 document_text = raz_compiler_rt_arena_get(documents.texts, d);
        i64 document_length = raz_compiler_rt_arena_get(documents.text_lengths, d);
        Source source; source.bytes = document_text; source.length = document_length;
        HirModule hir; bool valid = build_hir(source, &mut hir);
        LspWriter edits; if (!lsp_writer_init(&mut edits, 4096)) { ok = false; break; }
        bool first_edit = true;
        Lexer scan; init_lexer(&mut scan, source); Token token; next_token(&mut scan, &mut token);
        while (token.kind != TokenKind::End) {
            if (token.kind == TokenKind::Identifier && token.length == name_length) {
                bool spelling = true; i64 j = 0;
                while (j < name_length) {
                    if (raz_compiler_rt_arena_get(document_text, token.offset + j) != raz_compiler_rt_arena_get(text, name_offset + j)) { spelling = false; break; }
                    j += 1;
                }
                bool matches = false;
                if (spelling && valid) { matches = lsp_occurrence_matches_target(&mut hir, document_text, document_length, token.offset, token.length, &mut target); }
                else if (spelling && !valid && !target.local) { matches = true; }
                if (matches) {
                    if (!first_edit) { lsp_writer_byte(&mut edits, 44); }
                    first_edit = false;
                    i64 range_key[9] = [123,34,114,97,110,103,101,34,58];
                    lsp_writer_literal(&mut edits, &range_key, 9);
                    lsp_writer_range(&mut edits, document_text, document_length, token.offset, token.offset + token.length);
                    i64 new_key[11] = [44,34,110,101,119,84,101,120,116,34,58];
                    lsp_writer_literal(&mut edits, &new_key, 11);
                    lsp_writer_json_string(&mut edits, replacement, 0, replacement_length);
                    lsp_writer_byte(&mut edits, 125);
                }
            }
            next_token(&mut scan, &mut token);
        }
        if (valid || hir.diagnostic_code != DiagnosticCode::None) { destroy_hir(&mut hir); }
        if (!first_edit) {
