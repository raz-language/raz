        ok = lsp_send(&mut out);
    }
    lsp_writer_destroy(&mut out);
    return ok;
}

fn lsp_send_code_actions(i64 body, i64 length, i64 uri, i64 uri_length, i64 text, i64 text_length) -> bool {
    i64 capacity = text_length * 2 + 4096;
    i64 formatted = raz_compiler_rt_arena_create(capacity);
    if (formatted == 0) { return false; }
    i64 formatted_length = tooling_format_source(text, text_length, formatted, capacity);
    LspWriter out;
    if (!lsp_writer_init(&mut out, formatted_length + 2048)) { raz_compiler_rt_arena_destroy(formatted); return false; }
    bool ok = lsp_response_result_prefix(&mut out, body, length) && lsp_writer_byte(&mut out, 91);
    bool first = true;

    // The parser reports ExpectedToken at the token following a missing
    // terminator.  When the previous source line has content and does not
    // already end in a structural delimiter, offer the precise semicolon edit.
    Source source; source.bytes = text; source.length = text_length; HirModule hir;
    bool valid = build_hir(source, &mut hir);
    if (!valid && hir.diagnostic_code == DiagnosticCode::ExpectedToken) {
        i64 line_start = hir.diagnostic_offset;
        while (line_start > 0 && raz_compiler_rt_arena_get(text, line_start - 1) != 10) { line_start -= 1; }
        i64 insert = line_start;
        if (insert > 0) { insert -= 1; }
        while (insert > 0) {
            i64 byte = raz_compiler_rt_arena_get(text, insert - 1);
            if (byte != 32 && byte != 9 && byte != 13) { break; }
            insert -= 1;
        }
        if (insert > 0) {
            i64 previous = raz_compiler_rt_arena_get(text, insert - 1);
            if (previous != 59 && previous != 123 && previous != 125 && previous != 44) {
                i64 title[73] = [123,34,116,105,116,108,101,34,58,34,73,110,115,101,114,116,32,109,105,115,115,105,110,103,32,115,101,109,105,99,111,108,111,110,34,44,34,107,105,110,100,34,58,34,113,117,105,99,107,102,105,120,34,44,34,101,100,105,116,34,58,123,34,99,104,97,110,103,101,115,34,58,123];
                ok = ok && lsp_writer_literal(&mut out, &title, 73) && lsp_writer_json_string(&mut out, uri, 0, uri_length) && lsp_writer_byte(&mut out, 58) && lsp_writer_byte(&mut out, 91);
                i64 range_key[9] = [123,34,114,97,110,103,101,34,58];
                ok = ok && lsp_writer_literal(&mut out, &range_key, 9) && lsp_writer_range(&mut out, text, text_length, insert, insert);
                i64 replacement[13] = [44,34,110,101,119,84,101,120,116,34,58,34,59];
                ok = ok && lsp_writer_literal(&mut out, &replacement, 13);
                i64 close[6] = [34,125,93,125,125,125];
                ok = ok && lsp_writer_literal(&mut out, &close, 6);
                first = false;
            }
        }
    }
    if (valid || hir.diagnostic_code != DiagnosticCode::None) { destroy_hir(&mut hir); }

    bool changed = formatted_length >= 0 && !lsp_arena_equal(text, text_length, formatted, formatted_length);
    if (changed) {
        if (!first) { ok = ok && lsp_writer_byte(&mut out, 44); }
        i64 a[77] = [123,34,116,105,116,108,101,34,58,34,70,111,114,109,97,116,32,82,97,122,32,100,111,99,117,109,101,110,116,34,44,34,107,105,110,100,34,58,34,115,111,117,114,99,101,46,102,105,120,65,108,108,46,114,97,122,34,44,34,101,100,105,116,34,58,123,34,99,104,97,110,103,101,115,34,58,123];
        ok = ok && lsp_writer_literal(&mut out, &a, 76) && lsp_writer_json_string(&mut out, uri, 0, uri_length);
        i64 b[51] = [58,91,123,34,114,97,110,103,101,34,58,123,34,115,116,97,114,116,34,58,123,34,108,105,110,101,34,58,48,44,34,99,104,97,114,97,99,116,101,114,34,58,48,125,44,34,101,110,100,34,58];
        ok = ok && lsp_writer_literal(&mut out, &b, 51);
        i64 end[32] = [123,34,108,105,110,101,34,58,50,49,52,55,52,56,51,54,52,55,44,34,99,104,97,114,97,99,116,101,114,34,58,48];
        ok = ok && lsp_writer_literal(&mut out, &end, 32);
        i64 c[13] = [125,125,44,34,110,101,119,84,101,120,116,34,58];
        ok = ok && lsp_writer_literal(&mut out, &c, 13) && lsp_writer_json_string(&mut out, formatted, 0, formatted_length);
        i64 d[7] = [125,93,125,125,125,125,125];
        ok = ok && lsp_writer_literal(&mut out, &d, 7);
    }
    ok = ok && lsp_writer_byte(&mut out, 93) && lsp_writer_byte(&mut out, 125);
    if (ok) { ok = lsp_send(&mut out); }
    lsp_writer_destroy(&mut out); raz_compiler_rt_arena_destroy(formatted); return ok;
}

fn lsp_method_equals(i64 method, i64 method_length, i64[]value, i64 value_length) -> bool {
    return lsp_ascii_equal(method, 0, method_length, value, value_length);
}

fn lsp_command(i64 argc) -> i64 {
    if (argc != 2) {
        cli_print_invalid_arguments();
        return 2;
    }

    // LSP is a byte protocol.  Windows CRT text mode would otherwise expand
    // the explicit CRLF header bytes emitted by lsp_send() into CRCRLF.
    // Set both protocol streams to binary before reading or writing a frame.
    if (raz_rt_stdio_set_binary(0) <= 0 || raz_rt_stdio_set_binary(1) <= 0) {
        return 40;
    }

    LspInput input;
    LspDocuments documents;

    if (!lsp_input_init(&mut input) || !lsp_documents_init(&mut documents)) {
        return 40;
    }

    bool shutdown = false;
    bool running = true;

    while (running) {
        i64 body = 0;
        i64 body_length = 0;

        if (!lsp_read_message(&mut input, &mut body, &mut body_length)) {
            break;
        }

        i64 method = raz_compiler_rt_arena_create(128);
        i64 uri = raz_compiler_rt_arena_create(8192);
        i64 text = raz_compiler_rt_arena_create(body_length + 1);
        i64 method_key[6] = [109, 101, 116, 104, 111, 100];
        i64 uri_key[3] = [117, 114, 105];
        i64 text_key[4] = [116, 101, 120, 116];
        i64 method_length = lsp_json_string_field(body, body_length, &method_key, 6, method, 128, 0);
        i64 uri_length = lsp_json_string_field(body, body_length, &uri_key, 3, uri, 8192, 0);
        i64 text_length = lsp_json_string_field(body, body_length, &text_key, 4, text, body_length + 1, 0);
        i64 initialize[10] = [105, 110, 105, 116, 105, 97, 108, 105, 122, 101];
        i64 did_open[20] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 100, 105, 100, 79, 112, 101, 110];
        i64 did_change[22] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 100, 105, 100, 67, 104, 97, 110, 103, 101];
        i64 did_close[21] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 100, 105, 100, 67, 108, 111, 115, 101];
        i64 formatting[23] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 102, 111, 114, 109, 97, 116, 116, 105, 110, 103];
        i64 completion[23] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 99, 111, 109, 112, 108, 101, 116, 105, 111, 110];
        i64 symbols[27] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 100, 111, 99, 117, 109, 101, 110, 116, 83, 121, 109, 98, 111, 108];
        i64 actions[23] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 99, 111, 100, 101, 65, 99, 116, 105, 111, 110];
        i64 folding[25] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 102, 111, 108, 100, 105, 110, 103, 82, 97, 110, 103, 101];
        i64 selection[27] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 115, 101, 108, 101, 99, 116, 105, 111, 110, 82, 97, 110, 103, 101];
        i64 hover[18] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 104, 111, 118, 101, 114];
        i64 definition[23] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 100, 101, 102, 105, 110, 105, 116, 105, 111, 110];
        i64 references[23] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 114, 101, 102, 101, 114, 101, 110, 99, 101, 115];
        i64 rename[19] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 114, 101, 110, 97, 109, 101];
        i64 signature[26] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 115, 105, 103, 110, 97, 116, 117, 114, 101, 72, 101, 108, 112];
        i64 semantic[32] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 115, 101, 109, 97, 110, 116, 105, 99, 84, 111, 107, 101, 110, 115, 47, 102, 117, 108, 108];
        i64 inlay[22] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 105, 110, 108, 97, 121, 72, 105, 110, 116];
        i64 highlight[30] = [116, 101, 120, 116, 68, 111, 99, 117, 109, 101, 110, 116, 47, 100, 111, 99, 117, 109, 101, 110, 116, 72, 105, 103, 104, 108, 105, 103, 104, 116];
        i64 workspace[16] = [119, 111, 114, 107, 115, 112, 97, 99, 101, 47, 115, 121, 109, 98, 111, 108];
        i64 shutdown_word[8] = [115, 104, 117, 116, 100, 111, 119, 110];
        i64 exit_word[4] = [101, 120, 105, 116];

        if (method_length >= 0 && lsp_method_equals(method, method_length, &initialize, 10)) {
            // Index unopened workspace modules before the editor begins sending
            // overlays.  `rootUri` is the canonical modern LSP project root.
            i64 root_uri = raz_compiler_rt_arena_create(8192);
            i64 root_key[7] = [114, 111, 111, 116, 85, 114, 105];
            i64 root_uri_length = -1;
            if (root_uri != 0) { root_uri_length = lsp_json_string_field(body, body_length, &root_key, 7, root_uri, 8192, 0); }
            if (root_uri_length > 0) { lsp_workspace_load(&mut documents, root_uri, root_uri_length); }
            if (root_uri != 0) { raz_compiler_rt_arena_destroy(root_uri); }
            lsp_send_initialize(body, body_length);
        } else if (
        method_length >= 0 &&
        (
        lsp_method_equals(method, method_length, &did_open, 20) ||
        lsp_method_equals(method, method_length, &did_change, 22)
        )
        ) {
            if (uri_length >= 0 && text_length >= 0) {
                i64 index = lsp_document_set(&mut documents, uri, uri_length, text, text_length);

                if (index >= 0) {
                    lsp_publish_diagnostics(
                    raz_compiler_rt_arena_get(documents.uris, index),
                    raz_compiler_rt_arena_get(documents.uri_lengths, index),
                    raz_compiler_rt_arena_get(documents.texts, index),
                    raz_compiler_rt_arena_get(documents.text_lengths, index),
                    );
                }
            }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &did_close, 21)) {
            if (uri_length >= 0) {
                lsp_clear_diagnostics(uri, uri_length);
                // Closing an editor overlay must not remove the module from the
                // project index. Restore its saved bytes; only non-file/removed
                // documents disappear from the workspace.
                if (!lsp_document_restore_disk(&mut documents, uri, uri_length)) {
                    lsp_document_remove(&mut documents, uri, uri_length);
                }
            }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &formatting, 23)) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_formatting(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &completion, 23)) {
            i64 index = -1;
            if (uri_length >= 0) { index = lsp_document_find(&documents, uri, uri_length); }
            if (index >= 0) { lsp_send_completion(&documents, body, body_length, index); }
            else { lsp_send_null_result(body, body_length); }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &hover, 18)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_hover(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &definition, 23)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_definition(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &references, 23)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_references(&documents,body,body_length,index,false);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &rename, 19)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_rename(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &signature, 26)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_signature_help(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &semantic, 32)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_semantic_tokens(body,body_length,raz_compiler_rt_arena_get(documents.texts,index),raz_compiler_rt_arena_get(documents.text_lengths,index));}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &inlay, 22)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_inlay_hints(body,body_length,raz_compiler_rt_arena_get(documents.texts,index),raz_compiler_rt_arena_get(documents.text_lengths,index));}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &highlight, 30)) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_references(&documents,body,body_length,index,true);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &workspace, 16)) {
            lsp_send_workspace_symbols(&documents,body,body_length);
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &symbols, 27)) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_document_symbols(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &actions, 23)) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_code_actions(
                body,
                body_length,
                uri,
                uri_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &folding, 25)) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_folding(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &selection, 27)) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_selection(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &shutdown_word, 8)) {
            shutdown = true;
            lsp_send_null_result(body, body_length);
        } else if (method_length >= 0 && lsp_method_equals(method, method_length, &exit_word, 4)) {
            running = false;
        } else {
            i64 id_key[2] = [105, 100];

            if (lsp_json_find_key(body, body_length, &id_key, 2, 0) >= 0) {
                LspWriter error;

                if (lsp_writer_init(&mut error, 256)) {
                    lsp_response_begin(&mut error, body, body_length);

                    i64 e[60] = [44, 34, 101, 114, 114, 111, 114, 34, 58, 123, 34, 99, 111, 100, 101, 34, 58, 45, 51, 50, 54, 48, 49, 44, 34, 109, 101, 115, 115, 97, 103, 101, 34, 58, 34, 109, 101, 116, 104, 111, 100, 32, 110, 111, 116, 32, 105, 109, 112, 108, 101, 109, 101, 110, 116, 101, 100, 34, 125, 125];

                    lsp_writer_literal(&mut error, &e, 60);
                    lsp_send(&mut error);
                    lsp_writer_destroy(&mut error);
                }
            }
        }
        raz_compiler_rt_arena_destroy(method);
        raz_compiler_rt_arena_destroy(uri);
        raz_compiler_rt_arena_destroy(text);
        raz_compiler_rt_arena_destroy(body);
    }
    lsp_documents_destroy(&mut documents);
    lsp_input_destroy(&mut input);
    if (shutdown) {
        return 0;
    }
    return 1;
}
