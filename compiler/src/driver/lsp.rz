fn lsp_symbol_kind(Source& source, Token& token) -> i64 {
    if (token_is_namespace(source, token)) {
        return 3;
    }
    if (token_is_enum(source, token)) {
        return 10;
    }
    if (token_is_trait(source, token)) {
        return 11;
    }
    if (token_is_fn(source, token)) {
        return 12;
    }
    if (token_is_const(source, token)) {
        return 14;
    }
    if (token_is_struct(source, token)) {
        return 23;
    }
    if (token_is_static(source, token)) {
        return 13;
    }
    return 0;
}

fn lsp_document_identifier_start(i64 byte) -> bool {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95;
}

fn lsp_document_identifier_continue(i64 byte) -> bool {
    return lsp_document_identifier_start(byte) || (byte >= 48 && byte <= 57);
}

fn lsp_document_keyword(i64 text, i64 length, i64 offset, string keyword) -> bool {
    i64 keyword_length = compiler_literal_length(keyword);
    if (offset < 0 || offset + keyword_length > length) { return false; }
    i64 i = 0;
    while (i < keyword_length) {
        if (raz_compiler_rt_arena_get(text, offset + i) != compiler_literal_byte(keyword, i)) { return false; }
        i += 1;
    }
    if (offset > 0 && lsp_document_identifier_continue(raz_compiler_rt_arena_get(text, offset - 1))) { return false; }
    if (offset + keyword_length < length && lsp_document_identifier_continue(raz_compiler_rt_arena_get(text, offset + keyword_length))) { return false; }
    return true;
}

fn lsp_document_skip_horizontal_space(i64 text, i64 length, i64 offset) -> i64 {
    while (offset < length) {
        i64 byte = raz_compiler_rt_arena_get(text, offset);
        if (byte != 32 && byte != 9) { break; }
        offset += 1;
    }
    return offset;
}

fn lsp_document_declaration(i64 text, i64 length, i64 line_start, i64&mut name_offset, i64&mut name_length) -> i64 {
    i64 cursor = lsp_document_skip_horizontal_space(text, length, line_start);
    if (cursor >= length) { return 0; }
    if (lsp_document_keyword(text, length, cursor, "public")) {
        cursor = lsp_document_skip_horizontal_space(text, length, cursor + 6);
    }
    if (lsp_document_keyword(text, length, cursor, "async")) {
        cursor = lsp_document_skip_horizontal_space(text, length, cursor + 5);
    } else if (lsp_document_keyword(text, length, cursor, "unsafe")) {
        cursor = lsp_document_skip_horizontal_space(text, length, cursor + 6);
    }

    i64 kind = 0;
    i64 keyword_length = 0;
    if (lsp_document_keyword(text, length, cursor, "fn")) { kind = 12; keyword_length = 2; }
    else if (lsp_document_keyword(text, length, cursor, "namespace")) { kind = 3; keyword_length = 9; }
    else if (lsp_document_keyword(text, length, cursor, "enum")) { kind = 10; keyword_length = 4; }
    else if (lsp_document_keyword(text, length, cursor, "trait")) { kind = 11; keyword_length = 5; }
    else if (lsp_document_keyword(text, length, cursor, "const")) { kind = 14; keyword_length = 5; }
    else if (lsp_document_keyword(text, length, cursor, "struct")) { kind = 23; keyword_length = 6; }
    else if (lsp_document_keyword(text, length, cursor, "static")) { kind = 13; keyword_length = 6; }
    if (kind == 0) { return 0; }

    cursor = lsp_document_skip_horizontal_space(text, length, cursor + keyword_length);
    if (cursor >= length || !lsp_document_identifier_start(raz_compiler_rt_arena_get(text, cursor))) { return 0; }
    *name_offset = cursor;
    while (cursor < length && lsp_document_identifier_continue(raz_compiler_rt_arena_get(text, cursor))) { cursor += 1; }
    *name_length = cursor - *name_offset;
    return kind;
}

fn lsp_send_document_symbols(i64 body, i64 length, i64 text, i64 text_length) -> bool {
    LspWriter out;
    if (!lsp_writer_init(&mut out, 4096)) { return false; }
    bool ok = lsp_response_result_prefix(&mut out, body, length) && lsp_writer_byte(&mut out, 91);
    bool first = true;
    i64 line_start = 0;
    while (ok && line_start < text_length) {
        i64 name_offset = 0;
        i64 name_length = 0;
        i64 kind = lsp_document_declaration(text, text_length, line_start, &mut name_offset, &mut name_length);
        if (kind > 0 && name_length > 0) {
            if (!first) { ok = lsp_writer_byte(&mut out, 44); }
            first = false;
            ok = ok && lsp_writer_string_literal(&mut out, "{\"name\":");
            ok = ok && lsp_writer_json_string(&mut out, text, name_offset, name_length);
            ok = ok && lsp_writer_string_literal(&mut out, ",\"kind\":") && lsp_writer_decimal(&mut out, kind);
            ok = ok && lsp_writer_string_literal(&mut out, ",\"range\":") && lsp_writer_range(&mut out, text, text_length, name_offset, name_offset + name_length);
            ok = ok && lsp_writer_string_literal(&mut out, ",\"selectionRange\":") && lsp_writer_range(&mut out, text, text_length, name_offset, name_offset + name_length) && lsp_writer_byte(&mut out, 125);
        }
        while (line_start < text_length && raz_compiler_rt_arena_get(text, line_start) != 10) { line_start += 1; }
        if (line_start < text_length) { line_start += 1; }
    }
    ok = ok && lsp_writer_byte(&mut out, 93) && lsp_writer_byte(&mut out, 125);
    if (ok) { ok = lsp_send(&mut out); }
    lsp_writer_destroy(&mut out);
    return ok;
}

fn lsp_send_formatting(i64 body, i64 length, i64 text, i64 text_length) -> bool {
    i64 capacity = text_length * 2 + 4096;
    i64 formatted = raz_compiler_rt_arena_create(capacity);

    if (formatted == 0) {
        return false;
    }

    i64 formatted_length = tooling_format_source(text, text_length, formatted, capacity);

    if (formatted_length < 0) {
        raz_compiler_rt_arena_destroy(formatted);
        return lsp_send_null_result(body, length);
    }

    LspWriter out;

    if (!lsp_writer_init(&mut out, formatted_length + 512)) {
        raz_compiler_rt_arena_destroy(formatted);
        return false;
    }

    bool ok = lsp_response_result_prefix(&mut out, body, length);
        ok = ok && lsp_writer_string_literal(&mut out, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":");

        ok = ok && lsp_writer_string_literal(&mut out, "{\"line\":2147483647,\"character\":0");

        ok =
    ok &&
    lsp_writer_string_literal(&mut out, "}},\"newText\":") &&
    lsp_writer_json_string(&mut out, formatted, 0, formatted_length);
        ok = ok && lsp_writer_string_literal(&mut out, "}]}");
    if (ok) {
        ok = lsp_send(&mut out);
    }
    lsp_writer_destroy(&mut out);
    raz_compiler_rt_arena_destroy(formatted);
    return ok;
}

fn lsp_send_folding(i64 body, i64 length, i64 text, i64 text_length) -> bool {
    LspWriter out;

    if (!lsp_writer_init(&mut out, 4096)) {
        return false;
    }

    bool ok = lsp_response_result_prefix(&mut out, body, length) && lsp_writer_byte(&mut out, 91);
    i64 stack = raz_compiler_rt_arena_create(1024);
    i64 depth = 0;
    i64 line = 0;
    bool first = true;
    i64 i = 0;

    while (ok && i < text_length) {
        i64 byte = raz_compiler_rt_arena_get(text, i);

        if (byte == 10) {
            line += 1;
        } else if (byte == 123 && depth < 1024) {
            raz_compiler_rt_arena_set(stack, depth, line);
            depth += 1;
        } else if (byte == 125 && depth > 0) {
            depth -= 1;

            i64 start_line = raz_compiler_rt_arena_get(stack, depth);

            if (line > start_line) {
                if (!first) {
                    ok = lsp_writer_byte(&mut out, 44);
                }
                first = false;

                string a = "{\"startLine\": ";
                string b = ",\"endLine\": ";
                                ok = ok && lsp_writer_string_prefix(&mut out, a, 13) && lsp_writer_decimal(&mut out, start_line);
                ok = ok && lsp_writer_string_prefix(&mut out, b, 11) && lsp_writer_decimal(&mut out, line);
                ok = ok && lsp_writer_string_literal(&mut out, ",\"kind\":\"region\"}");
            }
        }
        i += 1;
    }
    raz_compiler_rt_arena_destroy(stack);
    ok = ok && lsp_writer_byte(&mut out, 93) && lsp_writer_byte(&mut out, 125);
    if (ok) {
        ok = lsp_send(&mut out);
    }
    lsp_writer_destroy(&mut out);
    return ok;
}

fn lsp_send_selection(i64 body, i64 length, i64 text, i64 text_length) -> bool {
    LspWriter out;

    if (!lsp_writer_init(&mut out, 256)) {
        return false;
    }

    bool ok = lsp_response_result_prefix(&mut out, body, length);
        ok =
    ok &&
    lsp_writer_string_literal(&mut out, "[{\"range\":") &&
    lsp_writer_range(&mut out, text, text_length, 0, text_length);
        ok = ok && lsp_writer_string_literal(&mut out, "}]") && lsp_writer_byte(&mut out, 125);
    if (ok) {
        ok = lsp_send(&mut out);
    }
    lsp_writer_destroy(&mut out);
    return ok;
}

fn lsp_send_code_actions(i64 body, i64 length, i64 uri, i64 uri_length, i64 text, i64 text_length) -> bool {
    i64 capacity = text_length * 2 + 4096;
    i64 formatted = raz_compiler_rt_arena_create(capacity);
    if (formatted == 0) { return false; }
    i64 formatted_length = tooling_format_source(text, text_length, formatted, capacity);
    LspWriter out;
    if (!lsp_writer_init(&mut out, formatted_length + 2048)) { raz_compiler_rt_arena_destroy(formatted); return false; }
    bool ok = lsp_response_result_prefix(&mut out, body, length) && lsp_writer_byte(&mut out, 91);
    bool first = true;

    // The parser reports ExpectedToken at the token following a missing
    // terminator.  When the previous source line has content and does not
    // already end in a structural delimiter, offer the precise semicolon edit.
    Source source; source.bytes = text; source.length = text_length; HirModule hir;
    bool valid = build_hir(source, &mut hir);
    if (!valid && hir.diagnostic_code == DiagnosticCode::ExpectedToken) {
        i64 line_start = hir.diagnostic_offset;
        while (line_start > 0 && raz_compiler_rt_arena_get(text, line_start - 1) != 10) { line_start -= 1; }
        i64 insert = line_start;
        if (insert > 0) { insert -= 1; }
        while (insert > 0) {
            i64 byte = raz_compiler_rt_arena_get(text, insert - 1);
            if (byte != 32 && byte != 9 && byte != 13) { break; }
            insert -= 1;
        }
        if (insert > 0) {
            i64 previous = raz_compiler_rt_arena_get(text, insert - 1);
            if (previous != 59 && previous != 123 && previous != 125 && previous != 44) {
                                ok = ok && lsp_writer_string_literal(&mut out, "{\"title\":\"Insert missing semicolon\",\"kind\":\"quickfix\",\"edit\":{\"changes\":{") && lsp_writer_json_string(&mut out, uri, 0, uri_length) && lsp_writer_byte(&mut out, 58) && lsp_writer_byte(&mut out, 91);
                                ok = ok && lsp_writer_string_literal(&mut out, "{\"range\":") && lsp_writer_range(&mut out, text, text_length, insert, insert);
                                ok = ok && lsp_writer_string_literal(&mut out, ",\"newText\":\";");
                                ok = ok && lsp_writer_string_literal(&mut out, "\"}]}}}");
                first = false;
            }
        }
    }
    if (valid || hir.diagnostic_code != DiagnosticCode::None) { destroy_hir(&mut hir); }

    bool changed = formatted_length >= 0 && !lsp_arena_equal(text, text_length, formatted, formatted_length);
    if (changed) {
        if (!first) { ok = ok && lsp_writer_byte(&mut out, 44); }
        string a = "{\"title\":\"Format Raz document\",\"kind\":\"source.fixAll.raz\",\"edit\":{\"changes\":{";
        ok = ok && lsp_writer_string_prefix(&mut out, a, 76) && lsp_writer_json_string(&mut out, uri, 0, uri_length);
                ok = ok && lsp_writer_string_literal(&mut out, ":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":");
                ok = ok && lsp_writer_string_literal(&mut out, "{\"line\":2147483647,\"character\":0");
                ok = ok && lsp_writer_string_literal(&mut out, "}},\"newText\":") && lsp_writer_json_string(&mut out, formatted, 0, formatted_length);
                ok = ok && lsp_writer_string_literal(&mut out, "}]}}}}}");
    }
    ok = ok && lsp_writer_byte(&mut out, 93) && lsp_writer_byte(&mut out, 125);
    if (ok) { ok = lsp_send(&mut out); }
    lsp_writer_destroy(&mut out); raz_compiler_rt_arena_destroy(formatted); return ok;
}

fn lsp_method_equals_literal(i64 method, i64 method_length, string value) -> bool {
    i64 value_length = compiler_literal_length(value);
    if (method_length != value_length) { return false; }
    i64 i = 0;
    while (i < value_length) {
        if (raz_compiler_rt_arena_get(method, i) != compiler_literal_byte(value, i)) { return false; }
        i += 1;
    }
    return true;
}

fn lsp_method_equals(i64 method, i64 method_length, i64[]value, i64 value_length) -> bool {
    return lsp_ascii_equal(method, 0, method_length, value, value_length);
}

fn lsp_command(i64 argc) -> i64 {
    if (argc != 2) {
        cli_print_invalid_arguments();
        return 2;
    }

    // LSP is a byte protocol.  Windows CRT text mode would otherwise expand
    // the explicit CRLF header bytes emitted by lsp_send() into CRCRLF.
    // Set both protocol streams to binary before reading or writing a frame.
    if (raz_rt_stdio_set_binary(0) <= 0 || raz_rt_stdio_set_binary(1) <= 0) {
        return 40;
    }

    LspInput input;
    LspDocuments documents;

    if (!lsp_input_init(&mut input) || !lsp_documents_init(&mut documents)) {
        return 40;
    }

    bool shutdown = false;
    bool running = true;

    while (running) {
        i64 body = 0;
        i64 body_length = 0;

        if (!lsp_read_message(&mut input, &mut body, &mut body_length)) {
            break;
        }

        i64 method = raz_compiler_rt_arena_create(128);
        i64 uri = raz_compiler_rt_arena_create(8192);
        i64 text = raz_compiler_rt_arena_create(body_length + 1);
                                i64 method_length = lsp_json_string_field_literal(body, body_length, "method", method, 128, 0);
        i64 uri_length = lsp_json_string_field_literal(body, body_length, "uri", uri, 8192, 0);
        i64 text_length = lsp_json_string_field_literal(body, body_length, "text", text, body_length + 1, 0);
                                                                                                                                                        string workspace = "workspace/symbol";
                        if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "initialize")) {
            // Index unopened workspace modules before the editor begins sending
            // overlays.  `rootUri` is the canonical modern LSP project root.
            i64 root_uri = raz_compiler_rt_arena_create(8192);
                        i64 root_uri_length = -1;
            if (root_uri != 0) { root_uri_length = lsp_json_string_field_literal(body, body_length, "rootUri", root_uri, 8192, 0); }
            if (root_uri_length > 0) { lsp_workspace_load(&mut documents, root_uri, root_uri_length); }
            if (root_uri != 0) { raz_compiler_rt_arena_destroy(root_uri); }
            lsp_send_initialize(body, body_length);
        } else if (
        method_length >= 0 &&
        (
        lsp_method_equals_literal(method, method_length, "textDocument/didOpen") ||
        lsp_method_equals_literal(method, method_length, "textDocument/didChange")
        )
        ) {
            if (uri_length >= 0 && text_length >= 0) {
                i64 index = lsp_document_set(&mut documents, uri, uri_length, text, text_length);

                if (index >= 0) {
                    lsp_analyze_document_and_publish(&mut documents, index);
                }
            }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/didClose")) {
            if (uri_length >= 0) {
                lsp_clear_diagnostics(uri, uri_length);
                // Closing an editor overlay must not remove the module from the
                // project index. Restore its saved bytes; only non-file/removed
                // documents disappear from the workspace.
                if (!lsp_document_restore_disk(&mut documents, uri, uri_length)) {
                    lsp_document_remove(&mut documents, uri, uri_length);
                }
            }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/formatting")) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_formatting(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/completion")) {
            i64 index = -1;
            if (uri_length >= 0) { index = lsp_document_find(&documents, uri, uri_length); }
            if (index >= 0) { lsp_send_completion(&documents, body, body_length, index); }
            else { lsp_send_null_result(body, body_length); }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/hover")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_hover(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/definition")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_definition(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/references")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_references(&documents,body,body_length,index,false);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/rename")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_rename(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/signatureHelp")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_signature_help(&documents,body,body_length,index);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/semanticTokens/full")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_semantic_tokens(body,body_length,raz_compiler_rt_arena_get(documents.texts,index),raz_compiler_rt_arena_get(documents.text_lengths,index));}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/inlayHint")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_inlay_hints(body,body_length,raz_compiler_rt_arena_get(documents.texts,index),raz_compiler_rt_arena_get(documents.text_lengths,index));}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/documentHighlight")) {
            i64 index=-1; if(uri_length>=0){index=lsp_document_find(&documents,uri,uri_length);} if(index>=0){lsp_send_references(&documents,body,body_length,index,true);}else{lsp_send_null_result(body,body_length);}
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, workspace)) {
            lsp_send_workspace_symbols(&documents,body,body_length);
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/documentSymbol")) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_document_symbols(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/codeAction")) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_code_actions(
                body,
                body_length,
                uri,
                uri_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/foldingRange")) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_folding(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "textDocument/selectionRange")) {
            i64 index = -1;

            if (uri_length >= 0) {
                index = lsp_document_find(&documents, uri, uri_length);
            }
            if (index >= 0) {
                lsp_send_selection(
                body,
                body_length,
                raz_compiler_rt_arena_get(documents.texts, index),
                raz_compiler_rt_arena_get(documents.text_lengths, index),
                );
            } else {
                lsp_send_null_result(body, body_length);
            }
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "shutdown")) {
            shutdown = true;
            lsp_send_null_result(body, body_length);
        } else if (method_length >= 0 && lsp_method_equals_literal(method, method_length, "exit")) {
            running = false;
        } else {
                        if (lsp_json_find_key_literal(body, body_length, "id", 0) >= 0) {
                LspWriter error;

                if (lsp_writer_init(&mut error, 256)) {
                    lsp_response_begin(&mut error, body, body_length);

                                        lsp_writer_string_literal(&mut error, ",\"error\":{\"code\":-32601,\"message\":\"method not implemented\"}}");
                    lsp_send(&mut error);
                    lsp_writer_destroy(&mut error);
                }
            }
        }
        raz_compiler_rt_arena_destroy(method);
        raz_compiler_rt_arena_destroy(uri);
        raz_compiler_rt_arena_destroy(text);
        raz_compiler_rt_arena_destroy(body);
    }
    lsp_documents_destroy(&mut documents);
    lsp_input_destroy(&mut input);
    if (shutdown) {
        return 0;
    }
    return 1;
}
