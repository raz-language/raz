fn lsp_symbol_kind(Source& source, Token& token) -> i64 {
    if (token_is_namespace(source, token)) {
        return 3;
    }
    if (token_is_enum(source, token)) {
        return 10;
    }
    if (token_is_trait(source, token)) {
        return 11;
    }
    if (token_is_fn(source, token)) {
        return 12;
    }
    if (token_is_const(source, token)) {
        return 14;
    }
    if (token_is_struct(source, token)) {
        return 23;
    }
    if (token_is_static(source, token)) {
        return 13;
    }
    return 0;
}

fn lsp_send_document_symbols(i64 body, i64 length, i64 text, i64 text_length) -> bool {
    LspWriter out;

    if (!lsp_writer_init(&mut out, 4096)) {
