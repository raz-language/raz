namespace raz_compiler_driver_incremental;
public import raz_compiler_driver_host_support;
// Persistent incremental-build state is deliberately conservative. Exact
// whole-source/backend matches may reuse a completed backend artifact. Module
// source/interface fingerprints are persisted independently so later frontend
// work can make HIR/MIR reuse module-granular without changing this format.
fn incremental_cache_schema() -> i64 {
  return 1;
}

fn incremental_path_dirname(i64 path, i64 length, i64 output, i64 capacity) -> i64 {
  if (path == 0 || output == 0 || length <= 0 || capacity <= 0) {
    return -1;
  }

  i64 end = length;

  while (
  end > 0 &&
  raz_compiler_rt_arena_get(path, end - 1) != 47 &&
  raz_compiler_rt_arena_get(path, end - 1) != 92
  ) {
    end -= 1;
  }
  if (end == 0) {
    raz_compiler_rt_arena_set(output, 0, 46);
    return 1;
  }

  i64 count = end - 1;

  if (count <= 0) {
    count = 1;
  }
  if (count > capacity) {
    return -1;
  }

  i64 index = 0;

  while (index < count) {
    raz_compiler_rt_arena_set(output, index, raz_compiler_rt_arena_get(path, index));
    index += 1;
  }
  return count;
}

fn incremental_append_ascii(i64 output, i64&mut cursor, i64 capacity, i64[]text, i64 length) -> bool {
  if (*cursor + length > capacity) {
    return false;
  }

  i64 index = 0;

  while (index < length) {
    raz_compiler_rt_arena_set(output, *cursor, text[index]);
    *cursor += 1;
    index += 1;
  }
  return true;
}

fn incremental_cache_path(
i64 manifest_path,
i64 manifest_length,
i64 leaf_kind,
i64 output,
i64 capacity,
) -> i64 {
  i64 cursor = incremental_path_dirname(manifest_path, manifest_length, output, capacity);

  if (cursor <= 0) {
    return -1;
  }

  i64 suffix[11] = [47, 46, 114, 97, 122, 47, 99, 97, 99, 104, 101];

  if (!incremental_append_ascii(output, &mut cursor, capacity, &suffix, 11)) {
    return -1;
  }
  if (leaf_kind == 0) {
    i64 leaf[10] = [47, 98, 117, 105, 108, 100, 46, 107, 101, 121];

    if (!incremental_append_ascii(output, &mut cursor, capacity, &leaf, 10)) {
      return -1;
    }
  } else if (leaf_kind == 1) {
    i64 leaf[13] = [47, 97, 114, 116, 105, 102, 97, 99, 116, 46, 98, 105, 110];

    if (!incremental_append_ascii(output, &mut cursor, capacity, &leaf, 13)) {
      return -1;
    }
  } else if (leaf_kind == 2) {
    i64 leaf[12] = [47, 109, 111, 100, 117, 108, 101, 115, 46, 100, 98, 103];

    if (!incremental_append_ascii(output, &mut cursor, capacity, &leaf, 12)) {
      return -1;
    }
  } else {
    i64 leaf[10] = [47, 109, 105, 114, 46, 115, 116, 97, 116, 101];

    if (!incremental_append_ascii(output, &mut cursor, capacity, &leaf, 10)) {
      return -1;
    }
  }
  return cursor;
}

fn incremental_cache_dir(i64 manifest_path, i64 manifest_length, i64 output, i64 capacity) -> i64 {
  i64 length = incremental_path_dirname(manifest_path, manifest_length, output, capacity);

  if (length <= 0) {
    return -1;
  }

  i64 suffix[11] = [47, 46, 114, 97, 122, 47, 99, 97, 99, 104, 101];

  if (!incremental_append_ascii(output, &mut length, capacity, &suffix, 11)) {
    return -1;
  }
  return length;
}

fn incremental_mix(i64 value, i64 next) -> i64 {
  i64 mixed = (value * 131 + next + 4099) % 281474976710597;

  if (mixed < 0) {
    mixed = 0 - mixed;
  }
  return mixed;
}

fn incremental_build_key(
Source& source,
i64 backend,
i64 llvm_emit_kind,
bool forge_native,
bool forge_structured_only,
) -> i64 {
  i64 key = raz_compiler_rt_arena_range_hash(source.bytes, 0, source.length, 146959810393466);

  key = incremental_mix(key, incremental_cache_schema());
  key = incremental_mix(key, backend);
  key = incremental_mix(key, llvm_emit_kind);
  if (forge_native) {
    key = incremental_mix(key, 1);
  } else {
    key = incremental_mix(key, 0);
  }
  if (forge_structured_only) {
    key = incremental_mix(key, 1);
  } else {
    key = incremental_mix(key, 0);
  }
  return key;
}

fn incremental_parse_decimal(i64 data, i64 length) -> i64 {
  if (data == 0 || length <= 0) {
    return -1;
  }

  i64 value = 0;
  i64 index = 0;

  while (index < length) {
    i64 byte = raz_compiler_rt_arena_get(data, index);

    if (byte == 10 || byte == 13 || byte == 32 || byte == 9) {
      index += 1;
    } else {
      if (byte < 48 || byte > 57) {
        return -1;
      }
      value = value * 10 + byte - 48;
      index += 1;
    }
  }
  return value;
}

fn incremental_try_restore_artifact(
i64 manifest_path,
i64 manifest_length,
Source& source,
i64 backend,
i64 llvm_emit_kind,
bool forge_native,
bool forge_structured_only,
i64 output_path,
i64 output_length,
) -> bool {
  if (manifest_path == 0 || manifest_length <= 0 || output_path == 0 || output_length <= 0) {
    return false;
  }

  i64 key_path = raz_compiler_rt_arena_create(8192);
  i64 artifact_path = raz_compiler_rt_arena_create(8192);
  i64 key_data = raz_compiler_rt_arena_create(128);

  if (key_path == 0 || artifact_path == 0 || key_data == 0) {
    return false;
  }

  i64 key_length = incremental_cache_path(manifest_path, manifest_length, 0, key_path, 8192);
  i64 artifact_length = incremental_cache_path(manifest_path, manifest_length, 1, artifact_path, 8192);
  bool restored = false;

  if (
  key_length > 0 &&
  artifact_length > 0 &&
  raz_compiler_rt_path_exists_ascii(artifact_path, artifact_length) != 0
  ) {
    i64 read = raz_compiler_rt_read_ascii(key_path, key_length, key_data, 128);

    if (
    read > 0 &&
    incremental_parse_decimal(
    key_data,
    read,
    ) == incremental_build_key(source, backend, llvm_emit_kind, forge_native, forge_structured_only) &&
    raz_compiler_rt_copy_file_ascii(artifact_path, artifact_length, output_path, output_length) >= 0
    ) {
      restored = true;
    }
  }
  raz_compiler_rt_arena_destroy(key_path);
  raz_compiler_rt_arena_destroy(artifact_path);
  raz_compiler_rt_arena_destroy(key_data);
  return restored;
}

fn incremental_store_artifact(
i64 manifest_path,
i64 manifest_length,
Source& source,
i64 backend,
i64 llvm_emit_kind,
bool forge_native,
bool forge_structured_only,
i64 output_path,
i64 output_length,
) {
  if (manifest_path == 0 || manifest_length <= 0 || output_path == 0 || output_length <= 0) {
    return;
  }

  i64 cache_dir = raz_compiler_rt_arena_create(8192);
  i64 key_path = raz_compiler_rt_arena_create(8192);
  i64 artifact_path = raz_compiler_rt_arena_create(8192);

  if (cache_dir == 0 || key_path == 0 || artifact_path == 0) {
    return;
  }

  i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
  i64 key_length = incremental_cache_path(manifest_path, manifest_length, 0, key_path, 8192);
  i64 artifact_length = incremental_cache_path(manifest_path, manifest_length, 1, artifact_path, 8192);

  if (
  cache_dir_length > 0 &&
  key_length > 0 &&
  artifact_length > 0 &&
  raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) == 0 &&
  raz_compiler_rt_copy_file_ascii(output_path, output_length, artifact_path, artifact_length) >= 0
  ) {
    ForgeWriter writer;

    writer.capacity = 128;
    writer.data = raz_compiler_rt_arena_create(writer.capacity);
    writer.length = 0;
    writer.failed = writer.data == 0;
    if (!writer.failed) {
      writer_decimal(
      &mut writer,
      incremental_build_key(source, backend, llvm_emit_kind, forge_native, forge_structured_only),
      );
      writer_newline(&mut writer);
      raz_compiler_rt_write_ascii(key_path, key_length, writer.data, writer.length);
    }
    writer_destroy(&mut writer);
  }
  raz_compiler_rt_arena_destroy(cache_dir);
  raz_compiler_rt_arena_destroy(key_path);
  raz_compiler_rt_arena_destroy(artifact_path);
}

fn incremental_state_next_decimal(i64 data, i64&mut cursor, i64 end) -> i64 {
  while (*cursor < end) {
    i64 byte = raz_compiler_rt_arena_get(data, *cursor);

    if (byte == 32 || byte == 9) {
      *cursor += 1;
    } else {
      break;
    }
  }
  if (*cursor >= end) {
    return -1;
  }

  i64 value = 0;
  bool found = false;

  while (*cursor < end) {
    i64 byte = raz_compiler_rt_arena_get(data, *cursor);

    if (byte < 48 || byte > 57) {
      break;
    }
    value = value * 10 + byte - 48;
    *cursor += 1;
    found = true;
  }
  if (!found) {
    return -1;
  }
  return value;
}

fn incremental_classify_module_changes(i64 manifest_path, i64 manifest_length, HirModule&mut hir) {
  hir.incremental_dirty_module_count = 0;
  hir.incremental_interface_dirty_module_count = 0;
  hir.incremental_affected_module_count = 0;

  i64 index = 0;

  while (index < hir.incremental_module_fingerprint_count) {
    raz_compiler_rt_arena_set(hir.incremental_module_dirty_kinds, index, 2);
    index += 1;
  }
  if (manifest_path == 0 || manifest_length <= 0) {
    hir.incremental_dirty_module_count = hir.incremental_module_fingerprint_count;
    hir.incremental_interface_dirty_module_count = hir.incremental_module_fingerprint_count;
    hir.incremental_affected_module_count = hir.incremental_module_fingerprint_count;
    return;
  }

  i64 state_path = raz_compiler_rt_arena_create(8192);
  i64 state_data = raz_compiler_rt_arena_create(524288);
  i64 old_ids = raz_compiler_rt_arena_create(4096);
  i64 old_sources = raz_compiler_rt_arena_create(4096);
  i64 old_interfaces = raz_compiler_rt_arena_create(4096);
  i64 old_packages = raz_compiler_rt_arena_create(4096);
  i64 old_namespaces = raz_compiler_rt_arena_create(4096);
  i64 affected = raz_compiler_rt_arena_create(4096);

  if (
  state_path == 0 ||
  state_data == 0 ||
  old_ids == 0 ||
  old_sources == 0 ||
  old_interfaces == 0 ||
  old_packages == 0 ||
  old_namespaces == 0 ||
  affected == 0
  ) {
    hir.incremental_dirty_module_count = hir.incremental_module_fingerprint_count;
    hir.incremental_interface_dirty_module_count = hir.incremental_module_fingerprint_count;
    hir.incremental_affected_module_count = hir.incremental_module_fingerprint_count;
    return;
  }

  i64 state_length = incremental_cache_path(manifest_path, manifest_length, 2, state_path, 8192);
  i64 read = -1;

  if (state_length > 0) {
    read = raz_compiler_rt_read_ascii(state_path, state_length, state_data, 524288);
  }

  i64 old_count = 0;
  if (read > 0) {
    i64 cursor = 0;

    while (cursor < read) {
      i64 start = cursor;

      while (cursor < read && raz_compiler_rt_arena_get(state_data, cursor) != 10) {
        cursor += 1;
      }
      i64 end = cursor;
      if (cursor < read) {
        cursor += 1;
      }
      if (end > start && raz_compiler_rt_arena_get(state_data, start) == 77 && old_count < 4096) {
        i64 field = start + 1;
        i64 old_id = incremental_state_next_decimal(state_data, &mut field, end);
        i64 old_source = incremental_state_next_decimal(state_data, &mut field, end);
        i64 old_interface = incremental_state_next_decimal(state_data, &mut field, end);
        i64 old_package = incremental_state_next_decimal(state_data, &mut field, end);
        i64 old_namespace = incremental_state_next_decimal(state_data, &mut field, end);

        if (
        old_id >= 0 &&
        old_source >= 0 &&
        old_interface >= 0 &&
        old_package >= 0 &&
        old_namespace >= 0
        ) {
          raz_compiler_rt_arena_set(old_ids, old_count, old_id);
          raz_compiler_rt_arena_set(old_sources, old_count, old_source);
          raz_compiler_rt_arena_set(old_interfaces, old_count, old_interface);
          raz_compiler_rt_arena_set(old_packages, old_count, old_package);
          raz_compiler_rt_arena_set(old_namespaces, old_count, old_namespace);
          old_count += 1;
        }
      }
    }
  }

  index = 0;
  while (index < hir.incremental_module_fingerprint_count) {
    i64 module_id = raz_compiler_rt_arena_get(hir.incremental_module_ids, index);
    i64 package_hash = raz_compiler_rt_arena_get(hir.incremental_module_package_hashes, index);
    i64 namespace_hash = raz_compiler_rt_arena_get(hir.incremental_module_namespace_hashes, index);
    i64 old_index = 0;
    i64 matched_index = -1;

    while (old_index < old_count && matched_index < 0) {
      if (
      raz_compiler_rt_arena_get(old_ids, old_index) == module_id &&
      raz_compiler_rt_arena_get(old_packages, old_index) == package_hash &&
      raz_compiler_rt_arena_get(old_namespaces, old_index) == namespace_hash
      ) {
        matched_index = old_index;
      }
      old_index += 1;
    }

    i64 kind = 2;
    if (matched_index >= 0) {
      i64 source_fingerprint = raz_compiler_rt_arena_get(hir.incremental_module_source_fingerprints, index);
      i64 interface_fingerprint = raz_compiler_rt_arena_get(hir.incremental_module_interface_fingerprints, index);

      if (raz_compiler_rt_arena_get(old_sources, matched_index) == source_fingerprint) {
        kind = 0;
      } else if (raz_compiler_rt_arena_get(old_interfaces, matched_index) == interface_fingerprint) {
        kind = 1;
      }
    }
    raz_compiler_rt_arena_set(hir.incremental_module_dirty_kinds, index, kind);
    if (kind != 0) {
      hir.incremental_dirty_module_count += 1;
      raz_compiler_rt_arena_set(affected, index, 1);
    }
    if (kind == 2) {
      hir.incremental_interface_dirty_module_count += 1;
    }
    index += 1;
  }

  i64 edge = 0;
  while (edge < hir.incremental_module_dependency_count) {
    i64 owner_id = raz_compiler_rt_arena_get(hir.incremental_module_dependency_owners, edge);
    i64 target_id = raz_compiler_rt_arena_get(hir.incremental_module_dependency_targets, edge);
    i64 target_index = 0;
    i64 owner_index = 0;

    while (
    target_index < hir.incremental_module_fingerprint_count &&
    raz_compiler_rt_arena_get(hir.incremental_module_ids, target_index) != target_id
    ) {
      target_index += 1;
    }
    while (
    owner_index < hir.incremental_module_fingerprint_count &&
    raz_compiler_rt_arena_get(hir.incremental_module_ids, owner_index) != owner_id
    ) {
      owner_index += 1;
    }
    if (
    target_index < hir.incremental_module_fingerprint_count &&
    owner_index < hir.incremental_module_fingerprint_count &&
    raz_compiler_rt_arena_get(hir.incremental_module_dirty_kinds, target_index) == 2
    ) {
      raz_compiler_rt_arena_set(affected, owner_index, 1);
    }
    edge += 1;
  }

  index = 0;
  while (index < hir.incremental_module_fingerprint_count) {
    if (raz_compiler_rt_arena_get(affected, index) != 0) {
      hir.incremental_affected_module_count += 1;
    }
    index += 1;
  }

  raz_compiler_rt_arena_destroy(state_path);
  raz_compiler_rt_arena_destroy(state_data);
  raz_compiler_rt_arena_destroy(old_ids);
  raz_compiler_rt_arena_destroy(old_sources);
  raz_compiler_rt_arena_destroy(old_interfaces);
  raz_compiler_rt_arena_destroy(old_packages);
  raz_compiler_rt_arena_destroy(old_namespaces);
  raz_compiler_rt_arena_destroy(affected);
}


fn incremental_hir_module_fingerprint(HirModule& hir, i64 module_index) -> i64 {
  i64 fingerprint = 17;
  i64 start = raz_compiler_rt_arena_get(hir.incremental_module_function_starts, module_index);
  i64 count = raz_compiler_rt_arena_get(hir.incremental_module_function_counts, module_index);
  i64 cursor = 0;

  fingerprint = incremental_mix(fingerprint, count);
  while (cursor < count) {
    i64 function_index = raz_compiler_rt_arena_get(hir.incremental_module_function_indices, start + cursor);

    fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index));
    fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(hir.function_local_counts, function_index));
    fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(hir.function_statement_counts, function_index));
    fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(hir.function_return_types, function_index));
    fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(hir.function_is_extern, function_index));
    cursor += 1;
  }
  return fingerprint;
}

fn incremental_load_module_cache_state(i64 manifest_path, i64 manifest_length, HirModule&mut hir) {
  hir.incremental_module_cache_hit_count = 0;

  i64 index = 0;
  while (index < hir.incremental_module_fingerprint_count) {
    raz_compiler_rt_arena_set(
      hir.incremental_module_hir_fingerprints,
      index,
      incremental_hir_module_fingerprint(hir, index),
    );
    raz_compiler_rt_arena_set(hir.incremental_module_cached_mir_fingerprints, index, 0);
    raz_compiler_rt_arena_set(hir.incremental_module_cache_kinds, index, 0);
    index += 1;
  }
  if (manifest_path == 0 || manifest_length <= 0) {
    return;
  }

  i64 state_path = raz_compiler_rt_arena_create(8192);
  i64 state_data = raz_compiler_rt_arena_create(524288);
  if (state_path == 0 || state_data == 0) {
    return;
  }

  i64 state_length = incremental_cache_path(manifest_path, manifest_length, 3, state_path, 8192);
  i64 read = -1;
  if (state_length > 0) {
    read = raz_compiler_rt_read_ascii(state_path, state_length, state_data, 524288);
  }
  if (read > 0) {
    i64 cursor = 0;

    while (cursor < read) {
      i64 start = cursor;
      while (cursor < read && raz_compiler_rt_arena_get(state_data, cursor) != 10) {
        cursor += 1;
      }
      i64 end = cursor;
      if (cursor < read) {
        cursor += 1;
      }
      if (end > start && raz_compiler_rt_arena_get(state_data, start) >= 48 && raz_compiler_rt_arena_get(state_data, start) <= 57) {
        i64 field = start;
        i64 module_id = incremental_state_next_decimal(state_data, &mut field, end);
        i64 source_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);
        i64 interface_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);
        i64 hir_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);
        i64 mir_fingerprint = incremental_state_next_decimal(state_data, &mut field, end);

        if (
          module_id >= 0 &&
          source_fingerprint >= 0 &&
          interface_fingerprint >= 0 &&
          hir_fingerprint >= 0 &&
          mir_fingerprint >= 0
        ) {
          i64 module_index = 0;
          while (
            module_index < hir.incremental_module_fingerprint_count &&
            raz_compiler_rt_arena_get(hir.incremental_module_ids, module_index) != module_id
          ) {
            module_index += 1;
          }
          if (
            module_index < hir.incremental_module_fingerprint_count &&
            raz_compiler_rt_arena_get(hir.incremental_module_dirty_kinds, module_index) == 0 &&
            raz_compiler_rt_arena_get(hir.incremental_module_source_fingerprints, module_index) == source_fingerprint &&
            raz_compiler_rt_arena_get(hir.incremental_module_interface_fingerprints, module_index) == interface_fingerprint &&
            raz_compiler_rt_arena_get(hir.incremental_module_hir_fingerprints, module_index) == hir_fingerprint
          ) {
            raz_compiler_rt_arena_set(hir.incremental_module_cached_mir_fingerprints, module_index, mir_fingerprint);
            raz_compiler_rt_arena_set(hir.incremental_module_cache_kinds, module_index, 1);
            hir.incremental_module_cache_hit_count += 1;
          }
        }
      }
    }
  }
  raz_compiler_rt_arena_destroy(state_path);
  raz_compiler_rt_arena_destroy(state_data);
}


fn incremental_persist_module_fingerprints(i64 manifest_path, i64 manifest_length, HirModule& hir) {
  if (manifest_path == 0 || manifest_length <= 0) {
    return;
  }

  i64 cache_dir = raz_compiler_rt_arena_create(8192);
  i64 state_path = raz_compiler_rt_arena_create(8192);

  if (cache_dir == 0 || state_path == 0) {
    return;
  }

  i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
  i64 state_length = incremental_cache_path(manifest_path, manifest_length, 2, state_path, 8192);

  if (
  cache_dir_length <= 0 ||
  state_length <= 0 ||
  raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) != 0
  ) {
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(state_path);
    return;
  }

  ForgeWriter writer;

  writer.capacity = 524288;
  writer.data = raz_compiler_rt_arena_create(writer.capacity);
  writer.length = 0;
  writer.failed = writer.data == 0;
  if (!writer.failed) {
    i64 header[9] = [82, 65, 90, 73, 78, 67, 32, 50, 10];

    writer_chars(&mut writer, &header, 9);

    i64 index = 0;

    while (index < hir.incremental_module_fingerprint_count) {
      i64 marker[1] = [77];

      writer_chars(&mut writer, &marker, 1);
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_ids, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_source_fingerprints, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_interface_fingerprints, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_package_hashes, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_namespace_hashes, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_function_starts, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_function_counts, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_dirty_kinds, index));
      writer_newline(&mut writer);
      index += 1;
    }

    i64 edge = 0;

    while (edge < hir.incremental_module_dependency_count) {
      i64 marker[1] = [69];

      writer_chars(&mut writer, &marker, 1);
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_dependency_owners, edge));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_dependency_targets, edge));
      writer_newline(&mut writer);
      edge += 1;
    }
    raz_compiler_rt_write_ascii(state_path, state_length, writer.data, writer.length);
  }
  writer_destroy(&mut writer);
  raz_compiler_rt_arena_destroy(cache_dir);
  raz_compiler_rt_arena_destroy(state_path);
}

fn incremental_mir_module_fingerprint(MirModule& mir, i64 module_id) -> i64 {
  i64 fingerprint = 17;
  i64 function_index = 0;

  while (function_index < mir.function_count) {
    if (raz_compiler_rt_arena_get(mir.function_module_ids, function_index) == module_id) {
      i64 instruction = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
      i64 end = instruction + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);

      fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index));
      fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.function_local_counts, function_index));
      while (instruction < end) {
        fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.opcodes, instruction));
        fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_types, instruction));
        fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_a, instruction));
        fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_b, instruction));
        fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_c, instruction));
        fingerprint = incremental_mix(fingerprint, raz_compiler_rt_arena_get(mir.op_d, instruction));
        instruction += 1;
      }
    }
    function_index += 1;
  }
  return fingerprint;
}

fn incremental_persist_module_mir_state(
  i64 manifest_path,
  i64 manifest_length,
  HirModule& hir,
  MirModule& mir,
) {
  if (manifest_path == 0 || manifest_length <= 0) {
    return;
  }

  i64 cache_dir = raz_compiler_rt_arena_create(8192);
  i64 state_path = raz_compiler_rt_arena_create(8192);

  if (cache_dir == 0 || state_path == 0) {
    return;
  }

  i64 cache_dir_length = incremental_cache_dir(manifest_path, manifest_length, cache_dir, 8192);
  i64 state_length = incremental_cache_path(manifest_path, manifest_length, 3, state_path, 8192);

  if (
  cache_dir_length <= 0 ||
  state_length <= 0 ||
  raz_compiler_rt_create_dir_ascii(cache_dir, cache_dir_length) != 0
  ) {
    raz_compiler_rt_arena_destroy(cache_dir);
    raz_compiler_rt_arena_destroy(state_path);
    return;
  }

  ForgeWriter writer;

  writer.capacity = 262144;
  writer.data = raz_compiler_rt_arena_create(writer.capacity);
  writer.length = 0;
  writer.failed = writer.data == 0;
  if (!writer.failed) {
    i64 header[9] = [82, 65, 90, 77, 73, 82, 32, 50, 10];

    writer_chars(&mut writer, &header, 9);

    i64 index = 0;

    while (index < hir.incremental_module_fingerprint_count) {
      i64 module_id = raz_compiler_rt_arena_get(hir.incremental_module_ids, index);

      i64 mir_fingerprint = incremental_mir_module_fingerprint(mir, module_id);

      writer_decimal(&mut writer, module_id);
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_source_fingerprints, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_interface_fingerprints, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, raz_compiler_rt_arena_get(hir.incremental_module_hir_fingerprints, index));
      writer_space(&mut writer);
      writer_decimal(&mut writer, mir_fingerprint);
      writer_newline(&mut writer);
      index += 1;
    }
    raz_compiler_rt_write_ascii(state_path, state_length, writer.data, writer.length);
  }
  writer_destroy(&mut writer);
  raz_compiler_rt_arena_destroy(cache_dir);
  raz_compiler_rt_arena_destroy(state_path);
}
