namespace raz_compiler_driver_backend;
public import raz_compiler_backend_rxe_codegen;
// Backend selection and dispatch. Frontend and MIR are deliberately backend-neutral.
// Backend kind 0 is Forge (default); kind 1 is LLVM; kind 2 is WebAssembly; kind 3 is RXE. --opt is shared.
fn backend_default() -> i64 {
  return 0;
}

fn backend_option_kind(i64 value, i64 length) -> i64 {
  if (value == 0) {
    return -1;
  }
  // --backend=forge
  if (length == 15) {
    i64 expected_forge[15] = [45, 45, 98, 97, 99, 107, 101, 110, 100, 61, 102, 111, 114, 103, 101];
    i64 i = 0;
    bool match_forge = true;

    while (i < 15) {
      if (raz_rt_stage1_arena_get(value, i) != expected_forge[i]) {
        match_forge = false;
      }
      i += 1;
    }
    if (match_forge) {
      return 0;
    }
  }
  // --backend=llvm
  if (length == 14) {
    i64 expected_llvm[14] = [45, 45, 98, 97, 99, 107, 101, 110, 100, 61, 108, 108, 118, 109];
    i64 i = 0;
    bool match_llvm = true;

    while (i < 14) {
      if (raz_rt_stage1_arena_get(value, i) != expected_llvm[i]) {
        match_llvm = false;
      }
      i += 1;
    }
    if (match_llvm) {
      return 1;
    }
  }
  // --backend=wasm
  if (length == 14) {
    i64 expected_wasm[14] = [45, 45, 98, 97, 99, 107, 101, 110, 100, 61, 119, 97, 115, 109];
    i64 i = 0;
    bool match_wasm = true;

    while (i < 14) {
      if (raz_rt_stage1_arena_get(value, i) != expected_wasm[i]) {
        match_wasm = false;
      }
      i += 1;
    }
    if (match_wasm) {
      return 2;
    }
  }
  // --backend=rxe
  if (length == 13) {
    i64 expected_rxe[13] = [45, 45, 98, 97, 99, 107, 101, 110, 100, 61, 114, 120, 101];
    i64 i = 0;
    bool match_rxe = true;

    while (i < 13) {
      if (raz_rt_stage1_arena_get(value, i) != expected_rxe[i]) {
        match_rxe = false;
      }
      i += 1;
    }
    if (match_rxe) {
      return 3;
    }
  }
  return -1;
}

fn backend_option_present(i64 value, i64 length) -> bool {
  if (value == 0 || length < 10) {
    return false;
  }

  i64 prefix[10] = [45, 45, 98, 97, 99, 107, 101, 110, 100, 61];
  i64 i = 0;

  while (i < 10) {
    if (raz_rt_stage1_arena_get(value, i) != prefix[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fn forge_native_option(i64 value, i64 length) -> bool {
  if (value == 0 || length != 14) {
    return false;
  }
  // --forge-native

  i64 expected[14] = [45, 45, 102, 111, 114, 103, 101, 45, 110, 97, 116, 105, 118, 101];
  i64 index = 0;

  while (index < 14) {
    if (raz_rt_stage1_arena_get(value, index) != expected[index]) {
      return false;
    }
    index += 1;
  }
  return true;
}

fn forge_structured_only_option(i64 value, i64 length) -> bool {
  if (value == 0 || length != 23) {
    return false;
  }
  // --forge-structured-only

  i64 expected[23] = [45, 45, 102, 111, 114, 103, 101, 45, 115, 116, 114, 117, 99, 116, 117, 114, 101, 100, 45, 111, 110, 108, 121];
  i64 index = 0;

  while (index < 23) {
    if (raz_rt_stage1_arena_get(value, index) != expected[index]) {
      return false;
    }
    index += 1;
  }
  return true;
}

fn emit_backend_module(
i64 backend,
bool forge_native,
bool forge_structured_only,
LlvmTargetOptions& llvm_options,
Source& source,
HirModule& hir,
MirModule& mir,
i64 output_path,
i64 output_path_length,
) -> bool {
  if (backend == 0) {
    i64 optimization = llvm_options.optimization_kind;

    if (optimization < 0) {
      optimization = 2;
    }
    return emit_forge_module(
    source,
    hir,
    mir,
    output_path,
    output_path_length,
    forge_native,
    forge_structured_only,
    optimization,
    );
  }
  if (backend == 1) {
    return emit_llvm_module(source, hir, mir, llvm_options, output_path, output_path_length);
  }
  if (backend == 2) {
    return emit_wasm_module(source, hir, mir, output_path, output_path_length);
  }
  if (backend == 3) {
    return emit_rxe_module(source, hir, mir, output_path, output_path_length);
  }
  return false;
}
