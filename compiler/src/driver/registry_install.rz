namespace raz_compiler_driver_registry_install;

public import raz_compiler_driver_registry;

// Installed package tools are layered on the normal registry resolver and
// content-addressed store. Keep executable-selection and user tool metadata
// out of the core registry module so resolution remains focused and bounded.
fn registry_install_bin_root(i64 output, i64 capacity) -> i64 {
    i64 home = raz_compiler_rt_arena_create(8192);

    if (home == 0) {
        return -1;
    }

    i64 raz_home_key[8] = [82, 65, 90, 95, 72, 79, 77, 69];
    i64 hl = registry_env_ascii(&raz_home_key, 8, home, 8192);
    i64 suffix_start = 0;
    i64 suffix_length = 4;
    i64 suffix[10] = [47, 98, 105, 110, 47, 46, 114, 97, 122, 0];

    if (hl <= 0) {
        i64 home_key[4] = [72, 79, 77, 69];

        hl = registry_env_ascii(&home_key, 4, home, 8192);
        if (hl <= 0) {
            i64 profile_key[11] = [85, 83, 69, 82, 80, 82, 79, 70, 73, 76, 69];

            hl = registry_env_ascii(&profile_key, 11, home, 8192);
        }
        suffix_start = 4;
        suffix_length = 10;
    }
    if (hl <= 0) {
        i64 fallback[10] = [46, 47, 46, 114, 97, 122, 47, 98, 105, 110];

        if (capacity < 10) {
            raz_compiler_rt_arena_destroy(home);
            return -1;
        }

        i64 f = 0;

        while (f < 10) {
            raz_compiler_rt_arena_set(output, f, fallback[f]);
            f += 1;
        }
        raz_compiler_rt_arena_destroy(home);
        return 10;
    }
    if (hl + suffix_length > capacity) {
        raz_compiler_rt_arena_destroy(home);
        return -1;
    }

    i64 i = 0;

    while (i < hl) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(home, i));
        i += 1;
    }
    i = 0;
    while (i < suffix_length) {
        raz_compiler_rt_arena_set(output, hl + i, suffix[suffix_start + i]);
        i += 1;
    }
    raz_compiler_rt_arena_destroy(home);
    return hl + suffix_length;
}

fn registry_install_parse_spec(i64 spec, i64 sl, i64 name, i64&mut nl, i64 constraint, i64&mut cl) -> bool {
    if (spec == 0 || sl <= 0) {
        return false;
    }

    i64 at = 0;

    while (at < sl && raz_compiler_rt_arena_get(spec, at) != 64) {
        at += 1;
    }
    *nl = at;
    if (*nl <= 0 || *nl > 4096) {
        return false;
    }

    i64 i = 0;

    while (i < *nl) {
        raz_compiler_rt_arena_set(name, i, raz_compiler_rt_arena_get(spec, i));
        i += 1;
    }
    if (at < sl) {
        *cl = sl - at - 1;
        if (*cl <= 0 || *cl > 256) {
            return false;
        }
        i = 0;
        while (i < *cl) {
            raz_compiler_rt_arena_set(constraint, i, raz_compiler_rt_arena_get(spec, at + 1 + i));
            i += 1;
        }
    } else {
        i64 any[7] = [62, 61, 48, 46, 48, 46, 48];

        *cl = 7;
        i = 0;
        while (i < 7) {
            raz_compiler_rt_arena_set(constraint, i, any[i]);
            i += 1;
        }
    }
    return true;
}

fn registry_install_append_quoted(i64 output, i64 capacity, i64&mut cursor, i64 value, i64 length) -> bool {
    i64 quote[1] = [34];

    return (
        package_append_literal(output, capacity, cursor, &quote, 1) &&
        package_append(output, capacity, cursor, value, 0, length) &&
        package_append_literal(output, capacity, cursor, &quote, 1)
    );
}

fn registry_install_metadata_path(i64 output, i64 capacity) -> i64 {
    i64 bin_root = raz_compiler_rt_arena_create(8192);

    if (bin_root == 0) {
        return -1;
    }

    i64 brl = registry_install_bin_root(bin_root, 8192);

    if (brl <= 4) {
        raz_compiler_rt_arena_destroy(bin_root);
        return -1;
    }

    i64 root_length = brl - 4;
    i64 suffix[15] = [47, 105, 110, 115, 116, 97, 108, 108, 101, 100, 45, 116, 111, 111, 108];

    if (root_length + 15 > capacity) {
        raz_compiler_rt_arena_destroy(bin_root);
        return -1;
    }

    i64 i = 0;

    while (i < root_length) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(bin_root, i));
        i += 1;
    }
    i = 0;
    while (i < 15) {
        raz_compiler_rt_arena_set(output, root_length + i, suffix[i]);
        i += 1;
    }
    raz_compiler_rt_arena_destroy(bin_root);
    return root_length + 15;
}

fn registry_install_metadata_set(
    i64 name,
    i64 nl,
    i64 version,
    i64 vl,
    i64 constraint,
    i64 cl,
    i64 checksum,
    i64 chl,
    i64 binary,
    i64 bl,
) -> bool {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 old = raz_compiler_rt_arena_create(1048576);
    i64 out = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || old == 0 || out == 0) {
        return false;
    }

    i64 pl = registry_install_metadata_path(path, 8192);

    if (pl <= 0) {
        return false;
    }

    i64 ol = raz_compiler_rt_read_ascii(path, pl, old, 1048576);

    if (ol < 0) {
        ol = 0;
    }

    i64 cursor = 0;
    i64 pos = 0;

    while (pos < ol) {
        i64 line_start = pos;
        i64 tab = pos;

        while (
            tab < ol &&
            raz_compiler_rt_arena_get(old, tab) != 9 &&
            raz_compiler_rt_arena_get(old, tab) != 10
        ) {
            tab += 1;
        }
        while (pos < ol && raz_compiler_rt_arena_get(old, pos) != 10) {
            pos += 1;
        }
        if (pos < ol) {
            pos += 1;
        }

        bool same = tab - line_start == nl;
        i64 i = 0;

        while (same && i < nl) {
            if (raz_compiler_rt_arena_get(old, line_start + i) != raz_compiler_rt_arena_get(name, i)) {
                same = false;
            }
            i += 1;
        }
        if (same) {
            i64 line_end = pos;

            if (line_end > line_start && raz_compiler_rt_arena_get(old, line_end - 1) == 10) {
                line_end -= 1;
            }

            i64 field = 0;
            i64 scan = tab;

            while (scan < line_end && field < 4) {
                if (raz_compiler_rt_arena_get(old, scan) == 9) {
                    field += 1;
                }
                scan += 1;
            }
            if (field == 4) {
                i64 existing_binary_length = line_end - scan;

                same = existing_binary_length == bl;
                i = 0;
                while (same && i < bl) {
                    if (raz_compiler_rt_arena_get(old, scan + i) != raz_compiler_rt_arena_get(binary, i)) {
                        same = false;
                    }
                    i += 1;
                }
            } else {
                same = bl == nl;
                i = 0;
                while (same && i < nl) {
                    if (raz_compiler_rt_arena_get(name, i) != raz_compiler_rt_arena_get(binary, i)) {
                        same = false;
                    }
                    i += 1;
                }
            }
        }
        if (!same) {
            i64 length = pos - line_start;

            if (cursor + length >= 1048576) {
                return false;
            }
            i = 0;
            while (i < length) {
                raz_compiler_rt_arena_set(out, cursor + i, raz_compiler_rt_arena_get(old, line_start + i));
                i += 1;
            }
            cursor += length;
        }
    }

    i64 needed = nl + 1 + vl + 1 + cl + 1 + chl + 1 + bl + 1;

    if (cursor + needed >= 1048576) {
        return false;
    }

    i64 i = 0;

    while (i < nl) {
        raz_compiler_rt_arena_set(out, cursor, raz_compiler_rt_arena_get(name, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(out, cursor, 9);
    cursor += 1;
    i = 0;
    while (i < vl) {
        raz_compiler_rt_arena_set(out, cursor, raz_compiler_rt_arena_get(version, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(out, cursor, 9);
    cursor += 1;
    i = 0;
    while (i < cl) {
        raz_compiler_rt_arena_set(out, cursor, raz_compiler_rt_arena_get(constraint, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(out, cursor, 9);
    cursor += 1;
    i = 0;
    while (i < chl) {
        raz_compiler_rt_arena_set(out, cursor, raz_compiler_rt_arena_get(checksum, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(out, cursor, 9);
    cursor += 1;
    i = 0;
    while (i < bl) {
        raz_compiler_rt_arena_set(out, cursor, raz_compiler_rt_arena_get(binary, i));
        cursor += 1;
        i += 1;
    }
    raz_compiler_rt_arena_set(out, cursor, 10);
    cursor += 1;
    return raz_compiler_rt_write_ascii(path, pl, out, cursor) == cursor;
}

fn registry_install_metadata_remove(i64 name, i64 nl) -> bool {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 old = raz_compiler_rt_arena_create(1048576);
    i64 out = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || old == 0 || out == 0) {
        return false;
    }

    i64 pl = registry_install_metadata_path(path, 8192);

    if (pl <= 0) {
        return false;
    }

    i64 ol = raz_compiler_rt_read_ascii(path, pl, old, 1048576);

    if (ol < 0) {
        return true;
    }

    i64 cursor = 0;
    i64 pos = 0;

    while (pos < ol) {
        i64 line_start = pos;
        i64 tab = pos;

        while (
            tab < ol &&
            raz_compiler_rt_arena_get(old, tab) != 9 &&
            raz_compiler_rt_arena_get(old, tab) != 10
        ) {
            tab += 1;
        }
        while (pos < ol && raz_compiler_rt_arena_get(old, pos) != 10) {
            pos += 1;
        }
        if (pos < ol) {
            pos += 1;
        }

        bool same = tab - line_start == nl;
        i64 i = 0;

        while (same && i < nl) {
            if (raz_compiler_rt_arena_get(old, line_start + i) != raz_compiler_rt_arena_get(name, i)) {
                same = false;
            }
            i += 1;
        }
        if (!same) {
            i64 length = pos - line_start;

            i = 0;
            while (i < length) {
                raz_compiler_rt_arena_set(out, cursor + i, raz_compiler_rt_arena_get(old, line_start + i));
                i += 1;
            }
            cursor += length;
        }
    }
    return raz_compiler_rt_write_ascii(path, pl, out, cursor) == cursor;
}

fn registry_install_list() -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || data == 0) {
        return 40;
    }

    i64 pl = registry_install_metadata_path(path, 8192);

    if (pl <= 0) {
        return 40;
    }

    i64 dl = raz_compiler_rt_read_ascii(path, pl, data, 1048576);

    if (dl <= 0) {
        i64 none[27] = [78, 111, 32, 105, 110, 115, 116, 97, 108, 108, 101, 100, 32, 112, 97, 99, 107, 97, 103, 101, 32, 116, 111, 111, 108, 115, 10];

        cli_write(&none, 27);
        return 0;
    }

    i64 header[16] = [73, 110, 115, 116, 97, 108, 108, 101, 100, 32, 116, 111, 111, 108, 115, 10];

    cli_write(&header, 16);

    i64 pos = 0;

    while (pos < dl) {
        i64 start = pos;

        while (
            pos < dl &&
            raz_compiler_rt_arena_get(data, pos) != 9 &&
            raz_compiler_rt_arena_get(data, pos) != 10
        ) {
            pos += 1;
        }
        if (pos > start) {
            cli_write_arena(data + start, pos - start);
        }
        if (pos < dl && raz_compiler_rt_arena_get(data, pos) == 9) {
            pos += 1;
        }

        i64 vstart = pos;

        while (
            pos < dl &&
            raz_compiler_rt_arena_get(data, pos) != 9 &&
            raz_compiler_rt_arena_get(data, pos) != 10
        ) {
            pos += 1;
        }

        i64 at[2] = [64, 32];

        cli_write(&at, 1);
        if (pos > vstart) {
            cli_write_arena(data + vstart, pos - vstart);
        }

        i64 nl[1] = [10];

        cli_write(&nl, 1);
        while (pos < dl && raz_compiler_rt_arena_get(data, pos) != 10) {
            pos += 1;
        }
        if (pos < dl) {
            pos += 1;
        }
    }
    return 0;
}

fn registry_install_metadata_constraint(i64 name, i64 nl, i64 constraint, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || data == 0) {
        return -1;
    }

    i64 pl = registry_install_metadata_path(path, 8192);

    if (pl <= 0) {
        return -1;
    }

    i64 dl = raz_compiler_rt_read_ascii(path, pl, data, 1048576);

    if (dl <= 0) {
        return -1;
    }

    i64 pos = 0;

    while (pos < dl) {
        i64 line_start = pos;
        i64 tab = pos;

        while (
            tab < dl &&
            raz_compiler_rt_arena_get(data, tab) != 9 &&
            raz_compiler_rt_arena_get(data, tab) != 10
        ) {
            tab += 1;
        }

        bool same = tab - line_start == nl;
        i64 i = 0;

        while (same && i < nl) {
            if (raz_compiler_rt_arena_get(data, line_start + i) != raz_compiler_rt_arena_get(name, i)) {
                same = false;
            }
            i += 1;
        }
        pos = tab;
        if (same && pos < dl && raz_compiler_rt_arena_get(data, pos) == 9) {
            pos += 1;
            while (
                pos < dl &&
                raz_compiler_rt_arena_get(data, pos) != 9 &&
                raz_compiler_rt_arena_get(data, pos) != 10
            ) {
                pos += 1;
            }
            if (pos < dl && raz_compiler_rt_arena_get(data, pos) == 9) {
                pos += 1;
            }

            i64 start = pos;

            while (
                pos < dl &&
                raz_compiler_rt_arena_get(data, pos) != 9 &&
                raz_compiler_rt_arena_get(data, pos) != 10
            ) {
                pos += 1;
            }

            i64 length = pos - start;

            if (length <= 0 || length > capacity) {
                return -1;
            }
            i = 0;
            while (i < length) {
                raz_compiler_rt_arena_set(constraint, i, raz_compiler_rt_arena_get(data, start + i));
                i += 1;
            }
            return length;
        }
        while (pos < dl && raz_compiler_rt_arena_get(data, pos) != 10) {
            pos += 1;
        }
        if (pos < dl) {
            pos += 1;
        }
    }
    return -1;
}

fn registry_install_metadata_binary(i64 name, i64 nl, i64 binary, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || data == 0 || binary == 0 || capacity <= 0) {
        return -1;
    }

    i64 pl = registry_install_metadata_path(path, 8192);

    if (pl <= 0) {
        return -1;
    }

    i64 dl = raz_compiler_rt_read_ascii(path, pl, data, 1048576);

    if (dl <= 0) {
        return -1;
    }

    i64 pos = 0;

    while (pos < dl) {
        i64 line_start = pos;
        i64 tab = pos;

        while (
            tab < dl &&
            raz_compiler_rt_arena_get(data, tab) != 9 &&
            raz_compiler_rt_arena_get(data, tab) != 10
        ) {
            tab += 1;
        }

        bool same = tab - line_start == nl;
        i64 i = 0;

        while (same && i < nl) {
            if (raz_compiler_rt_arena_get(data, line_start + i) != raz_compiler_rt_arena_get(name, i)) {
                same = false;
            }
            i += 1;
        }
        if (same) {
            pos = tab;

            i64 field = 0;

            while (field < 4 && pos < dl && raz_compiler_rt_arena_get(data, pos) != 10) {
                if (raz_compiler_rt_arena_get(data, pos) == 9) {
                    field += 1;
                }
                pos += 1;
            }
            if (field == 4) {
                i64 start = pos;

                while (pos < dl && raz_compiler_rt_arena_get(data, pos) != 10) {
                    pos += 1;
                }

                i64 length = pos - start;

                if (length > 0 && length <= capacity) {
                    i = 0;
                    while (i < length) {
                        raz_compiler_rt_arena_set(binary, i, raz_compiler_rt_arena_get(data, start + i));
                        i += 1;
                    }
                    return length;
                }
            }
            if (nl <= capacity) {
                i = 0;
                while (i < nl) {
                    raz_compiler_rt_arena_set(binary, i, raz_compiler_rt_arena_get(name, i));
                    i += 1;
                }
                return nl;
            }
            return -1;
        }
        while (pos < dl && raz_compiler_rt_arena_get(data, pos) != 10) {
            pos += 1;
        }
        if (pos < dl) {
            pos += 1;
        }
    }
    return -1;
}

fn registry_install_metadata_binary_owner(i64 binary, i64 bl, i64 owner, i64 capacity) -> i64 {
    i64 path = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(1048576);

    if (path == 0 || data == 0 || binary == 0 || bl <= 0 || owner == 0) {
        return -1;
    }

    i64 pl = registry_install_metadata_path(path, 8192);

    if (pl <= 0) {
        return -1;
    }

    i64 dl = raz_compiler_rt_read_ascii(path, pl, data, 1048576);

    if (dl <= 0) {
        return 0;
    }

    i64 pos = 0;

    while (pos < dl) {
        i64 line_start = pos;
        i64 line_end = pos;

        while (line_end < dl && raz_compiler_rt_arena_get(data, line_end) != 10) {
            line_end += 1;
        }

        i64 first_tab = line_start;

        while (first_tab < line_end && raz_compiler_rt_arena_get(data, first_tab) != 9) {
            first_tab += 1;
        }

        i64 package_length = first_tab - line_start;
        i64 field = 0;
        i64 cursor = first_tab;

        while (cursor < line_end && field < 4) {
            if (raz_compiler_rt_arena_get(data, cursor) == 9) {
                field += 1;
            }
            cursor += 1;
        }

        i64 binary_start = line_start;
        i64 binary_length = package_length;

        if (field == 4 && cursor <= line_end) {
            binary_start = cursor;
            binary_length = line_end - cursor;
        }

        bool same = binary_length == bl;
        i64 i = 0;

        while (same && i < bl) {
            if (raz_compiler_rt_arena_get(data, binary_start + i) != raz_compiler_rt_arena_get(binary, i)) {
                same = false;
            }
            i += 1;
        }
        if (same) {
            if (package_length <= 0 || package_length > capacity) {
                return -1;
            }
            i = 0;
            while (i < package_length) {
                raz_compiler_rt_arena_set(owner, i, raz_compiler_rt_arena_get(data, line_start + i));
                i += 1;
            }
            return package_length;
        }
        pos = line_end;
        if (pos < dl) {
            pos += 1;
        }
    }
    return 0;
}

fn registry_install_bin_option(i64 argument, i64 length, i64 output, i64 capacity) -> i64 {
    if (argument == 0 || output == 0 || length <= 6) {
        return 0;
    }

    i64 prefix[6] = [45, 45, 98, 105, 110, 61];
    i64 i = 0;

    while (i < 6) {
        if (raz_compiler_rt_arena_get(argument, i) != prefix[i]) {
            return 0;
        }
        i += 1;
    }

    i64 value_length = length - 6;

    if (value_length <= 0 || value_length > capacity) {
        return -1;
    }
    i = 0;
    while (i < value_length) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(argument, 6 + i));
        i += 1;
    }
    return value_length;
}

fn registry_install_manifest_bin_entry(
    i64 manifest,
    i64 length,
    i64 selected,
    i64 selected_length,
    i64 entry,
    i64 entry_capacity,
) -> i64 {
    if (manifest == 0 || selected == 0 || selected_length <= 0 || entry == 0) {
        return -1;
    }

    i64 current_name = raz_compiler_rt_arena_create(4096);
    i64 current_entry = raz_compiler_rt_arena_create(4096);

    if (current_name == 0 || current_entry == 0) {
        return -1;
    }

    bool in_bin = false;
    i64 current_name_length = 0;
    i64 current_entry_length = 0;
    i64 cursor = 0;

    while (cursor <= length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }

        i64 left = start;

        while (
            left < end &&
            (
                raz_compiler_rt_arena_get(manifest, left) == 32 ||
                raz_compiler_rt_arena_get(manifest, left) == 9
            )
        ) {
            left += 1;
        }

        i64 right = end;

        while (
            right > left &&
            (
                raz_compiler_rt_arena_get(manifest, right - 1) == 32 ||
                raz_compiler_rt_arena_get(manifest, right - 1) == 9
            )
        ) {
            right -= 1;
        }

        bool bin_header = right - left == 7;
        i64 header[7] = [91, 91, 98, 105, 110, 93, 93];
        i64 h = 0;

        while (bin_header && h < 7) {
            if (raz_compiler_rt_arena_get(manifest, left + h) != header[h]) {
                bin_header = false;
            }
            h += 1;
        }

        bool any_header = left < right && raz_compiler_rt_arena_get(manifest, left) == 91;

        if (bin_header || any_header || cursor > length) {
            if (in_bin && current_name_length == selected_length && current_entry_length > 0) {
                bool same = true;
                i64 i = 0;

                while (same && i < selected_length) {
                    if (
                        raz_compiler_rt_arena_get(current_name, i) != raz_compiler_rt_arena_get(selected, i)
                    ) {
                        same = false;
                    }
                    i += 1;
                }
                if (same) {
                    if (current_entry_length > entry_capacity) {
                        return -1;
                    }
                    i = 0;
                    while (i < current_entry_length) {
                        raz_compiler_rt_arena_set(entry, i, raz_compiler_rt_arena_get(current_entry, i));
                        i += 1;
                    }
                    return current_entry_length;
                }
            }
            in_bin = bin_header;
            current_name_length = 0;
            current_entry_length = 0;
        } else if (in_bin && left < right) {
            i64 equal = left;

            while (equal < right && raz_compiler_rt_arena_get(manifest, equal) != 61) {
                equal += 1;
            }
            if (equal < right) {
                i64 key_end = equal;

                while (
                    key_end > left &&
                    (
                        raz_compiler_rt_arena_get(manifest, key_end - 1) == 32 ||
                        raz_compiler_rt_arena_get(manifest, key_end - 1) == 9
                    )
                ) {
                    key_end -= 1;
                }

                bool name_key = key_end - left == 4;
                i64 nk[4] = [110, 97, 109, 101];
                i64 i = 0;

                while (name_key && i < 4) {
                    if (raz_compiler_rt_arena_get(manifest, left + i) != nk[i]) {
                        name_key = false;
                    }
                    i += 1;
                }

                bool entry_key = key_end - left == 5;
                i64 ek[5] = [101, 110, 116, 114, 121];

                i = 0;
                while (entry_key && i < 5) {
                    if (raz_compiler_rt_arena_get(manifest, left + i) != ek[i]) {
                        entry_key = false;
                    }
                    i += 1;
                }
                if (name_key) {
                    current_name_length = copy_quoted_value(manifest, equal + 1, right, current_name, 4096);
                } else if (entry_key) {
                    current_entry_length = copy_quoted_value(manifest, equal + 1, right, current_entry, 4096);
                }
            }
        }
        if (cursor >= length) {
            if (in_bin && current_name_length == selected_length && current_entry_length > 0) {
                bool same = true;
                i64 i = 0;

                while (same && i < selected_length) {
                    if (
                        raz_compiler_rt_arena_get(current_name, i) != raz_compiler_rt_arena_get(selected, i)
                    ) {
                        same = false;
                    }
                    i += 1;
                }
                if (same) {
                    if (current_entry_length > entry_capacity) {
                        return -1;
                    }
                    i = 0;
                    while (i < current_entry_length) {
                        raz_compiler_rt_arena_set(entry, i, raz_compiler_rt_arena_get(current_entry, i));
                        i += 1;
                    }
                    return current_entry_length;
                }
            }
            break;
        }
    }
    return 0;
}

fn registry_install_manifest_bin_names(i64 manifest, i64 length, i64 names, i64 stride, i64 max_bins) -> i64 {
    if (manifest == 0 || names == 0 || stride <= 0 || max_bins <= 0) {
        return -1;
    }

    bool in_bin = false;
    i64 current_name = raz_compiler_rt_arena_create(4096);
    i64 current_name_length = 0;
    i64 count = 0;
    i64 cursor = 0;

    if (current_name == 0) {
        return -1;
    }
    while (cursor <= length) {
        i64 start = cursor;

        while (
            cursor < length &&
            raz_compiler_rt_arena_get(manifest, cursor) != 10 &&
            raz_compiler_rt_arena_get(manifest, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor < length &&
            (
                raz_compiler_rt_arena_get(manifest, cursor) == 10 ||
                raz_compiler_rt_arena_get(manifest, cursor) == 13
            )
        ) {
            cursor += 1;
        }

        i64 left = start;

        while (
            left < end &&
            (
                raz_compiler_rt_arena_get(manifest, left) == 32 ||
                raz_compiler_rt_arena_get(manifest, left) == 9
            )
        ) {
            left += 1;
        }

        i64 right = end;

        while (
            right > left &&
            (
                raz_compiler_rt_arena_get(manifest, right - 1) == 32 ||
                raz_compiler_rt_arena_get(manifest, right - 1) == 9
            )
        ) {
            right -= 1;
        }

        bool bin_header = right - left == 7;
        i64 header[7] = [91, 91, 98, 105, 110, 93, 93];
        i64 h = 0;

        while (bin_header && h < 7) {
            if (raz_compiler_rt_arena_get(manifest, left + h) != header[h]) {
                bin_header = false;
            }
            h += 1;
        }

        bool any_header = left < right && raz_compiler_rt_arena_get(manifest, left) == 91;

        if (bin_header || any_header || cursor > length) {
            if (in_bin && current_name_length > 0) {
                if (count >= max_bins || current_name_length >= stride) {
                    return -1;
                }

                i64 i = 0;

                while (i < current_name_length) {
                    raz_compiler_rt_arena_set(
                        names,
                        count * stride + i,
                        raz_compiler_rt_arena_get(current_name, i),
                    );
                    i += 1;
                }
                raz_compiler_rt_arena_set(names, count * stride + current_name_length, 0);
                count += 1;
            }
            in_bin = bin_header;
            current_name_length = 0;
        } else if (in_bin && left < right) {
            i64 equal = left;

            while (equal < right && raz_compiler_rt_arena_get(manifest, equal) != 61) {
                equal += 1;
            }
            if (equal < right) {
                i64 key_end = equal;

                while (
                    key_end > left &&
                    (
                        raz_compiler_rt_arena_get(manifest, key_end - 1) == 32 ||
                        raz_compiler_rt_arena_get(manifest, key_end - 1) == 9
                    )
                ) {
                    key_end -= 1;
                }

                bool name_key = key_end - left == 4;
                i64 nk[4] = [110, 97, 109, 101];
                i64 i = 0;

                while (name_key && i < 4) {
                    if (raz_compiler_rt_arena_get(manifest, left + i) != nk[i]) {
                        name_key = false;
                    }
                    i += 1;
                }
                if (name_key) {
                    current_name_length = copy_quoted_value(manifest, equal + 1, right, current_name, 4096);
                }
            }
        }
        if (cursor >= length) {
            if (in_bin && current_name_length > 0) {
                if (count >= max_bins || current_name_length >= stride) {
                    return -1;
                }

                i64 i = 0;

                while (i < current_name_length) {
                    raz_compiler_rt_arena_set(
                        names,
                        count * stride + i,
                        raz_compiler_rt_arena_get(current_name, i),
                    );
                    i += 1;
                }
                raz_compiler_rt_arena_set(names, count * stride + current_name_length, 0);
                count += 1;
            }
            break;
        }
    }
    return count;
}

fn registry_install_all_bins(
    i64 program,
    i64 program_length,
    i64 spec,
    i64 spec_length,
    i64 manifest,
    i64 manifest_length,
    bool force,
    bool update,
) -> i64 {
    i64 names = raz_compiler_rt_arena_create(16384);
    i64 command = raz_compiler_rt_arena_create(32768);

    if (names == 0 || command == 0) {
        return 40;
    }

    i64 count = registry_install_manifest_bin_names(manifest, manifest_length, names, 256, 64);

    if (count < 0) {
        return 57;
    }
    if (count == 0) {
        return -1;
    }

    i64 index = 0;

    while (index < count) {
        i64 bin = names + index * 256;
        i64 bl = 0;

        while (bl < 256 && raz_compiler_rt_arena_get(bin, bl) != 0) {
            bl += 1;
        }
        if (bl <= 0) {
            return 57;
        }

        i64 cursor = 0;

        if (!registry_install_append_quoted(command, 32768, &mut cursor, program, program_length)) {
            return 40;
        }

        i64 install_text[9] = [32, 105, 110, 115, 116, 97, 108, 108, 32];

        if (!package_append_literal(command, 32768, &mut cursor, &install_text, 9)) {
            return 40;
        }
        if (update) {
            i64 update_text[9] = [45, 45, 117, 112, 100, 97, 116, 101, 32];

            if (!package_append_literal(command, 32768, &mut cursor, &update_text, 9)) {
                return 40;
            }
        } else if (force) {
            i64 force_text[8] = [45, 45, 102, 111, 114, 99, 101, 32];

            if (!package_append_literal(command, 32768, &mut cursor, &force_text, 8)) {
                return 40;
            }
        }

        i64 bin_prefix[6] = [45, 45, 98, 105, 110, 61];

        if (!package_append_literal(command, 32768, &mut cursor, &bin_prefix, 6)) {
            return 40;
        }
        if (!package_append(command, 32768, &mut cursor, bin, 0, bl)) {
            return 40;
        }

        i64 space[1] = [32];

        if (!package_append_literal(command, 32768, &mut cursor, &space, 1)) {
            return 40;
        }
        if (!registry_install_append_quoted(command, 32768, &mut cursor, spec, spec_length)) {
            return 40;
        }
        if (raz_compiler_rt_process_run_ascii(command, cursor) != 0) {
            return 46;
        }
        index += 1;
    }
    return 0;
}

fn package_install_command(i64 argc) -> i64 {
    if (argc == 3) {
        i64 option = raz_compiler_rt_arena_create(64);

        if (option == 0) {
            return 40;
        }

        i64 option_length = raz_compiler_rt_process_arg(2, option, 64);
        i64 list_option[6] = [45, 45, 108, 105, 115, 116];

        if (option_length == 6 && cli_arg_equals(option, option_length, &list_option, 6)) {
            return registry_install_list();
        }
    }
    if (argc < 3 || argc > 6) {
        return 55;
    }

    bool force = false;
    bool update = false;
    bool all_bins = false;
    i64 selected_bin = raz_compiler_rt_arena_create(4096);
    i64 selected_bin_length = 0;
    i64 spec_index = argc - 1;
    i64 option_index = 2;

    if (selected_bin == 0) {
        return 40;
    }
    while (option_index < spec_index) {
        i64 option = raz_compiler_rt_arena_create(4096);

        if (option == 0) {
            return 40;
        }

        i64 option_length = raz_compiler_rt_process_arg(option_index, option, 4096);
        i64 force_option[7] = [45, 45, 102, 111, 114, 99, 101];
        i64 update_option[8] = [45, 45, 117, 112, 100, 97, 116, 101];
        i64 bins_option[6] = [45, 45, 98, 105, 110, 115];

        if (option_length == 7 && cli_arg_equals(option, option_length, &force_option, 7)) {
            force = true;
        } else if (option_length == 8 && cli_arg_equals(option, option_length, &update_option, 8)) {
            update = true;
            force = true;
        } else if (option_length == 6 && cli_arg_equals(option, option_length, &bins_option, 6)) {
            all_bins = true;
        } else {
            i64 parsed_bin = registry_install_bin_option(option, option_length, selected_bin, 4096);

            if (parsed_bin <= 0) {
                return 55;
            }
            if (all_bins) {
                return 55;
            }
            selected_bin_length = parsed_bin;
        }
        option_index += 1;
    }
    if (all_bins && selected_bin_length > 0) {
        return 55;
    }

    i64 spec = raz_compiler_rt_arena_create(4096);
    i64 name = raz_compiler_rt_arena_create(4096);
    i64 constraint = raz_compiler_rt_arena_create(256);
    i64 version = raz_compiler_rt_arena_create(256);
    i64 store = raz_compiler_rt_arena_create(8192);
    i64 checksum = raz_compiler_rt_arena_create(64);
    i64 manifest = raz_compiler_rt_arena_create(65536);
    i64 manifest_path = raz_compiler_rt_arena_create(8192);
    i64 bin_root = raz_compiler_rt_arena_create(8192);
    i64 output = raz_compiler_rt_arena_create(8192);
    i64 program = raz_compiler_rt_arena_create(8192);
    i64 command = raz_compiler_rt_arena_create(32768);
    i64 entry = raz_compiler_rt_arena_create(4096);
    i64 previous_binary = raz_compiler_rt_arena_create(4096);
    i64 owner = raz_compiler_rt_arena_create(4096);
    i64 old_output = raz_compiler_rt_arena_create(8192);

    if (
        spec == 0 ||
        name == 0 ||
        constraint == 0 ||
        version == 0 ||
        store == 0 ||
        checksum == 0 ||
        manifest == 0 ||
        manifest_path == 0 ||
        bin_root == 0 ||
        output == 0 ||
        program == 0 ||
        command == 0 ||
        entry == 0 ||
        previous_binary == 0 ||
        owner == 0 ||
        old_output == 0
    ) {
        return 40;
    }

    i64 sl = raz_compiler_rt_process_arg(spec_index, spec, 4096);
    i64 nl = 0;
    i64 cl = 0;

    if (!registry_install_parse_spec(spec, sl, name, &mut nl, constraint, &mut cl)) {
        return 55;
    }

    i64 previous_binary_length = 0;

    if (selected_bin_length == 0) {
        previous_binary_length = registry_install_metadata_binary(name, nl, previous_binary, 4096);
        if (previous_binary_length < 0) {
            previous_binary_length = 0;
        }
    }
    if (update && nl == sl) {
        i64 stored = registry_install_metadata_constraint(name, nl, constraint, 256);

        if (stored <= 0) {
            return 61;
        }
        cl = stored;
    }
    if (update && selected_bin_length == 0 && previous_binary_length > 0) {
        bool package_default = previous_binary_length == nl;
        i64 i = 0;

        while (package_default && i < nl) {
            if (raz_compiler_rt_arena_get(previous_binary, i) != raz_compiler_rt_arena_get(name, i)) {
                package_default = false;
            }
            i += 1;
        }
        if (!package_default) {
            i = 0;
            while (i < previous_binary_length) {
                raz_compiler_rt_arena_set(selected_bin, i, raz_compiler_rt_arena_get(previous_binary, i));
                i += 1;
            }
            selected_bin_length = previous_binary_length;
        }
    }

    i64 status = registry_resolve(name, nl, constraint, cl, version, 256, store, 8192, checksum, 64);

    if (status != 0) {
        return status;
    }

    i64 store_length = 0;

    while (store_length < 8192 && raz_compiler_rt_arena_get(store, store_length) != 0) {
        store_length += 1;
    }
    if (store_length <= 0) {
        return 65;
    }

    i64 manifest_length = package_manifest_path_from_root(store, store_length, manifest_path, 8192);

    if (manifest_length <= 0 || raz_compiler_rt_path_exists_ascii(manifest_path, manifest_length) == 0) {
        return 57;
    }

    i64 manifest_data_length = raz_compiler_rt_read_ascii(manifest_path, manifest_length, manifest, 65536);

    if (manifest_data_length <= 0) {
        return 57;
    }
    if (selected_bin_length == 0) {
        i64 install_program_length = raz_compiler_rt_process_arg(0, program, 8192);

        if (install_program_length <= 0) {
            return 55;
        }
        i64 multi_status = registry_install_all_bins(
            program,
            install_program_length,
            spec,
            sl,
            manifest,
            manifest_data_length,
            force,
            update,
        );
        if (multi_status >= 0) {
            return multi_status;
        }
        if (all_bins) {
            return 55;
        }
    }

    i64 binary = name;
    i64 binary_length = nl;
    i64 entry_length = 0;

    if (selected_bin_length > 0) {
        entry_length = registry_install_manifest_bin_entry(
            manifest,
            manifest_data_length,
            selected_bin,
            selected_bin_length,
            entry,
            4096,
        );
        if (entry_length <= 0) {
            i64 missing[55] = [101, 114, 114, 111, 114, 58, 32, 112, 97, 99, 107, 97, 103, 101, 32, 100, 111, 101, 115, 32, 110, 111, 116, 32, 100, 101, 102, 105, 110, 101, 32, 116, 104, 101, 32, 114, 101, 113, 117, 101, 115, 116, 101, 100, 32, 98, 105, 110, 97, 114, 121, 10, 0, 0, 0];

            cli_write_stream(2, &missing, 52);
            return 55;
        }
        binary = selected_bin;
        binary_length = selected_bin_length;
    }

    i64 brl = registry_install_bin_root(bin_root, 8192);

    if (brl <= 0 || raz_compiler_rt_create_dir_ascii(bin_root, brl) != 0) {
        return 56;
    }

    i64 output_length = brl + 1 + binary_length;

    if (output_length + 4 >= 8192) {
        return 40;
    }

    i64 i = 0;

    while (i < brl) {
        raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(bin_root, i));
        i += 1;
    }
    raz_compiler_rt_arena_set(output, brl, 47);
    i = 0;
    while (i < binary_length) {
        raz_compiler_rt_arena_set(output, brl + 1 + i, raz_compiler_rt_arena_get(binary, i));
        i += 1;
    }
    if (raz_compiler_rt_host_platform() == 1) {
        i64 ext[4] = [46, 101, 120, 101];

        i = 0;
        while (i < 4) {
            raz_compiler_rt_arena_set(output, output_length + i, ext[i]);
            i += 1;
        }
        output_length += 4;
    }

    i64 owner_length = registry_install_metadata_binary_owner(binary, binary_length, owner, 4096);

    if (owner_length > 0) {
        bool same_owner = owner_length == nl;
        i64 oi = 0;

        while (same_owner && oi < nl) {
            if (raz_compiler_rt_arena_get(owner, oi) != raz_compiler_rt_arena_get(name, oi)) {
                same_owner = false;
            }
            oi += 1;
        }
        if (!same_owner) {
            i64 collision[49] = [101, 114, 114, 111, 114, 58, 32, 105, 110, 115, 116, 97, 108, 108, 101, 100, 32, 116, 111, 111, 108, 32, 110, 97, 109, 101, 32, 105, 115, 32, 111, 119, 110, 101, 100, 32, 98, 121, 32, 97, 110, 111, 116, 104, 101, 114, 32, 112, 97];

            cli_write_stream(2, &collision, 49);

            i64 nlout[1] = [10];

            cli_write_stream(2, &nlout, 1);
            return 55;
        }
    }
    if (!force && raz_compiler_rt_path_exists_ascii(output, output_length) != 0) {
        i64 already[77] = [101, 114, 114, 111, 114, 58, 32, 116, 111, 111, 108, 32, 105, 115, 32, 97, 108, 114, 101, 97, 100, 121, 32, 105, 110, 115, 116, 97, 108, 108, 101, 100, 10, 32, 32, 104, 101, 108, 112, 58, 32, 117, 115, 101, 32, 39, 114, 97, 122, 32, 105, 110, 115, 116, 97, 108, 108, 32, 45, 45, 102, 111, 114, 99, 101, 32, 60, 112, 97, 99, 107, 97, 103, 101, 62, 39, 10];

        cli_write_stream(2, &already, 77);
        return 55;
    }

    i64 program_length = raz_compiler_rt_process_arg(0, program, 8192);

    if (program_length <= 0) {
        return 55;
    }

    i64 cursor = 0;

    if (!registry_install_append_quoted(command, 32768, &mut cursor, program, program_length)) {
        return 40;
    }

    i64 build_text[7] = [32, 98, 117, 105, 108, 100, 32];

    if (!package_append_literal(command, 32768, &mut cursor, &build_text, 7)) {
        return 40;
    }
    if (entry_length > 0) {
        i64 entry_prefix[9] = [45, 45, 101, 110, 116, 114, 121, 61, 34];

        if (!package_append_literal(command, 32768, &mut cursor, &entry_prefix, 8)) {
            return 40;
        }
        if (!package_append(command, 32768, &mut cursor, entry, 0, entry_length)) {
            return 40;
        }

        i64 quote_space[2] = [34, 32];

        if (!package_append_literal(command, 32768, &mut cursor, &quote_space, 2)) {
            return 40;
        }
    }
    if (!registry_install_append_quoted(command, 32768, &mut cursor, manifest_path, manifest_length)) {
        return 40;
    }

    i64 space[1] = [32];

    if (!package_append_literal(command, 32768, &mut cursor, &space, 1)) {
        return 40;
    }
    if (!registry_install_append_quoted(command, 32768, &mut cursor, output, output_length)) {
        return 40;
    }

    i64 release[18] = [32, 45, 45, 112, 114, 111, 102, 105, 108, 101, 32, 114, 101, 108, 101, 97, 115, 101];

    if (!package_append_literal(command, 32768, &mut cursor, &release, 18)) {
        return 40;
    }
    if (raz_compiler_rt_process_run_ascii(command, cursor) != 0) {
        raz_compiler_rt_remove_path_ascii(output, output_length);
        return 46;
    }

    i64 vl_meta = 0;

    while (vl_meta < 256 && raz_compiler_rt_arena_get(version, vl_meta) != 0) {
        vl_meta += 1;
    }

    i64 chl = 0;

    while (chl < 64 && raz_compiler_rt_arena_get(checksum, chl) != 0) {
        chl += 1;
    }
    if (
        !registry_install_metadata_set(
            name,
            nl,
            version,
            vl_meta,
            constraint,
            cl,
            checksum,
            chl,
            binary,
            binary_length,
        )
    ) {
        raz_compiler_rt_remove_path_ascii(output, output_length);
        return 56;
    }
    if (previous_binary_length > 0) {
        bool same_binary = previous_binary_length == binary_length;
        i64 pi = 0;

        while (same_binary && pi < binary_length) {
            if (raz_compiler_rt_arena_get(previous_binary, pi) != raz_compiler_rt_arena_get(binary, pi)) {
                same_binary = false;
            }
            pi += 1;
        }
        if (!same_binary && brl + 1 + previous_binary_length + 4 < 8192) {
            pi = 0;
            while (pi < brl) {
                raz_compiler_rt_arena_set(old_output, pi, raz_compiler_rt_arena_get(bin_root, pi));
                pi += 1;
            }
            raz_compiler_rt_arena_set(old_output, brl, 47);
            pi = 0;
            while (pi < previous_binary_length) {
                raz_compiler_rt_arena_set(
                    old_output,
                    brl + 1 + pi,
                    raz_compiler_rt_arena_get(previous_binary, pi),
                );
                pi += 1;
            }

            i64 old_length = brl + 1 + previous_binary_length;

            if (raz_compiler_rt_host_platform() == 1) {
                i64 ext[4] = [46, 101, 120, 101];

                pi = 0;
                while (pi < 4) {
                    raz_compiler_rt_arena_set(old_output, old_length + pi, ext[pi]);
                    pi += 1;
                }
                old_length += 4;
            }
            if (raz_compiler_rt_path_exists_ascii(old_output, old_length) != 0) {
                raz_compiler_rt_remove_path_ascii(old_output, old_length);
            }
        }
    }

    i64 installed[10] = [73, 110, 115, 116, 97, 108, 108, 101, 100, 32];

    cli_write(&installed, 10);
    cli_write_arena(binary, binary_length);

    i64 from[7] = [32, 102, 114, 111, 109, 32, 32];

    cli_write(&from, 6);
    cli_write_arena(name, nl);

    i64 at[1] = [64];

    cli_write(&at, 1);

    i64 vl = 0;

    while (vl < 256 && raz_compiler_rt_arena_get(version, vl) != 0) {
        vl += 1;
    }
    cli_write_arena(version, vl);

    i64 newline[1] = [10];

    cli_write(&newline, 1);
    return 0;
}

fn registry_install_remove_package_binaries(i64 name, i64 nl) -> i64 {
    i64 metadata_path = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(1048576);
    i64 bin_root = raz_compiler_rt_arena_create(8192);
    i64 output = raz_compiler_rt_arena_create(8192);

    if (metadata_path == 0 || data == 0 || bin_root == 0 || output == 0) {
        return -1;
    }

    i64 mpl = registry_install_metadata_path(metadata_path, 8192);
    i64 brl = registry_install_bin_root(bin_root, 8192);

    if (mpl <= 0 || brl <= 0) {
        return -1;
    }

    i64 dl = raz_compiler_rt_read_ascii(metadata_path, mpl, data, 1048576);

    if (dl <= 0) {
        return 0;
    }

    i64 removed = 0;
    i64 pos = 0;

    while (pos < dl) {
        i64 line_start = pos;
        i64 line_end = pos;

        while (line_end < dl && raz_compiler_rt_arena_get(data, line_end) != 10) {
            line_end += 1;
        }

        i64 first_tab = line_start;

        while (first_tab < line_end && raz_compiler_rt_arena_get(data, first_tab) != 9) {
            first_tab += 1;
        }

        bool same = first_tab - line_start == nl;
        i64 i = 0;

        while (same && i < nl) {
            if (raz_compiler_rt_arena_get(data, line_start + i) != raz_compiler_rt_arena_get(name, i)) {
                same = false;
            }
            i += 1;
        }
        if (same) {
            i64 field = 0;
            i64 scan = first_tab;

            while (scan < line_end && field < 4) {
                if (raz_compiler_rt_arena_get(data, scan) == 9) {
                    field += 1;
                }
                scan += 1;
            }

            i64 binary_start = line_start;
            i64 binary_length = nl;

            if (field == 4 && scan <= line_end) {
                binary_start = scan;
                binary_length = line_end - scan;
            }
            if (binary_length > 0 && brl + 1 + binary_length + 4 < 8192) {
                i = 0;
                while (i < brl) {
                    raz_compiler_rt_arena_set(output, i, raz_compiler_rt_arena_get(bin_root, i));
                    i += 1;
                }
                raz_compiler_rt_arena_set(output, brl, 47);
                i = 0;
                while (i < binary_length) {
                    raz_compiler_rt_arena_set(
                        output,
                        brl + 1 + i,
                        raz_compiler_rt_arena_get(data, binary_start + i),
                    );
                    i += 1;
                }

                i64 ol = brl + 1 + binary_length;

                if (raz_compiler_rt_host_platform() == 1) {
                    i64 ext[4] = [46, 101, 120, 101];

                    i = 0;
                    while (i < 4) {
                        raz_compiler_rt_arena_set(output, ol + i, ext[i]);
                        i += 1;
                    }
                    ol += 4;
                }
                if (raz_compiler_rt_path_exists_ascii(output, ol) != 0) {
                    if (raz_compiler_rt_remove_path_ascii(output, ol) != 0) {
                        return -1;
                    }
                }
                removed += 1;
            }
        }
        pos = line_end;
        if (pos < dl) {
            pos += 1;
        }
    }
    return removed;
}

fn package_uninstall_command(i64 argc) -> i64 {
    if (argc != 3) {
        return 55;
    }

    i64 name = raz_compiler_rt_arena_create(4096);

    if (name == 0) {
        return 40;
    }

    i64 nl = raz_compiler_rt_process_arg(2, name, 4096);

    if (nl <= 0) {
        return 55;
    }

    i64 removed_count = registry_install_remove_package_binaries(name, nl);

    if (removed_count <= 0) {
        return 61;
    }
    if (!registry_install_metadata_remove(name, nl)) {
        return 56;
    }

    i64 removed[8] = [82, 101, 109, 111, 118, 101, 100, 32];

    cli_write(&removed, 8);
    cli_write_arena(name, nl);

    i64 suffix[9] = [32, 116, 111, 111, 108, 40, 115, 41, 10];

    cli_write(&suffix, 9);
    return 0;
}
