fn registry_digit(i64 value) -> bool {
    return value >= 48 && value <= 57;
}

fn registry_parse_u64(i64 data, i64 start, i64 end, i64&mut cursor) -> i64 {
    if (*cursor >= end || !registry_digit(raz_compiler_rt_arena_get(data, *cursor))) {
        return -1;
    }

    i64 value = 0;

    while (*cursor < end && registry_digit(raz_compiler_rt_arena_get(data, *cursor))) {
        value = value * 10 + (raz_compiler_rt_arena_get(data, *cursor) - 48);
        *cursor += 1;
    }
    return value;
}

fn registry_parse_semver(
    i64 data,
    i64 start,
    i64 length,
    i64&mut major,
    i64&mut minor,
    i64&mut patch,
) -> bool {
    i64 cursor = start;
    i64 end = start + length;

    *major = registry_parse_u64(data, start, end, &mut cursor);
    if (*major < 0 || cursor >= end || raz_compiler_rt_arena_get(data, cursor) != 46) {
        return false;
    }
    cursor += 1;
    *minor = registry_parse_u64(data, start, end, &mut cursor);
    if (*minor < 0 || cursor >= end || raz_compiler_rt_arena_get(data, cursor) != 46) {
        return false;
    }
    cursor += 1;
    *patch = registry_parse_u64(data, start, end, &mut cursor);
    if (*patch < 0) {
        return false;
    }
    // Prerelease/build suffixes are accepted but do not participate in this v1 ordering.
    return (
        cursor == end ||
        raz_compiler_rt_arena_get(data, cursor) == 45 ||
        raz_compiler_rt_arena_get(data, cursor) == 43
    );
}

fn registry_semver_has_prerelease(i64 data, i64 start, i64 length) -> bool {
    i64 i = 0;

    while (i < length) {
        i64 ch = raz_compiler_rt_arena_get(data, start + i);

        if (ch == 45) {
            return true;
        }
        if (ch == 43) {
            return false;
        }
        i += 1;
    }
    return false;
}

fn registry_semver_compare(i64 a0, i64 a1, i64 a2, i64 b0, i64 b1, i64 b2) -> i64 {
    if (a0<b0) {
        return -1;
    }
    if (a0> b0) {
        return 1;
    }
    if (a1<b1) {
        return -1;
    }
    if (a1> b1) {
        return 1;
    }
    if (a2<b2) {
        return -1;
    }
    if (a2> b2) {
        return 1;
    }
    return 0;
}

fn registry_constraint_matches(
    i64 version,
    i64 version_start,
    i64 version_length,
    i64 constraint,
    i64 constraint_length,
) -> bool {
    i64 vm = 0;
    i64 vn = 0;
    i64 vp = 0;

    if (!registry_parse_semver(version, version_start, version_length, &mut vm, &mut vn, &mut vp)) {
        return false;
    }
    if (constraint_length <= 0) {
        return true;
    }

    i64 offset = 0;
    i64 mode = 0;
    i64 first = raz_compiler_rt_arena_get(constraint, 0);

    if (first == 94) {
        mode = 1;
        offset = 1;
    }
    // ^
    else if (first == 126) {
        mode = 2;
        offset = 1;
    }
    // ~
    else if (first == 62 && constraint_length > 1 && raz_compiler_rt_arena_get(constraint, 1) == 61) {
        mode = 3;
        offset = 2;
    }
    // >=

    i64 cm = 0;
    i64 cn = 0;
    i64 cp = 0;

    if (!registry_parse_semver(constraint, offset, constraint_length - offset, &mut cm, &mut cn, &mut cp)) {
        return false;
    }

    bool version_prerelease = registry_semver_has_prerelease(version, version_start, version_length);

    bool constraint_prerelease = registry_semver_has_prerelease(
        constraint,
        offset,
        constraint_length - offset,
    );
    if (version_prerelease && !constraint_prerelease) {
        return false;
    }

    i64 cmp = registry_semver_compare(vm, vn, vp, cm, cn, cp);

    if (mode == 0) {
        if (cmp != 0) {
            return false;
        }
        if (constraint_prerelease) {
            if (version_length != constraint_length - offset) {
                return false;
            }

            i64 exact_index = 0;

            while (exact_index < version_length) {
                if (
                    raz_compiler_rt_arena_get(
                        version,
                        version_start + exact_index,
                    ) != raz_compiler_rt_arena_get(constraint, offset + exact_index)
                ) {
                    return false;
                }
                exact_index += 1;
            }
        }
        return true;
    }
    if (mode == 3) {
        return cmp >= 0;
    }
    if (mode == 2) {
        return cmp >= 0 && vm == cm && vn == cn;
    }
    if (cmp<0) {
        return false;
    }
    if (cm> 0) {
        return vm == cm;
    }
    if (cn > 0) {
        return vm == 0 && vn == cn;
    }
    return vm == 0 && vn == 0 && vp == cp;
}

fn registry_token(i64 data, i64 start, i64 end, i64 ordinal, i64&mut out_start, i64&mut out_length) -> bool {
    i64 cursor = start;
    i64 n = 0;

    while (cursor<end) {
        while (cursor<end && ascii_is_space(raz_compiler_rt_arena_get(data, cursor))) {
            cursor += 1;
        }
        if (cursor >= end) {
            break;
        }

        i64 ts = cursor;

        while (cursor<end && !ascii_is_space(raz_compiler_rt_arena_get(data, cursor))) {
            cursor += 1;
        }
        if (n == ordinal) {
            *out_start = ts;
            *out_length = cursor - ts;
            return true;
        }
        n += 1;
    }
    return false;
}

fn registry_bytes_equal(i64 a, i64 as_, i64 al, i64 b, i64 bs, i64 bl) -> bool {
    if (al != bl) {
        return false;
    }

    i64 i = 0;

    while (i<al) {
        if (raz_compiler_rt_arena_get(a, as_ + i) != raz_compiler_rt_arena_get(b, bs + i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn registry_store_materialize(
    i64 source,
    i64 source_length,
    i64 checksum,
    i64 checksum_length,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 store_length = registry_store_path(checksum, checksum_length, output, capacity);

    if (store_length <= 0) {
        return 40;
    }
    if (raz_compiler_rt_path_exists_ascii(output, store_length) != 0) {
        if (registry_store_verify(output, store_length, checksum, checksum_length)) {
            return store_length;
        }
        if (registry_offline()) {
            return -63;
        }
    }
    if (registry_offline()) {
        return -64;
    }
    if (raz_compiler_rt_copy_tree_ascii(source, source_length, output, store_length) != 0) {
        return -65;
    }
    if (!registry_store_verify(output, store_length, checksum, checksum_length)) {
        return -62;
    }
    return store_length;
}

// Returns 0 success. Registry transport errors use 60-76.
fn registry_resolve_mode(
    i64 name,
    i64 name_length,
    i64 constraint,
    i64 constraint_length,
    i64 out_version,
    i64 version_capacity,
    i64 out_path,
    i64 path_capacity,
    i64 out_checksum,
    i64 checksum_capacity,
    bool hydrate_lock,
) -> i64 {
    i64 data = raz_compiler_rt_arena_create(2097152);
    i64 base = raz_compiler_rt_arena_create(8192);

    if (data == 0 || base == 0) {
        return 40;
    }

    i64 base_length = 0;
    i64 length = registry_load_index(data, 2097152, base, 8192, &mut base_length);

    if (length <= 0) {
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(base);
        return 60;
    }

    bool found = false;
    i64 best0 = 0;
    i64 best1 = 0;
    i64 best2 = 0;
    i64 best_vs = 0;
    i64 best_vl = 0;
    i64 best_ps = 0;
    i64 best_pl = 0;
    i64 best_cs = 0;
    i64 best_cl = 0;
    i64 best_ks = 0;
    i64 best_kl = 0;
    i64 best_ss = 0;
    i64 best_sl = 0;
    i64 cursor = 0;

    while (cursor<length) {
        i64 start = cursor;

        while (
            cursor<length &&
            raz_compiler_rt_arena_get(data, cursor) != 10 &&
            raz_compiler_rt_arena_get(data, cursor) != 13
        ) {
            cursor += 1;
        }

        i64 end = cursor;

        while (
            cursor<length &&
            (raz_compiler_rt_arena_get(data, cursor) == 10 || raz_compiler_rt_arena_get(data, cursor) == 13)
        ) {
            cursor += 1;
        }
        if (start >= end) {
            continue;
        }

        i64 ns = 0;
        i64 nl = 0;
        i64 vs = 0;
        i64 vl = 0;
        i64 ps = 0;
        i64 pl = 0;
        i64 cs = 0;
        i64 cl = 0;
        i64 ks = 0;
        i64 kl = 0;
        i64 ss = 0;
        i64 sl = 0;

        if (
            !registry_token(data, start, end, 0, &mut ns, &mut nl) ||
            !registry_token(data, start, end, 1, &mut vs, &mut vl) ||
            !registry_token(data, start, end, 2, &mut ps, &mut pl) ||
            !registry_token(data, start, end, 3, &mut cs, &mut cl)
        ) {
            continue;
        }
        registry_token(data, start, end, 4, &mut ks, &mut kl);
        registry_token(data, start, end, 5, &mut ss, &mut sl);
        if (
            !registry_bytes_equal(data, ns, nl, name, 0, name_length) ||
            !registry_constraint_matches(data, vs, vl, constraint, constraint_length)
        ) {
            continue;
        }

        i64 m = 0;
        i64 n = 0;
        i64 p = 0;

        if (!registry_parse_semver(data, vs, vl, &mut m, &mut n, &mut p)) {
            continue;
        }
        if (!found || registry_semver_compare(m, n, p, best0, best1, best2)> 0) {
            found = true;
            best0 = m;
            best1 = n;
            best2 = p;
            best_vs = vs;
            best_vl = vl;
            best_ps = ps;
            best_pl = pl;
            best_cs = cs;
            best_cl = cl;
            best_ks = ks;
            best_kl = kl;
            best_ss = ss;
            best_sl = sl;
        }
    }
    if (!found) {
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(base);
        return 61;
    }
    if (best_vl> version_capacity || best_cl> checksum_capacity) {
        return 40;
    }

    i64 i = 0;

    while (i<best_vl) {
        raz_compiler_rt_arena_set(out_version, i, raz_compiler_rt_arena_get(data, best_vs + i));
        i += 1;
    }
    i = 0;
    while (i<best_cl) {
        raz_compiler_rt_arena_set(out_checksum, i, raz_compiler_rt_arena_get(data, best_cs + i));
        i += 1;
    }

    i64 selected_key = raz_compiler_rt_arena_create(32);
    i64 selected_signature = raz_compiler_rt_arena_create(160);

    if (selected_key == 0 || selected_signature == 0) {
        return 40;
    }
    i = 0;
    while (i<best_kl) {
        raz_compiler_rt_arena_set(selected_key, i, raz_compiler_rt_arena_get(data, best_ks + i));
        i += 1;
    }
    i = 0;
    while (i<best_sl) {
        raz_compiler_rt_arena_set(selected_signature, i, raz_compiler_rt_arena_get(data, best_ss + i));
        i += 1;
    }
    i64 trust = signing_verify_metadata(
        name,
        name_length,
        out_version,
        best_vl,
        out_checksum,
        best_cl,
        selected_key,
        best_kl,
        selected_signature,
        best_sl,
    );
    raz_compiler_rt_arena_destroy(selected_key);
    raz_compiler_rt_arena_destroy(selected_signature);
    if (trust != 1) {
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(base);
        return 68;
    }

    i64 cached_length = registry_store_path(out_checksum, best_cl, out_path, path_capacity);

    if (
        cached_length> 0 &&
        raz_compiler_rt_path_exists_ascii(out_path, cached_length) != 0 &&
        registry_store_verify(out_path, cached_length, out_checksum, best_cl)
    ) {
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(base);
        if (hydrate_lock) {
            return registry_fetch_package_lock(out_path, cached_length);
        }
        return 0;
    }

    i64 source = raz_compiler_rt_arena_create(16384);

    if (source == 0) {
        return 40;
    }

    i64 source_length = best_pl;

    i = 0;
    while (i<best_pl) {
        raz_compiler_rt_arena_set(source, i, raz_compiler_rt_arena_get(data, best_ps + i));
        i += 1;
    }

    i64 http[7] = [104, 116, 116, 112, 58, 47, 47];
    i64 https[8] = [104, 116, 116, 112, 115, 58, 47, 47];

    bool remote =
        registry_starts(source, source_length, &http, 7) ||
        registry_starts(source, source_length, &https, 8);
    if (!remote && base_length> 0) {
        i64 joined = raz_compiler_rt_arena_create(16384);

        if (joined == 0) {
            return 40;
        }
        source_length = registry_join_url(base, base_length, source, 0, source_length, joined, 16384);
        i = 0;
        while (i<source_length) {
            raz_compiler_rt_arena_set(source, i, raz_compiler_rt_arena_get(joined, i));
            i += 1;
        }
        raz_compiler_rt_arena_destroy(joined);
        remote = true;
    }

    i64 stored = 0;

    if (remote) {
        stored = registry_store_materialize_archive(
            source,
            source_length,
            out_checksum,
            best_cl,
            out_path,
            path_capacity,
        );
    } else if (registry_ends_dpk(source, source_length)) {
        stored = registry_store_materialize_local_archive(
            source,
            source_length,
            out_checksum,
            best_cl,
            out_path,
            path_capacity,
        );
    } else {
        stored = registry_store_materialize(
            source,
            source_length,
            out_checksum,
            best_cl,
            out_path,
            path_capacity,
        );
    }
    raz_compiler_rt_arena_destroy(source);
    raz_compiler_rt_arena_destroy(data);
    raz_compiler_rt_arena_destroy(base);
    if (stored<0) {
        return -stored;
    }
    if (hydrate_lock) {
        return registry_fetch_package_lock(out_path, stored);
    }
    return 0;
}

fn registry_resolve(
    i64 name,
    i64 name_length,
    i64 constraint,
    i64 constraint_length,
