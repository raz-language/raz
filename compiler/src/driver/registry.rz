        cli_write_stream(2, &text, 152);
        return status;
    }
    if (status == 73) {
        i64 text[132] = [101, 114, 114, 111, 114, 58, 32, 100, 101, 112, 101, 110, 100, 101, 110, 99, 121, 32, 103, 114, 97, 112, 104, 32, 99, 111, 110, 116, 97, 105, 110, 115, 32, 99, 111, 110, 102, 108, 105, 99, 116, 105, 110, 103, 32, 112, 97, 99, 107, 97, 103, 101, 32, 105, 100, 101, 110, 116, 105, 116, 105, 101, 115, 10, 32, 32, 104, 101, 108, 112, 58, 32, 97, 108, 105, 103, 110, 32, 118, 101, 114, 115, 105, 111, 110, 115, 32, 115, 111, 32, 101, 97, 99, 104, 32, 112, 97, 99, 107, 97, 103, 101, 32, 110, 97, 109, 101, 32, 114, 101, 115, 111, 108, 118, 101, 115, 32, 116, 111, 32, 111, 110, 101, 32, 112, 97, 99, 107, 97, 103, 101, 10];

