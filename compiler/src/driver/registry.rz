    i64 text[30] = [101, 114, 114, 111, 114, 58, 32, 112, 97, 99, 107, 97, 103, 101, 32, 99, 111, 109, 109, 97, 110, 100, 32, 102, 97, 105, 108, 101, 100, 10];

    cli_write_stream(2, &text, 30);
    return status;
