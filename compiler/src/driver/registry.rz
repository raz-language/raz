    i64 i = 0;
    while (i < length) {
        raz_compiler_rt_arena_set(temp, i, raz_compiler_rt_arena_get(data, start + i));
        i += 1;
    }
    cli_write_arena(temp, length);
    raz_compiler_rt_arena_destroy(temp);
}

fn registry_search_command(i64 argc) -> i64 {
    if (argc != 3) {
        return 55;
    }
    i64 query = raz_compiler_rt_arena_create(4096);
    i64 resolver = raz_compiler_rt_arena_create(2097152);
    i64 base = raz_compiler_rt_arena_create(8192);
    i64 data = raz_compiler_rt_arena_create(2097152);
    i64 url = raz_compiler_rt_arena_create(16384);
    if (query == 0 || resolver == 0 || base == 0 || data == 0 || url == 0) {
        return 40;
    }
    i64 ql = raz_compiler_rt_process_arg(2, query, 4096);
    if (ql <= 0) {
        return 55;
    }
    i64 base_length = 0;
    i64 resolver_length = registry_load_index(resolver, 2097152, base, 8192, &mut base_length);
    if (resolver_length <= 0) {
        return 60;
    }
    // Local/private index layouts are not required to ship the richer search
    // projection. Fall back to the resolver index in that case.
    if (base_length <= 0 || registry_offline()) {
        raz_compiler_rt_arena_destroy(query);
        raz_compiler_rt_arena_destroy(resolver);
        raz_compiler_rt_arena_destroy(base);
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(url);
        return registry_search_index_fallback(argc);
    }
    i64 suffix = raz_compiler_rt_arena_create(10);
    if (suffix == 0) {
        return 40;
    }
    i64 sb[10] = [115, 101, 97, 114, 99, 104, 46, 116, 120, 116];
    i64 i = 0;
    while (i < 10) {
        raz_compiler_rt_arena_set(suffix, i, sb[i]);
        i += 1;
    }
    i64 ul = registry_join_url(base, base_length, suffix, 0, 10, url, 16384);
    i64 length = registry_http_get(url, ul, data, 2097152);
    raz_compiler_rt_arena_destroy(suffix);
    if (length <= 0) {
        raz_compiler_rt_arena_destroy(query);
        raz_compiler_rt_arena_destroy(resolver);
        raz_compiler_rt_arena_destroy(base);
        raz_compiler_rt_arena_destroy(data);
        raz_compiler_rt_arena_destroy(url);
        return registry_search_index_fallback(argc);
    }
    i64 cursor = 0;
    i64 matches = 0;
    while (cursor < length) {
        i64 start = cursor;
        while (cursor < length && raz_compiler_rt_arena_get(data, cursor) != 10 && raz_compiler_rt_arena_get(data, cursor) != 13) {
            cursor += 1;
        }
        i64 end = cursor;
        while (cursor < length && (raz_compiler_rt_arena_get(data, cursor) == 10 || raz_compiler_rt_arena_get(data, cursor) == 13)) {
            cursor += 1;
        }
        i64 ns = 0; i64 nl = 0;
        i64 vs = 0; i64 vl = 0;
        i64 os = 0; i64 ol = 0;
        i64 ds = 0; i64 dl = 0;
        if (
            registry_tab_field(data, start, end, 0, &mut ns, &mut nl) &&
            registry_tab_field(data, start, end, 1, &mut vs, &mut vl) &&
            registry_tab_field(data, start, end, 2, &mut os, &mut ol) &&
            registry_tab_field(data, start, end, 3, &mut ds, &mut dl) &&
            (
                registry_contains_folded(data, ns, nl, query, ql) ||
                registry_contains_folded(data, os, ol, query, ql) ||
                registry_contains_folded(data, ds, dl, query, ql)
            )
        ) {
            registry_write_slice(data, ns, nl);
            i64 at[1] = [64]; cli_write(&at, 1);
            registry_write_slice(data, vs, vl);
            if (dl > 0) {
                i64 sep[3] = [32, 32, 45]; cli_write(&sep, 3);
                i64 space[1] = [32]; cli_write(&space, 1);
                registry_write_slice(data, ds, dl);
            }
            if (ol > 0) {
                i64 owner_open[10] = [32, 32, 91, 111, 119, 110, 101, 114, 115, 58]; cli_write(&owner_open, 10);
                i64 space[1] = [32]; cli_write(&space, 1);
                registry_write_slice(data, os, ol);
                i64 close[1] = [93]; cli_write(&close, 1);
            }
            i64 newline[1] = [10]; cli_write(&newline, 1);
            matches += 1;
        }
    }
    if (matches == 0) {
        i64 none[19] = [78,111,32,112,97,99,107,97,103,101,115,32,102,111,117,110,100,46,10];
        cli_write(&none, 19);
    }
