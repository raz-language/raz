    i64 publish_key[24] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 80, 85, 66, 76, 73, 83, 72, 95, 68, 73, 82];
    i64 registry_key[16] = [82, 65, 90, 95, 82, 69, 71, 73, 83, 84, 82, 89, 95, 85, 82, 76];
    i64 local = registry_env_ascii(&publish_key, 24, value, 8192);
    i64 remote = registry_env_ascii(&registry_key, 16, value, 8192);

    raz_compiler_rt_arena_destroy(value);
    return local <= 0 && remote <= 0;
}

fn registry_official_publish_metadata() -> i64 {
