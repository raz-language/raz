    i64 lk[7] = [108, 105, 99, 101, 110, 115, 101];
    i64 kl = package_manifest_field(manifest, length, &kk, 4, kind, 64);
    i64 dl = package_manifest_field(manifest, length, &dk, 11, description, 256);
    i64 ll = package_manifest_field(manifest, length, &lk, 7, license, 128);
    i64 library[7] = [108, 105, 98, 114, 97, 114, 121];
