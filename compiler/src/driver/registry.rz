fn registry_tab_field(i64 data, i64 start, i64 end, i64 ordinal, i64&mut out_start, i64&mut out_length) -> bool {
    i64 field = 0;
    i64 cursor = start;
    i64 fs = start;
    while (cursor <= end) {
        bool boundary = cursor == end;
        if (!boundary) {
            boundary = raz_compiler_rt_arena_get(data, cursor) == 9;
        }
        if (boundary) {
            if (field == ordinal) {
                *out_start = fs;
                *out_length = cursor - fs;
                return true;
            }
            field += 1;
            fs = cursor + 1;
        }
        cursor += 1;
    }
    return false;
}

fn registry_write_slice(i64 data, i64 start, i64 length) {
    if (length <= 0) {
