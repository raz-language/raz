namespace raz_compiler_driver_commands;
public import raz_compiler_driver_registry_vendor;
// Keep non-compilation command routing out of the compiler entrypoint.  The
// dispatcher owns command-specific arity and package-status reporting while
// main.rz remains focused on the compilation pipeline.
fn driver_command_dispatch(i64 process_argc, i64 cli_command, bool&mut handled) -> i64 {
    *handled = true;
    if (cli_command == 7) {
        if (process_argc != 2) {
            cli_print_invalid_arguments();
            return 2;
        }
        cli_print_backends();
        return 0;
    }
    if (cli_command == 8) {
        if (process_argc != 2) {
            cli_print_invalid_arguments();
            return 2;
        }
        cli_print_targets();
        return 0;
    }
    if (cli_command == 9) {
        if (process_argc != 2) {
            cli_print_invalid_arguments();
            return 2;
        }
        cli_print_doctor();
        return 0;
    }
    if (cli_command == 13) {
        if (process_argc != 2) {
            cli_print_invalid_arguments();
            return 2;
        }
        return cli_clean_project();
    }
    if (cli_command == 14) {
        if (process_argc != 2) {
            cli_print_invalid_arguments();
            return 2;
        }
        return cli_init_project();
    }
    if (cli_command == 15) {
        return cli_new_project(process_argc);
    }
    if (package_workspace_requested(process_argc)) {
        i64 workspace_status = package_workspace_command(process_argc, cli_command);

        if (
            cli_command == 22 ||
            cli_command == 23 ||
            cli_command == 24 ||
            cli_command == 25 ||
            cli_command == 30 ||
            cli_command == 34
        ) {
            return registry_report_status(workspace_status);
        }
        return workspace_status;
    }
    if (cli_command == 18) {
        return tooling_fmt_command(process_argc);
    }
    if (cli_command == 19) {
        return tooling_doc_command(process_argc);
    }
    if (cli_command == 20) {
        return registry_report_status(package_add_command(process_argc));
    }
    if (cli_command == 21) {
        return registry_report_status(package_remove_command(process_argc));
    }
    if (cli_command == 22) {
        return registry_report_status(package_registry_update_command());
    }
    if (cli_command == 23) {
        return registry_report_status(package_lock_command());
    }
    if (cli_command == 24) {
        return registry_report_status(package_metadata_command(false));
    }
    if (cli_command == 25 || cli_command == 34) {
        return registry_report_status(package_metadata_command(true));
    }
    if (cli_command == 26) {
        return registry_report_status(registry_command(process_argc));
    }
    if (cli_command == 27) {
        return registry_report_status(package_pack_command(process_argc));
    }
    if (cli_command == 28) {
        return registry_report_status(package_publish_command());
    }
    if (cli_command == 29) {
        return registry_report_status(signing_keygen_command(process_argc));
    }
    if (cli_command == 30) {
        return registry_report_status(package_registry_fetch_command());
    }
    if (cli_command == 31) {
        return registry_report_status(registry_search_command(process_argc));
    }
    if (cli_command == 32) {
        return registry_report_status(registry_info_command(process_argc));
    }
    if (cli_command == 33) {
        return registry_report_status(registry_outdated_command());
    }
    if (cli_command == 35) {
        return registry_report_status(package_install_command(process_argc));
    }
    if (cli_command == 36) {
        return registry_report_status(package_uninstall_command(process_argc));
    }
    if (cli_command == 37) {
        return registry_report_status(package_vendor_command(process_argc));
    }
    *handled = false;
    return 0;
}
