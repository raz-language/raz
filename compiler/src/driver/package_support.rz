namespace raz_compiler_driver_package_support;

public import raz_compiler_driver_lsp;

// Low-level byte-output helpers shared by package metadata, signing and registry
// transport. Keeping these below the high-level package/registry layers prevents
// transport utilities from pulling package resolution back into their public
// dependency spine.
fn cli_write_arena(i64 data, i64 length) {
    if (data == 0 || length <= 0) {
        return;
    }
    raz_compiler_rt_stdio_write_ascii(1, data, length);
}

fn package_manifest_path_from_root(i64 root, i64 root_length, i64 output, i64 capacity) -> i64 {
    i64 name = raz_compiler_rt_arena_create(9);

    if (name == 0) {
        return -1;
    }

    string bytes = "raz.toml";
    i64 i = 0;

    while (i<8) {
        raz_compiler_rt_arena_set(name, i, compiler_literal_byte(bytes, i));
        i += 1;
    }

    i64 result = path_join(root, root_length, name, 8, output, capacity);

    raz_compiler_rt_arena_destroy(name);
    return result;
}

fn package_manifest_field_literal(
    i64 manifest,
    i64 length,
    string key,
    i64 output,
    i64 capacity,
) -> i64 {
    i64 key_length = compiler_literal_length(key);
    i64 section = 0;
    i64 cursor = 0;
    while (cursor < length) {
        i64 start = cursor;
        while (cursor < length && raz_compiler_rt_arena_get(manifest, cursor) != 10 && raz_compiler_rt_arena_get(manifest, cursor) != 13) { cursor += 1; }
        i64 end = cursor;
        while (cursor < length && (raz_compiler_rt_arena_get(manifest, cursor) == 10 || raz_compiler_rt_arena_get(manifest, cursor) == 13)) { cursor += 1; }
        if (line_is_section(manifest, start, end, 1)) { section = 1; }
        else if (start < end && raz_compiler_rt_arena_get(manifest, start) == 91) { section = 0; }
        else if (section == 1) {
            i64 equal = start;
            while (equal < end && raz_compiler_rt_arena_get(manifest, equal) != 61) { equal += 1; }
            if (equal < end) {
                i64 ks = start; i64 ke = equal;
                while (ks < ke && ascii_is_space(raz_compiler_rt_arena_get(manifest, ks))) { ks += 1; }
                while (ke > ks && ascii_is_space(raz_compiler_rt_arena_get(manifest, ke - 1))) { ke -= 1; }
                if (ke - ks == key_length) {
                    bool same = true; i64 i = 0;
                    while (i < key_length) {
                        if (raz_compiler_rt_arena_get(manifest, ks + i) != compiler_literal_byte(key, i)) { same = false; }
                        i += 1;
                    }
                    if (same) { return copy_quoted_value(manifest, equal + 1, end, output, capacity); }
                }
            }
        }
    }
    return -1;
}

fn package_append(i64 output, i64 capacity, i64&mut cursor, i64 data, i64 start, i64 length) -> bool {
    if (*cursor + length > capacity) { return false; }
    i64 i = 0;
    while (i < length) {
        raz_compiler_rt_arena_set(output, *cursor + i, raz_compiler_rt_arena_get(data, start + i));
        i += 1;
    }
    *cursor += length;
    return true;
}

fn package_append_string_literal(i64 output, i64 capacity, i64&mut cursor, string text) -> bool {
    i64 length = compiler_literal_length(text);
    if (*cursor + length > capacity) { return false; }
    i64 i = 0;
    while (i < length) {
        raz_compiler_rt_arena_set(output, *cursor + i, compiler_literal_byte(text, i));
        i += 1;
    }
    *cursor += length;
    return true;
}

fn package_append_literal(i64 output, i64 capacity, i64&mut cursor, i64[]text, i64 length) -> bool {
    if (*cursor + length > capacity) { return false; }
    i64 i = 0;
    while (i < length) { raz_compiler_rt_arena_set(output, *cursor + i, text[i]); i += 1; }
    *cursor += length;
    return true;
}
