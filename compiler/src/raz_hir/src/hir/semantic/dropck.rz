namespace raz_hir::semantic::dropck;

public import raz_hir::core::model;

public fn hir_structure_needs_drop(HirModule& hir, i64 structure, i64 depth) -> bool {
    if (hir.drop_impl_count == 0 || structure < 0 || depth > 64) { return false; }
    if (raz_compiler_rt_arena_get(hir.struct_drop_functions, structure) >= 0) { return true; }
    i64 first = raz_compiler_rt_arena_get(hir.struct_field_starts, structure);
    i64 count = raz_compiler_rt_arena_get(hir.struct_field_counts, structure);
    i64 field = 0;
    while (field < count) {
        i64 metadata = first + field;
        if (raz_compiler_rt_arena_get(hir.struct_field_references, metadata) == 0) {
            i64 nested = raz_compiler_rt_arena_get(hir.struct_field_type_structs, metadata);
            if (nested >= 0 && hir_structure_needs_drop(hir, nested, depth + 1)) { return true; }
        }
        field += 1;
    }
    return false;
}
