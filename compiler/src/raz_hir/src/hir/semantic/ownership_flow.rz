namespace raz_hir::semantic::ownership_flow;

public import raz_hir::semantic::ownership_paths;

// Path-sensitive control-flow move analysis. This module owns per-function
// move-state propagation across blocks, branches, loops, and root statements.
fn hir_flow_local_state_capacity(HirBuilder&mut builder) -> i64 {
    return raz_compiler_rt_arena_get(builder.module.function_local_counts, builder.current_function, ) + 1;
}

fn hir_flow_parameter_state_capacity(HirBuilder&mut builder) -> i64 {
    return raz_compiler_rt_arena_get(builder.module.function_parameter_counts, builder.current_function, ) +
        1;
}

fn hir_flow_local_state_slot(HirBuilder&mut builder, i64 local) -> i64 {
    if (local < 0) {
        return -1;
    }
    return raz_compiler_rt_arena_get(builder.module.local_slots, local);
}

fn hir_flow_parameter_state_slot(HirBuilder&mut builder, i64 parameter) -> i64 {
    return parameter - raz_compiler_rt_arena_get(
        builder.module.function_parameter_starts,
        builder.current_function,
    );
}

fn hir_flow_copy_state(HirBuilder&mut builder, i64 source, i64 destination, bool locals, ) {
    i64 index = 0;
    i64 end = 0;

    if (locals) {
        end = raz_compiler_rt_arena_get(builder.module.function_local_counts, builder.current_function, );
    } else {
        end = raz_compiler_rt_arena_get(builder.module.function_parameter_counts, builder.current_function, );
    }
    while (index < end) {
        raz_compiler_rt_arena_set(destination, index, raz_compiler_rt_arena_get(source, index), );
        index += 1;
    }
}

fn hir_flow_union_state(HirBuilder&mut builder, i64 left, i64 right, i64 destination, bool locals, ) {
    i64 index = 0;
    i64 end = 0;

    if (locals) {
        end = raz_compiler_rt_arena_get(builder.module.function_local_counts, builder.current_function, );
    } else {
        end = raz_compiler_rt_arena_get(builder.module.function_parameter_counts, builder.current_function, );
    }
    while (index < end) {
        i64 moved = 0;

        if (raz_compiler_rt_arena_get(left, index) != 0 || raz_compiler_rt_arena_get(right, index) != 0) {
            moved = 1;
        }
        raz_compiler_rt_arena_set(destination, index, moved);
        index += 1;
    }
}

fn hir_flow_clear_function_state(HirBuilder&mut builder, i64 local_state, i64 parameter_state, ) {
    i64 local = 0;

    i64 local_end = raz_compiler_rt_arena_get(
        builder.module.function_local_counts,
        builder.current_function,
    );
    while (local < local_end) {
        raz_compiler_rt_arena_set(local_state, local, 0);
        local += 1;
    }

    i64 parameter = 0;

    i64 parameter_end = raz_compiler_rt_arena_get(
        builder.module.function_parameter_counts,
        builder.current_function,
    );
    while (parameter < parameter_end) {
        raz_compiler_rt_arena_set(parameter_state, parameter, 0);
        parameter += 1;
    }
}

fn hir_flow_local_index(HirBuilder&mut builder, i64 slot) -> i64 {
    return hir_local_index_from_slot(builder, slot);
}

// Plain assignment reinitializes the exact destination place. This includes
// whole values reached through a mutable reference (`move *self; *self = ...`).
fn hir_flow_reinitialize_assignment_target(
    HirBuilder&mut builder,
    i64 target,
    i64 local_state,
    i64 parameter_state,
) -> bool {
    i64 root_kind = 0;
    i64 root_index = -1;
    i64 path = 0;

    if (!hir_node_path(builder, target, &mut root_kind, &mut root_index, &mut path) || path != 0) {
        return false;
    }
    if (root_kind == 3) {
        i64 slot = hir_flow_local_state_slot(builder, root_index);

        if (slot >= 0) {
            raz_compiler_rt_arena_set(local_state, slot, 0);
            return true;
        }
    } else if (root_kind == 2) {
        i64 slot = hir_flow_parameter_state_slot(builder, root_index);

        if (slot >= 0) {
            raz_compiler_rt_arena_set(parameter_state, slot, 0);
            return true;
        }
    }
    return false;
}

fn hir_flow_check_node(HirBuilder&mut builder, i64 node, i64 local_state, i64 parameter_state) -> bool {
    if (node < 0) {
        return true;
    }

    i64 kind = raz_compiler_rt_arena_get(builder.module.node_kinds, node);

    if (kind == 2) {
        i64 parameter = raz_compiler_rt_arena_get(builder.module.node_a, node);

        if (raz_compiler_rt_arena_get(parameter_state, parameter) != 0) {
            hir_fail(builder, DiagnosticCode::UseAfterMove);
            return false;
        }
        return true;
    }
    if (kind == 3) {
        i64 local = raz_compiler_rt_arena_get(builder.module.node_a, node);

        if (raz_compiler_rt_arena_get(local_state, local) != 0) {
            hir_fail(builder, DiagnosticCode::UseAfterMove);
            return false;
        }
        return true;
    }
    if (kind == 39) {
        i64 operand = raz_compiler_rt_arena_get(builder.module.node_a, node);

        if (!hir_flow_check_node(builder, operand, local_state, parameter_state)) {
            return false;
        }

        i64 operand_structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, operand);

        bool consumes =
            operand_structure >= 0 &&
            raz_compiler_rt_arena_get(builder.module.struct_copy_flags, operand_structure) == 0;
        if (consumes) {
            i64 root_kind = 0;
            i64 root_index = -1;
            i64 path = 0;

            if (hir_node_path(builder, operand, &mut root_kind, &mut root_index, &mut path) && path == 0) {
                if (root_kind == 3) {
                    raz_compiler_rt_arena_set(
                        local_state,
                        hir_flow_local_state_slot(builder, root_index),
                        1,
                    );
                } else if (root_kind == 2) {
                    raz_compiler_rt_arena_set(
                        parameter_state,
                        hir_flow_parameter_state_slot(builder, root_index),
                        1,
                    );
                }
            }
        }
        return true;
    }
    if (kind == 4) {
        i64 first = raz_compiler_rt_arena_get(builder.module.node_b, node);
        i64 count = raz_compiler_rt_arena_get(builder.module.node_c, node);
        i64 argument = 0;

        while (argument < count) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.arguments, first + argument),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            argument += 1;
        }
        return true;
    }
    if ((kind >= 5 && kind <= 14) || kind == 19 || kind == 20 || (kind >= 23 && kind <= 28)) {
        return (
            hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_a, node),
                local_state,
                parameter_state,
            ) &&
            hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_b, node),
                local_state,
                parameter_state,
            )
        );
    }
    if (
        kind == 16 ||
        kind == 17 ||
        kind == 18 ||
        kind == 21 ||
        kind == 29 ||
        kind == 31 ||
        kind == 37 ||
        kind == 38 ||
        kind == 41 ||
        kind == 44 ||
        kind == 45 ||
        kind == 48 ||
        kind == 50 ||
        kind == 52
    ) {
        return hir_flow_check_node(
            builder,
            raz_compiler_rt_arena_get(builder.module.node_a, node),
            local_state,
            parameter_state,
        );
    }
    if (kind == 22) {
        return (
            hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_a, node),
                local_state,
                parameter_state,
            ) &&
            hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_b, node),
                local_state,
                parameter_state,
            )
        );
    }
    if (kind == 33) {
        i64 first = raz_compiler_rt_arena_get(builder.module.node_c, node);
        i64 count = raz_compiler_rt_arena_get(builder.module.node_values, node);
        i64 argument = 0;

        while (argument < count) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.arguments, first + argument),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            argument += 1;
        }
        return true;
    }
    if (kind == 34) {
        i64 first = raz_compiler_rt_arena_get(builder.module.node_b, node);
        i64 count = raz_compiler_rt_arena_get(builder.module.node_c, node);
        i64 argument = 0;

        while (argument < count) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.arguments, first + argument),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            argument += 1;
        }
        return true;
    }
    if (kind == 49) {
        if (
            !hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_a, node),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }

        i64 first = raz_compiler_rt_arena_get(builder.module.node_b, node);
        i64 count = raz_compiler_rt_arena_get(builder.module.node_c, node);
        i64 argument = 0;

        while (argument < count) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.arguments, first + argument),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            argument += 1;
        }
        return true;
    }
    if (kind == 51) {
        if (
            !hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_a, node),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }

        i64 packed = raz_compiler_rt_arena_get(builder.module.node_values, node);
        i64 count = packed & 65535;
        i64 dispatch_start = raz_compiler_rt_arena_get(builder.module.node_c, node);
        i64 first = dispatch_start - count;
        i64 argument = 0;

        while (argument < count) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.arguments, first + argument),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            argument += 1;
        }
        return true;
    }
    return true;
}

fn hir_flow_block_falls_through(HirBuilder&mut builder, i64 block) -> bool {
    if (block < 0) {
        return true;
    }
    i64 start = raz_compiler_rt_arena_get(builder.module.block_statement_starts, block);
    i64 end = start + raz_compiler_rt_arena_get(builder.module.block_statement_counts, block);
    i64 statement = start;

    while (statement < end) {
        i64 kind = raz_compiler_rt_arena_get(builder.module.statement_kinds, statement);

        if (kind == 2 || kind == 11 || kind == 12) {
            return false;
        }
        if (kind == 14) {
            if (!hir_flow_block_falls_through(builder, raz_compiler_rt_arena_get(builder.module.statement_a, statement))) {
                return false;
            }
        } else if (kind == 7) {
            i64 then_block = raz_compiler_rt_arena_get(builder.module.statement_b, statement);
            i64 else_block = raz_compiler_rt_arena_get(builder.module.statement_c, statement);

            if (
                else_block >= 0 &&
                !hir_flow_block_falls_through(builder, then_block) &&
                !hir_flow_block_falls_through(builder, else_block)
            ) {
                return false;
            }
        } else if (kind == 15) {
            i64 arm = raz_compiler_rt_arena_get(builder.module.statement_b, statement);
            i64 arm_end = arm + raz_compiler_rt_arena_get(builder.module.statement_c, statement);
            bool any_falls_through = false;

            while (arm < arm_end) {
                if (hir_flow_block_falls_through(builder, raz_compiler_rt_arena_get(builder.module.match_arm_blocks, arm))) {
                    any_falls_through = true;
                    break;
                }
                arm += 1;
            }
            if (!any_falls_through) {
                return false;
            }
        }
        statement += 1;
    }
    return true;
}

fn hir_flow_check_block(HirBuilder&mut builder, i64 block, i64 local_state, i64 parameter_state) -> bool {
    i64 start = raz_compiler_rt_arena_get(builder.module.block_statement_starts, block);
    i64 end = start + raz_compiler_rt_arena_get(builder.module.block_statement_counts, block);
    i64 statement = start;

    while (statement < end) {
        i64 kind = raz_compiler_rt_arena_get(builder.module.statement_kinds, statement);

        if (kind == 7) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }

            i64 entry_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
            i64 entry_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));
            i64 left_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
            i64 left_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));

            if (entry_locals == 0 || entry_parameters == 0 || left_locals == 0 || left_parameters == 0) {
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }
            hir_flow_copy_state(builder, local_state, entry_locals, true);
            hir_flow_copy_state(builder, parameter_state, entry_parameters, false);
            if (
                !hir_flow_check_block(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.statement_b, statement),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            hir_flow_copy_state(builder, local_state, left_locals, true);
            hir_flow_copy_state(builder, parameter_state, left_parameters, false);
            bool then_falls_through = hir_flow_block_falls_through(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_b, statement)
            );
            hir_flow_copy_state(builder, entry_locals, local_state, true);
            hir_flow_copy_state(builder, entry_parameters, parameter_state, false);

            i64 else_block = raz_compiler_rt_arena_get(builder.module.statement_c, statement);
            bool else_falls_through = true;

            if (else_block >= 0) {
                if (!hir_flow_check_block(builder, else_block, local_state, parameter_state)) {
                    return false;
                }
                else_falls_through = hir_flow_block_falls_through(builder, else_block);
            }
            if (then_falls_through && else_falls_through) {
                hir_flow_union_state(builder, left_locals, local_state, local_state, true);
                hir_flow_union_state(builder, left_parameters, parameter_state, parameter_state, false, );
            } else if (then_falls_through) {
                hir_flow_copy_state(builder, left_locals, local_state, true);
                hir_flow_copy_state(builder, left_parameters, parameter_state, false);
            } else if (!else_falls_through) {
                hir_flow_copy_state(builder, entry_locals, local_state, true);
                hir_flow_copy_state(builder, entry_parameters, parameter_state, false);
            }
            raz_compiler_rt_arena_destroy(entry_locals);
            raz_compiler_rt_arena_destroy(entry_parameters);
            raz_compiler_rt_arena_destroy(left_locals);
            raz_compiler_rt_arena_destroy(left_parameters);
        } else if (kind == 6) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }

            i64 entry_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
            i64 entry_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));

            if (entry_locals == 0 || entry_parameters == 0) {
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }
            hir_flow_copy_state(builder, local_state, entry_locals, true);
            hir_flow_copy_state(builder, parameter_state, entry_parameters, false);
            if (
                !hir_flow_check_block(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.statement_b, statement),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            hir_flow_union_state(builder, entry_locals, local_state, local_state, true);
            hir_flow_union_state(builder, entry_parameters, parameter_state, parameter_state, false, );
            raz_compiler_rt_arena_destroy(entry_locals);
            raz_compiler_rt_arena_destroy(entry_parameters);
        } else if (kind == 15) {
            if (
                !hir_flow_check_node(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }

            i64 entry_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
            i64 entry_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));
            i64 merged_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
            i64 merged_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));

            if (entry_locals == 0 || entry_parameters == 0 || merged_locals == 0 || merged_parameters == 0) {
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }
            hir_flow_copy_state(builder, local_state, entry_locals, true);
            hir_flow_copy_state(builder, parameter_state, entry_parameters, false);

            i64 arm = raz_compiler_rt_arena_get(builder.module.statement_b, statement);
            i64 arm_end = arm + raz_compiler_rt_arena_get(builder.module.statement_c, statement);
            bool first = true;

            while (arm < arm_end) {
                hir_flow_copy_state(builder, entry_locals, local_state, true);
                hir_flow_copy_state(builder, entry_parameters, parameter_state, false);
                i64 arm_guard = raz_compiler_rt_arena_get(builder.module.match_arm_guards, arm);
                if (arm_guard >= 0 && !hir_flow_check_node(builder, arm_guard, local_state, parameter_state)) {
                    return false;
                }
                if (
                    !hir_flow_check_block(
                        builder,
                        raz_compiler_rt_arena_get(builder.module.match_arm_blocks, arm),
                        local_state,
                        parameter_state,
                    )
                ) {
                    return false;
                }
                if (hir_flow_block_falls_through(builder, raz_compiler_rt_arena_get(builder.module.match_arm_blocks, arm))) {
                    if (first) {
                        hir_flow_copy_state(builder, local_state, merged_locals, true);
                        hir_flow_copy_state(builder, parameter_state, merged_parameters, false);
                        first = false;
                    } else {
                        hir_flow_union_state(builder, merged_locals, local_state, merged_locals, true, );
                        hir_flow_union_state(
                            builder,
                            merged_parameters,
                            parameter_state,
                            merged_parameters,
                            false,
                        );
                    }
                }
                arm += 1;
            }
            if (!first) {
                hir_flow_copy_state(builder, merged_locals, local_state, true);
                hir_flow_copy_state(builder, merged_parameters, parameter_state, false);
            } else {
                hir_flow_copy_state(builder, entry_locals, local_state, true);
                hir_flow_copy_state(builder, entry_parameters, parameter_state, false);
            }
            raz_compiler_rt_arena_destroy(entry_locals);
            raz_compiler_rt_arena_destroy(entry_parameters);
            raz_compiler_rt_arena_destroy(merged_locals);
            raz_compiler_rt_arena_destroy(merged_parameters);
        } else if (kind == 14) {
            if (
                !hir_flow_check_block(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
        } else if (kind == 1 || kind == 8 || kind == 9 || kind == 10) {
            i64 value = raz_compiler_rt_arena_get(builder.module.statement_b, statement);

            if (value >= 0 && !hir_flow_check_node(builder, value, local_state, parameter_state)) {
                return false;
            }

            i64 local = -1;

            if (kind == 1) {
                local = hir_flow_local_index(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                );
            } else {
                local = raz_compiler_rt_arena_get(builder.module.statement_c, statement);
            }
            if (local >= 0) {
                raz_compiler_rt_arena_set(local_state, hir_flow_local_state_slot(builder, local), 0);
            }
        } else if (kind == 4) {
            i64 value = raz_compiler_rt_arena_get(builder.module.statement_b, statement);

            if (!hir_flow_check_node(builder, value, local_state, parameter_state)) {
                return false;
            }

            i64 target = raz_compiler_rt_arena_get(builder.module.statement_a, statement);
            i64 operation = raz_compiler_rt_arena_get(builder.module.statement_c, statement);

            if (
                operation == 0 &&
                hir_flow_reinitialize_assignment_target(builder, target, local_state, parameter_state)
            ) {
                // Assignment writes new storage; it does not read the moved destination.
            } else if (!hir_flow_check_node(builder, target, local_state, parameter_state)) {
                return false;
            }
        } else if (kind == 2 || kind == 5) {
            i64 node = raz_compiler_rt_arena_get(builder.module.statement_a, statement);

            if (node >= 0 && !hir_flow_check_node(builder, node, local_state, parameter_state)) {
                return false;
            }
        }
        statement += 1;
    }
    return true;
}

fn hir_flow_check_root_statement(
    HirBuilder&mut builder,
    i64 statement,
    i64 local_state,
    i64 parameter_state,
) -> bool {
    i64 kind = raz_compiler_rt_arena_get(builder.module.statement_kinds, statement);

    if (kind == 7) {
        if (
            !hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }

        i64 entry_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
        i64 entry_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));
        i64 left_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
        i64 left_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));

        if (entry_locals == 0 || entry_parameters == 0 || left_locals == 0 || left_parameters == 0) {
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
        }
        hir_flow_copy_state(builder, local_state, entry_locals, true);
        hir_flow_copy_state(builder, parameter_state, entry_parameters, false);
        if (
            !hir_flow_check_block(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_b, statement),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }
        hir_flow_copy_state(builder, local_state, left_locals, true);
        hir_flow_copy_state(builder, parameter_state, left_parameters, false);
        bool then_falls_through = hir_flow_block_falls_through(
            builder,
            raz_compiler_rt_arena_get(builder.module.statement_b, statement)
        );
        hir_flow_copy_state(builder, entry_locals, local_state, true);
        hir_flow_copy_state(builder, entry_parameters, parameter_state, false);

        i64 else_block = raz_compiler_rt_arena_get(builder.module.statement_c, statement);
        bool else_falls_through = true;

        if (else_block >= 0) {
            if (!hir_flow_check_block(builder, else_block, local_state, parameter_state)) {
                return false;
            }
            else_falls_through = hir_flow_block_falls_through(builder, else_block);
        }
        if (then_falls_through && else_falls_through) {
            hir_flow_union_state(builder, left_locals, local_state, local_state, true);
            hir_flow_union_state(builder, left_parameters, parameter_state, parameter_state, false, );
        } else if (then_falls_through) {
            hir_flow_copy_state(builder, left_locals, local_state, true);
            hir_flow_copy_state(builder, left_parameters, parameter_state, false);
        } else if (!else_falls_through) {
            hir_flow_copy_state(builder, entry_locals, local_state, true);
            hir_flow_copy_state(builder, entry_parameters, parameter_state, false);
        }
        raz_compiler_rt_arena_destroy(entry_locals);
        raz_compiler_rt_arena_destroy(entry_parameters);
        raz_compiler_rt_arena_destroy(left_locals);
        raz_compiler_rt_arena_destroy(left_parameters);
        return true;
    }
    if (kind == 6) {
        if (
            !hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }

        i64 entry_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
        i64 entry_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));

        if (entry_locals == 0 || entry_parameters == 0) {
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
        }
        hir_flow_copy_state(builder, local_state, entry_locals, true);
        hir_flow_copy_state(builder, parameter_state, entry_parameters, false);
        if (
            !hir_flow_check_block(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_b, statement),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }
        hir_flow_union_state(builder, entry_locals, local_state, local_state, true);
        hir_flow_union_state(builder, entry_parameters, parameter_state, parameter_state, false, );
        raz_compiler_rt_arena_destroy(entry_locals);
        raz_compiler_rt_arena_destroy(entry_parameters);
        return true;
    }
    if (kind == 15) {
        if (
            !hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_a, statement),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }

        i64 entry_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
        i64 entry_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));
        i64 merged_locals = raz_compiler_rt_arena_create(hir_flow_local_state_capacity(builder));
        i64 merged_parameters = raz_compiler_rt_arena_create(hir_flow_parameter_state_capacity(builder));

        if (entry_locals == 0 || entry_parameters == 0 || merged_locals == 0 || merged_parameters == 0) {
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
        }
        hir_flow_copy_state(builder, local_state, entry_locals, true);
        hir_flow_copy_state(builder, parameter_state, entry_parameters, false);

        i64 arm = raz_compiler_rt_arena_get(builder.module.statement_b, statement);
        i64 arm_end = arm + raz_compiler_rt_arena_get(builder.module.statement_c, statement);
        bool first = true;

        while (arm < arm_end) {
            hir_flow_copy_state(builder, entry_locals, local_state, true);
            hir_flow_copy_state(builder, entry_parameters, parameter_state, false);
            if (
                !hir_flow_check_block(
                    builder,
                    raz_compiler_rt_arena_get(builder.module.match_arm_blocks, arm),
                    local_state,
                    parameter_state,
                )
            ) {
                return false;
            }
            if (hir_flow_block_falls_through(builder, raz_compiler_rt_arena_get(builder.module.match_arm_blocks, arm))) {
                if (first) {
                    hir_flow_copy_state(builder, local_state, merged_locals, true);
                    hir_flow_copy_state(builder, parameter_state, merged_parameters, false);
                    first = false;
                } else {
                    hir_flow_union_state(builder, merged_locals, local_state, merged_locals, true);
                    hir_flow_union_state(builder, merged_parameters, parameter_state, merged_parameters, false, );
                }
            }
            arm += 1;
        }
        if (!first) {
            hir_flow_copy_state(builder, merged_locals, local_state, true);
            hir_flow_copy_state(builder, merged_parameters, parameter_state, false);
        } else {
            hir_flow_copy_state(builder, entry_locals, local_state, true);
            hir_flow_copy_state(builder, entry_parameters, parameter_state, false);
        }
        raz_compiler_rt_arena_destroy(entry_locals);
        raz_compiler_rt_arena_destroy(entry_parameters);
        raz_compiler_rt_arena_destroy(merged_locals);
        raz_compiler_rt_arena_destroy(merged_parameters);
        return true;
    }
    if (kind == 14) {
        return hir_flow_check_block(
            builder,
            raz_compiler_rt_arena_get(builder.module.statement_a, statement),
            local_state,
            parameter_state,
        );
    }
    if (kind == 1 || kind == 8 || kind == 9 || kind == 10) {
        i64 value = raz_compiler_rt_arena_get(builder.module.statement_b, statement);

        if (value >= 0 && !hir_flow_check_node(builder, value, local_state, parameter_state)) {
            return false;
        }

        i64 local = -1;

        if (kind == 1) {
            local = hir_flow_local_index(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_a, statement),
            );
        } else {
            local = raz_compiler_rt_arena_get(builder.module.statement_c, statement);
        }
        if (local >= 0) {
            raz_compiler_rt_arena_set(local_state, hir_flow_local_state_slot(builder, local), 0);
        }
        return true;
    }
    if (kind == 4) {
        if (
            !hir_flow_check_node(
                builder,
                raz_compiler_rt_arena_get(builder.module.statement_b, statement),
                local_state,
                parameter_state,
            )
        ) {
            return false;
        }

        i64 target = raz_compiler_rt_arena_get(builder.module.statement_a, statement);
        i64 operation = raz_compiler_rt_arena_get(builder.module.statement_c, statement);

        if (
            operation == 0 &&
            hir_flow_reinitialize_assignment_target(builder, target, local_state, parameter_state)
        ) {
            return true;
        }
        return hir_flow_check_node(builder, target, local_state, parameter_state);
    }
    if (kind == 2 || kind == 5) {
        i64 node = raz_compiler_rt_arena_get(builder.module.statement_a, statement);

        if (node >= 0) {
            return hir_flow_check_node(builder, node, local_state, parameter_state);
        }
    }
    return true;
}

fn hir_validate_control_flow_moves(HirBuilder&mut builder) -> bool {
    i64 max_local_count = 0;
    i64 max_parameter_count = 0;
    i64 capacity_function = 0;

    while (capacity_function < builder.module.function_count) {
        i64 local_count = raz_compiler_rt_arena_get(
            builder.module.function_local_counts,
            capacity_function,
        );
        i64 parameter_count = raz_compiler_rt_arena_get(
            builder.module.function_parameter_counts,
            capacity_function,
        );
        if (local_count > max_local_count) {
            max_local_count = local_count;
        }
        if (parameter_count > max_parameter_count) {
            max_parameter_count = parameter_count;
        }
        capacity_function += 1;
    }

    i64 local_state = raz_compiler_rt_arena_create(max_local_count + 1);
    i64 parameter_state = raz_compiler_rt_arena_create(max_parameter_count + 1);
    i64 root_heads = raz_compiler_rt_arena_create(builder.module.function_count + 1);
    i64 root_tails = raz_compiler_rt_arena_create(builder.module.function_count + 1);
    i64 root_next = raz_compiler_rt_arena_create(builder.module.statement_count + 1);

    if (local_state == 0 || parameter_state == 0 || root_heads == 0 || root_tails == 0 || root_next == 0) {
        if (local_state != 0) {
            raz_compiler_rt_arena_destroy(local_state);
        }
        if (parameter_state != 0) {
            raz_compiler_rt_arena_destroy(parameter_state);
        }
        if (root_heads != 0) {
            raz_compiler_rt_arena_destroy(root_heads);
        }
        if (root_tails != 0) {
            raz_compiler_rt_arena_destroy(root_tails);
        }
        if (root_next != 0) {
            raz_compiler_rt_arena_destroy(root_next);
        }
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 function_index = 0;

    while (function_index < builder.module.function_count) {
        raz_compiler_rt_arena_set(root_heads, function_index, 0);
        raz_compiler_rt_arena_set(root_tails, function_index, 0);
        function_index += 1;
    }
    // Build the per-function root-statement index once. Deferred child blocks
    // remain reachable from their root control-flow statements and therefore do
    // not need to participate in the global function scan.

    i64 statement = 0;

    while (statement < builder.module.statement_count) {
        i64 owner = raz_compiler_rt_arena_get(builder.module.statement_function_indices, statement, );

        if (
            owner >= 0 &&
            owner < builder.module.function_count &&
            raz_compiler_rt_arena_get(builder.module.statement_block_indices, statement) < 0
        ) {
            i64 tail = raz_compiler_rt_arena_get(root_tails, owner);

            raz_compiler_rt_arena_set(root_next, statement, 0);
            if (tail > 0) {
                raz_compiler_rt_arena_set(root_next, tail - 1, statement + 1);
            } else {
                raz_compiler_rt_arena_set(root_heads, owner, statement + 1);
            }
            raz_compiler_rt_arena_set(root_tails, owner, statement + 1);
        }
        statement += 1;
    }

    i64 saved_function = builder.current_function;
    i64 saved_block = builder.current_block;

    function_index = 0;
    while (function_index < builder.module.function_count) {
        builder.current_function = function_index;
        builder.current_block = -1;
        hir_flow_clear_function_state(builder, local_state, parameter_state);

        i64 root = raz_compiler_rt_arena_get(root_heads, function_index);

        while (root > 0) {
            statement = root - 1;
            if (!hir_flow_check_root_statement(builder, statement, local_state, parameter_state)) {
                builder.current_function = saved_function;
                builder.current_block = saved_block;
                raz_compiler_rt_arena_destroy(local_state);
                raz_compiler_rt_arena_destroy(parameter_state);
                raz_compiler_rt_arena_destroy(root_heads);
                raz_compiler_rt_arena_destroy(root_tails);
                raz_compiler_rt_arena_destroy(root_next);
                return false;
            }
            root = raz_compiler_rt_arena_get(root_next, statement);
        }
        function_index += 1;
    }
    builder.current_function = saved_function;
    builder.current_block = saved_block;
    raz_compiler_rt_arena_destroy(local_state);
    raz_compiler_rt_arena_destroy(parameter_state);
    raz_compiler_rt_arena_destroy(root_heads);
    raz_compiler_rt_arena_destroy(root_tails);
    raz_compiler_rt_arena_destroy(root_next);
    return true;
}
