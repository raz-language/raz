                            hir.enum_member_values,
                            raz_compiler_rt_arena_get(hir.node_b, base_node),
                        );
                        return true;
                    }
                    element_index -= 1;
                }
            } else {
                return false;
            }
            if (element_index < 0 || element_index >= argument_count) {
                return false;
            }
            return hir_eval_const_engine(
                hir,
                0,
                raz_compiler_rt_arena_get(hir.arguments, argument_start + element_index),
                0,
                locals,
                parameters,
                steps,
                depth + 1,
                0,
                out,
            );
        }
        if (kind == 43) {
            i64 condition = 0;

            if (
                !hir_eval_const_engine(
                    hir,
                    0,
                    raz_compiler_rt_arena_get(hir.node_a, node),
                    0,
                    locals,
                    parameters,
                    steps,
                    depth + 1,
                    0,
                    &mut condition,
                ) ||
                condition == 0
            ) {
                return false;
            }
            *out = 0;
            return true;
        }
        if (kind == 18 || kind == 29) {
            i64 value = 0;

            if (
                !hir_eval_const_engine(
                    hir,
                    0,
                    raz_compiler_rt_arena_get(hir.node_a, node),
                    0,
                    locals,
                    parameters,
                    steps,
                    depth + 1,
                    0,
                    &mut value,
                )
            ) {
                return false;
            }
            if (kind == 18) {
                if (value == 0) {
                    *out = 1;
                } else {
                    *out = 0;
                }
            } else {
                *out = ~value;
            }
            return true;
        }

        i64 left = 0;
        i64 right = 0;

        if (
            !hir_eval_const_engine(
                hir,
                0,
                raz_compiler_rt_arena_get(hir.node_a, node),
                0,
                locals,
                parameters,
                steps,
                depth + 1,
                0,
                &mut left,
            ) ||
            !hir_eval_const_engine(
                hir,
                0,
                raz_compiler_rt_arena_get(hir.node_b, node),
                0,
                locals,
                parameters,
                steps,
                depth + 1,
                0,
                &mut right,
            )
        ) {
            return false;
        }
        if (kind == 5) {
            *out = left + right;
            return true;
        }
        if (kind == 6) {
            *out = left - right;
            return true;
        }
        if (kind == 7) {
            *out = left * right;
            return true;
        }
        if (kind == 8) {
            if (right == 0) {
                return false;
            }
            *out = left / right;
            return true;
        }
        if (kind == 9) {
            if (left == right) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 10) {
            if (left != right) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 11) {
            if (left < right) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 12) {
            if (left <= right) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 13) {
            if (left > right) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 14) {
            if (left >= right) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 19) {
            if (left != 0 && right != 0) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 20) {
            if (left != 0 || right != 0) {
                *out = 1;
            } else {
                *out = 0;
            }
            return true;
        }
        if (kind == 23) {
            if (right == 0) {
                return false;
            }
            *out = left % right;
            return true;
        }
        if (kind == 24) {
            *out = left & right;
            return true;
        }
        if (kind == 25) {
            *out = left | right;
            return true;
        }
        if (kind == 26) {
            *out = left ^ right;
            return true;
        }
        if (kind == 27) {
            *out = left << right;
            return true;
        }
        if (kind == 28) {
            *out = left >> right;
            return true;
        }
        return false;
