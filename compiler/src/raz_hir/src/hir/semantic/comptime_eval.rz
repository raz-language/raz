        i64 statement = item;
        i64 end = item + count;

        while (statement < end) {
            i64 current_steps = raz_compiler_rt_arena_get(steps, 0) + 1;

            raz_compiler_rt_arena_set(steps, 0, current_steps);
            if (current_steps > 100000) {
                return false;
            }

            i64 kind = raz_compiler_rt_arena_get(hir.statement_kinds, statement);

            if (kind == 9) {
                i64 stored = 0;

                if (
                    !hir_comptime_materialize_array_local(
