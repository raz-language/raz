namespace raz_hir::semantic::comptime_eval;

public import raz_hir::traits::solver;

// Deterministic compile-time evaluation engine. This module owns constexpr value
// materialization, comptime block execution, assignment/projection semantics, and
// constant folding. Parsing/directive orchestration remains in comptime.rz.
// Deterministic compile-time evaluation and reflection. Comptime code must never
// depend on ambient process state that would make builds irreproducible.
// Aggregate constexpr values start as immutable handles into HIR construction nodes.
// Mutable comptime locals are materialized into private arenas so nested field/index
// assignments never mutate the source HIR or alias unrelated evaluations.
fn hir_apply_comptime_assignment(i64 operation, i64 current, i64 value, i64&mut out) -> bool {
    if (operation == 0) {
        *out = value;
        return true;
    }
    if (operation == 1) {
        *out = current + value;
        return true;
    }
    if (operation == 2) {
        *out = current - value;
        return true;
    }
    if (operation == 3) {
        *out = current * value;
        return true;
    }
    if (operation == 4) {
        if (value == 0) {
            return false;
        }
        *out = current / value;
        return true;
    }
    if (operation == 5) {
        if (value == 0) {
            return false;
        }
        *out = current % value;
        return true;
    }
    if (operation == 6) {
        *out = current & value;
        return true;
    }
    if (operation == 7) {
        *out = current | value;
        return true;
    }
    if (operation == 8) {
        *out = current ^ value;
        return true;
    }
    if (operation == 9) {
        *out = current << value;
        return true;
    }
    if (operation == 10) {
        *out = current >> value;
        return true;
    }
    return false;
}

fn hir_comptime_values_equal(HirModule& hir, i64 left, i64 right, i64 locals, i64 depth) -> bool {
    i64 source_tag = 1152921504606846976;
    i64 mutable_tag = 2305843009213693952;
    bool left_aggregate = left >= source_tag;
    bool right_aggregate = right >= source_tag;

    if (!left_aggregate || !right_aggregate) {
        return left == right;
    }
    if (depth > 128) {
        return false;
    }
    // hir_eval_comptime_node materializes aggregate expressions before they reach
    // equality, so recursive comparison only needs compiler-owned mutable arenas.
    if (left < mutable_tag || right < mutable_tag) {
        return left == right;
    }

    i64 left_storage = left - mutable_tag;
    i64 right_storage = right - mutable_tag;
    i64 left_kind = raz_compiler_rt_arena_get(left_storage, 0);
    i64 right_kind = raz_compiler_rt_arena_get(right_storage, 0);
    i64 left_count = raz_compiler_rt_arena_get(left_storage, 1);
    i64 right_count = raz_compiler_rt_arena_get(right_storage, 1);

    if (left_kind != right_kind || left_count != right_count) {
        return false;
    }

    i64 index = 0;

    while (index < left_count) {
        i64 left_value = raz_compiler_rt_arena_get(left_storage, 2 + index);
        i64 right_value = raz_compiler_rt_arena_get(right_storage, 2 + index);

        if (!hir_comptime_values_equal(hir, left_value, right_value, locals, depth + 1)) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn hir_eval_comptime_node(HirModule& hir, i64 node, i64 locals, i64 depth, i64&mut out) -> bool {
    if (node < 0 || node >= hir.node_count || depth > 512) {
        return false;
    }

    i64 kind = raz_compiler_rt_arena_get(hir.node_kinds, node);

    if (kind == 1 || kind == 46) {
        // String literals and reflected names carry a deterministic content hash
        // in node_values so comptime equality does not depend on runtime pointers.
        *out = raz_compiler_rt_arena_get(hir.node_values, node);
        return true;
    }
    if (kind == 3) {
        *out = raz_compiler_rt_arena_get(locals, raz_compiler_rt_arena_get(hir.node_a, node));
        return true;
    }
    if (kind == 31) {
        return hir_eval_comptime_node(
            hir,
            raz_compiler_rt_arena_get(hir.node_a, node),
            locals,
            depth + 1,
            out,
        );
    }
    if (kind == 33 || kind == 34 || kind == 53) {
        i64 start = 0;
        i64 count = 0;
        i64 prefix = 0;

        if (kind == 34) {
            start = raz_compiler_rt_arena_get(hir.node_b, node);
            count = raz_compiler_rt_arena_get(hir.node_c, node);
        } else if (kind == 53) {
            start = raz_compiler_rt_arena_get(hir.node_a, node);
            count = raz_compiler_rt_arena_get(hir.node_b, node);
        } else {
            start = raz_compiler_rt_arena_get(hir.node_c, node);
            count = raz_compiler_rt_arena_get(hir.node_values, node);
            prefix = 1;
        }

        i64 storage = raz_compiler_rt_arena_create(count + prefix + 2);

        if (storage == 0) {
            return false;
        }
        raz_compiler_rt_arena_set(storage, 0, kind);
        raz_compiler_rt_arena_set(storage, 1, count + prefix);
        if (prefix != 0) {
            raz_compiler_rt_arena_set(
                storage,
                2,
                raz_compiler_rt_arena_get(hir.enum_member_values, raz_compiler_rt_arena_get(hir.node_b, node)),
            );
        }

        i64 index = 0;

        while (index < count) {
            i64 child = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.arguments, start + index),
                    locals,
                    depth + 1,
                    &mut child,
                )
            ) {
                return false;
            }
            raz_compiler_rt_arena_set(storage, 2 + prefix + index, child);
            index += 1;
        }
        *out = 2305843009213693952 + storage;
        return true;
    }
    if (kind == 16 || kind == 22) {
        i64 base_value = 0;

        if (
            !hir_eval_comptime_node(
                hir,
                raz_compiler_rt_arena_get(hir.node_a, node),
                locals,
                depth + 1,
                &mut base_value,
            ) ||
            base_value < 1152921504606846976
        ) {
            return false;
        }

        i64 element_index = 0;

        if (base_value >= 2305843009213693952) {
            i64 storage = base_value - 2305843009213693952;

            if (kind == 16) {
                element_index = raz_compiler_rt_arena_get(hir.node_b, node);
            } else if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.node_b, node),
                    locals,
                    depth + 1,
                    &mut element_index,
                )
            ) {
                return false;
            }

            i64 count = raz_compiler_rt_arena_get(storage, 1);

            if (element_index < 0 || element_index >= count) {
                return false;
            }
            *out = raz_compiler_rt_arena_get(storage, 2 + element_index);
            return true;
        }

        i64 base_node = base_value - 1152921504606846976;
        i64 base_kind = raz_compiler_rt_arena_get(hir.node_kinds, base_node);

        if (kind == 16) {
            element_index = raz_compiler_rt_arena_get(hir.node_b, node);
        } else if (
            !hir_eval_comptime_node(
                hir,
                raz_compiler_rt_arena_get(hir.node_b, node),
                locals,
                depth + 1,
                &mut element_index,
            )
        ) {
            return false;
        }

        i64 start = 0;
        i64 count = 0;

        if (base_kind == 34) {
            start = raz_compiler_rt_arena_get(hir.node_b, base_node);
            count = raz_compiler_rt_arena_get(hir.node_c, base_node);
        } else if (base_kind == 53) {
            start = raz_compiler_rt_arena_get(hir.node_a, base_node);
            count = raz_compiler_rt_arena_get(hir.node_b, base_node);
        } else if (base_kind == 33) {
            start = raz_compiler_rt_arena_get(hir.node_c, base_node);
            count = raz_compiler_rt_arena_get(hir.node_values, base_node);
            if (kind == 16) {
                if (element_index == 0) {
                    *out = raz_compiler_rt_arena_get(
                        hir.enum_member_values,
                        raz_compiler_rt_arena_get(hir.node_b, base_node),
                    );
                    return true;
                }
                element_index -= 1;
            }
        } else {
            return false;
        }
        if (element_index < 0 || element_index >= count) {
            return false;
        }
        return hir_eval_comptime_node(
            hir,
            raz_compiler_rt_arena_get(hir.arguments, start + element_index),
            locals,
            depth + 1,
            out,
        );
    }
    if (kind == 43) {
        i64 condition = 0;

        if (
            !hir_eval_comptime_node(
                hir,
                raz_compiler_rt_arena_get(hir.node_a, node),
                locals,
                depth + 1,
                &mut condition,
            ) ||
            condition == 0
        ) {
            return false;
        }
        *out = 1;
        return true;
    }
    if (kind == 18 || kind == 29) {
        i64 value = 0;

        if (
            !hir_eval_comptime_node(
                hir,
                raz_compiler_rt_arena_get(hir.node_a, node),
                locals,
                depth + 1,
                &mut value,
            )
        ) {
            return false;
        }
        if (kind == 18) {
            if (value == 0) {
                *out = 1;
            } else {
                *out = 0;
            }
        } else {
            *out = ~value;
        }
        return true;
    }

    i64 left = 0;
    i64 right = 0;

    if (
        !hir_eval_comptime_node(
            hir,
            raz_compiler_rt_arena_get(hir.node_a, node),
            locals,
            depth + 1,
            &mut left,
        ) ||
        !hir_eval_comptime_node(
            hir,
            raz_compiler_rt_arena_get(hir.node_b, node),
            locals,
            depth + 1,
            &mut right,
        )
    ) {
        return false;
    }
    if (kind == 5) {
        *out = left + right;
        return true;
    }
    if (kind == 6) {
        *out = left - right;
        return true;
    }
    if (kind == 7) {
        *out = left * right;
        return true;
    }
    if (kind == 8) {
        if (right == 0) {
            return false;
        }
        *out = left / right;
        return true;
    }
    if (kind == 9) {
        if (hir_comptime_values_equal(hir, left, right, locals, depth + 1)) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 10) {
        if (left != right) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 11) {
        if (left < right) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 12) {
        if (left <= right) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 13) {
        if (left > right) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 14) {
        if (left >= right) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 19) {
        if (left != 0 && right != 0) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 20) {
        if (left != 0 || right != 0) {
            *out = 1;
        } else {
            *out = 0;
        }
        return true;
    }
    if (kind == 23) {
        if (right == 0) {
            return false;
        }
        *out = left % right;
        return true;
    }
    if (kind == 24) {
        *out = left & right;
        return true;
    }
    if (kind == 25) {
        *out = left | right;
        return true;
    }
    if (kind == 26) {
        *out = left ^ right;
        return true;
    }
    if (kind == 27) {
        *out = left << right;
        return true;
    }
    if (kind == 28) {
        *out = left >> right;
        return true;
    }
    return false;
}

fn hir_comptime_materialize_value(HirModule& hir, i64 value, i64 locals, i64 depth, i64&mut out) -> bool {
    i64 source_tag = 1152921504606846976;
    i64 mutable_tag = 2305843009213693952;

    if (value < source_tag || value >= mutable_tag) {
        *out = value;
        return true;
    }
    if (depth > 128) {
        return false;
    }

    i64 node = value - source_tag;

    if (node < 0 || node >= hir.node_count) {
        return false;
    }
    return hir_eval_comptime_node(hir, node, locals, depth + 1, out);
}

fn hir_comptime_materialize_array_local(
    HirModule& hir,
    i64 local_index,
    i64 locals,
    i64 depth,
    i64&mut out,
) -> bool {
    if (local_index < 0 || local_index >= hir.local_count || depth > 128) {
        return false;
    }

    i64 start = raz_compiler_rt_arena_get(hir.local_array_element_starts, local_index);
    i64 count = raz_compiler_rt_arena_get(hir.local_array_element_counts, local_index);
    i64 storage = raz_compiler_rt_arena_create(count + 2);

    if (storage == 0) {
        return false;
    }
    raz_compiler_rt_arena_set(storage, 0, 53);
    raz_compiler_rt_arena_set(storage, 1, count);

    i64 index = 0;

    while (index < count) {
        i64 child = 0;

        if (
            !hir_eval_comptime_node(
                hir,
                raz_compiler_rt_arena_get(hir.array_elements, start + index),
                locals,
                depth + 1,
                &mut child,
            )
        ) {
            raz_compiler_rt_arena_destroy(storage);
            return false;
        }
        raz_compiler_rt_arena_set(storage, 2 + index, child);
        index += 1;
    }
    *out = 2305843009213693952 + storage;
    return true;
}

fn hir_comptime_projection_slot(
    HirModule& hir,
    i64 target,
    i64 locals,
    i64 depth,
    i64&mut storage,
    i64&mut slot,
) -> bool {
    i64 kind = raz_compiler_rt_arena_get(hir.node_kinds, target);

    if (kind != 16 && kind != 22) {
        return false;
    }

    i64 base = 0;

    if (
        !hir_eval_comptime_node(
            hir,
            raz_compiler_rt_arena_get(hir.node_a, target),
            locals,
            depth + 1,
            &mut base,
        )
    ) {
        return false;
    }

    i64 mutable_tag = 2305843009213693952;

    if (base < mutable_tag) {
        return false;
    }

    i64 arena = base - mutable_tag;
    i64 index = 0;

    if (kind == 16) {
        index = raz_compiler_rt_arena_get(hir.node_b, target);
    } else if (
        !hir_eval_comptime_node(
            hir,
            raz_compiler_rt_arena_get(hir.node_b, target),
            locals,
            depth + 1,
            &mut index,
        )
    ) {
        return false;
    }

    i64 count = raz_compiler_rt_arena_get(arena, 1);

    if (index < 0 || index >= count) {
        return false;
    }
    *storage = arena;
    *slot = 2 + index;
    return true;
}

fn hir_apply_comptime_target_assignment(
    HirModule& hir,
    i64 target,
    i64 operation,
    i64 value,
    i64 locals,
    i64 depth,
) -> bool {
    i64 kind = raz_compiler_rt_arena_get(hir.node_kinds, target);

    if (kind == 3) {
        i64 slot = raz_compiler_rt_arena_get(hir.node_a, target);
        i64 assigned = 0;

        if (
            !hir_apply_comptime_assignment(
                operation,
                raz_compiler_rt_arena_get(locals, slot),
                value,
                &mut assigned,
            )
        ) {
            return false;
        }
        raz_compiler_rt_arena_set(locals, slot, assigned);
        return true;
    }

    i64 storage = 0;
    i64 slot = 0;

    if (!hir_comptime_projection_slot(hir, target, locals, depth, &mut storage, &mut slot)) {
        return false;
    }

    i64 assigned = 0;

    if (
        !hir_apply_comptime_assignment(
            operation,
            raz_compiler_rt_arena_get(storage, slot),
            value,
            &mut assigned,
        )
    ) {
        return false;
    }
    raz_compiler_rt_arena_set(storage, slot, assigned);
    return true;
}

fn hir_comptime_block_may_break(HirModule& hir, i64 block, i64 depth) -> bool {
    if (block < 0 || depth > 64) {
        return false;
    }

    i64 statement = raz_compiler_rt_arena_get(hir.block_statement_starts, block);
    i64 end = statement + raz_compiler_rt_arena_get(hir.block_statement_counts, block);

    while (statement < end) {
        i64 kind = raz_compiler_rt_arena_get(hir.statement_kinds, statement);

        if (kind == 11) {
            return true;
        }
        if (kind == 14) {
            if (
                hir_comptime_block_may_break(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_a, statement),
                    depth + 1,
                )
            ) {
                return true;
            }
        } else if (kind == 7) {
            i64 then_block = raz_compiler_rt_arena_get(hir.statement_b, statement);
            i64 else_block = raz_compiler_rt_arena_get(hir.statement_c, statement);

            if (then_block >= 0 && hir_comptime_block_may_break(hir, then_block, depth + 1)) {
                return true;
            }
            if (else_block >= 0 && hir_comptime_block_may_break(hir, else_block, depth + 1)) {
                return true;
            }
        }
        // A break inside a nested loop belongs to that loop, not this one.
        statement += 1;
    }
    return false;
}

fn hir_comptime_condition_is_literal_true(HirModule& hir, i64 node) -> bool {
    return (
        node >= 0 &&
        node < hir.node_count &&
        raz_compiler_rt_arena_get(hir.node_kinds, node) == 1 &&
        raz_compiler_rt_arena_get(hir.node_c, node) == 1 &&
        raz_compiler_rt_arena_get(hir.node_values, node) != 0
    );
}

fn hir_execute_comptime_block(HirModule& hir, i64 block, i64 locals, i64 steps, i64&mut flow) -> bool {
    i64 start = raz_compiler_rt_arena_get(hir.block_statement_starts, block);
    i64 end = start + raz_compiler_rt_arena_get(hir.block_statement_counts, block);
    i64 statement = start;

    while (statement < end) {
        i64 current_steps = raz_compiler_rt_arena_get(steps, 0) + 1;

        raz_compiler_rt_arena_set(steps, 0, current_steps);
        if (current_steps > 100000) {
            return false;
        }

        i64 kind = raz_compiler_rt_arena_get(hir.statement_kinds, statement);

        if (kind == 9) {
            i64 stored = 0;

            if (
                !hir_comptime_materialize_array_local(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_c, statement),
                    locals,
                    0,
                    &mut stored,
                )
            ) {
                return false;
            }
            raz_compiler_rt_arena_set(locals, raz_compiler_rt_arena_get(hir.statement_a, statement), stored);
        } else if (kind == 8 || kind == 10) {
            i64 value = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_b, statement),
                    locals,
                    0,
                    &mut value,
                )
            ) {
                return false;
            }

            i64 stored = 0;

            if (!hir_comptime_materialize_value(hir, value, locals, 0, &mut stored)) {
                return false;
            }
            raz_compiler_rt_arena_set(locals, raz_compiler_rt_arena_get(hir.statement_a, statement), stored);
        } else if (kind == 1) {
            i64 value = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_b, statement),
                    locals,
                    0,
                    &mut value,
                )
            ) {
                return false;
            }

            i64 stored = 0;

            if (!hir_comptime_materialize_value(hir, value, locals, 0, &mut stored)) {
                return false;
            }
            raz_compiler_rt_arena_set(locals, raz_compiler_rt_arena_get(hir.statement_a, statement), stored);
        } else if (kind == 4) {
            i64 target = raz_compiler_rt_arena_get(hir.statement_a, statement);
            i64 value = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_b, statement),
                    locals,
                    0,
                    &mut value,
                )
            ) {
                return false;
            }

            i64 stored = 0;

            if (
                !hir_comptime_materialize_value(hir, value, locals, 0, &mut stored) ||
                !hir_apply_comptime_target_assignment(
                    hir,
                    target,
                    raz_compiler_rt_arena_get(hir.statement_c, statement),
                    stored,
                    locals,
                    0,
                )
            ) {
                return false;
            }
        } else if (kind == 5) {
            i64 ignored = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_a, statement),
                    locals,
                    0,
                    &mut ignored,
                )
            ) {
                return false;
            }
        } else if (kind == 18) {
            i64 condition = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_a, statement),
                    locals,
                    0,
                    &mut condition,
                ) ||
                condition == 0
            ) {
                return false;
            }
        } else if (kind == 14) {
            i64 nested_flow = 0;

            if (
                !hir_execute_comptime_block(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_a, statement),
                    locals,
                    steps,
                    &mut nested_flow,
                )
            ) {
                return false;
            }
            if (nested_flow != 0) {
                *flow = nested_flow;
                return true;
            }
        } else if (kind == 7) {
            i64 condition = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_a, statement),
                    locals,
                    0,
                    &mut condition,
                )
            ) {
                return false;
            }

            i64 selected = raz_compiler_rt_arena_get(hir.statement_b, statement);

            if (condition == 0) {
                selected = raz_compiler_rt_arena_get(hir.statement_c, statement);
            }
            if (selected >= 0) {
                i64 nested_flow = 0;

                if (!hir_execute_comptime_block(hir, selected, locals, steps, &mut nested_flow)) {
                    return false;
                }
                if (nested_flow != 0) {
                    *flow = nested_flow;
                    return true;
                }
            }
        } else if (kind == 6) {
            i64 loop_body = raz_compiler_rt_arena_get(hir.statement_b, statement);

            if (
                hir_comptime_condition_is_literal_true(
                    hir,
                    raz_compiler_rt_arena_get(hir.statement_a, statement),
                ) &&
                !hir_comptime_block_may_break(hir, loop_body, 0)
            ) {
                return false;
            }

            bool running = true;

            while (running) {
                i64 condition = 0;

                if (
                    !hir_eval_comptime_node(
                        hir,
                        raz_compiler_rt_arena_get(hir.statement_a, statement),
                        locals,
                        0,
                        &mut condition,
                    )
                ) {
                    return false;
                }
                if (condition == 0) {
                    running = false;
                } else {
                    i64 nested_flow = 0;

                    if (
                        !hir_execute_comptime_block(
                            hir,
                            raz_compiler_rt_arena_get(hir.statement_b, statement),
                            locals,
                            steps,
                            &mut nested_flow,
                        )
                    ) {
                        return false;
                    }
                    if (nested_flow == 1) {
                        running = false;
                    } else if (nested_flow != 0 && nested_flow != 2) {
                        *flow = nested_flow;
                        return true;
                    }
                }
            }
        } else if (kind == 13) {
            i64 slot = raz_compiler_rt_arena_get(hir.statement_a, statement);
            i64 range = raz_compiler_rt_arena_get(hir.statement_b, statement);
            i64 begin = 0;
            i64 finish = 0;

            if (
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.node_a, range),
                    locals,
                    0,
                    &mut begin,
                ) ||
                !hir_eval_comptime_node(
                    hir,
                    raz_compiler_rt_arena_get(hir.node_b, range),
                    locals,
                    0,
                    &mut finish,
                )
            ) {
                return false;
            }

            i64 value = begin;
            bool inclusive = raz_compiler_rt_arena_get(hir.node_c, range) != 0;
            bool running = true;

            while (running) {
                bool in_range = value < finish;

                if (inclusive) {
                    in_range = value <= finish;
                }
                if (!in_range) {
                    running = false;
                } else {
                    raz_compiler_rt_arena_set(locals, slot, value);

                    i64 nested_flow = 0;

                    if (
                        !hir_execute_comptime_block(
                            hir,
                            raz_compiler_rt_arena_get(hir.statement_c, statement),
                            locals,
                            steps,
                            &mut nested_flow,
                        )
                    ) {
                        return false;
                    }
                    if (nested_flow == 1) {
                        running = false;
                    } else if (nested_flow != 0 && nested_flow != 2) {
                        *flow = nested_flow;
                        return true;
                    }
                    value += 1;
                }
            }
        } else if (kind == 11) {
            *flow = 1;
            return true;
        } else if (kind == 12) {
            *flow = 2;
            return true;
        } else {
            return false;
        }
        statement += 1;
    }
    *flow = 0;
    return true;
}

fn hir_eval_const_engine(
    HirModule& hir,
    i64 mode,
    i64 item,
    i64 count,
    i64 locals,
    i64 parameters,
    i64 steps,
    i64 depth,
    i64 context,
    i64&mut out,
) -> bool {
    if (depth > 512) {
        return false;
    }
    if (mode == 0) {
        i64 node = item;

        if (node < 0 || node >= hir.node_count) {
            return false;
        }

        i64 kind = raz_compiler_rt_arena_get(hir.node_kinds, node);

        if (kind == 1) {
            *out = raz_compiler_rt_arena_get(hir.node_values, node);
            return true;
        }
        if (kind == 2) {
            if (parameters == 0) {
                return false;
            }
            *out = raz_compiler_rt_arena_get(parameters, raz_compiler_rt_arena_get(hir.node_a, node));
            return true;
        }
        if (kind == 3) {
            if (locals == 0) {
                return false;
            }
            *out = raz_compiler_rt_arena_get(locals, raz_compiler_rt_arena_get(hir.node_a, node));
            return true;
        }
        if (kind == 4) {
            i64 function_index = raz_compiler_rt_arena_get(hir.node_a, node);
            i64 argument_start = raz_compiler_rt_arena_get(hir.node_b, node);
            i64 argument_count = raz_compiler_rt_arena_get(hir.node_c, node);

            if (
                function_index < 0 ||
                function_index >= hir.function_count ||
                raz_compiler_rt_arena_get(hir.function_is_const, function_index) == 0 ||
                depth > 128
            ) {
                return false;
            }

            i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);

            if (parameter_count != argument_count) {
                return false;
            }

            i64 callee_parameters = raz_compiler_rt_arena_create(8192);
            i64 callee_locals = raz_compiler_rt_arena_create(8192);

            if (callee_parameters == 0 || callee_locals == 0) {
                if (callee_parameters != 0) {
                    raz_compiler_rt_arena_destroy(callee_parameters);
                }
                if (callee_locals != 0) {
                    raz_compiler_rt_arena_destroy(callee_locals);
                }
                return false;
            }

            i64 argument_index = 0;
            bool call_ok = true;

            while (call_ok && argument_index < argument_count) {
                i64 argument_value = 0;
                i64 argument = raz_compiler_rt_arena_get(hir.arguments, argument_start + argument_index);

                if (
                    !hir_eval_const_engine(
                        hir,
                        0,
                        argument,
                        0,
                        locals,
                        parameters,
                        steps,
                        depth + 1,
                        0,
                        &mut argument_value,
                    )
                ) {
                    call_ok = false;
                } else {
                    raz_compiler_rt_arena_set(callee_parameters, argument_index, argument_value);
                }
                argument_index += 1;
            }
            if (call_ok) {
                i64 callee_context = raz_compiler_rt_arena_create(5);

                if (callee_context == 0) {
                    call_ok = false;
                } else {
                    raz_compiler_rt_arena_set(callee_context, 0, callee_locals);
                    raz_compiler_rt_arena_set(callee_context, 1, callee_parameters);
                    raz_compiler_rt_arena_set(callee_context, 2, steps);
                    raz_compiler_rt_arena_set(callee_context, 3, 0);
                    raz_compiler_rt_arena_set(callee_context, 4, 0);

                    i64 start = raz_compiler_rt_arena_get(hir.function_statement_starts, function_index);

                    i64 statement_count = raz_compiler_rt_arena_get(
                        hir.function_root_statement_counts,
                        function_index,
                    );

                    i64 ignored = 0;

                    call_ok =
                        hir_eval_const_engine(
                            hir,
                            1,
                            start,
                            statement_count,
                            callee_locals,
                            callee_parameters,
                            steps,
                            depth + 1,
                            callee_context,
                            &mut ignored,
                        ) &&
                        raz_compiler_rt_arena_get(callee_context, 4) == 3;
                    if (call_ok) {
                        *out = raz_compiler_rt_arena_get(callee_context, 3);
                    }
                    raz_compiler_rt_arena_destroy(callee_context);
                }
            }
            raz_compiler_rt_arena_destroy(callee_parameters);
            raz_compiler_rt_arena_destroy(callee_locals);
            return call_ok;
        }
        if (kind == 31) {
            return hir_eval_const_engine(
                hir,
                0,
                raz_compiler_rt_arena_get(hir.node_a, node),
                0,
                locals,
                parameters,
                steps,
                depth + 1,
                0,
                out,
            );
        }
        // Aggregate constexpr values use a tagged HIR-node handle. This keeps
        // compile-time evaluation allocation-free while allowing nested
        // structs, tuples, enums and fixed arrays to flow through const fn calls.
        if (kind == 33 || kind == 34 || kind == 53) {
            *out = 1152921504606846976 + node;
            return true;
        }
        if (kind == 16 || kind == 22) {
            i64 base_value = 0;

            if (
                !hir_eval_const_engine(
                    hir,
                    0,
                    raz_compiler_rt_arena_get(hir.node_a, node),
                    0,
                    locals,
                    parameters,
                    steps,
                    depth + 1,
                    0,
                    &mut base_value,
                ) ||
                base_value < 1152921504606846976
            ) {
                return false;
            }

            i64 element_index = 0;

            if (base_value >= 2305843009213693952) {
                i64 storage = base_value - 2305843009213693952;

                if (kind == 16) {
                    element_index = raz_compiler_rt_arena_get(hir.node_b, node);
                } else if (
                    !hir_eval_const_engine(
                        hir,
                        0,
                        raz_compiler_rt_arena_get(hir.node_b, node),
                        0,
                        locals,
                        parameters,
                        steps,
                        depth + 1,
                        0,
                        &mut element_index,
                    )
                ) {
                    return false;
                }

                i64 aggregate_count = raz_compiler_rt_arena_get(storage, 1);

                if (element_index < 0 || element_index >= aggregate_count) {
                    return false;
                }
                *out = raz_compiler_rt_arena_get(storage, 2 + element_index);
                return true;
            }

            i64 base_node = base_value - 1152921504606846976;

            if (base_node < 0 || base_node >= hir.node_count) {
                return false;
            }

            i64 base_kind = raz_compiler_rt_arena_get(hir.node_kinds, base_node);

            if (kind == 16) {
                element_index = raz_compiler_rt_arena_get(hir.node_b, node);
            } else if (
                !hir_eval_const_engine(
                    hir,
                    0,
                    raz_compiler_rt_arena_get(hir.node_b, node),
                    0,
                    locals,
                    parameters,
                    steps,
                    depth + 1,
                    0,
                    &mut element_index,
                )
            ) {
                return false;
            }

            i64 argument_start = 0;
            i64 argument_count = 0;

            if (base_kind == 34) {
                argument_start = raz_compiler_rt_arena_get(hir.node_b, base_node);
                argument_count = raz_compiler_rt_arena_get(hir.node_c, base_node);
            } else if (base_kind == 53) {
                argument_start = raz_compiler_rt_arena_get(hir.node_a, base_node);
                argument_count = raz_compiler_rt_arena_get(hir.node_b, base_node);
            } else if (base_kind == 33) {
                argument_start = raz_compiler_rt_arena_get(hir.node_c, base_node);
                argument_count = raz_compiler_rt_arena_get(hir.node_values, base_node);
                // Enum payload storage has the discriminant in field zero.
                if (kind == 16) {
                    if (element_index == 0) {
