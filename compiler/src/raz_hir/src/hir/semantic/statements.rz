namespace raz_hir::semantic::statements;

public import raz_hir::semantic::expressions;
import raz_hir::semantic::declarations;
import raz_hir::semantic::dropck;

// Statement and control-flow HIR construction. This is where blocks, loops,
// match arms, defer, and scope-sensitive cleanup begin to take shape.
fn hir_add_block(HirBuilder&mut builder, i64 start, i64 end, i64&mut out) -> bool {
    if (builder.module.block_count >= 131072) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 index = builder.module.block_count;

    builder.module.block_count += 1;
    raz_compiler_rt_arena_set(builder.module.block_starts, index, start);
    raz_compiler_rt_arena_set(builder.module.block_ends, index, end);
    raz_compiler_rt_arena_set(builder.module.block_statement_starts, index, builder.module.statement_count);
    raz_compiler_rt_arena_set(builder.module.block_statement_counts, index, 0);
    raz_compiler_rt_arena_set(builder.module.block_function_indices, index, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.block_parent_indices, index, builder.current_block);
    raz_compiler_rt_arena_set(builder.module.block_loop_depths, index, builder.loop_depth);
    raz_compiler_rt_arena_set(builder.module.block_unsafe_depths, index, builder.unsafe_depth);
    raz_compiler_rt_arena_set(builder.module.block_generic_active, index, builder.generic_active);
    raz_compiler_rt_arena_set(
        builder.module.block_generic_template_indices,
        index,
        builder.generic_template_index
    );
    raz_compiler_rt_arena_set(
        builder.module.block_generic_type_name_offsets,
        index,
        builder.generic_type_name_offset
    );
    raz_compiler_rt_arena_set(
        builder.module.block_generic_type_name_lengths,
        index,
        builder.generic_type_name_length
    );
    raz_compiler_rt_arena_set(
        builder.module.block_generic_type_structures,
        index,
        builder.generic_type_structure
    );
    raz_compiler_rt_arena_set(builder.module.block_generic_type_kinds, index, builder.generic_type_kind);
    raz_compiler_rt_arena_set(
        builder.module.block_generic_signature_only,
        index,
        builder.generic_signature_only
    );
    raz_compiler_rt_arena_set(
        builder.module.block_generic_reparse_function_indices,
        index,
        builder.generic_reparse_function_index,
    );
    raz_compiler_rt_arena_set(
        builder.module.block_generic_substitution_counts,
        index,
        builder.generic_substitution_count,
    );

    i64 substitution = 0;

    while (substitution < builder.generic_substitution_count) {
        i64 snapshot = index * 32 + substitution;

        raz_compiler_rt_arena_set(
            builder.module.block_generic_substitution_name_offsets,
            snapshot,
            raz_compiler_rt_arena_get(builder.generic_substitution_name_offsets, substitution),
        );
        raz_compiler_rt_arena_set(
            builder.module.block_generic_substitution_name_lengths,
            snapshot,
            raz_compiler_rt_arena_get(builder.generic_substitution_name_lengths, substitution),
        );
        raz_compiler_rt_arena_set(
            builder.module.block_generic_substitution_type_structures,
            snapshot,
            raz_compiler_rt_arena_get(builder.generic_substitution_type_structs, substitution),
        );
        raz_compiler_rt_arena_set(
            builder.module.block_generic_substitution_types,
            snapshot,
            raz_compiler_rt_arena_get(builder.generic_substitution_types, substitution),
        );
        substitution += 1;
    }
    raz_compiler_rt_arena_set(builder.module.block_defer_starts, index, 0);
    raz_compiler_rt_arena_set(builder.module.block_defer_counts, index, 0);

    i64 defer_context = 0;

    if (builder.current_block >= 0) {
        defer_context = raz_compiler_rt_arena_get(builder.module.block_defer_contexts, builder.current_block);
    }
    raz_compiler_rt_arena_set(builder.module.block_defer_contexts, index, defer_context);
    *out = index;
    return true;
}

fn hir_add_statement(HirBuilder&mut builder, i64 kind, i64 a, i64 b, i64 c) -> bool {
    if (builder.module.statement_count >= 131072) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 index = builder.module.statement_count;

    builder.module.statement_count += 1;
    raz_compiler_rt_arena_set(builder.module.statement_kinds, index, kind);
    raz_compiler_rt_arena_set(builder.module.statement_block_indices, index, builder.current_block);
    raz_compiler_rt_arena_set(builder.module.statement_function_indices, index, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.statement_source_offsets, index, builder.current.offset);
    raz_compiler_rt_arena_set(builder.module.statement_a, index, a);
    raz_compiler_rt_arena_set(builder.module.statement_b, index, b);
    raz_compiler_rt_arena_set(builder.module.statement_c, index, c);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_structures, index, -1);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_root_kinds, index, 0);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_root_indices, index, -1);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_paths, index, 0);
    raz_compiler_rt_arena_set(
        builder.module.statement_predrop_moved_starts,
        index,
        builder.module.predrop_moved_path_count,
    );
    raz_compiler_rt_arena_set(builder.module.statement_predrop_moved_counts, index, 0);
    raz_compiler_rt_arena_set(
        builder.module.function_statement_counts,
        builder.current_function,
        raz_compiler_rt_arena_get(builder.module.function_statement_counts, builder.current_function) + 1,
    );
    return true;
}

fn hir_parse_parameter(HirBuilder&mut builder) -> bool {
    i64 type_structure = -1;
    i64 type_kind = 0;
    i64 reference = 0;
    i64 slice = 0;
    i64 slice_mutable = 0;

    if (
        !hir_parse_type_spec(
            builder,
            &mut type_structure,
            &mut type_kind,
            &mut reference,
            &mut slice,
            &mut slice_mutable,
        )
    ) {
        return false;
    }

    i64 lifetime = builder.last_type_lifetime;
    i64 reference_mutable = builder.last_type_reference_mutable;
    i64 function_type = builder.last_type_function_signature;
    i64 array_extent = -1;

    // Accept both fixed-array parameter spellings supported by Raz source:
    // `T[N] name` (used by existing const-generic code) and `T name[N]`
    // (used by current type-first declarations and backend examples).
    if (builder.current.kind == TokenKind::LeftBracket) {
        if (slice != 0 || reference != 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        hir_advance(builder);
        if (
            !hir_parse_const_generic_expression(builder, &mut array_extent) ||
            array_extent <= 0 ||
            !hir_expect(builder, TokenKind::RightBracket)
        ) {
            return false;
        }
    }
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }

    i64 name_offset = builder.current.offset;
    i64 name_length = builder.current.length;

    hir_advance(builder);
    if (builder.current.kind == TokenKind::LeftBracket) {
        if (array_extent >= 0 || slice != 0 || reference != 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        hir_advance(builder);
        if (
            !hir_parse_const_generic_expression(builder, &mut array_extent) ||
            array_extent <= 0 ||
            !hir_expect(builder, TokenKind::RightBracket)
        ) {
            return false;
        }
    }
    if (builder.module.parameter_count >= 32768) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 index = builder.module.parameter_count;

    builder.module.parameter_count += 1;
    raz_compiler_rt_arena_set(builder.module.parameter_name_offsets, index, name_offset);
    raz_compiler_rt_arena_set(builder.module.parameter_name_lengths, index, name_length);
    raz_compiler_rt_arena_set(builder.module.parameter_function_indices, index, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.parameter_type_structs, index, type_structure);
    raz_compiler_rt_arena_set(builder.module.parameter_types, index, type_kind);
    raz_compiler_rt_arena_set(builder.module.parameter_references, index, reference);
    raz_compiler_rt_arena_set(builder.module.parameter_reference_mutable, index, reference_mutable);
    raz_compiler_rt_arena_set(builder.module.parameter_lifetimes, index, lifetime);
    raz_compiler_rt_arena_set(builder.module.parameter_slices, index, slice);
    raz_compiler_rt_arena_set(builder.module.parameter_slice_mutable, index, slice_mutable);
    raz_compiler_rt_arena_set(builder.module.parameter_array_extents, index, array_extent);
    raz_compiler_rt_arena_set(builder.module.parameter_function_types, index, function_type);
    raz_compiler_rt_arena_set(builder.parameter_moved, index, 0);
    raz_compiler_rt_arena_set(
        builder.module.function_parameter_counts,
        builder.current_function,
        raz_compiler_rt_arena_get(builder.module.function_parameter_counts, builder.current_function) + 1,
    );
    return true;
}

fn hir_find_local_slot(HirBuilder&mut builder, i64 offset, i64 length) -> i64 {
    i64 link = raz_compiler_rt_arena_get(builder.module.function_last_locals, builder.current_function);

    while (link > 0) {
        i64 index = link - 1;

        if (
            token_same(
                &builder.scan.input,
                raz_compiler_rt_arena_get(builder.module.local_name_offsets, index),
                raz_compiler_rt_arena_get(builder.module.local_name_lengths, index),
                offset,
                length,
            )
        ) {
            return raz_compiler_rt_arena_get(builder.module.local_slots, index);
        }
        link = raz_compiler_rt_arena_get(builder.module.local_previous_function_locals, index);
    }
    return -1;
}

fn hir_parse_assignment(HirBuilder&mut builder) -> bool {
    i64 target = -1;

    builder.allow_moved_name = 1;

    bool target_ok = hir_parse_primary(builder, &mut target);

    builder.allow_moved_name = 0;
    if (!target_ok) {
        return false;
    }

    TokenKind operation = builder.current.kind;

    if (
        operation != TokenKind::Equal &&
        operation != TokenKind::PlusEqual &&
        operation != TokenKind::MinusEqual &&
        operation != TokenKind::StarEqual &&
        operation != TokenKind::SlashEqual &&
        operation != TokenKind::PercentEqual &&
        operation != TokenKind::AmpersandEqual &&
        operation != TokenKind::PipeEqual &&
        operation != TokenKind::CaretEqual &&
        operation != TokenKind::LessLessEqual &&
        operation != TokenKind::GreaterGreaterEqual
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    hir_advance(builder);

    i64 value = -1;

    if (!hir_parse_expression(builder, &mut value)) {
        return false;
    }
    if (operation == TokenKind::Equal) {
        i64 target_kind = raz_compiler_rt_arena_get(builder.module.node_kinds, target);

        if (target_kind == 3) {
            i64 local = hir_local_index_from_slot(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_a, target),
            );
            if (
                local >= 0 &&
                (
                    raz_compiler_rt_arena_get(builder.module.local_references, local) != 0 ||
                    raz_compiler_rt_arena_get(builder.module.local_slices, local) != 0
                )
            ) {
                hir_fail(builder, DiagnosticCode::BorrowConflict);
                return false;
            }
        } else if (target_kind == 2) {
            i64 parameter =
                raz_compiler_rt_arena_get(builder.module.function_parameter_starts, builder.current_function) +
                raz_compiler_rt_arena_get(builder.module.node_a, target);
            if (
                raz_compiler_rt_arena_get(builder.module.parameter_references, parameter) != 0 ||
                raz_compiler_rt_arena_get(builder.module.parameter_slices, parameter) != 0
            ) {
                hir_fail(builder, DiagnosticCode::BorrowConflict);
                return false;
            }
        }
    }

    i64 assignment_root_kind = 0;
    i64 assignment_root_index = -1;
    i64 assignment_root_path = 0;

    if (
        hir_node_path(
            builder,
            target,
            &mut assignment_root_kind,
            &mut assignment_root_index,
            &mut assignment_root_path,
        ) &&
        assignment_root_kind == 4
    ) {
        if (raz_compiler_rt_arena_get(builder.module.global_mutable_flags, assignment_root_index) == 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        if (
            assignment_root_path == 0 &&
            (
                raz_compiler_rt_arena_get(builder.module.global_type_structs, assignment_root_index) >= 0 ||
                raz_compiler_rt_arena_get(builder.module.global_array_extents, assignment_root_index) >= 0
            )
        ) {
            i64 replacement_kind = raz_compiler_rt_arena_get(builder.module.node_kinds, value);

            i64 global_structure = raz_compiler_rt_arena_get(
                builder.module.global_type_structs,
                assignment_root_index,
            );
            i64 global_extent = raz_compiler_rt_arena_get(
                builder.module.global_array_extents,
                assignment_root_index,
            );
            if (global_structure >= 0) {
                if (
                    replacement_kind != 34 ||
                    raz_compiler_rt_arena_get(builder.module.node_type_structs, value) != global_structure
                ) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            } else if (global_extent >= 0) {
                if (
                    replacement_kind != 53 ||
                    raz_compiler_rt_arena_get(builder.module.node_array_extents, value) != global_extent
                ) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            }
        }
    }
    if (raz_compiler_rt_arena_get(builder.module.node_kinds, target) == 21) {
        i64 reference_operand = raz_compiler_rt_arena_get(builder.module.node_a, target);

        if (
            raz_compiler_rt_arena_get(builder.module.node_references, reference_operand) == 1 &&
            raz_compiler_rt_arena_get(builder.module.node_reference_mutable, reference_operand) == 0
        ) {
            i64 operand_root_kind = 0;
            i64 operand_root_index = -1;
            i64 operand_path = 0;
            bool mutable_local_borrow = false;

            if (
                hir_node_path(
                    builder,
                    reference_operand,
                    &mut operand_root_kind,
                    &mut operand_root_index,
                    &mut operand_path,
                ) &&
                operand_root_kind == 3
            ) {
                mutable_local_borrow = raz_compiler_rt_arena_get(
                    builder.local_borrow_kinds,
                    operand_root_index,
                ) == 2;
            }
            if (!mutable_local_borrow) {
                hir_fail(builder, DiagnosticCode::BorrowConflict);
                return false;
            }
        }
        if (
            raz_compiler_rt_arena_get(builder.module.node_kinds, reference_operand) == 2 &&
            raz_compiler_rt_arena_get(builder.module.function_closure_kinds, builder.current_function) == 2
        ) {
            i64 reference_slot = raz_compiler_rt_arena_get(builder.module.node_a, reference_operand);

            if (
                reference_slot >= raz_compiler_rt_arena_get(
                    builder.module.function_closure_explicit_parameter_counts,
                    builder.current_function,
                )
            ) {
                hir_fail(builder, DiagnosticCode::BorrowConflict);
                return false;
            }
        }
    }
    if (raz_compiler_rt_arena_get(builder.module.node_kinds, target) == 22) {
        i64 indexed_base = raz_compiler_rt_arena_get(builder.module.node_a, target);

        if (
            raz_compiler_rt_arena_get(builder.module.node_slices, indexed_base) != 0 &&
            raz_compiler_rt_arena_get(builder.module.node_slice_mutable, indexed_base) == 0
        ) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
    }

    i64 target_reference = raz_compiler_rt_arena_get(builder.module.node_references, target);

    if (target_reference != 0) {
        if (
            operation != TokenKind::Equal ||
            !hir_require_reference_type(
                builder,
                &mut value,
                target_reference,
                raz_compiler_rt_arena_get(builder.module.node_type_structs, target),
                raz_compiler_rt_arena_get(builder.module.node_types, target),
            )
        ) {
            return false;
        }
    } else if (
        raz_compiler_rt_arena_get(builder.module.node_type_structs, target) < 0 &&
        !hir_require_value_type(
            builder,
            &mut value,
            raz_compiler_rt_arena_get(builder.module.node_types, target),
        )
    ) {
        return false;
    }

    i64 target_array_extent = raz_compiler_rt_arena_get(builder.module.node_array_extents, target);

    if (
        target_array_extent >= 0 &&
        raz_compiler_rt_arena_get(builder.module.node_array_extents, value) != target_array_extent
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    if (raz_compiler_rt_arena_get(builder.module.node_types, target) == 14) {
        i64 target_signature = raz_compiler_rt_arena_get(builder.module.node_function_types, target);
        i64 value_signature = raz_compiler_rt_arena_get(builder.module.node_function_types, value);

        if (
            target_signature < 0 ||
            value_signature < 0 ||
            !hir_function_pointer_signatures_equal(builder, target_signature, value_signature)
        ) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
    }
    if (!hir_expect(builder, TokenKind::Semicolon)) {
        return false;
    }
    if (raz_compiler_rt_arena_get(builder.module.node_kinds, target) == 2) {
        i64 parameter_slot = raz_compiler_rt_arena_get(builder.module.node_a, target);

        i64 parameter_start = raz_compiler_rt_arena_get(
            builder.module.function_parameter_starts,
            builder.current_function,
        );
        raz_compiler_rt_arena_set(builder.module.parameter_mutated, parameter_start + parameter_slot, 1);
    }

    i64 operation_code = 0;

    if (operation == TokenKind::PlusEqual) {
        operation_code = 1;
    } else if (operation == TokenKind::MinusEqual) {
        operation_code = 2;
    } else if (operation == TokenKind::StarEqual) {
        operation_code = 3;
    } else if (operation == TokenKind::SlashEqual) {
        operation_code = 4;
    } else if (operation == TokenKind::PercentEqual) {
        operation_code = 5;
    } else if (operation == TokenKind::AmpersandEqual) {
        operation_code = 6;
    } else if (operation == TokenKind::PipeEqual) {
        operation_code = 7;
    } else if (operation == TokenKind::CaretEqual) {
        operation_code = 8;
    } else if (operation == TokenKind::LessLessEqual) {
        operation_code = 9;
    } else if (operation == TokenKind::GreaterGreaterEqual) {
        operation_code = 10;
    }

    i64 target_root_kind = 0;
    i64 target_root_index = -1;
    i64 target_path = 0;

    bool has_target_root = hir_node_path(
        builder,
        target,
        &mut target_root_kind,
        &mut target_root_index,
        &mut target_path,
    );
    bool direct_local_assignment =
        operation_code == 0 &&
        raz_compiler_rt_arena_get(builder.module.node_kinds, target) == 3;
    bool whole_place_reinitialization = operation_code == 0 && has_target_root && target_path == 0;

    if (
        has_target_root &&
        hir_has_active_borrow(builder, target_root_kind, target_root_index, target_path, 2)
    ) {
        hir_fail(builder, DiagnosticCode::BorrowConflict);
        return false;
    }
    if (
        has_target_root &&
        hir_root_is_whole_moved(builder, target_root_kind, target_root_index) &&
        !whole_place_reinitialization
    ) {
        hir_fail(builder, DiagnosticCode::UseAfterMove);
        return false;
    }
    if (
        operation_code != 0 &&
        has_target_root &&
        hir_path_is_moved(builder, target_root_kind, target_root_index, target_path)
    ) {
        hir_fail(builder, DiagnosticCode::UseAfterMove);
        return false;
    }

    i64 predrop_structure = -1;
    bool needs_predrop = false;

    if (operation_code == 0 && has_target_root) {
        predrop_structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, target);
        needs_predrop =
            predrop_structure >= 0 &&
            hir_structure_needs_drop(builder.module, predrop_structure, 0) &&
            !hir_path_uninitialized_at_root(builder, target_root_kind, target_root_index, target_path);
    }

    i64 statement = builder.module.statement_count;
    bool added = false;

    if (direct_local_assignment) {
        added = hir_add_statement(
            builder,
            1,
            raz_compiler_rt_arena_get(builder.module.node_a, target),
            value,
            raz_compiler_rt_arena_get(builder.module.node_types, target),
        );
    } else {
        added = hir_add_statement(builder, 4, target, value, operation_code);
    }
    if (!added) {
        return false;
    }
    if (
        needs_predrop &&
        !hir_record_predrop(
            builder,
            statement,
            predrop_structure,
            target_root_kind,
            target_root_index,
            target_path,
        )
    ) {
        return false;
    }
    if (operation_code == 0 && has_target_root) {
        hir_clear_path_moved(builder, target_root_kind, target_root_index, target_path);
    }
    return true;
}

fn hir_find_callable_local(
    HirBuilder&mut builder,
    i64 offset,
    i64 length,
    i64&mut local_index,
    i64&mut local_slot,
) -> bool {
    i64 link = raz_compiler_rt_arena_get(builder.module.function_last_locals, builder.current_function);

    while (link > 0) {
        i64 index = link - 1;

        if (
            raz_compiler_rt_arena_get(builder.module.local_callable_functions, index) >= 0 &&
            token_same(
                &builder.scan.input,
                raz_compiler_rt_arena_get(builder.module.local_name_offsets, index),
                raz_compiler_rt_arena_get(builder.module.local_name_lengths, index),
                offset,
                length,
            ) &&
            hir_local_visible_in_scope(builder, index)
        ) {
            *local_index = index;
            *local_slot = raz_compiler_rt_arena_get(builder.module.local_slots, index);
            return true;
        }
        link = raz_compiler_rt_arena_get(builder.module.local_previous_function_locals, index);
    }
    return false;
}

fn hir_create_hidden_capture_local(
    HirBuilder&mut builder,
    i64 callable_function,
    i64 capture,
    i64&mut hidden_index,
) -> bool {
    if (builder.module.local_count >= 32768 || builder.module.callable_capture_local_count >= 262144) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 value = -1;

    if (!hir_make_closure_capture_argument(builder, callable_function, capture, &mut value)) {
        return false;
    }

    i64 index = builder.module.local_count;
    i64 slot = raz_compiler_rt_arena_get(builder.module.function_local_counts, builder.current_function);

    builder.module.local_count += 1;
    raz_compiler_rt_arena_set(builder.module.local_name_offsets, index, 0);
    raz_compiler_rt_arena_set(builder.module.local_name_lengths, index, 0);
    raz_compiler_rt_arena_set(builder.module.local_function_indices, index, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.local_block_indices, index, builder.current_block);
    raz_compiler_rt_arena_set(
        builder.module.local_type_structs,
        index,
        raz_compiler_rt_arena_get(builder.module.node_type_structs, value),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_types,
        index,
        raz_compiler_rt_arena_get(builder.module.node_types, value),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_references,
        index,
        raz_compiler_rt_arena_get(builder.module.node_references, value),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_slices,
        index,
        raz_compiler_rt_arena_get(builder.module.node_slices, value),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_slice_mutable,
        index,
        raz_compiler_rt_arena_get(builder.module.node_slice_mutable, value),
    );
    raz_compiler_rt_arena_set(builder.module.local_array_extents, index, -1);
    raz_compiler_rt_arena_set(
        builder.module.local_array_element_starts,
        index,
        builder.module.array_element_count,
    );
    raz_compiler_rt_arena_set(builder.module.local_array_element_counts, index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_functions, index, -1);
    raz_compiler_rt_arena_set(builder.module.local_callable_kinds, index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_starts, index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_counts, index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_consumed, index, 0);
    raz_compiler_rt_arena_set(
        builder.module.local_function_types,
        index,
        raz_compiler_rt_arena_get(builder.module.node_function_types, value),
    );
    raz_compiler_rt_arena_set(builder.local_moved, index, 0);
    hir_record_local_borrow(builder, index, value);
    raz_compiler_rt_arena_set(builder.module.function_local_counts, builder.current_function, slot + 1);
    hir_register_local(builder, index, slot);

    i64 structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, value);
    i64 reference = raz_compiler_rt_arena_get(builder.module.node_references, value);
    i64 capture_mode = raz_compiler_rt_arena_get(builder.module.function_closure_kinds, callable_function);

    if (reference == 0 && structure >= 0) {
        i64 statement_kind = 10;

        if (
            capture_mode == 1 &&
            raz_compiler_rt_arena_get(builder.module.struct_copy_flags, structure) != 0
        ) {
            statement_kind = 24;
        }
        if (!hir_add_statement(builder, statement_kind, slot, value, index)) {
            return false;
        }
    } else if (!hir_add_statement(builder, 8, slot, value, index)) {
        return false;
    }
    raz_compiler_rt_arena_set(
        builder.module.callable_capture_locals,
        builder.module.callable_capture_local_count,
        index,
    );
    builder.module.callable_capture_local_count += 1;
    *hidden_index = index;
    return true;
}

fn hir_append_callable_local_captures(
    HirBuilder&mut builder,
    i64 callable_local,
    i64 callable_function,
    i64 callable_kind,
) -> bool {
    i64 capture = raz_compiler_rt_arena_get(builder.module.local_callable_capture_starts, callable_local);

    i64 end =
        capture +
        raz_compiler_rt_arena_get(builder.module.local_callable_capture_counts, callable_local);
    while (capture < end) {
        if (builder.module.argument_count >= 262144) {
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
        }

        i64 hidden = raz_compiler_rt_arena_get(builder.module.callable_capture_locals, capture);
        i64 slot = raz_compiler_rt_arena_get(builder.module.local_slots, hidden);
        i64 node = -1;

        if (!hir_add_node(builder, 3, slot, 0, 0, 0, &mut node)) {
            return false;
        }
        hir_apply_name_type(builder, 3, slot, node);
        if (callable_kind == 4) {
            if (raz_compiler_rt_arena_get(builder.local_moved, hidden) != 0) {
                hir_fail(builder, DiagnosticCode::UseAfterMove);
                return false;
            }
            raz_compiler_rt_arena_set(builder.local_moved, hidden, 1);

            i64 moved = -1;

            if (!hir_add_node(builder, 39, node, 0, 0, 0, &mut moved)) {
                return false;
            }
            hir_copy_node_type(builder, moved, node);
            node = moved;
        }
        raz_compiler_rt_arena_set(builder.module.arguments, builder.module.argument_count, node);
        builder.module.argument_count += 1;
        capture += 1;
    }
    return true;
}

fn hir_parse_local(HirBuilder&mut builder) -> bool {
    i64 type_structure = -1;
    i64 type_kind = 0;
    i64 reference = 0;
    i64 slice = 0;
    i64 slice_mutable = 0;

    bool inferred =
        builder.current.kind == TokenKind::Identifier &&
        token_is_auto(&builder.scan.input, &builder.current);
    if (inferred) {
        hir_advance(builder);
    } else if (
        !hir_parse_type_spec(
            builder,
            &mut type_structure,
            &mut type_kind,
            &mut reference,
            &mut slice,
            &mut slice_mutable,
        )
    ) {
        return false;
    }

    i64 declared_lifetime = -1;
    i64 declared_reference_mutable = 0;
    i64 declared_function_type = -1;

    if (!inferred) {
        declared_lifetime = builder.last_type_lifetime;
        declared_reference_mutable = builder.last_type_reference_mutable;
        declared_function_type = builder.last_type_function_signature;
    }
    // Fixed-array declarations use the type-first spelling `i64[3] values`.
    // Keep accepting the older post-name spelling below for bootstrap source
    // compatibility, but parse the canonical extent before the identifier.

    i64 array_extent = -1;

    if (!inferred && builder.current.kind == TokenKind::LeftBracket) {
        if (slice != 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        hir_advance(builder);
        if (builder.current.kind == TokenKind::RightBracket) {
            array_extent = 0;
        } else {
            i64 extent_node = -1;

            if (
                !hir_parse_expression(builder, &mut extent_node) ||
                raz_compiler_rt_arena_get(builder.module.node_kinds, extent_node) != 1
            ) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            array_extent = raz_compiler_rt_arena_get(builder.module.node_values, extent_node);
        }
        if (!hir_expect(builder, TokenKind::RightBracket)) {
            return false;
        }
    }
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }

    i64 name_offset = builder.current.offset;
    i64 name_length = builder.current.length;

    hir_advance(builder);
    if (slice != 0 && builder.current.kind == TokenKind::LeftBracket) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    if (builder.current.kind == TokenKind::LeftBracket) {
        if (array_extent >= 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        hir_advance(builder);
        if (builder.current.kind != TokenKind::RightBracket) {
            i64 extent_node = -1;

            if (!hir_parse_expression(builder, &mut extent_node)) {
                return false;
            }
            if (raz_compiler_rt_arena_get(builder.module.node_kinds, extent_node) != 1) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            array_extent = raz_compiler_rt_arena_get(builder.module.node_values, extent_node);
        } else {
            array_extent = 0;
        }
        if (!hir_expect(builder, TokenKind::RightBracket)) {
            return false;
        }
    }

    i64 initializer = -1;
    i64 element_start = builder.module.array_element_count;
    i64 element_count = 0;
    bool has_initializer = builder.current.kind == TokenKind::Equal;

    if (has_initializer) {
        hir_advance(builder);
        if (builder.current.kind == TokenKind::LeftBracket) {
            hir_advance(builder);
            while (builder.current.kind != TokenKind::RightBracket) {
                if (builder.module.array_element_count >= 262144) {
                    hir_fail(builder, DiagnosticCode::TooManyItems);
                    return false;
                }

                i64 element = -1;

                if (!hir_parse_expression(builder, &mut element)) {
                    return false;
                }
                if (type_structure < 0 && !hir_require_value_type(builder, &mut element, type_kind)) {
                    return false;
                }
                raz_compiler_rt_arena_set(
                    builder.module.array_elements,
                    builder.module.array_element_count,
                    element,
                );
                builder.module.array_element_count += 1;
                element_count += 1;
                if (builder.current.kind == TokenKind::Comma) {
                    hir_advance(builder);
                } else if (builder.current.kind != TokenKind::RightBracket) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            }
            if (!hir_expect(builder, TokenKind::RightBracket)) {
                return false;
            }
            if (array_extent == 0) {
                array_extent = element_count;
            }
            if (array_extent >= 0 && element_count != array_extent) {
                // A fixed-size array literal must initialize every element.
                // Unsized [] declarations infer their extent above, so the
                // same equality rule applies after inference.
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            if (!hir_add_node(builder, 1, 0, 0, 0, 0, &mut initializer)) {
                return false;
            }
        } else {
            if (!hir_parse_expression(builder, &mut initializer)) {
                return false;
            }
            if (inferred) {
                // `auto` preserves the semantic type of any initializer. Closure
                // literals keep their environment-backed special representation;
                // ordinary/returned callable values remain typed indirect values.
                if (raz_compiler_rt_arena_get(builder.module.node_kinds, initializer) == 42) {
                    i64 inferred_closure_function = raz_compiler_rt_arena_get(
                        builder.module.node_a,
                        initializer,
                    );

                    i64 inferred_closure_kind = raz_compiler_rt_arena_get(builder.module.node_b, initializer);

                    type_structure = -1;
                    if (inferred_closure_kind == 3) {
                        type_kind = 17;
                    } else if (inferred_closure_kind == 4) {
                        type_kind = 18;
                    } else {
                        type_kind = 16;
                    }
                    reference = 0;
                    slice = 0;
                    slice_mutable = 0;
                    declared_function_type = hir_function_pointer_signature(
                        builder,
                        inferred_closure_function,
                    );
                } else {
                    type_structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, initializer);
                    type_kind = raz_compiler_rt_arena_get(builder.module.node_types, initializer);
                    reference = raz_compiler_rt_arena_get(builder.module.node_references, initializer);
                    slice = raz_compiler_rt_arena_get(builder.module.node_slices, initializer);
                    slice_mutable = raz_compiler_rt_arena_get(builder.module.node_slice_mutable, initializer);
                    declared_function_type = raz_compiler_rt_arena_get(
                        builder.module.node_function_types,
                        initializer,
                    );
                }
            }
            if (slice != 0) {
                i64 sliced = -1;

                if (!hir_coerce_slice(builder, initializer, slice_mutable, &mut sliced)) {
                    return false;
                }
                initializer = sliced;
                if (type_structure >= 0) {
                    if (
                        raz_compiler_rt_arena_get(
                            builder.module.node_type_structs,
                            initializer,
                        ) != type_structure
                    ) {
                        hir_fail(builder, DiagnosticCode::ExpectedToken);
                        return false;
                    }
                } else if (!hir_require_value_type(builder, &mut initializer, type_kind)) {
                    return false;
                }
            } else if (reference != 0) {
                if (
                    !hir_require_reference_type(
                        builder,
                        &mut initializer,
                        reference,
                        type_structure,
                        type_kind,
                    )
                ) {
                    return false;
                }
            } else if (type_kind == 15 && declared_function_type <= -2) {
                i64 trait_object = -2 - declared_function_type;
                i64 coerced_object = -1;

                if (!hir_coerce_trait_object(builder, initializer, trait_object, &mut coerced_object)) {
                    return false;
                }
                initializer = coerced_object;
            } else if (type_structure >= 0) {
                if (
                    raz_compiler_rt_arena_get(builder.module.node_type_structs, initializer) != type_structure
                ) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            } else if (
                !(
                    (type_kind == 14 || inferred) &&
                    raz_compiler_rt_arena_get(builder.module.node_kinds, initializer) == 42
                ) &&
                !hir_require_value_type(builder, &mut initializer, type_kind)
            ) {
                return false;
            }
        }
    }
    if (
        has_initializer &&
        array_extent >= 0 &&
        element_count == 0 &&
        raz_compiler_rt_arena_get(builder.module.node_array_extents, initializer) != array_extent
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    if (!has_initializer) {
        if (slice != 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        if (primitive_type_is_float(type_kind)) {
            if (!hir_add_node(builder, 30, 0, 0, 0, 0, &mut initializer)) {
                return false;
            }
            hir_set_node_type(builder, initializer, type_kind);
        } else {
            if (!hir_add_node(builder, 1, 0, 0, 0, 0, &mut initializer)) {
                return false;
            }
            hir_set_node_type(builder, initializer, type_kind);
        }
    }
    if (!has_initializer && reference >= 2) {
        raz_compiler_rt_arena_set(builder.module.node_references, initializer, reference);
        raz_compiler_rt_arena_set(builder.module.node_type_structs, initializer, type_structure);
    }
    if (!hir_expect(builder, TokenKind::Semicolon)) {
        return false;
    }
    if (builder.module.local_count >= 32768) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    if (!inferred && type_kind == 14) {
        i64 initializer_signature = raz_compiler_rt_arena_get(
            builder.module.node_function_types,
            initializer
        );
        if (raz_compiler_rt_arena_get(builder.module.node_kinds, initializer) == 42) {
            i64 initializer_function = raz_compiler_rt_arena_get(builder.module.node_a, initializer);

            if (
                raz_compiler_rt_arena_get(
                    builder.module.function_closure_capture_counts,
                    initializer_function,
                ) != 0
            ) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            initializer_signature = hir_function_pointer_signature(builder, initializer_function);
            raz_compiler_rt_arena_set(builder.module.node_kinds, initializer, 47);
            raz_compiler_rt_arena_set(builder.module.node_a, initializer, initializer_function);
            hir_set_node_type(builder, initializer, 14);
            raz_compiler_rt_arena_set(builder.module.node_function_types, initializer, initializer_signature);
        } else if (raz_compiler_rt_arena_get(builder.module.node_kinds, initializer) == 47) {
            i64 initializer_function = raz_compiler_rt_arena_get(builder.module.node_a, initializer);

            initializer_signature = hir_function_pointer_signature(builder, initializer_function);
            raz_compiler_rt_arena_set(builder.module.node_function_types, initializer, initializer_signature);
        }
        if (
            declared_function_type < 0 ||
            initializer_signature < 0 ||
            !hir_function_pointer_signatures_equal(builder, declared_function_type, initializer_signature)
        ) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
    }

    i64 callable_function = -1;
    i64 callable_kind = 0;
    i64 callable_capture_start = builder.module.callable_capture_local_count;
    i64 callable_capture_count = 0;

    if (
        !inferred &&
        type_kind == 14 &&
        raz_compiler_rt_arena_get(builder.module.node_kinds, initializer) == 47
    ) {
        // Keep the source function for diagnostics/provenance, but calls through
        // a function-pointer local always lower as typed indirect calls.
        callable_function = raz_compiler_rt_arena_get(builder.module.node_a, initializer);
        callable_kind = 5;
    }
    if (inferred && raz_compiler_rt_arena_get(builder.module.node_kinds, initializer) == 42) {
        callable_function = raz_compiler_rt_arena_get(builder.module.node_a, initializer);
        callable_kind = raz_compiler_rt_arena_get(builder.module.node_b, initializer);
        i64 capture = raz_compiler_rt_arena_get(
            builder.module.function_closure_capture_starts,
            callable_function,
        );
        i64 capture_end =
            capture +
            raz_compiler_rt_arena_get(builder.module.function_closure_capture_counts, callable_function);
        while (capture < capture_end) {
            i64 hidden = -1;

            if (!hir_create_hidden_capture_local(builder, callable_function, capture, &mut hidden)) {
                return false;
            }
            callable_capture_count += 1;
            capture += 1;
        }
        if (!hir_add_node(builder, 1, 0, 0, 0, 0, &mut initializer)) {
            return false;
        }
    }

    i64 index = builder.module.local_count;

    i64 local_slot = raz_compiler_rt_arena_get(
        builder.module.function_local_counts,
        builder.current_function
    );
    builder.module.local_count += 1;
    raz_compiler_rt_arena_set(builder.module.local_name_offsets, index, name_offset);
    raz_compiler_rt_arena_set(builder.module.local_name_lengths, index, name_length);
    raz_compiler_rt_arena_set(builder.module.local_function_indices, index, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.local_block_indices, index, builder.current_block);
    raz_compiler_rt_arena_set(builder.module.local_type_structs, index, type_structure);
    raz_compiler_rt_arena_set(builder.module.local_types, index, type_kind);
    raz_compiler_rt_arena_set(builder.module.local_references, index, reference);
    raz_compiler_rt_arena_set(builder.module.local_reference_mutable, index, declared_reference_mutable);
    raz_compiler_rt_arena_set(builder.module.local_lifetimes, index, declared_lifetime);
    raz_compiler_rt_arena_set(builder.module.local_slices, index, slice);
    raz_compiler_rt_arena_set(builder.module.local_slice_mutable, index, slice_mutable);
    raz_compiler_rt_arena_set(builder.module.local_array_extents, index, array_extent);
    raz_compiler_rt_arena_set(builder.module.local_array_element_starts, index, element_start);
    raz_compiler_rt_arena_set(builder.module.local_array_element_counts, index, element_count);
    raz_compiler_rt_arena_set(builder.module.local_callable_functions, index, callable_function);
    raz_compiler_rt_arena_set(builder.module.local_callable_kinds, index, callable_kind);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_starts, index, callable_capture_start);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_counts, index, callable_capture_count);
    raz_compiler_rt_arena_set(builder.module.local_callable_consumed, index, 0);
    raz_compiler_rt_arena_set(builder.module.local_function_types, index, declared_function_type);
    raz_compiler_rt_arena_set(builder.local_moved, index, 0);
    hir_record_local_borrow(builder, index, initializer);
    raz_compiler_rt_arena_set(
        builder.module.function_local_counts,
        builder.current_function,
        raz_compiler_rt_arena_get(builder.module.function_local_counts, builder.current_function) + 1,
    );
    hir_register_local(builder, index, local_slot);
    if (array_extent != -1) {
        return hir_add_statement(builder, 9, local_slot, initializer, index);
    }
    if (reference == 0 && type_structure != -1 && type_structure < builder.module.struct_count) {
        return hir_add_statement(builder, 10, local_slot, initializer, index);
    }
    return hir_add_statement(builder, 8, local_slot, initializer, index);
}

fn hir_capture_block(HirBuilder&mut builder, i64&mut start, i64&mut end, i64&mut block) -> bool {
    if (!hir_expect(builder, TokenKind::LeftBrace)) {
        return false;
    }
    *start = builder.current.offset;
    *end = *start;

    i64 depth = 1;

    while (depth > 0 && builder.current.kind != TokenKind::End) {
        if (builder.current.kind == TokenKind::LeftBrace) {
            depth += 1;
        } else if (builder.current.kind == TokenKind::RightBrace) {
            depth -= 1;
            if (depth == 0) {
                *end = builder.current.offset;
            }
        }
        hir_advance(builder);
    }
    if (depth != 0) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    return hir_add_block(builder, *start, *end, block);
}

fn hir_skip_if_chain(HirBuilder&mut builder, i64&mut end_offset) -> bool {
    if (
        builder.current.kind != TokenKind::Identifier ||
        !token_is_if(&builder.scan.input, &builder.current)
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }

    bool scanning_chain = true;

    while (scanning_chain) {
        hir_advance(builder);
        while (builder.current.kind != TokenKind::LeftBrace && builder.current.kind != TokenKind::End) {
            hir_advance(builder);
        }
        if (builder.current.kind != TokenKind::LeftBrace) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        hir_advance(builder);

        i64 depth = 1;

        while (depth > 0 && builder.current.kind != TokenKind::End) {
            if (builder.current.kind == TokenKind::LeftBrace) {
                depth += 1;
            } else if (builder.current.kind == TokenKind::RightBrace) {
                depth -= 1;
                if (depth == 0) {
                    *end_offset = builder.current.offset;
                }
            }
            hir_advance(builder);
        }
        if (depth != 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_else(&builder.scan.input, &builder.current)
        ) {
            hir_advance(builder);
            if (
                builder.current.kind == TokenKind::Identifier &&
                token_is_if(&builder.scan.input, &builder.current)
            ) {
                scanning_chain = true;
            } else {
                if (builder.current.kind != TokenKind::LeftBrace) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
                hir_advance(builder);

                i64 else_depth = 1;

                while (else_depth > 0 && builder.current.kind != TokenKind::End) {
                    if (builder.current.kind == TokenKind::LeftBrace) {
                        else_depth += 1;
                    } else if (builder.current.kind == TokenKind::RightBrace) {
                        else_depth -= 1;
                        if (else_depth == 0) {
                            *end_offset = builder.current.offset;
                        }
                    }
                    hir_advance(builder);
                }
                if (else_depth != 0) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
                scanning_chain = false;
            }
        } else {
            scanning_chain = false;
        }
    }
    return true;
}

fn token_is_wildcard(Source& source, Token& token) -> bool {
    return (
        token.kind == TokenKind::Identifier &&
        token.length == 1 &&
        source_byte(source, token.offset) == 95
    );
}

fn hir_parse_defer_statement(HirBuilder&mut builder) -> bool {
    hir_advance(builder);

    i64 deferred_block = -1;

    if (builder.current.kind == TokenKind::LeftBrace) {
        i64 start = 0;
        i64 end = 0;

        if (!hir_capture_block(builder, &mut start, &mut end, &mut deferred_block)) {
            return false;
        }
    } else {
        i64 start = builder.current.offset;
        i64 end = start;
        i64 paren_depth = 0;
        i64 bracket_depth = 0;
        i64 brace_depth = 0;
        bool complete = false;

        while (builder.current.kind != TokenKind::End && !complete) {
            if (builder.current.kind == TokenKind::LeftParen) {
                paren_depth += 1;
            } else if (builder.current.kind == TokenKind::RightParen && paren_depth > 0) {
                paren_depth -= 1;
            } else if (builder.current.kind == TokenKind::LeftBracket) {
                bracket_depth += 1;
            } else if (builder.current.kind == TokenKind::RightBracket && bracket_depth > 0) {
                bracket_depth -= 1;
            } else if (builder.current.kind == TokenKind::LeftBrace) {
                brace_depth += 1;
            } else if (builder.current.kind == TokenKind::RightBrace && brace_depth > 0) {
                brace_depth -= 1;
            } else if (
                builder.current.kind == TokenKind::Semicolon &&
                paren_depth == 0 &&
                bracket_depth == 0 &&
                brace_depth == 0
            ) {
                end = builder.current.offset + builder.current.length;
                hir_advance(builder);
                complete = true;
            }
            if (!complete) {
                hir_advance(builder);
            }
        }
        if (!complete || !hir_add_block(builder, start, end, &mut deferred_block)) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
    }
    if (builder.module.defer_count >= 16384) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    raz_compiler_rt_arena_set(builder.module.block_defer_contexts, deferred_block, 1);
    raz_compiler_rt_arena_set(builder.module.defer_blocks, builder.module.defer_count, deferred_block);
    builder.module.defer_count += 1;
    if (builder.current_block >= 0) {
        raz_compiler_rt_arena_set(
            builder.module.block_defer_counts,
            builder.current_block,
            raz_compiler_rt_arena_get(builder.module.block_defer_counts, builder.current_block) + 1,
        );
    } else {
        raz_compiler_rt_arena_set(
            builder.module.function_defer_counts,
            builder.current_function,
            raz_compiler_rt_arena_get(builder.module.function_defer_counts, builder.current_function) + 1,
        );
    }
    return true;
}

fn hir_parse_unsafe_statement(HirBuilder&mut builder) -> bool {
    hir_advance(builder);

    i64 start = 0;
    i64 end = 0;
    i64 block = -1;

    builder.unsafe_depth += 1;

    bool captured = hir_capture_block(builder, &mut start, &mut end, &mut block);

    builder.unsafe_depth -= 1;
    if (!captured) {
        return false;
    }
    return hir_add_statement(builder, 14, block, 0, 0);
}

fn hir_match_arm_nested_subsumes(
    HirBuilder&mut builder,
    i64 prior,
    i64 pending_nested_outer_indices,
    i64 pending_nested_values,
    i64 pending_nested_count,
) -> bool {
    i64 prior_count = raz_compiler_rt_arena_get(builder.module.match_arm_nested_test_counts, prior);

    if (prior_count == 0) {
        return true;
    }
    if (prior_count > pending_nested_count) {
        return false;
    }

    i64 prior_start = raz_compiler_rt_arena_get(builder.module.match_arm_nested_test_starts, prior);
    i64 prior_test = 0;

    while (prior_test < prior_count) {
        i64 prior_outer = raz_compiler_rt_arena_get(
            builder.module.match_nested_test_path_indices,
            prior_start + prior_test,
        );
        i64 prior_value = raz_compiler_rt_arena_get(
            builder.module.match_nested_test_values,
            prior_start + prior_test,
        );

        bool found = false;
        i64 current_test = 0;

        while (current_test < pending_nested_count) {
            if (
                raz_compiler_rt_arena_get(pending_nested_outer_indices, current_test) == prior_outer &&
                raz_compiler_rt_arena_get(pending_nested_values, current_test) == prior_value
            ) {
                found = true;
                current_test = pending_nested_count;
            } else {
                current_test += 1;
            }
        }
        if (!found) {
            return false;
        }
        prior_test += 1;
    }
    return true;
}

fn hir_match_arm_covers_assignment(
    HirBuilder&mut builder,
    i64 arm,
    i64 assignment_paths,
    i64 assignment_values,
    i64 assignment_count,
) -> bool {
    if (raz_compiler_rt_arena_get(builder.module.match_arm_guards, arm) >= 0) {
        // A guard is a runtime predicate. Even a structurally irrefutable
        // guarded arm cannot contribute to compile-time exhaustiveness.
        return false;
    }
    i64 test_start = raz_compiler_rt_arena_get(builder.module.match_arm_nested_test_starts, arm);
    i64 test_count = raz_compiler_rt_arena_get(builder.module.match_arm_nested_test_counts, arm);
    i64 test = 0;
    while (test < test_count) {
        i64 expected_path = raz_compiler_rt_arena_get(
            builder.module.match_nested_test_path_indices,
            test_start + test,
        );
        i64 expected_value = raz_compiler_rt_arena_get(
            builder.module.match_nested_test_values,
            test_start + test,
        );
        bool found = false;
        i64 assignment = 0;
        while (assignment < assignment_count) {
            if (raz_compiler_rt_arena_get(assignment_paths, assignment) == expected_path) {
                if (raz_compiler_rt_arena_get(assignment_values, assignment) != expected_value) {
                    return false;
                }
                found = true;
                assignment = assignment_count;
            } else {
                assignment += 1;
            }
        }
        if (!found) { return false; }
        test += 1;
    }
    return true;
}

fn hir_match_assignment_covered(
    HirBuilder&mut builder,
    i64 enumeration,
    i64 member_index,
    i64 arm_start,
    i64 arm_end,
    i64 assignment_paths,
    i64 assignment_values,
    i64 assignment_count,
) -> bool {
    i64 arm = arm_start;
    while (arm < arm_end) {
        if (
            raz_compiler_rt_arena_get(builder.module.match_arm_wildcards, arm) == 0 &&
            raz_compiler_rt_arena_get(builder.module.match_arm_enum_indices, arm) == enumeration &&
            raz_compiler_rt_arena_get(builder.module.match_arm_member_indices, arm) == member_index &&
            hir_match_arm_covers_assignment(
                builder,
                arm,
                assignment_paths,
                assignment_values,
                assignment_count,
            )
        ) {
            return true;
        }
        arm += 1;
    }
    return false;
}

fn hir_match_frontier_add_value(
    HirBuilder&mut builder,
    i64 parent_path,
    i64 value_structure,
    i64 value_type,
    i64 value_enum,
    i64 frontier_paths,
    i64 frontier_enums,
    i64&mut frontier_count,
    i64 depth,
) -> bool {
    if (depth > 32) { return false; }
    i64 enumeration = value_enum;
    if (enumeration < 0 && hir_type_is_enum(value_type)) {
        enumeration = hir_type_enum_index(value_type);
    }
    if (enumeration >= 0) {
        if (*frontier_count >= 256) { return false; }
        raz_compiler_rt_arena_set(frontier_paths, *frontier_count, parent_path);
        raz_compiler_rt_arena_set(frontier_enums, *frontier_count, enumeration);
        *frontier_count += 1;
        return true;
    }
    if (value_structure >= 0) {
        i64 field_start = raz_compiler_rt_arena_get(builder.module.struct_field_starts, value_structure);
        i64 field_count = raz_compiler_rt_arena_get(builder.module.struct_field_counts, value_structure);
        i64 field_index = 0;
        while (field_index < field_count) {
            i64 field = field_start + field_index;
            i64 child_path = hir_match_path_create(builder, parent_path, -field_index - 1);
            if (child_path < 0) { return false; }
            if (
                raz_compiler_rt_arena_get(builder.module.struct_field_references, field) == 0 &&
                raz_compiler_rt_arena_get(builder.module.struct_field_slices, field) == 0
            ) {
                if (
                    !hir_match_frontier_add_value(
                        builder,
                        child_path,
                        raz_compiler_rt_arena_get(builder.module.struct_field_type_structs, field),
                        raz_compiler_rt_arena_get(builder.module.struct_field_types, field),
                        -1,
                        frontier_paths,
                        frontier_enums,
                        frontier_count,
                        depth + 1,
                    )
                ) {
                    return false;
                }
            }
            field_index += 1;
        }
    }
    return true;
}

fn hir_match_enumerate_nested_frontier(
    HirBuilder&mut builder,
    i64 enumeration,
    i64 outer_member,
    i64 arm_start,
    i64 arm_end,
    i64 frontier_paths,
    i64 frontier_enums,
    i64 frontier_index,
    i64 frontier_count,
    i64 assignment_paths,
    i64 assignment_values,
    i64 assignment_count,
    i64&mut budget,
) -> bool {
    *budget += 1;
    if (*budget > 65536) { return false; }
    if (frontier_index >= frontier_count) {
        return hir_match_assignment_covered(
            builder,
            enumeration,
            outer_member,
            arm_start,
            arm_end,
            assignment_paths,
            assignment_values,
            assignment_count,
        );
    }

    i64 path = raz_compiler_rt_arena_get(frontier_paths, frontier_index);
    i64 nested_enum = raz_compiler_rt_arena_get(frontier_enums, frontier_index);
    i64 member_start = raz_compiler_rt_arena_get(builder.module.enum_member_starts, nested_enum);
    i64 member_count = raz_compiler_rt_arena_get(builder.module.enum_member_counts, nested_enum);
    i64 member_offset = 0;

    while (member_offset < member_count) {
        if (assignment_count >= 256) { return false; }
        i64 nested_member = member_start + member_offset;
        raz_compiler_rt_arena_set(assignment_paths, assignment_count, path);
        raz_compiler_rt_arena_set(
            assignment_values,
            assignment_count,
            raz_compiler_rt_arena_get(builder.module.enum_member_values, nested_member),
        );

        i64 branch_frontier_count = frontier_count;
        i64 payload_start = raz_compiler_rt_arena_get(builder.module.enum_member_payload_starts, nested_member);
        i64 payload_count = raz_compiler_rt_arena_get(builder.module.enum_member_payload_counts, nested_member);
        i64 payload_index = 0;
        while (payload_index < payload_count) {
            i64 child_payload = payload_start + payload_index;
            i64 child_path = hir_match_path_create(builder, path, payload_index);
            if (child_path < 0) { return false; }
            if (
                !hir_match_frontier_add_value(
                    builder,
                    child_path,
                    raz_compiler_rt_arena_get(builder.module.enum_payload_type_structs, child_payload),
                    raz_compiler_rt_arena_get(builder.module.enum_payload_types, child_payload),
                    hir_match_payload_enum(builder, child_payload),
                    frontier_paths,
                    frontier_enums,
                    &mut branch_frontier_count,
                    0,
                )
            ) {
                return false;
            }
            payload_index += 1;
        }
        if (
            !hir_match_enumerate_nested_frontier(
                builder,
                enumeration,
                outer_member,
                arm_start,
                arm_end,
                frontier_paths,
                frontier_enums,
                frontier_index + 1,
                branch_frontier_count,
                assignment_paths,
                assignment_values,
                assignment_count + 1,
                budget,
            )
        ) {
            return false;
        }
        member_offset += 1;
    }
    return true;
}

fn hir_match_nested_variant_exhaustive(
    HirBuilder&mut builder,
    i64 enumeration,
    i64 member_index,
    i64 arm_start,
    i64 arm_end,
) -> bool {
    i64 frontier_paths = raz_compiler_rt_arena_create(256);
    i64 frontier_enums = raz_compiler_rt_arena_create(256);
    i64 assignment_paths = raz_compiler_rt_arena_create(256);
    i64 assignment_values = raz_compiler_rt_arena_create(256);
    if (
        frontier_paths == 0 ||
        frontier_enums == 0 ||
        assignment_paths == 0 ||
        assignment_values == 0
    ) {
        return false;
    }

    i64 payload_start = raz_compiler_rt_arena_get(builder.module.enum_member_payload_starts, member_index);
    i64 payload_count = raz_compiler_rt_arena_get(builder.module.enum_member_payload_counts, member_index);
    i64 frontier_count = 0;
    i64 payload_index = 0;
    while (payload_index < payload_count) {
        i64 payload = payload_start + payload_index;
        i64 path = hir_match_path_create(builder, -1, payload_index);
        if (path < 0) { return false; }
        if (
            !hir_match_frontier_add_value(
                builder,
                path,
                raz_compiler_rt_arena_get(builder.module.enum_payload_type_structs, payload),
                raz_compiler_rt_arena_get(builder.module.enum_payload_types, payload),
                hir_match_payload_enum(builder, payload),
                frontier_paths,
                frontier_enums,
                &mut frontier_count,
                0,
            )
        ) {
            return false;
        }
        payload_index += 1;
    }
    if (frontier_count == 0) {
        raz_compiler_rt_arena_destroy(frontier_paths);
        raz_compiler_rt_arena_destroy(frontier_enums);
        raz_compiler_rt_arena_destroy(assignment_paths);
        raz_compiler_rt_arena_destroy(assignment_values);
        return false;
    }

    i64 budget = 0;
    bool exhaustive = hir_match_enumerate_nested_frontier(
        builder,
        enumeration,
        member_index,
        arm_start,
        arm_end,
        frontier_paths,
        frontier_enums,
        0,
        frontier_count,
        assignment_paths,
        assignment_values,
        0,
        &mut budget,
    );
    raz_compiler_rt_arena_destroy(frontier_paths);
    raz_compiler_rt_arena_destroy(frontier_enums);
    raz_compiler_rt_arena_destroy(assignment_paths);
    raz_compiler_rt_arena_destroy(assignment_values);
    return exhaustive;
}

fn hir_match_is_exhaustive(HirBuilder&mut builder, i64 enumeration, i64 arm_start, i64 arm_end, ) -> bool {
    i64 member_start = raz_compiler_rt_arena_get(builder.module.enum_member_starts, enumeration);
    i64 member_count = raz_compiler_rt_arena_get(builder.module.enum_member_counts, enumeration);
    i64 member_offset = 0;

    while (member_offset < member_count) {
        i64 member_index = member_start + member_offset;
        bool whole_variant_covered = false;
        bool has_variant_arm = false;
        i64 arm = arm_start;

        while (arm < arm_end) {
            if (
                raz_compiler_rt_arena_get(builder.module.match_arm_guards, arm) < 0 &&
                raz_compiler_rt_arena_get(builder.module.match_arm_wildcards, arm) == 0 &&
                raz_compiler_rt_arena_get(builder.module.match_arm_enum_indices, arm) == enumeration &&
                raz_compiler_rt_arena_get(builder.module.match_arm_member_indices, arm) == member_index
            ) {
                has_variant_arm = true;
                if (raz_compiler_rt_arena_get(builder.module.match_arm_nested_test_counts, arm) == 0) {
                    whole_variant_covered = true;
                    arm = arm_end;
                } else {
                    arm += 1;
                }
            } else {
                arm += 1;
            }
        }
        if (!whole_variant_covered) {
            if (
                !has_variant_arm ||
                !hir_match_nested_variant_exhaustive(builder, enumeration, member_index, arm_start, arm_end, )
            ) {
                return false;
            }
        }
        member_offset += 1;
    }
    return true;
}

fn hir_match_payload_enum(HirBuilder&mut builder, i64 payload) -> i64 {
    i64 payload_type = raz_compiler_rt_arena_get(builder.module.enum_payload_types, payload);
    if (hir_type_is_enum(payload_type)) {
        return hir_type_enum_index(payload_type);
    }
    return raz_compiler_rt_arena_get(builder.module.enum_payload_enum_indices, payload);
}

fn hir_match_path_create(HirBuilder&mut builder, i64 parent, i64 payload_index) -> i64 {
    i64 existing = 0;
    while (existing < builder.module.match_path_count) {
        if (
            raz_compiler_rt_arena_get(builder.module.match_path_parents, existing) == parent &&
            raz_compiler_rt_arena_get(builder.module.match_path_payload_indices, existing) == payload_index
        ) {
            return existing;
        }
        existing += 1;
    }
    if (builder.module.match_path_count >= 16384) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return -1;
    }
    i64 path = builder.module.match_path_count;
    raz_compiler_rt_arena_set(builder.module.match_path_parents, path, parent);
    raz_compiler_rt_arena_set(builder.module.match_path_payload_indices, path, payload_index);
    builder.module.match_path_count += 1;
    return path;
}

fn hir_match_path_root_payload(HirBuilder&mut builder, i64 path) -> i64 {
    i64 cursor = path;
    i64 root = -1;
    while (cursor >= 0) {
        root = raz_compiler_rt_arena_get(builder.module.match_path_payload_indices, cursor);
        cursor = raz_compiler_rt_arena_get(builder.module.match_path_parents, cursor);
    }
    return root;
}

fn hir_match_payload_relative_slot(HirBuilder&mut builder, i64 payload) -> i64 {
    if (payload < 0) { return 0; }
    i64 member = 0;
    while (member < builder.module.enum_member_count) {
        i64 start = raz_compiler_rt_arena_get(builder.module.enum_member_payload_starts, member);
        i64 count = raz_compiler_rt_arena_get(builder.module.enum_member_payload_counts, member);
        if (payload >= start && payload < start + count) {
            return payload - start;
        }
        member += 1;
    }
    return 0;
}

fn hir_match_path_ownership_path(HirBuilder&mut builder, i64 base_path, i64 path) -> i64 {
    if (path < 0) { return base_path; }
    i64 parent = raz_compiler_rt_arena_get(builder.module.match_path_parents, path);
    i64 out = base_path;
    if (parent >= 0) {
        out = hir_match_path_ownership_path(builder, base_path, parent);
    }
    i64 step = raz_compiler_rt_arena_get(builder.module.match_path_payload_indices, path);
    i64 segment = 1;
    if (step < 0) {
        // Struct fields occupy the upper half of the 12-bit ownership segment
        // space, keeping them distinct from enum payload slots.
        segment = 2048 + (-step - 1);
    } else {
        segment = hir_match_payload_relative_slot(builder, step) + 1;
    }
    if (segment >= 4096) { segment = 4095; }
    return out * 4096 + segment;
}

fn hir_validate_match_borrow(
    HirBuilder&mut builder,
    i64 subject,
    i64 match_path,
    i64 mutable_borrow,
    i64 at_offset,
    i64&mut out_root_kind,
    i64&mut out_root_index,
    i64&mut out_path,
) -> bool {
    i64 root_path = 0;
    if (!hir_node_path(builder, subject, out_root_kind, out_root_index, &mut root_path)) {
        hir_fail(builder, DiagnosticCode::InvalidMove);
        return false;
    }
    *out_path = hir_match_path_ownership_path(builder, root_path, match_path);
    if (hir_path_is_moved(builder, *out_root_kind, *out_root_index, *out_path)) {
        hir_fail(builder, DiagnosticCode::UseAfterMove);
        return false;
    }
    if (
        *out_root_kind == 4 &&
        mutable_borrow != 0 &&
        raz_compiler_rt_arena_get(builder.module.global_mutable_flags, *out_root_index) == 0
    ) {
        hir_fail(builder, DiagnosticCode::BorrowConflict);
        return false;
    }
    i64 requested_kind = 1;
    if (mutable_borrow != 0) { requested_kind = 2; }
    if (
        hir_has_active_borrow_at(
            builder,
            *out_root_kind,
            *out_root_index,
            *out_path,
            requested_kind,
            at_offset,
        )
    ) {
        hir_fail(builder, DiagnosticCode::BorrowConflict);
        return false;
    }
    return true;
}

fn hir_match_record_binding_named(
    HirBuilder&mut builder,
    i64 name_offset,
    i64 name_length,
    i64 binding_structure,
    i64 binding_type,
    i64 binding_array_extent,
    i64 payload,
    i64 path,
    i64 pending_offsets,
    i64 pending_lengths,
    i64 pending_outer_indices,
    i64 pending_path_indices,
    i64 pending_payload_indices,
    i64 pending_type_structs,
    i64 pending_types,
    i64 pending_array_extents,
    i64&mut pending_binding_count,
    i64 binding_mode,
) -> bool {
    if (*pending_binding_count >= 256) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }
    i64 prior = 0;
    while (prior < *pending_binding_count) {
        if (
            token_same(
                &builder.scan.input,
                raz_compiler_rt_arena_get(pending_offsets, prior),
                raz_compiler_rt_arena_get(pending_lengths, prior),
                name_offset,
                name_length,
            )
        ) {
            hir_fail(builder, DiagnosticCode::DuplicateName);
            return false;
        }
        prior += 1;
    }
    raz_compiler_rt_arena_set(pending_offsets, *pending_binding_count, name_offset);
    raz_compiler_rt_arena_set(pending_lengths, *pending_binding_count, name_length);
    i64 root_payload = hir_match_path_root_payload(builder, path);
    raz_compiler_rt_arena_set(
        pending_outer_indices,
        *pending_binding_count,
        root_payload + binding_mode * 32768,
    );
    raz_compiler_rt_arena_set(pending_path_indices, *pending_binding_count, path);
    raz_compiler_rt_arena_set(pending_payload_indices, *pending_binding_count, payload);
    raz_compiler_rt_arena_set(pending_type_structs, *pending_binding_count, binding_structure);
    raz_compiler_rt_arena_set(pending_types, *pending_binding_count, binding_type);
    raz_compiler_rt_arena_set(pending_array_extents, *pending_binding_count, binding_array_extent);
    *pending_binding_count += 1;
    return true;
}

fn hir_match_record_binding(
    HirBuilder&mut builder,
    i64 binding_structure,
    i64 binding_type,
    i64 binding_array_extent,
    i64 payload,
    i64 path,
    i64 pending_offsets,
    i64 pending_lengths,
    i64 pending_outer_indices,
    i64 pending_path_indices,
    i64 pending_payload_indices,
    i64 pending_type_structs,
    i64 pending_types,
    i64 pending_array_extents,
    i64&mut pending_binding_count,
) -> bool {
    if (token_is_wildcard(&builder.scan.input, &builder.current)) {
        hir_advance(builder);
        return true;
    }
    // Binding modes are represented explicitly in HIR. Plain and `move` are
    // owning/value bindings; `ref` and `ref mut` borrow the matched place.
    i64 binding_mode = 0;
    if (builder.current.kind == TokenKind::Identifier) {
        if (token_is_move(&builder.scan.input, &builder.current)) {
            hir_advance(builder);
        } else if (token_is_ref(&builder.scan.input, &builder.current)) {
            binding_mode = 1;
            hir_advance(builder);
            if (
                builder.current.kind == TokenKind::Identifier &&
                token_is_mut(&builder.scan.input, &builder.current)
            ) {
                binding_mode = 2;
                hir_advance(builder);
            }
        }
    }
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }
    i64 name_offset = builder.current.offset;
    i64 name_length = builder.current.length;
    if (
        !hir_match_record_binding_named(
            builder,
            name_offset,
            name_length,
            binding_structure,
            binding_type,
            binding_array_extent,
            payload,
            path,
            pending_offsets,
            pending_lengths,
            pending_outer_indices,
            pending_path_indices,
            pending_payload_indices,
            pending_type_structs,
            pending_types,
            pending_array_extents,
            pending_binding_count,
            binding_mode,
        )
    ) {
        return false;
    }
    hir_advance(builder);
    return true;
}

fn hir_match_parse_value_pattern(
    HirBuilder&mut builder,
    i64 value_structure,
    i64 value_type,
    i64 value_array_extent,
    i64 value_enum,
    i64 payload,
    i64 path,
    i64 pending_offsets,
    i64 pending_lengths,
    i64 pending_outer_indices,
    i64 pending_path_indices,
    i64 pending_payload_indices,
    i64 pending_type_structs,
    i64 pending_types,
    i64 pending_array_extents,
    i64&mut pending_binding_count,
    i64 pending_nested_paths,
    i64 pending_nested_values,
    i64&mut pending_nested_count,
) -> bool {
    if (builder.current.kind != TokenKind::Identifier) {
        if (token_is_wildcard(&builder.scan.input, &builder.current)) {
            return hir_match_record_binding(
                builder,
                value_structure,
                value_type,
                value_array_extent,
                payload,
                path,
                pending_offsets,
                pending_lengths,
                pending_outer_indices,
                pending_path_indices,
                pending_payload_indices,
                pending_type_structs,
                pending_types,
                pending_array_extents,
                pending_binding_count,
            );
        }
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }

    i64 nested_enum = value_enum;
    if (nested_enum < 0 && hir_type_is_enum(value_type)) {
        nested_enum = hir_type_enum_index(value_type);
    }
    if (nested_enum >= 0) {
        if (
            token_same(
                &builder.scan.input,
                raz_compiler_rt_arena_get(builder.module.enum_name_offsets, nested_enum),
                raz_compiler_rt_arena_get(builder.module.enum_name_lengths, nested_enum),
                builder.current.offset,
                builder.current.length,
            )
        ) {
            hir_advance(builder);
            if (builder.current.kind == TokenKind::Dot || builder.current.kind == TokenKind::ColonColon) {
                hir_advance(builder);
            } else {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            if (builder.current.kind != TokenKind::Identifier) {
                hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
                return false;
            }
            i64 nested_member = hir_find_enum_member_index(
                builder,
                nested_enum,
                builder.current.offset,
                builder.current.length,
            );
            if (nested_member < 0) {
                hir_fail(builder, DiagnosticCode::UnknownName);
                return false;
            }
            if (*pending_nested_count >= 256) {
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }
            raz_compiler_rt_arena_set(pending_nested_paths, *pending_nested_count, path);
            raz_compiler_rt_arena_set(
                pending_nested_values,
                *pending_nested_count,
                raz_compiler_rt_arena_get(builder.module.enum_member_values, nested_member),
            );
            *pending_nested_count += 1;
            hir_advance(builder);

            i64 child_start = raz_compiler_rt_arena_get(builder.module.enum_member_payload_starts, nested_member);
            i64 child_count = raz_compiler_rt_arena_get(builder.module.enum_member_payload_counts, nested_member);
            if (child_count > 0) {
                if (!hir_expect(builder, TokenKind::LeftParen)) { return false; }
                i64 child_index = 0;
                while (child_index < child_count) {
                    if (builder.current.kind == TokenKind::DotDot) {
                        hir_advance(builder);
                        child_index = child_count;
                        break;
                    }
                    i64 child_payload = child_start + child_index;
                    i64 child_path = hir_match_path_create(builder, path, child_index);
                    if (child_path < 0) { return false; }
                    if (
                        !hir_match_parse_value_pattern(
                            builder,
                            raz_compiler_rt_arena_get(builder.module.enum_payload_type_structs, child_payload),
                            raz_compiler_rt_arena_get(builder.module.enum_payload_types, child_payload),
                            raz_compiler_rt_arena_get(builder.module.enum_payload_array_extents, child_payload),
                            hir_match_payload_enum(builder, child_payload),
                            child_payload,
                            child_path,
                            pending_offsets,
                            pending_lengths,
                            pending_outer_indices,
                            pending_path_indices,
                            pending_payload_indices,
                            pending_type_structs,
                            pending_types,
                            pending_array_extents,
                            pending_binding_count,
                            pending_nested_paths,
                            pending_nested_values,
                            pending_nested_count,
                        )
                    ) {
                        return false;
                    }
                    child_index += 1;
                    if (child_index < child_count && !hir_expect(builder, TokenKind::Comma)) {
                        return false;
                    }
                }
                return hir_expect(builder, TokenKind::RightParen);
            }
            if (builder.current.kind == TokenKind::LeftParen) {
                hir_fail(builder, DiagnosticCode::WrongArgumentCount);
                return false;
            }
            return true;
        }
    }

    // Named aggregate patterns use the source struct name and field names, but
    // the path itself remains backend-neutral. Struct-field steps are encoded
    // as -(field_index + 1); enum-payload steps remain non-negative.
    if (value_structure >= 0) {
        Lexer lookahead = builder.scan;
        Token next;
        next_token(&mut lookahead, &mut next);
        if (
            next.kind == TokenKind::LeftBrace &&
            token_same(
                &builder.scan.input,
                raz_compiler_rt_arena_get(builder.module.struct_name_offsets, value_structure),
                raz_compiler_rt_arena_get(builder.module.struct_name_lengths, value_structure),
                builder.current.offset,
                builder.current.length,
            )
        ) {
            hir_advance(builder);
            if (!hir_expect(builder, TokenKind::LeftBrace)) { return false; }
            i64 field_start = raz_compiler_rt_arena_get(builder.module.struct_field_starts, value_structure);
            i64 field_count = raz_compiler_rt_arena_get(builder.module.struct_field_counts, value_structure);
            i64 seen_fields = raz_compiler_rt_arena_create(field_count + 1);
            if (seen_fields == 0) {
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }
            i64 seen_count = 0;
            bool rest_seen = false;
            while (builder.current.kind != TokenKind::RightBrace) {
                if (builder.current.kind == TokenKind::DotDot) {
                    hir_advance(builder);
                    rest_seen = true;
                    if (builder.current.kind == TokenKind::Comma) { hir_advance(builder); }
                    if (builder.current.kind != TokenKind::RightBrace) {
                        raz_compiler_rt_arena_destroy(seen_fields);
                        hir_fail(builder, DiagnosticCode::ExpectedToken);
                        return false;
                    }
                    break;
                }
                i64 shorthand_binding_mode = 0;
                if (builder.current.kind == TokenKind::Identifier) {
                    if (token_is_move(&builder.scan.input, &builder.current)) {
                        hir_advance(builder);
                    } else if (token_is_ref(&builder.scan.input, &builder.current)) {
                        shorthand_binding_mode = 1;
                        hir_advance(builder);
                        if (
                            builder.current.kind == TokenKind::Identifier &&
                            token_is_mut(&builder.scan.input, &builder.current)
                        ) {
                            shorthand_binding_mode = 2;
                            hir_advance(builder);
                        }
                    }
                }
                if (builder.current.kind != TokenKind::Identifier || rest_seen) {
                    raz_compiler_rt_arena_destroy(seen_fields);
                    hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
                    return false;
                }
                i64 field = hir_find_struct_field(
                    builder,
                    value_structure,
                    builder.current.offset,
                    builder.current.length,
                );
                if (field < 0) {
                    raz_compiler_rt_arena_destroy(seen_fields);
                    hir_fail(builder, DiagnosticCode::UnknownName);
                    return false;
                }
                i64 seen = 0;
                while (seen < seen_count) {
                    if (raz_compiler_rt_arena_get(seen_fields, seen) == field) {
                        raz_compiler_rt_arena_destroy(seen_fields);
                        hir_fail(builder, DiagnosticCode::DuplicateName);
                        return false;
                    }
                    seen += 1;
                }
                raz_compiler_rt_arena_set(seen_fields, seen_count, field);
                seen_count += 1;

                i64 name_offset = builder.current.offset;
                i64 name_length = builder.current.length;
                i64 relative_field = field - field_start;
                i64 field_path = hir_match_path_create(builder, path, -relative_field - 1);
                if (field_path < 0) {
                    raz_compiler_rt_arena_destroy(seen_fields);
                    return false;
                }
                i64 field_structure = raz_compiler_rt_arena_get(builder.module.struct_field_type_structs, field);
                i64 field_type = raz_compiler_rt_arena_get(builder.module.struct_field_types, field);
                i64 field_extent = raz_compiler_rt_arena_get(builder.module.struct_field_array_extents, field);
                hir_advance(builder);

                if (builder.current.kind == TokenKind::Colon) {
                    if (shorthand_binding_mode != 0) {
                        raz_compiler_rt_arena_destroy(seen_fields);
                        hir_fail(builder, DiagnosticCode::ExpectedToken);
                        return false;
                    }
                    hir_advance(builder);
                    if (
                        !hir_match_parse_value_pattern(
                            builder,
                            field_structure,
                            field_type,
                            field_extent,
                            -1,
                            -1,
                            field_path,
                            pending_offsets,
                            pending_lengths,
                            pending_outer_indices,
                            pending_path_indices,
                            pending_payload_indices,
                            pending_type_structs,
                            pending_types,
                            pending_array_extents,
                            pending_binding_count,
                            pending_nested_paths,
                            pending_nested_values,
                            pending_nested_count,
                        )
                    ) {
                        raz_compiler_rt_arena_destroy(seen_fields);
                        return false;
                    }
                } else {
                    if (
                        !hir_match_record_binding_named(
                            builder,
                            name_offset,
                            name_length,
                            field_structure,
                            field_type,
                            field_extent,
                            -1,
                            field_path,
                            pending_offsets,
                            pending_lengths,
                            pending_outer_indices,
                            pending_path_indices,
                            pending_payload_indices,
                            pending_type_structs,
                            pending_types,
                            pending_array_extents,
                            pending_binding_count,
                            shorthand_binding_mode,
                        )
                    ) {
                        raz_compiler_rt_arena_destroy(seen_fields);
                        return false;
                    }
                }
                if (builder.current.kind == TokenKind::Comma) {
                    hir_advance(builder);
                } else if (builder.current.kind != TokenKind::RightBrace) {
                    raz_compiler_rt_arena_destroy(seen_fields);
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            }
            if (!rest_seen && seen_count != field_count) {
                raz_compiler_rt_arena_destroy(seen_fields);
                hir_fail(builder, DiagnosticCode::WrongArgumentCount);
                return false;
            }
            raz_compiler_rt_arena_destroy(seen_fields);
            return hir_expect(builder, TokenKind::RightBrace);
        }
    }

    return hir_match_record_binding(
        builder,
        value_structure,
        value_type,
        value_array_extent,
        payload,
        path,
        pending_offsets,
        pending_lengths,
        pending_outer_indices,
        pending_path_indices,
        pending_payload_indices,
        pending_type_structs,
        pending_types,
        pending_array_extents,
        pending_binding_count,
    );
}

fn hir_match_parse_payload_pattern(
    HirBuilder&mut builder,
    i64 payload,
    i64 path,
    i64 pending_offsets,
    i64 pending_lengths,
    i64 pending_outer_indices,
    i64 pending_path_indices,
    i64 pending_payload_indices,
    i64 pending_type_structs,
    i64 pending_types,
    i64 pending_array_extents,
    i64&mut pending_binding_count,
    i64 pending_nested_paths,
    i64 pending_nested_values,
    i64&mut pending_nested_count,
) -> bool {
    return hir_match_parse_value_pattern(
        builder,
        raz_compiler_rt_arena_get(builder.module.enum_payload_type_structs, payload),
        raz_compiler_rt_arena_get(builder.module.enum_payload_types, payload),
        raz_compiler_rt_arena_get(builder.module.enum_payload_array_extents, payload),
        hir_match_payload_enum(builder, payload),
        payload,
        path,
        pending_offsets,
        pending_lengths,
        pending_outer_indices,
        pending_path_indices,
        pending_payload_indices,
        pending_type_structs,
        pending_types,
        pending_array_extents,
        pending_binding_count,
        pending_nested_paths,
        pending_nested_values,
        pending_nested_count,
    );
}

fn hir_parse_match_statement(HirBuilder&mut builder) -> bool {
    hir_advance(builder);

    i64 subject = -1;

    if (!hir_parse_expression(builder, &mut subject)) {
        return false;
    }
    if (!hir_expect(builder, TokenKind::LeftBrace)) {
        return false;
    }

    i64 arm_start = builder.module.match_arm_count;
    i64 arm_count = 0;
    i64 pattern_enum = -1;
    bool wildcard_seen = false;
    bool match_consumes_subject = false;

    while (builder.current.kind != TokenKind::RightBrace && builder.current.kind != TokenKind::End) {
        if (builder.module.match_arm_count >= 8192) {
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
        }

        i64 value = 0;
        i64 wildcard = 0;
        i64 enumeration = -1;
        i64 member_index = -1;
        i64 payload_start = 0;
        i64 payload_count = 0;
        i64 pending_offsets = 0;
        i64 pending_lengths = 0;
        i64 pending_outer_indices = 0;
        i64 pending_inner_indices = 0;
        i64 pending_payload_indices = 0;
        i64 pending_type_structs = 0;
        i64 pending_types = 0;
        i64 pending_array_extents = 0;
        i64 pending_binding_count = 0;
        i64 pending_nested_outer_indices = 0;
        i64 pending_nested_values = 0;
        i64 pending_nested_count = 0;
        bool arm_guarded = false;
        i64 guard_start = -1;
        i64 guard = -1;

        if (token_is_wildcard(&builder.scan.input, &builder.current)) {
            wildcard = 1;
            hir_advance(builder);
        } else {
            if (wildcard_seen || builder.current.kind != TokenKind::Identifier) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            // Parse the enum as a complete type so generic patterns such as
            // `Result<T, E>::Ok(value)` resolve through the same substitution
            // machinery as declarations and expressions.

            i64 direct_enum = hir_find_enum(builder, builder.current.offset, builder.current.length);
            i64 generic_enum = hir_find_generic_enum(builder, builder.current.offset, builder.current.length);
            Lexer pattern_scan = builder.scan;
            Token pattern_next;

            next_token(&mut pattern_scan, &mut pattern_next);
            bool explicit_generic = pattern_next.kind == TokenKind::Less;

            if (direct_enum >= 0 && !explicit_generic) {
                // A match pattern's `::` separates the enum type from its
                // variant. Do not hand `Enum::Variant` to the general qualified
                // type parser: it will correctly assume every `::` remains part
                // of the type path and consume the variant name. Direct enum
                // lookup also preserves identity for fieldless enums, whose
                // runtime scalar representation intentionally has type kind 0.
                enumeration = direct_enum;
                hir_advance(builder);
            } else {
                i64 pattern_structure = -1;
                i64 pattern_type = 0;
                i64 pattern_reference = 0;
                i64 pattern_slice = 0;
                i64 pattern_slice_mutable = 0;

                if (
                    generic_enum < 0 ||
                    !hir_parse_type_spec(
                        builder,
                        &mut pattern_structure,
                        &mut pattern_type,
                        &mut pattern_reference,
                        &mut pattern_slice,
                        &mut pattern_slice_mutable,
                    ) ||
                    pattern_structure >= 0 ||
                    pattern_reference != 0 ||
                    pattern_slice != 0 ||
                    !hir_type_is_enum(pattern_type)
                ) {
                    hir_fail(builder, DiagnosticCode::UnknownType);
                    return false;
                }
                enumeration = hir_type_enum_index(pattern_type);
            }
            if (pattern_enum < 0) {
                pattern_enum = enumeration;
            } else if (pattern_enum != enumeration) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            if (builder.current.kind == TokenKind::Dot || builder.current.kind == TokenKind::ColonColon) {
                hir_advance(builder);
            } else {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            if (builder.current.kind != TokenKind::Identifier) {
                hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
                return false;
            }
            member_index = hir_find_enum_member_index(
                builder,
                enumeration,
                builder.current.offset,
                builder.current.length,
            );
            if (member_index < 0) {
                hir_fail(builder, DiagnosticCode::UnknownName);
                return false;
            }
            value = raz_compiler_rt_arena_get(builder.module.enum_member_values, member_index);
            payload_start = raz_compiler_rt_arena_get(
                builder.module.enum_member_payload_starts,
                member_index
            );
            payload_count = raz_compiler_rt_arena_get(
                builder.module.enum_member_payload_counts,
                member_index
            );
            hir_advance(builder);
            if (payload_count > 0) {
                if (!hir_expect(builder, TokenKind::LeftParen)) {
                    return false;
                }
                // A single outer payload can expand into multiple bindings when
                // it is destructured as a nested enum variant. Keep pending
                // binding metadata separate from the outer payload arity.
                pending_offsets = raz_compiler_rt_arena_create(256);
                pending_lengths = raz_compiler_rt_arena_create(256);
                pending_outer_indices = raz_compiler_rt_arena_create(256);
                pending_inner_indices = raz_compiler_rt_arena_create(256);
                pending_payload_indices = raz_compiler_rt_arena_create(256);
                pending_type_structs = raz_compiler_rt_arena_create(256);
                pending_types = raz_compiler_rt_arena_create(256);
                pending_array_extents = raz_compiler_rt_arena_create(256);
                pending_nested_outer_indices = raz_compiler_rt_arena_create(256);
                pending_nested_values = raz_compiler_rt_arena_create(256);
                if (
                    pending_offsets == 0 ||
                    pending_lengths == 0 ||
                    pending_outer_indices == 0 ||
                    pending_inner_indices == 0 ||
                    pending_payload_indices == 0 ||
                    pending_type_structs == 0 ||
                    pending_types == 0 ||
                    pending_array_extents == 0 ||
                    pending_nested_outer_indices == 0 ||
                    pending_nested_values == 0
                ) {
                    hir_fail(builder, DiagnosticCode::TooManyItems);
                    return false;
                }

                i64 payload_index = 0;

                while (payload_index < payload_count) {
                    // Permit partial positional destructuring with a terminal
                    // rest pattern. Unlike `_`, which ignores exactly one
                    // payload, `..` ignores every remaining payload.
                    if (builder.current.kind == TokenKind::DotDot) {
                        hir_advance(builder);
                        payload_index = payload_count;
                        break;
                    }
                    i64 path = hir_match_path_create(builder, -1, payload_index);
                    if (path < 0) { return false; }
                    if (
                        !hir_match_parse_payload_pattern(
                            builder,
                            payload_start + payload_index,
                            path,
                            pending_offsets,
                            pending_lengths,
                            pending_outer_indices,
                            pending_inner_indices,
                            pending_payload_indices,
                            pending_type_structs,
                            pending_types,
                            pending_array_extents,
                            &mut pending_binding_count,
                            pending_nested_outer_indices,
                            pending_nested_values,
                            &mut pending_nested_count,
                        )
                    ) {
                        return false;
                    }
                    payload_index += 1;
                    if (payload_index < payload_count && !hir_expect(builder, TokenKind::Comma)) {
                        return false;
                    }
                }
                if (!hir_expect(builder, TokenKind::RightParen)) {
                    return false;
                }
            } else if (builder.current.kind == TokenKind::LeftParen) {
                hir_fail(builder, DiagnosticCode::WrongArgumentCount);
                return false;
            }

            if (
                builder.current.kind == TokenKind::Identifier &&
                token_is_if(&builder.scan.input, &builder.current)
            ) {
                arm_guarded = true;
                hir_advance(builder);
                guard_start = builder.current.offset;
                while (builder.current.kind != TokenKind::FatArrow && builder.current.kind != TokenKind::End) {
                    hir_advance(builder);
                }
                if (builder.current.kind != TokenKind::FatArrow || guard_start < 0) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
            }

            i64 prior = arm_start;

            while (prior < builder.module.match_arm_count) {
                if (
                    !arm_guarded &&
                    raz_compiler_rt_arena_get(builder.module.match_arm_guards, prior) < 0 &&
                    raz_compiler_rt_arena_get(builder.module.match_arm_wildcards, prior) == 0 &&
                    raz_compiler_rt_arena_get(builder.module.match_arm_enum_indices, prior) == enumeration &&
                    raz_compiler_rt_arena_get(builder.module.match_arm_member_indices, prior) == member_index
                ) {
                    // Repeating an outer variant is only a duplicate when the
                    // structural nested constraints are also identical. This
                    // permits disjoint arms such as Some(Ok(value)) and
                    // Some(Err(error)) while preserving the ordinary duplicate
                    // variant diagnostic and rejecting repeated nested arms.
                    i64 prior_nested_count = raz_compiler_rt_arena_get(
                        builder.module.match_arm_nested_test_counts,
                        prior
                    );

                    bool same_nested_pattern = prior_nested_count == pending_nested_count;

                    if (same_nested_pattern) {
                        i64 prior_nested_start = raz_compiler_rt_arena_get(
                            builder.module.match_arm_nested_test_starts,
                            prior
                        );

                        i64 nested_compare = 0;

                        while (nested_compare < pending_nested_count && same_nested_pattern) {
                            if (
                                raz_compiler_rt_arena_get(
                                    builder.module.match_nested_test_path_indices,
                                    prior_nested_start + nested_compare,
                                ) != raz_compiler_rt_arena_get(pending_nested_outer_indices, nested_compare) ||
                                raz_compiler_rt_arena_get(
                                    builder.module.match_nested_test_values,
                                    prior_nested_start + nested_compare,
                                ) != raz_compiler_rt_arena_get(pending_nested_values, nested_compare)
                            ) {
                                same_nested_pattern = false;
                            }
                            nested_compare += 1;
                        }
                    }
                    if (
                        same_nested_pattern ||
                        hir_match_arm_nested_subsumes(
                            builder,
                            prior,
                            pending_nested_outer_indices,
                            pending_nested_values,
                            pending_nested_count,
                        )
                    ) {
                        // A previous arm either exactly duplicates this pattern
                        // or already covers every value this more-specific arm
                        // could match. Reject the unreachable/subsumed arm.
                        hir_fail(builder, DiagnosticCode::UnreachablePattern);
                        return false;
                    }
                }
                prior += 1;
            }
        }
        if (
            !arm_guarded &&
            builder.current.kind == TokenKind::Identifier &&
            token_is_if(&builder.scan.input, &builder.current)
        ) {
            arm_guarded = true;
            hir_advance(builder);
            guard_start = builder.current.offset;
            while (builder.current.kind != TokenKind::FatArrow && builder.current.kind != TokenKind::End) {
                hir_advance(builder);
            }
            if (builder.current.kind != TokenKind::FatArrow || guard_start < 0) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
        }
        if (!hir_expect(builder, TokenKind::FatArrow)) {
            return false;
        }
        if (builder.current.kind != TokenKind::LeftBrace) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }

        i64 arm_body_start = 0;
        i64 arm_body_end = 0;
        i64 arm_block = -1;

        if (!hir_capture_block(builder, &mut arm_body_start, &mut arm_body_end, &mut arm_block)) {
            return false;
        }

        i64 binding_start = builder.module.match_binding_count;

        if (pending_binding_count > 0) {
            i64 binding_index = 0;

            while (binding_index < pending_binding_count) {
                if (builder.module.match_binding_count >= 16384) {
                    hir_fail(builder, DiagnosticCode::TooManyItems);
                    return false;
                }
                if (builder.module.local_count >= 32768) {
                    hir_fail(builder, DiagnosticCode::TooManyItems);
                    return false;
                }

                i64 payload = raz_compiler_rt_arena_get(pending_payload_indices, binding_index);
                i64 encoded_outer = raz_compiler_rt_arena_get(pending_outer_indices, binding_index);
                i64 binding_mode = 0;
                if (encoded_outer >= 65536) {
                    binding_mode = 2;
                    encoded_outer -= 65536;
                } else if (encoded_outer >= 32768) {
                    binding_mode = 1;
                    encoded_outer -= 32768;
                }
                i64 binding_structure = raz_compiler_rt_arena_get(pending_type_structs, binding_index);
                i64 binding_type = raz_compiler_rt_arena_get(pending_types, binding_index);
                i64 binding_array_extent = raz_compiler_rt_arena_get(pending_array_extents, binding_index);
                i64 local_index = builder.module.local_count;

                i64 local_slot = raz_compiler_rt_arena_get(
                    builder.module.function_local_counts,
                    builder.current_function,
                );
                builder.module.local_count += 1;
                raz_compiler_rt_arena_set(
                    builder.module.local_name_offsets,
                    local_index,
                    raz_compiler_rt_arena_get(pending_offsets, binding_index),
                );
                raz_compiler_rt_arena_set(
                    builder.module.local_name_lengths,
                    local_index,
                    raz_compiler_rt_arena_get(pending_lengths, binding_index),
                );
                raz_compiler_rt_arena_set(
                    builder.module.local_function_indices,
                    local_index,
                    builder.current_function,
                );
                raz_compiler_rt_arena_set(builder.module.local_block_indices, local_index, arm_block);
                raz_compiler_rt_arena_set(builder.module.local_type_structs, local_index, binding_structure);
                raz_compiler_rt_arena_set(builder.module.local_types, local_index, binding_type);
                if (
                    binding_mode == 0 &&
                    binding_structure >= 0 &&
                    raz_compiler_rt_arena_get(builder.module.struct_copy_flags, binding_structure) == 0
                ) {
                    match_consumes_subject = true;
                }
                i64 binding_reference = 0;
                i64 binding_reference_mutable = 0;
                if (binding_mode != 0) { binding_reference = 1; }
                if (binding_mode == 2) { binding_reference_mutable = 1; }
                raz_compiler_rt_arena_set(
                    builder.module.local_references,
                    local_index,
                    binding_reference,
                );
                raz_compiler_rt_arena_set(
                    builder.module.local_reference_mutable,
                    local_index,
                    binding_reference_mutable,
                );
                raz_compiler_rt_arena_set(
                    builder.module.local_array_extents,
                    local_index,
                    binding_array_extent,
                );
                raz_compiler_rt_arena_set(
                    builder.module.local_array_element_starts,
                    local_index,
                    builder.module.array_element_count,
                );
                raz_compiler_rt_arena_set(builder.module.local_array_element_counts, local_index, 0);
                raz_compiler_rt_arena_set(builder.module.local_callable_functions, local_index, -1);
                raz_compiler_rt_arena_set(builder.module.local_callable_kinds, local_index, 0);
                raz_compiler_rt_arena_set(builder.module.local_callable_capture_starts, local_index, 0);
                raz_compiler_rt_arena_set(builder.module.local_callable_capture_counts, local_index, 0);
                raz_compiler_rt_arena_set(builder.module.local_callable_consumed, local_index, 0);
                raz_compiler_rt_arena_set(builder.module.local_function_types, local_index, -1);
                raz_compiler_rt_arena_set(
                    builder.module.function_local_counts,
                    builder.current_function,
                    local_slot + 1,
                );
                hir_register_local(builder, local_index, local_slot);
                raz_compiler_rt_arena_set(
                    builder.module.match_binding_local_slots,
                    builder.module.match_binding_count,
                    local_slot,
                );
                raz_compiler_rt_arena_set(
                    builder.module.match_binding_outer_indices,
                    builder.module.match_binding_count,
                    encoded_outer,
                );
                raz_compiler_rt_arena_set(
                    builder.module.match_binding_inner_indices,
                    builder.module.match_binding_count,
                    -2,
                );
                raz_compiler_rt_arena_set(
                    builder.module.match_binding_path_indices,
                    builder.module.match_binding_count,
                    raz_compiler_rt_arena_get(pending_inner_indices, binding_index),
                );
                raz_compiler_rt_arena_set(
                    builder.module.match_binding_payload_indices,
                    builder.module.match_binding_count,
                    payload,
                );
                raz_compiler_rt_arena_set(
                    builder.module.match_binding_modes,
                    builder.module.match_binding_count,
                    binding_mode,
                );
                if (binding_mode != 0) {
                    i64 root_kind = 0;
                    i64 root_index = -1;
                    i64 borrow_path = 0;
                    i64 mutable_borrow = 0;
                    if (binding_mode == 2) { mutable_borrow = 1; }
                    i64 binding_offset = raz_compiler_rt_arena_get(pending_offsets, binding_index);
                    i64 binding_match_path = raz_compiler_rt_arena_get(pending_inner_indices, binding_index);
                    if (
                        !hir_validate_match_borrow(
                            builder,
                            subject,
                            binding_match_path,
                            mutable_borrow,
                            binding_offset,
                            &mut root_kind,
                            &mut root_index,
                            &mut borrow_path,
                        )
                    ) {
                        return false;
                    }
                    raz_compiler_rt_arena_set(builder.local_borrow_kinds, local_index, binding_mode);
                    raz_compiler_rt_arena_set(builder.local_borrow_source_kinds, local_index, root_kind);
                    raz_compiler_rt_arena_set(builder.local_borrow_source_indices, local_index, root_index);
                    raz_compiler_rt_arena_set(builder.local_borrow_source_paths, local_index, borrow_path);
                    raz_compiler_rt_arena_set(
                        builder.local_reference_last_uses,
                        local_index,
                        hir_compute_local_reference_last_use(builder, local_index),
                    );
                } else {
                    hir_record_local_borrow(builder, local_index, -1);
                }
                builder.module.match_binding_count += 1;
                binding_index += 1;
            }
        }

        if (arm_guarded) {
            i64 saved_scan_offset = builder.scan.offset;
            TokenKind saved_kind = builder.current.kind;
            i64 saved_offset = builder.current.offset;
            i64 saved_length = builder.current.length;
            i64 saved_block = builder.current_block;

            builder.current_block = arm_block;
            builder.scan.offset = guard_start;
            next_token(&mut builder.scan, &mut builder.current);
            if (!hir_parse_expression(builder, &mut guard) || builder.current.kind != TokenKind::FatArrow) {
                builder.current_block = saved_block;
                builder.scan.offset = saved_scan_offset;
                builder.current.kind = saved_kind;
                builder.current.offset = saved_offset;
                builder.current.length = saved_length;
                if (builder.module.diagnostic_code == DiagnosticCode::None) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                }
                return false;
            }
            builder.current_block = saved_block;
            builder.scan.offset = saved_scan_offset;
            builder.current.kind = saved_kind;
            builder.current.offset = saved_offset;
            builder.current.length = saved_length;
        }

        i64 nested_test_start = builder.module.match_nested_test_count;
        i64 nested_test = 0;

        while (nested_test < pending_nested_count) {
            if (builder.module.match_nested_test_count >= 16384) {
                hir_fail(builder, DiagnosticCode::TooManyItems);
                return false;
            }
            i64 nested_path = raz_compiler_rt_arena_get(pending_nested_outer_indices, nested_test);
            raz_compiler_rt_arena_set(
                builder.module.match_nested_test_outer_indices,
                builder.module.match_nested_test_count,
                hir_match_path_root_payload(builder, nested_path),
            );
            raz_compiler_rt_arena_set(
                builder.module.match_nested_test_path_indices,
                builder.module.match_nested_test_count,
                nested_path,
            );
            raz_compiler_rt_arena_set(
                builder.module.match_nested_test_values,
                builder.module.match_nested_test_count,
                raz_compiler_rt_arena_get(pending_nested_values, nested_test),
            );
            builder.module.match_nested_test_count += 1;
            nested_test += 1;
        }
        if (pending_offsets != 0) {
            raz_compiler_rt_arena_destroy(pending_offsets);
        }
        if (pending_lengths != 0) {
            raz_compiler_rt_arena_destroy(pending_lengths);
        }
        if (pending_outer_indices != 0) {
            raz_compiler_rt_arena_destroy(pending_outer_indices);
        }
        if (pending_inner_indices != 0) {
            raz_compiler_rt_arena_destroy(pending_inner_indices);
        }
        if (pending_payload_indices != 0) {
            raz_compiler_rt_arena_destroy(pending_payload_indices);
        }
        if (pending_type_structs != 0) {
            raz_compiler_rt_arena_destroy(pending_type_structs);
        }
        if (pending_types != 0) {
            raz_compiler_rt_arena_destroy(pending_types);
        }
        if (pending_array_extents != 0) {
            raz_compiler_rt_arena_destroy(pending_array_extents);
        }
        if (pending_nested_outer_indices != 0) {
            raz_compiler_rt_arena_destroy(pending_nested_outer_indices);
        }
        if (pending_nested_values != 0) {
            raz_compiler_rt_arena_destroy(pending_nested_values);
        }

        i64 arm = builder.module.match_arm_count;

        raz_compiler_rt_arena_set(builder.module.match_arm_values, arm, value);
        raz_compiler_rt_arena_set(builder.module.match_arm_blocks, arm, arm_block);
        raz_compiler_rt_arena_set(builder.module.match_arm_guards, arm, guard);
        raz_compiler_rt_arena_set(builder.module.match_arm_wildcards, arm, wildcard);
        raz_compiler_rt_arena_set(builder.module.match_arm_enum_indices, arm, enumeration);
        raz_compiler_rt_arena_set(builder.module.match_arm_member_indices, arm, member_index);
        raz_compiler_rt_arena_set(builder.module.match_arm_binding_starts, arm, binding_start);
        raz_compiler_rt_arena_set(builder.module.match_arm_binding_counts, arm, pending_binding_count);
        raz_compiler_rt_arena_set(builder.module.match_arm_nested_test_starts, arm, nested_test_start);
        raz_compiler_rt_arena_set(builder.module.match_arm_nested_test_counts, arm, pending_nested_count);
        builder.module.match_arm_count += 1;
        arm_count += 1;
        if (wildcard != 0 && !arm_guarded) {
            wildcard_seen = true;
        }
        if (builder.current.kind == TokenKind::Comma) {
            hir_advance(builder);
        }
        if (wildcard != 0 && !arm_guarded && builder.current.kind != TokenKind::RightBrace) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
    }
    if (!hir_expect(builder, TokenKind::RightBrace)) {
        return false;
    }
    if (arm_count == 0) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    if (!wildcard_seen) {
        if (
            pattern_enum < 0 ||
            !hir_match_is_exhaustive(builder, pattern_enum, arm_start, builder.module.match_arm_count, )
        ) {
            hir_fail(builder, DiagnosticCode::NonExhaustivePattern);
            return false;
        }
    }
    if (match_consumes_subject) {
        i64 root_kind = 0;
        i64 root_index = -1;
        i64 root_path = 0;

        if (hir_node_path(builder, subject, &mut root_kind, &mut root_index, &mut root_path)) {
            // Moving an owning enum payload leaves the aggregate partially
            // initialized. Record a child-path move rather than a deferred
            // whole-value move so any later use of the enum is rejected
            // eagerly, while a whole-value reassignment can still reinitialize
            // it by clearing the path set.

            i64 consumed_path = root_path * 4096 + 1;

            if (!hir_mark_path_moved(builder, root_kind, root_index, consumed_path)) {
                return false;
            }
        }
    }
    return hir_add_statement(builder, 15, subject, arm_start, arm_count);
}

fn hir_local_index_for_slot(HirBuilder&mut builder, i64 slot) -> i64 {
    return hir_local_index_from_slot(builder, slot);
}

fn hir_method_name_kind(Source& source, i64 offset, i64 length) -> i64 {
    // 1 = into_iter, 2 = next, 3 = current.
    if (
        length == 9 &&
        source_byte(source, offset) == 105 &&
        source_byte(source, offset + 1) == 110 &&
        source_byte(source, offset + 2) == 116 &&
        source_byte(source, offset + 3) == 111 &&
        source_byte(source, offset + 4) == 95 &&
        source_byte(source, offset + 5) == 105 &&
        source_byte(source, offset + 6) == 116 &&
        source_byte(source, offset + 7) == 101 &&
        source_byte(source, offset + 8) == 114
    ) {
        return 1;
    }
    if (
        length == 4 &&
        source_byte(source, offset) == 110 &&
        source_byte(source, offset + 1) == 101 &&
        source_byte(source, offset + 2) == 120 &&
        source_byte(source, offset + 3) == 116
    ) {
        return 2;
    }
    if (
        length == 7 &&
        source_byte(source, offset) == 99 &&
        source_byte(source, offset + 1) == 117 &&
        source_byte(source, offset + 2) == 114 &&
        source_byte(source, offset + 3) == 114 &&
        source_byte(source, offset + 4) == 101 &&
        source_byte(source, offset + 5) == 110 &&
        source_byte(source, offset + 6) == 116
    ) {
        return 3;
    }
    return 0;
}

fn hir_find_iteration_trait(HirBuilder&mut builder, i64 wanted) -> i64 {
    i64 trait_index = 0;

    while (trait_index < builder.module.trait_count) {
        i64 start = raz_compiler_rt_arena_get(builder.module.trait_method_starts, trait_index);
        i64 count = raz_compiler_rt_arena_get(builder.module.trait_method_counts, trait_index);
        i64 method = 0;

        while (method < count) {
            i64 trait_method = start + method;
            i64 offset = raz_compiler_rt_arena_get(builder.module.trait_method_name_offsets, trait_method);
            i64 length = raz_compiler_rt_arena_get(builder.module.trait_method_name_lengths, trait_method);

            if (hir_method_name_kind(&builder.scan.input, offset, length) == wanted) {
                return trait_index;
            }
            method += 1;
        }
        trait_index += 1;
    }
    return -1;
}

fn hir_validate_concrete_into_iterator_item(
    HirBuilder&mut builder,
    i64 source_structure,
    i64 iterator_structure,
) -> bool {
    i64 into_trait = hir_find_iteration_trait(builder, 1);
    i64 iterator_trait = hir_find_iteration_trait(builder, 2);

    if (into_trait < 0 || iterator_trait < 0) {
        return true;
    }

    i64 into_impl = hir_reflection_find_implementation(builder, source_structure, into_trait);
    i64 iterator_impl = hir_reflection_find_implementation(builder, iterator_structure, iterator_trait);

    if (into_impl < 0 || iterator_impl < 0) {
        return true;
    }
    // Generic impl bindings may still contain template parameters here. Their
    // instantiated associated types are validated through normal method types;
    // compare source tokens only for concrete implementations.
    if (
        raz_compiler_rt_arena_get(builder.module.trait_impl_generic_indices, into_impl) >= 0 ||
        raz_compiler_rt_arena_get(builder.module.trait_impl_generic_indices, iterator_impl) >= 0
    ) {
        return true;
    }

    Token into_item;
    Token iterator_item;

    if (
        !hir_reflection_impl_item_token(builder, into_impl, true, 0, &mut into_item) ||
        !hir_reflection_impl_item_token(builder, iterator_impl, true, 0, &mut iterator_item)
    ) {
        return true;
    }
    if (
        !token_same(
            &builder.scan.input,
            into_item.offset,
            into_item.length,
            iterator_item.offset,
            iterator_item.length,
        )
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    return true;
}

fn hir_find_iteration_method(HirBuilder&mut builder, i64 structure, i64 wanted) -> i64 {
    i64 method = 0;

    while (method < builder.module.inherent_method_count) {
        if (
            raz_compiler_rt_arena_get(builder.module.inherent_method_structures, method) == structure &&
            raz_compiler_rt_arena_get(builder.module.inherent_method_receivers, method) != 0
        ) {
            i64 offset = raz_compiler_rt_arena_get(builder.module.inherent_method_name_offsets, method);
            i64 length = raz_compiler_rt_arena_get(builder.module.inherent_method_name_lengths, method);

            if (hir_method_name_kind(&builder.scan.input, offset, length) == wanted) {
                return raz_compiler_rt_arena_get(builder.module.inherent_method_functions, method);
            }
        }
        method += 1;
    }
    return -1;
}

fn hir_make_single_argument_call(HirBuilder&mut builder, i64 target, i64 argument, i64&mut out) -> bool {
    if (
        target < 0 ||
        builder.module.argument_count >= 262144 ||
        raz_compiler_rt_arena_get(builder.module.function_parameter_counts, target) != 1
    ) {
        hir_fail(builder, DiagnosticCode::WrongArgumentCount);
        return false;
    }

    i64 argument_start = builder.module.argument_count;

    raz_compiler_rt_arena_set(builder.module.arguments, builder.module.argument_count, argument);
    builder.module.argument_count += 1;

    i64 call = -1;

    if (!hir_add_node(builder, 4, target, argument_start, 1, 0, &mut call)) {
        return false;
    }
    hir_set_node_type(builder, call, raz_compiler_rt_arena_get(builder.module.function_return_types, target));
    raz_compiler_rt_arena_set(
        builder.module.node_references,
        call,
        raz_compiler_rt_arena_get(builder.module.function_return_references, target),
    );
    raz_compiler_rt_arena_set(
        builder.module.node_reference_mutable,
        call,
        raz_compiler_rt_arena_get(builder.module.function_return_reference_mutable, target),
    );
    raz_compiler_rt_arena_set(
        builder.module.node_type_structs,
        call,
        raz_compiler_rt_arena_get(builder.module.function_return_type_structs, target),
    );
    raz_compiler_rt_arena_set(
        builder.module.node_slices,
        call,
        raz_compiler_rt_arena_get(builder.module.function_return_slices, target),
    );
    raz_compiler_rt_arena_set(
        builder.module.node_slice_mutable,
        call,
        raz_compiler_rt_arena_get(builder.module.function_return_slice_mutable, target),
    );
    raz_compiler_rt_arena_set(
        builder.module.node_function_types,
        call,
        raz_compiler_rt_arena_get(builder.module.function_return_function_types, target),
    );
    *out = call;
    return true;
}

fn hir_parse_custom_iterator_for(
    HirBuilder&mut builder,
    i64 name_offset,
    i64 name_length,
    i64 iterable,
    i64 structure,
) -> bool {
    // A value that already implements Iterator is directly iterable.  Only use
    // IntoIterator::into_iter when the source does not itself provide the
    // next/current protocol. This mirrors host compiler and avoids forcing wrapper
    // iterators for simple stateful iterator types.

    i64 direct_next = hir_find_iteration_method(builder, structure, 2);
    i64 direct_current = hir_find_iteration_method(builder, structure, 3);
    i64 iterator_value = iterable;
    i64 iterator_structure = structure;

    if (direct_next < 0 || direct_current < 0) {
        i64 into_function = hir_find_iteration_method(builder, structure, 1);

        if (into_function < 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }

        i64 receiver = iterable;

        if (raz_compiler_rt_arena_get(builder.module.node_references, receiver) == 0) {
            // Named places participate in normal borrow-conflict checking. A
            // temporary aggregate/call result has no ownership root yet, but
            // `for value in Type(...)` is allowed to borrow that temporary for
            // the duration of `into_iter`; its value remains live through this
            // call expression and the resulting iterator is stored separately.

            i64 borrow_root_kind = 0;
            i64 borrow_root_index = -1;
            i64 borrow_root_path = 0;

            if (
                hir_node_path(
                    builder,
                    receiver,
                    &mut borrow_root_kind,
                    &mut borrow_root_index,
                    &mut borrow_root_path,
                )
            ) {
                if (!hir_validate_borrow(builder, receiver, 1)) {
                    return false;
                }
            }

            i64 borrowed = -1;

            if (!hir_add_node(builder, 17, receiver, 0, 0, 1, &mut borrowed)) {
                return false;
            }
            hir_copy_node_type(builder, borrowed, receiver);
            raz_compiler_rt_arena_set(builder.module.node_references, borrowed, 1);
            receiver = borrowed;
        }
        if (!hir_make_single_argument_call(builder, into_function, receiver, &mut iterator_value)) {
            return false;
        }
        iterator_structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, iterator_value);
        if (
            iterator_structure >= 0 &&
            !hir_validate_concrete_into_iterator_item(builder, structure, iterator_structure)
        ) {
            return false;
        }
    }
    if (iterator_structure < 0) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }

    i64 next_function = hir_find_iteration_method(builder, iterator_structure, 2);
    i64 current_function = hir_find_iteration_method(builder, iterator_structure, 3);

    // bool is represented by the scalar i64 HIR kind (0). Type id 10 is char.
    if (
        next_function < 0 ||
        current_function < 0 ||
        raz_compiler_rt_arena_get(builder.module.function_return_types, next_function) != 0
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }

    i64 item_type = raz_compiler_rt_arena_get(builder.module.function_return_types, current_function);

    i64 item_structure = raz_compiler_rt_arena_get(
        builder.module.function_return_type_structs,
        current_function,
    );

    i64 child_start = 0;
    i64 child_end = 0;
    i64 child_block = -1;

    builder.loop_depth += 1;

    bool captured_body = hir_capture_block(builder, &mut child_start, &mut child_end, &mut child_block);

    builder.loop_depth -= 1;
    if (!captured_body || builder.module.local_count + 2 >= 32768) {
        return false;
    }

    i64 item_local = builder.module.local_count;
    i64 item_slot = raz_compiler_rt_arena_get(builder.module.function_local_counts, builder.current_function);

    builder.module.local_count += 1;
    raz_compiler_rt_arena_set(builder.module.local_name_offsets, item_local, name_offset);
    raz_compiler_rt_arena_set(builder.module.local_name_lengths, item_local, name_length);
    raz_compiler_rt_arena_set(builder.module.local_function_indices, item_local, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.local_block_indices, item_local, child_block);
    raz_compiler_rt_arena_set(builder.module.local_type_structs, item_local, item_structure);
    raz_compiler_rt_arena_set(builder.module.local_types, item_local, item_type);
    raz_compiler_rt_arena_set(
        builder.module.local_references,
        item_local,
        raz_compiler_rt_arena_get(builder.module.function_return_references, current_function),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_reference_mutable,
        item_local,
        raz_compiler_rt_arena_get(builder.module.function_return_reference_mutable, current_function),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_lifetimes,
        item_local,
        raz_compiler_rt_arena_get(builder.module.function_return_lifetimes, current_function),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_slices,
        item_local,
        raz_compiler_rt_arena_get(builder.module.function_return_slices, current_function),
    );
    raz_compiler_rt_arena_set(
        builder.module.local_slice_mutable,
        item_local,
        raz_compiler_rt_arena_get(builder.module.function_return_slice_mutable, current_function),
    );
    raz_compiler_rt_arena_set(builder.module.local_array_extents, item_local, -1);
    raz_compiler_rt_arena_set(
        builder.module.local_array_element_starts,
        item_local,
        builder.module.array_element_count,
    );
    raz_compiler_rt_arena_set(builder.module.local_array_element_counts, item_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_functions, item_local, -1);
    raz_compiler_rt_arena_set(builder.module.local_callable_kinds, item_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_starts, item_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_counts, item_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_consumed, item_local, 0);
    raz_compiler_rt_arena_set(
        builder.module.local_function_types,
        item_local,
        raz_compiler_rt_arena_get(builder.module.function_return_function_types, current_function),
    );

    i64 iterator_local = builder.module.local_count;
    i64 iterator_slot = item_slot + 1;

    builder.module.local_count += 1;
    raz_compiler_rt_arena_set(builder.module.local_name_offsets, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_name_lengths, iterator_local, 0);
    raz_compiler_rt_arena_set(
        builder.module.local_function_indices,
        iterator_local,
        builder.current_function
    );
    raz_compiler_rt_arena_set(builder.module.local_block_indices, iterator_local, child_block);
    raz_compiler_rt_arena_set(builder.module.local_type_structs, iterator_local, iterator_structure);
    raz_compiler_rt_arena_set(
        builder.module.local_types,
        iterator_local,
        raz_compiler_rt_arena_get(builder.module.node_types, iterator_value),
    );
    raz_compiler_rt_arena_set(builder.module.local_references, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_reference_mutable, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_lifetimes, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_slices, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_slice_mutable, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_array_extents, iterator_local, -1);
    raz_compiler_rt_arena_set(
        builder.module.local_array_element_starts,
        iterator_local,
        builder.module.array_element_count,
    );
    raz_compiler_rt_arena_set(builder.module.local_array_element_counts, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_functions, iterator_local, -1);
    raz_compiler_rt_arena_set(builder.module.local_callable_kinds, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_starts, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_counts, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_consumed, iterator_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_function_types, iterator_local, -1);
    raz_compiler_rt_arena_set(builder.module.function_local_counts, builder.current_function, item_slot + 2);
    hir_register_local(builder, item_local, item_slot);
    hir_register_local(builder, iterator_local, iterator_slot);

    i64 iterator_loop = -1;

    if (
        !hir_add_node(
            builder,
            51,
            iterator_value,
            next_function,
            current_function,
            iterator_slot,
            &mut iterator_loop,
        )
    ) {
        return false;
    }
    hir_set_node_type(builder, iterator_loop, item_type);
    raz_compiler_rt_arena_set(builder.module.node_type_structs, iterator_loop, item_structure);
    return hir_add_statement(builder, 19, item_slot, iterator_loop, child_block);
}

fn hir_parse_for_statement(HirBuilder&mut builder) -> bool {
    hir_advance(builder);
    if (builder.current.kind != TokenKind::Identifier) {
        hir_fail(builder, DiagnosticCode::ExpectedIdentifier);
        return false;
    }

    i64 name_offset = builder.current.offset;
    i64 name_length = builder.current.length;

    hir_advance(builder);
    if (
        builder.current.kind != TokenKind::Identifier ||
        !token_is_in(&builder.scan.input, &builder.current)
    ) {
        hir_fail(builder, DiagnosticCode::ExpectedToken);
        return false;
    }
    hir_advance(builder);

    i64 iterable = -1;

    if (!hir_parse_expression(builder, &mut iterable)) {
        return false;
    }
    bool range_loop =
        builder.current.kind == TokenKind::DotDot ||
        builder.current.kind == TokenKind::DotDotEqual;
    bool inclusive = builder.current.kind == TokenKind::DotDotEqual;
    i64 end_value = -1;
    i64 element_type = 0;
    i64 element_structure = -1;
    i64 array_extent = -1;
    i64 borrowed_array = 0;
    // Fixed-array iteration lowers the array storage itself. A leading `&` or
    // `&mut` controls the element borrow flavor, but it must not replace the
    // iterable value with a reference to the local variable that stores the
    // arena/image pointer.
    i64 array_iterable = iterable;

    if (range_loop) {
        hir_advance(builder);
        bool boolean_range_end =
            builder.current.kind == TokenKind::Identifier &&
            (
                token_is_true(&builder.scan.input, &builder.current) ||
                token_is_false(&builder.scan.input, &builder.current)
            );
        if (!hir_parse_expression(builder, &mut end_value)) {
            return false;
        }
        if (boolean_range_end) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        element_type = hir_binary_type(builder, &mut iterable, &mut end_value);
        if (element_type < 0 || !primitive_type_is_integer(element_type)) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
    } else {
        i64 iterable_kind = raz_compiler_rt_arena_get(builder.module.node_kinds, iterable);
        i64 array_source = iterable;

        if (iterable_kind == 17) {
            borrowed_array = 1 + raz_compiler_rt_arena_get(builder.module.node_values, iterable);
            array_source = raz_compiler_rt_arena_get(builder.module.node_a, iterable);
            array_iterable = array_source;
            iterable_kind = raz_compiler_rt_arena_get(builder.module.node_kinds, array_source);
        }
        if (iterable_kind != 3) {
            i64 iterable_structure = raz_compiler_rt_arena_get(builder.module.node_type_structs, iterable);

            if (iterable_structure >= 0) {
                return hir_parse_custom_iterator_for(
                    builder,
                    name_offset,
                    name_length,
                    iterable,
                    iterable_structure,
                );
            }
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        i64 source_local = hir_local_index_for_slot(
            builder,
            raz_compiler_rt_arena_get(builder.module.node_a, array_source),
        );
        if (source_local < 0) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        array_extent = raz_compiler_rt_arena_get(builder.module.local_array_extents, source_local);
        element_type = raz_compiler_rt_arena_get(builder.module.local_types, source_local);
        element_structure = raz_compiler_rt_arena_get(builder.module.local_type_structs, source_local);
        if (array_extent <= 0) {
            // Ordinary local expressions use node kind 3 regardless of whether
            // the local is an array or a structure. Give structure locals the
            // iterator protocol before applying fixed-array requirements.
            if (element_structure >= 0) {
                return hir_parse_custom_iterator_for(
                    builder,
                    name_offset,
                    name_length,
                    iterable,
                    element_structure,
                );
            }
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
        if (element_structure < 0 && element_type == 1) {
            hir_fail(builder, DiagnosticCode::ExpectedToken);
            return false;
        }
    }

    i64 child_start = 0;
    i64 child_end = 0;
    i64 child_block = -1;

    builder.loop_depth += 1;

    bool captured_body = hir_capture_block(builder, &mut child_start, &mut child_end, &mut child_block);

    builder.loop_depth -= 1;
    if (!captured_body) {
        return false;
    }

    i64 needed_locals = 1;

    if (!range_loop) {
        needed_locals = 2;
    }
    if (builder.module.local_count + needed_locals >= 32768) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 local_index = builder.module.local_count;

    i64 local_slot = raz_compiler_rt_arena_get(
        builder.module.function_local_counts,
        builder.current_function
    );
    builder.module.local_count += 1;
    raz_compiler_rt_arena_set(builder.module.local_name_offsets, local_index, name_offset);
    raz_compiler_rt_arena_set(builder.module.local_name_lengths, local_index, name_length);
    raz_compiler_rt_arena_set(builder.module.local_function_indices, local_index, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.local_block_indices, local_index, child_block);
    raz_compiler_rt_arena_set(builder.module.local_type_structs, local_index, element_structure);
    raz_compiler_rt_arena_set(builder.module.local_types, local_index, element_type);
    // Borrowed-array iteration yields a reference to each element rather than
    // copying the element into the loop binding. The borrow flavor is kept on
    // the synthetic loop local so normal HIR dereference/borrow rules apply.

    i64 loop_reference = 0;

    if (borrowed_array != 0) {
        loop_reference = 1;
    }
    raz_compiler_rt_arena_set(builder.module.local_references, local_index, loop_reference);

    i64 loop_reference_mutable = 0;

    if (borrowed_array == 2) {
        loop_reference_mutable = 1;
    }
    raz_compiler_rt_arena_set(builder.module.local_reference_mutable, local_index, loop_reference_mutable);
    raz_compiler_rt_arena_set(builder.module.local_array_extents, local_index, -1);
    raz_compiler_rt_arena_set(
        builder.module.local_array_element_starts,
        local_index,
        builder.module.array_element_count,
    );
    raz_compiler_rt_arena_set(builder.module.local_array_element_counts, local_index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_functions, local_index, -1);
    raz_compiler_rt_arena_set(builder.module.local_callable_kinds, local_index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_starts, local_index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_counts, local_index, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_consumed, local_index, 0);
    raz_compiler_rt_arena_set(builder.module.local_function_types, local_index, -1);
    raz_compiler_rt_arena_set(builder.module.function_local_counts, builder.current_function, local_slot + 1);
    hir_register_local(builder, local_index, local_slot);
    if (range_loop) {
        i64 range = -1;
        i64 inclusive_value = 0;

        if (inclusive) {
            inclusive_value = 1;
        }
        if (!hir_add_node(builder, 32, iterable, end_value, inclusive_value, 0, &mut range)) {
            return false;
        }
        hir_set_node_type(builder, range, element_type);
        return hir_add_statement(builder, 13, local_slot, range, child_block);
    }

    i64 index_local = builder.module.local_count;
    i64 index_slot = local_slot + 1;

    builder.module.local_count += 1;
    raz_compiler_rt_arena_set(builder.module.local_name_offsets, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_name_lengths, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_function_indices, index_local, builder.current_function);
    raz_compiler_rt_arena_set(builder.module.local_block_indices, index_local, child_block);
    raz_compiler_rt_arena_set(builder.module.local_type_structs, index_local, -1);
    raz_compiler_rt_arena_set(builder.module.local_types, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_references, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_array_extents, index_local, -1);
    raz_compiler_rt_arena_set(
        builder.module.local_array_element_starts,
        index_local,
        builder.module.array_element_count,
    );
    raz_compiler_rt_arena_set(builder.module.local_array_element_counts, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_functions, index_local, -1);
    raz_compiler_rt_arena_set(builder.module.local_callable_kinds, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_starts, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_capture_counts, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_callable_consumed, index_local, 0);
    raz_compiler_rt_arena_set(builder.module.local_function_types, index_local, -1);
    raz_compiler_rt_arena_set(builder.module.function_local_counts, builder.current_function, index_slot + 1);
    hir_register_local(builder, index_local, index_slot);

    i64 array_loop = -1;

    if (!hir_add_node(builder, 34, array_iterable, array_extent, index_slot, borrowed_array, &mut array_loop)) {
        return false;
    }
    hir_set_node_type(builder, array_loop, element_type);
    raz_compiler_rt_arena_set(builder.module.node_type_structs, array_loop, element_structure);
    return hir_add_statement(builder, 17, local_slot, array_loop, child_block);
}

fn hir_parse_block_statements(HirBuilder&mut builder, i64 block_index) -> bool {
    if (
        raz_compiler_rt_arena_get(builder.module.block_function_indices, block_index) == 16383 &&
        raz_compiler_rt_arena_get(builder.module.block_statement_counts, block_index) > 0
    ) {
        return true;
    }

    i64 saved_function = builder.current_function;
    i64 saved_block = builder.current_block;
    i64 saved_loop_depth = builder.loop_depth;
    i64 saved_unsafe_depth = builder.unsafe_depth;
    i64 saved_scan_offset = builder.scan.offset;
    TokenKind saved_current_kind = builder.current.kind;
    i64 saved_current_offset = builder.current.offset;
    i64 saved_current_length = builder.current.length;
    i64 saved_generic_active = builder.generic_active;
    i64 saved_generic_template_index = builder.generic_template_index;
    i64 saved_generic_type_name_offset = builder.generic_type_name_offset;
    i64 saved_generic_type_name_length = builder.generic_type_name_length;
    i64 saved_generic_type_structure = builder.generic_type_structure;
    i64 saved_generic_type_kind = builder.generic_type_kind;
    i64 saved_generic_signature_only = builder.generic_signature_only;
    i64 saved_generic_reparse_function_index = builder.generic_reparse_function_index;
    i64 saved_generic_substitution_count = builder.generic_substitution_count;
    i64 saved_generic_substitution_name_offsets[32];
    i64 saved_generic_substitution_name_lengths[32];
    i64 saved_generic_substitution_type_structures[32];
    i64 saved_generic_substitution_types[32];
    i64 saved_substitution = 0;

    while (saved_substitution < saved_generic_substitution_count) {
        saved_generic_substitution_name_offsets[saved_substitution] = raz_compiler_rt_arena_get(
            builder.generic_substitution_name_offsets,
            saved_substitution
        );
        saved_generic_substitution_name_lengths[saved_substitution] = raz_compiler_rt_arena_get(
            builder.generic_substitution_name_lengths,
            saved_substitution
        );
        saved_generic_substitution_type_structures[saved_substitution] = raz_compiler_rt_arena_get(
            builder.generic_substitution_type_structs,
            saved_substitution
        );
        saved_generic_substitution_types[saved_substitution] = raz_compiler_rt_arena_get(
            builder.generic_substitution_types,
            saved_substitution
        );
        saved_substitution += 1;
    }
    builder.current_function = raz_compiler_rt_arena_get(builder.module.block_function_indices, block_index);
    builder.current_block = block_index;
    builder.loop_depth = raz_compiler_rt_arena_get(builder.module.block_loop_depths, block_index);
    builder.unsafe_depth = raz_compiler_rt_arena_get(builder.module.block_unsafe_depths, block_index);
    builder.generic_active = raz_compiler_rt_arena_get(builder.module.block_generic_active, block_index);
    builder.generic_template_index = raz_compiler_rt_arena_get(
        builder.module.block_generic_template_indices,
        block_index
    );
    builder.generic_type_name_offset = raz_compiler_rt_arena_get(
        builder.module.block_generic_type_name_offsets,
        block_index
    );
    builder.generic_type_name_length = raz_compiler_rt_arena_get(
        builder.module.block_generic_type_name_lengths,
        block_index
    );
    builder.generic_type_structure = raz_compiler_rt_arena_get(
        builder.module.block_generic_type_structures,
        block_index
    );
    builder.generic_type_kind = raz_compiler_rt_arena_get(
        builder.module.block_generic_type_kinds,
        block_index
    );
    builder.generic_signature_only = raz_compiler_rt_arena_get(
        builder.module.block_generic_signature_only,
        block_index
    );
    builder.generic_reparse_function_index = raz_compiler_rt_arena_get(
        builder.module.block_generic_reparse_function_indices,
        block_index
    );
    builder.generic_substitution_count = raz_compiler_rt_arena_get(
        builder.module.block_generic_substitution_counts,
        block_index
    );

    i64 block_substitution = 0;

    while (block_substitution < builder.generic_substitution_count) {
        i64 snapshot = block_index * 32 + block_substitution;

        raz_compiler_rt_arena_set(
            builder.generic_substitution_name_offsets,
            block_substitution,
            raz_compiler_rt_arena_get(builder.module.block_generic_substitution_name_offsets, snapshot),
        );
        raz_compiler_rt_arena_set(
            builder.generic_substitution_name_lengths,
            block_substitution,
            raz_compiler_rt_arena_get(builder.module.block_generic_substitution_name_lengths, snapshot),
        );
        raz_compiler_rt_arena_set(
            builder.generic_substitution_type_structs,
            block_substitution,
            raz_compiler_rt_arena_get(builder.module.block_generic_substitution_type_structures, snapshot),
        );
        raz_compiler_rt_arena_set(
            builder.generic_substitution_types,
            block_substitution,
            raz_compiler_rt_arena_get(builder.module.block_generic_substitution_types, snapshot),
        );
        block_substitution += 1;
    }
    raz_compiler_rt_arena_set(builder.module.block_defer_starts, block_index, builder.module.defer_count);
    raz_compiler_rt_arena_set(builder.module.block_defer_counts, block_index, 0);
    builder.scan.offset = raz_compiler_rt_arena_get(builder.module.block_starts, block_index);
    next_token(&mut builder.scan, &mut builder.current);

    i64 block_statement_start = builder.module.statement_count;

    i64 original_function_statement_count = raz_compiler_rt_arena_get(
        builder.module.function_statement_counts,
        builder.current_function,
    );
    raz_compiler_rt_arena_set(builder.module.block_statement_starts, block_index, block_statement_start);
    raz_compiler_rt_arena_set(builder.module.block_statement_counts, block_index, 0);

    i64 end_offset = raz_compiler_rt_arena_get(builder.module.block_ends, block_index);

    while (builder.current.kind != TokenKind::End && builder.current.offset < end_offset) {
        if (builder.current.kind == TokenKind::LeftBrace) {
            i64 lexical_start = 0;
            i64 lexical_end = 0;
            i64 lexical_block = -1;

            if (
                !hir_capture_block(builder, &mut lexical_start, &mut lexical_end, &mut lexical_block) ||
                !hir_add_statement(builder, 14, lexical_block, 0, 0)
            ) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_else(&builder.scan.input, &builder.current)
        ) {
            hir_advance(builder);
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_const(&builder.scan.input, &builder.current)
        ) {
            if (!hir_parse_const_declaration(builder)) {
                return false;
            }
        } else if (
            builder.comptime_mode != 0 &&
            builder.current.kind == TokenKind::Identifier &&
            token_is_assert(&builder.scan.input, &builder.current)
        ) {
            hir_advance(builder);
            if (!hir_expect(builder, TokenKind::LeftParen)) {
                return false;
            }

            i64 condition = -1;

            if (
                !hir_parse_expression(builder, &mut condition) ||
                !hir_expect(builder, TokenKind::RightParen) ||
                !hir_expect(builder, TokenKind::Semicolon)
            ) {
                return false;
            }
            if (!hir_add_statement(builder, 18, condition, 0, 0)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_defer(&builder.scan.input, &builder.current)
        ) {
            if (!hir_parse_defer_statement(builder)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_match(&builder.scan.input, &builder.current)
        ) {
            if (!hir_parse_match_statement(builder)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_unsafe(&builder.scan.input, &builder.current)
        ) {
            if (!hir_parse_unsafe_statement(builder)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_for(&builder.scan.input, &builder.current)
        ) {
            if (!hir_parse_for_statement(builder)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_while(&builder.scan.input, &builder.current)
        ) {
            hir_advance(builder);

            i64 condition = -1;

            if (!hir_parse_expression(builder, &mut condition)) {
                return false;
            }

            i64 child_start = 0;
            i64 child_end = 0;
            i64 child_block = -1;

            builder.loop_depth += 1;
            bool captured_loop_body = hir_capture_block(
                builder,
                &mut child_start,
                &mut child_end,
                &mut child_block,
            );
            builder.loop_depth -= 1;
            if (!captured_loop_body || !hir_add_statement(builder, 6, condition, child_block, 0)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_if(&builder.scan.input, &builder.current)
        ) {
            hir_advance(builder);

            i64 condition = -1;

            if (!hir_parse_expression(builder, &mut condition)) {
                return false;
            }

            i64 then_start = 0;
            i64 then_end = 0;
            i64 then_block = -1;

            if (!hir_capture_block(builder, &mut then_start, &mut then_end, &mut then_block)) {
                return false;
            }

            i64 else_block = -1;

            if (
                builder.current.kind == TokenKind::Identifier &&
                token_is_else(&builder.scan.input, &builder.current)
            ) {
                hir_advance(builder);
                if (
                    builder.current.kind == TokenKind::Identifier &&
                    token_is_if(&builder.scan.input, &builder.current)
                ) {
                    i64 else_start = builder.current.offset;
                    i64 else_end = else_start;

                    if (!hir_skip_if_chain(builder, &mut else_end)) {
                        return false;
                    }
                    if (!hir_add_block(builder, else_start, else_end, &mut else_block)) {
                        return false;
                    }
                } else {
                    i64 else_start = 0;
                    i64 else_end = 0;

                    if (!hir_capture_block(builder, &mut else_start, &mut else_end, &mut else_block)) {
                        return false;
                    }
                }
            }
            if (!hir_add_statement(builder, 7, condition, then_block, else_block)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_break(&builder.scan.input, &builder.current)
        ) {
            if (
                raz_compiler_rt_arena_get(builder.module.block_defer_contexts, block_index) != 0 ||
                builder.loop_depth <= 0
            ) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            hir_advance(builder);
            if (!hir_expect(builder, TokenKind::Semicolon) || !hir_add_statement(builder, 11, 0, 0, 0)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_continue(&builder.scan.input, &builder.current)
        ) {
            if (
                raz_compiler_rt_arena_get(builder.module.block_defer_contexts, block_index) != 0 ||
                builder.loop_depth <= 0
            ) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            hir_advance(builder);
            if (!hir_expect(builder, TokenKind::Semicolon) || !hir_add_statement(builder, 12, 0, 0, 0)) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_return(&builder.scan.input, &builder.current)
        ) {
            if (raz_compiler_rt_arena_get(builder.module.block_defer_contexts, block_index) != 0) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
            hir_advance(builder);

            i64 expression = -1;

            if (
                builder.current.kind != TokenKind::Semicolon &&
                !hir_parse_expression(builder, &mut expression)
            ) {
                return false;
            }
            if (expression >= 0) {
                if (
                    raz_compiler_rt_arena_get(
                        builder.module.function_return_slices,
                        builder.current_function,
                    ) != 0
                ) {
                    i64 sliced_return = -1;

                    if (
                        !hir_coerce_slice(
                            builder,
                            expression,
                            raz_compiler_rt_arena_get(
                                builder.module.function_return_slice_mutable,
                                builder.current_function,
                            ),
                            &mut sliced_return,
                        )
                    ) {
                        return false;
                    }
                    expression = sliced_return;
                }
                i64 return_structure = raz_compiler_rt_arena_get(
                    builder.module.function_return_type_structs,
                    builder.current_function,
                );
                i64 return_reference = raz_compiler_rt_arena_get(
                    builder.module.function_return_references,
                    builder.current_function,
                );
                // A direct borrow of a local stack binding cannot escape the
                // defining function. Chained reference locals are handled by the
                // provenance helper below as that coverage expands.
                if (raz_compiler_rt_arena_get(builder.module.node_kinds, expression) == 17) {
                    i64 borrowed_operand = raz_compiler_rt_arena_get(builder.module.node_a, expression);

                    if (raz_compiler_rt_arena_get(builder.module.node_kinds, borrowed_operand) == 3) {
                        hir_fail(builder, DiagnosticCode::BorrowConflict);
                        return false;
                    }
                }
                bool unsafe_raw_return =
                    builder.unsafe_depth > 0 &&
                    hir_reference_origin_is_raw_storage(builder, expression);
                if (!unsafe_raw_return && hir_reference_origin_is_local(builder, expression)) {
                    hir_fail(builder, DiagnosticCode::BorrowConflict);
                    return false;
                }
                if (return_reference != 0) {
                    if (
                        !hir_require_reference_type(
                            builder,
                            &mut expression,
                            return_reference,
                            return_structure,
                            raz_compiler_rt_arena_get(
                                builder.module.function_return_types,
                                builder.current_function,
                            ),
                        )
                    ) {
                        return false;
                    }
                    if (
                        return_reference == 1 &&
                        !unsafe_raw_return &&
                        hir_reference_origin_is_local(builder, expression)
                    ) {
                        hir_fail(builder, DiagnosticCode::BorrowConflict);
                        return false;
                    }
                    i64 declared_lifetime = raz_compiler_rt_arena_get(
                        builder.module.function_return_lifetimes,
                        builder.current_function,
                    );
                    i64 actual_lifetime = raz_compiler_rt_arena_get(
                        builder.module.node_lifetimes,
                        expression
                    );
                    if (
                        declared_lifetime >= 0 &&
                        actual_lifetime >= 0 &&
                        declared_lifetime != actual_lifetime
                    ) {
                        hir_fail(builder, DiagnosticCode::BorrowConflict);
                        return false;
                    }
                } else if (return_structure >= 0) {
                    if (
                        raz_compiler_rt_arena_get(
                            builder.module.node_type_structs,
                            expression,
                        ) != return_structure
                    ) {
                        hir_fail(builder, DiagnosticCode::ExpectedToken);
                        return false;
                    }
                } else {
                    i64 declared_return_type = raz_compiler_rt_arena_get(
                        builder.module.function_return_types,
                        builder.current_function,
                    );
                    if (
                        declared_return_type >= 16 &&
                        declared_return_type <= 18 &&
                        raz_compiler_rt_arena_get(builder.module.node_kinds, expression) == 42
                    ) {
                        i64 closure_function = raz_compiler_rt_arena_get(builder.module.node_a, expression);
                        i64 closure_kind = raz_compiler_rt_arena_get(builder.module.node_b, expression);
                        bool kind_compatible = false;

                        if (declared_return_type == 16) {
                            kind_compatible = closure_kind == 1 || closure_kind == 2;
                        } else if (declared_return_type == 17) {
                            kind_compatible = closure_kind == 1 || closure_kind == 2 || closure_kind == 3;
                        } else {
                            kind_compatible = closure_kind >= 1 && closure_kind <= 4;
                        }
                        i64 expected_signature = raz_compiler_rt_arena_get(
                            builder.module.function_return_function_types,
                            builder.current_function,
                        );
                        if (
                            hir_closure_captures_parent_stack_by_reference(
                                builder,
                                closure_function,
                                builder.current_function,
                            )
                        ) {
                            hir_fail(builder, DiagnosticCode::BorrowConflict);
                            return false;
                        }
                        if (
                            !kind_compatible ||
                            expected_signature < 0 ||
                            !hir_function_matches_pointer_signature(
                                builder,
                                closure_function,
                                expected_signature,
                            )
                        ) {
                            hir_fail(builder, DiagnosticCode::ExpectedToken);
                            return false;
                        }
                        // The externally visible callable signature excludes the
                        // closure environment. Preserve the declared contract on
                        // the value; hidden capture parameters remain on the
                        // synthesized function for lowering only.
                        raz_compiler_rt_arena_set(
                            builder.module.node_function_types,
                            expression,
                            expected_signature,
                        );
                    } else if (!hir_require_value_type(builder, &mut expression, declared_return_type)) {
                        return false;
                    }
                }
                if (
                    raz_compiler_rt_arena_get(
                        builder.module.function_return_types,
                        builder.current_function,
                    ) == 14
                ) {
                    i64 expected_signature = raz_compiler_rt_arena_get(
                        builder.module.function_return_function_types,
                        builder.current_function,
                    );
                    i64 actual_signature = raz_compiler_rt_arena_get(
                        builder.module.node_function_types,
                        expression,
                    );
                    if (
                        expected_signature < 0 ||
                        actual_signature < 0 ||
                        !hir_function_pointer_signatures_equal(builder, expected_signature, actual_signature)
                    ) {
                        hir_fail(builder, DiagnosticCode::ExpectedToken);
                        return false;
                    }
                }
            }
            if (
                !hir_expect(builder, TokenKind::Semicolon) ||
                !hir_add_statement(builder, 2, expression, 0, 0)
            ) {
                return false;
            }
        } else if (
            builder.current.kind == TokenKind::Identifier &&
            token_is_fn(&builder.scan.input, &builder.current)
        ) {
            // A lower-case `fn(...) -> T name` in statement position is a thin
            // function-pointer local. Parse it directly instead of running the
            // declaration lookahead, whose lexer rewind can leave nested
            // signature punctuation paired with stale token state.
            if (!hir_parse_local(builder)) {
                return false;
            }
        } else {
            bool declaration = false;

            if (
                builder.current.kind == TokenKind::Identifier ||
                builder.current.kind == TokenKind::LeftParen
            ) {
                i64 declaration_scan_offset = builder.scan.offset;
                TokenKind declaration_current_kind = builder.current.kind;
                i64 declaration_current_offset = builder.current.offset;
                i64 declaration_current_length = builder.current.length;

                if (builder.current.kind == TokenKind::LeftParen) {
                    i64 type_depth = 0;
                    bool scanning_type = true;

                    while (scanning_type && builder.current.kind != TokenKind::End) {
                        if (builder.current.kind == TokenKind::LeftParen) {
                            type_depth += 1;
                        } else if (builder.current.kind == TokenKind::RightParen) {
                            type_depth -= 1;
                            if (type_depth == 0) {
                                hir_advance(builder);
                                scanning_type = false;
                            }
                        }
                        if (scanning_type) {
                            hir_advance(builder);
                        }
                    }
                } else {
                    bool scanning_function_pointer =
                        token_is_fn(&builder.scan.input, &builder.current) ||
                        hir_callable_type_kind(&builder.scan.input, &builder.current) != 0;
                    hir_advance(builder);
                    // A namespaced user type is still a single type spelling in
                    // declaration position.  Walk the complete `A::B::Type`
                    // path before testing for the following local identifier.
                    // The semantic type parser performs the real namespace,
                    // visibility, and package lookup after this cheap probe.
                    if (!scanning_function_pointer) {
                        while (builder.current.kind == TokenKind::ColonColon) {
                            hir_advance(builder);
                            if (builder.current.kind != TokenKind::Identifier) {
                                break;
                            }
                            hir_advance(builder);
                        }
                    }
                    if (scanning_function_pointer && builder.current.kind == TokenKind::LeftParen) {
                        i64 signature_depth = 0;
                        bool scanning_signature = true;

                        while (scanning_signature && builder.current.kind != TokenKind::End) {
                            if (builder.current.kind == TokenKind::LeftParen) {
                                signature_depth += 1;
                            } else if (builder.current.kind == TokenKind::RightParen) {
                                signature_depth -= 1;
                                if (signature_depth == 0) {
                                    hir_advance(builder);
                                    scanning_signature = false;
                                }
                            }
                            if (scanning_signature) {
                                hir_advance(builder);
                            }
                        }
                        if (builder.current.kind == TokenKind::Arrow) {
                            hir_advance(builder);
                            if (builder.current.kind == TokenKind::Identifier) {
                                hir_advance(builder);
                            }
                        }
                    } else if (builder.current.kind == TokenKind::Less) {
                        i64 generic_depth = 0;
                        bool scanning_generic = true;

                        while (scanning_generic && builder.current.kind != TokenKind::End) {
                            if (builder.current.kind == TokenKind::Less) {
                                generic_depth += 1;
                            } else if (builder.current.kind == TokenKind::Greater) {
                                generic_depth -= 1;
                                if (generic_depth == 0) {
                                    hir_advance(builder);
                                    scanning_generic = false;
                                }
                            }
                            if (scanning_generic) {
                                hir_advance(builder);
                            }
                        }
                    }
                }
                if (builder.current.kind == TokenKind::LeftBracket) {
                    // Both slice types (`T[]`) and fixed arrays (`T[N]`) put
                    // brackets before the local identifier.  Declaration
                    // probing only needs to step over the extent expression;
                    // the real parser validates it afterwards.
                    hir_advance(builder);
                    if (builder.current.kind == TokenKind::RightBracket) {
                        hir_advance(builder);
                        if (
                            builder.current.kind == TokenKind::Identifier &&
                            token_is_mut(&builder.scan.input, &builder.current)
                        ) {
                            hir_advance(builder);
                        }
                    } else {
                        i64 bracket_depth = 1;

                        while (builder.current.kind != TokenKind::End && bracket_depth > 0) {
                            if (builder.current.kind == TokenKind::LeftBracket) {
                                bracket_depth += 1;
                            } else if (builder.current.kind == TokenKind::RightBracket) {
                                bracket_depth -= 1;
                            }
                            hir_advance(builder);
                        }
                    }
                }
                if (builder.current.kind == TokenKind::Ampersand) {
                    hir_advance(builder);
                    if (
                        builder.current.kind == TokenKind::Identifier &&
                        token_is_mut(&builder.scan.input, &builder.current)
                    ) {
                        hir_advance(builder);
                    }
                } else if (builder.current.kind == TokenKind::Star) {
                    // Raw-pointer suffixes are part of a local's type, just like
                    // borrowed-reference suffixes.  The lightweight declaration
                    // probe must consume `*const` / `*mut` before looking for the
                    // local identifier; the real type parser validates the suffix.
                    hir_advance(builder);
                    if (
                        builder.current.kind == TokenKind::Identifier &&
                        (
                            token_is_const(&builder.scan.input, &builder.current) ||
                            token_is_mut(&builder.scan.input, &builder.current)
                        )
                    ) {
                        hir_advance(builder);
                    }
                }
                declaration = builder.current.kind == TokenKind::Identifier;
                // Primitive type names cannot begin expression statements.
                // Treat them as declarations even when a fixed-array extent
                // appears between the type and local name.
                if (
                    !declaration &&
                    declaration_current_kind == TokenKind::Identifier &&
                    token_is_scalar_type(
                        &builder.scan.input,
                        declaration_current_offset,
                        declaration_current_length,
                    )
                ) {
                    // Type spellings are not globally reserved in value position.
                    // A lexical binding may legitimately shadow a primitive alias
                    // (for example `i64 byte = 3; byte = 47;`).  Only use the
                    // scalar-name fallback when no visible local/parameter owns
                    // the spelling at this source position.

                    i64 shadow_kind = 0;
                    i64 shadow_slot = -1;

                    if (
                        !hir_find_name(
                            builder,
                            declaration_current_offset,
                            declaration_current_length,
                            &mut shadow_kind,
                            &mut shadow_slot,
                        )
                    ) {
                        declaration = true;
                    }
                }
                builder.scan.offset = declaration_scan_offset;
                init_token(
                    &mut builder.current,
                    declaration_current_kind,
                    declaration_current_offset,
                    declaration_current_length,
                );
                // `fn(...) -> T name` is unambiguously a typed local declaration
                // in statement position. Preserve that classification after the
                // lightweight lookahead so it cannot fall through to closure parsing.
                if (
                    builder.current.kind == TokenKind::Identifier &&
                    token_is_fn(&builder.scan.input, &builder.current)
                ) {
                    declaration = true;
                }
            }
            if (declaration) {
                if (!hir_parse_local(builder)) {
                    return false;
                }
            } else {
                i64 expression_scan_offset = builder.scan.offset;
                TokenKind expression_current_kind = builder.current.kind;
                i64 expression_current_offset = builder.current.offset;
                i64 expression_current_length = builder.current.length;
                i64 probe = -1;

                builder.allow_moved_name = 1;

                bool probe_ok = hir_parse_primary(builder, &mut probe);

                builder.allow_moved_name = 0;
                if (!probe_ok) {
                    return false;
                }
                bool assignment =
                    builder.current.kind == TokenKind::Equal ||
                    builder.current.kind == TokenKind::PlusEqual ||
                    builder.current.kind == TokenKind::MinusEqual ||
                    builder.current.kind == TokenKind::StarEqual ||
                    builder.current.kind == TokenKind::SlashEqual ||
                    builder.current.kind == TokenKind::PercentEqual ||
                    builder.current.kind == TokenKind::AmpersandEqual ||
                    builder.current.kind == TokenKind::PipeEqual ||
                    builder.current.kind == TokenKind::CaretEqual ||
                    builder.current.kind == TokenKind::LessLessEqual ||
                    builder.current.kind == TokenKind::GreaterGreaterEqual;
                builder.scan.offset = expression_scan_offset;
                init_token(
                    &mut builder.current,
                    expression_current_kind,
                    expression_current_offset,
                    expression_current_length,
                );
                if (assignment) {
                    if (!hir_parse_assignment(builder)) {
                        return false;
                    }
                } else {
                    i64 expression = -1;

                    if (!hir_parse_expression(builder, &mut expression)) {
                        return false;
                    }
                    if (
                        !hir_expect(builder, TokenKind::Semicolon) ||
                        !hir_add_statement(builder, 5, expression, 0, 0)
                    ) {
                        return false;
                    }
                }
            }
        }
    }

    i64 parsed_statement_count = builder.module.statement_count - block_statement_start;

    if (
        parsed_statement_count == 0 &&
        raz_compiler_rt_arena_get(builder.module.block_starts, block_index) < end_offset
    ) {
        builder.scan.offset = raz_compiler_rt_arena_get(builder.module.block_starts, block_index);
        next_token(&mut builder.scan, &mut builder.current);
        while (builder.current.kind != TokenKind::End && builder.current.offset < end_offset) {
            i64 assignment_scan_offset = builder.scan.offset;
            TokenKind assignment_current_kind = builder.current.kind;
            i64 assignment_current_offset = builder.current.offset;
            i64 assignment_current_length = builder.current.length;
            i64 assignment_target = -1;

            if (!hir_parse_primary(builder, &mut assignment_target)) {
                return false;
            }
            bool assignment_statement =
                builder.current.kind == TokenKind::Equal ||
                builder.current.kind == TokenKind::PlusEqual ||
                builder.current.kind == TokenKind::MinusEqual ||
                builder.current.kind == TokenKind::StarEqual ||
                builder.current.kind == TokenKind::SlashEqual ||
                builder.current.kind == TokenKind::PercentEqual ||
                builder.current.kind == TokenKind::AmpersandEqual ||
                builder.current.kind == TokenKind::PipeEqual ||
                builder.current.kind == TokenKind::CaretEqual ||
                builder.current.kind == TokenKind::LessLessEqual ||
                builder.current.kind == TokenKind::GreaterGreaterEqual;
            builder.scan.offset = assignment_scan_offset;
            init_token(
                &mut builder.current,
                assignment_current_kind,
                assignment_current_offset,
                assignment_current_length,
            );
            if (!assignment_statement || !hir_parse_assignment(builder)) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }
        }
        parsed_statement_count = builder.module.statement_count - block_statement_start;
    }
    raz_compiler_rt_arena_set(builder.module.block_statement_counts, block_index, parsed_statement_count);
    raz_compiler_rt_arena_set(
        builder.module.function_statement_counts,
        builder.current_function,
        original_function_statement_count,
    );
    builder.current_function = saved_function;
    builder.current_block = saved_block;
    builder.loop_depth = saved_loop_depth;
    builder.scan.offset = saved_scan_offset;
    init_token(&mut builder.current, saved_current_kind, saved_current_offset, saved_current_length);
    builder.unsafe_depth = saved_unsafe_depth;
    builder.generic_active = saved_generic_active;
    builder.generic_template_index = saved_generic_template_index;
    builder.generic_type_name_offset = saved_generic_type_name_offset;
    builder.generic_type_name_length = saved_generic_type_name_length;
    builder.generic_type_structure = saved_generic_type_structure;
    builder.generic_type_kind = saved_generic_type_kind;
    builder.generic_signature_only = saved_generic_signature_only;
    builder.generic_reparse_function_index = saved_generic_reparse_function_index;
    builder.generic_substitution_count = saved_generic_substitution_count;
    saved_substitution = 0;
    while (saved_substitution < saved_generic_substitution_count) {
        raz_compiler_rt_arena_set(
            builder.generic_substitution_name_offsets,
            saved_substitution,
            saved_generic_substitution_name_offsets[saved_substitution],
        );
        raz_compiler_rt_arena_set(
            builder.generic_substitution_name_lengths,
            saved_substitution,
            saved_generic_substitution_name_lengths[saved_substitution],
        );
        raz_compiler_rt_arena_set(
            builder.generic_substitution_type_structs,
            saved_substitution,
            saved_generic_substitution_type_structures[saved_substitution],
        );
        raz_compiler_rt_arena_set(
            builder.generic_substitution_types,
            saved_substitution,
            saved_generic_substitution_types[saved_substitution],
        );
        saved_substitution += 1;
    }
    return true;
}
