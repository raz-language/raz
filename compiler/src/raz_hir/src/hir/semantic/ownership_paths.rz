namespace raz_hir::semantic::ownership_paths;

public import raz_hir::core::builder;

// Ownership-path projection and move-state tracking. Keep path identity and
// partial-move bookkeeping separate from borrow/coercion orchestration.
fn hir_local_index_from_slot(HirBuilder&mut builder, i64 slot) -> i64 {
    i64 function_index = builder.current_function;
    i64 local_epoch = raz_compiler_rt_arena_get(builder.module.function_last_locals, function_index);
    i64 cache_slot = (function_index * 131 + slot * 17 + 47) % 8192;

    if (
        raz_compiler_rt_arena_get_unchecked(builder.slot_local_cache_functions, cache_slot) == function_index + 1 &&
        raz_compiler_rt_arena_get_unchecked(builder.slot_local_cache_slots, cache_slot) == slot &&
        raz_compiler_rt_arena_get_unchecked(builder.slot_local_cache_local_epochs, cache_slot) == local_epoch
    ) {
        builder.scope_cache_hits += 1;
        return raz_compiler_rt_arena_get_unchecked(builder.slot_local_cache_results, cache_slot);
    }
    builder.scope_cache_misses += 1;

    i64 result = -1;
    i64 link = raz_compiler_rt_arena_get(builder.module.function_last_locals, function_index);

    while (link > 0 && result < 0) {
        i64 index = link - 1;

        if (raz_compiler_rt_arena_get(builder.module.local_slots, index) == slot) {
            result = index;
        } else {
            link = raz_compiler_rt_arena_get(builder.module.local_previous_function_locals, index);
        }
    }
    raz_compiler_rt_arena_set_unchecked(builder.slot_local_cache_functions, cache_slot, function_index + 1);
    raz_compiler_rt_arena_set_unchecked(builder.slot_local_cache_slots, cache_slot, slot);
    raz_compiler_rt_arena_set_unchecked(builder.slot_local_cache_local_epochs, cache_slot, local_epoch);
    raz_compiler_rt_arena_set_unchecked(builder.slot_local_cache_results, cache_slot, result);
    return result;
}

fn hir_node_path(
    HirBuilder&mut builder,
    i64 node,
    i64&mut root_kind,
    i64&mut root_index,
    i64&mut path,
) -> bool {
    if (node < 0) {
        return false;
    }

    i64 kind = raz_compiler_rt_arena_get(builder.module.node_kinds, node);

    if (kind == 2) {
        *root_kind = 2;
        *root_index =
            raz_compiler_rt_arena_get(builder.module.function_parameter_starts, builder.current_function) +
            raz_compiler_rt_arena_get(builder.module.node_a, node);
        *path = 0;
        return true;
    }
    if (kind == 3) {
        *root_kind = 3;
        *root_index = hir_local_index_from_slot(
            builder,
            raz_compiler_rt_arena_get(builder.module.node_a, node),
        );
        *path = 0;
        return *root_index >= 0;
    }
    if (kind == 54) {
        *root_kind = 4;
        *root_index = raz_compiler_rt_arena_get(builder.module.node_a, node);
        *path = 0;
        return *root_index >= 0 && *root_index < builder.module.global_count;
    }
    if (kind == 16) {
        if (
            !hir_node_path(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_a, node),
                root_kind,
                root_index,
                path,
            )
        ) {
            return false;
        }
        *path = *path * 4096 + raz_compiler_rt_arena_get(builder.module.node_b, node) + 1;
        return true;
    }
    if (kind == 22) {
        if (
            !hir_node_path(
                builder,
                raz_compiler_rt_arena_get(builder.module.node_a, node),
                root_kind,
                root_index,
                path,
            )
        ) {
            return false;
        }

        i64 index_node = raz_compiler_rt_arena_get(builder.module.node_b, node);

        if (raz_compiler_rt_arena_get(builder.module.node_kinds, index_node) != 1) {
            *path = 0;
            return true;
        }

        i64 fixed_index = raz_compiler_rt_arena_get(builder.module.node_values, index_node);

        if (fixed_index < 0 || fixed_index >= 2047) {
            *path = 0;
            return true;
        }
        *path = *path * 4096 + 2048 + fixed_index;
        return true;
    }
    if (kind == 21 || kind == 37 || kind == 39) {
        return hir_node_path(
            builder,
            raz_compiler_rt_arena_get(builder.module.node_a, node),
            root_kind,
            root_index,
            path,
        );
    }
    return false;
}

fn hir_node_root(HirBuilder&mut builder, i64 node, i64&mut root_kind, i64&mut root_index) -> bool {
    i64 path = 0;

    return hir_node_path(builder, node, root_kind, root_index, &mut path);
}

fn hir_paths_overlap(i64 left, i64 right) -> bool {
    if (left == 0 || right == 0) {
        return true;
    }

    i64 cursor = left;

    while (cursor > 0) {
        if (cursor == right) {
            return true;
        }
        cursor = cursor / 4096;
    }
    cursor = right;
    while (cursor > 0) {
        if (cursor == left) {
            return true;
        }
        cursor = cursor / 4096;
    }
    return false;
}

fn hir_root_is_whole_moved(HirBuilder&mut builder, i64 root_kind, i64 root_index) -> bool {
    if (root_kind == 2) {
        return raz_compiler_rt_arena_get(builder.parameter_moved, root_index) != 0;
    }
    if (root_kind == 3) {
        return raz_compiler_rt_arena_get(builder.local_moved, root_index) != 0;
    }
    return false;
}

fn hir_path_is_moved(HirBuilder&mut builder, i64 root_kind, i64 root_index, i64 path) -> bool {
    if (hir_root_is_whole_moved(builder, root_kind, root_index)) {
        return true;
    }

    i64 index = 0;

    while (index < builder.moved_path_count) {
        if (
            raz_compiler_rt_arena_get(builder.moved_path_root_kinds, index) == root_kind &&
            raz_compiler_rt_arena_get(builder.moved_path_root_indices, index) == root_index
        ) {
            i64 moved_path = raz_compiler_rt_arena_get(builder.moved_paths, index);

            if (moved_path >= 0 && hir_paths_overlap(moved_path, path)) {
                return true;
            }
        }
        index += 1;
    }
    return false;
}

fn hir_path_uninitialized_at_root(HirBuilder&mut builder, i64 root_kind, i64 root_index, i64 path) -> bool {
    if (hir_root_is_whole_moved(builder, root_kind, root_index)) {
        return true;
    }

    i64 index = 0;

    while (index < builder.moved_path_count) {
        if (
            raz_compiler_rt_arena_get(builder.moved_path_root_kinds, index) == root_kind &&
            raz_compiler_rt_arena_get(builder.moved_path_root_indices, index) == root_index
        ) {
            i64 moved_path = raz_compiler_rt_arena_get(builder.moved_paths, index);

            if (moved_path >= 0) {
                i64 cursor = path;

                while (cursor > 0) {
                    if (cursor == moved_path) {
                        return true;
                    }
                    cursor = cursor / 4096;
                }
            }
        }
        index += 1;
    }
    return false;
}

fn hir_record_predrop(
    HirBuilder&mut builder,
    i64 statement,
    i64 structure,
    i64 root_kind,
    i64 root_index,
    i64 path,
) -> bool {
    raz_compiler_rt_arena_set(builder.module.statement_predrop_structures, statement, structure);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_root_kinds, statement, root_kind);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_root_indices, statement, root_index);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_paths, statement, path);

    i64 start = builder.module.predrop_moved_path_count;
    i64 count = 0;
    i64 index = 0;

    while (index < builder.moved_path_count) {
        if (
            raz_compiler_rt_arena_get(builder.moved_path_root_kinds, index) == root_kind &&
            raz_compiler_rt_arena_get(builder.moved_path_root_indices, index) == root_index
        ) {
            i64 moved_path = raz_compiler_rt_arena_get(builder.moved_paths, index);

            if (moved_path >= 0 && hir_paths_overlap(moved_path, path)) {
                if (builder.module.predrop_moved_path_count >= 262144) {
                    hir_fail(builder, DiagnosticCode::TooManyItems);
                    return false;
                }
                raz_compiler_rt_arena_set(
                    builder.module.predrop_moved_paths,
                    builder.module.predrop_moved_path_count,
                    moved_path,
                );
                builder.module.predrop_moved_path_count += 1;
                count += 1;
            }
        }
        index += 1;
    }
    raz_compiler_rt_arena_set(builder.module.statement_predrop_moved_starts, statement, start);
    raz_compiler_rt_arena_set(builder.module.statement_predrop_moved_counts, statement, count);
    return true;
}

fn hir_clear_path_moved(HirBuilder&mut builder, i64 root_kind, i64 root_index, i64 path) {
    if (path == 0) {
        if (root_kind == 2) {
            raz_compiler_rt_arena_set(builder.parameter_moved, root_index, 0);
        } else if (root_kind == 3) {
            raz_compiler_rt_arena_set(builder.local_moved, root_index, 0);
        }
    }

    i64 index = 0;

    while (index < builder.moved_path_count) {
        if (
            raz_compiler_rt_arena_get(builder.moved_path_root_kinds, index) == root_kind &&
            raz_compiler_rt_arena_get(builder.moved_path_root_indices, index) == root_index
        ) {
            i64 moved_path = raz_compiler_rt_arena_get(builder.moved_paths, index);

            if (moved_path >= 0 && (path == 0 || hir_paths_overlap(moved_path, path))) {
                raz_compiler_rt_arena_set(builder.moved_paths, index, -1);
            }
        }
        index += 1;
    }
}

fn hir_mark_path_moved(HirBuilder&mut builder, i64 root_kind, i64 root_index, i64 path) -> bool {
    if (path == 0) {
        hir_clear_path_moved(builder, root_kind, root_index, 0);
        if (root_kind == 2) {
            raz_compiler_rt_arena_set(builder.parameter_moved, root_index, 1);
        } else if (root_kind == 3) {
            raz_compiler_rt_arena_set(builder.local_moved, root_index, 1);
        }
        return true;
    }
    if (builder.moved_path_count >= 16384) {
        hir_fail(builder, DiagnosticCode::TooManyItems);
        return false;
    }

    i64 index = builder.moved_path_count;

    builder.moved_path_count += 1;
    raz_compiler_rt_arena_set(builder.moved_path_root_kinds, index, root_kind);
    raz_compiler_rt_arena_set(builder.moved_path_root_indices, index, root_index);
    raz_compiler_rt_arena_set(builder.moved_paths, index, path);
    return true;
}
