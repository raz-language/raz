                i64 indirect_type = raz_compiler_rt_arena_get(builder.module.node_types, indirect_callee);

                if (
                    (indirect_type != 14 && (indirect_type < 16 || indirect_type > 18)) ||
                    indirect_signature < 0
                ) {
                    hir_fail(builder, DiagnosticCode::ExpectedToken);
                    return false;
                }
                indirect_call = true;
                callable_local = -1;
            }
        }
        hir_advance(builder);

        i64 pending_arguments = raz_compiler_rt_arena_create(256);

        if (pending_arguments == 0) {
            hir_fail(builder, DiagnosticCode::TooManyItems);
            return false;
        }
        // Parallel to pending_arguments, holding where each argument started.
        // Losing this arena only costs a diagnostic its precise location, so a
        // failed allocation degrades the message rather than the compile.
        i64 pending_argument_offsets = raz_compiler_rt_arena_create(256);

        i64 argument_count = 0;

        if (builder.current.kind != TokenKind::RightParen) {
            bool parsing_arguments = true;

            while (parsing_arguments) {
                i64 argument = -1;
                // Recorded before the argument is consumed: signature checks run
                // after the whole call is parsed, by which point the builder's
                // current token is the one past the closing parenthesis.
                i64 argument_offset = builder.current.offset;

                if (!hir_parse_expression(builder, &mut argument)) {
                    raz_compiler_rt_arena_destroy(pending_arguments);
                    raz_compiler_rt_arena_destroy(pending_argument_offsets);
                    return false;
                }
                if (argument_count >= 256) {
                    raz_compiler_rt_arena_destroy(pending_arguments);
                    raz_compiler_rt_arena_destroy(pending_argument_offsets);
                    hir_fail(builder, DiagnosticCode::TooManyItems);
                    return false;
                }
                if (pending_argument_offsets != 0) {
                    raz_compiler_rt_arena_set(pending_argument_offsets, argument_count, argument_offset);
                }
                raz_compiler_rt_arena_set(pending_arguments, argument_count, argument);
                argument_count += 1;
                if (builder.current.kind == TokenKind::Comma) {
                    hir_advance(builder);
                    if (builder.current.kind == TokenKind::RightParen) {
                        parsing_arguments = false;
                    }
                } else {
                    parsing_arguments = false;
                }
            }
        }
        if (!hir_expect(builder, TokenKind::RightParen)) {
            raz_compiler_rt_arena_destroy(pending_arguments);
            raz_compiler_rt_arena_destroy(pending_argument_offsets);
            return false;
        }

        i64 call = -1;

        if (
            !hir_validate_and_emit_call(
                builder,
                target,
                structure,
                callable_local,
                indirect_callee,
                indirect_signature,
                indirect_call,
                pending_arguments,
                pending_argument_offsets,
                argument_count,
                &mut call,
            )
        ) {
            raz_compiler_rt_arena_destroy(pending_argument_offsets);
            return false;
        }
        raz_compiler_rt_arena_destroy(pending_argument_offsets);
        // Function/constructor calls are primary expressions too, so postfix
        // propagation must be handled before returning from the direct-call
        // fast path.  Without this, `produce()?` leaves `?` unconsumed even
        // though member/index postfixes on ordinary names use the common loop.
        if (builder.current.kind == TokenKind::Question) {
            i64 operand_type = raz_compiler_rt_arena_get(builder.module.node_types, call);

            if (!hir_type_is_enum(operand_type) || builder.current_function < 0) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }

            i64 enumeration = hir_type_enum_index(operand_type);
            i64 success_member = hir_enum_propagation_success_member(builder, enumeration);

            i64 return_type = raz_compiler_rt_arena_get(
                builder.module.function_return_types,
                builder.current_function,
            );
            i64 return_structure = raz_compiler_rt_arena_get(
                builder.module.function_return_type_structs,
                builder.current_function,
            );
            if (
                success_member < 0 ||
                return_structure >= 0 ||
                !hir_enum_propagation_compatible(builder, enumeration, return_type)
            ) {
                hir_fail(builder, DiagnosticCode::ExpectedToken);
                return false;
            }

            i64 return_enumeration = hir_type_enum_index(return_type);

            i64 payload = raz_compiler_rt_arena_get(
                builder.module.enum_member_payload_starts,
                success_member
            );

            i64 propagated = -1;

            if (
                !hir_add_node(
                    builder,
                    48,
                    call,
                    enumeration,
                    success_member,
                    return_enumeration,
                    &mut propagated,
                )
            ) {
                return false;
            }
            raz_compiler_rt_arena_set(
                builder.module.node_type_structs,
                propagated,
                raz_compiler_rt_arena_get(builder.module.enum_payload_type_structs, payload),
            );
            hir_set_node_type(
                builder,
                propagated,
                raz_compiler_rt_arena_get(builder.module.enum_payload_types, payload),
            );
            raz_compiler_rt_arena_set(
                builder.module.node_array_extents,
                propagated,
                raz_compiler_rt_arena_get(builder.module.enum_payload_array_extents, payload),
            );
            hir_advance(builder);
            call = propagated;
        }
        if (builder.current.kind == TokenKind::Dot || builder.current.kind == TokenKind::ColonColon) {
            i64 chained = -1;

            if (!hir_parse_temporary_method_chain(builder, call, &mut chained)) {
                return false;
            }
            call = chained;
        }
        *out = call;
        return true;
    }

    i64 kind = 0;
    i64 slot = -1;
    i64 base = -1;

    builder.namespace_lookup_target_hash = qualified_namespace;
    builder.namespace_lookup_target_package_hash = qualified_package;

    i64 constant = hir_find_constant(builder, offset, length);

    builder.namespace_lookup_target_hash = -1;
    builder.namespace_lookup_target_package_hash = -1;

    i64 associated_const_value = 0;
    bool associated_const = false;
    bool local_value = false;

    if (qualified_namespace < 0 && constant < 0) {
        associated_const = hir_find_generic_trait_associated_const_value(
            builder,
            offset,
            length,
            &mut associated_const_value,
        );
        if (!associated_const) {
            local_value = hir_find_name(builder, offset, length, &mut kind, &mut slot);
        }
    }
    // Only search package/module declarations after lexical resolution fails.
    // The old order scanned every global and every function for each local
    // identifier in a block, which made compiler HIR construction quadratic.

    i64 global_value = -1;
    i64 function_value = -1;

    if (constant < 0 && !associated_const && !local_value) {
        builder.namespace_lookup_target_hash = qualified_namespace;
        builder.namespace_lookup_target_package_hash = qualified_package;
        global_value = hir_find_global(builder, offset, length);
        if (global_value < 0) {
            function_value = hir_find_function(builder, offset, length);
        }
        builder.namespace_lookup_target_hash = -1;
        builder.namespace_lookup_target_package_hash = -1;
    }
    if (constant >= 0) {
        base = raz_compiler_rt_arena_get(builder.module.constant_nodes, constant);
    } else if (associated_const) {
        if (!hir_add_node(builder, 1, associated_const_value, 0, 0, 0, &mut base)) {
            return false;
        }
        hir_set_node_type(builder, base, 2);
    } else if (local_value) {
        // Lexical bindings shadow module-level function names in value position.
        // A parameter such as `capacity` must remain the parameter even when a
        // helper function named `capacity` exists in the same module.
        if (!hir_add_node(builder, kind, slot, 0, 0, 0, &mut base)) {
            return false;
        }
        hir_apply_name_type(builder, kind, slot, base);
        // Closure borrow captures are passed as runtime reference handles.  They
        // behave like the captured place inside the closure body, so insert the
        // implicit dereference only for synthesized capture parameters.  Normal
        // source-level reference parameters continue to use their existing ABI.
        i64 active_closure_kind = raz_compiler_rt_arena_get(
            builder.module.function_closure_kinds,
            builder.current_function,
        );
        if (
            kind == 2 &&
            raz_compiler_rt_arena_get(builder.module.function_closure_ids, builder.current_function) >= 0 &&
            slot >= raz_compiler_rt_arena_get(
                builder.module.function_closure_explicit_parameter_counts,
                builder.current_function,
            ) &&
            raz_compiler_rt_arena_get(builder.module.node_references, base) != 0 &&
            active_closure_kind != 2 &&
            active_closure_kind != 3
        ) {
            i64 capture_value = -1;

            if (!hir_add_node(builder, 21, base, 0, 0, 0, &mut capture_value)) {
                return false;
            }
            hir_copy_node_type(builder, capture_value, base);
            raz_compiler_rt_arena_set(builder.module.node_references, capture_value, 0);
            base = capture_value;
        }
    } else if (global_value >= 0) {
        if (!hir_add_node(builder, 54, global_value, 0, 0, 0, &mut base)) {
            return false;
        }
        raz_compiler_rt_arena_set(
            builder.module.node_type_structs,
            base,
            raz_compiler_rt_arena_get(builder.module.global_type_structs, global_value),
        );
        hir_set_node_type(
            builder,
            base,
            raz_compiler_rt_arena_get(builder.module.global_types, global_value)
        );
        raz_compiler_rt_arena_set(
            builder.module.node_array_extents,
            base,
            raz_compiler_rt_arena_get(builder.module.global_array_extents, global_value),
        );
        raz_compiler_rt_arena_set(
            builder.module.node_function_types,
            base,
            raz_compiler_rt_arena_get(builder.module.global_function_types, global_value),
        );
    } else if (function_value >= 0) {
        if (!hir_add_node(builder, 47, function_value, 0, 0, 0, &mut base)) {
            return false;
        }
        hir_set_node_type(builder, base, 14);
        raz_compiler_rt_arena_set(
            builder.module.node_function_types,
            base,
            hir_function_pointer_signature(builder, function_value),
        );
    } else if (builder.current.kind == TokenKind::Dot || builder.current.kind == TokenKind::ColonColon) {
        i64 namespace_marker = resolved_generic_structure;

        if (namespace_marker < 0) {
            builder.namespace_lookup_target_hash = qualified_namespace;
            builder.namespace_lookup_target_package_hash = qualified_package;
            namespace_marker = hir_find_struct(builder, offset, length);
            builder.namespace_lookup_target_hash = -1;
            builder.namespace_lookup_target_package_hash = -1;
        }
        if (resolved_generic_enum >= 0) {
            namespace_marker = -2 - resolved_generic_enum;
        } else if (namespace_marker < 0) {
            i64 plain_enum = hir_find_enum(builder, offset, length);

            if (plain_enum >= 0) {
                namespace_marker = -2 - plain_enum;
            }
        }
        if (!hir_add_node(builder, 15, offset, length, namespace_marker, 0, &mut base)) {
            return false;
        }
    } else {
        hir_fail(builder, DiagnosticCode::UnknownName);
        return false;
    }
    while (
        builder.current.kind == TokenKind::Dot ||
        builder.current.kind == TokenKind::ColonColon ||
        builder.current.kind == TokenKind::LeftBracket ||
        builder.current.kind == TokenKind::Question
    ) {
        i64 postfix = -1;

        if (builder.current.kind == TokenKind::Dot || builder.current.kind == TokenKind::ColonColon) {
            if (!hir_parse_member_postfix(builder, base, &mut postfix)) {
                return false;
            }
        } else if (builder.current.kind == TokenKind::Question) {
            if (!hir_apply_propagation_postfix(builder, base, &mut postfix)) {
                return false;
            }
        } else {
            hir_advance(builder);

            i64 index = -1;

            if (!hir_parse_expression(builder, &mut index) || !hir_expect(builder, TokenKind::RightBracket)) {
                return false;
            }
            if (!hir_apply_index_postfix(builder, base, index, &mut postfix)) {
                return false;
            }
        }
        base = postfix;
    }
    *out = base;
    return true;
}

fn hir_parse_expression(HirBuilder&mut builder, i64&mut out) -> bool {
    i64 left = -1;

    if (!hir_parse_logical_and(builder, &mut left)) {
        return false;
    }
    while (builder.current.kind == TokenKind::PipePipe) {
        hir_advance(builder);

        i64 right = -1;

        if (!hir_parse_logical_and(builder, &mut right)) {
            return false;
        }

        i64 combined = -1;

        if (!hir_add_node(builder, 20, left, right, 0, 0, &mut combined)) {
            return false;
        }
        left = combined;
    }
    *out = left;
    return true;
}
