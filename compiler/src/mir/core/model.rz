namespace raz_compiler_mir_core_model;
public import raz_compiler_hir_semantic_comptime;
// Canonical executable MIR storage. HIR no longer owns the backend IR model.
public struct MirModule {
    i64 function_count;
    i64 instruction_count;
    i64 global_count;
    i64 global_values;
    i64 global_extern_flags;
    i64 function_instruction_starts;
    i64 function_instruction_counts;
    i64 function_parameter_counts;
    i64 function_local_counts;
    i64 function_is_extern;
    i64 function_extern_kinds;
    i64 function_module_ids;
    i64 module_count;
    i64 module_ids;
    i64 module_function_starts;
    i64 module_function_counts;
    i64 module_function_indices;
    i64 opcodes;
    i64 op_types;
    i64 op_a;
    i64 op_b;
    i64 op_c;
    i64 op_d;
    i64 call_argument_count;
    i64 call_arguments;

    // Non-executable ownership events. These are semantic MIR metadata and are
    // consumed by CFG ownership analyses, never by Forge/LLVM code generation.

    i64 ownership_event_count;
    i64 ownership_event_instructions;
    i64 ownership_event_kinds;
    i64 ownership_event_slots;
    i64 ownership_event_path_starts;
    i64 ownership_event_path_counts;
    i64 ownership_event_parents;
    i64 ownership_path_component_count;
    i64 ownership_path_components;

    // Transient lowering context: parameters are spilled after declared locals
    // so mutable parameters use the same frame load/store semantics as locals.

    i64 lowering_parameter_local_base;
    i64 lowering_parameter_start;

    // Current HIR function while MIR expressions are lowered. Escaping closure
    // construction needs this to materialize captures from the parent frame.

    i64 lowering_function_index;

    // Active lexical cleanup context for expression-level early exits such as `?`.

    i64 lowering_cleanup_function;
    i64 lowering_cleanup_block;
}
