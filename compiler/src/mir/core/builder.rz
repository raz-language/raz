namespace raz_compiler_mir_core_builder;
public import raz_compiler_mir_core_model;
// Allocation, mutation, and instruction construction primitives for MIR.
fn init_mir(MirModule&mut out) -> bool {
    out.function_count = 0;
    out.instruction_count = 0;
    out.global_count = 0;
    out.global_values = raz_rt_stage1_arena_create(4096);
    out.global_extern_flags = raz_rt_stage1_arena_create(4096);
    out.function_instruction_starts = raz_rt_stage1_arena_create(16384);
    out.function_instruction_counts = raz_rt_stage1_arena_create(16384);
    out.function_parameter_counts = raz_rt_stage1_arena_create(16384);
    out.function_local_counts = raz_rt_stage1_arena_create(16384);
    out.function_is_extern = raz_rt_stage1_arena_create(16384);
    out.function_extern_kinds = raz_rt_stage1_arena_create(16384);
    out.function_module_ids = raz_rt_stage1_arena_create(16384);
    out.module_count = 0;
    out.module_ids = raz_rt_stage1_arena_create(4096);
    out.module_function_starts = raz_rt_stage1_arena_create(4096);
    out.module_function_counts = raz_rt_stage1_arena_create(4096);
    out.module_function_indices = raz_rt_stage1_arena_create(16384);
    out.opcodes = raz_rt_stage1_arena_create(524288);
    out.op_types = raz_rt_stage1_arena_create(524288);
    out.op_a = raz_rt_stage1_arena_create(524288);
    out.op_b = raz_rt_stage1_arena_create(524288);
    out.op_c = raz_rt_stage1_arena_create(524288);
    out.op_d = raz_rt_stage1_arena_create(524288);
    out.call_argument_count = 0;
    out.call_arguments = raz_rt_stage1_arena_create(524288);
    out.ownership_event_count = 0;
    out.ownership_event_instructions = raz_rt_stage1_arena_create(262144);
    out.ownership_event_kinds = raz_rt_stage1_arena_create(262144);
    out.ownership_event_slots = raz_rt_stage1_arena_create(262144);
    out.ownership_event_path_starts = raz_rt_stage1_arena_create(262144);
    out.ownership_event_path_counts = raz_rt_stage1_arena_create(262144);
    out.ownership_event_parents = raz_rt_stage1_arena_create(262144);
    out.ownership_path_component_count = 0;
    out.ownership_path_components = raz_rt_stage1_arena_create(524288);
    out.lowering_parameter_local_base = 0;
    out.lowering_parameter_start = 0;
    out.lowering_function_index = -1;
    out.lowering_cleanup_function = -1;
    out.lowering_cleanup_block = -1;
    return (
        out.global_values != 0 &&
        out.global_extern_flags != 0 &&
        out.function_instruction_starts != 0 &&
        out.function_instruction_counts != 0 &&
        out.function_parameter_counts != 0 &&
        out.function_local_counts != 0 &&
        out.function_is_extern != 0 &&
        out.function_extern_kinds != 0 &&
        out.function_module_ids != 0 &&
        out.module_ids != 0 &&
        out.module_function_starts != 0 &&
        out.module_function_counts != 0 &&
        out.module_function_indices != 0 &&
        out.opcodes != 0 &&
        out.op_types != 0 &&
        out.op_a != 0 &&
        out.op_b != 0 &&
        out.op_c != 0 &&
        out.op_d != 0 &&
        out.call_arguments != 0 &&
        out.ownership_event_instructions != 0 &&
        out.ownership_event_kinds != 0 &&
        out.ownership_event_slots != 0 &&
        out.ownership_event_path_starts != 0 &&
        out.ownership_event_path_counts != 0 &&
        out.ownership_event_parents != 0 &&
        out.ownership_path_components != 0
    );
}

fn destroy_mir(MirModule&mut out) {
    raz_rt_stage1_arena_destroy(out.global_values);
    raz_rt_stage1_arena_destroy(out.global_extern_flags);
    raz_rt_stage1_arena_destroy(out.function_instruction_starts);
    raz_rt_stage1_arena_destroy(out.function_instruction_counts);
    raz_rt_stage1_arena_destroy(out.function_parameter_counts);
    raz_rt_stage1_arena_destroy(out.function_local_counts);
    raz_rt_stage1_arena_destroy(out.function_is_extern);
    raz_rt_stage1_arena_destroy(out.function_extern_kinds);
    raz_rt_stage1_arena_destroy(out.function_module_ids);
    raz_rt_stage1_arena_destroy(out.module_ids);
    raz_rt_stage1_arena_destroy(out.module_function_starts);
    raz_rt_stage1_arena_destroy(out.module_function_counts);
    raz_rt_stage1_arena_destroy(out.module_function_indices);
    raz_rt_stage1_arena_destroy(out.opcodes);
    raz_rt_stage1_arena_destroy(out.op_types);
    raz_rt_stage1_arena_destroy(out.op_a);
    raz_rt_stage1_arena_destroy(out.op_b);
    raz_rt_stage1_arena_destroy(out.op_c);
    raz_rt_stage1_arena_destroy(out.op_d);
    raz_rt_stage1_arena_destroy(out.call_arguments);
    raz_rt_stage1_arena_destroy(out.ownership_event_instructions);
    raz_rt_stage1_arena_destroy(out.ownership_event_kinds);
    raz_rt_stage1_arena_destroy(out.ownership_event_slots);
    raz_rt_stage1_arena_destroy(out.ownership_event_path_starts);
    raz_rt_stage1_arena_destroy(out.ownership_event_path_counts);
    raz_rt_stage1_arena_destroy(out.ownership_event_parents);
    raz_rt_stage1_arena_destroy(out.ownership_path_components);
}

fn mir_emit(MirModule&mut out, i64 opcode, i64 a, i64 b, i64 c, i64 d) -> i64 {
    i64 index = out.instruction_count;

    out.instruction_count += 1;
    raz_rt_stage1_arena_set(out.opcodes, index, opcode);
    raz_rt_stage1_arena_set(out.op_types, index, 0);
    raz_rt_stage1_arena_set(out.op_a, index, a);
    raz_rt_stage1_arena_set(out.op_b, index, b);
    raz_rt_stage1_arena_set(out.op_c, index, c);
    raz_rt_stage1_arena_set(out.op_d, index, d);
    return index;
}

fn mir_emit_typed(MirModule&mut out, i64 opcode, i64 a, i64 b, i64 c, i64 d, i64 type_kind) -> i64 {
    i64 instruction = mir_emit(out, opcode, a, b, c, d);

    raz_rt_stage1_arena_set(out.op_types, instruction, type_kind);
    return instruction;
}

fn mir_patch_target(MirModule&mut out, i64 instruction, i64 target) -> bool {
    if (instruction < 0 || instruction >= out.instruction_count) {
        return false;
    }
    raz_rt_stage1_arena_set(out.op_b, instruction, target);
    return true;
}

fn mir_patch_operand(MirModule&mut out, i64 instruction, i64 operand, i64 value) -> bool {
    if (instruction < 0 || instruction >= out.instruction_count) {
        return false;
    }
    if (operand == 0) {
        raz_rt_stage1_arena_set(out.op_a, instruction, value);
    } else if (operand == 1) {
        raz_rt_stage1_arena_set(out.op_b, instruction, value);
    } else if (operand == 2) {
        raz_rt_stage1_arena_set(out.op_c, instruction, value);
    } else if (operand == 3) {
        raz_rt_stage1_arena_set(out.op_d, instruction, value);
    } else {
        return false;
    }
    return true;
}

fn mir_record_ownership_path_event(
    MirModule&mut out,
    i64 instruction,
    i64 kind,
    i64 slot,
    i64 components,
    i64 component_count,
) -> bool {
    if (
        out.ownership_event_count >= 262144 ||
        out.ownership_path_component_count + component_count >= 524288 ||
        instruction < 0 ||
        instruction >= out.instruction_count ||
        slot < 0 ||
        component_count < 0
    ) {
        return false;
    }

    i64 event = out.ownership_event_count;
    i64 path_start = out.ownership_path_component_count;
    i64 component = 0;

    while (component < component_count) {
        raz_rt_stage1_arena_set(
            out.ownership_path_components,
            path_start + component,
            raz_rt_stage1_arena_get(components, component),
        );
        component += 1;
    }
    out.ownership_path_component_count += component_count;
    out.ownership_event_count += 1;
    raz_rt_stage1_arena_set(out.ownership_event_instructions, event, instruction);
    raz_rt_stage1_arena_set(out.ownership_event_kinds, event, kind);
    raz_rt_stage1_arena_set(out.ownership_event_slots, event, slot);
    raz_rt_stage1_arena_set(out.ownership_event_path_starts, event, path_start);
    raz_rt_stage1_arena_set(out.ownership_event_path_counts, event, component_count);
    raz_rt_stage1_arena_set(out.ownership_event_parents, event, -1);
    return true;
}

fn mir_record_ownership_event(MirModule&mut out, i64 instruction, i64 kind, i64 slot) -> bool {
    return mir_record_ownership_path_event(out, instruction, kind, slot, 0, 0);
}
