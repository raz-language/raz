namespace raz_compiler_mir_interpreter;

extern fn raz_rt_time_monotonic_nanos() -> i64;
public import raz_compiler_mir_transform_pipeline;
// MIR interpreter and qualification corpus. Kept separate from lowering so
// execution is a consumer of verified MIR rather than part of IR construction.
fn compiler_div_nonnegative(i64 left, i64 right) -> i64 {
    if (right <= 0 || left < 0) {
        return 0;
    }

    i64 remainder = left;
    i64 quotient = 0;

    while (remainder >= right) {
        i64 divisor = right;
        i64 multiple = 1;

        while (divisor <= remainder - divisor) {
            divisor += divisor;
            multiple += multiple;
        }
        remainder -= divisor;
        quotient += multiple;
    }
    return quotient;
}

fn execute_mir_extern(MirModule& mir, i64 function_index, i64 arguments, i64 argument_count) -> i64 {
    i64 kind = raz_compiler_rt_arena_get(mir.function_extern_kinds, function_index);

    if (kind == 1 && argument_count == 1) {
        return raz_compiler_rt_arena_create(raz_compiler_rt_arena_get(arguments, 0));
    }
    if (kind == 2 && argument_count == 1) {
        raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(arguments, 0));
        return 0;
    }
    if (kind == 3 && argument_count == 2) {
        return raz_compiler_rt_arena_get(
            raz_compiler_rt_arena_get(arguments, 0),
            raz_compiler_rt_arena_get(arguments, 1),
        );
    }
    if (kind == 4 && argument_count == 3) {
        raz_compiler_rt_arena_set(
            raz_compiler_rt_arena_get(arguments, 0),
            raz_compiler_rt_arena_get(arguments, 1),
            raz_compiler_rt_arena_get(arguments, 2),
        );
        return 0;
    }
    if (kind == 5 && argument_count == 4) {
        return raz_compiler_rt_write_ascii(
            raz_compiler_rt_arena_get(arguments, 0),
            raz_compiler_rt_arena_get(arguments, 1),
            raz_compiler_rt_arena_get(arguments, 2),
            raz_compiler_rt_arena_get(arguments, 3),
        );
    }
    if (kind == 6 && argument_count == 4) {
        return raz_compiler_rt_read_ascii(
            raz_compiler_rt_arena_get(arguments, 0),
            raz_compiler_rt_arena_get(arguments, 1),
            raz_compiler_rt_arena_get(arguments, 2),
            raz_compiler_rt_arena_get(arguments, 3),
        );
    }
    return 0;
}

fn destroy_owned_locals(i64 locals, i64 owned, i64 local_count) {
    i64 slot = 0;

    while (slot < local_count) {
        if (raz_compiler_rt_arena_get(owned, slot) != 0) {
            i64 handle = raz_compiler_rt_arena_get(locals, slot);

            if (handle != 0) {
                raz_compiler_rt_arena_destroy(handle);
                raz_compiler_rt_arena_set(locals, slot, 0);
            }
        }
        slot += 1;
    }
}

fn execute_mir_function(
    MirModule& mir,
    i64 function_index,
    i64 argument_values,
    i64 argument_start,
    i64 argument_count,
) -> i64 {
    i64 register_capacity = mir.instruction_count + 1;
    i64 registers = raz_compiler_rt_arena_create(register_capacity);

    if (registers == 0) {
        return 0;
    }

    i64 register_slot = 0;

    while (register_slot < register_capacity) {
        raz_compiler_rt_arena_set(registers, register_slot, 0);
        register_slot += 1;
    }

    i64 edge_value_slot = mir.instruction_count;
    i64 local_count = raz_compiler_rt_arena_get(mir.function_local_counts, function_index);
    i64 frame_capacity = local_count + 1;
    i64 locals = raz_compiler_rt_arena_create(frame_capacity);
    i64 owned = raz_compiler_rt_arena_create(frame_capacity);

    if (locals == 0 || owned == 0) {
        if (locals != 0) {
            raz_compiler_rt_arena_destroy(locals);
        }
        if (owned != 0) {
            raz_compiler_rt_arena_destroy(owned);
        }
        raz_compiler_rt_arena_destroy(registers);
        return 0;
    }

    i64 initialize_slot = 0;

    while (initialize_slot < frame_capacity) {
        raz_compiler_rt_arena_set(locals, initialize_slot, 0);
        raz_compiler_rt_arena_set(owned, initialize_slot, 0);
        initialize_slot += 1;
    }

    i64 ip = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = ip + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 step_budget = 10000;

    while (ip < end) {
        if (step_budget <= 0) {
            destroy_owned_locals(locals, owned, local_count);
            raz_compiler_rt_arena_destroy(owned);
            raz_compiler_rt_arena_destroy(locals);
            raz_compiler_rt_arena_destroy(registers);
            return 0;
        }
        step_budget -= 1;

        bool jumped = false;
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        if (opcode == 1) {
            raz_compiler_rt_arena_set(registers, ip, raz_compiler_rt_arena_get(mir.op_a, ip));
        } else if (opcode == 2) {
            i64 parameter_index = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (argument_values != 0 && parameter_index >= 0 && parameter_index < argument_count) {
                raz_compiler_rt_arena_set(
                    registers,
                    ip,
                    raz_compiler_rt_arena_get(argument_values, argument_start + parameter_index),
                );
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 3) {
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_get(locals, raz_compiler_rt_arena_get(mir.op_a, ip)),
            );
        } else if (opcode == 47) {
            i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (
                global_index < 0 ||
                global_index >= mir.global_count ||
                raz_compiler_rt_arena_get(mir.global_extern_flags, global_index) != 0
            ) {
                raz_compiler_rt_arena_set(registers, ip, 0);
            } else {
                raz_compiler_rt_arena_set(
                    registers,
                    ip,
                    raz_compiler_rt_arena_get(mir.global_values, global_index),
                );
            }
        } else if (opcode == 48) {
            i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (
                global_index >= 0 &&
                global_index < mir.global_count &&
                raz_compiler_rt_arena_get(mir.global_extern_flags, global_index) == 0
            ) {
                raz_compiler_rt_arena_set(
                    mir.global_values,
                    global_index,
                    raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
                );
            }
        } else if (opcode == 49) {
            // The bootstrap interpreter tags module-storage references as a
            // negative logical address. Native backends replace this with a real
            // process address while preserving the same reference operations.

            i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

            raz_compiler_rt_arena_set(registers, ip, -global_index - 1);
        } else if (opcode == 4) {
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) + raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
            );
        } else if (opcode == 5) {
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) - raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
            );
        } else if (opcode == 6) {
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) * raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
            );
        } else if (opcode == 7) {
            i64 left = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip));
            i64 right = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip));

            if (right == 0) {
                raz_compiler_rt_arena_set(registers, ip, 0);
            } else {
                raz_compiler_rt_arena_set(registers, ip, left / right);
            }
        } else if (opcode == 40) {
            // The bootstrap MIR interpreter stores scalar values in i64 slots.
            // Native width/sign conversion semantics are exercised through
            // emitted Forge IR; compiler-internal interpretation keeps the raw
            // scalar bits while preserving the typed MIR metadata.
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)),
            );
        } else if (opcode == 8) {
            i64 call_start = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 call_count = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 call_values = raz_compiler_rt_arena_create(call_count + 1);

            if (call_values == 0) {
                destroy_owned_locals(locals, owned, local_count);
                raz_compiler_rt_arena_destroy(owned);
                raz_compiler_rt_arena_destroy(locals);
                raz_compiler_rt_arena_destroy(registers);
                return 0;
            }

            i64 call_index = 0;

            while (call_index < call_count) {
                i64 argument_register = raz_compiler_rt_arena_get(
                    mir.call_arguments,
                    call_start + call_index
                );
                raz_compiler_rt_arena_set(
                    call_values,
                    call_index,
                    raz_compiler_rt_arena_get(registers, argument_register),
                );
                call_index += 1;
            }

            i64 target_function = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (raz_compiler_rt_arena_get(mir.function_is_extern, target_function) != 0) {
                raz_compiler_rt_arena_set(
                    registers,
                    ip,
                    execute_mir_extern(mir, target_function, call_values, call_count),
                );
            } else {
                raz_compiler_rt_arena_set(
                    registers,
                    ip,
                    execute_mir_function(mir, target_function, call_values, 0, call_count),
                );
            }
            raz_compiler_rt_arena_destroy(call_values);
        } else if (opcode == 9) {
            raz_compiler_rt_arena_set(
                locals,
                raz_compiler_rt_arena_get(mir.op_a, ip),
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
            );
        } else if (opcode == 10) {
            i64 result = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip));

            destroy_owned_locals(locals, owned, local_count);
            raz_compiler_rt_arena_destroy(owned);
            raz_compiler_rt_arena_destroy(locals);
            raz_compiler_rt_arena_destroy(registers);
            return result;
        } else if (opcode == 11) {
            if (
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) == raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip))
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 12) {
            if (
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) != raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip))
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 13) {
            if (
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) < raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip))
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 14) {
            if (
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) <= raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip))
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 15) {
            if (
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) > raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip))
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 16) {
            if (
                raz_compiler_rt_arena_get(
                    registers,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                ) >= raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip))
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 17) {
            if (raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)) != 0) {
                raz_compiler_rt_arena_set(
                    registers,
                    ip,
                    raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
                );
            } else {
                raz_compiler_rt_arena_set(
                    registers,
                    ip,
                    raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_c, ip)),
                );
            }
        } else if (opcode == 18) {
            if (raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)) == 0) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 19) {
            if (
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)) != 0 &&
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)) != 0
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 20) {
            if (
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)) != 0 ||
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)) != 0
            ) {
                raz_compiler_rt_arena_set(registers, ip, 1);
            } else {
                raz_compiler_rt_arena_set(registers, ip, 0);
            }
        } else if (opcode == 21) {
            destroy_owned_locals(locals, owned, local_count);
            raz_compiler_rt_arena_destroy(owned);
            raz_compiler_rt_arena_destroy(locals);
            raz_compiler_rt_arena_destroy(registers);
            return 0;
        } else if (opcode == 22) {
            i64 argument = raz_compiler_rt_arena_get(mir.op_c, ip);

            if (argument >= 0) {
                raz_compiler_rt_arena_set(
                    registers,
                    edge_value_slot,
                    raz_compiler_rt_arena_get(registers, argument),
                );
            }
            ip = raz_compiler_rt_arena_get(mir.op_b, ip);
            jumped = true;
        } else if (opcode == 23) {
            i64 argument = raz_compiler_rt_arena_get(mir.op_d, ip);

            if (argument >= 0) {
                raz_compiler_rt_arena_set(
                    registers,
                    edge_value_slot,
                    raz_compiler_rt_arena_get(registers, argument),
                );
            }
            if (raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)) == 0) {
                ip = raz_compiler_rt_arena_get(mir.op_b, ip);
            } else {
                ip = raz_compiler_rt_arena_get(mir.op_c, ip);
            }
            jumped = true;
        } else if (opcode == 24) {
            if (raz_compiler_rt_arena_get(mir.op_a, ip) != 0) {
                raz_compiler_rt_arena_set(
                    registers,
                    ip,
                    raz_compiler_rt_arena_get(registers, edge_value_slot)
                );
            } else {
                raz_compiler_rt_arena_set(registers, ip, ip);
            }
        } else if (opcode == 25) {
            raz_compiler_rt_arena_set(registers, ip, raz_compiler_rt_arena_get(mir.op_a, ip));
        } else if (opcode == 26) {
            i64 reference = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip));

            if (reference < 0) {
                i64 global_index = -reference - 1;

                if (
                    global_index >= 0 &&
                    global_index < mir.global_count &&
                    raz_compiler_rt_arena_get(mir.global_extern_flags, global_index) == 0
                ) {
                    raz_compiler_rt_arena_set(
                        registers,
                        ip,
                        raz_compiler_rt_arena_get(mir.global_values, global_index),
                    );
                } else {
                    raz_compiler_rt_arena_set(registers, ip, 0);
                }
            } else {
                raz_compiler_rt_arena_set(registers, ip, raz_compiler_rt_arena_get(locals, reference));
            }
        } else if (opcode == 27) {
            i64 reference = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip));
            i64 stored = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip));

            if (reference < 0) {
                i64 global_index = -reference - 1;

                if (
                    global_index >= 0 &&
                    global_index < mir.global_count &&
                    raz_compiler_rt_arena_get(mir.global_extern_flags, global_index) == 0
                ) {
                    raz_compiler_rt_arena_set(mir.global_values, global_index, stored);
                }
            } else {
                raz_compiler_rt_arena_set(locals, reference, stored);
            }
            raz_compiler_rt_arena_set(registers, ip, stored);
        } else if (opcode == 28) {
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_get(
                    raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)),
                    raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
                ),
            );
        } else if (opcode == 29) {
            raz_compiler_rt_arena_set(
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)),
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip)),
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_c, ip)),
            );
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_c, ip)),
            );
        } else if (opcode == 30) {
            raz_compiler_rt_arena_set(
                registers,
                ip,
                raz_compiler_rt_arena_create(raz_compiler_rt_arena_get(mir.op_a, ip)),
            );
        } else if (opcode == 31) {
            raz_compiler_rt_arena_destroy(raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip)));
            raz_compiler_rt_arena_set(registers, ip, 0);
        } else if (opcode == 32) {
            raz_compiler_rt_arena_set(registers, ip, 0);
        } else if (opcode == 33) {
            i64 owned_slot = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (owned_slot >= 0 && owned_slot < local_count) {
                raz_compiler_rt_arena_set(owned, owned_slot, 1);
            }
            raz_compiler_rt_arena_set(registers, ip, 0);
        } else if (opcode >= 34 && opcode <= 39) {
            i64 left = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_a, ip));
            i64 right = raz_compiler_rt_arena_get(registers, raz_compiler_rt_arena_get(mir.op_b, ip));

            if (opcode == 34) {
                if (right == 0) {
                    raz_compiler_rt_arena_set(registers, ip, 0);
                } else {
                    raz_compiler_rt_arena_set(registers, ip, left % right);
                }
            } else if (opcode == 35) {
                raz_compiler_rt_arena_set(registers, ip, left & right);
            } else if (opcode == 36) {
                raz_compiler_rt_arena_set(registers, ip, left | right);
            } else if (opcode == 37) {
                raz_compiler_rt_arena_set(registers, ip, left ^ right);
            } else if (opcode == 38) {
                raz_compiler_rt_arena_set(registers, ip, left << right);
            } else {
                raz_compiler_rt_arena_set(registers, ip, left >> right);
            }
        }
        if (!jumped) {
            ip += 1;
        }
    }
    destroy_owned_locals(locals, owned, local_count);
    raz_compiler_rt_arena_destroy(owned);
    raz_compiler_rt_arena_destroy(locals);
    raz_compiler_rt_arena_destroy(registers);
    return 0;
}

fn qualify_mir_control_flow() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 1;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 0);

    i64 zero = mir_emit(&mut mir, 1, 0, 0, 0, 0);

    mir_emit(&mut mir, 22, 0, 2, zero, 0);
    mir_emit(&mut mir, 24, 1, 0, 0, 0);

    i64 limit = mir_emit(&mut mir, 1, 5, 0, 0, 0);
    i64 condition = mir_emit(&mut mir, 13, 2, limit, 0, 0);

    mir_emit(&mut mir, 23, condition, 10, 6, 2);
    mir_emit(&mut mir, 24, 1, 0, 0, 0);

    i64 one = mir_emit(&mut mir, 1, 1, 0, 0, 0);
    i64 incremented = mir_emit(&mut mir, 4, 6, one, 0, 0);

    mir_emit(&mut mir, 22, 0, 2, incremented, 0);
    mir_emit(&mut mir, 24, 1, 0, 0, 0);
    mir_emit(&mut mir, 10, 10, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);

    i64 value = execute_mir_function(&mir, 0, 0, 0, 0);

    destroy_mir(&mut mir);
    return value == 5;
}

fn qualify_mir_memory() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 1;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 2);

    i64 value = mir_emit(&mut mir, 1, 42, 0, 0, 0);

    mir_emit(&mut mir, 9, 0, value, 0, 0);

    i64 address = mir_emit(&mut mir, 25, 0, 0, 0, 0);
    i64 loaded = mir_emit(&mut mir, 26, address, 0, 0, 0);

    mir_emit(&mut mir, 10, loaded, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);

    i64 result = execute_mir_function(&mir, 0, 0, 0, 0);

    destroy_mir(&mut mir);
    return result == 42;
}

fn qualify_mir_many_arguments() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 2;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 5);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 0);

    i64 p0 = mir_emit(&mut mir, 2, 0, 0, 0, 0);
    i64 p1 = mir_emit(&mut mir, 2, 1, 0, 0, 0);
    i64 p2 = mir_emit(&mut mir, 2, 2, 0, 0, 0);
    i64 p3 = mir_emit(&mut mir, 2, 3, 0, 0, 0);
    i64 p4 = mir_emit(&mut mir, 2, 4, 0, 0, 0);
    i64 s0 = mir_emit(&mut mir, 4, p0, p1, 0, 0);
    i64 s1 = mir_emit(&mut mir, 4, s0, p2, 0, 0);
    i64 s2 = mir_emit(&mut mir, 4, s1, p3, 0, 0);
    i64 s3 = mir_emit(&mut mir, 4, s2, p4, 0, 0);

    mir_emit(&mut mir, 10, s3, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 1, mir.instruction_count);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 1, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 1, 0);

    i64 argument_start = mir.call_argument_count;
    i64 value = 1;

    while (value <= 5) {
        i64 constant = mir_emit(&mut mir, 1, value, 0, 0, 0);

        raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count, constant);
        mir.call_argument_count += 1;
        value += 1;
    }

    i64 called = mir_emit(&mut mir, 8, 0, argument_start, 5, 0);

    mir_emit(&mut mir, 10, called, 0, 0, 0);
    raz_compiler_rt_arena_set(
        mir.function_instruction_counts,
        1,
        mir.instruction_count - raz_compiler_rt_arena_get(mir.function_instruction_starts, 1),
    );

    i64 result = execute_mir_function(&mir, 1, 0, 0, 0);

    destroy_mir(&mut mir);
    return result == 15;
}

fn qualify_mir_extern_dispatch() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 5;

    i64 extern_index = 0;

    while (extern_index < 4) {
        raz_compiler_rt_arena_set(mir.function_instruction_starts, extern_index, 0);
        raz_compiler_rt_arena_set(mir.function_instruction_counts, extern_index, 0);
        raz_compiler_rt_arena_set(mir.function_is_extern, extern_index, 1);
        raz_compiler_rt_arena_set(mir.function_extern_kinds, extern_index, extern_index + 1);
        extern_index += 1;
    }
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 4, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 4, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 4, 1);
    raz_compiler_rt_arena_set(mir.function_is_extern, 4, 0);

    i64 count = mir_emit(&mut mir, 1, 4, 0, 0, 0);
    i64 create_start = mir.call_argument_count;

    raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count, count);
    mir.call_argument_count += 1;

    i64 handle = mir_emit(&mut mir, 8, 0, create_start, 1, 0);

    mir_emit(&mut mir, 9, 0, handle, 0, 0);

    i64 index = mir_emit(&mut mir, 1, 2, 0, 0, 0);
    i64 value = mir_emit(&mut mir, 1, 77, 0, 0, 0);
    i64 set_start = mir.call_argument_count;

    raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count, handle);
    raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count + 1, index);
    raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count + 2, value);
    mir.call_argument_count += 3;
    mir_emit(&mut mir, 8, 3, set_start, 3, 0);

    i64 get_start = mir.call_argument_count;

    raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count, handle);
    raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count + 1, index);
    mir.call_argument_count += 2;

    i64 loaded = mir_emit(&mut mir, 8, 2, get_start, 2, 0);
    i64 destroy_start = mir.call_argument_count;

    raz_compiler_rt_arena_set(mir.call_arguments, mir.call_argument_count, handle);
    mir.call_argument_count += 1;
    mir_emit(&mut mir, 8, 1, destroy_start, 1, 0);
    mir_emit(&mut mir, 10, loaded, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 4, mir.instruction_count);

    i64 result = execute_mir_function(&mir, 4, 0, 0, 0);

    destroy_mir(&mut mir);
    return result == 77;
}

fn qualify_mir_call_frame_ownership() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 2;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 1);

    i64 storage = mir_emit(&mut mir, 30, 2, 0, 0, 0);

    mir_emit(&mut mir, 9, 0, storage, 0, 0);
    mir_emit(&mut mir, 33, 0, 0, 0, 0);

    i64 field = mir_emit(&mut mir, 1, 1, 0, 0, 0);
    i64 value = mir_emit(&mut mir, 1, 64, 0, 0, 0);

    mir_emit(&mut mir, 29, storage, field, value, 0);

    i64 loaded = mir_emit(&mut mir, 28, storage, field, 0, 0);

    mir_emit(&mut mir, 10, loaded, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 1, mir.instruction_count);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 1, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 1, 0);

    i64 call_start = mir.call_argument_count;
    i64 first = mir_emit(&mut mir, 8, 0, call_start, 0, 0);
    i64 second = mir_emit(&mut mir, 8, 0, call_start, 0, 0);
    i64 sum = mir_emit(&mut mir, 4, first, second, 0, 0);

    mir_emit(&mut mir, 10, sum, 0, 0, 0);
    raz_compiler_rt_arena_set(
        mir.function_instruction_counts,
        1,
        mir.instruction_count - raz_compiler_rt_arena_get(mir.function_instruction_starts, 1),
    );

    i64 result = execute_mir_function(&mir, 1, 0, 0, 0);

    destroy_mir(&mut mir);
    return result == 128;
}

fn qualify_mir_owned_aggregate() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 1;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 0);

    i64 storage = mir_emit(&mut mir, 30, 3, 0, 0, 0);
    i64 field = mir_emit(&mut mir, 1, 1, 0, 0, 0);
    i64 value = mir_emit(&mut mir, 1, 91, 0, 0, 0);

    mir_emit(&mut mir, 29, storage, field, value, 0);

    i64 loaded = mir_emit(&mut mir, 28, storage, field, 0, 0);

    mir_emit(&mut mir, 31, storage, 0, 0, 0);
    mir_emit(&mut mir, 10, loaded, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);

    i64 result = execute_mir_function(&mir, 0, 0, 0, 0);

    destroy_mir(&mut mir);
    return result == 91;
}

fn qualify_mir_owned_array() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 1;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 0);

    i64 storage = mir_emit(&mut mir, 30, 4, 0, 0, 0);
    i64 index = 0;

    while (index < 4) {
        i64 index_value = mir_emit(&mut mir, 1, index, 0, 0, 0);
        i64 element_value = mir_emit(&mut mir, 1, (index + 1) * 10, 0, 0, 0);

        mir_emit(&mut mir, 29, storage, index_value, element_value, 0);
        index += 1;
    }

    i64 selected_index = mir_emit(&mut mir, 1, 2, 0, 0, 0);
    i64 loaded = mir_emit(&mut mir, 28, storage, selected_index, 0, 0);

    mir_emit(&mut mir, 31, storage, 0, 0, 0);
    mir_emit(&mut mir, 10, loaded, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);

    i64 result = execute_mir_function(&mir, 0, 0, 0, 0);

    destroy_mir(&mut mir);
    return result == 30;
}

fn execute_mir_main(HirModule& hir, MirModule& mir) -> i64 {
    i64 index = 0;

    while (index < hir.function_count) {
        if (raz_compiler_rt_arena_get(hir.function_name_lengths, index) == 4) {
            return execute_mir_function(mir, index, 0, 0, 0);
        }
        index += 1;
    }
    return -1;
}

// compiler candidate-owned Forge text emission and source-file driver.
fn mir_bench_write_literal(i64[]text, i64 length) {
    if (length <= 0) {
        return;
    }

    i64 buffer = raz_compiler_rt_arena_create(length);

    if (buffer == 0) {
        return;
    }

    i64 i = 0;

    while (i < length) {
        raz_compiler_rt_arena_set(buffer, i, text[i]);
        i += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, buffer, length);
    raz_compiler_rt_arena_destroy(buffer);
}

fn mir_bench_write_i64(i64 value) {
    i64 bytes = raz_compiler_rt_arena_create(32);

    if (bytes == 0) {
        return;
    }

    i64 cursor = 0;
    i64 magnitude = value;

    if (value < 0) {
        raz_compiler_rt_arena_set(bytes, cursor, 45);
        cursor += 1;
        if (value == (-9223372036854775807 - 1)) {
            i64 literal[19] = [57, 50, 50, 51, 51, 55, 50, 48, 51, 54, 56, 53, 52, 55, 55, 53, 56, 48, 56];
            i64 i = 0;

            while (i < 19) {
                raz_compiler_rt_arena_set(bytes, cursor, literal[i]);
                cursor += 1;
                i += 1;
            }
            raz_compiler_rt_stdio_write_ascii(1, bytes, cursor);
            raz_compiler_rt_arena_destroy(bytes);
            return;
        }
        magnitude = -value;
    }

    i64 digits = raz_compiler_rt_arena_create(24);

    if (digits == 0) {
        raz_compiler_rt_arena_destroy(bytes);
        return;
    }

    i64 count = 0;

    if (magnitude == 0) {
        raz_compiler_rt_arena_set(digits, count, 48);
        count = 1;
    } else {
        while (magnitude > 0) {
            raz_compiler_rt_arena_set(digits, count, 48 + magnitude % 10);
            count += 1;
            magnitude = magnitude / 10;
        }
    }

    i64 i = count;

    while (i > 0) {
        i -= 1;
        raz_compiler_rt_arena_set(bytes, cursor, raz_compiler_rt_arena_get(digits, i));
        cursor += 1;
    }
    raz_compiler_rt_stdio_write_ascii(1, bytes, cursor);
    raz_compiler_rt_arena_destroy(digits);
    raz_compiler_rt_arena_destroy(bytes);
}

fn execute_mir_benches(Source& input, HirModule& hir, MirModule& mir, i64 iterations) -> i64 {
    if (iterations <= 0) {
        return 57;
    }

    i64 index = 0;
    i64 discovered = 0;

    while (index < hir.function_count) {
        i64 length = raz_compiler_rt_arena_get(hir.function_name_lengths, index);
        i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, index);

        bool bench_name =
            length >= 6 &&
            raz_compiler_rt_arena_get(input.bytes, offset) == 98 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 1) == 101 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 2) == 110 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 3) == 99 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 4) == 104 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 5) == 95;
        if (bench_name && raz_compiler_rt_arena_get(hir.function_is_extern, index) == 0) {
            if (raz_compiler_rt_arena_get(hir.function_parameter_counts, index) != 0) {
                return 57;
            }
            discovered += 1;
            // Warm once so one-time interpreter/table initialization is not part of the sample.

            i64 warm = execute_mir_function(mir, index, 0, 0, 0);

            if (warm != 0) {
                return warm;
            }

            i64 start = raz_rt_time_monotonic_nanos();
            i64 iteration = 0;

            while (iteration < iterations) {
                i64 status = execute_mir_function(mir, index, 0, 0, 0);

                if (status != 0) {
                    return status;
                }
                iteration += 1;
            }

            i64 elapsed = raz_rt_time_monotonic_nanos() - start;
            i64 ns_per_op = elapsed / iterations;
            i64 prefix[6] = [98, 101, 110, 99, 104, 32];

            mir_bench_write_literal(&prefix, 6);

            i64 name = raz_compiler_rt_arena_create(length);

            if (name == 0) {
                return 40;
            }
            raz_compiler_rt_arena_copy(name, 0, input.bytes, offset, length);
            raz_compiler_rt_stdio_write_ascii(1, name, length);
            raz_compiler_rt_arena_destroy(name);

            i64 middle[2] = [32, 32];

            mir_bench_write_literal(&middle, 2);
            mir_bench_write_i64(ns_per_op);

            i64 suffix[7] = [32, 110, 115, 47, 111, 112, 10];

            mir_bench_write_literal(&suffix, 7);
        }
        index += 1;
    }
    if (discovered == 0) {
        i64 none[31] = [110, 111, 32, 98, 101, 110, 99, 104, 95, 32, 102, 117, 110, 99, 116, 105, 111, 110, 115, 32, 100, 105, 115, 99, 111, 118, 101, 114, 101, 100, 10];

        mir_bench_write_literal(&none, 31);
    }
    return 0;
}

fn execute_mir_tests(Source& input, HirModule& hir, MirModule& mir) -> i64 {
    i64 index = 0;
    i64 discovered = 0;

    while (index < hir.function_count) {
        i64 length = raz_compiler_rt_arena_get(hir.function_name_lengths, index);
        i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, index);

        bool test_name =
            length >= 5 &&
            raz_compiler_rt_arena_get(input.bytes, offset) == 116 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 1) == 101 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 2) == 115 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 3) == 116 &&
            raz_compiler_rt_arena_get(input.bytes, offset + 4) == 95;
        if (test_name && raz_compiler_rt_arena_get(hir.function_is_extern, index) == 0) {
            if (raz_compiler_rt_arena_get(hir.function_parameter_counts, index) != 0) {
                return 57;
            }
            discovered += 1;

            i64 status = execute_mir_function(mir, index, 0, 0, 0);

            if (status != 0) {
                return status;
            }
        }
        index += 1;
    }
    if (discovered == 0) {
        return 0;
    }
    return 0;
}
