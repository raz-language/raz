namespace raz_compiler_mir_ownership_partial_moves;
public import raz_compiler_mir_ownership_paths;
// Projection-aware move verification. State is function-local and tracks only
// projected move events that can affect the current function. Joins union the
// MAY-moved state; sibling projections remain independent.
fn mir_partial_move_matrix_get(i64 matrix, i64 width, i64 block, i64 event) -> i64 {
  return raz_rt_stage1_arena_get(matrix, block * width + event);
}

fn mir_partial_move_matrix_set(i64 matrix, i64 width, i64 block, i64 event, i64 value) {
  raz_rt_stage1_arena_set(matrix, block * width + event, value);
}

fn mir_partial_local_event_conflicts(
MirModule& mir,
i64 move_events,
i64 move_count,
i64 state,
i64 current,
) -> bool {
  i64 local_event = 0;

  while (local_event < move_count) {
    if (raz_rt_stage1_arena_get(state, local_event) != 0) {
      i64 prior = raz_rt_stage1_arena_get(move_events, local_event);

      if (mir_ownership_paths_overlap(mir, prior, current)) {
        return true;
      }
    }
    local_event += 1;
  }
  return false;
}

fn mir_partial_local_clear_slot(
MirModule& mir,
i64 move_events,
i64 move_count,
i64 state,
i64 slot,
) {
  i64 local_event = 0;

  while (local_event < move_count) {
    i64 event = raz_rt_stage1_arena_get(move_events, local_event);

    if (raz_rt_stage1_arena_get(mir.ownership_event_slots, event) == slot) {
      raz_rt_stage1_arena_set(state, local_event, 0);
    }
    local_event += 1;
  }
}

fn mir_partial_local_clear_path(
MirModule& mir,
i64 move_events,
i64 move_count,
i64 state,
i64 reinitialize_event,
) {
  i64 local_event = 0;

  while (local_event < move_count) {
    i64 candidate = raz_rt_stage1_arena_get(move_events, local_event);

    if (mir_ownership_path_prefix_of(mir, reinitialize_event, candidate)) {
      raz_rt_stage1_arena_set(state, local_event, 0);
    }
    local_event += 1;
  }
}

fn mir_partial_local_apply_event(
MirModule& mir,
i64 move_events,
i64 move_count,
i64 state,
i64 event,
) -> bool {
  if (mir_partial_local_event_conflicts(mir, move_events, move_count, state, event)) {
    return false;
  }

  i64 local_event = 0;

  while (local_event < move_count) {
    i64 candidate = raz_rt_stage1_arena_get(move_events, local_event);

    if (mir_ownership_paths_same(mir, candidate, event)) {
      raz_rt_stage1_arena_set(state, local_event, 1);
    }
    local_event += 1;
  }
  return true;
}

fn mir_partial_reset_state(i64 state, i64 count) {
  i64 event = 0;

  while (event < count) {
    raz_rt_stage1_arena_set(state, event, 0);
    event += 1;
  }
}

fn mir_partial_apply_block(
MirModule& mir,
MirCfg& cfg,
i64 block,
i64 move_events,
i64 move_count,
i64 move_event_at_instruction,
i64 reinitialize_event_at_instruction,
i64 state,
) -> bool {
  i64 ip = raz_rt_stage1_arena_get(cfg.block_starts, block);
  i64 end = raz_rt_stage1_arena_get(cfg.block_ends, block);

  while (ip < end) {
    i64 opcode = raz_rt_stage1_arena_get(mir.opcodes, ip);

    if (opcode == 9) {
      mir_partial_local_clear_slot(
      mir,
      move_events,
      move_count,
      state,
      raz_rt_stage1_arena_get(mir.op_a, ip),
      );
    }

    i64 reinitialize_event = raz_rt_stage1_arena_get(reinitialize_event_at_instruction, ip);

    if (reinitialize_event >= 0) {
      mir_partial_local_clear_path(
      mir,
      move_events,
      move_count,
      state,
      reinitialize_event,
      );
    }

    i64 move_event = raz_rt_stage1_arena_get(move_event_at_instruction, ip);

    if (
    move_event >= 0 &&
    !mir_partial_local_apply_event(mir, move_events, move_count, state, move_event)
    ) {
      return false;
    }
    ip += 1;
  }
  return true;
}

fn verify_mir_partial_move_dataflow(MirModule& mir) -> bool {
  if (!verify_mir_ownership_paths(mir)) {
    return false;
  }
  if (mir.ownership_event_count == 0) {
    return true;
  }

  bool has_projected_move = false;
  i64 event = 0;

  while (event < mir.ownership_event_count && !has_projected_move) {
    if (
    raz_rt_stage1_arena_get(mir.ownership_event_kinds, event) == 1 &&
    raz_rt_stage1_arena_get(mir.ownership_event_path_counts, event) > 0
    ) {
      has_projected_move = true;
    }
    event += 1;
  }
  if (!has_projected_move) {
    return true;
  }

  MirCfg cfg;

  if (!build_mir_cfg(mir, &mut cfg)) {
    return false;
  }
  if (cfg.block_count == 0) {
    destroy_mir_cfg(&mut cfg);
    return true;
  }

  // Index projected move/reinitialize events by program point once. The old
  // verifier searched the complete ownership event table for every MIR
  // instruction, which is quadratic on compiler-sized modules.
  i64 move_event_at_instruction = raz_rt_stage1_arena_create(mir.instruction_count + 1);
  i64 reinitialize_event_at_instruction = raz_rt_stage1_arena_create(mir.instruction_count + 1);

  if (move_event_at_instruction == 0 || reinitialize_event_at_instruction == 0) {
    if (move_event_at_instruction != 0) {
      raz_rt_stage1_arena_destroy(move_event_at_instruction);
    }
    if (reinitialize_event_at_instruction != 0) {
      raz_rt_stage1_arena_destroy(reinitialize_event_at_instruction);
    }
    destroy_mir_cfg(&mut cfg);
    return false;
  }

  i64 clear = 0;
  while (clear < mir.instruction_count + 1) {
    raz_rt_stage1_arena_set(move_event_at_instruction, clear, -1);
    raz_rt_stage1_arena_set(reinitialize_event_at_instruction, clear, -1);
    clear += 1;
  }

  event = 0;
  while (event < mir.ownership_event_count) {
    i64 path_count = raz_rt_stage1_arena_get(mir.ownership_event_path_counts, event);

    if (path_count > 0) {
      i64 instruction = raz_rt_stage1_arena_get(mir.ownership_event_instructions, event);
      i64 kind = raz_rt_stage1_arena_get(mir.ownership_event_kinds, event);

      if (instruction >= 0 && instruction < mir.instruction_count) {
        if (kind == 1) {
          raz_rt_stage1_arena_set(move_event_at_instruction, instruction, event);
        } else if (kind == 2) {
          raz_rt_stage1_arena_set(reinitialize_event_at_instruction, instruction, event);
        }
      }
    }
    event += 1;
  }

  bool valid = true;
  i64 function_index = 0;

  while (function_index < mir.function_count && valid) {
    if (function_index % 128 == 0) {
    }
    i64 first_block = raz_rt_stage1_arena_get(cfg.function_block_starts, function_index);
    i64 block_count = raz_rt_stage1_arena_get(cfg.function_block_counts, function_index);
    i64 function_start = raz_rt_stage1_arena_get(mir.function_instruction_starts, function_index);
    i64 function_end = function_start + raz_rt_stage1_arena_get(
    mir.function_instruction_counts,
    function_index,
    );

    if (block_count == 0) {
      function_index += 1;
      continue;
    }

    i64 move_events = raz_rt_stage1_arena_create(mir.ownership_event_count + 1);
    if (move_events == 0) {
      valid = false;
      break;
    }
    i64 move_count = 0;
    event = 0;
    while (event < mir.ownership_event_count) {
      if (
      raz_rt_stage1_arena_get(mir.ownership_event_kinds, event) == 1 &&
      raz_rt_stage1_arena_get(mir.ownership_event_path_counts, event) > 0
      ) {
        i64 instruction = raz_rt_stage1_arena_get(mir.ownership_event_instructions, event);

        if (instruction >= function_start && instruction < function_end) {
          raz_rt_stage1_arena_set(move_events, move_count, event);
          move_count += 1;
        }
      }
      event += 1;
    }
    if (move_count == 0) {
      raz_rt_stage1_arena_destroy(move_events);
      function_index += 1;
      continue;
    }
    if (move_count > 64) {
    }

    i64 local = raz_rt_stage1_arena_create(move_count + 1);
    if (local == 0) {
      raz_rt_stage1_arena_destroy(move_events);
      valid = false;
      break;
    }
    mir_partial_reset_state(local, move_count);

    // Straight-line functions need no fixed-point state.
    if (block_count == 1) {
      valid = mir_partial_apply_block(
      mir,
      &cfg,
      first_block,
      move_events,
      move_count,
      move_event_at_instruction,
      reinitialize_event_at_instruction,
      local,
      );
      raz_rt_stage1_arena_destroy(local);
      raz_rt_stage1_arena_destroy(move_events);
      function_index += 1;
      continue;
    }

    i64 matrix_count = block_count * move_count + 1;
    i64 out_state = raz_rt_stage1_arena_create(matrix_count);
    i64 ready = raz_rt_stage1_arena_create(block_count + 1);
    i64 queue = raz_rt_stage1_arena_create(block_count + 1);
    i64 in_queue = raz_rt_stage1_arena_create(block_count + 1);

    if (out_state == 0 || ready == 0 || queue == 0 || in_queue == 0) {
      if (out_state != 0) { raz_rt_stage1_arena_destroy(out_state); }
      if (ready != 0) { raz_rt_stage1_arena_destroy(ready); }
      if (queue != 0) { raz_rt_stage1_arena_destroy(queue); }
      if (in_queue != 0) { raz_rt_stage1_arena_destroy(in_queue); }
      raz_rt_stage1_arena_destroy(local);
      raz_rt_stage1_arena_destroy(move_events);
      valid = false;
      break;
    }

    clear = 0;
    while (clear < matrix_count) {
      raz_rt_stage1_arena_set(out_state, clear, 0);
      clear += 1;
    }
    clear = 0;
    while (clear < block_count + 1) {
      raz_rt_stage1_arena_set(ready, clear, 0);
      raz_rt_stage1_arena_set(in_queue, clear, 0);
      clear += 1;
    }

    i64 queue_capacity = block_count + 1;
    i64 queue_head = 0;
    i64 queue_tail = 0;
    i64 queue_count = 1;
    i64 processed = 0;
    i64 process_limit = block_count * (move_count + 2) * 8 + 64;

    raz_rt_stage1_arena_set(queue, 0, 0);
    raz_rt_stage1_arena_set(in_queue, 0, 1);
    queue_tail = 1 % queue_capacity;

    while (queue_count > 0 && valid && processed < process_limit) {
      i64 local_block = raz_rt_stage1_arena_get(queue, queue_head);
      queue_head = (queue_head + 1) % queue_capacity;
      queue_count -= 1;
      raz_rt_stage1_arena_set(in_queue, local_block, 0);
      processed += 1;
      mir_partial_reset_state(local, move_count);

      i64 block = first_block + local_block;
      if (local_block != 0) {
        i64 predecessor_start = raz_rt_stage1_arena_get(cfg.predecessor_starts, block);
        i64 predecessor_count = raz_rt_stage1_arena_get(cfg.predecessor_counts, block);
        i64 predecessor_offset = 0;
        bool have_predecessor = false;

        while (predecessor_offset < predecessor_count) {
          i64 predecessor = raz_rt_stage1_arena_get(
          cfg.predecessors,
          predecessor_start + predecessor_offset,
          );
          i64 predecessor_local = predecessor - first_block;

          if (
          predecessor_local >= 0 &&
          predecessor_local < block_count &&
          raz_rt_stage1_arena_get(ready, predecessor_local) != 0
          ) {
            i64 local_event = 0;

            while (local_event < move_count) {
              if (
              mir_partial_move_matrix_get(
              out_state,
              move_count,
              predecessor_local,
              local_event,
              ) != 0
              ) {
                raz_rt_stage1_arena_set(local, local_event, 1);
              }
              local_event += 1;
            }
            have_predecessor = true;
          }
          predecessor_offset += 1;
        }
        if (!have_predecessor) {
          continue;
        }
      }

      if (
      !mir_partial_apply_block(
      mir,
      &cfg,
      block,
      move_events,
      move_count,
      move_event_at_instruction,
      reinitialize_event_at_instruction,
      local,
      )
      ) {
        valid = false;
        break;
      }

      bool was_ready = raz_rt_stage1_arena_get(ready, local_block) != 0;
      bool out_changed = false;
      i64 local_event = 0;

      while (local_event < move_count) {
        i64 value = raz_rt_stage1_arena_get(local, local_event);

        if (
        mir_partial_move_matrix_get(out_state, move_count, local_block, local_event) !=
        value
        ) {
          mir_partial_move_matrix_set(
          out_state,
          move_count,
          local_block,
          local_event,
          value,
          );
          out_changed = true;
        }
        local_event += 1;
      }
      if (!was_ready) {
        raz_rt_stage1_arena_set(ready, local_block, 1);
        out_changed = true;
      }

      if (out_changed) {
        i64 successor = raz_rt_stage1_arena_get(cfg.successor_a, block);
        i64 successor_slot = 0;

        while (successor_slot < 2) {
          if (successor_slot == 1) {
            successor = raz_rt_stage1_arena_get(cfg.successor_b, block);
          }
          if (successor >= first_block && successor < first_block + block_count) {
            i64 successor_local = successor - first_block;

            if (raz_rt_stage1_arena_get(in_queue, successor_local) == 0) {
              raz_rt_stage1_arena_set(queue, queue_tail, successor_local);
              queue_tail = (queue_tail + 1) % queue_capacity;
              queue_count += 1;
              raz_rt_stage1_arena_set(in_queue, successor_local, 1);
            }
          }
          successor_slot += 1;
        }
      }
    }
    if (processed >= process_limit && queue_count > 0) {
      valid = false;
    }

    raz_rt_stage1_arena_destroy(out_state);
    raz_rt_stage1_arena_destroy(ready);
    raz_rt_stage1_arena_destroy(queue);
    raz_rt_stage1_arena_destroy(in_queue);
    raz_rt_stage1_arena_destroy(local);
    raz_rt_stage1_arena_destroy(move_events);
    function_index += 1;
  }

  raz_rt_stage1_arena_destroy(move_event_at_instruction);
  raz_rt_stage1_arena_destroy(reinitialize_event_at_instruction);
  destroy_mir_cfg(&mut cfg);
  return valid;
}
