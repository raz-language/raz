namespace raz_compiler_mir_ownership_places;

public import raz_compiler_mir_analysis_dominance;

// Canonical location vocabulary for MIR ownership analysis. kind: 0 invalid,
// 1 local slot, 2 global, 3 dereference, 4 indexed/field projection.
public struct MirPlace {
    i64 kind;
    i64 base;
    i64 projection;
}

fn mir_place_local(i64 slot) -> MirPlace {
    MirPlace place;

    place.kind = 1;
    place.base = slot;
    place.projection = -1;
    return place;
}

fn mir_place_global(i64 global_index) -> MirPlace {
    MirPlace place;

    place.kind = 2;
    place.base = global_index;
    place.projection = -1;
    return place;
}

fn mir_place_from_reference_instruction(MirModule& mir, i64 instruction) -> MirPlace {
    MirPlace place;

    place.kind = 0;
    place.base = -1;
    place.projection = -1;
    if (instruction < 0 || instruction >= mir.instruction_count) {
        return place;
    }

    i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, instruction);

    if (opcode == 25) {
        return mir_place_local(raz_compiler_rt_arena_get(mir.op_a, instruction));
    }
    if (opcode == 49) {
        return mir_place_global(raz_compiler_rt_arena_get(mir.op_a, instruction));
    }
    if (opcode == 26) {
        place.kind = 3;
        place.base = raz_compiler_rt_arena_get(mir.op_a, instruction);
        return place;
    }
    if (opcode == 28) {
        place.kind = 4;
        place.base = raz_compiler_rt_arena_get(mir.op_a, instruction);
        place.projection = raz_compiler_rt_arena_get(mir.op_b, instruction);
    }
    return place;
}
