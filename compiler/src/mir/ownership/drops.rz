namespace raz_compiler_mir_ownership_drops;
public import raz_compiler_mir_ownership_reborrows;
// MIR opcode 33 marks a frame slot as owning storage; opcode 31 releases an
// allocation. Keep drop bookkeeping explicit so cleanup verification can become
// CFG/path-sensitive without backend-specific logic.
fn verify_mir_drop_annotations(MirModule& mir) -> bool {
  i64 ip = 0;

  while (ip < mir.instruction_count) {
    i64 opcode = raz_rt_stage1_arena_get(mir.opcodes, ip);

    if (opcode == 31) {
      i64 value = raz_rt_stage1_arena_get(mir.op_a, ip);

      if (value < 0 || value >= mir.instruction_count) {
        return false;
      }
    }
    ip += 1;
  }
  return true;
}

fn verify_mir_ownership_facts(MirModule& mir) -> bool {
  if (!verify_mir_local_places(mir)) { return false; }
  if (!verify_mir_reference_sources(mir)) { return false; }
  if (!verify_mir_loan_regions(mir)) { return false; }
  if (!verify_mir_reborrow_provenance(mir)) { return false; }
  if (!verify_mir_drop_annotations(mir)) { return false; }
  if (!verify_mir_local_move_dataflow(mir)) { return false; }
  if (!verify_mir_partial_move_dataflow(mir)) { return false; }
  return true;
}
