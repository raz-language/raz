namespace raz_compiler_mir_ownership_borrows;

public import raz_compiler_mir_ownership_partial_moves;

fn mir_opcode_creates_reference(i64 opcode) -> bool {
    return opcode == 25 || opcode == 49;
}

fn verify_mir_reference_sources(MirModule& mir) -> bool {
    i64 ip = 0;

    while (ip < mir.instruction_count) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        if (opcode == 49) {
            i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (global_index < 0 || global_index >= mir.global_count) {
                return false;
            }
        }
        if (opcode == 26 || opcode == 27) {
            i64 source = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (source < 0 || source >= mir.instruction_count) {
                return false;
            }
        }
        ip += 1;
    }
    return true;
}
