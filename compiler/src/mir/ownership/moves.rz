namespace raz_compiler_mir_ownership_moves;
public import raz_compiler_mir_ownership_initialization;
// Validate local-slot references at MIR level. HIR remains the authority for
// move legality during migration; these facts are the substrate for path-sensitive
// move-state analysis in the next pass.
fn verify_mir_local_places(MirModule& mir) -> bool {
  i64 function_index = 0;

  while (function_index < mir.function_count) {
    i64 start = raz_rt_stage1_arena_get(mir.function_instruction_starts, function_index);
    i64 count = raz_rt_stage1_arena_get(mir.function_instruction_counts, function_index);
    i64 local_count = raz_rt_stage1_arena_get(mir.function_local_counts, function_index);
    i64 ip = start;

    while (ip < start + count) {
      i64 opcode = raz_rt_stage1_arena_get(mir.opcodes, ip);

      if (opcode == 3 || opcode == 9 || opcode == 25 || opcode == 33) {
        i64 slot = raz_rt_stage1_arena_get(mir.op_a, ip);

        if (slot < 0 || slot >= local_count) {
          return false;
        }
      }
      ip += 1;
    }
    function_index += 1;
  }
  return true;
}
