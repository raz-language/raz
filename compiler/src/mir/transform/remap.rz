namespace raz_compiler_mir_transform_remap;
public import raz_compiler_mir_transform_const_prop;
// Complete instruction/value remapping used by compacting MIR transforms.
// MIR currently uses instruction indices as value identities, so every
// register operand, branch target, function range, and call-argument value
// must be rewritten as one atomic operation.
public struct MirInstructionMap {
  i64 old_to_new;
  i64 next_kept;
  i64 kept_count;
}

fn destroy_mir_instruction_map(MirInstructionMap&mut map) {
  raz_rt_stage1_arena_destroy(map.old_to_new);
  raz_rt_stage1_arena_destroy(map.next_kept);
  map.old_to_new = 0;
  map.next_kept = 0;
  map.kept_count = 0;
}

fn build_mir_instruction_map(MirModule& mir, i64 keep_flags, MirInstructionMap&mut map) -> bool {
  map.old_to_new = raz_rt_stage1_arena_create(mir.instruction_count + 1);
  map.next_kept = raz_rt_stage1_arena_create(mir.instruction_count + 1);
  map.kept_count = 0;
  if (map.old_to_new == 0 || map.next_kept == 0) {
    destroy_mir_instruction_map(map);
    return false;
  }

  i64 old_ip = 0;

  while (old_ip < mir.instruction_count) {
    if (raz_rt_stage1_arena_get(keep_flags, old_ip) != 0) {
      raz_rt_stage1_arena_set(map.old_to_new, old_ip, map.kept_count);
      map.kept_count += 1;
    } else {
      raz_rt_stage1_arena_set(map.old_to_new, old_ip, -1);
    }
    old_ip += 1;
  }
  raz_rt_stage1_arena_set(map.old_to_new, mir.instruction_count, map.kept_count);

  i64 next = map.kept_count;

  old_ip = mir.instruction_count;
  while (old_ip > 0) {
    old_ip -= 1;
    if (raz_rt_stage1_arena_get(keep_flags, old_ip) != 0) {
      next = raz_rt_stage1_arena_get(map.old_to_new, old_ip);
    }
    raz_rt_stage1_arena_set(map.next_kept, old_ip, next);
  }
  raz_rt_stage1_arena_set(map.next_kept, mir.instruction_count, map.kept_count);
  return true;
}

fn mir_map_value(MirModule& mir, MirInstructionMap& map, i64 value) -> i64 {
  if (value < 0 || value >= mir.instruction_count) {
    return value;
  }
  return raz_rt_stage1_arena_get(map.old_to_new, value);
}

fn mir_map_target(MirModule& mir, MirInstructionMap& map, i64 target) -> i64 {
  if (target < 0 || target > mir.instruction_count) {
    return target;
  }
  return raz_rt_stage1_arena_get(map.next_kept, target);
}

fn mir_get_operand(MirModule& mir, i64 ip, i64 operand) -> i64 {
  if (operand == 0) {
    return raz_rt_stage1_arena_get(mir.op_a, ip);
  }
  if (operand == 1) {
    return raz_rt_stage1_arena_get(mir.op_b, ip);
  }
  if (operand == 2) {
    return raz_rt_stage1_arena_get(mir.op_c, ip);
  }
  return raz_rt_stage1_arena_get(mir.op_d, ip);
}

fn mir_set_operand(MirModule&mut mir, i64 ip, i64 operand, i64 value) {
  if (operand == 0) {
    raz_rt_stage1_arena_set(mir.op_a, ip, value);
  } else if (operand == 1) {
    raz_rt_stage1_arena_set(mir.op_b, ip, value);
  } else if (operand == 2) {
    raz_rt_stage1_arena_set(mir.op_c, ip, value);
  } else {
    raz_rt_stage1_arena_set(mir.op_d, ip, value);
  }
}

fn mir_replace_value_uses(MirModule&mut mir, i64 old_value, i64 new_value) -> bool {
  if (
  old_value < 0 ||
  old_value >= mir.instruction_count ||
  new_value < 0 ||
  new_value >= mir.instruction_count
  ) {
    return false;
  }

  i64 ip = 0;

  while (ip < mir.instruction_count) {
    i64 opcode = raz_rt_stage1_arena_get(mir.opcodes, ip);
    i64 operand = 0;

    while (operand < 4) {
      if (mir_operand_is_register(opcode, operand)) {
        if (mir_get_operand(mir, ip, operand) == old_value) {
          mir_set_operand(mir, ip, operand, new_value);
        }
      }
      operand += 1;
    }
    ip += 1;
  }

  i64 argument = 0;

  while (argument < mir.call_argument_count) {
    if (raz_rt_stage1_arena_get(mir.call_arguments, argument) == old_value) {
      raz_rt_stage1_arena_set(mir.call_arguments, argument, new_value);
    }
    argument += 1;
  }
  return true;
}

fn compact_mir_instructions(MirModule&mut mir, i64 keep_flags) -> bool {
  MirInstructionMap map;

  if (!build_mir_instruction_map(mir, keep_flags, &mut map)) {
    return false;
  }
  // Rewrite value operands and control-flow targets while old indices still
  // address the original instruction stream.

  i64 old_ip = 0;

  while (old_ip < mir.instruction_count) {
    if (raz_rt_stage1_arena_get(keep_flags, old_ip) != 0) {
      i64 opcode = raz_rt_stage1_arena_get(mir.opcodes, old_ip);
      i64 operand = 0;

      while (operand < 4) {
        if (mir_operand_is_register(opcode, operand)) {
          i64 value = mir_get_operand(mir, old_ip, operand);

          if (value >= 0) {
            i64 mapped = mir_map_value(mir, &map, value);

            if (mapped < 0) {
              destroy_mir_instruction_map(&mut map);
              return false;
            }
            mir_set_operand(mir, old_ip, operand, mapped);
          }
        }
        operand += 1;
      }
      if (opcode == 22) {
        mir_set_operand(mir, old_ip, 1, mir_map_target(mir, &map, mir_get_operand(mir, old_ip, 1)));
      } else if (opcode == 23) {
        mir_set_operand(mir, old_ip, 1, mir_map_target(mir, &map, mir_get_operand(mir, old_ip, 1)));
        mir_set_operand(mir, old_ip, 2, mir_map_target(mir, &map, mir_get_operand(mir, old_ip, 2)));
      }
    }
    old_ip += 1;
  }

  i64 argument = 0;

  while (argument < mir.call_argument_count) {
    i64 value = raz_rt_stage1_arena_get(mir.call_arguments, argument);

    if (value >= 0 && value < mir.instruction_count) {
      i64 mapped = mir_map_value(mir, &map, value);

      if (mapped < 0) {
        destroy_mir_instruction_map(&mut map);
        return false;
      }
      raz_rt_stage1_arena_set(mir.call_arguments, argument, mapped);
    }
    argument += 1;
  }

  i64 ownership_event = 0;

  while (ownership_event < mir.ownership_event_count) {
    i64 instruction = raz_rt_stage1_arena_get(mir.ownership_event_instructions, ownership_event);
    i64 mapped_instruction = mir_map_target(mir, &map, instruction);

    raz_rt_stage1_arena_set(mir.ownership_event_instructions, ownership_event, mapped_instruction);
    ownership_event += 1;
  }

  i64 function_index = 0;

  while (function_index < mir.function_count) {
    i64 old_start = raz_rt_stage1_arena_get(mir.function_instruction_starts, function_index);
    i64 old_count = raz_rt_stage1_arena_get(mir.function_instruction_counts, function_index);
    i64 old_end = old_start + old_count;
    i64 new_start = mir_map_target(mir, &map, old_start);
    i64 new_end = mir_map_target(mir, &map, old_end);

    raz_rt_stage1_arena_set(mir.function_instruction_starts, function_index, new_start);
    raz_rt_stage1_arena_set(mir.function_instruction_counts, function_index, new_end - new_start);
    function_index += 1;
  }
  // Compact in place. new_ip never exceeds old_ip, so forward copying is safe.
  old_ip = 0;
  while (old_ip < mir.instruction_count) {
    i64 new_ip = raz_rt_stage1_arena_get(map.old_to_new, old_ip);

    if (new_ip >= 0 && new_ip != old_ip) {
      raz_rt_stage1_arena_set(mir.opcodes, new_ip, raz_rt_stage1_arena_get(mir.opcodes, old_ip));
      raz_rt_stage1_arena_set(mir.op_types, new_ip, raz_rt_stage1_arena_get(mir.op_types, old_ip));
      raz_rt_stage1_arena_set(mir.op_a, new_ip, raz_rt_stage1_arena_get(mir.op_a, old_ip));
      raz_rt_stage1_arena_set(mir.op_b, new_ip, raz_rt_stage1_arena_get(mir.op_b, old_ip));
      raz_rt_stage1_arena_set(mir.op_c, new_ip, raz_rt_stage1_arena_get(mir.op_c, old_ip));
      raz_rt_stage1_arena_set(mir.op_d, new_ip, raz_rt_stage1_arena_get(mir.op_d, old_ip));
    }
    old_ip += 1;
  }
  mir.instruction_count = map.kept_count;
  destroy_mir_instruction_map(&mut map);
  return true;
}
