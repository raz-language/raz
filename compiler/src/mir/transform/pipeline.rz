namespace raz_compiler_mir_transform_pipeline;
public import raz_compiler_mir_transform_cfg_cleanup;
// Single choke point between semantic lowering and MIR consumers. Every backend
// sees the same verified, canonicalized MIR and never owns language semantics.
fn run_mir_pipeline(MirModule&mut mir, i64 optimization_level) -> bool {
  if (!verify_mir_structure(mir)) {
    return false;
  }
  if (!verify_mir_ownership_semantics(mir)) {
    return false;
  }
  i64 effective_optimization = optimization_level;

  if (effective_optimization < 0) {
    effective_optimization = 2;
  }
  // O0 is deliberately verification-only. Language legality still passes the
  // complete structural and ownership firewalls, but no canonicalization or
  // optimization transform is required before a backend consumes MIR.
  if (effective_optimization == 0) {
    return true;
  }
  if (!simplify_mir_cfg(mir)) {
    return false;
  }
  if (!propagate_mir_constants(mir)) {
    return false;
  }
  if (!propagate_mir_copies(mir)) {
    return false;
  }
  if (!simplify_mir_scalars(mir)) {
    return false;
  }
  if (!eliminate_mir_dead_values(mir)) {
    return false;
  }
  if (!cleanup_mir_cfg(mir)) {
    return false;
  }
  if (!eliminate_mir_dead_values(mir)) {
    return false;
  }
  bool final_structure = verify_mir_structure(mir);
  if (!final_structure) {
    return false;
  }
  bool final_ownership = verify_mir_ownership_semantics(mir);
  return final_ownership;
}
