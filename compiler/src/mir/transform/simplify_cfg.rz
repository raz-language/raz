namespace raz_compiler_mir_transform_simplify_cfg;
public import raz_compiler_mir_verify_verifier;
// First conservative canonicalization: collapse conditional branches whose two
// destinations are identical into an unconditional jump. This preserves edge
// values and removes needless backend branching without renumbering MIR.
fn simplify_mir_cfg(MirModule&mut mir) -> bool {
  i64 ip = 0;

  while (ip < mir.instruction_count) {
    if (raz_compiler_rt_arena_get(mir.opcodes, ip) == 23) {
      i64 false_target = raz_compiler_rt_arena_get(mir.op_b, ip);
      i64 true_target = raz_compiler_rt_arena_get(mir.op_c, ip);

      if (false_target == true_target) {
        i64 edge_value = raz_compiler_rt_arena_get(mir.op_d, ip);

        raz_compiler_rt_arena_set(mir.opcodes, ip, 22);
        raz_compiler_rt_arena_set(mir.op_a, ip, 0);
        raz_compiler_rt_arena_set(mir.op_b, ip, false_target);
        raz_compiler_rt_arena_set(mir.op_c, ip, edge_value);
        raz_compiler_rt_arena_set(mir.op_d, ip, 0);
      }
    }
    ip += 1;
  }
  return true;
}
