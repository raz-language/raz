namespace raz_compiler_mir_transform_copy_prop;
public import raz_compiler_mir_transform_remap;
// Numeric cast opcode 40 is a semantic copy when source and destination MIR
// types are identical. Rewrite all consumers to the original value; DCE can
// then remove the redundant cast in the same pipeline iteration.
fn propagate_mir_copies(MirModule&mut mir) -> bool {
  i64 ip = 0;

  while (ip < mir.instruction_count) {
    if (raz_rt_stage1_arena_get(mir.opcodes, ip) == 40) {
      i64 source = raz_rt_stage1_arena_get(mir.op_a, ip);

      if (source >= 0 && source < mir.instruction_count) {
        i64 target_type = raz_rt_stage1_arena_get(mir.op_types, ip);
        i64 source_type = raz_rt_stage1_arena_get(mir.op_types, source);

        if (target_type == source_type && !mir_replace_value_uses(mir, ip, source)) {
          return false;
        }
      }
    }
    ip += 1;
  }
  return true;
}
