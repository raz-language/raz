namespace raz_compiler_mir_analysis_dominance;
public import raz_compiler_mir_analysis_liveness;
// Dominance queries use CFG reachability and predecessor scans. The compact
// implementation favors bootstrap simplicity; the API can later switch to a
// Lengauer-Tarjan implementation without changing MIR consumers.
fn mir_cfg_block_reaches_without(MirCfg& cfg, i64 entry, i64 target, i64 excluded) -> bool {
  if (entry == excluded) {
    return false;
  }

  MirDataflowSet seen;

  if (!init_mir_dataflow_set(&mut seen, cfg.block_count)) {
    return false;
  }

  i64 work = raz_compiler_rt_arena_create(cfg.block_count + 1);

  if (work == 0) {
    destroy_mir_dataflow_set(&mut seen);
    return false;
  }

  i64 head = 0;
  i64 tail = 0;

  mir_dataflow_insert(&mut seen, entry);
  raz_compiler_rt_arena_set(work, tail, entry);
  tail += 1;

  bool found = false;

  while (head < tail && !found) {
    i64 block = raz_compiler_rt_arena_get(work, head);

    head += 1;
    if (block == target) {
      found = true;
    } else {
      i64 successor = raz_compiler_rt_arena_get(cfg.successor_a, block);

      if (successor >= 0 && successor != excluded && mir_dataflow_insert(&mut seen, successor)) {
        raz_compiler_rt_arena_set(work, tail, successor);
        tail += 1;
      }
      successor = raz_compiler_rt_arena_get(cfg.successor_b, block);
      if (successor >= 0 && successor != excluded && mir_dataflow_insert(&mut seen, successor)) {
        raz_compiler_rt_arena_set(work, tail, successor);
        tail += 1;
      }
    }
  }
  raz_compiler_rt_arena_destroy(work);
  destroy_mir_dataflow_set(&mut seen);
  return found;
}

fn mir_cfg_dominates(MirCfg& cfg, i64 entry, i64 candidate, i64 target) -> bool {
  if (candidate == target) {
    return true;
  }
  if (candidate == entry) {
    return true;
  }
  if (candidate < 0 || target < 0 || entry < 0) {
    return false;
  }
  return !mir_cfg_block_reaches_without(cfg, entry, target, candidate);
}
