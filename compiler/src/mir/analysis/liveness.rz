namespace raz_compiler_mir_analysis_liveness;

public import raz_compiler_mir_analysis_dataflow;

// Register values in MIR are instruction-indexed SSA-like temporaries. This
// summary records use counts and last-use positions without mutating the IR.
public struct MirUseInfo {
    i64 use_counts;
}

fn init_mir_use_info(MirModule& mir, MirUseInfo&mut info) -> bool {
    // Arena allocation is already zero-filled, which is exactly the initial
    // state required by use counts. DCE is the sole consumer of MirUseInfo, so
    // do not allocate or initialize a parallel last-use table that no pass reads.
    info.use_counts = raz_compiler_rt_arena_create(mir.instruction_count + 1);
    return info.use_counts != 0;
}

fn destroy_mir_use_info(MirUseInfo&mut info) {
    raz_compiler_rt_arena_destroy(info.use_counts);
}

fn mir_record_register_use(MirModule& mir, MirUseInfo&mut info, i64 user, i64 value) -> bool {
    if (value < 0 || value >= mir.instruction_count) {
        return false;
    }

    i64 count = raz_compiler_rt_arena_get_unchecked(info.use_counts, value);

    raz_compiler_rt_arena_set_unchecked(info.use_counts, value, count + 1);
    return true;
}

fn mir_register_operand_mask(i64 opcode) -> i64 {
    // Four low bits describe which inline MIR operands are SSA value uses.
    // Computing this once per instruction avoids repeating the opcode decision
    // tree for each of the four operand positions in analysis/transform passes.
    if ((opcode >= 4 && opcode <= 7) || (opcode >= 11 && opcode <= 20) || (opcode >= 34 && opcode <= 39)) {
        return 3;
    }
    if (opcode == 9 || opcode == 48) {
        return 2;
    }
    if (opcode == 27 || opcode == 28 || opcode == 45) {
        return 3;
    }
    if (
        opcode == 10 ||
        opcode == 26 ||
        opcode == 31 ||
        opcode == 40 ||
        opcode == 41 ||
        opcode == 44 ||
        opcode == 46
    ) {
        return 1;
    }
    if (opcode == 23) {
        return 9;
    }
    if (opcode == 22) {
        return 4;
    }
    if (opcode == 29) {
        return 7;
    }
    return 0;
}

fn build_mir_use_info(MirModule& mir, MirUseInfo&mut info) -> bool {
    if (!init_mir_use_info(mir, info)) {
        return false;
    }

    i64 ip = 0;

    while (ip < mir.instruction_count) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);
        i64 register_mask = mir_register_operand_mask(opcode);
        i64 operand = 0;

        while (operand < 4) {
            if ((register_mask&(1 << operand)) != 0) {
                i64 value = 0;

                if (operand == 0) {
                    value = raz_compiler_rt_arena_get(mir.op_a, ip);
                } else if (operand == 1) {
                    value = raz_compiler_rt_arena_get(mir.op_b, ip);
                } else if (operand == 2) {
                    value = raz_compiler_rt_arena_get(mir.op_c, ip);
                } else {
                    value = raz_compiler_rt_arena_get(mir.op_d, ip);
                }
                if (value >= 0 && !mir_record_register_use(mir, info, ip, value)) {
                    destroy_mir_use_info(info);
                    return false;
                }
            }
            operand += 1;
        }
        ip += 1;
    }
    // The auxiliary call/capture arena stores MIR value identities. Counting
    // every populated entry is conservative and also covers closure captures,
    // whose arity is HIR-owned rather than duplicated in MirModule.

    i64 argument = 0;

    while (argument < mir.call_argument_count) {
        i64 value = raz_compiler_rt_arena_get(mir.call_arguments, argument);

        if (value >= 0 && value < mir.instruction_count) {
            if (!mir_record_register_use(mir, info, mir.instruction_count, value)) {
                destroy_mir_use_info(info);
                return false;
            }
        }
        argument += 1;
    }
    return true;
}
