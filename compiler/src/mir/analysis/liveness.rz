namespace raz_compiler_mir_analysis_liveness;
public import raz_compiler_mir_analysis_dataflow;
// Register values in MIR are instruction-indexed SSA-like temporaries. This
// summary records use counts and last-use positions without mutating the IR.
public struct MirUseInfo {
  i64 use_counts;
  i64 last_uses;
}

fn init_mir_use_info(MirModule& mir, MirUseInfo&mut info) -> bool {
  info.use_counts = raz_rt_stage1_arena_create(mir.instruction_count + 1);
  info.last_uses = raz_rt_stage1_arena_create(mir.instruction_count + 1);
  if (info.use_counts == 0 || info.last_uses == 0) {
    return false;
  }

  i64 index = 0;

  while (index < mir.instruction_count) {
    raz_rt_stage1_arena_set(info.use_counts, index, 0);
    raz_rt_stage1_arena_set(info.last_uses, index, -1);
    index += 1;
  }
  return true;
}

fn destroy_mir_use_info(MirUseInfo&mut info) {
  raz_rt_stage1_arena_destroy(info.use_counts);
  raz_rt_stage1_arena_destroy(info.last_uses);
}

fn mir_record_register_use(MirModule& mir, MirUseInfo&mut info, i64 user, i64 value) -> bool {
  if (value < 0 || value >= mir.instruction_count) {
    return false;
  }

  i64 count = raz_rt_stage1_arena_get(info.use_counts, value);

  raz_rt_stage1_arena_set(info.use_counts, value, count + 1);
  raz_rt_stage1_arena_set(info.last_uses, value, user);
  return true;
}

fn mir_operand_is_register(i64 opcode, i64 operand) -> bool {
  if (opcode >= 4 && opcode <= 7) {
    return operand == 0 || operand == 1;
  }
  if (opcode >= 11 && opcode <= 20) {
    return operand == 0 || operand == 1;
  }
  if (opcode >= 34 && opcode <= 39) {
    return operand == 0 || operand == 1;
  }
  if (opcode == 9) {
    return operand == 1;
  }
  if (opcode == 27) {
    return operand == 0 || operand == 1;
  }
  if (opcode == 10 || opcode == 18 || opcode == 26 || opcode == 31 || opcode == 40) {
    return operand == 0;
  }
  if (opcode == 23) {
    return operand == 0 || operand == 3;
  }
  if (opcode == 22) {
    return operand == 2;
  }
  if (opcode == 28) {
    return operand == 0 || operand == 1;
  }
  if (opcode == 29) {
    return operand == 0 || operand == 1 || operand == 2;
  }
  if (opcode == 41 || opcode == 46) {
    return operand == 0;
  }
  if (opcode == 44 || opcode == 45) {
    return operand == 0 || (opcode == 45 && operand == 1);
  }
  if (opcode == 48) {
    return operand == 1;
  }
  return false;
}

fn build_mir_use_info(MirModule& mir, MirUseInfo&mut info) -> bool {
  if (!init_mir_use_info(mir, info)) {
    return false;
  }

  i64 ip = 0;

  while (ip < mir.instruction_count) {
    i64 opcode = raz_rt_stage1_arena_get(mir.opcodes, ip);
    i64 operand = 0;

    while (operand < 4) {
      if (mir_operand_is_register(opcode, operand)) {
        i64 value = 0;

        if (operand == 0) {
          value = raz_rt_stage1_arena_get(mir.op_a, ip);
        } else if (operand == 1) {
          value = raz_rt_stage1_arena_get(mir.op_b, ip);
        } else if (operand == 2) {
          value = raz_rt_stage1_arena_get(mir.op_c, ip);
        } else {
          value = raz_rt_stage1_arena_get(mir.op_d, ip);
        }
        if (value >= 0 && !mir_record_register_use(mir, info, ip, value)) {
          destroy_mir_use_info(info);
          return false;
        }
      }
      operand += 1;
    }
    ip += 1;
  }
  // The auxiliary call/capture arena stores MIR value identities. Counting
  // every populated entry is conservative and also covers closure captures,
  // whose arity is HIR-owned rather than duplicated in MirModule.

  i64 argument = 0;

  while (argument < mir.call_argument_count) {
    i64 value = raz_rt_stage1_arena_get(mir.call_arguments, argument);

    if (value >= 0 && value < mir.instruction_count) {
      if (!mir_record_register_use(mir, info, mir.instruction_count, value)) {
        destroy_mir_use_info(info);
        return false;
      }
    }
    argument += 1;
  }
  return true;
}
