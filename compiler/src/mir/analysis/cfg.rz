namespace raz_compiler_mir_analysis_cfg;
public import raz_compiler_mir_lowering;
// Explicit basic-block graph used by MIR verification, ownership dataflow, and
// optimization. Branch targets remain instruction indices in the canonical MIR;
// this view maps them to stable block indices without changing the executable IR.
public struct MirCfg {
  i64 block_count;
  i64 block_starts;
  i64 block_ends;
  i64 block_functions;
  i64 instruction_blocks;
  i64 successor_a;
  i64 successor_b;
  i64 predecessor_counts;
  i64 predecessor_starts;
  i64 predecessors;
  i64 function_block_starts;
  i64 function_block_counts;
}

fn mir_opcode_is_terminator(i64 opcode) -> bool {
  return opcode == 10 || opcode == 21 || opcode == 22 || opcode == 23;
}

fn mir_opcode_is_branch(i64 opcode) -> bool {
  return opcode == 22 || opcode == 23;
}

fn mir_instruction_in_function(MirModule& mir, i64 function_index, i64 instruction) -> bool {
  if (function_index < 0 || function_index >= mir.function_count) {
    return false;
  }

  i64 start = raz_rt_stage1_arena_get(mir.function_instruction_starts, function_index);
  i64 count = raz_rt_stage1_arena_get(mir.function_instruction_counts, function_index);

  return instruction >= start && instruction < start + count;
}

fn mir_branch_target_valid(MirModule& mir, i64 function_index, i64 target) -> bool {
  return mir_instruction_in_function(mir, function_index, target);
}

fn init_mir_cfg(MirModule& mir, MirCfg&mut cfg) -> bool {
  cfg.block_count = 0;
  cfg.block_starts = raz_rt_stage1_arena_create(mir.instruction_count + mir.function_count + 1);
  cfg.block_ends = raz_rt_stage1_arena_create(mir.instruction_count + mir.function_count + 1);
  cfg.block_functions = raz_rt_stage1_arena_create(mir.instruction_count + mir.function_count + 1);
  cfg.instruction_blocks = raz_rt_stage1_arena_create(mir.instruction_count + 1);
  cfg.successor_a = raz_rt_stage1_arena_create(mir.instruction_count + mir.function_count + 1);
  cfg.successor_b = raz_rt_stage1_arena_create(mir.instruction_count + mir.function_count + 1);
  cfg.predecessor_counts = raz_rt_stage1_arena_create(mir.instruction_count + mir.function_count + 1);
  cfg.predecessor_starts = raz_rt_stage1_arena_create(mir.instruction_count + mir.function_count + 2);
  cfg.predecessors = raz_rt_stage1_arena_create((mir.instruction_count + mir.function_count + 1) * 2 + 1);
  cfg.function_block_starts = raz_rt_stage1_arena_create(mir.function_count + 1);
  cfg.function_block_counts = raz_rt_stage1_arena_create(mir.function_count + 1);
  return (
  cfg.block_starts != 0 &&
  cfg.block_ends != 0 &&
  cfg.block_functions != 0 &&
  cfg.instruction_blocks != 0 &&
  cfg.successor_a != 0 &&
  cfg.successor_b != 0 &&
  cfg.predecessor_counts != 0 &&
  cfg.predecessor_starts != 0 &&
  cfg.predecessors != 0 &&
  cfg.function_block_starts != 0 &&
  cfg.function_block_counts != 0
  );
}

fn destroy_mir_cfg(MirCfg&mut cfg) {
  raz_rt_stage1_arena_destroy(cfg.block_starts);
  raz_rt_stage1_arena_destroy(cfg.block_ends);
  raz_rt_stage1_arena_destroy(cfg.block_functions);
  raz_rt_stage1_arena_destroy(cfg.instruction_blocks);
  raz_rt_stage1_arena_destroy(cfg.successor_a);
  raz_rt_stage1_arena_destroy(cfg.successor_b);
  raz_rt_stage1_arena_destroy(cfg.predecessor_counts);
  raz_rt_stage1_arena_destroy(cfg.predecessor_starts);
  raz_rt_stage1_arena_destroy(cfg.predecessors);
  raz_rt_stage1_arena_destroy(cfg.function_block_starts);
  raz_rt_stage1_arena_destroy(cfg.function_block_counts);
}

fn mir_cfg_block_for_instruction(MirCfg& cfg, i64 instruction) -> i64 {
  if (instruction < 0) {
    return -1;
  }
  return raz_rt_stage1_arena_get(cfg.instruction_blocks, instruction);
}

fn mir_cfg_add_block(MirCfg&mut cfg, i64 function_index, i64 start) -> i64 {
  i64 block = cfg.block_count;

  cfg.block_count += 1;
  raz_rt_stage1_arena_set(cfg.block_starts, block, start);
  raz_rt_stage1_arena_set(cfg.block_ends, block, start);
  raz_rt_stage1_arena_set(cfg.block_functions, block, function_index);
  raz_rt_stage1_arena_set(cfg.successor_a, block, -1);
  raz_rt_stage1_arena_set(cfg.successor_b, block, -1);
  raz_rt_stage1_arena_set(cfg.predecessor_counts, block, 0);
  return block;
}

fn mir_cfg_set_successor(MirCfg&mut cfg, i64 block, i64 slot, i64 successor) {
  if (slot == 0) {
    raz_rt_stage1_arena_set(cfg.successor_a, block, successor);
  } else {
    raz_rt_stage1_arena_set(cfg.successor_b, block, successor);
  }
  if (successor >= 0) {
    i64 predecessors = raz_rt_stage1_arena_get(cfg.predecessor_counts, successor);

    raz_rt_stage1_arena_set(cfg.predecessor_counts, successor, predecessors + 1);
  }
}

fn build_mir_cfg(MirModule& mir, MirCfg&mut cfg) -> bool {
  if (!init_mir_cfg(mir, cfg)) {
    return false;
  }

  i64 function_index = 0;

  while (function_index < mir.function_count) {
    i64 start = raz_rt_stage1_arena_get(mir.function_instruction_starts, function_index);
    i64 count = raz_rt_stage1_arena_get(mir.function_instruction_counts, function_index);
    i64 end = start + count;
    i64 first_block = cfg.block_count;

    raz_rt_stage1_arena_set(cfg.function_block_starts, function_index, first_block);
    if (count > 0) {
      i64 current_block = mir_cfg_add_block(cfg, function_index, start);
      i64 ip = start;

      while (ip < end) {
        if (ip > start && raz_rt_stage1_arena_get(mir.opcodes, ip) == 24) {
          raz_rt_stage1_arena_set(cfg.block_ends, current_block, ip);
          current_block = mir_cfg_add_block(cfg, function_index, ip);
        }
        raz_rt_stage1_arena_set(cfg.instruction_blocks, ip, current_block);
        ip += 1;
      }
      raz_rt_stage1_arena_set(cfg.block_ends, current_block, end);
    }
    raz_rt_stage1_arena_set(
    cfg.function_block_counts,
    function_index,
    cfg.block_count - first_block,
    );
    function_index += 1;
  }

  i64 block = 0;

  while (block < cfg.block_count) {
    i64 block_start = raz_rt_stage1_arena_get(cfg.block_starts, block);
    i64 block_end = raz_rt_stage1_arena_get(cfg.block_ends, block);
    i64 function_index = raz_rt_stage1_arena_get(cfg.block_functions, block);

    if (block_end > block_start) {
      i64 terminator = block_end - 1;
      i64 opcode = raz_rt_stage1_arena_get(mir.opcodes, terminator);

      if (opcode == 22) {
        i64 target = raz_rt_stage1_arena_get(mir.op_b, terminator);

        if (!mir_branch_target_valid(mir, function_index, target)) {
          destroy_mir_cfg(cfg);
          return false;
        }
        mir_cfg_set_successor(cfg, block, 0, mir_cfg_block_for_instruction(cfg, target));
      } else if (opcode == 23) {
        i64 false_target = raz_rt_stage1_arena_get(mir.op_b, terminator);
        i64 true_target = raz_rt_stage1_arena_get(mir.op_c, terminator);

        if (
        !mir_branch_target_valid(mir, function_index, false_target) ||
        !mir_branch_target_valid(mir, function_index, true_target)
        ) {
          destroy_mir_cfg(cfg);
          return false;
        }
        mir_cfg_set_successor(cfg, block, 0, mir_cfg_block_for_instruction(cfg, false_target));
        mir_cfg_set_successor(cfg, block, 1, mir_cfg_block_for_instruction(cfg, true_target));
      } else if (!mir_opcode_is_terminator(opcode)) {
        i64 next = block + 1;

        if (
        next < cfg.block_count &&
        raz_rt_stage1_arena_get(cfg.block_functions, next) == function_index
        ) {
          mir_cfg_set_successor(cfg, block, 0, next);
        }
      }
    }
    block += 1;
  }

  // Materialize predecessor lists once. Dataflow consumers can then visit
  // incoming edges directly instead of rescanning every block in a function.
  i64 predecessor_cursor = 0;
  block = 0;
  while (block < cfg.block_count) {
    raz_rt_stage1_arena_set(cfg.predecessor_starts, block, predecessor_cursor);
    predecessor_cursor += raz_rt_stage1_arena_get(cfg.predecessor_counts, block);
    block += 1;
  }
  raz_rt_stage1_arena_set(cfg.predecessor_starts, cfg.block_count, predecessor_cursor);

  i64 predecessor_fills = raz_rt_stage1_arena_create(cfg.block_count + 1);
  if (predecessor_fills == 0) {
    destroy_mir_cfg(cfg);
    return false;
  }
  block = 0;
  while (block < cfg.block_count + 1) {
    raz_rt_stage1_arena_set(predecessor_fills, block, 0);
    block += 1;
  }
  block = 0;
  while (block < cfg.block_count) {
    i64 successor = raz_rt_stage1_arena_get(cfg.successor_a, block);
    if (successor >= 0) {
      i64 fill = raz_rt_stage1_arena_get(predecessor_fills, successor);
      i64 start = raz_rt_stage1_arena_get(cfg.predecessor_starts, successor);
      raz_rt_stage1_arena_set(cfg.predecessors, start + fill, block);
      raz_rt_stage1_arena_set(predecessor_fills, successor, fill + 1);
    }
    successor = raz_rt_stage1_arena_get(cfg.successor_b, block);
    if (successor >= 0) {
      i64 fill = raz_rt_stage1_arena_get(predecessor_fills, successor);
      i64 start = raz_rt_stage1_arena_get(cfg.predecessor_starts, successor);
      raz_rt_stage1_arena_set(cfg.predecessors, start + fill, block);
      raz_rt_stage1_arena_set(predecessor_fills, successor, fill + 1);
    }
    block += 1;
  }
  raz_rt_stage1_arena_destroy(predecessor_fills);
  return true;
}
