namespace raz_compiler_mir_analysis_dataflow;
public import raz_compiler_mir_analysis_cfg;
// Small arena-backed bitset abstraction shared by MIR fixed-point analyses.
public struct MirDataflowSet {
  i64 values;
  i64 count;
}

fn init_mir_dataflow_set(MirDataflowSet&mut set, i64 count) -> bool {
  set.count = count;
  set.values = raz_compiler_rt_arena_create(count + 1);
  if (set.values == 0) {
    return false;
  }

  i64 index = 0;

  while (index < count) {
    raz_compiler_rt_arena_set(set.values, index, 0);
    index += 1;
  }
  return true;
}

fn destroy_mir_dataflow_set(MirDataflowSet&mut set) {
  raz_compiler_rt_arena_destroy(set.values);
}

fn mir_dataflow_contains(MirDataflowSet& set, i64 index) -> bool {
  return index >= 0 && index < set.count && raz_compiler_rt_arena_get(set.values, index) != 0;
}

fn mir_dataflow_insert(MirDataflowSet&mut set, i64 index) -> bool {
  if (index < 0 || index >= set.count) {
    return false;
  }
  if (raz_compiler_rt_arena_get(set.values, index) != 0) {
    return false;
  }
  raz_compiler_rt_arena_set(set.values, index, 1);
  return true;
}

fn mir_cfg_mark_reachable(MirCfg& cfg, i64 entry_block, MirDataflowSet&mut reachable) -> bool {
  if (entry_block < 0 || entry_block >= cfg.block_count) {
    return false;
  }

  i64 work = raz_compiler_rt_arena_create(cfg.block_count + 1);

  if (work == 0) {
    return false;
  }

  i64 head = 0;
  i64 tail = 0;

  raz_compiler_rt_arena_set(work, tail, entry_block);
  tail += 1;
  mir_dataflow_insert(reachable, entry_block);
  while (head < tail) {
    i64 block = raz_compiler_rt_arena_get(work, head);

    head += 1;

    i64 successor = raz_compiler_rt_arena_get(cfg.successor_a, block);

    if (successor >= 0 && mir_dataflow_insert(reachable, successor)) {
      raz_compiler_rt_arena_set(work, tail, successor);
      tail += 1;
    }
    successor = raz_compiler_rt_arena_get(cfg.successor_b, block);
    if (successor >= 0 && mir_dataflow_insert(reachable, successor)) {
      raz_compiler_rt_arena_set(work, tail, successor);
      tail += 1;
    }
  }
  raz_compiler_rt_arena_destroy(work);
  return true;
}
