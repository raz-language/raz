namespace raz_borrowck::semantics;

public import raz_borrowck::drops;

// Canonical backend legality firewall for ownership. HIR may diagnose earlier,
// but every executable MIR module must independently satisfy these semantics
// before optimization and again before code generation.
public fn verify_mir_ownership_semantics(MirModule& mir) -> bool {
    return verify_mir_ownership_facts(mir);
}
