namespace raz_codegen_forge::codegen;

public import raz_codegen_forge::function_codegen;
import hir::semantic::dropck;

// Forge async lowering and final module orchestration.



fn forge_write_emit_failure(Source& source, HirModule& hir, i64 function_index) {
    ForgeWriter diagnostic;

    writer_init(&mut diagnostic);
    writer_literal(&mut diagnostic, "error: Forge backend could not emit function ");
    if (function_index >= 0 && function_index < hir.function_count) {
        writer_function_name(&mut diagnostic, source, hir, function_index);
    } else {
        writer_decimal(&mut diagnostic, function_index);
    }
    writer_newline(&mut diagnostic);
    raz_compiler_rt_stdio_write_ascii(2, diagnostic.data, diagnostic.length);
    writer_destroy(&mut diagnostic);
}

// Scalar/function helpers live in forge_function_codegen.rz.
fn writer_async_cleanup_name(ForgeWriter&mut out, Source& source, HirModule& hir, i64 structure) {
    string prefix = "@__raz_async_cleanup";
    i64 index = 0;

    while (index < 20) {
        writer_put(out, compiler_literal_byte(prefix, index));
        index += 1;
    }
    writer_put(out, 95);
    writer_structure_name(out, source, hir, structure);
}

fn emit_async_structure_cleanup_function(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    i64 structure,
) -> bool {
    if (structure < 0 || !hir_structure_needs_drop(hir, structure, 0)) {
        return true;
    }
    writer_space(out);
    writer_space(out);
    writer_keyword_func(out);
    writer_space(out);
    writer_async_cleanup_name(out, source, hir, structure);
    writer_put(out, 40);
    writer_put(out, 37);
    writer_put(out, 118);
    writer_put(out, 97);
    writer_put(out, 108);
    writer_put(out, 117);
    writer_put(out, 101);
    writer_put(out, 58);
    writer_space(out);
    writer_i64(out);
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 45);
    writer_put(out, 62);
    writer_space(out);
    writer_put(out, 118);
    writer_put(out, 111);
    writer_put(out, 105);
    writer_put(out, 100);
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);
    writer_async_entry(out);

    i64 drop_function = raz_compiler_rt_arena_get(hir.struct_drop_functions, structure);

    if (drop_function >= 0) {
        writer_async_indent(out);
        writer_async_call_text(out);
        writer_void(out);
        writer_space(out);
        writer_function_name(out, source, hir, drop_function);
        writer_put(out, 40);
        writer_put(out, 37);
        writer_put(out, 118);
        writer_put(out, 97);
        writer_put(out, 108);
        writer_put(out, 117);
        writer_put(out, 101);
        writer_put(out, 41);
        writer_newline(out);
    }

    i64 field_start = raz_compiler_rt_arena_get(hir.struct_field_starts, structure);
    i64 field_count = raz_compiler_rt_arena_get(hir.struct_field_counts, structure);
    i64 field = field_count;

    while (field > 0) {
        field -= 1;

        i64 metadata = field_start + field;
        i64 child = raz_compiler_rt_arena_get(hir.struct_field_type_structs, metadata);

        if (
            child >= 0 &&
            raz_compiler_rt_arena_get(hir.struct_field_references, metadata) == 0 &&
            hir_structure_needs_drop(hir, child, 0)
        ) {
            i64 field_reg = writer_synthetic_register(237, structure * 256 + field);
            i64 index_reg = writer_synthetic_register(238, structure * 256 + field);

            writer_async_emit_const_i64(out, index_reg, field);
            writer_instruction_prefix(out, field_reg);
            writer_async_call_text(out);
            writer_i64(out);
            writer_space(out);
            writer_runtime_name(out, 3);
            writer_put(out, 40);
            writer_put(out, 37);
            writer_put(out, 118);
            writer_put(out, 97);
            writer_put(out, 108);
            writer_put(out, 117);
            writer_put(out, 101);
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, index_reg);
            writer_put(out, 41);
            writer_newline(out);
            writer_async_call_void_prefix(out);
            writer_async_cleanup_name(out, source, hir, child);
            writer_put(out, 40);
            writer_register(out, field_reg);
            writer_put(out, 41);
            writer_newline(out);
        }
    }
    writer_async_call_void_prefix(out);
    writer_runtime_name(out, 2);
    writer_put(out, 40);
    writer_put(out, 37);
    writer_put(out, 118);
    writer_put(out, 97);
    writer_put(out, 108);
    writer_put(out, 117);
    writer_put(out, 101);
    writer_put(out, 41);
    writer_newline(out);
    writer_async_return_prefix(out);
    writer_newline(out);
    writer_space(out);
    writer_space(out);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    return !out.failed;
}

fn writer_async_emit_slot_disarm(ForgeWriter&mut out, i64 slot_register) {
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, 16);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, slot_register);
    writer_put(out, 41);
    writer_newline(out);
}

fn writer_async_emit_slot_store_owned(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    i64 structure,
    i64 slot_register,
    i64 value_register,
) {
    writer_async_emit_slot_disarm(out, slot_register);

    i64 cleanup = writer_synthetic_register(239, structure * 1024 + slot_register);

    writer_instruction_prefix(out, cleanup);
    writer_async_func_address_text(out);
    writer_async_cleanup_name(out, source, hir, structure);
    writer_newline(out);
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, 15);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, slot_register);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, value_register);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, cleanup);
    writer_put(out, 41);
    writer_newline(out);
}

public fn async_mir_await_count(HirModule& hir, MirModule& mir, i64 function_index) -> i64 {
    i64 ip = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = ip + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 count = 0;

    while (ip < end) {
        if (raz_compiler_rt_arena_get(mir.opcodes, ip) == 41) {
            count += 1;
        }
        ip += 1;
    }
    return count;
}

public fn async_mir_supported(HirModule& hir, MirModule& mir, i64 function_index) -> bool {
    if (
        raz_compiler_rt_arena_get(hir.function_return_types, function_index) != 0 ||
        raz_compiler_rt_arena_get(hir.function_return_slices, function_index) != 0
    ) {
        return false;
    }

    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);
    i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);
    i64 p = 0;

    while (p < parameter_count) {
        i64 parameter = parameter_start + p;

        if (
            raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter) >= 0 ||
            raz_compiler_rt_arena_get(hir.parameter_types, parameter) != 0 ||
            raz_compiler_rt_arena_get(hir.parameter_references, parameter) != 0 ||
            raz_compiler_rt_arena_get(hir.parameter_slices, parameter) != 0
        ) {
            return false;
        }
        p += 1;
    }

    i64 local_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);
    i64 l = 0;

    while (l < local_count) {
        i64 local = forge_native_hir_local_index(hir, function_index, l);

        if (
            local < 0 ||
            raz_compiler_rt_arena_get(hir.local_types, local) != 0 ||
            raz_compiler_rt_arena_get(hir.local_references, local) != 0 ||
            raz_compiler_rt_arena_get(hir.local_slices, local) != 0 ||
            raz_compiler_rt_arena_get(hir.local_array_extents, local) > 0
        ) {
            return false;
        }
        l += 1;
    }

    i64 ip = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = ip + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);

    while (ip < end) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        bool allowed =
            opcode == 1 ||
            opcode == 2 ||
            opcode == 3 ||
            (opcode >= 4 && opcode <= 20) ||
            opcode == 8 ||
            opcode == 44 ||
            opcode == 45 ||
            opcode == 46 ||
            opcode == 47 ||
            opcode == 48 ||
            opcode == 49 ||
            opcode == 9 ||
            opcode == 10 ||
            opcode == 22 ||
            opcode == 23 ||
            opcode == 24 ||
            (opcode >= 28 && opcode <= 33) ||
            (opcode >= 34 && opcode <= 41);
        if (!allowed) {
            return false;
        }
        ip += 1;
    }
    return true;
}

fn writer_async_emit_const_i64(ForgeWriter&mut out, i64 reg, i64 value) {
    writer_instruction_prefix(out, reg);
    writer_async_const_text(out);
    writer_i64(out);
    writer_space(out);
    writer_decimal(out, value);
    writer_newline(out);
}

fn writer_async_emit_const_i32(ForgeWriter&mut out, i64 reg, i64 value) {
    writer_instruction_prefix(out, reg);
    writer_async_const_text(out);
    writer_i32(out);
    writer_space(out);
    writer_decimal(out, value);
    writer_newline(out);
}

fn writer_async_emit_void_call1(ForgeWriter&mut out, i64 runtime_kind, i64 first, i64 first_is_frame) {
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, runtime_kind);
    writer_put(out, 40);
    if (first_is_frame != 0) {
        writer_async_frame_ref(out);
    } else {
        writer_register(out, first);
    }
    writer_put(out, 41);
    writer_newline(out);
}

fn writer_async_emit_state_store(ForgeWriter&mut out, i64 state_register) {
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, 5);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, state_register);
    writer_put(out, 41);
    writer_newline(out);
}

fn writer_async_emit_slot_store(ForgeWriter&mut out, i64 slot_register, i64 value_register) {
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, 7);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, slot_register);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, value_register);
    writer_put(out, 41);
    writer_newline(out);
}

fn writer_async_emit_slot_load(ForgeWriter&mut out, i64 result_register, i64 slot_register) {
    writer_instruction_prefix(out, result_register);
    writer_async_call_text(out);
    writer_i64(out);
    writer_space(out);
    writer_async_runtime_name(out, 6);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, slot_register);
    writer_put(out, 41);
    writer_newline(out);
}

fn emit_async_scalar_instruction(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 ip,
) -> bool {
    i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);
    i64 op_type = raz_compiler_rt_arena_get(mir.op_types, ip);
    i64 local_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);

    if (opcode == 1) {
        writer_instruction_prefix(out, ip);
        writer_async_const_text(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 2) {
        i64 slot_reg = writer_synthetic_register(120, ip);

        writer_async_emit_const_i64(out, slot_reg, local_count + raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_async_emit_slot_load(out, ip, slot_reg);
        return true;
    }
    if (opcode == 3) {
        i64 slot_reg = writer_synthetic_register(121, ip);

        writer_async_emit_const_i64(out, slot_reg, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_async_emit_slot_load(out, ip, slot_reg);
        return true;
    }
    if ((opcode >= 4 && opcode <= 7) || (opcode >= 34 && opcode <= 39)) {
        writer_instruction_prefix(out, ip);
        writer_operator(out, opcode, op_type);
        writer_space(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        return true;
    }
    if (opcode >= 11 && opcode <= 16) {
        i64 cmp = writer_synthetic_register(122, ip);
        i64 zero = writer_synthetic_register(123, ip);
        i64 one = writer_synthetic_register(124, ip);

        writer_instruction_prefix(out, cmp);
        writer_compare(out, opcode, op_type);
        writer_space(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        writer_async_emit_const_i64(out, zero, 0);
        writer_async_emit_const_i64(out, one, 1);
        writer_instruction_prefix(out, ip);
        writer_literal(out, "select ");
        writer_i64(out);
        writer_space(out);
        writer_register(out, cmp);
        writer_space(out);
        writer_register(out, one);
        writer_space(out);
        writer_register(out, zero);
        writer_newline(out);
        return true;
    }
    if (opcode == 18) {
        i64 zero = writer_synthetic_register(125, ip);
        i64 cmp = writer_synthetic_register(126, ip);
        i64 one = writer_synthetic_register(127, ip);

        writer_async_emit_const_i64(out, zero, 0);
        writer_async_emit_const_i64(out, one, 1);
        writer_instruction_prefix(out, cmp);
        writer_compare(out, 12, 0);
        writer_space(out);
        writer_i64(out);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_space(out);
        writer_register(out, zero);
        writer_newline(out);
        writer_instruction_prefix(out, ip);
        writer_literal(out, "select ");
        writer_i64(out);
        writer_space(out);
        writer_register(out, cmp);
        writer_space(out);
        writer_register(out, zero);
        writer_space(out);
        writer_register(out, one);
        writer_newline(out);
        return true;
    }
    if (opcode == 19 || opcode == 20) {
        writer_instruction_prefix(out, ip);
        if (opcode == 19) {
            writer_put(out, 97);
            writer_put(out, 110);
            writer_put(out, 100);
        } else {
            writer_put(out, 111);
            writer_put(out, 114);
        }
        writer_space(out);
        writer_i64(out);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 8) {
        i64 target_function = raz_compiler_rt_arena_get(mir.op_a, ip);
        bool void_call = raz_compiler_rt_arena_get(hir.function_returns_value, target_function) == 0;

        if (void_call) {
            writer_async_indent(out);
        } else {
            writer_instruction_prefix(out, ip);
        }
        writer_async_call_text(out);
        if (void_call) {
            writer_void(out);
        } else if (
            raz_compiler_rt_arena_get(hir.function_return_references, target_function) != 0 ||
            raz_compiler_rt_arena_get(hir.function_return_slices, target_function) != 0 ||
            raz_compiler_rt_arena_get(hir.function_return_type_structs, target_function) >= 0
        ) {
            writer_i64(out);
        } else if (raz_compiler_rt_arena_get(hir.function_return_function_types, target_function) >= 0) {
            writer_ptr(out);
        } else {
            writer_scalar_type(out, op_type);
        }
        writer_space(out);
        writer_function_name(out, source, hir, target_function);
        writer_put(out, 40);

        i64 first = raz_compiler_rt_arena_get(mir.op_b, ip);
        i64 count = raz_compiler_rt_arena_get(mir.op_c, ip);
        i64 a = 0;

        while (a < count) {
            if (a > 0) {
                writer_put(out, 44);
                writer_space(out);
            }
            writer_register(out, raz_compiler_rt_arena_get(mir.call_arguments, first + a));
            a += 1;
        }
        writer_put(out, 41);
        writer_newline(out);
        if (void_call) {
            writer_instruction_prefix(out, ip);
            writer_async_const_text(out);
            writer_i64(out);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
        }
        return true;
    }
    if (opcode == 44) {
        writer_instruction_prefix(out, ip);
        writer_put(out, 99);
        // c
        writer_put(out, 97);
        // a
        writer_put(out, 108);
        // l
        writer_put(out, 108);
        // l
        writer_put(out, 46);
        // .
        writer_put(out, 105);
        // i
        writer_put(out, 110);
        // n
        writer_put(out, 100);
        // d
        writer_put(out, 105);
        // i
        writer_put(out, 114);
        // r
        writer_put(out, 101);
        // e
        writer_put(out, 99);
        // c
        writer_put(out, 116);
        // t
        writer_space(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_space(out);
        writer_put(out, 97);
        writer_put(out, 115);
        writer_space(out);
        writer_function_signature_name(out, raz_compiler_rt_arena_get(mir.op_d, ip));
        writer_put(out, 40);

        i64 first = raz_compiler_rt_arena_get(mir.op_b, ip);
        i64 count = raz_compiler_rt_arena_get(mir.op_c, ip);
        i64 argument = 0;

        while (argument < count) {
            if (argument > 0) {
                writer_put(out, 44);
                writer_space(out);
            }
            writer_register(out, raz_compiler_rt_arena_get(mir.call_arguments, first + argument));
            argument += 1;
        }
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 45) {
        writer_instruction_prefix(out, ip);
        writer_async_call_text(out);
        writer_i64(out);
        writer_space(out);
        writer_runtime_name(out, 5);
        writer_put(out, 40);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 47) {
        i64 global_address = writer_synthetic_register(228, ip);

        writer_instruction_prefix(out, global_address);

        i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

        writer_global_address_opcode(out, raz_compiler_rt_arena_get(hir.global_tls_flags, global_index) != 0);
        writer_space(out);
        writer_ptr(out);
        writer_space(out);
        writer_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        writer_instruction_prefix(out, ip);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 97);
        writer_put(out, 100);
        writer_space(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_register(out, global_address);
        writer_newline(out);
        return true;
    }
    if (opcode == 48) {
        i64 global_address = writer_synthetic_register(228, ip);

        writer_instruction_prefix(out, global_address);

        i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

        writer_global_address_opcode(out, raz_compiler_rt_arena_get(hir.global_tls_flags, global_index) != 0);
        writer_space(out);
        writer_ptr(out);
        writer_space(out);
        writer_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        writer_space(out);
        writer_space(out);
        writer_put(out, 115);
        writer_put(out, 116);
        writer_put(out, 111);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_space(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_space(out);
        writer_register(out, global_address);
        writer_newline(out);
        return true;
    }
    if (opcode == 49) {
        writer_instruction_prefix(out, ip);

        i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

        writer_global_address_opcode(out, raz_compiler_rt_arena_get(hir.global_tls_flags, global_index) != 0);
        writer_space(out);
        writer_ptr(out);
        writer_space(out);
        writer_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 46) {
        writer_instruction_prefix(out, ip);
        writer_put(out, 99);
        writer_put(out, 111);
        writer_put(out, 112);
        writer_put(out, 121);
        writer_space(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 9) {
        i64 local_slot = raz_compiler_rt_arena_get(mir.op_a, ip);
        i64 slot_reg = writer_synthetic_register(128, ip);

        writer_async_emit_const_i64(out, slot_reg, local_slot);

        i64 structure = -1;

        if (
            local_slot >= 0 &&
            local_slot < raz_compiler_rt_arena_get(hir.function_local_counts, function_index)
        ) {
            i64 local_index = forge_native_hir_local_index(hir, function_index, local_slot);

            if (local_index >= 0) {
                structure = raz_compiler_rt_arena_get(hir.local_type_structs, local_index);
            }
        }
        if (structure >= 0 && hir_structure_needs_drop(hir, structure, 0)) {
            writer_async_emit_slot_store_owned(
                out,
                source,
                hir,
                structure,
                slot_reg,
                raz_compiler_rt_arena_get(mir.op_b, ip),
            );
        } else {
            writer_async_emit_slot_store(out, slot_reg, raz_compiler_rt_arena_get(mir.op_b, ip));
        }
        writer_instruction_prefix(out, ip);
        writer_put(out, 99);
        writer_put(out, 111);
        writer_put(out, 112);
        writer_put(out, 121);
        writer_space(out);
        writer_i64(out);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 28) {
        writer_instruction_prefix(out, ip);
        writer_async_call_text(out);
        writer_i64(out);
        writer_space(out);
        writer_runtime_name(out, 3);
        writer_put(out, 40);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 29) {
        writer_async_call_void_prefix(out);
        writer_runtime_name(out, 4);
        writer_put(out, 40);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_c, ip));
        writer_put(out, 41);
        writer_newline(out);
        writer_instruction_prefix(out, ip);
        writer_put(out, 99);
        writer_put(out, 111);
        writer_put(out, 112);
        writer_put(out, 121);
        writer_space(out);
        writer_i64(out);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_c, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 30) {
        i64 count_reg = writer_synthetic_register(240, ip);
        i64 aggregate_marker = raz_compiler_rt_arena_get(mir.op_b, ip);
        i64 element_type = raz_compiler_rt_arena_get(mir.op_d, ip);

        writer_async_emit_const_i64(out, count_reg, raz_compiler_rt_arena_get(mir.op_a, ip));
        i64 width_reg = -1;
        i64 width_bytes = 0;
        bool typed_array = aggregate_marker == 2 && primitive_type_width(element_type) > 0 && primitive_type_width(element_type) <= 64;
        if (typed_array) {
            width_reg = writer_synthetic_register(241, ip);
            width_bytes = (primitive_type_width(element_type) + 7) / 8;
            writer_async_emit_const_i64(out, width_reg, width_bytes);
        }
        writer_instruction_prefix(out, ip);
        writer_async_call_text(out);
        writer_i64(out);
        writer_space(out);
        if (typed_array) {
            writer_runtime_name(out, 17);
            writer_put(out, 40);
            writer_register(out, count_reg);
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, width_reg);
            writer_put(out, 41);
        } else {
            writer_runtime_name(out, 1);
            writer_put(out, 40);
            writer_register(out, count_reg);
            writer_put(out, 41);
        }
        writer_newline(out);
        return true;
    }
    if (opcode == 31) {
        i64 storage_reg = raz_compiler_rt_arena_get(mir.op_a, ip);

        if (
            storage_reg >= 0 &&
            storage_reg < mir.instruction_count &&
            raz_compiler_rt_arena_get(mir.opcodes, storage_reg) == 3
        ) {
            i64 slot = raz_compiler_rt_arena_get(mir.op_a, storage_reg);

            if (slot >= 0 && slot < raz_compiler_rt_arena_get(hir.function_local_counts, function_index)) {
                i64 local_index = forge_native_hir_local_index(hir, function_index, slot);
                i64 structure = -1;

                if (local_index >= 0) {
                    structure = raz_compiler_rt_arena_get(hir.local_type_structs, local_index);
                }
                if (structure >= 0 && hir_structure_needs_drop(hir, structure, 0)) {
                    i64 slot_reg = writer_synthetic_register(241, ip);

                    writer_async_emit_const_i64(out, slot_reg, slot);
                    writer_async_emit_slot_disarm(out, slot_reg);
                }
            }
        }
        writer_async_call_void_prefix(out);
        writer_runtime_name(out, 2);
        writer_put(out, 40);
        writer_register(out, storage_reg);
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 32 || opcode == 33) {
        return true;
    }
    if (opcode == 40) {
        writer_instruction_prefix(out, ip);
        writer_numeric_cast_opcode(out, raz_compiler_rt_arena_get(mir.op_b, ip), op_type);
        writer_space(out);
        writer_scalar_type(out, op_type);
        writer_space(out);
        writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        return true;
    }
    return false;
}

fn emit_forge_async_function(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
) -> bool {
    if (!async_mir_supported(hir, mir, function_index)) {
        return false;
    }

    i64 await_count = async_mir_await_count(hir, mir, function_index);
    i64 local_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);
    i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);
    i64 completed_state = await_count + 1;
    i64 cancelled_state = await_count + 2;

    // Public async wrapper.
    writer_space(out);
    writer_space(out);
    writer_keyword_func(out);
    writer_space(out);
    writer_function_name(out, source, hir, function_index);
    writer_put(out, 40);

    i64 p = 0;

    while (p < parameter_count) {
        if (p > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        writer_parameter(out, p);
        writer_put(out, 58);
        writer_space(out);
        writer_i64(out);
        p += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 45);
    writer_put(out, 62);
    writer_space(out);
    writer_i64(out);
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);
    writer_async_entry(out);

    i64 frame_reg = writer_synthetic_register(130, function_index);

    writer_instruction_prefix(out, frame_reg);
    writer_async_call_text(out);

    string ptrtxt = "ptr ";
    i64 pi = 0;

    while (pi < 4) {
        writer_put(out, compiler_literal_byte(ptrtxt, pi));
        pi += 1;
    }
    writer_async_function_name(out, source, hir, function_index, 1);
    writer_put(out, 40);
    p = 0;
    while (p < parameter_count) {
        if (p > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        writer_parameter(out, p);
        p += 1;
    }
    writer_put(out, 41);
    writer_newline(out);

    i64 future_reg = writer_synthetic_register(131, function_index);

    writer_instruction_prefix(out, future_reg);
    writer_async_call_text(out);
    writer_i64(out);
    writer_space(out);
    writer_async_runtime_name(out, 3);
    writer_put(out, 40);
    writer_register(out, frame_reg);
    writer_put(out, 41);
    writer_newline(out);

    i64 poll_reg = writer_synthetic_register(132, function_index);

    writer_instruction_prefix(out, poll_reg);
    writer_async_call_text(out);
    writer_i32(out);
    writer_space(out);
    writer_async_function_name(out, source, hir, function_index, 2);
    writer_put(out, 40);
    writer_register(out, frame_reg);
    writer_put(out, 41);
    writer_newline(out);
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, 14);
    writer_put(out, 40);
    writer_register(out, frame_reg);
    writer_put(out, 41);
    writer_newline(out);
    writer_async_return_prefix(out);
    writer_register(out, future_reg);
    writer_newline(out);
    writer_space(out);
    writer_space(out);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    // Constructor.
    writer_space(out);
    writer_space(out);
    writer_keyword_func(out);
    writer_space(out);
    writer_async_function_name(out, source, hir, function_index, 1);
    writer_put(out, 40);
    p = 0;
    while (p < parameter_count) {
        if (p > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        writer_parameter(out, p);
        writer_put(out, 58);
        writer_space(out);
        writer_i64(out);
        p += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 45);
    writer_put(out, 62);
    writer_space(out);

    string ptrret = "ptr";

    pi = 0;
    while (pi < 3) {
        writer_put(out, compiler_literal_byte(ptrret, pi));
        pi += 1;
    }
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);
    writer_async_entry(out);

    i64 slot_count_reg = writer_synthetic_register(133, function_index);

    writer_async_emit_const_i64(out, slot_count_reg, local_count + parameter_count + await_count);

    i64 new_frame = writer_synthetic_register(134, function_index);

    writer_instruction_prefix(out, new_frame);
    writer_async_call_text(out);
    pi = 0;
    while (pi < 3) {
        writer_put(out, compiler_literal_byte(ptrret, pi));
        pi += 1;
    }
    writer_space(out);
    writer_async_runtime_name(out, 1);
    writer_put(out, 40);
    writer_register(out, slot_count_reg);
    writer_put(out, 41);
    writer_newline(out);

    i64 zero_state = writer_synthetic_register(135, function_index);

    writer_async_emit_const_i32(out, zero_state, 0);
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, 5);
    writer_put(out, 40);
    writer_register(out, new_frame);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, zero_state);
    writer_put(out, 41);
    writer_newline(out);

    i64 poll_addr = writer_synthetic_register(136, function_index);

    writer_instruction_prefix(out, poll_addr);
    writer_async_func_address_text(out);
    writer_async_function_name(out, source, hir, function_index, 2);
    writer_newline(out);
    writer_async_call_void_prefix(out);
    writer_async_runtime_name(out, 2);
    writer_put(out, 40);
    writer_register(out, new_frame);
    writer_put(out, 44);
    writer_space(out);
    writer_register(out, poll_addr);
    writer_put(out, 41);
    writer_newline(out);
    p = 0;
    while (p < parameter_count) {
        i64 slot = writer_synthetic_register(137, p + function_index * 64);

        writer_async_emit_const_i64(out, slot, local_count + p);
        writer_async_call_void_prefix(out);
        writer_async_runtime_name(out, 7);
        writer_put(out, 40);
        writer_register(out, new_frame);
        writer_put(out, 44);
        writer_space(out);
        writer_register(out, slot);
        writer_put(out, 44);
        writer_space(out);
        writer_parameter(out, p);
        writer_put(out, 41);
        writer_newline(out);
        p += 1;
    }
    writer_async_return_prefix(out);
    writer_register(out, new_frame);
    writer_newline(out);
    writer_space(out);
    writer_space(out);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    // Poll function header and dispatch.
    writer_space(out);
    writer_space(out);
    writer_keyword_func(out);
    writer_space(out);
    writer_async_function_name(out, source, hir, function_index, 2);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 58);
    writer_space(out);
    pi = 0;
    while (pi < 3) {
        writer_put(out, compiler_literal_byte(ptrret, pi));
        pi += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 45);
    writer_put(out, 62);
    writer_space(out);
    writer_i32(out);
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);
    writer_async_entry(out);

    i64 state_reg = writer_synthetic_register(138, function_index);

    writer_instruction_prefix(out, state_reg);
    writer_async_call_text(out);
    writer_i32(out);
    writer_space(out);
    writer_async_runtime_name(out, 4);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 41);
    writer_newline(out);
    writer_async_jump_prefix(out);
    writer_async_state_label(out, 0, 4);
    writer_newline(out);

    i64 state = 0;

    while (state <= cancelled_state) {
        writer_space(out);
        writer_space(out);
        writer_async_state_label(out, state, 4);
        writer_put(out, 58);
        writer_newline(out);

        i64 expected = writer_synthetic_register(140 + state * 2, function_index);
        i64 matches = writer_synthetic_register(141 + state * 2, function_index);

        writer_async_emit_const_i32(out, expected, state);
        writer_instruction_prefix(out, matches);
        writer_async_cmp_eq_text(out);
        writer_i32(out);
        writer_space(out);
        writer_register(out, state_reg);
        writer_space(out);
        writer_register(out, expected);
        writer_newline(out);
        writer_async_branch_prefix(out);
        writer_register(out, matches);
        writer_put(out, 44);
        writer_space(out);
        writer_async_state_label(out, state, 0);
        writer_put(out, 44);
        writer_space(out);
        if (state < cancelled_state) {
            writer_async_state_label(out, state + 1, 4);
        } else {
            string inv = "invalid.state";
            i64 ii = 0;

            while (ii < 13) {
                writer_put(out, compiler_literal_byte(inv, ii));
                ii += 1;
            }
        }
        writer_newline(out);
        state += 1;
    }
    writer_async_invalid(out);
    // Entry state checks.
    state = 0;
    while (state <= await_count) {
        writer_space(out);
        writer_space(out);
        writer_async_state_label(out, state, 0);
        writer_put(out, 58);
        writer_newline(out);

        i64 cancelled = writer_synthetic_register(200 + state, function_index);

        writer_instruction_prefix(out, cancelled);
        writer_async_call_text(out);

        string i1txt = "i1 ";

        pi = 0;
        while (pi < 3) {
            writer_put(out, compiler_literal_byte(i1txt, pi));
            pi += 1;
        }
        writer_async_runtime_name(out, 10);
        writer_put(out, 40);
        writer_async_frame_ref(out);
        writer_put(out, 41);
        writer_newline(out);
        writer_async_branch_prefix(out);
        writer_register(out, cancelled);
        writer_put(out, 44);
        writer_space(out);
        writer_async_state_label(out, cancelled_state, 0);
        writer_put(out, 44);
        writer_space(out);
        writer_async_state_label(out, state, 1);
        writer_newline(out);
        state += 1;
    }
    writer_space(out);
    writer_space(out);
    writer_async_state_label(out, completed_state, 0);
    writer_put(out, 58);
    writer_newline(out);

    i64 complete_status = writer_synthetic_register(210, function_index);

    writer_async_emit_const_i32(out, complete_status, 1);
    writer_async_return_prefix(out);
    writer_register(out, complete_status);
    writer_newline(out);
    writer_space(out);
    writer_space(out);
    writer_async_state_label(out, cancelled_state, 0);
    writer_put(out, 58);
    writer_newline(out);
    writer_async_emit_void_call1(out, 11, 0, 1);

    i64 cancel_status = writer_synthetic_register(211, function_index);

    writer_async_emit_const_i32(out, cancel_status, -1);
    writer_async_return_prefix(out);
    writer_register(out, cancel_status);
    writer_newline(out);
    // MIR segments split at await markers.

    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = start + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 segment_state = 0;
    i64 ip = start;
    bool segment_open = false;
    bool block_terminated = false;

    while (ip < end) {
        if (!segment_open) {
            writer_space(out);
            writer_space(out);
            writer_async_state_label(out, segment_state, 1);
            writer_put(out, 58);
            writer_newline(out);
            segment_open = true;
            block_terminated = false;
        }

        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        if (opcode == 24) {
            if (!block_terminated) {
                writer_jump_edge_no_arguments(out, ip);
            }
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            writer_block_name(out, ip);
            if (raz_compiler_rt_arena_get(mir.op_a, ip) != 0) {
                writer_put(out, 40);
                writer_register(out, ip);
                writer_put(out, 58);
                writer_space(out);
                writer_i64(out);
                writer_put(out, 41);
            }
            writer_put(out, 58);
            writer_newline(out);
            block_terminated = false;
        } else if (block_terminated) {} else if (opcode == 42) {
            writer_instruction_prefix(out, ip);
            writer_put(out, 103);
            writer_put(out, 108);
            writer_put(out, 111);
            writer_put(out, 98);
            writer_put(out, 97);
            writer_put(out, 108);
            writer_put(out, 46);
            writer_put(out, 97);
            writer_put(out, 100);
            writer_put(out, 100);
            writer_put(out, 114);
            writer_put(out, 101);
            writer_put(out, 115);
            writer_put(out, 115);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            writer_string_global_name(out, ip);
            writer_newline(out);
        } else if (opcode == 43) {
            writer_instruction_prefix(out, ip);
            writer_put(out, 102);
            writer_put(out, 117);
            writer_put(out, 110);
            writer_put(out, 99);
            writer_put(out, 46);
            writer_put(out, 97);
            writer_put(out, 100);
            writer_put(out, 100);
            writer_put(out, 114);
            writer_put(out, 101);
            writer_put(out, 115);
            writer_put(out, 115);
            writer_space(out);
            writer_ptr(out);
            writer_space(out);

            i64 address_function = raz_compiler_rt_arena_get(mir.op_a, ip);

            writer_function_name(out, source, hir, address_function);
            i64 address_signature_encoded = raz_compiler_rt_arena_get(
                hir.function_pointer_signatures,
                address_function,
            );
            if (address_signature_encoded > 0) {
                writer_space(out);
                writer_put(out, 97);
                writer_put(out, 115);
                writer_space(out);
                writer_function_signature_name(out, address_signature_encoded - 1);
            }
            writer_newline(out);
        } else if (opcode == 22) {
            writer_jump_edge(
                out,
                raz_compiler_rt_arena_get(mir.op_b, ip),
                raz_compiler_rt_arena_get(mir.op_c, ip),
            );
            block_terminated = true;
        } else if (opcode == 23) {
            i64 condition_zero = writer_synthetic_register(234, ip);
            i64 condition_i1 = writer_synthetic_register(235, ip);

            writer_async_emit_const_i64(out, condition_zero, 0);
            writer_instruction_prefix(out, condition_i1);
            writer_compare(out, 12, 0);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_space(out);
            writer_register(out, condition_zero);
            writer_newline(out);

            i64 edge_argument = raz_compiler_rt_arena_get(mir.op_d, ip);

            writer_branch_edge(
                out,
                condition_i1,
                raz_compiler_rt_arena_get(mir.op_c, ip),
                raz_compiler_rt_arena_get(mir.op_b, ip),
                edge_argument,
                edge_argument,
            );
            block_terminated = true;
        } else if (opcode == 41) {
            i64 future = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 future_slot_reg = writer_synthetic_register(220, ip);

            writer_async_emit_const_i64(out, future_slot_reg, local_count + parameter_count + segment_state);
            writer_async_emit_slot_store(out, future_slot_reg, future);

            i64 resume_state_reg = writer_synthetic_register(221, ip);

            writer_async_emit_const_i32(out, resume_state_reg, segment_state + 1);
            writer_async_emit_state_store(out, resume_state_reg);

            i64 poll = writer_synthetic_register(222, ip);

            writer_instruction_prefix(out, poll);
            writer_async_call_text(out);
            writer_i32(out);
            writer_space(out);
            writer_async_runtime_name(out, 12);
            writer_put(out, 40);
            writer_async_frame_ref(out);
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, future);
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, resume_state_reg);
            writer_put(out, 41);
            writer_newline(out);

            i64 ready = writer_synthetic_register(223, ip);

            writer_async_emit_const_i32(out, ready, 1);

            i64 is_ready = writer_synthetic_register(224, ip);

            writer_instruction_prefix(out, is_ready);
            writer_async_cmp_eq_text(out);
            writer_i32(out);
            writer_space(out);
            writer_register(out, poll);
            writer_space(out);
            writer_register(out, ready);
            writer_newline(out);
            writer_async_branch_prefix(out);
            writer_register(out, is_ready);
            writer_put(out, 44);
            writer_space(out);
            writer_async_state_label(out, segment_state + 1, 2);
            writer_put(out, 44);
            writer_space(out);
            writer_async_state_label(out, segment_state + 1, 3);
            writer_newline(out);
            // Re-poll work for next state.  Every resumable block owns its own constants so SSA dominance is explicit.
            writer_space(out);
            writer_space(out);
            writer_async_state_label(out, segment_state + 1, 1);
            writer_put(out, 58);
            writer_newline(out);

            i64 reload_slot = writer_synthetic_register(225, ip);

            writer_async_emit_const_i64(out, reload_slot, local_count + parameter_count + segment_state);

            i64 reload_future = writer_synthetic_register(226, ip);

            writer_async_emit_slot_load(out, reload_future, reload_slot);

            i64 repoll_state = writer_synthetic_register(232, ip);

            writer_async_emit_const_i32(out, repoll_state, segment_state + 1);

            i64 repoll = writer_synthetic_register(227, ip);

            writer_instruction_prefix(out, repoll);
            writer_async_call_text(out);
            writer_i32(out);
            writer_space(out);
            writer_async_runtime_name(out, 12);
            writer_put(out, 40);
            writer_async_frame_ref(out);
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, reload_future);
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, repoll_state);
            writer_put(out, 41);
            writer_newline(out);

            i64 repoll_ready_value = writer_synthetic_register(233, ip);

            writer_async_emit_const_i32(out, repoll_ready_value, 1);

            i64 re_ready = writer_synthetic_register(228, ip);

            writer_instruction_prefix(out, re_ready);
            writer_async_cmp_eq_text(out);
            writer_i32(out);
            writer_space(out);
            writer_register(out, repoll);
            writer_space(out);
            writer_register(out, repoll_ready_value);
            writer_newline(out);
            writer_async_branch_prefix(out);
            writer_register(out, re_ready);
            writer_put(out, 44);
            writer_space(out);
            writer_async_state_label(out, segment_state + 1, 2);
            writer_put(out, 44);
            writer_space(out);
            writer_async_state_label(out, segment_state + 1, 3);
            writer_newline(out);
            // Pending is a fully terminated block.
            writer_space(out);
            writer_space(out);
            writer_async_state_label(out, segment_state + 1, 3);
            writer_put(out, 58);
            writer_newline(out);

            i64 pending = writer_synthetic_register(229, ip);

            writer_async_emit_const_i32(out, pending, 0);
            writer_async_return_prefix(out);
            writer_register(out, pending);
            writer_newline(out);
            // The resumed continuation owns all instructions that follow the await.
            writer_space(out);
            writer_space(out);
            writer_async_state_label(out, segment_state + 1, 2);
            writer_put(out, 58);
            writer_newline(out);
            writer_instruction_prefix(out, ip);
            writer_async_call_text(out);
            writer_i64(out);
            writer_space(out);
            writer_async_runtime_name(out, 13);
            writer_put(out, 40);
            writer_async_frame_ref(out);
            writer_put(out, 41);
            writer_newline(out);
            segment_state += 1;
            segment_open = true;
            block_terminated = false;
        } else if (opcode == 10) {
            i64 result = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 cleanup_local = 0;

            while (cleanup_local < local_count) {
                i64 cleanup_local_index = forge_native_hir_local_index(hir, function_index, cleanup_local);
                i64 cleanup_structure = -1;

                if (cleanup_local_index >= 0) {
                    cleanup_structure = raz_compiler_rt_arena_get(
                        hir.local_type_structs,
                        cleanup_local_index,
                    );
                }
                if (cleanup_structure >= 0 && hir_structure_needs_drop(hir, cleanup_structure, 0)) {
                    i64 cleanup_slot = writer_synthetic_register(242, ip * 64 + cleanup_local);

                    writer_async_emit_const_i64(out, cleanup_slot, cleanup_local);
                    writer_async_emit_slot_disarm(out, cleanup_slot);
                }
                cleanup_local += 1;
            }
            writer_async_call_void_prefix(out);
            writer_async_runtime_name(out, 9);
            writer_put(out, 40);
            writer_async_frame_ref(out);
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, result);
            writer_put(out, 41);
            writer_newline(out);

            i64 done_state_reg = writer_synthetic_register(230, ip);

            writer_async_emit_const_i32(out, done_state_reg, completed_state);
            writer_async_emit_state_store(out, done_state_reg);

            i64 done_status = writer_synthetic_register(231, ip);

            writer_async_emit_const_i32(out, done_status, 1);
            writer_async_return_prefix(out);
            writer_register(out, done_status);
            writer_newline(out);
            segment_open = false;
            block_terminated = true;
        } else {
            if (!emit_async_scalar_instruction(out, source, hir, mir, function_index, ip)) {
                return false;
            }
        }
        ip += 1;
    }
    writer_space(out);
    writer_space(out);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    // Drop function.
    writer_space(out);
    writer_space(out);
    writer_keyword_func(out);
    writer_space(out);
    writer_async_function_name(out, source, hir, function_index, 3);
    writer_put(out, 40);
    writer_async_frame_ref(out);
    writer_put(out, 58);
    writer_space(out);
    pi = 0;
    while (pi < 3) {
        writer_put(out, compiler_literal_byte(ptrret, pi));
        pi += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 45);
    writer_put(out, 62);
    writer_space(out);
    writer_put(out, 118);
    writer_put(out, 111);
    writer_put(out, 105);
    writer_put(out, 100);
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);
    writer_async_entry(out);
    writer_async_emit_void_call1(out, 14, 0, 1);
    writer_async_return_prefix(out);
    writer_newline(out);
    writer_space(out);
    writer_space(out);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    return !out.failed;
}

public fn find_main_function(HirModule& hir, Source& source) -> i64 {
    i64 index = 0;

    while (index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_parameter_counts, index) == 0 &&
            raz_compiler_rt_arena_get(hir.function_name_lengths, index) == 4 &&
            source_byte(source, raz_compiler_rt_arena_get(hir.function_name_offsets, index)) == 109 &&
            source_byte(source, raz_compiler_rt_arena_get(hir.function_name_offsets, index) + 1) == 97 &&
            source_byte(source, raz_compiler_rt_arena_get(hir.function_name_offsets, index) + 2) == 105 &&
            source_byte(source, raz_compiler_rt_arena_get(hir.function_name_offsets, index) + 3) == 110
        ) {
            return index;
        }
        index += 1;
    }
    return -1;
}

fn write_forge_output(ForgeWriter&mut writer, i64 output_path, i64 output_path_length) -> bool {
    i64 written = 0;

    if (output_path != 0 && output_path_length > 0) {
        written = raz_compiler_rt_write_ascii(output_path, output_path_length, writer.data, writer.length);
    } else {
        // intentional-byte-array: raw fallback FIR path for raz_rt_write_ascii_i64.
        i64 path[17] = [115, 116, 97, 103, 101, 49, 45, 111, 117, 116, 112, 117, 116, 46, 102, 105, 114];

        written = raz_rt_write_ascii_i64(&mut path[0], 17, writer.data, writer.length);
    }
    return written == writer.length;
}

fn emit_forge_native_object(
    ForgeWriter&mut writer,
    i64 output_path,
    i64 output_path_length,
    i64 optimization_level,
) -> bool {
    if (output_path == 0 || output_path_length <= 0 || writer.failed || writer.length <= 0) {
        return false;
    }
    // Forge owns its optimizer pipeline and emits the host COFF/ELF object
    // in-process through the compiler bridge. 0..5 map to O0/O1/O2/O3/Os/Oz.
    return raz_compiler_forge_emit_object_i64(
        writer.data,
        writer.length,
        output_path,
        output_path_length,
        optimization_level,
    ) > 0;
}

public fn emit_forge_module(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 output_path,
    i64 output_path_length,
    bool forge_native,
    bool forge_structured_only,
    i64 optimization_level,
) -> bool {
    // Production native Forge compilation must not depend on successfully
    // serializing MIR to the legacy textual FIR grammar. Try the structured
    // C-API path first; textual FIR is retained only as a compatibility fallback
    // for MIR families that have not migrated yet.

    i64 structured_main = find_main_function(hir, source);
    i64 structured_support_code = -1;
    i64 structured_image_pointer_values = raz_compiler_rt_arena_create(mir.instruction_count + 1);

    if (
        structured_image_pointer_values != 0 &&
        forge_native_build_image_pointer_values(hir, mir, structured_image_pointer_values)
    ) {
        structured_support_code = forge_native_support_failure_code_cached(
            hir,
            mir,
            structured_main,
            structured_image_pointer_values,
        );
    }

    if (structured_support_code == 0) {
        bool structured_emitted = emit_forge_native_scalar_module(
            source,
            hir,
            mir,
            structured_main,
            output_path,
            output_path_length,
            optimization_level,
            !forge_native,
            structured_image_pointer_values,
            -1,
            -1,
            true,
        );
        if (structured_image_pointer_values != 0) {
            raz_compiler_rt_arena_destroy(structured_image_pointer_values);
            structured_image_pointer_values = 0;
        }
        // Native compilation has no reason to rebuild the same module through
        // the legacy textual path after structured validation succeeded. Text
        // emission retains the compatibility fallback if serialization fails.
        if (forge_native || structured_emitted) {
            return structured_emitted;
        }
    } else if (structured_image_pointer_values != 0) {
        raz_compiler_rt_arena_destroy(structured_image_pointer_values);
        structured_image_pointer_values = 0;
    }

    if (forge_native && forge_structured_only) {
        forge_native_write_support_diagnostic(source, hir, mir, structured_main);
        return false;
    }

    ForgeWriter writer;

    writer_init(&mut writer);
    writer_put(&mut writer, 109);
    writer_put(&mut writer, 111);
    writer_put(&mut writer, 100);
    writer_put(&mut writer, 117);
    writer_put(&mut writer, 108);
    writer_put(&mut writer, 101);
    writer_space(&mut writer);
    writer_put(&mut writer, 64);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 122);
    writer_put(&mut writer, 95);
    writer_put(&mut writer, 115);
    writer_put(&mut writer, 116);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 103);
    writer_put(&mut writer, 101);
    writer_put(&mut writer, 49);
    writer_space(&mut writer);
    writer_put(&mut writer, 123);
    writer_newline(&mut writer);
    if (!emit_forge_module_globals(&mut writer, source, hir)) {
        writer_destroy(&mut writer);
        return false;
    }
    if (!emit_forge_global_lifecycle(&mut writer, source, hir)) {
        writer_destroy(&mut writer);
        return false;
    }
    emit_forge_string_globals(&mut writer, source, mir);
    emit_forge_function_signatures(&mut writer, hir);
    emit_compiler_runtime_declarations(&mut writer);
    emit_compiler_f64_runtime_declarations(&mut writer);
    emit_stage1_legacy_runtime_declarations(&mut writer);
    emit_compiler_process_runtime_declarations(&mut writer);

    bool has_async = false;
    i64 async_scan = 0;

    while (async_scan < hir.function_count) {
        if (raz_compiler_rt_arena_get(hir.function_is_async, async_scan) != 0) {
            has_async = true;
        }
        async_scan += 1;
    }
    if (has_async) {
        emit_compiler_async_runtime_declarations(&mut writer);
        emit_compiler_async_owned_runtime_declarations(&mut writer);
        emit_compiler_async_future_result_declaration(&mut writer);
    }
    if (has_async) {
        i64 async_cleanup_structure = 0;

        while (async_cleanup_structure < hir.struct_count) {
            if (hir_structure_needs_drop(hir, async_cleanup_structure, 0)) {
                if (
                    !emit_async_structure_cleanup_function(&mut writer, source, hir, async_cleanup_structure)
                ) {
                    return false;
                }
            }
            async_cleanup_structure += 1;
        }
    }

    i64 extern_index = 0;

    while (extern_index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, extern_index) != 0 &&
            !forge_is_builtin_runtime_extern(source, hir, extern_index) &&
            !forge_extern_already_emitted(source, hir, extern_index)
        ) {
            emit_forge_extern_function(&mut writer, source, hir, extern_index);
        }
        extern_index += 1;
    }

    i64 main_index = find_main_function(hir, source);
    i64 reachable_functions = backend_build_function_reachability(hir, mir, main_index);
    if (reachable_functions == 0) { writer_destroy(&mut writer); return false; }
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0 &&
            raz_compiler_rt_arena_get(reachable_functions, function_index) != 0
        ) {
            if (raz_compiler_rt_arena_get(hir.function_is_async, function_index) != 0) {
                if (!emit_forge_async_function(&mut writer, source, hir, mir, function_index)) {
                    return false;
                }
            } else if (!emit_forge_function(&mut writer, source, hir, mir, function_index)) {
                forge_write_emit_failure(source, hir, function_index);
                return false;
            }
        }
        function_index += 1;
    }

    if (main_index < 0 || raz_compiler_rt_arena_get(hir.function_parameter_counts, main_index) != 0) {
        raz_compiler_rt_arena_destroy(reachable_functions);
        return false;
    }
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_keyword_func(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 64);
    writer_put(&mut writer, 95);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 122);
    writer_put(&mut writer, 95);
    writer_put(&mut writer, 101);
    writer_put(&mut writer, 110);
    writer_put(&mut writer, 116);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 121);
    writer_put(&mut writer, 40);
    writer_put(&mut writer, 41);
    writer_space(&mut writer);
    writer_put(&mut writer, 45);
    writer_put(&mut writer, 62);
    writer_space(&mut writer);
    writer_i32(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 123);
    writer_newline(&mut writer);
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 101);
    writer_put(&mut writer, 110);
    writer_put(&mut writer, 116);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 121);
    writer_put(&mut writer, 58);
    writer_newline(&mut writer);
    if (forge_has_aggregate_globals(hir)) {
        writer_async_call_void_prefix(&mut writer);
        writer_put(&mut writer, 64);

        string init_name = "__raz_globals_init";
        i64 name_cursor = 0;

        while (name_cursor < 18) {
            writer_put(&mut writer, compiler_literal_byte(init_name, name_cursor));
            name_cursor += 1;
        }
        writer_put(&mut writer, 40);
        writer_put(&mut writer, 41);
        writer_newline(&mut writer);
    }
    writer_instruction_prefix(&mut writer, 9000);
    writer_put(&mut writer, 99);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 108);
    writer_put(&mut writer, 108);
    writer_space(&mut writer);
    writer_i64(&mut writer);
    writer_space(&mut writer);
    writer_function_name(&mut writer, source, hir, main_index);
    writer_put(&mut writer, 40);
    writer_put(&mut writer, 41);
    writer_newline(&mut writer);
    if (forge_has_aggregate_globals(hir)) {
        writer_async_call_void_prefix(&mut writer);
        writer_put(&mut writer, 64);

        string fini_name = "__raz_globals_fini";
        i64 name_cursor = 0;

        while (name_cursor < 18) {
            writer_put(&mut writer, compiler_literal_byte(fini_name, name_cursor));
            name_cursor += 1;
        }
        writer_put(&mut writer, 40);
        writer_put(&mut writer, 41);
        writer_newline(&mut writer);
    }
    writer_instruction_prefix(&mut writer, 9001);
    writer_put(&mut writer, 116);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 117);
    writer_put(&mut writer, 110);
    writer_put(&mut writer, 99);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 116);
    writer_put(&mut writer, 101);
    writer_space(&mut writer);
    writer_i32(&mut writer);
    writer_space(&mut writer);
    writer_register(&mut writer, 9000);
    writer_newline(&mut writer);
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_keyword_return(&mut writer);
    writer_space(&mut writer);
    writer_register(&mut writer, 9001);
    writer_newline(&mut writer);
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 125);
    writer_newline(&mut writer);
    // Preserve `_raz_entry` as the Raz lifecycle entry and expose a C ABI
    // `main` that delegates to it. This ensures aggregate globals are
    // initialized/finalized for native Forge executables.
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_keyword_func(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 64);
    writer_put(&mut writer, 109);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 105);
    writer_put(&mut writer, 110);
    writer_put(&mut writer, 40);
    writer_put(&mut writer, 41);
    writer_space(&mut writer);
    writer_put(&mut writer, 45);
    writer_put(&mut writer, 62);
    writer_space(&mut writer);
    writer_i32(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 123);
    writer_newline(&mut writer);
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 101);
    writer_put(&mut writer, 110);
    writer_put(&mut writer, 116);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 121);
    writer_put(&mut writer, 58);
    writer_newline(&mut writer);
    writer_instruction_prefix(&mut writer, 9010);
    writer_put(&mut writer, 99);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 108);
    writer_put(&mut writer, 108);
    writer_space(&mut writer);
    writer_i32(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 64);
    writer_put(&mut writer, 95);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 97);
    writer_put(&mut writer, 122);
    writer_put(&mut writer, 95);
    writer_put(&mut writer, 101);
    writer_put(&mut writer, 110);
    writer_put(&mut writer, 116);
    writer_put(&mut writer, 114);
    writer_put(&mut writer, 121);
    writer_put(&mut writer, 40);
    writer_put(&mut writer, 41);
    writer_newline(&mut writer);
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_keyword_return(&mut writer);
    writer_space(&mut writer);
    writer_register(&mut writer, 9010);
    writer_newline(&mut writer);
    writer_space(&mut writer);
    writer_space(&mut writer);
    writer_put(&mut writer, 125);
    writer_newline(&mut writer);
    writer_put(&mut writer, 125);
    writer_newline(&mut writer);
    if (writer.failed) {
        return false;
    }

    raz_compiler_rt_arena_destroy(reachable_functions);
    bool success = write_forge_output(&mut writer, output_path, output_path_length);

    if (success && forge_native) {
        // Structured support was classified once before serialization. If it had
        // been supported, emit_forge_module returned through the direct path
        // above. Reuse that decision here instead of rescanning every function,
        // local, and MIR instruction a second time.
        success = emit_forge_native_object(&mut writer, output_path, output_path_length, optimization_level);
    }
    writer_destroy(&mut writer);
    return success;
}

fn writer_block_name(ForgeWriter&mut out, i64 index) {
    writer_put(out, 98);
    writer_put(out, 98);
    writer_decimal(out, index);
}

fn writer_jump_edge(ForgeWriter&mut out, i64 target, i64 argument) {
    writer_space(out);
    writer_space(out);
    writer_put(out, 106);
    writer_put(out, 117);
    writer_put(out, 109);
    writer_put(out, 112);
    writer_space(out);
    writer_block_name(out, target);
    writer_put(out, 40);
    if (argument >= 0) {
        writer_register(out, argument);
    }
    writer_put(out, 41);
    writer_newline(out);
}

fn writer_jump_edge_no_arguments(ForgeWriter&mut out, i64 target) {
    writer_space(out);
    writer_space(out);
    writer_put(out, 106);
    writer_put(out, 117);
    writer_put(out, 109);
    writer_put(out, 112);
    writer_space(out);
    writer_block_name(out, target);
    writer_put(out, 40);
    writer_put(out, 41);
    writer_newline(out);
}

fn writer_branch_edge(
    ForgeWriter&mut out,
    i64 condition,
    i64 true_target,
    i64 false_target,
    i64 true_argument,
    i64 false_argument,
) {
    writer_space(out);
    writer_space(out);
    writer_put(out, 98);
    writer_put(out, 114);
    writer_put(out, 97);
    writer_put(out, 110);
    writer_put(out, 99);
    writer_put(out, 104);
    writer_space(out);
    writer_register(out, condition);
    writer_put(out, 44);
    writer_space(out);
    writer_block_name(out, true_target);
    writer_put(out, 40);
    if (true_argument >= 0) {
        writer_register(out, true_argument);
    }
    writer_put(out, 41);
    writer_put(out, 44);
    writer_space(out);
    writer_block_name(out, false_target);
    writer_put(out, 40);
    if (false_argument >= 0) {
        writer_register(out, false_argument);
    }
    writer_put(out, 41);
    writer_newline(out);
}

fn writer_branch_edge_no_arguments(ForgeWriter&mut out, i64 condition, i64 true_target, i64 false_target) {
    writer_space(out);
    writer_space(out);
    writer_put(out, 98);
    writer_put(out, 114);
    writer_put(out, 97);
    writer_put(out, 110);
    writer_put(out, 99);
    writer_put(out, 104);
    writer_space(out);
    writer_register(out, condition);
    writer_put(out, 44);
    writer_space(out);
    writer_block_name(out, true_target);
    writer_put(out, 40);
    writer_put(out, 41);
    writer_put(out, 44);
    writer_space(out);
    writer_block_name(out, false_target);
    writer_put(out, 40);
    writer_put(out, 41);
    writer_newline(out);
}


public fn forge_root_package_hash(Source& source, HirModule& hir) -> i64 {
    i64 main_index = find_main_function(hir, source);
    if (main_index < 0) { return -1; }
    i64 module_id = raz_compiler_rt_arena_get(hir.incremental_function_module_ids, main_index);
    i64 index = 0;
    while (index < hir.incremental_module_fingerprint_count) {
        if (raz_compiler_rt_arena_get(hir.incremental_module_ids, index) == module_id) {
            return raz_compiler_rt_arena_get(hir.incremental_module_package_hashes, index);
        }
        index += 1;
    }
    return -1;
}

public fn forge_root_module_id(Source& source, HirModule& hir) -> i64 {
    i64 main_index = find_main_function(hir, source);
    if (main_index < 0 || main_index >= hir.function_count) { return -1; }
    return raz_compiler_rt_arena_get(hir.incremental_function_module_ids, main_index);
}

// Emit one Forge object containing bodies owned by a single package hash.
// Reachable functions from other packages are emitted as declarations so the
// native linker can resolve them from cached sibling package objects. The root
// package alone asks for the Raz entry wrappers.
public fn emit_forge_package_object(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 package_hash,
    bool root_package,
    i64 output_path,
    i64 output_path_length,
    i64 optimization_level,
) -> bool {
    if (package_hash < 0 || output_path == 0 || output_path_length <= 0) { return false; }
    i64 main_index = find_main_function(hir, source);
    if (main_index < 0) { return false; }
    i64 image_pointer_values = raz_compiler_rt_arena_create(mir.instruction_count + 1);
    if (image_pointer_values == 0) { return false; }
    bool prepared = forge_native_build_image_pointer_values(hir, mir, image_pointer_values);
    bool supported = false;
    if (prepared) {
        supported = forge_native_support_failure_code_cached(hir, mir, main_index, image_pointer_values) == 0;
    }
    bool emitted = false;
    if (supported) {
        emitted = emit_forge_native_scalar_module(
            source,
            hir,
            mir,
            main_index,
            output_path,
            output_path_length,
            optimization_level,
            false,
            image_pointer_values,
            package_hash,
            -1,
            root_package,
        );
    }
    raz_compiler_rt_arena_destroy(image_pointer_values);
    return emitted;
}

// Emit one Forge object containing bodies owned by one HIR module inside a
// package.  All other reachable functions remain declarations so sibling
// package/module objects resolve them at link time.
public fn emit_forge_module_object(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 package_hash,
    i64 module_id,
    bool entry_module,
    i64 output_path,
    i64 output_path_length,
    i64 optimization_level,
) -> bool {
    if (package_hash < 0 || module_id < 0 || output_path == 0 || output_path_length <= 0) { return false; }
    i64 main_index = find_main_function(hir, source);
    if (main_index < 0) { return false; }
    i64 image_pointer_values = raz_compiler_rt_arena_create(mir.instruction_count + 1);
    if (image_pointer_values == 0) { return false; }
    bool prepared = forge_native_build_image_pointer_values(hir, mir, image_pointer_values);
    bool supported = false;
    if (prepared) {
        supported = forge_native_support_failure_code_cached(hir, mir, main_index, image_pointer_values) == 0;
    }
    bool emitted = false;
    if (supported) {
        emitted = emit_forge_native_scalar_module(
            source,
            hir,
            mir,
            main_index,
            output_path,
            output_path_length,
            optimization_level,
            false,
            image_pointer_values,
            package_hash,
            module_id,
            entry_module,
        );
    }
    raz_compiler_rt_arena_destroy(image_pointer_values);
    return emitted;
}

// Emit multiple module-owned Forge objects while sharing the expensive
// whole-module support scan and image-pointer analysis.  Each output still
// owns an independent Forge object/session, but immutable analysis of the HIR
// and MIR is performed once for the entire dirty-module batch.
public fn emit_forge_module_object_batch(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 package_hash,
    i64 module_ids,
    i64 entry_flags,
    i64 output_paths,
    i64 output_lengths,
    i64 module_count,
    i64 optimization_level,
) -> bool {
    if (
        package_hash < 0 || module_ids == 0 || entry_flags == 0 ||
        output_paths == 0 || output_lengths == 0 || module_count <= 0
    ) {
        return false;
    }
    i64 main_index = find_main_function(hir, source);
    if (main_index < 0) { return false; }
    i64 image_pointer_values = raz_compiler_rt_arena_create(mir.instruction_count + 1);
    if (image_pointer_values == 0) { return false; }
    bool prepared = forge_native_build_image_pointer_values(hir, mir, image_pointer_values);
    bool supported = false;
    if (prepared) {
        supported = forge_native_support_failure_code_cached(hir, mir, main_index, image_pointer_values) == 0;
    }
    bool emitted = supported;
    i64 index = 0;
    while (emitted && index < module_count) {
        i64 module_id = raz_compiler_rt_arena_get(module_ids, index);
        i64 entry_raw = raz_compiler_rt_arena_get(entry_flags, index);
        i64 output_path = raz_compiler_rt_arena_get(output_paths, index);
        i64 output_length = raz_compiler_rt_arena_get(output_lengths, index);
        if (module_id < 0 || output_path == 0 || output_length <= 0) {
            emitted = false;
        } else {
            emitted = emit_forge_native_scalar_module(
                source,
                hir,
                mir,
                main_index,
                output_path,
                output_length,
                optimization_level,
                false,
                image_pointer_values,
                package_hash,
                module_id,
                entry_raw != 0,
            );
        }
        index += 1;
    }
    raz_compiler_rt_arena_destroy(image_pointer_values);
    return emitted;
}

public fn emit_forge_cfg_qualification() -> bool {
    MirModule mir;

    if (!init_mir(&mut mir)) {
        return false;
    }
    mir.function_count = 1;
    raz_compiler_rt_arena_set(mir.function_instruction_starts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_parameter_counts, 0, 0);
    raz_compiler_rt_arena_set(mir.function_local_counts, 0, 0);

    i64 zero = mir_emit(&mut mir, 1, 0, 0, 0, 0);

    mir_emit(&mut mir, 22, 0, 2, zero, 0);
    mir_emit(&mut mir, 24, 1, 0, 0, 0);

    i64 limit = mir_emit(&mut mir, 1, 5, 0, 0, 0);
    i64 condition = mir_emit(&mut mir, 13, 2, limit, 0, 0);

    mir_emit(&mut mir, 23, condition, 10, 6, 2);
    mir_emit(&mut mir, 24, 1, 0, 0, 0);

    i64 one = mir_emit(&mut mir, 1, 1, 0, 0, 0);
    i64 incremented = mir_emit(&mut mir, 4, 6, one, 0, 0);

    mir_emit(&mut mir, 22, 0, 2, incremented, 0);
    mir_emit(&mut mir, 24, 1, 0, 0, 0);
    mir_emit(&mut mir, 10, 10, 0, 0, 0);
    raz_compiler_rt_arena_set(mir.function_instruction_counts, 0, mir.instruction_count);

    ForgeWriter out;

    writer_init(&mut out);
    writer_put(&mut out, 109);
    writer_put(&mut out, 111);
    writer_put(&mut out, 100);
    writer_put(&mut out, 117);
    writer_put(&mut out, 108);
    writer_put(&mut out, 101);
    writer_space(&mut out);
    writer_put(&mut out, 64);
    writer_put(&mut out, 114);
    writer_put(&mut out, 97);
    writer_put(&mut out, 122);
    writer_put(&mut out, 95);
    writer_put(&mut out, 99);
    writer_put(&mut out, 102);
    writer_put(&mut out, 103);
    writer_space(&mut out);
    writer_put(&mut out, 123);
    writer_newline(&mut out);
    writer_space(&mut out);
    writer_space(&mut out);
    writer_keyword_func(&mut out);
    writer_space(&mut out);
    writer_put(&mut out, 64);
    writer_put(&mut out, 109);
    writer_put(&mut out, 97);
    writer_put(&mut out, 105);
    writer_put(&mut out, 110);
    writer_put(&mut out, 40);
    writer_put(&mut out, 41);
    writer_space(&mut out);
    writer_put(&mut out, 45);
    writer_put(&mut out, 62);
    writer_space(&mut out);
    writer_i64(&mut out);
    writer_space(&mut out);
    writer_put(&mut out, 123);
    writer_newline(&mut out);
    writer_space(&mut out);
    writer_space(&mut out);
    writer_put(&mut out, 101);
    writer_put(&mut out, 110);
    writer_put(&mut out, 116);
    writer_put(&mut out, 114);
    writer_put(&mut out, 121);
    writer_put(&mut out, 58);
    writer_newline(&mut out);

    i64 ip = 0;

    while (ip < mir.instruction_count) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        if (opcode == 24) {
            writer_newline(&mut out);
            writer_space(&mut out);
            writer_space(&mut out);
            writer_block_name(&mut out, ip);
            if (raz_compiler_rt_arena_get(mir.op_a, ip) != 0) {
                writer_put(&mut out, 40);
                writer_register(&mut out, ip);
                writer_put(&mut out, 58);
                writer_space(&mut out);
                writer_i64(&mut out);
                writer_put(&mut out, 41);
            }
            writer_put(&mut out, 58);
            writer_newline(&mut out);
        } else if (opcode == 1) {
            writer_instruction_prefix(&mut out, ip);
            writer_put(&mut out, 99);
            writer_put(&mut out, 111);
            writer_put(&mut out, 110);
            writer_put(&mut out, 115);
            writer_put(&mut out, 116);
            writer_space(&mut out);
            writer_i64(&mut out);
            writer_space(&mut out);
            writer_decimal(&mut out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(&mut out);
        } else if (opcode == 4) {
            writer_instruction_prefix(&mut out, ip);
            writer_operator(&mut out, opcode, 0);
            writer_space(&mut out);
            writer_i64(&mut out);
            writer_space(&mut out);
            writer_register(&mut out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_space(&mut out);
            writer_register(&mut out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_newline(&mut out);
        } else if (opcode == 13) {
            writer_instruction_prefix(&mut out, ip);
            writer_compare(&mut out, opcode, 0);
            writer_space(&mut out);
            writer_i64(&mut out);
            writer_space(&mut out);
            writer_register(&mut out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_space(&mut out);
            writer_register(&mut out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_newline(&mut out);
        } else if (opcode == 22) {
            writer_jump_edge(
                &mut out,
                raz_compiler_rt_arena_get(mir.op_b, ip),
                raz_compiler_rt_arena_get(mir.op_c, ip),
            );
        } else if (opcode == 23) {
            writer_branch_edge(
                &mut out,
                raz_compiler_rt_arena_get(mir.op_a, ip),
                raz_compiler_rt_arena_get(mir.op_c, ip),
                raz_compiler_rt_arena_get(mir.op_b, ip),
                raz_compiler_rt_arena_get(mir.op_d, ip),
                raz_compiler_rt_arena_get(mir.op_d, ip),
            );
        } else if (opcode == 10) {
            writer_space(&mut out);
            writer_space(&mut out);
            writer_keyword_return(&mut out);
            writer_space(&mut out);
            writer_register(&mut out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(&mut out);
        } else {
            destroy_mir(&mut mir);
            writer_destroy(&mut out);
            return false;
        }
        ip += 1;
    }
    writer_space(&mut out);
    writer_space(&mut out);
    writer_put(&mut out, 125);
    writer_newline(&mut out);
    writer_put(&mut out, 125);
    writer_newline(&mut out);

    // intentional-byte-array: raw CFG dump path for raz_rt_write_ascii_i64.
    i64 path[21] = [115, 116, 97, 103, 101, 49, 45, 99, 102, 103, 45, 111, 117, 116, 112, 117, 116, 46, 102, 105, 114];
    i64 written = raz_rt_write_ascii_i64(&mut path[0], 21, out.data, out.length);
    i64 expected = out.length;
    bool success = !out.failed && written == expected;

    writer_destroy(&mut out);
    destroy_mir(&mut mir);
    return success;
}
