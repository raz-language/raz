                // native ptr transient. Convert that transient before ret,
                // matching the Forge backend and the declared function type.
                writer_space(out);
                writer_space(out);
                llvm_temp(out, 303, ip);
                writer_space(out);
                writer_put(out, 61);
                writer_space(out);
                llvm_literal(out, "ptrtoint ptr ");
                llvm_value(out, return_value);
                llvm_literal(out, " to i64");
                writer_newline(out);
