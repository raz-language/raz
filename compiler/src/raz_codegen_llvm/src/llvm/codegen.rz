                writer_space(out);
                writer_space(out);
                llvm_temp(out, 51, ip);
                writer_space(out);
                writer_put(out, 61);
                writer_space(out);
                llvm_literal(out, "inttoptr i64 ");
                llvm_value(out, reference);
                llvm_literal(out, " to ptr");
                writer_newline(out);
                writer_space(out);
                writer_space(out);
                llvm_temp(out, 10, ip);
                writer_space(out);
                writer_put(out, 61);
                writer_space(out);
                llvm_literal(out, "load i64, ptr ");
                llvm_temp(out, 51, ip);
                writer_newline(out);
