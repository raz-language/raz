            i64 return_value = raz_compiler_rt_arena_get(mir.op_a, ip);

            bool raw_pointer_return =
                raz_compiler_rt_arena_get(hir.function_return_references, function_index) >= 2 &&
                return_value >= 0 &&
                return_value < mir.instruction_count &&
                (
                    raz_compiler_rt_arena_get(mir.op_types, return_value) == 12 ||
                    raz_compiler_rt_arena_get(mir.op_types, return_value) == 14
                ) &&
                (
                    raz_compiler_rt_arena_get(mir.opcodes, return_value) == 1 ||
                    raz_compiler_rt_arena_get(mir.opcodes, return_value) == 40 ||
                    raz_compiler_rt_arena_get(mir.opcodes, return_value) == 43
