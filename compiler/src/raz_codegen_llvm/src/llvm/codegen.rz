            llvm_literal(out, labelword);
            writer_put(out, 37);
            llvm_block(out, true_target);
            llvm_literal(out, labelword);
            writer_put(out, 37);
            llvm_block(out, false_target);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 25) {
            // LLVM references use Raz's machine-word ABI while carrying the
