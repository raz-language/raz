            writer_space(out);
            llvm_temp(out, 31, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);
            llvm_literal(out, "icmp ne ");
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_literal(out, "br i1 ");
            llvm_temp(out, 31, ip);

