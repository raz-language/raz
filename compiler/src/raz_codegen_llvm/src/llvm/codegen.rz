            writer_space(out);
            writer_space(out);
            llvm_literal(out, "ret");
            writer_space(out);
            llvm_function_return_type(out, hir, function_index);
            writer_space(out);
            if (raw_pointer_return) {
                llvm_temp(out, 303, ip);
            } else {
                llvm_value(out, return_value);
            }
            writer_newline(out);
            terminated = true;
        } else if (opcode == 21) {
            writer_space(out);
            writer_space(out);

            string ret = "ret void";

            llvm_literal(out, ret);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 22) {
            i64 target = raz_compiler_rt_arena_get(mir.op_b, ip);

            if (target < 0) {
                return false;
            }
            writer_space(out);
            writer_space(out);
            llvm_literal(out, "br label ");
            writer_put(out, 37);
            llvm_block(out, target);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 23) {
            i64 false_target = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 true_target = raz_compiler_rt_arena_get(mir.op_c, ip);

            if (false_target < 0 || true_target < 0) {
