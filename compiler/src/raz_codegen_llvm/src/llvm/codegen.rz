                // Pointer/reference semantic types may already be represented as
                // Raz's canonical machine-word handle (for example a local load
                // or aggregate/slice-derived address). Only native LLVM ptr
                // producers need ptrtoint; word producers store directly.
                llvm_emit_local_store_word(out, local_slot, stored_value);
