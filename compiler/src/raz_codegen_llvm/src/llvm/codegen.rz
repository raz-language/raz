            i64 reference = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 reference_opcode = -1;
            i64 reference_type = 0;

            if (reference >= 0 && reference < mir.instruction_count) {
                reference_opcode = raz_compiler_rt_arena_get(mir.opcodes, reference);
                reference_type = raz_compiler_rt_arena_get(mir.op_types, reference);
            }
            // A semantic pointer/reference is not necessarily represented as an
            // LLVM ptr: borrowed parameters and aggregate references deliberately
            // use Raz's machine-word address ABI. Numeric casts *to* a raw pointer
            // are already native LLVM ptr values and must not be inttoptr'd again.
            bool reference_is_pointer =
                reference_opcode == 40 &&
                (reference_type == 12 || reference_type == 13 || reference_type == 14);
            i64 value = raz_compiler_rt_arena_get(mir.op_b, ip);

            if (reference_is_pointer) {
                i64 value_type = llvm_value_result_type(mir, value);

                writer_space(out);
                writer_space(out);
                llvm_literal(out, "store ");
                llvm_type(out, value_type);
                writer_space(out);
                llvm_value(out, value);
                writer_put(out, 44);
                writer_space(out);
                llvm_literal(out, "ptr ");
                llvm_value(out, reference);
                writer_newline(out);
            } else {
                i64 value_type = llvm_value_result_type(mir, value);
                i64 raw = value;
                if (
                    value_type != 12 &&
                    value_type != 13 &&
                    value_type != 14
                ) {
                    raw = llvm_emit_value_to_raw(out, ip, value, value_type);
                } else if (llvm_value_is_native_pointer(hir, mir, function_index, value)) {
                    raw = llvm_emit_value_to_raw(out, ip, value, value_type);
                }

                writer_space(out);
                writer_space(out);
                llvm_temp(out, 52, ip);
                writer_space(out);
                writer_put(out, 61);
                writer_space(out);
                llvm_literal(out, "inttoptr i64 ");
                llvm_value(out, reference);
                llvm_literal(out, " to ptr");
                writer_newline(out);
                writer_space(out);
                writer_space(out);
                llvm_literal(out, "store i64 ");
                if (raw >= 0) {
                    llvm_value(out, raw);
                } else if (raw == -21) {
                    llvm_temp(out, 21, ip);
                } else {
                    llvm_temp(out, 20, ip);
                }
                writer_put(out, 44);
                writer_space(out);
                llvm_literal(out, "ptr ");
                llvm_temp(out, 52, ip);
                writer_newline(out);
            }
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "add i64 0, 0");
            writer_newline(out);
        } else if (opcode == 28) {
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 41, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);
            llvm_literal(out, "call i64 @raz_rt_stage1_arena_get(i64 ");
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

            string middle = ", i64 ";

            llvm_literal(out, middle);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_put(out, 41);
            writer_newline(out);
            if (type_kind == 12 || type_kind == 13 || type_kind == 14) {
                // Aggregate storage carries pointer-like values as Raz machine-word
                // addresses. Keep the loaded word as i64 until an operation needs
                // to materialize a native LLVM ptr.
                llvm_emit_assignment(out, ip);
                llvm_literal(out, "add i64 ");
                llvm_temp(out, 41, ip);
                llvm_literal(out, ", 0");
                writer_newline(out);
            } else {
                llvm_emit_raw_to_value(out, ip, 41, ip, type_kind);
            }
        } else if (opcode == 29) {
            i64 value = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 value_type = llvm_value_result_type(mir, value);
            i64 raw = value;
            if (value_type != 12 && value_type != 13 && value_type != 14) {
                raw = llvm_emit_value_to_raw(out, ip, value, value_type);
            } else if (llvm_value_is_native_pointer(hir, mir, function_index, value)) {
                raw = llvm_emit_value_to_raw(out, ip, value, value_type);
            }

            writer_space(out);
            writer_space(out);
            llvm_literal(out, "call void @raz_rt_stage1_arena_set(i64 ");
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

            string middle = ", i64 ";

            llvm_literal(out, middle);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            llvm_literal(out, middle);
            if (raw >= 0) {
                llvm_value(out, raw);
            } else if (raw == -21) {
                llvm_temp(out, 21, ip);
            } else {
                llvm_temp(out, 20, ip);
            }
            writer_put(out, 41);
            writer_newline(out);
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "add i64 ");
            if (raw >= 0) {
                llvm_value(out, raw);
            } else if (raw == -21) {
                llvm_temp(out, 21, ip);
            } else {
                llvm_temp(out, 20, ip);
            }
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
        } else if (opcode == 30) {
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "call i64 @raz_rt_stage1_arena_create(i64 ");
            writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 31) {
            writer_space(out);
            writer_space(out);
            llvm_literal(out, "call void @raz_rt_stage1_arena_destroy(i64 ");
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 50) {
            if (!llvm_emit_callable_create(out, hir, mir, function_index, ip)) { return false; }
        } else if (opcode == 51) {
            if (!llvm_emit_callable_invoke(out, hir, mir, function_index, ip)) { return false; }
        } else if (opcode == 52) {
            if (!llvm_emit_callable_clone_or_destroy(out, hir, mir, function_index, ip, true)) { return false; }
        } else if (opcode == 53) {
            if (!llvm_emit_callable_clone_or_destroy(out, hir, mir, function_index, ip, false)) { return false; }
        } else if (opcode == 44) {
            i64 signature = raz_compiler_rt_arena_get(mir.op_d, ip);
            i64 callee = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 argument_start = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 argument_count = raz_compiler_rt_arena_get(mir.op_c, ip);

            if (!llvm_value_is_native_pointer(hir, mir, function_index, callee)) {
                writer_space(out);
                writer_space(out);
                llvm_temp(out, 450, ip);
                writer_space(out);
                writer_put(out, 61);
                writer_space(out);
                llvm_literal(out, "inttoptr i64 ");
                llvm_value(out, callee);
                llvm_literal(out, " to ptr");
                writer_newline(out);
            }

            i64 normalized_argument = 0;

            while (normalized_argument < argument_count) {
                i64 argument_value = raz_compiler_rt_arena_get(
                    mir.call_arguments,
                    argument_start + normalized_argument,
                );
                if (
                    llvm_function_type_parameter_uses_native_pointer(hir, signature, normalized_argument) &&
                    !llvm_value_is_native_pointer(hir, mir, function_index, argument_value)
                ) {
                    writer_space(out);
                    writer_space(out);
                    llvm_temp(out, 460 + normalized_argument, ip);
                    writer_space(out);
                    writer_put(out, 61);
                    writer_space(out);
                    llvm_literal(out, "inttoptr i64 ");
                    llvm_value(out, argument_value);
                    llvm_literal(out, " to ptr");
                    writer_newline(out);
                }
                normalized_argument += 1;
            }
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "call");
            writer_space(out);
            llvm_function_type_return_type(out, hir, signature);
            writer_space(out);
            if (llvm_value_is_native_pointer(hir, mir, function_index, callee)) {
                llvm_value(out, callee);
            } else {
                llvm_temp(out, 450, ip);
            }
            writer_put(out, 40);

            i64 argument = 0;

            while (argument < argument_count) {
                if (argument > 0) {
                    writer_put(out, 44);
                    writer_space(out);
                }
                llvm_function_type_parameter_type(out, hir, signature, argument);
                writer_space(out);

                i64 argument_value = raz_compiler_rt_arena_get(mir.call_arguments, argument_start + argument);

                if (
                    llvm_function_type_parameter_uses_native_pointer(hir, signature, argument) &&
                    !llvm_value_is_native_pointer(hir, mir, function_index, argument_value)
                ) {
                    llvm_temp(out, 460 + argument, ip);
                } else {
                    llvm_value(out, argument_value);
                }
                argument += 1;
            }
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 47) {
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "load ");
            llvm_type(out, type_kind);
            writer_put(out, 44);
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(out);
        } else if (opcode == 48) {
            writer_space(out);
            writer_space(out);
            llvm_literal(out, "store ");
            llvm_type(out, type_kind);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_put(out, 44);
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(out);
        } else if (opcode == 49) {
            llvm_emit_assignment(out, ip);

            string ptrtoint = "ptrtoint";

            llvm_literal(out, ptrtoint);
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
            llvm_literal(out, " to i64");
            writer_newline(out);
        } else if (opcode == 46) {
            // Spawn remains visible as a distinct MIR effect. The source async
            // call already produced the future handle, so the synchronous LLVM
            // lowering preserves that handle exactly like Forge does.
            llvm_emit_assignment(out, ip);
            if (primitive_type_is_float(type_kind)) {
                llvm_literal(out, "fadd ");
                llvm_type(out, type_kind);
                writer_space(out);
                llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_put(out, 44);
                writer_space(out);
                writer_put(out, 48);
                writer_put(out, 46);
                writer_put(out, 48);
            } else {
                llvm_literal(out, "add ");
                llvm_type(out, type_kind);
                writer_space(out);
                llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_put(out, 44);
                writer_space(out);
                writer_decimal(out, 0);
            }
            writer_newline(out);
        } else if (opcode == 45) {
            // Arena element references are genuine aliases. The compiler arena
            // handle is the address of its i64 payload, so LLVM can form the
            // element address directly while keeping Raz references as i64.
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 53, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);
            llvm_literal(out, "inttoptr");
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            llvm_literal(out, " to ptr");
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 54, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);
            llvm_literal(out, "getelementptr");
            writer_space(out);
            writer_i64(out);
            writer_put(out, 44);
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_temp(out, 53, ip);
            llvm_literal(out, ", i64 ");
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_newline(out);
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "ptrtoint");
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_temp(out, 54, ip);
            llvm_literal(out, " to i64");
            writer_newline(out);
        } else if (opcode == 42) {
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "getelementptr ");
            writer_put(out, 91);
            writer_decimal(out, llvm_string_decoded_length(source, mir, ip) + 1);
            llvm_literal(out, " x i8],");
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_string_global_name(out, ip);
            llvm_literal(out, ", i64 0, i64 0");
            writer_newline(out);
        } else if (opcode == 43) {
            llvm_emit_assignment(out, ip);
            llvm_literal(out, "select i1 true,");
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_function_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
            llvm_literal(out, ", ptr null");
            writer_newline(out);
        } else if (opcode == 32 || opcode == 33) {
            // Ownership markers are compile-time MIR effects; LLVM needs no code.
        } else {
            ForgeWriter diagnostic;

            writer_init(&mut diagnostic);
            writer_literal(&mut diagnostic, "error: LLVM backend unsupported MIR opcode ");
            writer_decimal(&mut diagnostic, opcode);
            writer_literal(&mut diagnostic, " at instruction ");
            writer_decimal(&mut diagnostic, ip);
            writer_newline(&mut diagnostic);
            raz_compiler_rt_stdio_write_ascii(2, diagnostic.data, diagnostic.length);
            writer_destroy(&mut diagnostic);
            return false;
        }
        ip += 1;
    }
    if (!terminated) {
        if (raz_compiler_rt_arena_get(hir.function_returns_value, function_index) == 0) {
            writer_space(out);
            writer_space(out);
            llvm_literal(out, "ret void");
            writer_newline(out);
        } else {
            writer_space(out);
            writer_space(out);
            llvm_literal(out, "unreachable");
            writer_newline(out);
        }
    }
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    return !out.failed;
}

fn write_llvm_output(ForgeWriter&mut writer, i64 output_path, i64 output_path_length) -> bool {
    i64 written = 0;

    if (output_path != 0 && output_path_length > 0) {
        written = raz_compiler_rt_write_ascii(output_path, output_path_length, writer.data, writer.length);
    } else {
        // intentional-byte-array: raw fallback output path for raz_rt_write_ascii_i64.

        i64 path[16] = [115, 116, 97, 103, 101, 49, 45, 111, 117, 116, 112, 117, 116, 46, 108, 108];

        written = raz_rt_write_ascii_i64(&mut path[0], 16, writer.data, writer.length);
    }
    return written == writer.length;
}

fn llvm_extern_already_emitted(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 previous = 0;

    while (previous < function_index) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, previous) != 0 &&
            function_native_symbol_same(source, hir, previous, function_index)
        ) {
            return true;
        }
        previous += 1;
    }
    return false;
}

public fn emit_llvm_module(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    LlvmTargetOptions& options,
    i64 output_path,
    i64 output_path_length,
) -> bool {
    if (!llvm_validate_symbol_options(source, hir, options)) {
        return false;
    }

    ForgeWriter writer;

    writer_init(&mut writer);
    llvm_literal(&mut writer, "; Raz LLVM backend - generated IR\n\n\n");
    llvm_emit_target_metadata(&mut writer, options);
    llvm_emit_runtime_declarations(&mut writer);
    if (llvm_mir_has_callable_operations(mir)) {
        llvm_emit_callable_runtime_declarations(&mut writer);
    }
    llvm_emit_module_globals(&mut writer, source, hir);
    llvm_emit_global_lifecycle(&mut writer, source, hir);
    llvm_emit_string_globals(&mut writer, source, mir);

    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0 &&
            !llvm_extern_already_emitted(source, hir, function_index)
        ) {
            llvm_emit_function_header(&mut writer, source, hir, mir, options, function_index, true);
            writer_newline(&mut writer);
        }
        function_index += 1;
    }
    writer_newline(&mut writer);

    i64 structure = 0;

    while (structure < hir.struct_count) {
        if (!llvm_emit_async_structure_cleanup_function(&mut writer, source, hir, structure)) {
            writer_destroy(&mut writer);
            return false;
        }
        structure += 1;
    }

    i64 main_index = find_main_function(hir, source);
    i64 reachable_functions = llvm_build_function_reachability(hir, mir, main_index);

    if (reachable_functions == 0) {
        writer_destroy(&mut writer);
        return false;
    }
    if (!llvm_emit_callable_support_functions(&mut writer, source, hir, mir, reachable_functions)) {
        raz_compiler_rt_arena_destroy(reachable_functions);
        writer_destroy(&mut writer);
        return false;
    }
    function_index = 0;
    while (function_index < hir.function_count) {
        bool explicitly_retained =
            llvm_symbol_list_contains(
                source,
                hir,
                function_index,
                options.export_arg,
                options.export_offset,
                options.export_length
            ) ||
            llvm_symbol_list_contains(
                source,
                hir,
                function_index,
                options.weak_arg,
                options.weak_offset,
                options.weak_length
            ) ||
            llvm_symbol_list_contains(
                source,
                hir,
                function_index,
                options.linkonce_arg,
                options.linkonce_offset,
                options.linkonce_length
            );
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0 &&
            (raz_compiler_rt_arena_get(reachable_functions, function_index) != 0 || explicitly_retained)
        ) {
            if (!llvm_emit_function(&mut writer, source, hir, mir, options, function_index)) {
                llvm_write_emit_failure(source, hir, function_index);
                writer_destroy(&mut writer);
                return false;
            }
        }
        function_index += 1;
    }
    raz_compiler_rt_arena_destroy(reachable_functions);
    if (
        main_index < 0 ||
        raz_compiler_rt_arena_get(hir.function_parameter_counts, main_index) != 0
    ) {
        writer_destroy(&mut writer);
        return false;
    }
    llvm_literal(&mut writer, "define i32 @main() {");
    writer_newline(&mut writer);
    if (llvm_has_aggregate_globals(hir)) {
        llvm_literal(&mut writer, "  call void @__raz_globals_init()\n");
    }

    bool main_returns_value =
        raz_compiler_rt_arena_get(hir.function_returns_value, main_index) != 0;
    if (main_returns_value) {
        llvm_literal(&mut writer, "%razmain = ");
    }
    llvm_literal(&mut writer, "call ");
    llvm_function_return_type(&mut writer, hir, main_index);
    writer_space(&mut writer);
    llvm_function_name(&mut writer, source, hir, main_index);
    writer_put(&mut writer, 40);
    writer_put(&mut writer, 41);
    writer_newline(&mut writer);
    if (llvm_has_aggregate_globals(hir)) {
        llvm_literal(&mut writer, "  call void @__raz_globals_fini()\n");
    }

    if (!main_returns_value) {
        llvm_literal(&mut writer, "  ret i32 0");
    } else {
        i64 main_return_type = raz_compiler_rt_arena_get(hir.function_return_types, main_index);

        if (
            primitive_type_is_float(main_return_type) ||
            main_return_type == 12 ||
            main_return_type == 13 ||
            main_return_type == 14 ||
            hir_type_is_enum(main_return_type)
        ) {
            writer_destroy(&mut writer);
            return false;
        }
        writer_space(&mut writer);
        writer_space(&mut writer);
        llvm_literal(&mut writer, "%exit = ");

        i64 main_width = primitive_type_width(main_return_type);

        if (main_width > 32) {
            llvm_literal(&mut writer, "trunc ");
            llvm_type(&mut writer, main_return_type);
            writer_space(&mut writer);
            llvm_literal(&mut writer, "%razmain");
            llvm_literal(&mut writer, " to i32");
        } else if (main_width < 32) {
            llvm_literal(&mut writer, "zext ");
            llvm_type(&mut writer, main_return_type);
            writer_space(&mut writer);
            llvm_literal(&mut writer, "%razmain");
            llvm_literal(&mut writer, " to i32");
        } else {
            llvm_literal(&mut writer, "add i32 ");
            llvm_literal(&mut writer, "%razmain");
            writer_put(&mut writer, 44);
            writer_space(&mut writer);
            writer_decimal(&mut writer, 0);
        }
        writer_newline(&mut writer);
        llvm_literal(&mut writer, "  ret i32 %exit");
    }
    writer_newline(&mut writer);
    writer_put(&mut writer, 125);
    writer_newline(&mut writer);
    if (writer.failed) {
        writer_destroy(&mut writer);
        return false;
    }

    bool success = write_llvm_output(&mut writer, output_path, output_path_length);

    writer_destroy(&mut writer);
    return success;
}
