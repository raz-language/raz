            string ptrtoint = "ptrtoint";

            llvm_literal(out, ptrtoint);
            writer_space(out);
            llvm_literal(out, "ptr ");
            llvm_local(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            llvm_literal(out, " to i64");
            writer_newline(out);
        } else if (opcode == 26) {
            i64 reference = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 reference_opcode = -1;
            i64 reference_type = 0;

            if (reference >= 0 && reference < mir.instruction_count) {
                reference_opcode = raz_compiler_rt_arena_get(mir.opcodes, reference);
                reference_type = raz_compiler_rt_arena_get(mir.op_types, reference);
            }
            // A semantic pointer/reference is not necessarily represented as an
            // LLVM ptr: borrowed parameters and aggregate references deliberately
            // use Raz's machine-word address ABI. Numeric casts *to* a raw pointer
            // are already native LLVM ptr values and must not be inttoptr'd again.
            bool reference_is_pointer =
                reference_opcode == 40 &&
                (reference_type == 12 || reference_type == 13 || reference_type == 14);
            bool parameter_aggregate_handle =
                reference_opcode == 2 &&
                (
                    raz_compiler_rt_arena_get(mir.op_b, ip) >= 0 ||
                    raz_compiler_rt_arena_get(mir.op_c, ip) >= 0
                );
