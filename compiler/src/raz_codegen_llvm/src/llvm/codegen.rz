                return false;
            }
        } else if (opcode == 8) {
            i64 target = raz_compiler_rt_arena_get(mir.op_a, ip);
            bool returns_value = raz_compiler_rt_arena_get(hir.function_returns_value, target) != 0;
            i64 argument_count = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 argument_start = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 normalized_argument = 0;

            // LLVM's scalar string/function-pointer parameters are native ptr,
            // while Raz locals keep those values in canonical i64 machine-word
            // slots. Normalize word-backed arguments before starting the call so
            // a stored literal can be passed just like a direct literal.
            while (normalized_argument < argument_count) {
                i64 argument_value = raz_compiler_rt_arena_get(
                    mir.call_arguments,
                    argument_start + normalized_argument,
                );
                if (
                    llvm_parameter_uses_native_pointer(hir, target, normalized_argument) &&
                    !llvm_value_is_native_pointer(hir, mir, function_index, argument_value)
                ) {
                    writer_space(out);
                    writer_space(out);
                    llvm_temp(out, 400 + normalized_argument, ip);
                    writer_space(out);
                    writer_put(out, 61);
                    writer_space(out);
                    llvm_literal(out, "inttoptr i64 ");
                    llvm_value(out, argument_value);
                    llvm_literal(out, " to ptr");
                    writer_newline(out);
                }
                normalized_argument += 1;
            }
            if (returns_value) {
                llvm_emit_assignment(out, ip);
            } else {
                writer_space(out);
                writer_space(out);
            }
            llvm_literal(out, "call");
            writer_space(out);
            llvm_function_return_type(out, hir, target);
            writer_space(out);
            llvm_function_name(out, source, hir, target);
            writer_put(out, 40);

            i64 argument = 0;

            while (argument < argument_count) {
                if (argument > 0) {
                    writer_put(out, 44);
                    writer_space(out);
                }
                llvm_parameter_type(out, hir, target, argument);
                writer_space(out);

                i64 argument_value = raz_compiler_rt_arena_get(mir.call_arguments, argument_start + argument);

                if (
                    llvm_parameter_uses_native_pointer(hir, target, argument) &&
                    !llvm_value_is_native_pointer(hir, mir, function_index, argument_value)
                ) {
                    llvm_temp(out, 400 + argument, ip);
                } else {
                    llvm_value(out, argument_value);
                }
                argument += 1;
            }
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 9) {
            i64 local_slot = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 stored_value = raz_compiler_rt_arena_get(mir.op_b, ip);

            if (llvm_value_is_native_pointer(hir, mir, function_index, stored_value)) {
                // MIR locals are canonical machine-word slots even when the
                // producing LLVM value is a native pointer (including erased
                // callable handles). Normalize the physical value at the slot
                // boundary so subsequent loads remain backend-neutral i64s.
                llvm_emit_local_store_native_pointer(out, ip, local_slot, stored_value);
            } else if (
                llvm_local_is_reference(hir, function_index, local_slot) ||
                type_kind == 12 ||
                type_kind == 13 ||
                type_kind == 14
