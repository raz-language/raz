namespace raz_compiler_backend_rxe_verify;

public import raz_compiler_backend_rxe_blocks;

fn rxe_verify_selector_mix(i64 hash, i64 value, i64 prime) -> i64 {
    hash = hash ^ (value & 4294967295);
    return (hash * prime) & 4294967295;
}

fn rxe_verify_callable_selector(RxeModule& module, i64 function_index, i64&mut lo_out, i64&mut hi_out) -> bool {
    if (function_index < 0 || function_index >= module.function_count) {
        return false;
    }

    i64 lo = 2166136261;
    i64 hi = 2246822519;
    i64 start = raz_compiler_rt_arena_get(module.function_signature_starts, function_index);
    i64 count = raz_compiler_rt_arena_get(module.function_argument_counts, function_index);

    lo = rxe_verify_selector_mix(
        lo,
        raz_compiler_rt_arena_get(module.function_name_hashes, function_index),
        16777619
    );
    hi = rxe_verify_selector_mix(
        hi,
        raz_compiler_rt_arena_get(module.function_name_hashes, function_index),
        3266489917
    );
    lo = rxe_verify_selector_mix(
        lo,
        raz_compiler_rt_arena_get(module.function_abi_kinds, function_index),
        16777619
    );
    hi = rxe_verify_selector_mix(
        hi,
        raz_compiler_rt_arena_get(module.function_abi_kinds, function_index),
        3266489917
    );
    lo = rxe_verify_selector_mix(
        lo,
        raz_compiler_rt_arena_get(module.function_return_types, function_index),
        16777619
    );
    lo = rxe_verify_selector_mix(
        lo,
        raz_compiler_rt_arena_get(module.function_return_nested, function_index),
        16777619
    );
    lo = rxe_verify_selector_mix(
        lo,
        raz_compiler_rt_arena_get(module.function_return_flags, function_index),
        16777619
    );
    hi = rxe_verify_selector_mix(
        hi,
        raz_compiler_rt_arena_get(module.function_return_types, function_index),
        3266489917
    );
    hi = rxe_verify_selector_mix(
        hi,
        raz_compiler_rt_arena_get(module.function_return_nested, function_index),
        3266489917
    );
    hi = rxe_verify_selector_mix(
        hi,
        raz_compiler_rt_arena_get(module.function_return_flags, function_index),
        3266489917
    );

    i64 parameter = 0;

    while (parameter < count) {
        i64 index = start + parameter;

        lo = rxe_verify_selector_mix(
            lo,
            raz_compiler_rt_arena_get(module.signature_parameter_types, index),
            16777619
        );
        lo = rxe_verify_selector_mix(
            lo,
            raz_compiler_rt_arena_get(module.signature_parameter_nested, index),
            16777619
        );
        lo = rxe_verify_selector_mix(
            lo,
            raz_compiler_rt_arena_get(module.signature_parameter_extents, index),
            16777619
        );
        lo = rxe_verify_selector_mix(
            lo,
            raz_compiler_rt_arena_get(module.signature_parameter_flags, index),
            16777619
        );
        hi = rxe_verify_selector_mix(
            hi,
            raz_compiler_rt_arena_get(module.signature_parameter_types, index),
            3266489917
        );
        hi = rxe_verify_selector_mix(
            hi,
            raz_compiler_rt_arena_get(module.signature_parameter_nested, index),
            3266489917
        );
        hi = rxe_verify_selector_mix(
            hi,
            raz_compiler_rt_arena_get(module.signature_parameter_extents, index),
            3266489917
        );
        hi = rxe_verify_selector_mix(
            hi,
            raz_compiler_rt_arena_get(module.signature_parameter_flags, index),
            3266489917
        );
        parameter += 1;
    }
    *lo_out = lo;
    *hi_out = hi;
    return true;
}

fn rxe_verify_feature_bitmap(RxeModule& module) -> bool {
    i64 expected = 0;
    i64 i = 0;

    while (i < module.instruction_count) {
        expected = expected | rxe_opcode_feature(raz_compiler_rt_arena_get(module.opcodes, i));
        i += 1;
    }
    return module.feature_flags == expected;
}

fn rxe_verify_fingerprint_mix(i64 hash, i64 value, i64 prime) -> i64 {
    hash = hash ^ (value & 4294967295);
    return (hash * prime) & 4294967295;
}

fn rxe_verify_fingerprint(RxeModule& module) -> bool {
    i64 lo = 2166136261;
    i64 hi = 2246822519;

    lo = rxe_verify_fingerprint_mix(lo, rxe_format_version(), 16777619);
    hi = rxe_verify_fingerprint_mix(hi, rxe_isa_version(), 3266489917);
    lo = rxe_verify_fingerprint_mix(lo, module.feature_flags, 16777619);
    hi = rxe_verify_fingerprint_mix(hi, module.feature_flags, 3266489917);
    lo = rxe_verify_fingerprint_mix(lo, module.function_count, 16777619);
    hi = rxe_verify_fingerprint_mix(hi, module.function_count, 3266489917);
    lo = rxe_verify_fingerprint_mix(lo, module.instruction_count, 16777619);
    hi = rxe_verify_fingerprint_mix(hi, module.instruction_count, 3266489917);
    lo = rxe_verify_fingerprint_mix(lo, module.block_count, 16777619);
    hi = rxe_verify_fingerprint_mix(hi, module.block_count, 3266489917);

    i64 i = 0;

    while (i < module.function_count) {
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_code_starts, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_code_counts, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_frame_slots, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_selector_lo, i),
            16777619
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.function_register_counts, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.function_selector_hi, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.function_abi_kinds, i),
            3266489917
        );
        i += 1;
    }
    i = 0;
    while (i < module.instruction_count) {
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.opcodes, i), 16777619);
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.dst, i), 16777619);
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.src0, i), 16777619);
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.src1, i), 16777619);
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.immediates, i), 16777619);
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.opcodes, i), 3266489917);
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.dst, i), 3266489917);
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.src0, i), 3266489917);
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.src1, i), 3266489917);
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.immediates, i), 3266489917);
        i += 1;
    }
    i = 0;
    while (i < module.constant_count) {
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.constants, i), 16777619);
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.constants, i), 3266489917);
        i += 1;
    }
    i = 0;
    while (i < module.global_count) {
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.global_values, i), 16777619);
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.global_flags, i), 3266489917);
        i += 1;
    }
    i = 0;
    while (i < module.layout_count) {
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.layout_kinds, i), 16777619);
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.layout_slot_counts, i),
            16777619
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.layout_field_starts, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.layout_field_counts, i),
            3266489917
        );
        i += 1;
    }
    i = 0;
    while (i < module.layout_field_count) {
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.layout_field_types, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.layout_field_nested, i),
            16777619
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.layout_field_extents, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.layout_field_flags, i),
            3266489917
        );
        i += 1;
    }
    i = 0;
    while (i < module.signature_parameter_count) {
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.signature_parameter_types, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.signature_parameter_flags, i),
            16777619
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.signature_parameter_nested, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.signature_parameter_extents, i),
            3266489917
        );
        i += 1;
    }
    i = 0;
    while (i < module.function_type_count) {
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_type_signature_starts, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_type_parameter_counts, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_type_return_types, i),
            16777619
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.function_type_return_nested, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.function_type_return_flags, i),
            3266489917
        );
        i += 1;
    }
    i = 0;
    while (i < module.function_type_parameter_count) {
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_type_parameter_types, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.function_type_parameter_flags, i),
            16777619
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.function_type_parameter_nested, i),
            3266489917
        );
        i += 1;
    }
    i = 0;
    while (i < module.block_count) {
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.block_code_starts, i), 16777619);
        lo = rxe_verify_fingerprint_mix(lo, raz_compiler_rt_arena_get(module.block_code_counts, i), 16777619);
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.block_successor0, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.block_successor1, i),
            3266489917
        );
        i += 1;
    }
    i = 0;
    while (i < module.export_count) {
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.export_selector_lo, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.export_function_indices, i),
            16777619
        );
        lo = rxe_verify_fingerprint_mix(
            lo,
            raz_compiler_rt_arena_get(module.export_name_hashes, i),
            16777619
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.export_selector_hi, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(
            hi,
            raz_compiler_rt_arena_get(module.export_abi_kinds, i),
            3266489917
        );
        hi = rxe_verify_fingerprint_mix(hi, raz_compiler_rt_arena_get(module.export_flags, i), 3266489917);
        i += 1;
    }
    return lo == module.module_fingerprint_lo && hi == module.module_fingerprint_hi;
}

fn rxe_verify_module(RxeModule& module) -> bool {
    if (
        module.failed ||
        module.function_count < 0 ||
        module.instruction_count < 0 ||
        module.block_count < 0 ||
        module.block_count > module.instruction_count ||
        module.global_count < 0 ||
        module.layout_count < 0 ||
        module.layout_field_count < 0 ||
        module.signature_parameter_count < 0 ||
        module.function_type_count < 0 ||
        module.function_type_parameter_count < 0 ||
        module.export_count < 0 ||
        module.export_count > module.function_count ||
        module.feature_flags < 0 ||
        module.feature_flags > 63 ||
        module.module_fingerprint_lo < 0 ||
        module.module_fingerprint_lo > 4294967295 ||
        module.module_fingerprint_hi < 0 ||
        module.module_fingerprint_hi > 4294967295
    ) {
        return false;
    }
    if (!rxe_verify_feature_bitmap(module)) {
        return false;
    }

    i64 i = 0;

    while (i < module.instruction_count) {
        i64 opcode = raz_compiler_rt_arena_get(module.opcodes, i);

        if (!rxe_opcode_valid(opcode)) {
            return false;
        }

        i64 d = raz_compiler_rt_arena_get(module.dst, i);
        i64 a = raz_compiler_rt_arena_get(module.src0, i);
        i64 b = raz_compiler_rt_arena_get(module.src1, i);
        i64 imm = raz_compiler_rt_arena_get(module.immediates, i);

        if (
            d < 0 ||
            d >= rxe_register_count() ||
            a < 0 ||
            a >= rxe_register_count() ||
            b < 0 ||
            b >= rxe_register_count()
        ) {
            return false;
        }
        if (opcode == rxe_op_jmp() || opcode == rxe_op_brnz()) {
            if (imm < 0 || imm >= module.instruction_count) {
                return false;
            }
        }
        if (opcode == rxe_op_ldc64() && (imm < 0 || imm >= module.constant_count)) {
            return false;
        }
        if (
            (opcode == rxe_op_call() || opcode == rxe_op_func_ref() || opcode == rxe_op_make_closure()) &&
            (imm < 0 || imm >= module.function_count)
        ) {
            return false;
        }
        if (
            (
                opcode == rxe_op_load_global() ||
                opcode == rxe_op_store_global() ||
                opcode == rxe_op_global_ref() ||
                opcode == rxe_op_string_ref()
            ) &&
            (imm < 0 || imm >= module.global_count)
        ) {
            return false;
        }
        if (
            (opcode == rxe_op_select() || opcode == rxe_op_index_store() || opcode == rxe_op_slice_store()) &&
            (imm < 0 || imm >= rxe_register_count())
        ) {
            return false;
        }
        if (opcode == rxe_op_arg() && (imm < 0 || imm > 255)) {
            return false;
        }
        if (opcode == rxe_op_mem_copy() && (imm < 0 || imm > 65535)) {
            return false;
        }
        if (
            (opcode == rxe_op_call() || opcode == rxe_op_call_indirect() || opcode == rxe_op_call_closure()) &&
            (b < 0 || b > 255)
        ) {
            return false;
        }
        if (
            (opcode == rxe_op_call_indirect() || opcode == rxe_op_call_closure()) &&
            (imm < 0 || imm >= module.function_type_count)
        ) {
            return false;
        }
        if (
            (opcode == rxe_op_call_indirect() || opcode == rxe_op_call_closure()) &&
            b != raz_compiler_rt_arena_get(module.function_type_parameter_counts, imm)
        ) {
            return false;
        }
        if (opcode == rxe_op_make_closure() && (b < 0 || b > 255)) {
            return false;
        }
        if (opcode == rxe_op_call() && b != raz_compiler_rt_arena_get(module.function_argument_counts, imm)) {
            return false;
        }
        if (opcode == rxe_op_alloc()) {
            i64 count = imm & 65535;
            i64 layout_encoded = (imm >> 16) & 65535;

            if (count <= 0 || a < 0 || a > 2) {
                return false;
            }
            if (a == 0) {
                if (layout_encoded != 0) {
                    return false;
                }
            } else if (a == 1) {
                if (layout_encoded == 0) {
                    return false;
                }

                i64 layout = layout_encoded - 1;

                if (layout < 0 || layout >= module.layout_count) {
                    return false;
                }
                if (raz_compiler_rt_arena_get(module.layout_kinds, layout) != 1) {
                    return false;
                }
                if (raz_compiler_rt_arena_get(module.layout_slot_counts, layout) != count) {
                    return false;
                }
            } else {
                // Fixed arrays carry their extent in count. Primitive-element
                // arrays have no nested layout; arrays of structures name the
                // element layout, whose slot count is independent of extent.
                if (layout_encoded != 0) {
                    i64 element_layout = layout_encoded - 1;

                    if (element_layout < 0 || element_layout >= module.layout_count) {
                        return false;
                    }
                    if (raz_compiler_rt_arena_get(module.layout_kinds, element_layout) != 1) {
                        return false;
                    }
                }
            }
        }
        i += 1;
    }

    i64 layout = 0;

    while (layout < module.layout_count) {
        i64 kind = raz_compiler_rt_arena_get(module.layout_kinds, layout);
        i64 first = raz_compiler_rt_arena_get(module.layout_field_starts, layout);
        i64 count = raz_compiler_rt_arena_get(module.layout_field_counts, layout);
        i64 slots = raz_compiler_rt_arena_get(module.layout_slot_counts, layout);

        if (kind != 1 && kind != 2) {
            return false;
        }
        if (slots <= 0 || first < 0 || count < 0 || first + count > module.layout_field_count) {
            return false;
        }
        if (kind == 1 && count != slots) {
            return false;
        }
        if (kind == 2 && count != 0) {
            return false;
        }
        layout += 1;
    }

    i64 field = 0;

    while (field < module.layout_field_count) {
        i64 nested = raz_compiler_rt_arena_get(module.layout_field_nested, field);
        i64 extent = raz_compiler_rt_arena_get(module.layout_field_extents, field);
        i64 flags = raz_compiler_rt_arena_get(module.layout_field_flags, field);

        if (nested < 0 || nested > module.layout_count) {
            return false;
        }
        if (extent < 0 || flags < 0 || flags > 7) {
            return false;
        }
        field += 1;
    }

    i64 signature_function = 0;

    while (signature_function < module.function_count) {
        i64 start = raz_compiler_rt_arena_get(module.function_signature_starts, signature_function);
        i64 count = raz_compiler_rt_arena_get(module.function_argument_counts, signature_function);
        i64 nested = raz_compiler_rt_arena_get(module.function_return_nested, signature_function);
        i64 flags = raz_compiler_rt_arena_get(module.function_return_flags, signature_function);

        if (start < 0 || count < 0 || start + count > module.signature_parameter_count) {
            return false;
        }
        if (nested < 0 || nested > module.layout_count || flags < 0 || flags > 127) {
            return false;
        }
        signature_function += 1;
    }

    i64 signature_parameter = 0;

    while (signature_parameter < module.signature_parameter_count) {
        i64 nested = raz_compiler_rt_arena_get(module.signature_parameter_nested, signature_parameter);
        i64 extent = raz_compiler_rt_arena_get(module.signature_parameter_extents, signature_parameter);
        i64 flags = raz_compiler_rt_arena_get(module.signature_parameter_flags, signature_parameter);

        if (nested < 0 || nested > module.layout_count || extent < 0 || flags < 0 || flags > 63) {
            return false;
        }
        signature_parameter += 1;
    }

    i64 function_type = 0;

    while (function_type < module.function_type_count) {
        i64 start = raz_compiler_rt_arena_get(module.function_type_signature_starts, function_type);
        i64 count = raz_compiler_rt_arena_get(module.function_type_parameter_counts, function_type);
        i64 nested = raz_compiler_rt_arena_get(module.function_type_return_nested, function_type);
        i64 flags = raz_compiler_rt_arena_get(module.function_type_return_flags, function_type);

        if (start < 0 || count < 0 || start + count > module.function_type_parameter_count) {
            return false;
        }
        if (nested < 0 || nested > module.layout_count || flags < 0 || flags > 127) {
            return false;
        }
        function_type += 1;
    }

    i64 function_type_parameter = 0;

    while (function_type_parameter < module.function_type_parameter_count) {
        i64 nested = raz_compiler_rt_arena_get(
            module.function_type_parameter_nested,
            function_type_parameter
        );

        i64 flags = raz_compiler_rt_arena_get(module.function_type_parameter_flags, function_type_parameter);

        if (nested < 0 || nested > module.layout_count || flags < 0 || flags > 31) {
            return false;
        }
        function_type_parameter += 1;
    }

    i64 function_index = 0;
    i64 expected_start = 0;

    while (function_index < module.function_count) {
        i64 start = raz_compiler_rt_arena_get(module.function_code_starts, function_index);
        i64 count = raz_compiler_rt_arena_get(module.function_code_counts, function_index);
        i64 arguments = raz_compiler_rt_arena_get(module.function_argument_counts, function_index);
        i64 registers = raz_compiler_rt_arena_get(module.function_register_counts, function_index);
        i64 frame_slots = raz_compiler_rt_arena_get(module.function_frame_slots, function_index);

        if (start != expected_start || count < 0 || start + count > module.instruction_count) {
            return false;
        }
        if (arguments < 0 || arguments > 255 || frame_slots < 0) {
            return false;
        }
        if (registers < 1 || registers > rxe_register_count()) {
            return false;
        }

        i64 ip = start;
        i64 end = start + count;

        while (ip < end) {
            i64 opcode = raz_compiler_rt_arena_get(module.opcodes, ip);
            i64 imm = raz_compiler_rt_arena_get(module.immediates, ip);

            if ((opcode == rxe_op_jmp() || opcode == rxe_op_brnz()) && (imm < start || imm >= end)) {
                return false;
            }
            if (
                (opcode == rxe_op_load_slot() || opcode == rxe_op_store_slot()) &&
                (imm < 0 || imm >= frame_slots)
            ) {
                return false;
            }
            if (opcode == rxe_op_load_arg() && (imm < 0 || imm >= arguments)) {
                return false;
            }
            ip += 1;
        }
        expected_start = end;
        function_index += 1;
    }
    if (expected_start != module.instruction_count) {
        return false;
    }
    // Verify the canonical basic-block directory independently from its builder.

    i64 expected_block = 0;

    function_index = 0;
    while (function_index < module.function_count) {
        i64 first = raz_compiler_rt_arena_get(module.function_block_starts, function_index);
        i64 count = raz_compiler_rt_arena_get(module.function_block_counts, function_index);
        i64 function_start = raz_compiler_rt_arena_get(module.function_code_starts, function_index);
        i64 function_end = function_start + raz_compiler_rt_arena_get(module.function_code_counts, function_index);

        if (first != expected_block || count < 0 || count > 65535 || first + count > module.block_count) {
            return false;
        }

        i64 expected_code = function_start;
        i64 block = first;

        while (block < first + count) {
            i64 code_start = raz_compiler_rt_arena_get(module.block_code_starts, block);
            i64 code_count = raz_compiler_rt_arena_get(module.block_code_counts, block);
            i64 successor0 = raz_compiler_rt_arena_get(module.block_successor0, block);
            i64 successor1 = raz_compiler_rt_arena_get(module.block_successor1, block);

            if (code_start != expected_code || code_count <= 0 || code_start + code_count > function_end) {
                return false;
            }
            if (
                successor0 < -1 ||
                successor0 >= module.block_count ||
                successor1 < -1 ||
                successor1 >= module.block_count
            ) {
                return false;
            }
            if (successor0 >= 0 && (successor0 < first || successor0 >= first + count)) {
                return false;
            }
            if (successor1 >= 0 && (successor1 < first || successor1 >= first + count)) {
                return false;
            }

            i64 last = code_start + code_count - 1;
            i64 op = raz_compiler_rt_arena_get(module.opcodes, last);

            if (op == rxe_op_jmp()) {
                if (successor0 < 0 || successor1 != -1) {
                    return false;
                }
                if (
                    raz_compiler_rt_arena_get(
                        module.block_code_starts,
                        successor0
                    ) != raz_compiler_rt_arena_get(module.immediates, last)
                ) {
                    return false;
                }
            } else if (op == rxe_op_brnz()) {
                if (successor0 < 0) {
                    return false;
                }
                if (
                    raz_compiler_rt_arena_get(
                        module.block_code_starts,
                        successor0
                    ) != raz_compiler_rt_arena_get(module.immediates, last)
                ) {
                    return false;
                }
                if (block + 1 < first + count) {
                    if (successor1 != block + 1) {
                        return false;
                    }
                } else if (successor1 != -1) {
                    return false;
                }
            } else if (op == rxe_op_ret() || op == rxe_op_ret_void() || op == rxe_op_trap()) {
                if (successor0 != -1 || successor1 != -1) {
                    return false;
                }
            } else {
                if (block + 1 < first + count) {
                    if (successor0 != block + 1 || successor1 != -1) {
                        return false;
                    }
                } else if (successor0 != -1 || successor1 != -1) {
                    return false;
                }
            }
            expected_code = code_start + code_count;
            block += 1;
        }
        if (expected_code != function_end) {
            return false;
        }
        expected_block = first + count;
        function_index += 1;
    }
    if (expected_block != module.block_count) {
        return false;
    }
    i = 0;
    while (i < module.function_count) {
        i64 name_hash = raz_compiler_rt_arena_get(module.function_name_hashes, i);
        i64 abi_kind = raz_compiler_rt_arena_get(module.function_abi_kinds, i);
        i64 expected_lo = 0;
        i64 expected_hi = 0;

        if (name_hash < 0 || name_hash > 4294967295) {
            return false;
        }
        if (abi_kind < 0 || abi_kind > 65535) {
            return false;
        }
        if (!rxe_verify_callable_selector(module, i, &mut expected_lo, &mut expected_hi)) {
            return false;
        }
        if (raz_compiler_rt_arena_get(module.function_selector_lo, i) != expected_lo) {
            return false;
        }
        if (raz_compiler_rt_arena_get(module.function_selector_hi, i) != expected_hi) {
            return false;
        }
        i += 1;
    }

    i64 export_index = 0;
    i64 previous_hi = -1;
    i64 previous_lo = -1;
    i64 previous_function = -1;

    while (export_index < module.export_count) {
        i64 function_index = raz_compiler_rt_arena_get(module.export_function_indices, export_index);
        i64 name_hash = raz_compiler_rt_arena_get(module.export_name_hashes, export_index);
        i64 selector_lo = raz_compiler_rt_arena_get(module.export_selector_lo, export_index);
        i64 selector_hi = raz_compiler_rt_arena_get(module.export_selector_hi, export_index);
        i64 abi_kind = raz_compiler_rt_arena_get(module.export_abi_kinds, export_index);
        i64 flags = raz_compiler_rt_arena_get(module.export_flags, export_index);

        if (function_index < 0 || function_index >= module.function_count) {
            return false;
        }
        if (name_hash != raz_compiler_rt_arena_get(module.function_name_hashes, function_index)) {
            return false;
        }
        if (selector_lo != raz_compiler_rt_arena_get(module.function_selector_lo, function_index)) {
            return false;
        }
        if (selector_hi != raz_compiler_rt_arena_get(module.function_selector_hi, function_index)) {
            return false;
        }
        if (abi_kind != raz_compiler_rt_arena_get(module.function_abi_kinds, function_index)) {
            return false;
        }
        if (selector_lo < 0 || selector_lo > 4294967295 || selector_hi < 0 || selector_hi > 4294967295) {
            return false;
        }
        if (flags < 0 || flags > 65535) {
            return false;
        }
        if (previous_hi > selector_hi) {
            return false;
        }
        if (previous_hi == selector_hi && previous_lo > selector_lo) {
            return false;
        }
        if (previous_hi == selector_hi && previous_lo == selector_lo && previous_function >= function_index) {
            return false;
        }
        // A 64-bit selector collision is rejected rather than made ambiguous.
        if (previous_hi == selector_hi && previous_lo == selector_lo) {
            return false;
        }
        previous_hi = selector_hi;
        previous_lo = selector_lo;
        previous_function = function_index;
        export_index += 1;
    }
    if (!rxe_verify_fingerprint(module)) {
        return false;
    }
    return true;
}
