namespace raz_compiler_backend_rxe_model;

public import raz_compiler_backend_rxe_isa;

public struct RxeModule {
    i64 instruction_count;
    i64 opcodes;
    i64 dst;
    i64 src0;
    i64 src1;
    i64 immediates;
    i64 branch_mir_targets;
    i64 constants;
    i64 constant_count;
    i64 function_count;
    i64 function_code_starts;
    i64 function_code_counts;
    i64 function_frame_slots;
    i64 function_argument_counts;
    i64 function_register_counts;
    i64 block_count;
    i64 function_block_starts;
    i64 function_block_counts;
    i64 block_code_starts;
    i64 block_code_counts;
    i64 block_successor0;
    i64 block_successor1;

    // Stable callable ABI identity retained in RXE v4. Name hashes are FNV-1a
    // over the source spelling; ABI kinds preserve Raz declaration metadata.

    i64 function_name_hashes;
    i64 function_selector_lo;
    i64 function_selector_hi;
    i64 function_abi_kinds;

    // Deterministic public callable table. RXE v5 exports all non-extern
    // Raz functions and carries enough identity for deployment/tooling lookup.

    i64 export_count;
    i64 export_function_indices;
    i64 export_name_hashes;
    i64 export_selector_lo;
    i64 export_selector_hi;
    i64 export_abi_kinds;
    i64 export_flags;

    // Semantic module fingerprint (two independent 32-bit lanes).

    i64 module_fingerprint_lo;
    i64 module_fingerprint_hi;

    // Canonical RXE ISA capability bitmap derived from the final instruction stream.

    i64 feature_flags;

    // Canonical callable signatures. Parameters are flattened in function order
    // so an RXE verifier/runtime never needs HIR to validate indirect calls.

    i64 signature_parameter_count;
    i64 function_signature_starts;
    i64 function_return_types;
    i64 function_return_nested;
    i64 function_return_flags;
    i64 signature_parameter_types;
    i64 signature_parameter_nested;
    i64 signature_parameter_extents;
    i64 signature_parameter_flags;
    i64 function_type_count;
    i64 function_type_parameter_count;
    i64 function_type_signature_starts;
    i64 function_type_parameter_counts;
    i64 function_type_return_types;
    i64 function_type_return_nested;
    i64 function_type_return_flags;
    i64 function_type_parameter_types;
    i64 function_type_parameter_nested;
    i64 function_type_parameter_flags;
    i64 global_count;
    i64 global_values;
    i64 global_flags;

    // Canonical aggregate layout metadata. RXE aggregates are slot images;
    // descriptors make structure shape explicit and independently verifiable.

    i64 layout_count;
    i64 layout_kinds;
    i64 layout_field_starts;
    i64 layout_field_counts;
    i64 layout_slot_counts;
    i64 layout_field_count;
    i64 layout_field_types;
    i64 layout_field_nested;
    i64 layout_field_extents;
    i64 layout_field_flags;
    i64 mir_to_rxe;
    i64 mir_instruction_capacity;
    bool failed;
}

fn rxe_module_init(RxeModule&mut out, HirModule& hir, MirModule& mir) -> bool {
    out.instruction_count = 0;
    out.constant_count = 0;
    out.function_count = mir.function_count;
    out.block_count = 0;
    out.global_count = mir.global_count;
    out.signature_parameter_count = hir.parameter_count;
    out.function_type_count = hir.function_type_count;
    out.export_count = 0;
    out.module_fingerprint_lo = 0;
    out.module_fingerprint_hi = 0;
    out.feature_flags = 0;
    out.function_type_parameter_count = hir.function_type_parameter_count;
    out.layout_count = hir.struct_count + hir.enum_count;
    out.layout_field_count = hir.struct_field_count;
    out.mir_instruction_capacity = mir.instruction_count + 1;
    out.opcodes = raz_compiler_rt_arena_create(1048576);
    out.dst = raz_compiler_rt_arena_create(1048576);
    out.src0 = raz_compiler_rt_arena_create(1048576);
    out.src1 = raz_compiler_rt_arena_create(1048576);
    out.immediates = raz_compiler_rt_arena_create(1048576);
    out.branch_mir_targets = raz_compiler_rt_arena_create(1048576);
    out.constants = raz_compiler_rt_arena_create(262144);
    out.function_code_starts = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_code_counts = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_frame_slots = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_argument_counts = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_register_counts = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_block_starts = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_block_counts = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.block_code_starts = raz_compiler_rt_arena_create(1048576);
    out.block_code_counts = raz_compiler_rt_arena_create(1048576);
    out.block_successor0 = raz_compiler_rt_arena_create(1048576);
    out.block_successor1 = raz_compiler_rt_arena_create(1048576);
    out.function_name_hashes = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_selector_lo = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_selector_hi = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_abi_kinds = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.export_function_indices = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.export_name_hashes = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.export_selector_lo = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.export_selector_hi = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.export_abi_kinds = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.export_flags = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_signature_starts = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_return_types = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_return_nested = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.function_return_flags = raz_compiler_rt_arena_create(mir.function_count + 1);
    out.signature_parameter_types = raz_compiler_rt_arena_create(out.signature_parameter_count + 1);
    out.signature_parameter_nested = raz_compiler_rt_arena_create(out.signature_parameter_count + 1);
    out.signature_parameter_extents = raz_compiler_rt_arena_create(out.signature_parameter_count + 1);
    out.signature_parameter_flags = raz_compiler_rt_arena_create(out.signature_parameter_count + 1);
    out.function_type_signature_starts = raz_compiler_rt_arena_create(out.function_type_count + 1);
    out.function_type_parameter_counts = raz_compiler_rt_arena_create(out.function_type_count + 1);
    out.function_type_return_types = raz_compiler_rt_arena_create(out.function_type_count + 1);
    out.function_type_return_nested = raz_compiler_rt_arena_create(out.function_type_count + 1);
    out.function_type_return_flags = raz_compiler_rt_arena_create(out.function_type_count + 1);
    out.function_type_parameter_types = raz_compiler_rt_arena_create(out.function_type_parameter_count + 1);
    out.function_type_parameter_nested = raz_compiler_rt_arena_create(out.function_type_parameter_count + 1);
    out.function_type_parameter_flags = raz_compiler_rt_arena_create(out.function_type_parameter_count + 1);
    out.global_values = raz_compiler_rt_arena_create(mir.global_count + 1);
    out.global_flags = raz_compiler_rt_arena_create(mir.global_count + 1);
    out.layout_kinds = raz_compiler_rt_arena_create(out.layout_count + 1);
    out.layout_field_starts = raz_compiler_rt_arena_create(out.layout_count + 1);
    out.layout_field_counts = raz_compiler_rt_arena_create(out.layout_count + 1);
    out.layout_slot_counts = raz_compiler_rt_arena_create(out.layout_count + 1);
    out.layout_field_types = raz_compiler_rt_arena_create(out.layout_field_count + 1);
    out.layout_field_nested = raz_compiler_rt_arena_create(out.layout_field_count + 1);
    out.layout_field_extents = raz_compiler_rt_arena_create(out.layout_field_count + 1);
    out.layout_field_flags = raz_compiler_rt_arena_create(out.layout_field_count + 1);
    out.mir_to_rxe = raz_compiler_rt_arena_create(out.mir_instruction_capacity);
    out.failed = (out.opcodes == 0 || out.dst == 0 || out.src0 == 0 || out.src1 == 0 || out.immediates == 0 || out.branch_mir_targets == 0 || out.constants == 0 || out.function_code_starts == 0 || out.function_code_counts == 0 || out.function_frame_slots == 0 || out.function_argument_counts == 0 || out.function_register_counts == 0 || out.function_block_starts == 0 || out.function_block_counts == 0 || out.block_code_starts == 0 || out.block_code_counts == 0 || out.block_successor0 == 0 || out.block_successor1 == 0 || out.function_name_hashes == 0 || out.function_selector_lo == 0 || out.function_selector_hi == 0 || out.function_abi_kinds == 0 || out.export_function_indices == 0 || out.export_name_hashes == 0 || out.export_selector_lo == 0 || out.export_selector_hi == 0 || out.export_abi_kinds == 0 || out.export_flags == 0 || out.function_signature_starts == 0 || out.function_return_types == 0 || out.function_return_nested == 0 || out.function_return_flags == 0 || out.signature_parameter_types == 0 || out.signature_parameter_nested == 0 || out.signature_parameter_extents == 0 || out.signature_parameter_flags == 0 || out.function_type_signature_starts == 0 || out.function_type_parameter_counts == 0 || out.function_type_return_types == 0 || out.function_type_return_nested == 0 || out.function_type_return_flags == 0 || out.function_type_parameter_types == 0 || out.function_type_parameter_nested == 0 || out.function_type_parameter_flags == 0 || out.global_values == 0 || out.global_flags == 0 || out.layout_kinds == 0 || out.layout_field_starts == 0 || out.layout_field_counts == 0 || out.layout_slot_counts == 0 || out.layout_field_types == 0 || out.layout_field_nested == 0 || out.layout_field_extents == 0 || out.layout_field_flags == 0 || out.mir_to_rxe == 0);
    if (!out.failed) {
        i64 function_index = 0;

        while (function_index < mir.function_count) {
            i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);
            i64 return_flags = 0;

            if (raz_compiler_rt_arena_get(hir.function_returns_value, function_index) != 0) {
                return_flags = return_flags | 64;
            }
            if (raz_compiler_rt_arena_get(hir.function_return_references, function_index) != 0) {
                return_flags = return_flags | 1;
            }
            if (raz_compiler_rt_arena_get(hir.function_return_reference_mutable, function_index) != 0) {
                return_flags = return_flags | 2;
            }
            if (raz_compiler_rt_arena_get(hir.function_return_slices, function_index) != 0) {
                return_flags = return_flags | 4;
            }
            if (raz_compiler_rt_arena_get(hir.function_return_slice_mutable, function_index) != 0) {
                return_flags = return_flags | 8;
            }
            if (raz_compiler_rt_arena_get(hir.function_return_function_types, function_index) >= 0) {
                return_flags = return_flags | 16;
            }
            raz_compiler_rt_arena_set(out.function_name_hashes, function_index, 0);
            raz_compiler_rt_arena_set(out.function_selector_lo, function_index, 0);
            raz_compiler_rt_arena_set(out.function_selector_hi, function_index, 0);
            raz_compiler_rt_arena_set(
                out.function_abi_kinds,
                function_index,
                raz_compiler_rt_arena_get(hir.function_abi_kinds, function_index)
            );
            raz_compiler_rt_arena_set(out.function_signature_starts, function_index, parameter_start);
            raz_compiler_rt_arena_set(
                out.function_return_types,
                function_index,
                raz_compiler_rt_arena_get(hir.function_return_types, function_index)
            );
            raz_compiler_rt_arena_set(
                out.function_return_nested,
                function_index,
                raz_compiler_rt_arena_get(hir.function_return_type_structs, function_index) + 1
            );
            raz_compiler_rt_arena_set(out.function_return_flags, function_index, return_flags);
            function_index += 1;
        }

        i64 parameter = 0;

        while (parameter < out.signature_parameter_count) {
            i64 flags = 0;
            i64 extent = raz_compiler_rt_arena_get(hir.parameter_array_extents, parameter);

            if (raz_compiler_rt_arena_get(hir.parameter_references, parameter) != 0) {
                flags = flags | 1;
            }
            if (raz_compiler_rt_arena_get(hir.parameter_reference_mutable, parameter) != 0) {
                flags = flags | 2;
            }
            if (raz_compiler_rt_arena_get(hir.parameter_slices, parameter) != 0) {
                flags = flags | 4;
            }
            if (raz_compiler_rt_arena_get(hir.parameter_slice_mutable, parameter) != 0) {
                flags = flags | 8;
            }
            if (raz_compiler_rt_arena_get(hir.parameter_function_types, parameter) >= 0) {
                flags = flags | 16;
            }
            if (extent >= 0) {
                flags = flags | 32;
            }
            raz_compiler_rt_arena_set(
                out.signature_parameter_types,
                parameter,
                raz_compiler_rt_arena_get(hir.parameter_types, parameter)
            );
            raz_compiler_rt_arena_set(
                out.signature_parameter_nested,
                parameter,
                raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter) + 1
            );
            raz_compiler_rt_arena_set(out.signature_parameter_extents, parameter, extent + 1);
            raz_compiler_rt_arena_set(out.signature_parameter_flags, parameter, flags);
            parameter += 1;
        }

        i64 function_type = 0;

        while (function_type < out.function_type_count) {
            i64 return_flags = 0;

            if (raz_compiler_rt_arena_get(hir.function_type_return_references, function_type) != 0) {
                return_flags = return_flags | 1;
            }
            if (raz_compiler_rt_arena_get(hir.function_type_return_slices, function_type) != 0) {
                return_flags = return_flags | 4;
            }
            if (raz_compiler_rt_arena_get(hir.function_type_return_slice_mutable, function_type) != 0) {
                return_flags = return_flags | 8;
            }
            if (raz_compiler_rt_arena_get(hir.function_type_return_function_types, function_type) >= 0) {
                return_flags = return_flags | 16;
            }
            if (raz_compiler_rt_arena_get(hir.function_type_return_types, function_type) != 0) {
                return_flags = return_flags | 64;
            }
            raz_compiler_rt_arena_set(
                out.function_type_signature_starts,
                function_type,
                raz_compiler_rt_arena_get(hir.function_type_parameter_starts, function_type)
            );
            raz_compiler_rt_arena_set(
                out.function_type_parameter_counts,
                function_type,
                raz_compiler_rt_arena_get(hir.function_type_parameter_counts, function_type)
            );
            raz_compiler_rt_arena_set(
                out.function_type_return_types,
                function_type,
                raz_compiler_rt_arena_get(hir.function_type_return_types, function_type)
            );
            raz_compiler_rt_arena_set(
                out.function_type_return_nested,
                function_type,
                raz_compiler_rt_arena_get(hir.function_type_return_type_structs, function_type) + 1
            );
            raz_compiler_rt_arena_set(out.function_type_return_flags, function_type, return_flags);
            function_type += 1;
        }

        i64 type_parameter = 0;

        while (type_parameter < out.function_type_parameter_count) {
            i64 flags = 0;

            if (raz_compiler_rt_arena_get(hir.function_type_parameter_references, type_parameter) != 0) {
                flags = flags | 1;
            }
            if (raz_compiler_rt_arena_get(hir.function_type_parameter_slices, type_parameter) != 0) {
                flags = flags | 4;
            }
            if (raz_compiler_rt_arena_get(hir.function_type_parameter_slice_mutable, type_parameter) != 0) {
                flags = flags | 8;
            }
            if (raz_compiler_rt_arena_get(hir.function_type_parameter_function_types, type_parameter) >= 0) {
                flags = flags | 16;
            }
            raz_compiler_rt_arena_set(
                out.function_type_parameter_types,
                type_parameter,
                raz_compiler_rt_arena_get(hir.function_type_parameter_types, type_parameter)
            );
            raz_compiler_rt_arena_set(
                out.function_type_parameter_nested,
                type_parameter,
                raz_compiler_rt_arena_get(hir.function_type_parameter_type_structs, type_parameter) + 1
            );
            raz_compiler_rt_arena_set(out.function_type_parameter_flags, type_parameter, flags);
            type_parameter += 1;
        }

        i64 global = 0;

        while (global < mir.global_count) {
            raz_compiler_rt_arena_set(
                out.global_values,
                global,
                raz_compiler_rt_arena_get(mir.global_values, global)
            );
            raz_compiler_rt_arena_set(
                out.global_flags,
                global,
                raz_compiler_rt_arena_get(mir.global_extern_flags, global)
            );
            global += 1;
        }

        i64 structure = 0;

        while (structure < hir.struct_count) {
            i64 first = raz_compiler_rt_arena_get(hir.struct_field_starts, structure);
            i64 count = raz_compiler_rt_arena_get(hir.struct_field_counts, structure);

            raz_compiler_rt_arena_set(out.layout_kinds, structure, 1);
            raz_compiler_rt_arena_set(out.layout_field_starts, structure, first);
            raz_compiler_rt_arena_set(out.layout_field_counts, structure, count);
            raz_compiler_rt_arena_set(out.layout_slot_counts, structure, count);
            structure += 1;
        }

        i64 enumeration = 0;

        while (enumeration < hir.enum_count) {
            i64 layout = hir.struct_count + enumeration;
            i64 member_start = raz_compiler_rt_arena_get(hir.enum_member_starts, enumeration);
            i64 member_count = raz_compiler_rt_arena_get(hir.enum_member_counts, enumeration);
            i64 maximum_payload = 0;
            i64 member = 0;

            while (member < member_count) {
                i64 payloads = raz_compiler_rt_arena_get(
                    hir.enum_member_payload_counts,
                    member_start + member
                );
                if (payloads > maximum_payload) {
                    maximum_payload = payloads;
                }
                member += 1;
            }
            raz_compiler_rt_arena_set(out.layout_kinds, layout, 2);
            raz_compiler_rt_arena_set(out.layout_field_starts, layout, 0);
            raz_compiler_rt_arena_set(out.layout_field_counts, layout, 0);
            raz_compiler_rt_arena_set(out.layout_slot_counts, layout, maximum_payload + 1);
            enumeration += 1;
        }

        i64 field = 0;

        while (field < hir.struct_field_count) {
            i64 flags = 0;

            if (raz_compiler_rt_arena_get(hir.struct_field_references, field) != 0) {
                flags = flags | 1;
            }
            if (raz_compiler_rt_arena_get(hir.struct_field_slices, field) != 0) {
                flags = flags | 2;
            }
            if (raz_compiler_rt_arena_get(hir.struct_field_function_types, field) >= 0) {
                flags = flags | 4;
            }
            raz_compiler_rt_arena_set(
                out.layout_field_types,
                field,
                raz_compiler_rt_arena_get(hir.struct_field_types, field)
            );
            raz_compiler_rt_arena_set(
                out.layout_field_nested,
                field,
                raz_compiler_rt_arena_get(hir.struct_field_type_structs, field) + 1
            );
            raz_compiler_rt_arena_set(
                out.layout_field_extents,
                field,
                raz_compiler_rt_arena_get(hir.struct_field_array_extents, field) + 1
            );
            raz_compiler_rt_arena_set(out.layout_field_flags, field, flags);
            field += 1;
        }

        i64 map = 0;

        while (map < out.mir_instruction_capacity) {
            raz_compiler_rt_arena_set(out.mir_to_rxe, map, -1);
            map += 1;
        }
    }
    return !out.failed;
}

fn rxe_module_destroy(RxeModule&mut out) {
    raz_compiler_rt_arena_destroy(out.opcodes);
    raz_compiler_rt_arena_destroy(out.dst);
    raz_compiler_rt_arena_destroy(out.src0);
    raz_compiler_rt_arena_destroy(out.src1);
    raz_compiler_rt_arena_destroy(out.immediates);
    raz_compiler_rt_arena_destroy(out.branch_mir_targets);
    raz_compiler_rt_arena_destroy(out.constants);
    raz_compiler_rt_arena_destroy(out.function_code_starts);
    raz_compiler_rt_arena_destroy(out.function_code_counts);
    raz_compiler_rt_arena_destroy(out.function_frame_slots);
    raz_compiler_rt_arena_destroy(out.function_argument_counts);
    raz_compiler_rt_arena_destroy(out.function_register_counts);
    raz_compiler_rt_arena_destroy(out.function_block_starts);
    raz_compiler_rt_arena_destroy(out.function_block_counts);
    raz_compiler_rt_arena_destroy(out.block_code_starts);
    raz_compiler_rt_arena_destroy(out.block_code_counts);
    raz_compiler_rt_arena_destroy(out.block_successor0);
    raz_compiler_rt_arena_destroy(out.block_successor1);
    raz_compiler_rt_arena_destroy(out.function_name_hashes);
    raz_compiler_rt_arena_destroy(out.function_selector_lo);
    raz_compiler_rt_arena_destroy(out.function_selector_hi);
    raz_compiler_rt_arena_destroy(out.function_abi_kinds);
    raz_compiler_rt_arena_destroy(out.export_function_indices);
    raz_compiler_rt_arena_destroy(out.export_name_hashes);
    raz_compiler_rt_arena_destroy(out.export_selector_lo);
    raz_compiler_rt_arena_destroy(out.export_selector_hi);
    raz_compiler_rt_arena_destroy(out.export_abi_kinds);
    raz_compiler_rt_arena_destroy(out.export_flags);
    raz_compiler_rt_arena_destroy(out.function_signature_starts);
    raz_compiler_rt_arena_destroy(out.function_return_types);
    raz_compiler_rt_arena_destroy(out.function_return_nested);
    raz_compiler_rt_arena_destroy(out.function_return_flags);
    raz_compiler_rt_arena_destroy(out.signature_parameter_types);
    raz_compiler_rt_arena_destroy(out.signature_parameter_nested);
    raz_compiler_rt_arena_destroy(out.signature_parameter_extents);
    raz_compiler_rt_arena_destroy(out.signature_parameter_flags);
    raz_compiler_rt_arena_destroy(out.function_type_signature_starts);
    raz_compiler_rt_arena_destroy(out.function_type_parameter_counts);
    raz_compiler_rt_arena_destroy(out.function_type_return_types);
    raz_compiler_rt_arena_destroy(out.function_type_return_nested);
    raz_compiler_rt_arena_destroy(out.function_type_return_flags);
    raz_compiler_rt_arena_destroy(out.function_type_parameter_types);
    raz_compiler_rt_arena_destroy(out.function_type_parameter_nested);
    raz_compiler_rt_arena_destroy(out.function_type_parameter_flags);
    raz_compiler_rt_arena_destroy(out.global_values);
    raz_compiler_rt_arena_destroy(out.global_flags);
    raz_compiler_rt_arena_destroy(out.layout_kinds);
    raz_compiler_rt_arena_destroy(out.layout_field_starts);
    raz_compiler_rt_arena_destroy(out.layout_field_counts);
    raz_compiler_rt_arena_destroy(out.layout_slot_counts);
    raz_compiler_rt_arena_destroy(out.layout_field_types);
    raz_compiler_rt_arena_destroy(out.layout_field_nested);
    raz_compiler_rt_arena_destroy(out.layout_field_extents);
    raz_compiler_rt_arena_destroy(out.layout_field_flags);
    raz_compiler_rt_arena_destroy(out.mir_to_rxe);
}

fn rxe_emit(RxeModule&mut out, i64 opcode, i64 dst, i64 src0, i64 src1, i64 immediate) -> i64 {
    if (out.failed || out.instruction_count >= 1048576) {
        out.failed = true;
        return -1;
    }

    i64 index = out.instruction_count;

    out.instruction_count += 1;
    raz_compiler_rt_arena_set(out.opcodes, index, opcode);
    raz_compiler_rt_arena_set(out.dst, index, dst);
    raz_compiler_rt_arena_set(out.src0, index, src0);
    raz_compiler_rt_arena_set(out.src1, index, src1);
    raz_compiler_rt_arena_set(out.immediates, index, immediate);
    raz_compiler_rt_arena_set(out.branch_mir_targets, index, -1);
    return index;
}

fn rxe_constant_i64(RxeModule&mut out, i64 value) -> i64 {
    i64 i = 0;

    while (i < out.constant_count) {
        if (raz_compiler_rt_arena_get(out.constants, i) == value) {
            return i;
        }
        i += 1;
    }
    if (out.constant_count >= 262144) {
        out.failed = true;
        return -1;
    }

    i64 index = out.constant_count;

    raz_compiler_rt_arena_set(out.constants, index, value);
    out.constant_count += 1;
    return index;
}
