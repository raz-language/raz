namespace raz_compiler_backend_rxe_writer;

public import raz_compiler_backend_rxe_reference;

fn rxe_write_u8(ForgeWriter&mut out, i64 value) {
    writer_put(out, value & 255);
}

fn rxe_write_u16(ForgeWriter&mut out, i64 value) {
    rxe_write_u8(out, value);
    rxe_write_u8(out, value >> 8);
}

fn rxe_write_u32(ForgeWriter&mut out, i64 value) {
    rxe_write_u8(out, value);
    rxe_write_u8(out, value >> 8);
    rxe_write_u8(out, value >> 16);
    rxe_write_u8(out, value >> 24);
}

fn rxe_write_u64(ForgeWriter&mut out, i64 value) {
    rxe_write_u32(out, value);
    rxe_write_u32(out, value >> 32);
}

fn rxe_write_module(RxeModule& module, i64 output_path, i64 output_path_length) -> bool {
    ForgeWriter out;

    writer_init(&mut out);

    i64 header_bytes = 104;
    i64 function_bytes = module.function_count * 16;
    i64 code_offset = header_bytes + function_bytes;
    i64 code_bytes = module.instruction_count * 8;
    i64 constant_offset = code_offset + code_bytes;
    i64 constant_bytes = module.constant_count * 8;
    i64 global_offset = constant_offset + constant_bytes;
    i64 global_bytes = module.global_count * 16;
    i64 layout_offset = global_offset + global_bytes;
    i64 layout_bytes = module.layout_count * 16 + module.layout_field_count * 16;
    i64 signature_offset = layout_offset + layout_bytes;

    i64 signature_bytes =
        module.function_count * 32 +
        module.function_type_count * 16 +
        module.signature_parameter_count * 16 +
        module.function_type_parameter_count * 16;
    i64 export_offset = signature_offset + signature_bytes;
    i64 export_bytes = module.export_count * 24;
    i64 block_offset = export_offset + export_bytes;
    i64 block_bytes = module.block_count * 16;

    // RXE v7 uses a 104-byte self-describing header. v6 exposed only the
    // aggregate section byte size; v7 adds independent layout/layout-field
    // counts so an external decoder can split that section without HIR.
    rxe_write_u8(&mut out, 82);
    rxe_write_u8(&mut out, 88);
    rxe_write_u8(&mut out, 69);
    rxe_write_u8(&mut out, 0);
    rxe_write_u16(&mut out, rxe_format_version());
    rxe_write_u16(&mut out, rxe_isa_version());
    rxe_write_u32(&mut out, module.feature_flags);
    rxe_write_u32(&mut out, module.function_count);
    rxe_write_u32(&mut out, module.instruction_count);
    rxe_write_u32(&mut out, module.constant_count);
    rxe_write_u32(&mut out, module.global_count);
    rxe_write_u32(&mut out, header_bytes);
    rxe_write_u32(&mut out, code_offset);
    rxe_write_u32(&mut out, code_bytes);
    rxe_write_u32(&mut out, constant_offset);
    rxe_write_u32(&mut out, constant_bytes);
    rxe_write_u32(&mut out, global_offset);
    rxe_write_u32(&mut out, global_bytes);
    rxe_write_u32(&mut out, layout_offset);
    rxe_write_u32(&mut out, layout_bytes);
    rxe_write_u32(&mut out, signature_offset);
    rxe_write_u32(&mut out, signature_bytes);
    rxe_write_u32(&mut out, module.function_type_count);
    rxe_write_u32(&mut out, module.signature_parameter_count);
    rxe_write_u32(&mut out, module.function_type_parameter_count);
    rxe_write_u32(&mut out, module.module_fingerprint_lo);
    rxe_write_u32(&mut out, module.module_fingerprint_hi);
    rxe_write_u32(&mut out, module.export_count);
    rxe_write_u32(&mut out, module.layout_count);
    rxe_write_u32(&mut out, module.layout_field_count);
    while (out.length < header_bytes) {
        writer_put(&mut out, 0);
    }

    i64 f = 0;

    while (f < module.function_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_code_starts, f));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_code_counts, f));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_frame_slots, f));
        rxe_write_u8(&mut out, raz_compiler_rt_arena_get(module.function_argument_counts, f));
        rxe_write_u8(&mut out, raz_compiler_rt_arena_get(module.function_register_counts, f));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.function_block_counts, f));
        f += 1;
    }

    i64 i = 0;

    while (i < module.instruction_count) {
        rxe_write_u8(&mut out, raz_compiler_rt_arena_get(module.opcodes, i));
        rxe_write_u8(&mut out, raz_compiler_rt_arena_get(module.dst, i));
        rxe_write_u8(&mut out, raz_compiler_rt_arena_get(module.src0, i));
        rxe_write_u8(&mut out, raz_compiler_rt_arena_get(module.src1, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.immediates, i));
        i += 1;
    }
    i = 0;
    while (i < module.constant_count) {
        rxe_write_u64(&mut out, raz_compiler_rt_arena_get(module.constants, i));
        i += 1;
    }
    i = 0;
    while (i < module.global_count) {
        rxe_write_u64(&mut out, raz_compiler_rt_arena_get(module.global_values, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.global_flags, i));
        rxe_write_u32(&mut out, 0);
        i += 1;
    }
    i = 0;
    while (i < module.layout_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_kinds, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_field_starts, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_field_counts, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_slot_counts, i));
        i += 1;
    }
    i = 0;
    while (i < module.layout_field_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_field_types, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_field_nested, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_field_extents, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.layout_field_flags, i));
        i += 1;
    }
    // Direct-function signatures.
    i = 0;
    while (i < module.function_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_signature_starts, i));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.function_argument_counts, i));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.function_return_flags, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_return_types, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_return_nested, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_name_hashes, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_selector_lo, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_selector_hi, i));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.function_abi_kinds, i));
        rxe_write_u16(&mut out, 0);
        i += 1;
    }
    // Interned function-type signatures used by CALL_INDIRECT/CALL_CLOSURE.
    i = 0;
    while (i < module.function_type_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_type_signature_starts, i));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.function_type_parameter_counts, i));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.function_type_return_flags, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_type_return_types, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_type_return_nested, i));
        i += 1;
    }
    // Direct-function parameter descriptors.
    i = 0;
    while (i < module.signature_parameter_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.signature_parameter_types, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.signature_parameter_nested, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.signature_parameter_extents, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.signature_parameter_flags, i));
        i += 1;
    }
    // Function-type parameter descriptors. Extent is reserved as zero because
    // the current Raz function-type model does not carry fixed-array extents.
    i = 0;
    while (i < module.function_type_parameter_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_type_parameter_types, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_type_parameter_nested, i));
        rxe_write_u32(&mut out, 0);
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.function_type_parameter_flags, i));
        i += 1;
    }
    // Deterministic deployment/tooling export table. export_offset is derived as
    // signature_offset + signature_bytes, so no additional header pointer is needed.
    i = 0;
    while (i < module.export_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.export_function_indices, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.export_name_hashes, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.export_selector_lo, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.export_selector_hi, i));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.export_abi_kinds, i));
        rxe_write_u16(&mut out, raz_compiler_rt_arena_get(module.export_flags, i));
        rxe_write_u32(&mut out, 0);
        i += 1;
    }
    // Canonical basic-block directory follows exports. Its offset and total count
    // are derived from prior sections plus per-function block counts.
    i = 0;
    while (i < module.block_count) {
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.block_code_starts, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.block_code_counts, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.block_successor0, i));
        rxe_write_u32(&mut out, raz_compiler_rt_arena_get(module.block_successor1, i));
        i += 1;
    }
    if (out.length != block_offset + block_bytes) {
        writer_destroy(&mut out);
        return false;
    }

    i64 written = raz_compiler_rt_write_ascii(output_path, output_path_length, out.data, out.length);
    bool ok = !out.failed && written == out.length;

    writer_destroy(&mut out);
    return ok;
}
