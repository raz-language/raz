namespace raz_compiler_backend_rxe_reference;

public import raz_compiler_backend_rxe_disasm;

// Canonical RXE reference executor used by compiler differential tests. This is
// deliberately a clarity-first semantic oracle, not the production blockchain
// VM. Handles are tagged integers so no host pointer can enter RXE semantics.
public struct RxeReferenceState {
    i64 heap_values;
    i64 heap_owner;
    i64 heap_lengths;
    i64 heap_alive;
    i64 heap_next;
    i64 closure_functions;
    i64 closure_capture_starts;
    i64 closure_capture_counts;
    i64 closure_values;
    i64 closure_count;
    i64 closure_value_count;
}

fn rxe_ref_global_base() -> i64 {
    return 562949953421312;
}

fn rxe_ref_heap_base() -> i64 {
    return 844424930131968;
}

fn rxe_ref_closure_base() -> i64 {
    return 1125899906842624;
}

fn rxe_ref_tag_span() -> i64 {
    return 281474976710656;
}

fn rxe_reference_heap_capacity() -> i64 {
    return 1048576;
}

fn rxe_reference_closure_capacity() -> i64 {
    return 65536;
}

fn rxe_reference_capture_capacity() -> i64 {
    return 262144;
}

fn rxe_reference_state_init(RxeReferenceState&mut state) -> bool {
    state.heap_values = raz_compiler_rt_arena_create(rxe_reference_heap_capacity());
    state.heap_owner = raz_compiler_rt_arena_create(rxe_reference_heap_capacity());
    state.heap_lengths = raz_compiler_rt_arena_create(rxe_reference_heap_capacity());
    state.heap_alive = raz_compiler_rt_arena_create(rxe_reference_heap_capacity());
    state.closure_functions = raz_compiler_rt_arena_create(rxe_reference_closure_capacity());
    state.closure_capture_starts = raz_compiler_rt_arena_create(rxe_reference_closure_capacity());
    state.closure_capture_counts = raz_compiler_rt_arena_create(rxe_reference_closure_capacity());
    state.closure_values = raz_compiler_rt_arena_create(rxe_reference_capture_capacity());
    state.heap_next = 0;
    state.closure_count = 0;
    state.closure_value_count = 0;
    if (
        state.heap_values == 0 ||
        state.heap_owner == 0 ||
        state.heap_lengths == 0 ||
        state.heap_alive == 0 ||
        state.closure_functions == 0 ||
        state.closure_capture_starts == 0 ||
        state.closure_capture_counts == 0 ||
        state.closure_values == 0
    ) {
        return false;
    }
    return true;
}

fn rxe_reference_state_destroy(RxeReferenceState&mut state) {
    if (state.heap_values != 0) {
        raz_compiler_rt_arena_destroy(state.heap_values);
    }
    if (state.heap_owner != 0) {
        raz_compiler_rt_arena_destroy(state.heap_owner);
    }
    if (state.heap_lengths != 0) {
        raz_compiler_rt_arena_destroy(state.heap_lengths);
    }
    if (state.heap_alive != 0) {
        raz_compiler_rt_arena_destroy(state.heap_alive);
    }
    if (state.closure_functions != 0) {
        raz_compiler_rt_arena_destroy(state.closure_functions);
    }
    if (state.closure_capture_starts != 0) {
        raz_compiler_rt_arena_destroy(state.closure_capture_starts);
    }
    if (state.closure_capture_counts != 0) {
        raz_compiler_rt_arena_destroy(state.closure_capture_counts);
    }
    if (state.closure_values != 0) {
        raz_compiler_rt_arena_destroy(state.closure_values);
    }
}

fn rxe_reference_i64_min() -> i64 {
    return -9223372036854775807 - 1;
}

fn rxe_reference_unsigned_less(i64 a, i64 b) -> bool {
    bool an = a < 0;
    bool bn = b < 0;

    if (an != bn) {
        return !an;
    }
    return a < b;
}

fn rxe_reference_unsigned_less_equal(i64 a, i64 b) -> bool {
    return a == b || rxe_reference_unsigned_less(a, b);
}

fn rxe_reference_logical_shr(i64 value, i64 shift) -> i64 {
    i64 count = shift & 63;
    i64 out = value;

    while (count > 0) {
        out = (out >> 1) & 9223372036854775807;
        count -= 1;
    }
    return out;
}

fn rxe_reference_bit(i64 bit) -> i64 {
    if (bit == 63) {
        return rxe_reference_i64_min();
    }
    return 1 << bit;
}

fn rxe_reference_unsigned_divrem(i64 numerator, i64 denominator, bool want_remainder, i64&mut out) -> bool {
    if (denominator == 0) {
        return false;
    }

    i64 quotient = 0;
    i64 remainder = 0;
    i64 bit = 63;

    while (bit >= 0) {
        remainder = (remainder << 1) | (rxe_reference_logical_shr(numerator, bit) & 1);
        if (!rxe_reference_unsigned_less(remainder, denominator)) {
            remainder = remainder - denominator;
            quotient = quotient | rxe_reference_bit(bit);
        }
        bit -= 1;
    }
    if (want_remainder) {
        *out = remainder;
    } else {
        *out = quotient;
    }
    return true;
}

fn rxe_reference_heap_cell(RxeReferenceState& state, i64 handle, i64&mut cell) -> bool {
    if (handle < rxe_ref_heap_base() || handle >= rxe_ref_heap_base() + rxe_ref_tag_span()) {
        return false;
    }

    i64 index = handle - rxe_ref_heap_base();

    if (index < 0 || index >= state.heap_next) {
        return false;
    }

    i64 owner = raz_compiler_rt_arena_get(state.heap_owner, index);

    if (owner < 0 || owner >= state.heap_next || raz_compiler_rt_arena_get(state.heap_alive, owner) == 0) {
        return false;
    }

    i64 length = raz_compiler_rt_arena_get(state.heap_lengths, owner);

    if (index < owner || index >= owner + length) {
        return false;
    }
    *cell = index;
    return true;
}

fn rxe_reference_heap_index(RxeReferenceState& state, i64 handle, i64 offset, i64&mut cell) -> bool {
    i64 base_cell = 0;

    if (!rxe_reference_heap_cell(state, handle, &mut base_cell)) {
        return false;
    }

    i64 owner = raz_compiler_rt_arena_get(state.heap_owner, base_cell);
    i64 length = raz_compiler_rt_arena_get(state.heap_lengths, owner);
    i64 target = base_cell + offset;

    if (offset < 0 || target < owner || target >= owner + length) {
        return false;
    }
    *cell = target;
    return true;
}

fn rxe_reference_alloc(RxeReferenceState&mut state, i64 count, i64&mut handle) -> bool {
    if (count <= 0 || state.heap_next + count > rxe_reference_heap_capacity()) {
        return false;
    }

    i64 base = state.heap_next;
    i64 i = 0;

    while (i < count) {
        raz_compiler_rt_arena_set(state.heap_values, base + i, 0);
        raz_compiler_rt_arena_set(state.heap_owner, base + i, base);
        i += 1;
    }
    raz_compiler_rt_arena_set(state.heap_lengths, base, count);
    raz_compiler_rt_arena_set(state.heap_alive, base, 1);
    state.heap_next += count;
    *handle = rxe_ref_heap_base() + base;
    return true;
}

fn rxe_reference_slice_element(RxeReferenceState& state, i64 slice, i64 index, i64&mut element, ) -> bool {
    if (index < 0) {
        return false;
    }

    i64 slice_cell = 0;

    if (!rxe_reference_heap_cell(state, slice, &mut slice_cell)) {
        return false;
    }

    i64 owner = raz_compiler_rt_arena_get(state.heap_owner, slice_cell);
    i64 length = raz_compiler_rt_arena_get(state.heap_lengths, owner);

    if (slice_cell + 1 >= owner + length) {
        return false;
    }

    i64 data = raz_compiler_rt_arena_get(state.heap_values, slice_cell);
    i64 extent = raz_compiler_rt_arena_get(state.heap_values, slice_cell + 1);

    if (extent < 0 || index >= extent) {
        return false;
    }
    return rxe_reference_heap_index(state, data, index, element);
}

fn rxe_reference_mem_copy(RxeReferenceState&mut state, i64 destination, i64 source, i64 count) -> bool {
    if (count < 0) {
        return false;
    }
    if (count == 0) {
        return true;
    }

    i64 destination_cell = 0;
    i64 source_cell = 0;

    if (!rxe_reference_heap_index(state, destination, count - 1, &mut destination_cell)) {
        return false;
    }
    if (!rxe_reference_heap_index(state, source, count - 1, &mut source_cell)) {
        return false;
    }
    if (!rxe_reference_heap_cell(state, destination, &mut destination_cell)) {
        return false;
    }
    if (!rxe_reference_heap_cell(state, source, &mut source_cell)) {
        return false;
    }
    if (destination_cell > source_cell && destination_cell < source_cell + count) {
        i64 i = count;

        while (i > 0) {
            i -= 1;
            raz_compiler_rt_arena_set(
                state.heap_values,
                destination_cell + i,
                raz_compiler_rt_arena_get(state.heap_values, source_cell + i),
            );
        }
    } else {
        i64 i = 0;

        while (i < count) {
            raz_compiler_rt_arena_set(
                state.heap_values,
                destination_cell + i,
                raz_compiler_rt_arena_get(state.heap_values, source_cell + i),
            );
            i += 1;
        }
    }
    return true;
}

fn rxe_reference_free(RxeReferenceState&mut state, i64 handle) -> bool {
    i64 cell = 0;

    if (!rxe_reference_heap_cell(state, handle, &mut cell)) {
        return false;
    }

    i64 owner = raz_compiler_rt_arena_get(state.heap_owner, cell);

    if (cell != owner) {
        return false;
    }
    raz_compiler_rt_arena_set(state.heap_alive, owner, 0);
    return true;
}

fn rxe_reference_load_ref(RxeModule&mut module, RxeReferenceState& state, i64 handle, i64&mut value) -> bool {
    if (handle >= rxe_ref_global_base() && handle < rxe_ref_global_base() + rxe_ref_tag_span()) {
        i64 index = handle - rxe_ref_global_base();

        if (index < 0 || index >= module.global_count) {
            return false;
        }
        *value = raz_compiler_rt_arena_get(module.global_values, index);
        return true;
    }

    i64 cell = 0;

    if (!rxe_reference_heap_cell(state, handle, &mut cell)) {
        return false;
    }
    *value = raz_compiler_rt_arena_get(state.heap_values, cell);
    return true;
}

fn rxe_reference_store_ref(RxeModule&mut module, RxeReferenceState&mut state, i64 handle, i64 value) -> bool {
    if (handle >= rxe_ref_global_base() && handle < rxe_ref_global_base() + rxe_ref_tag_span()) {
        i64 index = handle - rxe_ref_global_base();

        if (index < 0 || index >= module.global_count) {
            return false;
        }
        raz_compiler_rt_arena_set(module.global_values, index, value);
        return true;
    }

    i64 cell = 0;

    if (!rxe_reference_heap_cell(state, handle, &mut cell)) {
        return false;
    }
    raz_compiler_rt_arena_set(state.heap_values, cell, value);
    return true;
}

fn rxe_reference_make_closure(
    RxeReferenceState&mut state,
    i64 function_index,
    i64 staged,
    i64 capture_count,
    i64&mut handle,
) -> bool {
    if (
        function_index < 0 ||
        capture_count < 0 ||
        state.closure_count >= rxe_reference_closure_capacity() ||
        state.closure_value_count + capture_count > rxe_reference_capture_capacity()
    ) {
        return false;
    }

    i64 closure = state.closure_count;
    i64 first = state.closure_value_count;

    raz_compiler_rt_arena_set(state.closure_functions, closure, function_index);
    raz_compiler_rt_arena_set(state.closure_capture_starts, closure, first);
    raz_compiler_rt_arena_set(state.closure_capture_counts, closure, capture_count);

    i64 i = 0;

    while (i < capture_count) {
        raz_compiler_rt_arena_set(state.closure_values, first + i, raz_compiler_rt_arena_get(staged, i));
        i += 1;
    }
    state.closure_count += 1;
    state.closure_value_count += capture_count;
    *handle = rxe_ref_closure_base() + closure;
    return true;
}

fn rxe_reference_execute_function_state(
    RxeModule&mut module,
    RxeReferenceState&mut state,
    i64 function_index,
    i64 arguments,
    i64 argument_count,
    i64 depth,
    i64&mut result,
) -> bool {
    if (function_index < 0 || function_index >= module.function_count || depth > 64) {
        return false;
    }
    if (argument_count != raz_compiler_rt_arena_get(module.function_argument_counts, function_index)) {
        return false;
    }

    i64 registers = raz_compiler_rt_arena_create(rxe_register_count());
    i64 slots = raz_compiler_rt_arena_create(raz_compiler_rt_arena_get(module.function_frame_slots, function_index) + 1);
    i64 locals = raz_compiler_rt_arena_create(65536);
    i64 staged = raz_compiler_rt_arena_create(256);

    if (registers == 0 || slots == 0 || locals == 0 || staged == 0) {
        if (registers != 0) {
            raz_compiler_rt_arena_destroy(registers);
        }
        if (slots != 0) {
            raz_compiler_rt_arena_destroy(slots);
        }
        if (locals != 0) {
            raz_compiler_rt_arena_destroy(locals);
        }
        if (staged != 0) {
            raz_compiler_rt_arena_destroy(staged);
        }
        return false;
    }

    i64 ip = raz_compiler_rt_arena_get(module.function_code_starts, function_index);
    i64 end = ip + raz_compiler_rt_arena_get(module.function_code_counts, function_index);
    i64 steps = 0;
    bool ok = true;
    bool done = false;

    while (ok && !done && ip >= 0 && ip < end && steps < 10000000) {
        steps += 1;

        i64 op = raz_compiler_rt_arena_get(module.opcodes, ip);
        i64 d = raz_compiler_rt_arena_get(module.dst, ip);
        i64 a = raz_compiler_rt_arena_get(module.src0, ip);
        i64 b = raz_compiler_rt_arena_get(module.src1, ip);
        i64 imm = raz_compiler_rt_arena_get(module.immediates, ip);
        i64 av = raz_compiler_rt_arena_get(registers, a);
        i64 bv = raz_compiler_rt_arena_get(registers, b);
        i64 next = ip + 1;

        if (op == rxe_op_nop()) {} else if (op == rxe_op_movi()) {
            raz_compiler_rt_arena_set(registers, d, imm);
        } else if (op == rxe_op_ldc64()) {
            if (imm < 0 || imm >= module.constant_count) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(module.constants, imm));
            }
        } else if (op == rxe_op_mov()) {
            raz_compiler_rt_arena_set(registers, d, av);
        } else if (op == rxe_op_load_arg()) {
            if (imm < 0 || imm >= argument_count) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(arguments, imm));
            }
        } else if (op == rxe_op_load_slot()) {
            raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(slots, imm));
        } else if (op == rxe_op_store_slot()) {
            raz_compiler_rt_arena_set(slots, imm, raz_compiler_rt_arena_get(registers, 0));
        } else if (op == rxe_op_load_local()) {
            raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(locals, imm));
        } else if (op == rxe_op_store_local()) {
            raz_compiler_rt_arena_set(locals, imm, raz_compiler_rt_arena_get(registers, 0));
        } else if (op == rxe_op_load_global()) {
            raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(module.global_values, imm));
        } else if (op == rxe_op_store_global()) {
            raz_compiler_rt_arena_set(module.global_values, imm, raz_compiler_rt_arena_get(registers, 0));
        } else if (op == rxe_op_global_ref() || op == rxe_op_string_ref()) {
            raz_compiler_rt_arena_set(registers, d, rxe_ref_global_base() + imm);
        } else if (op == rxe_op_load_ref()) {
            i64 value = 0;

            if (!rxe_reference_load_ref(module, state, av, &mut value)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, value);
            }
        } else if (op == rxe_op_store_ref()) {
            if (!rxe_reference_store_ref(module, state, av, bv)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, bv);
            }
        } else if (op == rxe_op_arg()) {
            raz_compiler_rt_arena_set(staged, imm, raz_compiler_rt_arena_get(registers, d));
        } else if (op == rxe_op_func_ref()) {
            raz_compiler_rt_arena_set(registers, d, imm + 1);
        } else if (op == rxe_op_call()) {
            i64 child_result = 0;

            if (
                !rxe_reference_execute_function_state(
                    module,
                    state,
                    imm,
                    staged,
                    b,
                    depth + 1,
                    &mut child_result,
                )
            ) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, child_result);
            }
        } else if (op == rxe_op_call_indirect()) {
            i64 target = av - 1;
            i64 child_result = 0;

            if (
                target < 0 ||
                target >= module.function_count ||
                !rxe_reference_execute_function_state(
                    module,
                    state,
                    target,
                    staged,
                    b,
                    depth + 1,
                    &mut child_result,
                )
            ) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, child_result);
            }
        } else if (op == rxe_op_make_closure()) {
            i64 handle = 0;

            if (!rxe_reference_make_closure(state, imm, staged, b, &mut handle)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, handle);
            }
        } else if (op == rxe_op_call_closure()) {
            if (av < rxe_ref_closure_base() || av >= rxe_ref_closure_base() + state.closure_count) {
                ok = false;
            } else {
                i64 closure = av - rxe_ref_closure_base();
                i64 captures = raz_compiler_rt_arena_get(state.closure_capture_counts, closure);
                i64 first = raz_compiler_rt_arena_get(state.closure_capture_starts, closure);
                i64 combined_count = b + captures;
                i64 combined = raz_compiler_rt_arena_create(combined_count + 1);

                if (combined == 0 || combined_count > 255) {
                    ok = false;
                } else {
                    i64 ci = 0;

                    while (ci < b) {
                        raz_compiler_rt_arena_set(combined, ci, raz_compiler_rt_arena_get(staged, ci));
                        ci += 1;
                    }
                    ci = 0;
                    while (ci < captures) {
                        raz_compiler_rt_arena_set(
                            combined,
                            b + ci,
                            raz_compiler_rt_arena_get(state.closure_values, first + ci),
                        );
                        ci += 1;
                    }

                    i64 child_result = 0;
                    i64 target = raz_compiler_rt_arena_get(state.closure_functions, closure);

                    if (
                        !rxe_reference_execute_function_state(
                            module,
                            state,
                            target,
                            combined,
                            combined_count,
                            depth + 1,
                            &mut child_result,
                        )
                    ) {
                        ok = false;
                    } else {
                        raz_compiler_rt_arena_set(registers, d, child_result);
                    }
                    raz_compiler_rt_arena_destroy(combined);
                }
            }
        } else if (op == rxe_op_alloc()) {
            i64 handle = 0;
            i64 count = imm & 65535;

            if (!rxe_reference_alloc(state, count, &mut handle)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, handle);
            }
        } else if (op == rxe_op_free()) {
            if (!rxe_reference_free(state, raz_compiler_rt_arena_get(registers, d))) {
                ok = false;
            }
        } else if (op == rxe_op_index_load()) {
            i64 cell = 0;

            if (!rxe_reference_heap_index(state, av, bv, &mut cell)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(state.heap_values, cell));
            }
        } else if (op == rxe_op_index_store()) {
            i64 cell = 0;

            if (
                imm < 0 ||
                imm >= rxe_register_count() ||
                !rxe_reference_heap_index(state, av, bv, &mut cell)
            ) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(state.heap_values, cell, raz_compiler_rt_arena_get(registers, imm));
            }
        } else if (op == rxe_op_index_ref()) {
            i64 cell = 0;

            if (!rxe_reference_heap_index(state, av, bv, &mut cell)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, rxe_ref_heap_base() + cell);
            }
        } else if (op == rxe_op_slice_load()) {
            i64 cell = 0;

            if (!rxe_reference_slice_element(state, av, bv, &mut cell)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(state.heap_values, cell));
            }
        } else if (op == rxe_op_slice_store()) {
            i64 cell = 0;

            if (
                imm < 0 ||
                imm >= rxe_register_count() ||
                !rxe_reference_slice_element(state, av, bv, &mut cell)
            ) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(state.heap_values, cell, raz_compiler_rt_arena_get(registers, imm));
            }
        } else if (op == rxe_op_slice_ref()) {
            i64 cell = 0;

            if (!rxe_reference_slice_element(state, av, bv, &mut cell)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, rxe_ref_heap_base() + cell);
            }
        } else if (op == rxe_op_mem_copy()) {
            if (!rxe_reference_mem_copy(state, av, bv, imm)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, av);
            }
        } else if (op == rxe_op_add64()) {
            raz_compiler_rt_arena_set(registers, d, av + bv);
        } else if (op == rxe_op_sub64()) {
            raz_compiler_rt_arena_set(registers, d, av - bv);
        } else if (op == rxe_op_mul64()) {
            raz_compiler_rt_arena_set(registers, d, av * bv);
        } else if (op == rxe_op_divs64()) {
            if (bv == 0 || (av == rxe_reference_i64_min() && bv == -1)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, av / bv);
            }
        } else if (op == rxe_op_rems64()) {
            if (bv == 0 || (av == rxe_reference_i64_min() && bv == -1)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, av % bv);
            }
        } else if (op == rxe_op_div64() || op == rxe_op_rem64()) {
            i64 uv = 0;

            if (!rxe_reference_unsigned_divrem(av, bv, op == rxe_op_rem64(), &mut uv)) {
                ok = false;
            } else {
                raz_compiler_rt_arena_set(registers, d, uv);
            }
        } else if (op == rxe_op_and64()) {
            raz_compiler_rt_arena_set(registers, d, av & bv);
        } else if (op == rxe_op_or64()) {
            raz_compiler_rt_arena_set(registers, d, av | bv);
        } else if (op == rxe_op_xor64()) {
            raz_compiler_rt_arena_set(registers, d, av ^ bv);
        } else if (op == rxe_op_shl64()) {
            raz_compiler_rt_arena_set(registers, d, av << (bv & 63));
        } else if (op == rxe_op_shr64()) {
            raz_compiler_rt_arena_set(registers, d, rxe_reference_logical_shr(av, bv));
        } else if (op == rxe_op_sar64()) {
            raz_compiler_rt_arena_set(registers, d, av >> (bv & 63));
        } else if (op == rxe_op_eq64()) {
            if (av == bv) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_ne64()) {
            if (av != bv) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_lt64()) {
            if (rxe_reference_unsigned_less(av, bv)) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_le64()) {
            if (rxe_reference_unsigned_less_equal(av, bv)) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_gt64()) {
            if (!rxe_reference_unsigned_less_equal(av, bv)) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_ge64()) {
            if (!rxe_reference_unsigned_less(av, bv)) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_lts64()) {
            if (av < bv) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_les64()) {
            if (av <= bv) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_gts64()) {
            if (av > bv) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_ges64()) {
            if (av >= bv) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_select()) {
            if (av != 0) {
                raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(registers, b));
            } else {
                raz_compiler_rt_arena_set(registers, d, raz_compiler_rt_arena_get(registers, imm));
            }
        } else if (op == rxe_op_not_bool()) {
            if (av == 0) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_boolize()) {
            if (av != 0) {
                raz_compiler_rt_arena_set(registers, d, 1);
            } else {
                raz_compiler_rt_arena_set(registers, d, 0);
            }
        } else if (op == rxe_op_trunc8()) {
            raz_compiler_rt_arena_set(registers, d, av & 255);
        } else if (op == rxe_op_trunc16()) {
            raz_compiler_rt_arena_set(registers, d, av & 65535);
        } else if (op == rxe_op_trunc32()) {
            raz_compiler_rt_arena_set(registers, d, av & 4294967295);
        } else if (op == rxe_op_sext8()) {
            i64 v8 = av & 255;

            if ((v8 & 128) != 0) {
                v8 = v8 - 256;
            }
            raz_compiler_rt_arena_set(registers, d, v8);
        } else if (op == rxe_op_sext16()) {
            i64 v16 = av & 65535;

            if ((v16 & 32768) != 0) {
                v16 = v16 - 65536;
            }
            raz_compiler_rt_arena_set(registers, d, v16);
        } else if (op == rxe_op_sext32()) {
            i64 v32 = av & 4294967295;

            if ((v32 & 2147483648) != 0) {
                v32 = v32 - 4294967296;
            }
            raz_compiler_rt_arena_set(registers, d, v32);
        } else if (op == rxe_op_jmp()) {
            next = imm;
        } else if (op == rxe_op_brnz()) {
            if (av != 0) {
                next = imm;
            }
        } else if (op == rxe_op_ret()) {
            *result = raz_compiler_rt_arena_get(registers, d);
            done = true;
        } else if (op == rxe_op_ret_void()) {
            *result = 0;
            done = true;
        } else if (op == rxe_op_trap()) {
            ok = false;
        } else {
            ok = false;
        }
        ip = next;
    }
    if (!done) {
        ok = false;
    }
    raz_compiler_rt_arena_destroy(registers);
    raz_compiler_rt_arena_destroy(slots);
    raz_compiler_rt_arena_destroy(locals);
    raz_compiler_rt_arena_destroy(staged);
    return ok;
}

fn rxe_reference_execute_function(
    RxeModule&mut module,
    i64 function_index,
    i64 arguments,
    i64 argument_count,
    i64 depth,
    i64&mut result,
) -> bool {
    RxeReferenceState state;

    state.heap_values = 0;
    state.heap_owner = 0;
    state.heap_lengths = 0;
    state.heap_alive = 0;
    state.closure_functions = 0;
    state.closure_capture_starts = 0;
    state.closure_capture_counts = 0;
    state.closure_values = 0;
    if (!rxe_reference_state_init(&mut state)) {
        rxe_reference_state_destroy(&mut state);
        return false;
    }
    bool ok = rxe_reference_execute_function_state(
        module,
        &mut state,
        function_index,
        arguments,
        argument_count,
        depth,
        result,
    );
    rxe_reference_state_destroy(&mut state);
    return ok;
}

// Differential oracle used by RXE conformance tests. Arguments are already
// canonical i64 MIR values, so both interpreters consume the exact same arena.
fn rxe_reference_matches_mir(
    MirModule&mut mir,
    RxeModule&mut module,
    i64 function_index,
    i64 arguments,
    i64 argument_count,
) -> bool {
    if (function_index < 0 || function_index >= module.function_count) {
        return false;
    }
    if (argument_count != raz_compiler_rt_arena_get(module.function_argument_counts, function_index)) {
        return false;
    }
    if (argument_count > 0 && arguments == 0) {
        return false;
    }

    i64 mir_result = execute_mir_function(mir, function_index, arguments, 0, argument_count);
    i64 rxe_result = 0;

    if (!rxe_reference_execute_function(module, function_index, arguments, argument_count, 0, &mut rxe_result)) {
        return false;
    }
    return mir_result == rxe_result;
}

fn rxe_reference_matches_mir_zero_arg(MirModule&mut mir, RxeModule&mut module, i64 function_index, ) -> bool {
    return rxe_reference_matches_mir(mir, module, function_index, 0, 0);
}

// Deterministic argument-corpus differential runner used by the RXE compatibility contract
// suite. It intentionally uses a fixed xorshift stream so failures reproduce
// byte-for-byte without host randomness or clocks.
fn rxe_reference_conformance_next(i64 value) -> i64 {
    value = value ^ (value << 13);
    value = value ^ rxe_reference_logical_shr(value, 7);
    value = value ^ (value << 17);
    return value;
}

fn rxe_reference_matches_mir_seeded(
    MirModule&mut mir,
    RxeModule&mut module,
    i64 function_index,
    i64 seed,
    i64 case_count,
) -> bool {
    if (function_index < 0 || function_index >= module.function_count || case_count < 0) {
        return false;
    }

    i64 argument_count = raz_compiler_rt_arena_get(module.function_argument_counts, function_index);
    i64 capacity = argument_count;

    if (capacity <= 0) {
        capacity = 1;
    }

    i64 arguments = raz_compiler_rt_arena_create(capacity);

    if (arguments == 0) {
        return false;
    }

    i64 state = seed;
    i64 case_index = 0;
    bool ok = true;

    while (case_index < case_count && ok) {
        i64 argument = 0;

        while (argument < argument_count) {
            state = rxe_reference_conformance_next(state + case_index + argument + 1);
            raz_compiler_rt_arena_set(arguments, argument, state);
            argument += 1;
        }
        ok = rxe_reference_matches_mir(mir, module, function_index, arguments, argument_count);
        case_index += 1;
    }
    raz_compiler_rt_arena_destroy(arguments);
    return ok;
}
