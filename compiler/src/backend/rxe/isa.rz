namespace raz_compiler_backend_rxe_isa;
public import raz_compiler_backend_wasm_codegen;

// RXE ISA v1. Canonical instructions are eight bytes:
// opcode:u8 dst:u8 src0:u8 src1:u8 imm:u32 (little endian).
fn rxe_isa_version() -> i64 { return 1; }
fn rxe_format_version() -> i64 { return 7; }
fn rxe_register_count() -> i64 { return 32; }

fn rxe_op_nop() -> i64 { return 0; }
fn rxe_op_movi() -> i64 { return 1; }
fn rxe_op_ldc64() -> i64 { return 2; }
fn rxe_op_mov() -> i64 { return 3; }
fn rxe_op_load_arg() -> i64 { return 4; }
fn rxe_op_load_slot() -> i64 { return 5; }
fn rxe_op_store_slot() -> i64 { return 6; }
fn rxe_op_load_local() -> i64 { return 7; }
fn rxe_op_store_local() -> i64 { return 8; }
fn rxe_op_load_global() -> i64 { return 9; }
fn rxe_op_store_global() -> i64 { return 10; }
fn rxe_op_global_ref() -> i64 { return 11; }
fn rxe_op_local_ref() -> i64 { return 12; }
fn rxe_op_load_ref() -> i64 { return 13; }
fn rxe_op_store_ref() -> i64 { return 14; }
fn rxe_op_func_ref() -> i64 { return 15; }
fn rxe_op_jmp() -> i64 { return 16; }
fn rxe_op_brnz() -> i64 { return 17; }
fn rxe_op_ret() -> i64 { return 18; }
fn rxe_op_ret_void() -> i64 { return 19; }
fn rxe_op_trap() -> i64 { return 20; }
fn rxe_op_call() -> i64 { return 21; }
fn rxe_op_arg() -> i64 { return 22; }
fn rxe_op_call_indirect() -> i64 { return 23; }
fn rxe_op_make_closure() -> i64 { return 24; }
fn rxe_op_call_closure() -> i64 { return 25; }

fn rxe_op_add64() -> i64 { return 32; }
fn rxe_op_sub64() -> i64 { return 33; }
fn rxe_op_mul64() -> i64 { return 34; }
fn rxe_op_div64() -> i64 { return 35; }
fn rxe_op_rem64() -> i64 { return 36; }
fn rxe_op_and64() -> i64 { return 37; }
fn rxe_op_or64() -> i64 { return 38; }
fn rxe_op_xor64() -> i64 { return 39; }
fn rxe_op_shl64() -> i64 { return 40; }
fn rxe_op_shr64() -> i64 { return 41; }
fn rxe_op_divs64() -> i64 { return 42; }
fn rxe_op_rems64() -> i64 { return 43; }
fn rxe_op_sar64() -> i64 { return 44; }

fn rxe_op_eq64() -> i64 { return 64; }
fn rxe_op_ne64() -> i64 { return 65; }
fn rxe_op_lt64() -> i64 { return 66; }
fn rxe_op_le64() -> i64 { return 67; }
fn rxe_op_gt64() -> i64 { return 68; }
fn rxe_op_ge64() -> i64 { return 69; }
fn rxe_op_select() -> i64 { return 70; }
fn rxe_op_not_bool() -> i64 { return 71; }
fn rxe_op_trunc8() -> i64 { return 72; }
fn rxe_op_trunc16() -> i64 { return 73; }
fn rxe_op_trunc32() -> i64 { return 74; }
fn rxe_op_sext8() -> i64 { return 75; }
fn rxe_op_sext16() -> i64 { return 76; }
fn rxe_op_sext32() -> i64 { return 77; }
fn rxe_op_boolize() -> i64 { return 78; }
fn rxe_op_lts64() -> i64 { return 79; }
fn rxe_op_les64() -> i64 { return 87; }
fn rxe_op_gts64() -> i64 { return 88; }
fn rxe_op_ges64() -> i64 { return 89; }

fn rxe_op_alloc() -> i64 { return 80; }
fn rxe_op_free() -> i64 { return 81; }
fn rxe_op_index_load() -> i64 { return 82; }
fn rxe_op_index_store() -> i64 { return 83; }
fn rxe_op_index_ref() -> i64 { return 84; }
fn rxe_op_string_ref() -> i64 { return 85; }
fn rxe_op_mem_copy() -> i64 { return 86; }
fn rxe_op_slice_load() -> i64 { return 90; }
fn rxe_op_slice_store() -> i64 { return 91; }
fn rxe_op_slice_ref() -> i64 { return 92; }

fn rxe_opcode_valid(i64 opcode) -> bool {
    return (opcode >= 0 && opcode <= 25) ||
        (opcode >= 32 && opcode <= 44) ||
        (opcode >= 64 && opcode <= 89) ||
        (opcode >= 80 && opcode <= 86) ||
        (opcode >= 90 && opcode <= 92);
}

// RXE v7 canonical feature bits. These are executable requirements, not host
// capabilities: a loader can reject unsupported modules before decoding code.
fn rxe_feature_calls() -> i64 { return 1; }
fn rxe_feature_closures() -> i64 { return 2; }
fn rxe_feature_memory() -> i64 { return 4; }
fn rxe_feature_globals() -> i64 { return 8; }
fn rxe_feature_slices() -> i64 { return 16; }
fn rxe_feature_signed() -> i64 { return 32; }

fn rxe_opcode_feature(i64 opcode) -> i64 {
    if (opcode == rxe_op_call() || opcode == rxe_op_call_indirect() || opcode == rxe_op_arg() || opcode == rxe_op_func_ref()) { return rxe_feature_calls(); }
    if (opcode == rxe_op_make_closure() || opcode == rxe_op_call_closure()) { return rxe_feature_calls() | rxe_feature_closures(); }
    if (opcode == rxe_op_load_global() || opcode == rxe_op_store_global() || opcode == rxe_op_global_ref() || opcode == rxe_op_string_ref()) { return rxe_feature_globals(); }
    if (opcode == rxe_op_slice_load() || opcode == rxe_op_slice_store() || opcode == rxe_op_slice_ref()) { return rxe_feature_memory() | rxe_feature_slices(); }
    if (opcode == rxe_op_alloc() || opcode == rxe_op_free() || opcode == rxe_op_load_ref() || opcode == rxe_op_store_ref() || opcode == rxe_op_local_ref() || opcode == rxe_op_index_load() || opcode == rxe_op_index_store() || opcode == rxe_op_index_ref() || opcode == rxe_op_mem_copy()) { return rxe_feature_memory(); }
    if (opcode == rxe_op_divs64() || opcode == rxe_op_rems64() || opcode == rxe_op_sar64() || opcode == rxe_op_lts64() || opcode == rxe_op_les64() || opcode == rxe_op_gts64() || opcode == rxe_op_ges64() || opcode == rxe_op_sext8() || opcode == rxe_op_sext16() || opcode == rxe_op_sext32()) { return rxe_feature_signed(); }
    return 0;
}
