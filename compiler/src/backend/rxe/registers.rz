namespace raz_compiler_backend_rxe_registers;
public import raz_compiler_backend_rxe_dataflow;

fn rxe_opcode_writes_dst(i64 op) -> bool {
    return (
        op == rxe_op_movi() ||
        op == rxe_op_ldc64() ||
        op == rxe_op_mov() ||
        op == rxe_op_load_arg() ||
        op == rxe_op_load_slot() ||
        op == rxe_op_load_local() ||
        op == rxe_op_load_global() ||
        op == rxe_op_global_ref() ||
        op == rxe_op_local_ref() ||
        op == rxe_op_load_ref() ||
        op == rxe_op_func_ref() ||
        op == rxe_op_call() ||
        op == rxe_op_call_indirect() ||
        op == rxe_op_make_closure() ||
        op == rxe_op_call_closure() ||
        (op >= rxe_op_add64() && op <= rxe_op_sar64()) ||
        (op >= rxe_op_eq64() && op <= rxe_op_boolize()) ||
        op == rxe_op_lts64() ||
        op == rxe_op_les64() ||
        op == rxe_op_gts64() ||
        op == rxe_op_ges64() ||
        op == rxe_op_alloc() ||
        op == rxe_op_index_load() ||
        op == rxe_op_index_ref() ||
        op == rxe_op_string_ref() ||
        op == rxe_op_mem_copy() ||
        op == rxe_op_slice_load() ||
        op == rxe_op_slice_ref()
    );
}

fn rxe_register_cache_clear(i64 slots) {
    i64 reg = 0;

    while (reg < rxe_register_count()) {
        raz_compiler_rt_arena_set(slots, reg, -1);
        reg += 1;
    }
}

fn rxe_register_cache_forget_register(i64 slots, i64 reg) {
    if (reg >= 0 && reg < rxe_register_count()) {
        raz_compiler_rt_arena_set(slots, reg, -1);
    }
}

fn rxe_register_cache_find_slot(i64 slots, i64 slot) -> i64 {
    i64 reg = 0;

    while (reg < rxe_register_count()) {
        if (raz_compiler_rt_arena_get(slots, reg) == slot) {
            return reg;
        }
        reg += 1;
    }
    return -1;
}

fn rxe_function_has_backedge(RxeModule& module, i64 start, i64 end) -> bool {
    i64 ip = start;

    while (ip < end) {
        i64 op = raz_compiler_rt_arena_get(module.opcodes, ip);

        if (op == rxe_op_jmp() || op == rxe_op_brnz()) {
            if (raz_compiler_rt_arena_get(module.immediates, ip) <= ip) {
                return true;
            }
        }
        ip += 1;
    }
    return false;
}

// Assign MIR-result frame slots to r6-r31 with CFG-aware conservative
// liveness. Physical assignments are stable for the complete live interval;
// registers are never recycled while a stale slot->register mapping survives.
// Loop-carried values whose first loop access is a load remain in frame slots
// until a future SSA/phi-aware allocator can prove their incoming value.
fn rxe_linear_scan_function(RxeModule&mut module, i64 function) -> bool {
    i64 start = raz_compiler_rt_arena_get(module.function_code_starts, function);
    i64 end = start + raz_compiler_rt_arena_get(module.function_code_counts, function);
    i64 slot_count = raz_compiler_rt_arena_get(module.function_frame_slots, function);
    i64 slot_first = raz_compiler_rt_arena_create(slot_count + 1);
    i64 slot_last = raz_compiler_rt_arena_create(slot_count + 1);
    i64 slot_reg = raz_compiler_rt_arena_create(slot_count + 1);
    i64 slot_blocked = raz_compiler_rt_arena_create(slot_count + 1);
    i64 loop_store_seen = raz_compiler_rt_arena_create(slot_count + 1);
    i64 reg_slot = raz_compiler_rt_arena_create(rxe_register_count());

    if (
        slot_first == 0 || slot_last == 0 || slot_reg == 0 ||
        slot_blocked == 0 || loop_store_seen == 0 || reg_slot == 0
    ) {
        if (slot_first != 0) { raz_compiler_rt_arena_destroy(slot_first); }
        if (slot_last != 0) { raz_compiler_rt_arena_destroy(slot_last); }
        if (slot_reg != 0) { raz_compiler_rt_arena_destroy(slot_reg); }
        if (slot_blocked != 0) { raz_compiler_rt_arena_destroy(slot_blocked); }
        if (loop_store_seen != 0) { raz_compiler_rt_arena_destroy(loop_store_seen); }
        if (reg_slot != 0) { raz_compiler_rt_arena_destroy(reg_slot); }
        return false;
    }

    i64 slot = 0;
    while (slot <= slot_count) {
        raz_compiler_rt_arena_set(slot_first, slot, -1);
        raz_compiler_rt_arena_set(slot_last, slot, -1);
        raz_compiler_rt_arena_set(slot_reg, slot, -1);
        raz_compiler_rt_arena_set(slot_blocked, slot, 0);
        raz_compiler_rt_arena_set(loop_store_seen, slot, 0);
        slot += 1;
    }
    i64 reg = 0;
    while (reg < rxe_register_count()) {
        raz_compiler_rt_arena_set(reg_slot, reg, -1);
        reg += 1;
    }

    i64 ip = start;
    while (ip < end) {
        i64 op = raz_compiler_rt_arena_get(module.opcodes, ip);
        if (op == rxe_op_load_slot() || op == rxe_op_store_slot()) {
            i64 s = raz_compiler_rt_arena_get(module.immediates, ip);
            if (s < 0 || s >= slot_count) {
                raz_compiler_rt_arena_destroy(slot_first);
                raz_compiler_rt_arena_destroy(slot_last);
                raz_compiler_rt_arena_destroy(slot_reg);
                raz_compiler_rt_arena_destroy(slot_blocked);
                raz_compiler_rt_arena_destroy(loop_store_seen);
                raz_compiler_rt_arena_destroy(reg_slot);
                return false;
            }
            if (raz_compiler_rt_arena_get(slot_first, s) < 0) {
                raz_compiler_rt_arena_set(slot_first, s, ip);
                // A frame value cannot be replaced by a register if its first
                // access is a load; the register has no defining instruction.
                if (op == rxe_op_load_slot()) { raz_compiler_rt_arena_set(slot_blocked, s, 1); }
            }
            raz_compiler_rt_arena_set(slot_last, s, ip);
        }
        ip += 1;
    }

    // Analyze each backward edge independently. A slot loaded before any store
    // in the loop body is loop-carried/invariant and remains memory-backed.
    ip = start;
    while (ip < end) {
        i64 op = raz_compiler_rt_arena_get(module.opcodes, ip);
        if (op == rxe_op_jmp() || op == rxe_op_brnz()) {
            i64 target = raz_compiler_rt_arena_get(module.immediates, ip);
            if (target >= start && target <= ip) {
                slot = 0;
                while (slot < slot_count) {
                    raz_compiler_rt_arena_set(loop_store_seen, slot, 0);
                    slot += 1;
                }
                i64 cursor = target;
                while (cursor <= ip) {
                    i64 cursor_op = raz_compiler_rt_arena_get(module.opcodes, cursor);
                    if (cursor_op == rxe_op_load_slot() || cursor_op == rxe_op_store_slot()) {
                        i64 s = raz_compiler_rt_arena_get(module.immediates, cursor);
                        if (cursor_op == rxe_op_load_slot() && raz_compiler_rt_arena_get(loop_store_seen, s) == 0) {
                            // A load-before-store at the loop header is a machine-level phi
                            // when the slot has a proven preheader definition. Keeping one
                            // stable register across the backedge carries the updated value.
                            if (raz_compiler_rt_arena_get(slot_first, s) >= target) {
                                raz_compiler_rt_arena_set(slot_blocked, s, 1);
                            }
                        }
                        if (cursor_op == rxe_op_store_slot()) {
                            raz_compiler_rt_arena_set(loop_store_seen, s, 1);
                        }
                        // Keep any promotable loop-local value live through the
                        // complete backedge range to prevent unsafe register reuse.
                        if (raz_compiler_rt_arena_get(slot_first, s) > target) {
                            raz_compiler_rt_arena_set(slot_first, s, target);
                        }
                        if (raz_compiler_rt_arena_get(slot_last, s) < ip) {
                            raz_compiler_rt_arena_set(slot_last, s, ip);
                        }
                    }
                    cursor += 1;
                }
            }
        }
        ip += 1;
    }

    // Extend the preliminary intervals with fixed-point block liveness. This
    // makes joins and loop-carried values explicit instead of relying only on
    // backward-edge heuristics. The earlier loop analysis remains a cheap
    // conservative guard for values with no materializable incoming definition.
    if (!rxe_dataflow_extend_slot_intervals(
        module,
        function,
        slot_count,
        slot_first,
        slot_last,
        slot_blocked
    )) {
        raz_compiler_rt_arena_destroy(slot_first);
        raz_compiler_rt_arena_destroy(slot_last);
        raz_compiler_rt_arena_destroy(slot_reg);
        raz_compiler_rt_arena_destroy(slot_blocked);
        raz_compiler_rt_arena_destroy(loop_store_seen);
        raz_compiler_rt_arena_destroy(reg_slot);
        return false;
    }

    // Deterministic interval allocation. Slots are visited by first program
    // position then slot number; lowest free architectural register wins.
    ip = start;
    while (ip < end) {
        reg = 6;
        while (reg < rxe_register_count()) {
            i64 active = raz_compiler_rt_arena_get(reg_slot, reg);
            if (active >= 0 && raz_compiler_rt_arena_get(slot_last, active) < ip) {
                raz_compiler_rt_arena_set(reg_slot, reg, -1);
            }
            reg += 1;
        }
        slot = 0;
        while (slot < slot_count) {
            if (
                raz_compiler_rt_arena_get(slot_first, slot) == ip &&
                raz_compiler_rt_arena_get(slot_blocked, slot) == 0
            ) {
                reg = 6;
                while (reg < rxe_register_count() && raz_compiler_rt_arena_get(reg_slot, reg) >= 0) { reg += 1; }
                if (reg < rxe_register_count()) {
                    raz_compiler_rt_arena_set(slot_reg, slot, reg);
                    raz_compiler_rt_arena_set(reg_slot, reg, slot);
                }
            }
            slot += 1;
        }
        ip += 1;
    }

    // Rewrite only slots with a proven stable register assignment.
    ip = start;
    while (ip < end) {
        i64 op = raz_compiler_rt_arena_get(module.opcodes, ip);
        if (op == rxe_op_store_slot() || op == rxe_op_load_slot()) {
            i64 s = raz_compiler_rt_arena_get(module.immediates, ip);
            i64 assigned = raz_compiler_rt_arena_get(slot_reg, s);
            if (assigned >= 6) {
                raz_compiler_rt_arena_set(module.opcodes, ip, rxe_op_mov());
                if (op == rxe_op_store_slot()) {
                    raz_compiler_rt_arena_set(module.dst, ip, assigned);
                    raz_compiler_rt_arena_set(module.src0, ip, 0);
                } else {
                    raz_compiler_rt_arena_set(module.src0, ip, assigned);
                }
                raz_compiler_rt_arena_set(module.src1, ip, 0);
                raz_compiler_rt_arena_set(module.immediates, ip, 0);
            }
        }
        ip += 1;
    }

    raz_compiler_rt_arena_destroy(slot_first);
    raz_compiler_rt_arena_destroy(slot_last);
    raz_compiler_rt_arena_destroy(slot_reg);
    raz_compiler_rt_arena_destroy(slot_blocked);
    raz_compiler_rt_arena_destroy(loop_store_seen);
    raz_compiler_rt_arena_destroy(reg_slot);
    return true;


}

// Secondary cache promotion handles looped functions and any values that spill
// from linear scan. Slot stores remain the canonical fallback at merge points.
fn rxe_promote_slot_reloads(RxeModule&mut module, i64 function, i64 resident) -> bool {
    rxe_register_cache_clear(resident);

    i64 start = raz_compiler_rt_arena_get(module.function_code_starts, function);
    i64 end = start + raz_compiler_rt_arena_get(module.function_code_counts, function);
    i64 ip = start;

    while (ip < end) {
        i64 op = raz_compiler_rt_arena_get(module.opcodes, ip);
        i64 d = raz_compiler_rt_arena_get(module.dst, ip);

        if (
            op == rxe_op_jmp() ||
            op == rxe_op_brnz() ||
            op == rxe_op_call() ||
            op == rxe_op_call_indirect() ||
            op == rxe_op_call_closure() ||
            op == rxe_op_ret() ||
            op == rxe_op_ret_void() ||
            op == rxe_op_trap()
        ) {
            rxe_register_cache_clear(resident);
        } else if (op == rxe_op_load_slot()) {
            i64 slot = raz_compiler_rt_arena_get(module.immediates, ip);
            i64 cached = rxe_register_cache_find_slot(resident, slot);

            rxe_register_cache_forget_register(resident, d);
            if (cached >= 0 && cached != d) {
                raz_compiler_rt_arena_set(module.opcodes, ip, rxe_op_mov());
                raz_compiler_rt_arena_set(module.src0, ip, cached);
                raz_compiler_rt_arena_set(module.src1, ip, 0);
                raz_compiler_rt_arena_set(module.immediates, ip, 0);
            }
            raz_compiler_rt_arena_set(resident, d, slot);
        } else if (op == rxe_op_store_slot()) {
            i64 slot = raz_compiler_rt_arena_get(module.immediates, ip);

            raz_compiler_rt_arena_set(resident, 0, slot);
        } else if (rxe_opcode_writes_dst(op)) {
            rxe_register_cache_forget_register(resident, d);
        }
        ip += 1;
    }
    return true;
}

fn rxe_allocate_registers(RxeModule&mut module) -> bool {
    i64 resident = raz_compiler_rt_arena_create(rxe_register_count());

    if (resident == 0) {
        return false;
    }

    i64 function = 0;

    while (function < module.function_count) {
        if (!rxe_linear_scan_function(module, function)) {
            raz_compiler_rt_arena_destroy(resident);
            return false;
        }
        if (!rxe_promote_slot_reloads(module, function, resident)) {
            raz_compiler_rt_arena_destroy(resident);
            return false;
        }

        i64 start = raz_compiler_rt_arena_get(module.function_code_starts, function);
        i64 end = start + raz_compiler_rt_arena_get(module.function_code_counts, function);
        i64 maximum_register = 0;
        i64 ip = start;

        while (ip < end) {
            i64 d = raz_compiler_rt_arena_get(module.dst, ip);
            i64 a = raz_compiler_rt_arena_get(module.src0, ip);
            i64 b = raz_compiler_rt_arena_get(module.src1, ip);

            if (d > maximum_register) {
                maximum_register = d;
            }
            if (a > maximum_register) {
                maximum_register = a;
            }
            if (b > maximum_register) {
                maximum_register = b;
            }

            i64 op = raz_compiler_rt_arena_get(module.opcodes, ip);

            if (
                (op == rxe_op_select() || op == rxe_op_index_store()) &&
                raz_compiler_rt_arena_get(module.immediates, ip) > maximum_register
            ) {
                maximum_register = raz_compiler_rt_arena_get(module.immediates, ip);
            }
            ip += 1;
        }
        raz_compiler_rt_arena_set(module.function_register_counts, function, maximum_register + 1);
        function += 1;
    }
    raz_compiler_rt_arena_destroy(resident);
    return !module.failed;
}
