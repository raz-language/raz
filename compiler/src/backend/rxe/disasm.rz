namespace raz_compiler_backend_rxe_disasm;

public import raz_compiler_backend_rxe_verify;

// Stable named RXE assembly dump used by backend tests and VM bring-up. Mnemonics
// are tooling text only; numeric opcode values remain the canonical binary ISA.
fn rxe_disasm_opcode_name(ForgeWriter&mut out, i64 opcode) {
    if (opcode == rxe_op_nop()) {
        writer_put(out, 110);
        writer_put(out, 111);
        writer_put(out, 112);
    } else if (opcode == rxe_op_movi()) {
        writer_put(out, 109);
        writer_put(out, 111);
        writer_put(out, 118);
        writer_put(out, 105);
    } else if (opcode == rxe_op_ldc64()) {
        writer_put(out, 108);
        writer_put(out, 100);
        writer_put(out, 99);
        writer_put(out, 54);
        writer_put(out, 52);
    } else if (opcode == rxe_op_mov()) {
        writer_put(out, 109);
        writer_put(out, 111);
        writer_put(out, 118);
    } else if (opcode == rxe_op_load_arg()) {
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 97);
        writer_put(out, 100);
        writer_put(out, 46);
        writer_put(out, 97);
        writer_put(out, 114);
        writer_put(out, 103);
    } else if (opcode == rxe_op_load_slot()) {
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 97);
        writer_put(out, 100);
        writer_put(out, 46);
        writer_put(out, 115);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 116);
    } else if (opcode == rxe_op_store_slot()) {
        writer_put(out, 115);
        writer_put(out, 116);
        writer_put(out, 111);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 46);
        writer_put(out, 115);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 116);
    } else if (opcode == rxe_op_load_local()) {
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 97);
        writer_put(out, 100);
        writer_put(out, 46);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 99);
        writer_put(out, 97);
        writer_put(out, 108);
    } else if (opcode == rxe_op_store_local()) {
        writer_put(out, 115);
        writer_put(out, 116);
        writer_put(out, 111);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 46);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 99);
        writer_put(out, 97);
        writer_put(out, 108);
    } else if (opcode == rxe_op_load_global()) {
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 97);
        writer_put(out, 100);
        writer_put(out, 46);
        writer_put(out, 103);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 98);
        writer_put(out, 97);
        writer_put(out, 108);
    } else if (opcode == rxe_op_store_global()) {
        writer_put(out, 115);
        writer_put(out, 116);
        writer_put(out, 111);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 46);
        writer_put(out, 103);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 98);
        writer_put(out, 97);
        writer_put(out, 108);
    } else if (opcode == rxe_op_global_ref()) {
        writer_put(out, 103);
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 98);
        writer_put(out, 97);
        writer_put(out, 108);
        writer_put(out, 46);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 102);
    } else if (opcode == rxe_op_local_ref()) {
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 99);
        writer_put(out, 97);
        writer_put(out, 108);
        writer_put(out, 46);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 102);
    } else if (opcode == rxe_op_load_ref()) {
        writer_put(out, 108);
        writer_put(out, 111);
        writer_put(out, 97);
        writer_put(out, 100);
        writer_put(out, 46);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 102);
    } else if (opcode == rxe_op_store_ref()) {
        writer_put(out, 115);
        writer_put(out, 116);
        writer_put(out, 111);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 46);
