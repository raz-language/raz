        writer_put(out, 108);
    } else if (opcode == rxe_op_arg()) {
        writer_put(out, 97);
        writer_put(out, 114);
        writer_put(out, 103);
    } else if (opcode == rxe_op_call_indirect()) {
        writer_put(out, 99);
        writer_put(out, 97);
        writer_put(out, 108);
        writer_put(out, 108);
        writer_put(out, 46);
        writer_put(out, 105);
        writer_put(out, 110);
