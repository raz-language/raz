fn rxe_disassemble_module(RxeModule& module, ForgeWriter&mut out) -> bool {
    writer_put(out, 114);
    writer_put(out, 120);
    writer_put(out, 101);
    writer_space(out);
    // rxe
    writer_put(out, 102);
    writer_put(out, 112);
    writer_put(out, 61);
    writer_decimal(out, module.module_fingerprint_hi);
    writer_put(out, 58);
    writer_decimal(out, module.module_fingerprint_lo);
    writer_space(out);
    writer_put(out, 102);
    writer_put(out, 101);
    writer_put(out, 97);
    writer_put(out, 116);
    writer_put(out, 117);
    writer_put(out, 114);
    writer_put(out, 101);
    writer_put(out, 115);
    writer_put(out, 61);
    writer_decimal(out, module.feature_flags);
    writer_space(out);
    writer_put(out, 101);
    writer_put(out, 120);
    writer_put(out, 112);
    writer_put(out, 111);
    writer_put(out, 114);
    writer_put(out, 116);
    writer_put(out, 115);
    writer_put(out, 61);
    writer_decimal(out, module.export_count);
    writer_newline(out);

    i64 function = 0;

    while (function < module.function_count) {
        writer_put(out, 102);
        writer_put(out, 110);
        writer_put(out, 32);
        // "fn "
        writer_decimal(out, function);
        writer_put(out, 32);
        writer_put(out, 104);
        writer_put(out, 97);
        writer_put(out, 115);
        writer_put(out, 104);
        writer_put(out, 61);
        writer_decimal(out, raz_compiler_rt_arena_get(module.function_name_hashes, function));
        writer_put(out, 32);
        writer_put(out, 115);
        writer_put(out, 101);
        writer_put(out, 108);
        writer_put(out, 61);
        writer_decimal(out, raz_compiler_rt_arena_get(module.function_selector_hi, function));
        writer_put(out, 58);
        writer_decimal(out, raz_compiler_rt_arena_get(module.function_selector_lo, function));
        writer_put(out, 32);
        writer_put(out, 97);
        writer_put(out, 98);
        writer_put(out, 105);
        writer_put(out, 61);
        writer_decimal(out, raz_compiler_rt_arena_get(module.function_abi_kinds, function));
        writer_put(out, 32);
        writer_put(out, 97);
        writer_put(out, 114);
        writer_put(out, 103);
        writer_put(out, 115);
        writer_put(out, 61);
        writer_decimal(out, raz_compiler_rt_arena_get(module.function_argument_counts, function));
        writer_put(out, 32);
        writer_put(out, 114);
        writer_put(out, 101);
        writer_put(out, 103);
        writer_put(out, 115);
        writer_put(out, 61);
        writer_decimal(out, raz_compiler_rt_arena_get(module.function_register_counts, function));
        writer_put(out, 32);
        writer_put(out, 102);
        writer_put(out, 114);
        writer_put(out, 97);
        writer_put(out, 109);
        writer_put(out, 101);
        writer_put(out, 61);
        writer_decimal(out, raz_compiler_rt_arena_get(module.function_frame_slots, function));
        writer_put(out, 58);
        writer_newline(out);

        i64 ip = raz_compiler_rt_arena_get(module.function_code_starts, function);
        i64 end = ip + raz_compiler_rt_arena_get(module.function_code_counts, function);

        while (ip < end) {
            writer_space(out);
            writer_space(out);
            writer_decimal(out, ip);
            writer_space(out);

            i64 opcode = raz_compiler_rt_arena_get(module.opcodes, ip);

            rxe_disasm_opcode_name(out, opcode);
            writer_space(out);
            writer_put(out, 114);
            writer_decimal(out, raz_compiler_rt_arena_get(module.dst, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_put(out, 114);
            writer_decimal(out, raz_compiler_rt_arena_get(module.src0, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_put(out, 114);
            writer_decimal(out, raz_compiler_rt_arena_get(module.src1, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, raz_compiler_rt_arena_get(module.immediates, ip));
            writer_newline(out);
            ip += 1;
        }
        function += 1;
    }
    return !out.failed;
}

fn rxe_write_disassembly(RxeModule& module, i64 output_path, i64 output_path_length) -> bool {
    ForgeWriter out;

    writer_init(&mut out);

    bool ok = rxe_disassemble_module(module, &mut out);

    if (ok) {
        i64 written = raz_compiler_rt_write_ascii(output_path, output_path_length, out.data, out.length);

        ok = written == out.length;
    }
    writer_destroy(&mut out);
    return ok;
}
