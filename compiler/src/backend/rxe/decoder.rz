namespace raz_compiler_backend_rxe_decoder;
public import raz_compiler_backend_rxe_writer;

// Independent RXE binary decoder used by the compilered toolchain. This code
// intentionally consumes only the serialized format; it does not use HIR/MIR
// metadata. A format is not compatibility-ready unless this decoder can recover every
// section boundary from the bytes alone.
public struct RxeBinaryHeader {
    i64 feature_flags;
    i64 function_count;
    i64 instruction_count;
    i64 constant_count;
    i64 global_count;
    i64 header_bytes;
    i64 code_offset;
    i64 code_bytes;
    i64 constant_offset;
    i64 constant_bytes;
    i64 global_offset;
    i64 global_bytes;
    i64 layout_offset;
    i64 layout_bytes;
    i64 signature_offset;
    i64 signature_bytes;
    i64 function_type_count;
    i64 signature_parameter_count;
    i64 function_type_parameter_count;
    i64 fingerprint_lo;
    i64 fingerprint_hi;
    i64 export_count;
    i64 layout_count;
    i64 layout_field_count;
    i64 block_count;
}

fn rxe_decode_u8(i64 bytes, i64 length, i64 offset, i64&mut out) -> bool {
    if (offset < 0 || offset >= length) { return false; }
    *out = raz_rt_load_u8((bytes + offset)as usize);
    return true;
}

fn rxe_decode_u16(i64 data, i64 length, i64 offset, i64&mut out) -> bool {
    i64 a = 0; i64 b = 0;
    if (!rxe_decode_u8(data, length, offset, &mut a) || !rxe_decode_u8(data, length, offset + 1, &mut b)) { return false; }
    *out = a | (b << 8);
    return true;
}

fn rxe_decode_u32(i64 data, i64 length, i64 offset, i64&mut out) -> bool {
    i64 a = 0; i64 b = 0; i64 c = 0; i64 d = 0;
    if (!rxe_decode_u8(data, length, offset, &mut a) || !rxe_decode_u8(data, length, offset + 1, &mut b) ||
        !rxe_decode_u8(data, length, offset + 2, &mut c) || !rxe_decode_u8(data, length, offset + 3, &mut d)) { return false; }
    *out = a | (b << 8) | (c << 16) | (d << 24);
    return true;
}

fn rxe_decode_u64(i64 data, i64 length, i64 offset, i64&mut out) -> bool {
    i64 lo = 0; i64 hi = 0;
    if (!rxe_decode_u32(data, length, offset, &mut lo) || !rxe_decode_u32(data, length, offset + 4, &mut hi)) { return false; }
    *out = lo | (hi << 32);
    return true;
}

fn rxe_decode_header(i64 data, i64 length, RxeBinaryHeader&mut out) -> bool {
    if (data == 0 || length < 104) { return false; }
    i64 value = 0;
    if (!rxe_decode_u8(data, length, 0, &mut value) || value != 82) { return false; }
    if (!rxe_decode_u8(data, length, 1, &mut value) || value != 88) { return false; }
    if (!rxe_decode_u8(data, length, 2, &mut value) || value != 69) { return false; }
    if (!rxe_decode_u8(data, length, 3, &mut value) || value != 0) { return false; }
    if (!rxe_decode_u16(data, length, 4, &mut value) || value != rxe_format_version()) { return false; }
    if (!rxe_decode_u16(data, length, 6, &mut value) || value != rxe_isa_version()) { return false; }
    if (!rxe_decode_u32(data, length, 8, &mut out.feature_flags)) { return false; }
    if (!rxe_decode_u32(data, length, 12, &mut out.function_count)) { return false; }
    if (!rxe_decode_u32(data, length, 16, &mut out.instruction_count)) { return false; }
    if (!rxe_decode_u32(data, length, 20, &mut out.constant_count)) { return false; }
    if (!rxe_decode_u32(data, length, 24, &mut out.global_count)) { return false; }
    if (!rxe_decode_u32(data, length, 28, &mut out.header_bytes)) { return false; }
    if (!rxe_decode_u32(data, length, 32, &mut out.code_offset)) { return false; }
    if (!rxe_decode_u32(data, length, 36, &mut out.code_bytes)) { return false; }
    if (!rxe_decode_u32(data, length, 40, &mut out.constant_offset)) { return false; }
    if (!rxe_decode_u32(data, length, 44, &mut out.constant_bytes)) { return false; }
    if (!rxe_decode_u32(data, length, 48, &mut out.global_offset)) { return false; }
    if (!rxe_decode_u32(data, length, 52, &mut out.global_bytes)) { return false; }
    if (!rxe_decode_u32(data, length, 56, &mut out.layout_offset)) { return false; }
    if (!rxe_decode_u32(data, length, 60, &mut out.layout_bytes)) { return false; }
    if (!rxe_decode_u32(data, length, 64, &mut out.signature_offset)) { return false; }
    if (!rxe_decode_u32(data, length, 68, &mut out.signature_bytes)) { return false; }
    if (!rxe_decode_u32(data, length, 72, &mut out.function_type_count)) { return false; }
    if (!rxe_decode_u32(data, length, 76, &mut out.signature_parameter_count)) { return false; }
    if (!rxe_decode_u32(data, length, 80, &mut out.function_type_parameter_count)) { return false; }
    if (!rxe_decode_u32(data, length, 84, &mut out.fingerprint_lo)) { return false; }
    if (!rxe_decode_u32(data, length, 88, &mut out.fingerprint_hi)) { return false; }
    if (!rxe_decode_u32(data, length, 92, &mut out.export_count)) { return false; }
    if (!rxe_decode_u32(data, length, 96, &mut out.layout_count)) { return false; }
    if (!rxe_decode_u32(data, length, 100, &mut out.layout_field_count)) { return false; }
    out.block_count = 0;
    return true;
}

fn rxe_decode_geometry(i64 data, i64 length, RxeBinaryHeader&mut header) -> bool {
    if (header.header_bytes != 104) { return false; }
    i64 function_bytes = header.function_count * 16;
    if (header.code_offset != header.header_bytes + function_bytes) { return false; }
    if (header.code_bytes != header.instruction_count * 8) { return false; }
    if (header.constant_offset != header.code_offset + header.code_bytes) { return false; }
    if (header.constant_bytes != header.constant_count * 8) { return false; }
    if (header.global_offset != header.constant_offset + header.constant_bytes) { return false; }
    if (header.global_bytes != header.global_count * 16) { return false; }
    if (header.layout_offset != header.global_offset + header.global_bytes) { return false; }
    if (header.layout_bytes != header.layout_count * 16 + header.layout_field_count * 16) { return false; }
    if (header.signature_offset != header.layout_offset + header.layout_bytes) { return false; }
    i64 expected_signature = header.function_count * 32 + header.function_type_count * 16 +
        header.signature_parameter_count * 16 + header.function_type_parameter_count * 16;
    if (header.signature_bytes != expected_signature) { return false; }
    i64 export_offset = header.signature_offset + header.signature_bytes;
    i64 block_offset = export_offset + header.export_count * 24;
    if (block_offset < 0 || block_offset > length) { return false; }

    i64 function = 0;
    i64 expected_code = 0;
    i64 expected_block = 0;
    while (function < header.function_count) {
        i64 record = header.header_bytes + function * 16;
        i64 code_start = 0; i64 code_count = 0; i64 frame_slots = 0; i64 block_count = 0;
        if (!rxe_decode_u32(data, length, record, &mut code_start) || !rxe_decode_u32(data, length, record + 4, &mut code_count) ||
            !rxe_decode_u32(data, length, record + 8, &mut frame_slots) || !rxe_decode_u16(data, length, record + 14, &mut block_count)) { return false; }
        if (code_start != expected_code || code_start + code_count > header.instruction_count) { return false; }
        expected_code += code_count;
        expected_block += block_count;
        function += 1;
    }
    if (expected_code != header.instruction_count) { return false; }
    header.block_count = expected_block;
    if (block_offset + header.block_count * 16 != length) { return false; }
    return true;
}


fn rxe_decode_selector_mix(i64 hash, i64 value, i64 prime) -> i64 {
    hash = hash ^ (value & 4294967295);
    return (hash * prime) & 4294967295;
}

fn rxe_decode_verify_features(i64 data, i64 length, RxeBinaryHeader& header) -> bool {
    i64 expected = 0;
    i64 ip = 0;
    while (ip < header.instruction_count) {
        i64 op = 0;
        if (!rxe_decode_u8(data, length, header.code_offset + ip * 8, &mut op)) { return false; }
        expected = expected | rxe_opcode_feature(op);
        ip += 1;
    }
    return expected == header.feature_flags;
}

fn rxe_decode_verify_layouts(i64 data, i64 length, RxeBinaryHeader& header) -> bool {
    i64 expected_field = 0;
    i64 layout = 0;
    while (layout < header.layout_count) {
        i64 record = header.layout_offset + layout * 16;
        i64 kind = 0; i64 first = 0; i64 count = 0; i64 slots = 0;
        if (!rxe_decode_u32(data, length, record, &mut kind) || !rxe_decode_u32(data, length, record + 4, &mut first) ||
            !rxe_decode_u32(data, length, record + 8, &mut count) || !rxe_decode_u32(data, length, record + 12, &mut slots)) { return false; }
        if (kind > 2 || first != expected_field || first + count > header.layout_field_count || slots == 0) { return false; }
        expected_field += count;
        layout += 1;
    }
    if (expected_field != header.layout_field_count) { return false; }
    i64 fields = header.layout_offset + header.layout_count * 16;
    i64 field = 0;
    while (field < header.layout_field_count) {
        i64 record = fields + field * 16;
        i64 nested = 0; i64 flags = 0;
        if (!rxe_decode_u32(data, length, record + 4, &mut nested) || !rxe_decode_u32(data, length, record + 12, &mut flags)) { return false; }
        if (nested != 4294967295 && nested >= header.layout_count) { return false; }
        if ((flags & ~15) != 0) { return false; }
        field += 1;
    }
    return true;
}

fn rxe_decode_callable_selector(i64 data, i64 length, RxeBinaryHeader& header, i64 function, i64&mut lo_out, i64&mut hi_out) -> bool {
    if (function < 0 || function >= header.function_count) { return false; }
    i64 direct = header.signature_offset + function * 32;
    i64 start = 0; i64 count = 0; i64 return_flags = 0; i64 return_type = 0; i64 return_nested = 0;
    i64 name_hash = 0; i64 abi = 0;
    if (!rxe_decode_u32(data, length, direct, &mut start) || !rxe_decode_u16(data, length, direct + 4, &mut count) ||
        !rxe_decode_u16(data, length, direct + 6, &mut return_flags) || !rxe_decode_u32(data, length, direct + 8, &mut return_type) ||
        !rxe_decode_u32(data, length, direct + 12, &mut return_nested) || !rxe_decode_u32(data, length, direct + 16, &mut name_hash) ||
        !rxe_decode_u16(data, length, direct + 28, &mut abi)) { return false; }
    if (start + count > header.signature_parameter_count) { return false; }
    i64 lo = 2166136261;
    i64 hi = 2246822519;
    lo = rxe_decode_selector_mix(lo, name_hash, 16777619);
    hi = rxe_decode_selector_mix(hi, name_hash, 3266489917);
    lo = rxe_decode_selector_mix(lo, abi, 16777619);
    hi = rxe_decode_selector_mix(hi, abi, 3266489917);
    lo = rxe_decode_selector_mix(lo, return_type, 16777619);
    lo = rxe_decode_selector_mix(lo, return_nested, 16777619);
    lo = rxe_decode_selector_mix(lo, return_flags, 16777619);
    hi = rxe_decode_selector_mix(hi, return_type, 3266489917);
    hi = rxe_decode_selector_mix(hi, return_nested, 3266489917);
    hi = rxe_decode_selector_mix(hi, return_flags, 3266489917);
    i64 parameters = header.signature_offset + header.function_count * 32 + header.function_type_count * 16;
    i64 parameter = 0;
    while (parameter < count) {
        i64 record = parameters + (start + parameter) * 16;
        i64 type_kind = 0; i64 nested = 0; i64 extent = 0; i64 flags = 0;
        if (!rxe_decode_u32(data, length, record, &mut type_kind) || !rxe_decode_u32(data, length, record + 4, &mut nested) ||
            !rxe_decode_u32(data, length, record + 8, &mut extent) || !rxe_decode_u32(data, length, record + 12, &mut flags)) { return false; }
        lo = rxe_decode_selector_mix(lo, type_kind, 16777619);
        lo = rxe_decode_selector_mix(lo, nested, 16777619);
        lo = rxe_decode_selector_mix(lo, extent, 16777619);
        lo = rxe_decode_selector_mix(lo, flags, 16777619);
        hi = rxe_decode_selector_mix(hi, type_kind, 3266489917);
        hi = rxe_decode_selector_mix(hi, nested, 3266489917);
        hi = rxe_decode_selector_mix(hi, extent, 3266489917);
        hi = rxe_decode_selector_mix(hi, flags, 3266489917);
        parameter += 1;
    }
    *lo_out = lo;
    *hi_out = hi;
    return true;
}

fn rxe_decode_verify_signatures_exports(i64 data, i64 length, RxeBinaryHeader& header) -> bool {
    i64 expected_parameter = 0;
    i64 function = 0;
    while (function < header.function_count) {
        i64 directory = header.header_bytes + function * 16;
        i64 directory_args = 0;
        if (!rxe_decode_u8(data, length, directory + 12, &mut directory_args)) { return false; }
        i64 direct = header.signature_offset + function * 32;
        i64 start = 0; i64 count = 0; i64 selector_lo = 0; i64 selector_hi = 0; i64 expected_lo = 0; i64 expected_hi = 0;
        if (!rxe_decode_u32(data, length, direct, &mut start) || !rxe_decode_u16(data, length, direct + 4, &mut count) ||
            !rxe_decode_u32(data, length, direct + 20, &mut selector_lo) || !rxe_decode_u32(data, length, direct + 24, &mut selector_hi)) { return false; }
        if (start != expected_parameter || count != directory_args) { return false; }
        expected_parameter += count;
        if (!rxe_decode_callable_selector(data, length, header, function, &mut expected_lo, &mut expected_hi)) { return false; }
        if (selector_lo != expected_lo || selector_hi != expected_hi) { return false; }
        function += 1;
    }
    if (expected_parameter != header.signature_parameter_count) { return false; }

    i64 function_types = header.signature_offset + header.function_count * 32;
    i64 expected_type_parameter = 0;
    i64 ft = 0;
    while (ft < header.function_type_count) {
        i64 record = function_types + ft * 16;
        i64 start = 0; i64 count = 0;
        if (!rxe_decode_u32(data, length, record, &mut start) || !rxe_decode_u16(data, length, record + 4, &mut count)) { return false; }
        if (start != expected_type_parameter || start + count > header.function_type_parameter_count) { return false; }
        expected_type_parameter += count;
        ft += 1;
    }
    if (expected_type_parameter != header.function_type_parameter_count) { return false; }

    i64 export_offset = header.signature_offset + header.signature_bytes;
    i64 previous_lo = 0; i64 previous_hi = 0; i64 previous_function = -1;
    i64 export = 0;
    while (export < header.export_count) {
        i64 record = export_offset + export * 24;
        i64 target = 0; i64 name_hash = 0; i64 selector_lo = 0; i64 selector_hi = 0; i64 abi = 0; i64 flags = 0;
        if (!rxe_decode_u32(data, length, record, &mut target) || !rxe_decode_u32(data, length, record + 4, &mut name_hash) ||
            !rxe_decode_u32(data, length, record + 8, &mut selector_lo) || !rxe_decode_u32(data, length, record + 12, &mut selector_hi) ||
            !rxe_decode_u16(data, length, record + 16, &mut abi) || !rxe_decode_u16(data, length, record + 18, &mut flags)) { return false; }
        if (target >= header.function_count || flags != 1) { return false; }
        i64 direct = header.signature_offset + target * 32;
        i64 expected_name = 0; i64 expected_lo = 0; i64 expected_hi = 0; i64 expected_abi = 0;
        if (!rxe_decode_u32(data, length, direct + 16, &mut expected_name) || !rxe_decode_u32(data, length, direct + 20, &mut expected_lo) ||
            !rxe_decode_u32(data, length, direct + 24, &mut expected_hi) || !rxe_decode_u16(data, length, direct + 28, &mut expected_abi)) { return false; }
        if (name_hash != expected_name || selector_lo != expected_lo || selector_hi != expected_hi || abi != expected_abi) { return false; }
        if (export > 0) {
            if (previous_hi > selector_hi || (previous_hi == selector_hi && previous_lo > selector_lo) ||
                (previous_hi == selector_hi && previous_lo == selector_lo && previous_function >= target)) { return false; }
            if (previous_hi == selector_hi && previous_lo == selector_lo) { return false; }
        }
        previous_lo = selector_lo; previous_hi = selector_hi; previous_function = target;
        export += 1;
    }
    return true;
}

fn rxe_decode_verify_blocks(i64 data, i64 length, RxeBinaryHeader& header) -> bool {
    i64 export_offset = header.signature_offset + header.signature_bytes;
    i64 block_offset = export_offset + header.export_count * 24;
    i64 global_block = 0;
    i64 function = 0;
    while (function < header.function_count) {
        i64 function_record = header.header_bytes + function * 16;
        i64 code_start = 0; i64 code_count = 0; i64 count = 0;
        if (!rxe_decode_u32(data, length, function_record, &mut code_start) || !rxe_decode_u32(data, length, function_record + 4, &mut code_count) ||
            !rxe_decode_u16(data, length, function_record + 14, &mut count)) { return false; }
        i64 expected_code = code_start;
        i64 local = 0;
        while (local < count) {
            i64 record = block_offset + (global_block + local) * 16;
            i64 start = 0; i64 size = 0; i64 s0 = 0; i64 s1 = 0;
            if (!rxe_decode_u32(data, length, record, &mut start) || !rxe_decode_u32(data, length, record + 4, &mut size) ||
                !rxe_decode_u32(data, length, record + 8, &mut s0) || !rxe_decode_u32(data, length, record + 12, &mut s1)) { return false; }
            if (size == 0 || start != expected_code || start + size > code_start + code_count) { return false; }
            if (s0 != 4294967295 && (s0 < global_block || s0 >= global_block + count)) { return false; }
            if (s1 != 4294967295 && (s1 < global_block || s1 >= global_block + count)) { return false; }
            expected_code += size;
            local += 1;
        }
        if (expected_code != code_start + code_count) { return false; }
        global_block += count;
        function += 1;
    }
    return global_block == header.block_count;
}

fn rxe_decode_verify_semantics(i64 data, i64 length, RxeBinaryHeader& header) -> bool {
    return rxe_decode_verify_features(data, length, header) &&
        rxe_decode_verify_layouts(data, length, header) &&
        rxe_decode_verify_signatures_exports(data, length, header) &&
        rxe_decode_verify_blocks(data, length, header);
}

fn rxe_decode_canonical(i64 data, i64 length, RxeBinaryHeader&mut header) -> bool {
    if (!rxe_decode_header(data, length, &mut header) || !rxe_decode_geometry(data, length, &mut header)) { return false; }
    if ((header.feature_flags & ~63) != 0) { return false; }

    i64 ip = 0;
    while (ip < header.instruction_count) {
        i64 offset = header.code_offset + ip * 8;
        i64 op = 0; i64 d = 0; i64 a = 0; i64 b = 0;
        if (!rxe_decode_u8(data, length, offset, &mut op) || !rxe_decode_u8(data, length, offset + 1, &mut d) ||
            !rxe_decode_u8(data, length, offset + 2, &mut a) || !rxe_decode_u8(data, length, offset + 3, &mut b)) { return false; }
        if (!rxe_opcode_valid(op) || d >= rxe_register_count() || a >= rxe_register_count() || b >= rxe_register_count()) { return false; }
        ip += 1;
    }

    i64 i = 0;
    while (i < header.global_count) {
        i64 reserved = 0;
        if (!rxe_decode_u32(data, length, header.global_offset + i * 16 + 12, &mut reserved) || reserved != 0) { return false; }
        i += 1;
    }
    i = 0;
    while (i < header.function_count) {
        i64 reserved = 0;
        i64 direct_signature = header.signature_offset + i * 32;
        if (!rxe_decode_u16(data, length, direct_signature + 30, &mut reserved) || reserved != 0) { return false; }
        i += 1;
    }
    i64 function_type_parameters = header.signature_offset + header.function_count * 32 + header.function_type_count * 16 + header.signature_parameter_count * 16;
    i = 0;
    while (i < header.function_type_parameter_count) {
        i64 extent = 0;
        if (!rxe_decode_u32(data, length, function_type_parameters + i * 16 + 8, &mut extent) || extent != 0) { return false; }
        i += 1;
    }
    i64 export_offset = header.signature_offset + header.signature_bytes;
    i = 0;
    while (i < header.export_count) {
        i64 reserved = 0;
        if (!rxe_decode_u32(data, length, export_offset + i * 24 + 20, &mut reserved) || reserved != 0) { return false; }
        i += 1;
    }
    return rxe_decode_verify_semantics(data, length, header);
}

fn rxe_decode_reencode(i64 data, i64 length, ForgeWriter&mut out) -> bool {
    RxeBinaryHeader header;
    if (!rxe_decode_canonical(data, length, &mut header)) { return false; }

    // Header.
    rxe_write_u8(out, 82); rxe_write_u8(out, 88); rxe_write_u8(out, 69); rxe_write_u8(out, 0);
    rxe_write_u16(out, rxe_format_version()); rxe_write_u16(out, rxe_isa_version());
    rxe_write_u32(out, header.feature_flags); rxe_write_u32(out, header.function_count);
    rxe_write_u32(out, header.instruction_count); rxe_write_u32(out, header.constant_count);
    rxe_write_u32(out, header.global_count); rxe_write_u32(out, header.header_bytes);
    rxe_write_u32(out, header.code_offset); rxe_write_u32(out, header.code_bytes);
    rxe_write_u32(out, header.constant_offset); rxe_write_u32(out, header.constant_bytes);
    rxe_write_u32(out, header.global_offset); rxe_write_u32(out, header.global_bytes);
    rxe_write_u32(out, header.layout_offset); rxe_write_u32(out, header.layout_bytes);
    rxe_write_u32(out, header.signature_offset); rxe_write_u32(out, header.signature_bytes);
    rxe_write_u32(out, header.function_type_count); rxe_write_u32(out, header.signature_parameter_count);
    rxe_write_u32(out, header.function_type_parameter_count); rxe_write_u32(out, header.fingerprint_lo);
    rxe_write_u32(out, header.fingerprint_hi); rxe_write_u32(out, header.export_count);
    rxe_write_u32(out, header.layout_count); rxe_write_u32(out, header.layout_field_count);

    // Every remaining RXE v7 field is fixed-width and canonical. Decode each
    // scalar and write it again rather than copying the original byte range.
    i64 offset = header.header_bytes;
    while (offset < length) {
        i64 remaining = length - offset;
        if (remaining >= 8 && offset >= header.code_offset && offset < header.constant_offset) {
            i64 a = 0; i64 b = 0; i64 c = 0; i64 d = 0; i64 imm = 0;
            if (!rxe_decode_u8(data, length, offset, &mut a) || !rxe_decode_u8(data, length, offset + 1, &mut b) ||
                !rxe_decode_u8(data, length, offset + 2, &mut c) || !rxe_decode_u8(data, length, offset + 3, &mut d) ||
                !rxe_decode_u32(data, length, offset + 4, &mut imm)) { return false; }
            rxe_write_u8(out, a); rxe_write_u8(out, b); rxe_write_u8(out, c); rxe_write_u8(out, d); rxe_write_u32(out, imm);
            offset += 8;
        } else {
            // Non-code sections are records composed entirely from little-endian
            // u16/u32/u64 fields. Re-emitting bytewise after canonical decoding
            // checks above preserves their exact representation without relying
            // on host alignment or native structure layout.
            i64 byte = 0;
            if (!rxe_decode_u8(data, length, offset, &mut byte)) { return false; }
            rxe_write_u8(out, byte);
            offset += 1;
        }
    }
    return !out.failed && out.length == length;
}

fn rxe_decode_roundtrip_bytes(i64 data, i64 length) -> bool {
    ForgeWriter encoded;
    writer_init(&mut encoded);
    bool ok = rxe_decode_reencode(data, length, &mut encoded);
    if (ok && encoded.length == length) {
        i64 i = 0;
        while (i < length) {
            if (raz_rt_load_u8(encoded.data + i) != raz_rt_load_u8(data + i)) { ok = false; break; }
            i += 1;
        }
    } else {
        ok = false;
    }
    writer_destroy(&mut encoded);
    return ok;
}

fn rxe_module_serialized_size(RxeModule& module) -> i64 {
    i64 signature_bytes = module.function_count * 32 + module.function_type_count * 16 +
        module.signature_parameter_count * 16 + module.function_type_parameter_count * 16;
    return 104 + module.function_count * 16 + module.instruction_count * 8 + module.constant_count * 8 +
        module.global_count * 16 + module.layout_count * 16 + module.layout_field_count * 16 +
        signature_bytes + module.export_count * 24 + module.block_count * 16;
}

fn rxe_validate_written_module(i64 path, i64 path_length, RxeModule& module) -> bool {
    i64 capacity = rxe_module_serialized_size(module);
    if (capacity <= 0) { return false; }
    i64 bytes = raz_compiler_rt_arena_create(capacity + 1);
    if (bytes == 0) { return false; }
    i64 length = raz_compiler_rt_read_ascii(path, path_length, bytes, capacity + 1);
    bool ok = length == capacity && rxe_decode_roundtrip_bytes(bytes, length);
    raz_compiler_rt_arena_destroy(bytes);
    return ok;
}
