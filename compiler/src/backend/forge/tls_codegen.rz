namespace raz_compiler_backend_forge_tls_codegen;
public import raz_compiler_backend_forge_symbol_writer;
// Forge TLS lowering helpers shared by textual and structured backends.
fn writer_global_address_opcode(ForgeWriter&mut out, bool thread_local_global) {
  if (thread_local_global) {
    i64 tls_address[11] = [116, 108, 115, 46, 97, 100, 100, 114, 101, 115, 115];

    writer_chars(out, &tls_address, 11);
  } else {
    i64 global_address[14] = [103, 108, 111, 98, 97, 108, 46, 97, 100, 100, 114, 101, 115, 115];

    writer_chars(out, &global_address, 14);
  }
}
