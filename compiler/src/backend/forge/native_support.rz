namespace raz_compiler_backend_forge_native_support;
public import raz_compiler_backend_forge_native_shape;
// Parser-free Forge lowering for the primitive scalar MIR surface. This module
// talks only to the stable Forge C ABI; all decisions about Raz types, symbols,
// MIR opcodes, control flow, external declarations, and calling structure remain
// in Raz. Integer and floating-point primitives share this path.
fn forge_native_scratch_init(ForgeWriter&mut out) -> bool {
  out.capacity = 512;
  out.data = raz_compiler_rt_arena_create(out.capacity);
  out.length = 0;
  out.failed = out.data == 0;
  return !out.failed;
}

fn forge_native_scratch_reset(ForgeWriter&mut out) {
  out.length = 0;
  out.failed = out.data == 0;
}

fn forge_native_type(i64 type_kind) -> i64 {
  // Payload-bearing enums retain their concrete HIR identity as 1024 + enum index.
  // MIR carries enum values as pointers to their native payload image.
  if (
  (type_kind >= 1024 && type_kind < 1280) ||
  type_kind == 12 ||
  type_kind == 13 ||
  type_kind == 14 ||
  type_kind == 15 ||
  (type_kind >= 16 && type_kind <= 18)
  ) {
    return 8;
  }
  if (type_kind == 1) {
    return 7;
  }
  if (type_kind == 11) {
    return 6;
  }

  i64 width = primitive_type_width(type_kind);

  if (width == 8) {
    return 2;
  }
  if (width == 16) {
    return 3;
  }
  if (width == 32) {
    return 4;
  }
  return 5;
}

fn forge_native_writer_block_name(ForgeWriter&mut out, i64 index) {
  writer_put(out, 98);
  writer_put(out, 98);
  writer_decimal(out, index);
}

fn forge_native_writer_word(ForgeWriter&mut out, i64 word) {
  if (word == 1) {
    i64 text[5] = [99, 111, 110, 115, 116];

    writer_chars(out, &text, 5);
  } else if (word == 2) {
    i64 text[4] = [99, 111, 112, 121];

    writer_chars(out, &text, 4);
  } else if (word == 3) {
    i64 text[4] = [99, 97, 108, 108];

    writer_chars(out, &text, 4);
  } else if (word == 4) {
    i64 text[6] = [115, 101, 108, 101, 99, 116];

    writer_chars(out, &text, 6);
  } else if (word == 5) {
    i64 text[6] = [114, 101, 116, 117, 114, 110];

    writer_chars(out, &text, 6);
  } else if (word == 6) {
    i64 text[4] = [106, 117, 109, 112];

    writer_chars(out, &text, 4);
  } else if (word == 7) {
    i64 text[6] = [98, 114, 97, 110, 99, 104];

    writer_chars(out, &text, 6);
  } else if (word == 8) {
    i64 text[11] = [115, 116, 97, 99, 107, 46, 97, 108, 108, 111, 99];

    writer_chars(out, &text, 11);
  } else if (word == 9) {
    i64 text[4] = [108, 111, 97, 100];

    writer_chars(out, &text, 4);
  } else if (word == 10) {
    i64 text[5] = [115, 116, 111, 114, 101];

    writer_chars(out, &text, 5);
  } else if (word == 11) {
    i64 text[14] = [103, 108, 111, 98, 97, 108, 46, 97, 100, 100, 114, 101, 115, 115];

    writer_chars(out, &text, 14);
  } else if (word == 12) {
    i64 text[10] = [112, 116, 114, 46, 111, 102, 102, 115, 101, 116];

    writer_chars(out, &text, 10);
  } else if (word == 13) {
    i64 text[11] = [109, 101, 109, 111, 114, 121, 46, 99, 111, 112, 121];

    writer_chars(out, &text, 11);
  } else if (word == 14) {
    i64 text[20] = [115, 116, 114, 117, 99, 116, 46, 102, 105, 101, 108, 100, 46, 97, 100, 100, 114, 101, 115, 115];

    writer_chars(out, &text, 20);
  } else if (word == 15) {
    i64 text[21] = [97, 114, 114, 97, 121, 46, 101, 108, 101, 109, 101, 110, 116, 46, 97, 100, 100, 114, 101, 115, 115];

    writer_chars(out, &text, 21);
  } else if (word == 16) {
    i64 text[21] = [97, 103, 103, 114, 101, 103, 97, 116, 101, 46, 99, 111, 112, 121, 46, 115, 116, 114, 117, 99, 116];

    writer_chars(out, &text, 21);
  } else if (word == 17) {
    i64 text[20] = [97, 103, 103, 114, 101, 103, 97, 116, 101, 46, 99, 111, 112, 121, 46, 97, 114, 114, 97, 121];

    writer_chars(out, &text, 20);
  } else if (word == 18) {
    i64 text[21] = [97, 103, 103, 114, 101, 103, 97, 116, 101, 46, 122, 101, 114, 111, 46, 115, 116, 114, 117, 99, 116];

    writer_chars(out, &text, 21);
  } else if (word == 19) {
    i64 text[20] = [97, 103, 103, 114, 101, 103, 97, 116, 101, 46, 122, 101, 114, 111, 46, 97, 114, 114, 97, 121];

    writer_chars(out, &text, 20);
  } else if (word == 20) {
    i64 text[11] = [116, 108, 115, 46, 97, 100, 100, 114, 101, 115, 115];

    writer_chars(out, &text, 11);
  }
}

fn forge_native_append_operation(
i64 block,
ForgeWriter&mut result,
ForgeWriter&mut opcode,
i64 type_kind,
) -> i64 {
  i64 result_data = 0;

  if (result.length > 0) {
    result_data = result.data;
  }
  return raz_compiler_forge_block_append_operation_i64(
  block,
  result_data,
  result.length,
  opcode.data,
  opcode.length,
  type_kind,
  );
}

fn forge_native_add_register_operand(
i64 block,
i64 operation,
ForgeWriter&mut scratch,
i64 register_index,
) -> bool {
  forge_native_scratch_reset(scratch);
  writer_register(scratch, register_index);
  return raz_compiler_forge_operation_add_operand_i64(block, operation, scratch.data, scratch.length) != 0;
}

fn forge_native_add_parameter_operand(
i64 block,
i64 operation,
ForgeWriter&mut scratch,
i64 parameter_index,
) -> bool {
  forge_native_scratch_reset(scratch);
  writer_parameter(scratch, parameter_index);
  return raz_compiler_forge_operation_add_operand_i64(block, operation, scratch.data, scratch.length) != 0;
}

fn forge_native_add_literal_operand(i64 block, i64 operation, ForgeWriter&mut scratch, i64 value) -> bool {
  forge_native_scratch_reset(scratch);
  writer_decimal(scratch, value);
  return raz_compiler_forge_operation_add_operand_i64(block, operation, scratch.data, scratch.length) != 0;
}

fn forge_native_add_function_operand(
i64 block,
i64 operation,
ForgeWriter&mut scratch,
Source& source,
HirModule& hir,
i64 function_index,
) -> bool {
  forge_native_scratch_reset(scratch);
  writer_function_name(scratch, source, hir, function_index);
  return raz_compiler_forge_operation_add_operand_i64(block, operation, scratch.data, scratch.length) != 0;
}

fn forge_native_writer_runtime_name(ForgeWriter&mut out, i64 runtime_kind, bool symbol) {
  if (symbol) {
    writer_put(out, 64);
  }
  if (runtime_kind == 1) {
    i64 text[12] = [114, 97, 122, 95, 114, 116, 95, 97, 108, 108, 111, 99];

    writer_chars(out, &text, 12);
  } else if (runtime_kind == 2) {
    i64 text[14] = [114, 97, 122, 95, 114, 116, 95, 100, 101, 97, 108, 108, 111, 99];

    writer_chars(out, &text, 14);
  } else if (runtime_kind == 3) {
    i64 text[13] = [114, 97, 122, 95, 114, 116, 95, 109, 101, 109, 99, 112, 121];

    writer_chars(out, &text, 13);
  } else if (runtime_kind == 4) {
    i64 text[29] = [114, 97, 122, 95, 114, 116, 95, 99, 97, 108, 108, 97, 98, 108, 101, 95, 99, 114, 101, 97, 116, 101, 95, 101, 114, 97, 115, 101, 100];

    writer_chars(out, &text, 29);
  } else if (runtime_kind == 5) {
    i64 text[29] = [114, 97, 122, 95, 114, 116, 95, 99, 97, 108, 108, 97, 98, 108, 101, 95, 105, 110, 118, 111, 107, 101, 95, 101, 114, 97, 115, 101, 100];

    writer_chars(out, &text, 29);
  } else if (runtime_kind == 6) {
    i64 text[29] = [114, 97, 122, 95, 114, 116, 95, 99, 97, 108, 108, 97, 98, 108, 101, 95, 99, 108, 111, 110, 101, 95, 101, 114, 97, 115, 101, 100, 0];

    writer_chars(out, &text, 29);
  } else {
    i64 text[30] = [114, 97, 122, 95, 114, 116, 95, 99, 97, 108, 108, 97, 98, 108, 101, 95, 100, 101, 115, 116, 114, 111, 121, 95, 101, 114, 97, 115, 101, 100];

    writer_chars(out, &text, 30);
  }
}

fn forge_native_add_runtime_operand(
i64 block,
i64 operation,
ForgeWriter&mut scratch,
i64 runtime_kind,
) -> bool {
  forge_native_scratch_reset(scratch);
  forge_native_writer_runtime_name(scratch, runtime_kind, true);
  return raz_compiler_forge_operation_add_operand_i64(block, operation, scratch.data, scratch.length) != 0;
}

fn forge_native_writer_callable_adapter_name(
ForgeWriter&mut out,
i64 closure_function,
i64 instruction,
bool symbol,
) {
  if (symbol) {
    writer_put(out, 64);
  }

  i64 prefix[23] = [95, 95, 114, 97, 122, 95, 99, 97, 108, 108, 97, 98, 108, 101, 95, 97, 100, 97, 112, 116, 101, 114, 95];

  writer_chars(out, &prefix, 23);
  writer_decimal(out, closure_function);
  writer_put(out, 95);
  writer_decimal(out, instruction);
}

fn forge_native_writer_callable_drop_name(
ForgeWriter&mut out,
i64 closure_function,
i64 instruction,
bool symbol,
) {
  if (symbol) {
    writer_put(out, 64);
  }

  i64 prefix[20] = [95, 95, 114, 97, 122, 95, 99, 97, 108, 108, 97, 98, 108, 101, 95, 100, 114, 111, 112, 95];

  writer_chars(out, &prefix, 20);
  writer_decimal(out, closure_function);
  writer_put(out, 95);
  writer_decimal(out, instruction);
}

fn forge_native_runtime_parameter_type(i64 runtime_kind, i64 parameter) -> i64 {
  if (runtime_kind == 1) {
    return 5;
  }
  if (runtime_kind == 2) {
    return 8;
  }
  if (runtime_kind == 3) {
    if (parameter < 2) {
      return 8;
    }
    return 5;
  }
  if (runtime_kind == 4) {
    if (parameter < 4) {
      return 8;
    }
    if (parameter == 4) {
      return 4;
    }
    return 5;
  }
  if (runtime_kind == 5) {
    if (parameter == 0 || parameter == 2 || parameter == 4) {
      return 8;
    }
    return 5;
  }
  return 8;
}

fn forge_native_runtime_parameter_count(i64 runtime_kind) -> i64 {
  if (runtime_kind == 1 || runtime_kind == 2 || runtime_kind == 6 || runtime_kind == 7) {
    return 1;
  }
  if (runtime_kind == 3) {
    return 3;
  }
  if (runtime_kind == 4) {
    return 8;
  }
  return 6;
}

fn forge_native_runtime_return_type(i64 runtime_kind) -> i64 {
  if (runtime_kind == 1 || runtime_kind == 4 || runtime_kind == 6) {
    return 8;
  }
  if (runtime_kind == 5) {
    return 4;
  }
  return 0;
}

fn forge_native_emit_callable_runtime_declarations(
i64 session,
ForgeWriter&mut name,
ForgeWriter&mut parameter_name,
) -> bool {
  i64 runtime_kind = 1;

  while (runtime_kind <= 7) {
    forge_native_scratch_reset(name);
    forge_native_writer_runtime_name(name, runtime_kind, false);
    i64 function_handle = raz_compiler_forge_session_add_function_i64(
    session,
    name.data,
    name.length,
    forge_native_runtime_return_type(runtime_kind),
    0,
    0,
    0,
    0,
    0,
    -1,
    1,
    0,
    );
    if (
    function_handle == 0 ||
    raz_compiler_forge_function_set_abi_i64(function_handle, 0, 0, 0, 0) == 0
    ) {
      return false;
    }

    i64 count = forge_native_runtime_parameter_count(runtime_kind);
    i64 parameter = 0;

    while (parameter < count) {
      forge_native_scratch_reset(parameter_name);
      writer_parameter(parameter_name, parameter);
      if (
      raz_compiler_forge_function_add_parameter_i64(
      function_handle,
      parameter_name.data,
      parameter_name.length,
      forge_native_runtime_parameter_type(runtime_kind, parameter),
      0,
      0,
      0,
      0,
      0,
      0,
      0,
      ) == 0
      ) {
        return false;
      }
      parameter += 1;
    }
    runtime_kind += 1;
  }
  return true;
}

fn forge_native_writer_signature_name(ForgeWriter&mut out, i64 signature, bool symbol) {
  if (symbol) {
    writer_put(out, 64);
  }

  i64 prefix[12] = [95, 95, 114, 97, 122, 95, 102, 110, 115, 105, 103, 95];

  writer_chars(out, &prefix, 12);
  writer_decimal(out, signature);
}

fn forge_native_writer_string_name(ForgeWriter&mut out, i64 instruction, bool symbol) {
  if (symbol) {
    writer_put(out, 64);
  }

  i64 prefix[13] = [95, 95, 114, 97, 122, 95, 115, 116, 114, 105, 110, 103, 95];

  writer_chars(out, &prefix, 13);
  writer_decimal(out, instruction);
}

fn forge_native_writer_slice_name(ForgeWriter&mut out) {
  i64 text[11] = [64, 95, 95, 114, 97, 122, 95, 115, 108, 105, 99];

  writer_chars(out, &text, 11);
  writer_put(out, 101);
}

fn forge_native_emit_slice_structure(i64 session, ForgeWriter&mut name, ForgeWriter&mut field_name) -> bool {
  forge_native_scratch_reset(name);
  forge_native_writer_slice_name(name);

  i64 structure_handle = raz_compiler_forge_session_add_struct_i64(session, name.data, name.length, 0);

  if (structure_handle == 0) {
    return false;
  }
  forge_native_scratch_reset(field_name);

  i64 data_name[4] = [100, 97, 116, 97];

  writer_chars(field_name, &data_name, 4);
  if (
  raz_compiler_forge_struct_add_field_i64(
  session,
  structure_handle,
  field_name.data,
  field_name.length,
  8,
  0,
  0,
  0,
  ) == 0
  ) {
    return false;
  }
  forge_native_scratch_reset(field_name);

  i64 length_name[6] = [108, 101, 110, 103, 116, 104];

  writer_chars(field_name, &length_name, 6);
  return raz_compiler_forge_struct_add_field_i64(
  session,
  structure_handle,
  field_name.data,
  field_name.length,
  5,
  0,
  0,
  0,
  ) != 0;
}

fn forge_native_signatures_equivalent(HirModule& hir, i64 left, i64 right, i64 depth) -> bool {
  if (left == right) {
    return true;
  }
  if (
  left < 0 ||
  right < 0 ||
  left >= hir.function_type_count ||
  right >= hir.function_type_count ||
  depth > 16
  ) {
    return false;
  }
  // Forge signature identity is an ABI/codegen property. Raz may intern the
  // same callable shape more than once while preserving source-level type
  // metadata, so compare the effective structured-Forge types rather than
  // the raw HIR bookkeeping slots. This keeps callback parameters,
  // func.address and call.indirect on one canonical signature symbol.

  i64 left_return_type = raz_compiler_rt_arena_get(hir.function_type_return_types, left);
  i64 right_return_type = raz_compiler_rt_arena_get(hir.function_type_return_types, right);

  if (
  raz_compiler_rt_arena_get(hir.function_type_return_references, left) != 0 ||
  raz_compiler_rt_arena_get(hir.function_type_return_slices, left) != 0
  ) {
    left_return_type = 12;
  } else if (raz_compiler_rt_arena_get(hir.function_type_return_function_types, left) >= 0) {
    left_return_type = 14;
  }
  if (
  raz_compiler_rt_arena_get(hir.function_type_return_references, right) != 0 ||
  raz_compiler_rt_arena_get(hir.function_type_return_slices, right) != 0
  ) {
    right_return_type = 12;
  } else if (raz_compiler_rt_arena_get(hir.function_type_return_function_types, right) >= 0) {
    right_return_type = 14;
  }
  if (
  left_return_type != right_return_type ||
  raz_compiler_rt_arena_get(
  hir.function_type_return_slices,
  left,
  ) != raz_compiler_rt_arena_get(hir.function_type_return_slices, right)
  ) {
    return false;
  }

  i64 left_return_function = raz_compiler_rt_arena_get(hir.function_type_return_function_types, left);
  i64 right_return_function = raz_compiler_rt_arena_get(hir.function_type_return_function_types, right);

  if ((left_return_function < 0) != (right_return_function < 0)) {
    return false;
  }
  if (
  left_return_function >= 0 &&
  !forge_native_signatures_equivalent(hir, left_return_function, right_return_function, depth + 1)
  ) {
    return false;
  }

  i64 left_count = raz_compiler_rt_arena_get(hir.function_type_parameter_counts, left);
  i64 right_count = raz_compiler_rt_arena_get(hir.function_type_parameter_counts, right);

  if (left_count != right_count) {
    return false;
  }

  i64 left_start = raz_compiler_rt_arena_get(hir.function_type_parameter_starts, left);
  i64 right_start = raz_compiler_rt_arena_get(hir.function_type_parameter_starts, right);
  i64 parameter = 0;

  while (parameter < left_count) {
    i64 a = left_start + parameter;
    i64 b = right_start + parameter;
    i64 left_type = raz_compiler_rt_arena_get(hir.function_type_parameter_types, a);
    i64 right_type = raz_compiler_rt_arena_get(hir.function_type_parameter_types, b);

    if (
    raz_compiler_rt_arena_get(hir.function_type_parameter_references, a) != 0 ||
    raz_compiler_rt_arena_get(hir.function_type_parameter_slices, a) != 0
    ) {
      left_type = 12;
    } else if (raz_compiler_rt_arena_get(hir.function_type_parameter_function_types, a) >= 0) {
      left_type = 14;
    }
    if (
    raz_compiler_rt_arena_get(hir.function_type_parameter_references, b) != 0 ||
    raz_compiler_rt_arena_get(hir.function_type_parameter_slices, b) != 0
    ) {
      right_type = 12;
    } else if (raz_compiler_rt_arena_get(hir.function_type_parameter_function_types, b) >= 0) {
      right_type = 14;
    }
    if (
    left_type != right_type ||
    raz_compiler_rt_arena_get(
    hir.function_type_parameter_slices,
    a,
    ) != raz_compiler_rt_arena_get(hir.function_type_parameter_slices, b)
    ) {
      return false;
    }

    i64 left_nested = raz_compiler_rt_arena_get(hir.function_type_parameter_function_types, a);
    i64 right_nested = raz_compiler_rt_arena_get(hir.function_type_parameter_function_types, b);

    if ((left_nested < 0) != (right_nested < 0)) {
      return false;
    }
    if (
    left_nested >= 0 &&
    !forge_native_signatures_equivalent(hir, left_nested, right_nested, depth + 1)
    ) {
      return false;
    }
    parameter += 1;
  }
  return true;
}

fn forge_native_canonical_signature(HirModule& hir, i64 signature) -> i64 {
  if (signature < 0 || signature >= hir.function_type_count) {
    return signature;
  }

  i64 candidate = 0;

  while (candidate < signature) {
    if (forge_native_signatures_equivalent(hir, candidate, signature, 0)) {
      return candidate;
    }
    candidate += 1;
  }
  return signature;
}

fn forge_native_add_signature_operand(
i64 block,
i64 operation,
ForgeWriter&mut scratch,
HirModule& hir,
i64 signature,
) -> bool {
  forge_native_scratch_reset(scratch);
  forge_native_writer_signature_name(scratch, forge_native_canonical_signature(hir, signature), true);
  return raz_compiler_forge_operation_add_operand_i64(block, operation, scratch.data, scratch.length) != 0;
}

fn forge_native_add_string_operand(
i64 block,
i64 operation,
ForgeWriter&mut scratch,
i64 instruction,
) -> bool {
  forge_native_scratch_reset(scratch);
  forge_native_writer_string_name(scratch, instruction, true);
  return raz_compiler_forge_operation_add_operand_i64(block, operation, scratch.data, scratch.length) != 0;
}

fn forge_native_decode_string_literal(
ForgeWriter&mut out,
Source& source,
MirModule& mir,
i64 instruction,
) -> bool {
  forge_native_scratch_reset(out);

  i64 offset = raz_compiler_rt_arena_get(mir.op_a, instruction);
  i64 length = raz_compiler_rt_arena_get(mir.op_b, instruction);
  bool raw_slice = raz_compiler_rt_arena_get(mir.op_c, instruction) != 0;

  if (offset < 0 || length < 0) {
    return false;
  }

  i64 index = 0;
  i64 end = length;

  if (!raw_slice) {
    if (length < 2) {
      writer_put(out, 0);
      return !out.failed;
    }
    index = 1;
    end = length - 1;
  }
  while (index < end) {
    i64 byte = source_byte(source, offset + index);

    if (!raw_slice && byte == 92 && index + 1 < end) {
      i64 escaped = source_byte(source, offset + index + 1);

      if (escaped == 110) {
        byte = 10;
      } else if (escaped == 114) {
        byte = 13;
      } else if (escaped == 116) {
        byte = 9;
      } else if (escaped == 48) {
        byte = 0;
      } else {
        byte = escaped;
      }
      index += 2;
    } else {
      index += 1;
    }
    writer_put(out, byte);
  }
  writer_put(out, 0);
  return !out.failed;
}

fn forge_native_add_successor(i64 block, i64 operation, ForgeWriter&mut scratch, i64 target) -> bool {
  forge_native_scratch_reset(scratch);
  forge_native_writer_block_name(scratch, target);
  return raz_compiler_forge_operation_add_successor_i64(
  block,
  operation,
  scratch.data,
  scratch.length,
  ) != 0;
}

fn forge_native_add_successor_argument(
i64 block,
i64 operation,
i64 successor_index,
ForgeWriter&mut scratch,
i64 value,
) -> bool {
  forge_native_scratch_reset(scratch);
  writer_register(scratch, value);
  return raz_compiler_forge_operation_add_successor_argument_i64(
  block,
  operation,
  successor_index,
  scratch.data,
  scratch.length,
  ) != 0;
}

fn forge_native_primitive_type_supported(i64 type_kind) -> bool {
  return primitive_type_is_integer(type_kind) || primitive_type_is_float(type_kind);
}

fn forge_native_scalar_storage_size(i64 type_kind) -> i64 {
  i64 width = primitive_type_width(type_kind);

  if (width <= 0) {
    return 0;
  }

  i64 size = (width + 7) / 8;

  if (size < 1) {
    return 1;
  }
  if (size > 8) {
    return 8;
  }
  return size;
}

fn forge_native_nested_structure_supported(HirModule& hir, i64 structure, i64 depth) -> bool {
  if (structure < 0 || structure >= hir.struct_count || depth > 32) {
    return false;
  }

  i64 first = raz_compiler_rt_arena_get(hir.struct_field_starts, structure);
  i64 count = raz_compiler_rt_arena_get(hir.struct_field_counts, structure);

  if (count <= 0) {
    return false;
  }

  i64 field = 0;

  while (field < count) {
    i64 metadata = first + field;

    if (
    raz_compiler_rt_arena_get(hir.struct_field_references, metadata) != 0 ||
    raz_compiler_rt_arena_get(hir.struct_field_function_types, metadata) >= 0
    ) {
      field += 1;
      continue;
    }
    if (raz_compiler_rt_arena_get(hir.struct_field_slices, metadata) != 0) {
      field += 1;
      continue;
    }

    i64 nested = raz_compiler_rt_arena_get(hir.struct_field_type_structs, metadata);
    i64 extent = raz_compiler_rt_arena_get(hir.struct_field_array_extents, metadata);

    if (extent >= 0) {
      if (extent <= 0) {
        return false;
      }
      if (nested >= 0 && !forge_native_nested_structure_supported(hir, nested, depth + 1)) {
        return false;
      }
      if (
      nested < 0 &&
      !forge_native_primitive_type_supported(
      raz_compiler_rt_arena_get(hir.struct_field_types, metadata),
      )
      ) {
        return false;
      }
    } else if (nested >= 0) {
      if (!forge_native_nested_structure_supported(hir, nested, depth + 1)) {
        return false;
      }
    } else if (
    !forge_native_primitive_type_supported(raz_compiler_rt_arena_get(hir.struct_field_types, metadata))
    ) {
      return false;
    }
    field += 1;
  }
  return true;
}

fn forge_native_flat_return_structure_supported(HirModule& hir, i64 structure) -> bool {
  // Kept under the historical name while the structured backend broadens
  // from flat images to recursively materialized native aggregate layouts.
  return forge_native_nested_structure_supported(hir, structure, 0);
}

fn forge_native_function_type_parameter_type(HirModule& hir, i64 parameter_index) -> i64 {
  if (raz_compiler_rt_arena_get(hir.function_type_parameter_references, parameter_index) != 0) {
    return 12;
  }
  if (raz_compiler_rt_arena_get(hir.function_type_parameter_slices, parameter_index) != 0) {
    return 12;
  }
  i64 parameter_structure = raz_compiler_rt_arena_get(
  hir.function_type_parameter_type_structs,
  parameter_index,
  );
  if (parameter_structure >= 0) {
    if (!forge_native_flat_return_structure_supported(hir, parameter_structure)) {
      return -1;
    }
    return 12;
  }

  i64 type_kind = raz_compiler_rt_arena_get(hir.function_type_parameter_types, parameter_index);

  // Fn/FnMut/FnOnce are erased runtime objects. Their function-type metadata
  // describes dispatch, but the value itself is not a raw callback pointer.
  if (type_kind >= 16 && type_kind <= 18) {
    return 12;
  }
  if (raz_compiler_rt_arena_get(hir.function_type_parameter_function_types, parameter_index) >= 0) {
    return 14;
  }
  if (type_kind == 13) {
    return 13;
  }
  if (!forge_native_primitive_type_supported(type_kind)) {
    return -1;
  }
  return type_kind;
}

fn forge_native_function_type_return_type(HirModule& hir, i64 signature) -> i64 {
  if (raz_compiler_rt_arena_get(hir.function_type_return_references, signature) != 0) {
    return 12;
  }
  if (raz_compiler_rt_arena_get(hir.function_type_return_slices, signature) != 0) {
    return 12;
  }

  i64 return_structure = raz_compiler_rt_arena_get(hir.function_type_return_type_structs, signature);

  if (return_structure >= 0) {
    if (!forge_native_flat_return_structure_supported(hir, return_structure)) {
      return -1;
    }
    return 12;
  }

  i64 type_kind = raz_compiler_rt_arena_get(hir.function_type_return_types, signature);

  if (type_kind >= 16 && type_kind <= 18) {
    return 12;
  }
  if (raz_compiler_rt_arena_get(hir.function_type_return_function_types, signature) >= 0) {
    return 14;
  }
  if (type_kind == 13) {
    return 13;
  }
  if (!forge_native_primitive_type_supported(type_kind)) {
    return -1;
  }
  return type_kind;
}

fn forge_native_function_signature_supported(HirModule& hir, i64 signature) -> bool {
  if (
  signature < 0 ||
  signature >= hir.function_type_count ||
  forge_native_function_type_return_type(hir, signature) < 0
  ) {
    return false;
  }

  i64 start = raz_compiler_rt_arena_get(hir.function_type_parameter_starts, signature);
  i64 count = raz_compiler_rt_arena_get(hir.function_type_parameter_counts, signature);
  i64 index = 0;

  while (index < count) {
    if (forge_native_function_type_parameter_type(hir, start + index) < 0) {
      return false;
    }
    index += 1;
  }
  return true;
}

fn forge_native_emit_function_signatures(
i64 session,
Source& source,
HirModule& hir,
ForgeWriter&mut scratch,
ForgeWriter&mut aggregate_name,
) -> bool {
  i64 signature = 0;

  while (signature < hir.function_type_count) {
    if (!forge_native_function_signature_supported(hir, signature)) {
      signature += 1;
      continue;
    }
    forge_native_scratch_reset(scratch);
    forge_native_writer_signature_name(scratch, signature, false);

    i64 signature_name_data = scratch.data;
    i64 signature_name_length = scratch.length;
    i64 return_type = forge_native_type(forge_native_function_type_return_type(hir, signature));
    i64 return_aggregate_kind = 0;

    forge_native_scratch_reset(aggregate_name);

    i64 return_structure = raz_compiler_rt_arena_get(hir.function_type_return_type_structs, signature);

    if (raz_compiler_rt_arena_get(hir.function_type_return_slices, signature) != 0) {
      return_aggregate_kind = 1;
      forge_native_writer_slice_name(aggregate_name);
    } else if (return_structure >= 0) {
      return_aggregate_kind = 1;
      writer_structure_name(aggregate_name, source, hir, return_structure);
    }

    i64 return_owned = 0;

    if (return_aggregate_kind != 0) {
      return_owned = 1;
    }
    i64 function_handle = raz_compiler_forge_session_add_function_i64(
    session,
    signature_name_data,
    signature_name_length,
    return_type,
    return_aggregate_kind,
    aggregate_name.data,
    aggregate_name.length,
    return_owned,
    0,
    -1,
    0,
    1,
    );
    if (
    function_handle == 0 ||
    raz_compiler_forge_function_set_abi_i64(function_handle, 0, 0, 0, 0) == 0
    ) {
      return false;
    }

    i64 start = raz_compiler_rt_arena_get(hir.function_type_parameter_starts, signature);
    i64 count = raz_compiler_rt_arena_get(hir.function_type_parameter_counts, signature);
    i64 parameter = 0;

    while (parameter < count) {
      i64 parameter_index = start + parameter;

      forge_native_scratch_reset(scratch);
      writer_parameter(scratch, parameter);

      i64 name_data = scratch.data;
      i64 name_length = scratch.length;

      i64 nested_signature = raz_compiler_rt_arena_get(
      hir.function_type_parameter_function_types,
      parameter_index,
      );

      ForgeWriter signature_name;

      if (!forge_native_scratch_init(&mut signature_name)) {
        return false;
      }
      if (nested_signature >= 0) {
        forge_native_writer_signature_name(
        &mut signature_name,
        forge_native_canonical_signature(hir, nested_signature),
        false,
        );
      }

      i64 aggregate_kind = 0;

      forge_native_scratch_reset(aggregate_name);
      i64 parameter_structure = raz_compiler_rt_arena_get(
      hir.function_type_parameter_type_structs,
      parameter_index,
      );
      if (raz_compiler_rt_arena_get(hir.function_type_parameter_slices, parameter_index) != 0) {
        aggregate_kind = 1;
        forge_native_writer_slice_name(aggregate_name);
      } else if (parameter_structure >= 0) {
        aggregate_kind = 1;
        writer_structure_name(aggregate_name, source, hir, parameter_structure);
      }

      i64 parameter_owned = 0;

      if (aggregate_kind != 0) {
        parameter_owned = 1;
      }
      i64 ok = raz_compiler_forge_function_add_parameter_i64(
      function_handle,
      name_data,
      name_length,
      forge_native_type(forge_native_function_type_parameter_type(hir, parameter_index)),
      aggregate_kind,
      aggregate_name.data,
      aggregate_name.length,
      parameter_owned,
      0,
      signature_name.data,
      signature_name.length,
      );
      writer_destroy(&mut signature_name);
      if (ok == 0) {
        return false;
      }
      parameter += 1;
    }
    signature += 1;
  }
  return true;
}
