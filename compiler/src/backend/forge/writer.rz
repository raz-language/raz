public import raz_compiler_mir_interpreter;
// Textual Forge IR writer and the narrow runtime declarations used by generated
// compilers. Raz owns every emitted character so fixed-point output stays deterministic.
extern fn raz_rt_write_ascii_i64(i64&mut path, i64 path_length, i64 data, i64 size) -> i64;
extern fn raz_rt_read_ascii_i64(i64&mut path, i64 path_length, i64 data, i64 capacity) -> i64;
// Compiler-only native boundary. The Raz frontend still owns MIR -> Forge IR
// lowering; this bridge feeds the completed in-memory module directly into the
// linked C++ Forge library for optimization and host object emission.
