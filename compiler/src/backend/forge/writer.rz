public struct ForgeWriter {
  i64 data;
  i64 capacity;
  i64 length;
  bool failed;
}

fn writer_init(ForgeWriter&mut out) {
  out.capacity = 8388608;
  out.data = raz_rt_stage1_arena_create(out.capacity);
  out.length = 0;
  out.failed = out.data == 0;
}

fn writer_destroy(ForgeWriter&mut out) {
  if (out.data != 0) {
    raz_rt_stage1_arena_destroy(out.data);
  }
  out.data = 0;
  out.capacity = 0;
  out.length = 0;
}

fn writer_grow(ForgeWriter&mut out) -> bool {
  if (out.failed) {
    return false;
  }

  i64 next_capacity = out.capacity * 2;

  if (next_capacity <= out.capacity) {
    out.failed = true;
    return false;
  }

  i64 next_data = raz_rt_stage1_arena_create(next_capacity);

  if (next_data == 0) {
    out.failed = true;
    return false;
  }
  if (raz_rt_stage1_arena_copy(next_data, 0, out.data, 0, out.length) != out.length) {
    raz_rt_stage1_arena_destroy(next_data);
    out.failed = true;
    return false;
  }
  raz_rt_stage1_arena_destroy(out.data);
  out.data = next_data;
  out.capacity = next_capacity;
  return true;
}

fn writer_put(ForgeWriter&mut out, i64 code) {
  if (out.failed) {
    return;
  }
  if (out.length >= out.capacity && !writer_grow(out)) {
    return;
  }
  raz_rt_stage1_arena_set(out.data, out.length, code);
  out.length += 1;
}

fn writer_chars(ForgeWriter&mut out, i64[]data, i64 length) {
  i64 index = 0;

  while (index < length) {
    writer_put(out, data[index]);
    index += 1;
  }
}

fn writer_at(ForgeWriter& out, i64 index) -> i64 {
  return raz_rt_stage1_arena_get(out.data, index);
}

fn writer_space(ForgeWriter&mut out) {
  writer_put(out, 32);
}

fn writer_newline(ForgeWriter&mut out) {
  writer_put(out, 10);
}

fn writer_text(ForgeWriter&mut out, Source& source, i64 offset, i64 length) {
  i64 index = 0;

  while (index < length) {
    writer_put(out, source_byte(source, offset + index));
    index += 1;
  }
}

fn writer_decimal(ForgeWriter&mut out, i64 value) {
  if (value == (-9223372036854775807 - 1)) {
    i64 minimum[20] = [45, 57, 50, 50, 51, 51, 55, 50, 48, 51, 54, 56, 53, 52, 55, 55, 53, 56, 48, 56];

    writer_chars(out, &minimum, 20);
    return;
  }
  if (value == 0) {
    writer_put(out, 48);
    return;
  }

  i64 remaining = value;

  if (remaining < 0) {
    writer_put(out, 45);
    remaining = 0 - remaining;
  }

  i64 digits[24];
  i64 count = 0;

  while (remaining > 0) {
    i64 quotient = stage1_div_nonnegative(remaining, 10);

    digits[count] = remaining - quotient * 10;
    count += 1;
    remaining = quotient;
  }
  while (count > 0) {
    count -= 1;
    writer_put(out, 48 + digits[count]);
  }
}

fn writer_register(ForgeWriter&mut out, i64 index) {
  writer_put(out, 37);
  writer_put(out, 114);
  if (index < 0) {
    writer_decimal(out, 999999);
  } else {
    writer_decimal(out, index);
  }
}

fn writer_parameter(ForgeWriter&mut out, i64 index) {
  writer_put(out, 37);
  writer_put(out, 112);
  writer_decimal(out, index);
}

fn writer_synthetic_register(i64 category, i64 index) -> i64 {
  // Synthetic Forge SSA values must live in disjoint namespaces.  MIR
  // instruction ids are capped well below this stride, so compiler growth
  // cannot make one synthetic category collide with another.
  return 10000000 + category * 1000000 + index;
}

fn writer_i8(ForgeWriter&mut out) {
  writer_put(out, 105);
  writer_put(out, 56);
}

fn writer_i16(ForgeWriter&mut out) {
  writer_put(out, 105);
  writer_put(out, 49);
  writer_put(out, 54);
}

fn writer_i32(ForgeWriter&mut out) {
  writer_put(out, 105);
  writer_put(out, 51);
  writer_put(out, 50);
}

fn writer_i64(ForgeWriter&mut out) {
  writer_put(out, 105);
  writer_put(out, 54);
  writer_put(out, 52);
}

fn writer_f32(ForgeWriter&mut out) {
  writer_put(out, 102);
  writer_put(out, 51);
  writer_put(out, 50);
}

fn writer_f64(ForgeWriter&mut out) {
  writer_put(out, 102);
  writer_put(out, 54);
  writer_put(out, 52);
}

fn writer_ptr(ForgeWriter&mut out) {
  writer_put(out, 112);
  writer_put(out, 116);
  writer_put(out, 114);
}

fn writer_void(ForgeWriter&mut out) {
  writer_put(out, 118);
  writer_put(out, 111);
  writer_put(out, 105);
  writer_put(out, 100);
}

fn writer_scalar_type(ForgeWriter&mut out, i64 type_kind) {
  if (type_kind == 12 || type_kind == 13 || type_kind == 14) {
    writer_ptr(out);
    return;
  }
  // Payload-bearing enums are represented by integer arena handles in the
  // self-host runtime. Keep their Forge ABI aligned with construction, field
  // projection, and arena intrinsics instead of spelling the handle as ptr.
  if (hir_type_is_enum(type_kind)) {
    writer_i64(out);
    return;
  }
  if (type_kind == 1) {
    writer_f64(out);
    return;
  }
  if (type_kind == 11) {
    writer_f32(out);
    return;
  }

  i64 width = primitive_type_width(type_kind);

  if (width == 8) {
    writer_i8(out);
  } else if (width == 16) {
    writer_i16(out);
  } else if (width == 32) {
    writer_i32(out);
  } else {
    writer_i64(out);
  }
}

fn writer_keyword_func(ForgeWriter&mut out) {
  writer_put(out, 102);
  writer_put(out, 117);
  writer_put(out, 110);
  writer_put(out, 99);
}

fn writer_keyword_return(ForgeWriter&mut out) {
  writer_put(out, 114);
  writer_put(out, 101);
  writer_put(out, 116);
  writer_put(out, 117);
  writer_put(out, 114);
  writer_put(out, 110);
}

fn writer_instruction_prefix(ForgeWriter&mut out, i64 index) {
  writer_space(out);
  writer_space(out);
  writer_register(out, index);
  writer_space(out);
  writer_put(out, 61);
  writer_space(out);
}

fn writer_numeric_cast_opcode(ForgeWriter&mut out, i64 source_type, i64 target_type) {
  if (source_type == 12 || target_type == 12) {
    if (source_type == target_type) {
      i64 copy_word[4] = [99, 111, 112, 121];

      writer_chars(out, &copy_word, 4);
    } else {
      i64 bitcast_word[7] = [98, 105, 116, 99, 97, 115, 116];

      writer_chars(out, &bitcast_word, 7);
    }
    return;
  }

  bool source_float = primitive_type_is_float(source_type);
  bool target_float = primitive_type_is_float(target_type);

  if (!source_float && !target_float) {
    i64 source_width = primitive_type_width(source_type);
    i64 target_width = primitive_type_width(target_type);

    if (source_width < target_width) {
      if (primitive_type_is_unsigned(source_type)) {
        writer_put(out, 122);
        writer_put(out, 101);
        writer_put(out, 114);
        writer_put(out, 111);
        writer_put(out, 95);
        writer_put(out, 101);
        writer_put(out, 120);
        writer_put(out, 116);
        writer_put(out, 101);
        writer_put(out, 110);
        writer_put(out, 100);
      } else {
        writer_put(out, 115);
        writer_put(out, 105);
        writer_put(out, 103);
        writer_put(out, 110);
        writer_put(out, 95);
        writer_put(out, 101);
        writer_put(out, 120);
        writer_put(out, 116);
        writer_put(out, 101);
        writer_put(out, 110);
        writer_put(out, 100);
      }
    } else if (source_width > target_width) {
      writer_put(out, 116);
      writer_put(out, 114);
      writer_put(out, 117);
      writer_put(out, 110);
      writer_put(out, 99);
      writer_put(out, 97);
      writer_put(out, 116);
      writer_put(out, 101);
    } else {
      writer_put(out, 99);
      writer_put(out, 111);
      writer_put(out, 112);
      writer_put(out, 121);
    }
    return;
  }
  if (!source_float && target_float) {
    writer_put(out, 105);
    writer_put(out, 110);
    writer_put(out, 116);
    writer_put(out, 95);
    writer_put(out, 116);
    writer_put(out, 111);
    writer_put(out, 95);
    writer_put(out, 102);
    writer_put(out, 108);
    writer_put(out, 111);
    writer_put(out, 97);
    writer_put(out, 116);
    writer_put(out, 46);
    if (primitive_type_is_unsigned(source_type)) {
      writer_put(out, 117);
      writer_put(out, 110);
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    } else {
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    }
    return;
  }
  if (source_float && !target_float) {
    writer_put(out, 102);
    writer_put(out, 108);
    writer_put(out, 111);
    writer_put(out, 97);
    writer_put(out, 116);
    writer_put(out, 95);
    writer_put(out, 116);
    writer_put(out, 111);
    writer_put(out, 95);
    writer_put(out, 105);
    writer_put(out, 110);
    writer_put(out, 116);
    writer_put(out, 46);
    if (primitive_type_is_unsigned(target_type)) {
      writer_put(out, 117);
      writer_put(out, 110);
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    } else {
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    }
    return;
  }

  i64 source_width = primitive_type_width(source_type);
  i64 target_width = primitive_type_width(target_type);

  if (source_width < target_width) {
    writer_put(out, 102);
    writer_put(out, 108);
    writer_put(out, 111);
    writer_put(out, 97);
    writer_put(out, 116);
    writer_put(out, 95);
    writer_put(out, 101);
    writer_put(out, 120);
    writer_put(out, 116);
    writer_put(out, 101);
    writer_put(out, 110);
    writer_put(out, 100);
  } else if (source_width > target_width) {
    writer_put(out, 102);
    writer_put(out, 108);
    writer_put(out, 111);
    writer_put(out, 97);
    writer_put(out, 116);
    writer_put(out, 95);
    writer_put(out, 116);
    writer_put(out, 114);
    writer_put(out, 117);
    writer_put(out, 110);
    writer_put(out, 99);
    writer_put(out, 97);
    writer_put(out, 116);
    writer_put(out, 101);
  } else {
    writer_put(out, 99);
    writer_put(out, 111);
    writer_put(out, 112);
    writer_put(out, 121);
  }
}

fn writer_operator(ForgeWriter&mut out, i64 opcode, i64 type_kind) {
  if (opcode == 4) {
    writer_put(out, 97);
    writer_put(out, 100);
    writer_put(out, 100);
  } else if (opcode == 5) {
    writer_put(out, 115);
    writer_put(out, 117);
    writer_put(out, 98);
  } else if (opcode == 6) {
    writer_put(out, 109);
    writer_put(out, 117);
    writer_put(out, 108);
  } else if (opcode == 7) {
    writer_put(out, 100);
    writer_put(out, 105);
    writer_put(out, 118);
    if (!primitive_type_is_float(type_kind)) {
      writer_put(out, 46);
      if (primitive_type_is_unsigned(type_kind)) {
        writer_put(out, 117);
        writer_put(out, 110);
        writer_put(out, 115);
        writer_put(out, 105);
        writer_put(out, 103);
        writer_put(out, 110);
        writer_put(out, 101);
        writer_put(out, 100);
      } else {
        writer_put(out, 115);
        writer_put(out, 105);
        writer_put(out, 103);
        writer_put(out, 110);
        writer_put(out, 101);
        writer_put(out, 100);
      }
    }
  } else if (opcode == 34) {
    writer_put(out, 114);
    writer_put(out, 101);
    writer_put(out, 109);
    writer_put(out, 46);
    if (primitive_type_is_unsigned(type_kind)) {
      writer_put(out, 117);
      writer_put(out, 110);
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    } else {
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    }
  } else if (opcode == 35) {
    writer_put(out, 97);
    writer_put(out, 110);
    writer_put(out, 100);
  } else if (opcode == 36) {
    writer_put(out, 111);
    writer_put(out, 114);
  } else if (opcode == 37) {
    writer_put(out, 120);
    writer_put(out, 111);
    writer_put(out, 114);
  } else if (opcode == 38) {
    writer_put(out, 115);
    writer_put(out, 104);
    writer_put(out, 108);
  } else {
    writer_put(out, 115);
    writer_put(out, 104);
    writer_put(out, 114);
    writer_put(out, 46);
    if (primitive_type_is_unsigned(type_kind)) {
      writer_put(out, 117);
      writer_put(out, 110);
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    } else {
      writer_put(out, 115);
      writer_put(out, 105);
      writer_put(out, 103);
      writer_put(out, 110);
      writer_put(out, 101);
      writer_put(out, 100);
    }
  }
}

fn writer_compare(ForgeWriter&mut out, i64 opcode, i64 type_kind) {
  writer_put(out, 99);
  writer_put(out, 109);
  writer_put(out, 112);
  writer_put(out, 46);

  bool unsigned_compare = primitive_type_is_unsigned(type_kind) && opcode >= 13;

  if (opcode == 11) {
    writer_put(out, 101);
    writer_put(out, 113);
  } else if (opcode == 12) {
    writer_put(out, 110);
    writer_put(out, 101);
  } else if (opcode == 13) {
    if (unsigned_compare) {
      writer_put(out, 117);
      writer_put(out, 108);
      writer_put(out, 116);
    } else {
      writer_put(out, 108);
      writer_put(out, 116);
    }
  } else if (opcode == 14) {
    if (unsigned_compare) {
      writer_put(out, 117);
      writer_put(out, 108);
      writer_put(out, 101);
    } else {
      writer_put(out, 108);
      writer_put(out, 101);
    }
  } else if (opcode == 15) {
    if (unsigned_compare) {
      writer_put(out, 117);
      writer_put(out, 103);
      writer_put(out, 116);
    } else {
      writer_put(out, 103);
      writer_put(out, 116);
    }
  } else {
    if (unsigned_compare) {
      writer_put(out, 117);
      writer_put(out, 103);
      writer_put(out, 101);
    } else {
      writer_put(out, 103);
      writer_put(out, 101);
    }
  }
}

fn writer_structure_needs_identity_suffix(Source& source, HirModule& hir, i64 structure) -> bool {
  i64 offset = raz_rt_stage1_arena_get(hir.struct_name_offsets, structure);
  i64 length = raz_rt_stage1_arena_get(hir.struct_name_lengths, structure);

  if (offset < 0 || length <= 0) {
    return false;
  }

  i64 template = raz_rt_stage1_arena_get(hir.struct_generic_template_indices, structure);
  i64 index = 0;

  while (index < hir.struct_count) {
    if (index != structure) {
      i64 other_offset = raz_rt_stage1_arena_get(hir.struct_name_offsets, index);
      i64 other_length = raz_rt_stage1_arena_get(hir.struct_name_lengths, index);

      if (other_offset >= 0 && token_same(source, offset, length, other_offset, other_length)) {
        i64 other_template = raz_rt_stage1_arena_get(hir.struct_generic_template_indices, index);

        if (template < 0 || other_template < 0 || template != other_template) {
          return true;
        }
      }
    }
    index += 1;
  }
  return false;
}

fn writer_structure_name(ForgeWriter&mut out, Source& source, HirModule& hir, i64 structure) {
  writer_text(
  out,
  source,
  raz_rt_stage1_arena_get(hir.struct_name_offsets, structure),
  raz_rt_stage1_arena_get(hir.struct_name_lengths, structure),
  );
  if (writer_structure_needs_identity_suffix(source, hir, structure)) {
    writer_put(out, 95);
    writer_put(out, 115);
    writer_decimal(out, structure);
  }

  i64 generic_template = raz_rt_stage1_arena_get(hir.struct_generic_template_indices, structure);

  if (generic_template >= 0) {
    writer_put(out, 95);
    writer_put(out, 103);
    writer_put(out, 95);

    i64 child_structure = raz_rt_stage1_arena_get(hir.struct_generic_type_structs, structure);

    if (child_structure >= 0) {
      writer_structure_name(out, source, hir, child_structure);
    } else {
      writer_scalar_type(out, raz_rt_stage1_arena_get(hir.struct_generic_types, structure));
    }
  }
}

fn function_native_symbol_same(Source& source, HirModule& hir, i64 left, i64 right) -> bool {
  i64 left_offset = raz_rt_stage1_arena_get(hir.function_name_offsets, left);
  i64 left_length = raz_rt_stage1_arena_get(hir.function_name_lengths, left);

  if (raz_rt_stage1_arena_get(hir.function_link_name_lengths, left) > 0) {
    left_offset = raz_rt_stage1_arena_get(hir.function_link_name_offsets, left);
    left_length = raz_rt_stage1_arena_get(hir.function_link_name_lengths, left);
  }

  i64 right_offset = raz_rt_stage1_arena_get(hir.function_name_offsets, right);
  i64 right_length = raz_rt_stage1_arena_get(hir.function_name_lengths, right);

  if (raz_rt_stage1_arena_get(hir.function_link_name_lengths, right) > 0) {
    right_offset = raz_rt_stage1_arena_get(hir.function_link_name_offsets, right);
    right_length = raz_rt_stage1_arena_get(hir.function_link_name_lengths, right);
  }
  return token_same(source, left_offset, left_length, right_offset, right_length);
}

fn writer_function_needs_identity_suffix(Source& source, HirModule& hir, i64 function_index) -> bool {
  if (
  raz_rt_stage1_arena_get(hir.function_is_extern, function_index) != 0 ||
  raz_rt_stage1_arena_get(hir.function_inherent_structs, function_index) != -1 ||
  raz_rt_stage1_arena_get(hir.function_closure_ids, function_index) >= 0 ||
  raz_rt_stage1_arena_get(hir.function_drop_structs, function_index) >= 0 ||
  raz_rt_stage1_arena_get(hir.function_clone_structs, function_index) >= 0
  ) {
    return false;
  }

  i64 offset = raz_rt_stage1_arena_get(hir.function_name_offsets, function_index);
  i64 length = raz_rt_stage1_arena_get(hir.function_name_lengths, function_index);

  if (
  length == 4 &&
  source_byte(source, offset) == 109 &&
  source_byte(source, offset + 1) == 97 &&
  source_byte(source, offset + 2) == 105 &&
  source_byte(source, offset + 3) == 110
  ) {
    return false;
  }

  i64 template = raz_rt_stage1_arena_get(hir.function_generic_template_indices, function_index);
  i64 index = 0;

  while (index < hir.function_count) {
    if (
    index != function_index &&
    raz_rt_stage1_arena_get(hir.function_is_extern, index) == 0 &&
    raz_rt_stage1_arena_get(hir.function_inherent_structs, index) == -1 &&
    raz_rt_stage1_arena_get(hir.function_closure_ids, index) < 0 &&
    raz_rt_stage1_arena_get(hir.function_drop_structs, index) < 0 &&
    raz_rt_stage1_arena_get(hir.function_clone_structs, index) < 0
    ) {
      i64 other_offset = raz_rt_stage1_arena_get(hir.function_name_offsets, index);
      i64 other_length = raz_rt_stage1_arena_get(hir.function_name_lengths, index);

      if (token_same(source, offset, length, other_offset, other_length)) {
        i64 other_template = raz_rt_stage1_arena_get(hir.function_generic_template_indices, index);

        if (template < 0 || other_template < 0 || template != other_template) {
          return true;
        }
      }
    }
    index += 1;
  }
  return false;
}

fn writer_function_name(ForgeWriter&mut out, Source& source, HirModule& hir, i64 function_index) {
  writer_put(out, 64);
  if (raz_rt_stage1_arena_get(hir.function_is_extern, function_index) != 0) {
    if (raz_rt_stage1_arena_get(hir.function_link_name_lengths, function_index) > 0) {
      writer_text(
      out,
      source,
      raz_rt_stage1_arena_get(hir.function_link_name_offsets, function_index),
      raz_rt_stage1_arena_get(hir.function_link_name_lengths, function_index),
      );
    } else {
      writer_text(
      out,
      source,
      raz_rt_stage1_arena_get(hir.function_name_offsets, function_index),
      raz_rt_stage1_arena_get(hir.function_name_lengths, function_index),
      );
    }
    return;
  }

  i64 drop_structure = raz_rt_stage1_arena_get(hir.function_drop_structs, function_index);
  i64 clone_structure = raz_rt_stage1_arena_get(hir.function_clone_structs, function_index);
  i64 closure_id = raz_rt_stage1_arena_get(hir.function_closure_ids, function_index);
  i64 generic_template = raz_rt_stage1_arena_get(hir.function_generic_template_indices, function_index);

  if (closure_id >= 0) {
    writer_put(out, 95);
    writer_put(out, 95);
    writer_put(out, 114);
    writer_put(out, 97);
    writer_put(out, 122);
    writer_put(out, 95);
    writer_put(out, 99);
    writer_put(out, 108);
    writer_put(out, 111);
    writer_put(out, 115);
    writer_put(out, 117);
    writer_put(out, 114);
    writer_put(out, 101);
    writer_put(out, 95);
    writer_decimal(out, closure_id);
  } else if (drop_structure >= 0) {
    writer_put(out, 95);
    writer_put(out, 95);
    writer_put(out, 114);
    writer_put(out, 97);
    writer_put(out, 122);
    writer_put(out, 95);
    writer_put(out, 100);
    writer_put(out, 114);
    writer_put(out, 111);
    writer_put(out, 112);
    writer_put(out, 95);
    writer_structure_name(out, source, hir, drop_structure);
  } else if (clone_structure >= 0) {
    writer_put(out, 95);
    writer_put(out, 95);
    writer_put(out, 114);
    writer_put(out, 97);
    writer_put(out, 122);
    writer_put(out, 95);
    writer_put(out, 99);
    writer_put(out, 108);
    writer_put(out, 111);
    writer_put(out, 110);
    writer_put(out, 101);
    writer_put(out, 95);
    writer_structure_name(out, source, hir, clone_structure);
  } else {
    i64 function_name_offset = raz_rt_stage1_arena_get(hir.function_name_offsets, function_index);
    i64 function_name_length = raz_rt_stage1_arena_get(hir.function_name_lengths, function_index);

    if (
    function_name_length == 4 &&
    source_byte(source, function_name_offset) == 109 &&
    source_byte(source, function_name_offset + 1) == 97 &&
    source_byte(source, function_name_offset + 2) == 105 &&
    source_byte(source, function_name_offset + 3) == 110
    ) {
      // Keep the Raz language entry distinct from the C ABI main. The
      // generated C entry delegates through `_raz_entry`, which owns
      // module-global initialization/finalization.
      writer_put(out, 95);
      writer_put(out, 95);
      writer_put(out, 114);
      writer_put(out, 97);
      writer_put(out, 122);
      writer_put(out, 95);
      writer_put(out, 109);
      writer_put(out, 97);
      writer_put(out, 105);
      writer_put(out, 110);
    } else {
      // Raz-defined functions use an internal native namespace. Keeping
      // source names out of the platform symbol namespace prevents public
      // library helpers such as `close`, `read`, and `write` from
      // interposing libc/OS entry points used by the runtime itself.
      writer_put(out, 95);
      writer_put(out, 95);
      writer_put(out, 114);
      writer_put(out, 97);
      writer_put(out, 122);
      writer_put(out, 95);
      writer_put(out, 102);
      writer_put(out, 110);
      writer_put(out, 95);
      writer_text(out, source, function_name_offset, function_name_length);
      if (writer_function_needs_identity_suffix(source, hir, function_index)) {
        writer_put(out, 95);
        writer_put(out, 102);
        writer_decimal(out, function_index);
      }
    }

    i64 inherent_structure = raz_rt_stage1_arena_get(hir.function_inherent_structs, function_index);

    if (generic_template < 0 && inherent_structure != -1) {
      writer_put(out, 95);
      writer_put(out, 105);
      writer_put(out, 95);
      if (inherent_structure >= 0) {
        writer_structure_name(out, source, hir, inherent_structure);
      } else {
        writer_put(out, 101);
        writer_decimal(out, -2 - inherent_structure);
      }
    }
    if (generic_template >= 0) {
      writer_put(out, 95);
      writer_put(out, 103);
      writer_put(out, 95);
      if (inherent_structure <= -2) {
        writer_put(out, 101);
        writer_decimal(out, -2 - inherent_structure);
      } else {
        i64 generic_structure = raz_rt_stage1_arena_get(
        hir.function_generic_type_structs,
        function_index,
        );
        if (generic_structure >= 0) {
          writer_structure_name(out, source, hir, generic_structure);
        } else {
          writer_scalar_type(
          out,
          raz_rt_stage1_arena_get(hir.function_generic_types, function_index),
          );
        }
      }
    }
  }
}

