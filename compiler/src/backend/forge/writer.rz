fn writer_function_signature_name(ForgeWriter&mut out, i64 signature) {
  writer_put(out, 64);
  writer_put(out, 95);
  writer_put(out, 95);
  writer_put(out, 114);
  writer_put(out, 97);
  writer_put(out, 122);
  writer_put(out, 95);
  writer_put(out, 102);
  writer_put(out, 110);
  writer_put(out, 115);
  writer_put(out, 105);
  writer_put(out, 103);
  writer_put(out, 95);
  writer_decimal(out, signature);
}

fn writer_function_signature_type(
ForgeWriter&mut out,
i64 structure,
i64 type_kind,
i64 reference,
i64 slice,
) {
  if (structure >= 0 || reference != 0 || slice != 0) {
    writer_i64(out);
  } else {
    writer_scalar_type(out, type_kind);
  }
}

fn emit_forge_function_signatures(ForgeWriter&mut out, HirModule& hir) {
  i64 signature = 0;

  while (signature < hir.function_type_count) {
    writer_space(out);
    writer_space(out);
    writer_put(out, 115);
    // s
    writer_put(out, 105);
    // i
    writer_put(out, 103);
    // g
    writer_put(out, 110);
    // n
    writer_put(out, 97);
    // a
    writer_put(out, 116);
    // t
    writer_put(out, 117);
    // u
    writer_put(out, 114);
    // r
    writer_put(out, 101);
    // e
    writer_space(out);
    writer_function_signature_name(out, signature);
    writer_put(out, 40);

    i64 parameter_start = raz_rt_stage1_arena_get(hir.function_type_parameter_starts, signature);
    i64 parameter_count = raz_rt_stage1_arena_get(hir.function_type_parameter_counts, signature);
    i64 parameter = 0;

    while (parameter < parameter_count) {
      if (parameter > 0) {
        writer_put(out, 44);
        writer_space(out);
      }
      writer_put(out, 37);
      writer_put(out, 112);
      writer_decimal(out, parameter);
      writer_put(out, 58);
      writer_space(out);

      i64 parameter_index = parameter_start + parameter;

      writer_function_signature_type(
      out,
      raz_rt_stage1_arena_get(hir.function_type_parameter_type_structs, parameter_index),
      raz_rt_stage1_arena_get(hir.function_type_parameter_types, parameter_index),
      raz_rt_stage1_arena_get(hir.function_type_parameter_references, parameter_index),
      raz_rt_stage1_arena_get(hir.function_type_parameter_slices, parameter_index),
      );
      parameter += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 45);
    writer_put(out, 62);
    writer_space(out);
    writer_function_signature_type(
    out,
    raz_rt_stage1_arena_get(hir.function_type_return_type_structs, signature),
    raz_rt_stage1_arena_get(hir.function_type_return_types, signature),
    raz_rt_stage1_arena_get(hir.function_type_return_references, signature),
    raz_rt_stage1_arena_get(hir.function_type_return_slices, signature),
    );
    writer_newline(out);
    signature += 1;
  }
}

fn emit_forge_extern_function(ForgeWriter&mut out, Source& source, HirModule& hir, i64 function_index) {
  writer_space(out);
  writer_space(out);
  writer_put(out, 101);
  // e
  writer_put(out, 120);
  // x
  writer_put(out, 116);
  // t
  writer_put(out, 101);
  // e
  writer_put(out, 114);
  // r
  writer_put(out, 110);
  // n
  writer_space(out);
  // Forge uses an explicit C calling-convention prefix. `system` and Raz use
  // the platform convention, so they intentionally omit a prefix here.
  if (raz_rt_stage1_arena_get(hir.function_abi_kinds, function_index) == 1) {
    writer_put(out, 99);
    // c
    writer_space(out);
  }
  writer_keyword_func(out);
  writer_space(out);
  writer_function_name(out, source, hir, function_index);
  writer_put(out, 40);

  i64 parameter_start = raz_rt_stage1_arena_get(hir.function_parameter_starts, function_index);
  i64 parameter_count = raz_rt_stage1_arena_get(hir.function_parameter_counts, function_index);
  i64 parameter = 0;

  while (parameter < parameter_count) {
    if (parameter > 0) {
      writer_put(out, 44);
      writer_space(out);
    }
    writer_parameter(out, parameter);
    writer_put(out, 58);
    writer_space(out);

    i64 index = parameter_start + parameter;

    if (
    raz_rt_stage1_arena_get(hir.parameter_references, index) != 0 ||
    raz_rt_stage1_arena_get(hir.parameter_slices, index) != 0 ||
    raz_rt_stage1_arena_get(hir.parameter_array_extents, index) >= 0 ||
    raz_rt_stage1_arena_get(hir.parameter_type_structs, index) >= 0
    ) {
      writer_i64(out);
    } else if (raz_rt_stage1_arena_get(hir.parameter_function_types, index) >= 0) {
      writer_ptr(out);
    } else {
      writer_scalar_type(out, raz_rt_stage1_arena_get(hir.parameter_types, index));
    }
    parameter += 1;
  }
  writer_put(out, 41);
  writer_space(out);
  writer_put(out, 45);
  writer_put(out, 62);
  writer_space(out);
  if (raz_rt_stage1_arena_get(hir.function_returns_value, function_index) == 0) {
    writer_void(out);
  } else if (
  raz_rt_stage1_arena_get(hir.function_return_references, function_index) != 0 ||
  raz_rt_stage1_arena_get(hir.function_return_slices, function_index) != 0 ||
  raz_rt_stage1_arena_get(hir.function_return_type_structs, function_index) >= 0
  ) {
    writer_i64(out);
  } else if (raz_rt_stage1_arena_get(hir.function_return_function_types, function_index) >= 0) {
    writer_ptr(out);
  } else {
    writer_scalar_type(out, raz_rt_stage1_arena_get(hir.function_return_types, function_index));
  }
  writer_newline(out);
