    } else if (opcode == 29) {
      i64 stored_register = raz_rt_stage1_arena_get(mir.op_c, ip);
      bool floating = raz_rt_stage1_arena_get(mir.op_types, stored_register) == 1;

      writer_space(out);
      writer_space(out);
      writer_put(out, 99);
      writer_put(out, 97);
      writer_put(out, 108);
      writer_put(out, 108);
      writer_space(out);
      writer_put(out, 118);
      writer_put(out, 111);
      writer_put(out, 105);
