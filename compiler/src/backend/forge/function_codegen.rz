namespace raz_compiler_backend_forge_function_codegen;

public import raz_compiler_backend_forge_globals_codegen;
import raz_compiler_backend_forge_codegen;
import raz_compiler_driver_project;

// Forge scalar/function lowering from the Pass C verified backend.
// Split mechanically to keep compiler modules below the source-size gate.
// Lower typed MIR into verified Forge IR. Language semantics should already be
// decided before this point; this file maps those decisions onto backend operations.
// String literals are emitted as immutable byte globals. The value flowing
// through HIR/MIR is the relocatable address of that storage, which keeps the
// built-in string representation pointer-sized and independent of host memory.
fn forge_string_literal_byte_length(Source& source, i64 offset, i64 length, bool raw_slice) -> i64 {
    if (raw_slice) {
        return length + 1;
    }
    if (length < 2) {
        return 1;
    }

    i64 index = 1;
    i64 end = length - 1;
    i64 bytes = 0;

    while (index < end) {
        i64 current = source_byte(source, offset + index);

        if (current == 92 && index + 1 < end) {
            // Raz escape sequences currently encode one output byte. Keep the
            // original spelling for Forge and count the decoded payload here.
            index += 2;
        } else {
            index += 1;
        }
        bytes += 1;
    }
    return bytes + 1;
}

fn writer_string_global_name(ForgeWriter&mut out, i64 instruction) {
    writer_put(out, 64);
    writer_put(out, 95);
    writer_put(out, 95);
    writer_put(out, 114);
    writer_put(out, 97);
    writer_put(out, 122);
    writer_put(out, 95);
    writer_put(out, 115);
    writer_put(out, 116);
    writer_put(out, 114);
    writer_put(out, 105);
    writer_put(out, 110);
    writer_put(out, 103);
    writer_put(out, 95);
    writer_decimal(out, instruction);
}

fn emit_forge_string_global(ForgeWriter&mut out, Source& source, MirModule& mir, i64 instruction) {
    i64 offset = raz_compiler_rt_arena_get(mir.op_a, instruction);
    i64 length = raz_compiler_rt_arena_get(mir.op_b, instruction);
    bool raw_slice = raz_compiler_rt_arena_get(mir.op_c, instruction) != 0;
    i64 byte_length = forge_string_literal_byte_length(source, offset, length, raw_slice);

    writer_space(out);
    writer_space(out);
    writer_put(out, 99);
    writer_put(out, 111);
    writer_put(out, 110);
    writer_put(out, 115);
    writer_put(out, 116);
    writer_put(out, 97);
    writer_put(out, 110);
    writer_put(out, 116);
    writer_space(out);
    writer_string_global_name(out, instruction);
    writer_put(out, 58);
    writer_space(out);
    writer_i8(out);
    writer_put(out, 91);
    writer_decimal(out, byte_length);
    writer_put(out, 93);
    writer_space(out);
    writer_put(out, 97);
    writer_put(out, 108);
    writer_put(out, 105);
    writer_put(out, 103);
    writer_put(out, 110);
    writer_space(out);
    writer_decimal(out, 1);
    writer_space(out);
    writer_put(out, 61);
    writer_space(out);
    writer_put(out, 34);
    if (raw_slice) {
        if (length > 0) {
            writer_text(out, source, offset, length);
        }
    } else if (length > 2) {
        writer_text(out, source, offset + 1, length - 2);
    }
    writer_put(out, 92);
    writer_put(out, 48);
    writer_put(out, 34);
    writer_newline(out);
}

fn forge_is_builtin_runtime_extern(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 length = raz_compiler_rt_arena_get(hir.function_name_lengths, function_index);

    if (length < 7) {
        return false;
    }

    i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);

    bool runtime_prefix =
        source_byte(source, offset) == 114 &&
        source_byte(source, offset + 1) == 97 &&
        source_byte(source, offset + 2) == 122 &&
        source_byte(source, offset + 3) == 95 &&
        source_byte(source, offset + 4) == 114 &&
        source_byte(source, offset + 5) == 116 &&
        source_byte(source, offset + 6) == 95;
    if (!runtime_prefix) {
        return false;
    }
    // Only suppress declarations that the Forge emitter itself guarantees.
    // User-facing runtime/OS shims such as raz_rt_alloc, raz_rt_file_open,
    // and raz_rt_udp_send_to must be emitted from their source-level extern
    // declarations.  The old prefix-only test silently dropped every raz_rt_*
    // extern, leaving valid stdlib programs with unresolved callees.
    if (
        length >= 14 &&
        source_byte(source, offset + 7) == 115 &&
        source_byte(source, offset + 8) == 116 &&
        source_byte(source, offset + 9) == 97 &&
        source_byte(source, offset + 10) == 103 &&
        source_byte(source, offset + 11) == 101 &&
        source_byte(source, offset + 12) == 49 &&
        source_byte(source, offset + 13) == 95
    ) {
        return true;
    }
    if (
        length >= 13 &&
        source_byte(source, offset + 7) == 97 &&
        source_byte(source, offset + 8) == 115 &&
        source_byte(source, offset + 9) == 121 &&
        source_byte(source, offset + 10) == 110 &&
        source_byte(source, offset + 11) == 99 &&
        source_byte(source, offset + 12) == 95
    ) {
        return true;
    }
    if (
        length >= 14 &&
        source_byte(source, offset + 7) == 102 &&
        source_byte(source, offset + 8) == 117 &&
        source_byte(source, offset + 9) == 116 &&
        source_byte(source, offset + 10) == 117 &&
        source_byte(source, offset + 11) == 114 &&
        source_byte(source, offset + 12) == 101 &&
        source_byte(source, offset + 13) == 95
    ) {
        return true;
    }
    if (length == 22) {
        string expected = "raz_rt_write_ascii_i64";
        i64 index = 0;
        bool same = true;

        while (index < 22 && same) {
            if (source_byte(source, offset + index) != compiler_literal_byte(expected, index)) {
                same = false;
            }
            index += 1;
        }
        if (same) {
            return true;
        }
    }
    if (length == 21) {
        string expected = "raz_rt_read_ascii_i64";
        i64 index = 0;
        bool same = true;

        while (index < 21 && same) {
            if (source_byte(source, offset + index) != compiler_literal_byte(expected, index)) {
                same = false;
            }
            index += 1;
        }
        if (same) {
            return true;
        }
    }
    return false;
}

fn forge_extern_already_emitted(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 previous = 0;

    while (previous < function_index) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, previous) != 0 &&
            !forge_is_builtin_runtime_extern(source, hir, previous) &&
            function_native_symbol_same(source, hir, previous, function_index)
        ) {
            return true;
        }
        previous += 1;
    }
    return false;
}

fn emit_forge_string_globals(ForgeWriter&mut out, Source& source, MirModule& mir) {
    i64 instruction = 0;

    while (instruction < mir.instruction_count) {
        if (raz_compiler_rt_arena_get(mir.opcodes, instruction) == 42) {
            emit_forge_string_global(out, source, mir, instruction);
        }
        instruction += 1;
    }
}

fn forge_function_pointer_local_type(HirModule& hir, i64 function_index, i64 local_slot) -> i64 {
    i64 declared_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);

    if (local_slot >= 0 && local_slot < declared_count) {
        i64 local_index = forge_native_hir_local_index(hir, function_index, local_slot);

        if (
            local_index >= 0 &&
            raz_compiler_rt_arena_get(hir.local_types, local_index) == 14 &&
            raz_compiler_rt_arena_get(hir.local_function_types, local_index) >= 0
        ) {
            return raz_compiler_rt_arena_get(hir.local_function_types, local_index);
        }
        return -1;
    }

    i64 parameter = local_slot - declared_count;
    i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);

    if (parameter >= 0 && parameter < parameter_count) {
        i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);

        return raz_compiler_rt_arena_get(hir.parameter_function_types, parameter_start + parameter);
    }
    return -1;
}

fn forge_function_pointer_local_register(i64 local_slot) -> i64 {
    return writer_synthetic_register(70, local_slot);
}

fn emit_forge_function(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
) -> bool {
    writer_space(out);
    writer_space(out);
    // Target features are part of the FIR function contract. Forge carries this
    // prefix into machine IR so target backends can validate/select instructions
    // without the frontend depending on native codegen details.

    i64 feature_length = raz_compiler_rt_arena_get(hir.function_target_feature_lengths, function_index);

    if (feature_length != 0) {
        writer_text(
            out,
            source,
            raz_compiler_rt_arena_get(hir.function_target_feature_offsets, function_index),
            feature_length,
        );
        writer_space(out);
    }
    writer_keyword_func(out);
    writer_space(out);
    writer_function_name(out, source, hir, function_index);
    writer_put(out, 40);

    i64 parameter = 0;

    while (parameter < raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index)) {
        if (parameter > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        writer_parameter(out, parameter);
        writer_put(out, 58);
        writer_space(out);

        i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);
        i64 parameter_index = parameter_start + parameter;

        if (
            raz_compiler_rt_arena_get(hir.parameter_references, parameter_index) != 0 ||
            raz_compiler_rt_arena_get(hir.parameter_slices, parameter_index) != 0 ||
            raz_compiler_rt_arena_get(hir.parameter_array_extents, parameter_index) >= 0 ||
            raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index) >= 0
        ) {
            writer_i64(out);
        } else {
            writer_scalar_type(out, raz_compiler_rt_arena_get(hir.parameter_types, parameter_index));
        }
        parameter += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 45);
    writer_put(out, 62);
    writer_space(out);
    if (raz_compiler_rt_arena_get(hir.function_returns_value, function_index) == 0) {
        writer_void(out);
    } else if (
        raz_compiler_rt_arena_get(hir.function_return_references, function_index) != 0 ||
        raz_compiler_rt_arena_get(hir.function_return_slices, function_index) != 0 ||
        raz_compiler_rt_arena_get(hir.function_return_type_structs, function_index) >= 0
    ) {
        writer_i64(out);
    } else {
        writer_scalar_type(out, raz_compiler_rt_arena_get(hir.function_return_types, function_index));
    }
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);
    writer_space(out);
    writer_space(out);
    writer_put(out, 101);
    writer_put(out, 110);
    writer_put(out, 116);
    writer_put(out, 114);
    writer_put(out, 121);
    writer_put(out, 58);
    writer_newline(out);
    writer_instruction_prefix(out, 999999);
    writer_put(out, 99);
    writer_put(out, 111);
    writer_put(out, 110);
    writer_put(out, 115);
    writer_put(out, 116);
    writer_space(out);
    writer_i64(out);
    writer_space(out);
    writer_decimal(out, 0);
    writer_newline(out);
    writer_instruction_prefix(out, 999998);
    writer_put(out, 99);
    writer_put(out, 111);
    writer_put(out, 110);
    writer_put(out, 115);
    writer_put(out, 116);
    writer_space(out);
    writer_i64(out);
    writer_space(out);
    writer_decimal(out, 1);
    writer_newline(out);

    i64 local_capacity = raz_compiler_rt_arena_get(mir.function_local_counts, function_index) + 1;
    i64 frame_register = writer_synthetic_register(0, function_index);
    i64 frame_count_register = writer_synthetic_register(1, function_index);

    writer_instruction_prefix(out, frame_count_register);
    writer_put(out, 99);
    writer_put(out, 111);
    writer_put(out, 110);
    writer_put(out, 115);
    writer_put(out, 116);
    writer_space(out);
    writer_i64(out);
    writer_space(out);
    writer_decimal(out, local_capacity);
    writer_newline(out);
    writer_instruction_prefix(out, frame_register);
    writer_put(out, 99);
    writer_put(out, 97);
    writer_put(out, 108);
    writer_put(out, 108);
    writer_space(out);
    writer_i64(out);
    writer_space(out);
    writer_runtime_name(out, 1);
    writer_put(out, 40);
    writer_register(out, frame_count_register);
    writer_put(out, 41);
    writer_newline(out);
    // Function-pointer locals cannot live in the scalar stage arena: Forge
    // models callable targets as ptr values while the arena stores i64 cells.
    // Give those locals genuine pointer stack slots and keep all other locals
    // on the existing deterministic arena path.

    i64 pointer_local = 0;
    i64 pointer_local_count = raz_compiler_rt_arena_get(mir.function_local_counts, function_index);

    while (pointer_local < pointer_local_count) {
        if (forge_function_pointer_local_type(hir, function_index, pointer_local) >= 0) {
            writer_instruction_prefix(out, forge_function_pointer_local_register(pointer_local));
            writer_put(out, 115);
            writer_put(out, 116);
            writer_put(out, 97);
            writer_put(out, 99);
            writer_put(out, 107);
            writer_put(out, 46);
            writer_put(out, 97);
            writer_put(out, 108);
            writer_put(out, 108);
            writer_put(out, 111);
            writer_put(out, 99);
            writer_space(out);
            writer_ptr(out);
            writer_space(out);
            writer_decimal(out, 8);
            writer_space(out);
            writer_put(out, 97);
            writer_put(out, 108);
            writer_put(out, 105);
            writer_put(out, 103);
            writer_put(out, 110);
            writer_space(out);
            writer_decimal(out, 8);
            writer_newline(out);
        }
        pointer_local += 1;
    }

    i64 local_registers = raz_compiler_rt_arena_create(local_capacity);

    if (local_registers == 0) {
        return false;
    }

    i64 local = 0;

    while (local < local_capacity) {
        raz_compiler_rt_arena_set(local_registers, local, -1);
        local += 1;
    }

    i64 ip = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = ip + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 block_terminated = 0;

    while (ip < end) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        if (opcode == 24) {
            if (block_terminated == 0) {
                writer_jump_edge_no_arguments(out, ip);
            }
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            writer_block_name(out, ip);
            if (raz_compiler_rt_arena_get(mir.op_a, ip) != 0) {
                writer_put(out, 40);
                writer_register(out, ip);
                writer_put(out, 58);
                writer_space(out);
                writer_i64(out);
                writer_put(out, 41);
            }
            writer_put(out, 58);
            writer_newline(out);
            block_terminated = 0;
        } else if (block_terminated != 0) {} else if (opcode == 1) {
            i64 op_type = raz_compiler_rt_arena_get(mir.op_types, ip);

            writer_instruction_prefix(out, ip);
            writer_put(out, 99);
            writer_put(out, 111);
            writer_put(out, 110);
            writer_put(out, 115);
            writer_put(out, 116);
            writer_space(out);
            writer_scalar_type(out, op_type);
            writer_space(out);
            if (op_type == 1) {
                i64 literal_length = raz_compiler_rt_arena_get(mir.op_b, ip);

                if (literal_length > 0) {
                    writer_text(out, source, raz_compiler_rt_arena_get(mir.op_a, ip), literal_length);
                } else {
                    writer_put(out, 48);
                    writer_put(out, 46);
                    writer_put(out, 48);
                }
            } else {
                writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            }
            writer_newline(out);
        } else if (opcode == 42) {
            writer_instruction_prefix(out, ip);

            i64 global_index = raz_compiler_rt_arena_get(mir.op_a, ip);

            // String globals are addresses, but the Raz value ABI transports
            // those address bits as i64. global.address explicitly permits an
            // i64 result, avoiding ptr/i64 mismatches in scalar locals/calls.
            writer_global_address_opcode(out, false);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            writer_string_global_name(out, ip);
            writer_newline(out);
        } else if (opcode == 43) {
            writer_instruction_prefix(out, ip);
            writer_put(out, 102);
            writer_put(out, 117);
            writer_put(out, 110);
            writer_put(out, 99);
            writer_put(out, 46);
            writer_put(out, 97);
            writer_put(out, 100);
            writer_put(out, 100);
            writer_put(out, 114);
            writer_put(out, 101);
            writer_put(out, 115);
            writer_put(out, 115);
            writer_space(out);
            writer_ptr(out);
            writer_space(out);

            i64 address_function = raz_compiler_rt_arena_get(mir.op_a, ip);

            writer_function_name(out, source, hir, address_function);
            i64 address_signature_encoded = raz_compiler_rt_arena_get(
                hir.function_pointer_signatures,
                address_function,
            );
            if (address_signature_encoded > 0) {
                writer_space(out);
                writer_put(out, 97);
                writer_put(out, 115);
                writer_space(out);
                writer_function_signature_name(out, address_signature_encoded - 1);
            }
            writer_newline(out);
        } else if (opcode == 2) {
            writer_instruction_prefix(out, ip);
            writer_put(out, 99);
            writer_put(out, 111);
            writer_put(out, 112);
            writer_put(out, 121);
            writer_space(out);

            i64 copied_parameter = raz_compiler_rt_arena_get(mir.op_a, ip);

            i64 copied_parameter_index =
                raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index) +
                copied_parameter;
            if (
                raz_compiler_rt_arena_get(hir.parameter_references, copied_parameter_index) != 0 ||
                raz_compiler_rt_arena_get(hir.parameter_slices, copied_parameter_index) != 0 ||
                raz_compiler_rt_arena_get(hir.parameter_array_extents, copied_parameter_index) >= 0 ||
                raz_compiler_rt_arena_get(hir.parameter_type_structs, copied_parameter_index) >= 0
            ) {
                writer_i64(out);
            } else if (raz_compiler_rt_arena_get(hir.parameter_function_types, copied_parameter_index) >= 0) {
                writer_ptr(out);
            } else {
                writer_scalar_type(out, raz_compiler_rt_arena_get(mir.op_types, ip));
            }
            writer_space(out);
            writer_parameter(out, copied_parameter);
            writer_newline(out);
        } else if (opcode == 3) {
            i64 loaded_local_slot = raz_compiler_rt_arena_get(mir.op_a, ip);

            if (forge_function_pointer_local_type(hir, function_index, loaded_local_slot) >= 0) {
                writer_instruction_prefix(out, ip);
                writer_put(out, 108);
                writer_put(out, 111);
                writer_put(out, 97);
                writer_put(out, 100);
                writer_space(out);
                writer_ptr(out);
                writer_space(out);
                writer_register(out, forge_function_pointer_local_register(loaded_local_slot));
                writer_space(out);
                writer_put(out, 97);
                writer_put(out, 108);
                writer_put(out, 105);
                writer_put(out, 103);
                writer_put(out, 110);
                writer_space(out);
                writer_decimal(out, 8);
                writer_newline(out);
            } else {
                i64 slot_register = writer_synthetic_register(2, ip);

                writer_instruction_prefix(out, slot_register);
                writer_put(out, 99);
                writer_put(out, 111);
                writer_put(out, 110);
                writer_put(out, 115);
                writer_put(out, 116);
                writer_space(out);
                writer_i64(out);
                writer_space(out);
                writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_newline(out);

                i64 load_type = raz_compiler_rt_arena_get(mir.op_types, ip);
                i64 loaded_local_index = forge_native_hir_local_index(hir, function_index, loaded_local_slot);
                bool word_backed_local = false;

                if (loaded_local_index >= 0) {
                    word_backed_local =
                        raz_compiler_rt_arena_get(hir.local_references, loaded_local_index) != 0 ||
                        raz_compiler_rt_arena_get(hir.local_slices, loaded_local_index) != 0 ||
                        raz_compiler_rt_arena_get(hir.local_array_extents, loaded_local_index) >= 0 ||
                        raz_compiler_rt_arena_get(hir.local_type_structs, loaded_local_index) >= 0;
                }
                if (word_backed_local) {
                    writer_instruction_prefix(out, ip);
                    writer_literal(out, "call i64 ");
                    writer_runtime_name(out, 3);
                    writer_put(out, 40);
                    writer_register(out, frame_register);
                    writer_put(out, 44);
                    writer_space(out);
                    writer_register(out, slot_register);
                    writer_put(out, 41);
                    writer_newline(out);
                } else if (primitive_type_is_float(load_type)) {
                    i64 loaded_register = ip;

                    if (load_type == 11) {
                        loaded_register = writer_synthetic_register(236, ip);
                    }
                    writer_instruction_prefix(out, loaded_register);
                    writer_put(out, 99);
                    writer_put(out, 97);
                    writer_put(out, 108);
                    writer_put(out, 108);
                    writer_space(out);
                    writer_f64(out);
                    writer_space(out);
                    writer_runtime_name(out, 8);
                    writer_put(out, 40);
                    writer_register(out, frame_register);
                    writer_put(out, 44);
                    writer_space(out);
                    writer_register(out, slot_register);
                    writer_put(out, 41);
                    writer_newline(out);
                    if (load_type == 11) {
                        writer_instruction_prefix(out, ip);
                        writer_numeric_cast_opcode(out, 1, 11);
                        writer_space(out);
                        writer_f32(out);
                        writer_space(out);
                        writer_register(out, loaded_register);
                        writer_newline(out);
                    }
                } else if (primitive_type_width(load_type) < 64) {
                    i64 raw_register = writer_synthetic_register(3, ip);

                    writer_instruction_prefix(out, raw_register);
                    writer_put(out, 99);
                    writer_put(out, 97);
                    writer_put(out, 108);
                    writer_put(out, 108);
                    writer_space(out);
                    writer_i64(out);
                    writer_space(out);
                    writer_runtime_name(out, 3);
                    writer_put(out, 40);
                    writer_register(out, frame_register);
                    writer_put(out, 44);
                    writer_space(out);
                    writer_register(out, slot_register);
                    writer_put(out, 41);
                    writer_newline(out);
                    writer_instruction_prefix(out, ip);
                    writer_numeric_cast_opcode(out, 0, load_type);
                    writer_space(out);
                    writer_scalar_type(out, load_type);
                    writer_space(out);
                    writer_register(out, raw_register);
                    writer_newline(out);
                } else {
                    writer_instruction_prefix(out, ip);
