      writer_register(out, raz_rt_stage1_arena_get(mir.op_a, ip));
      writer_put(out, 44);
      writer_space(out);
      writer_register(out, raz_rt_stage1_arena_get(mir.op_b, ip));
      writer_put(out, 44);
      writer_space(out);
      writer_register(out, stored_register);
      writer_put(out, 41);
      writer_newline(out);
      writer_instruction_prefix(out, ip);
      writer_put(out, 99);
      writer_put(out, 111);
      writer_put(out, 112);
      writer_put(out, 121);
      writer_space(out);
      if (floating) {
