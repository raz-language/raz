      }
      writer_space(out);
      writer_register(out, stored_register);
      writer_newline(out);
    } else if (opcode == 30) {
      i64 allocation_count = writer_synthetic_register(12, ip);

      writer_instruction_prefix(out, allocation_count);
      writer_put(out, 99);
      writer_put(out, 111);
      writer_put(out, 110);
      writer_put(out, 115);
      writer_put(out, 116);
      writer_space(out);
      writer_i64(out);
      writer_space(out);
      writer_decimal(out, raz_rt_stage1_arena_get(mir.op_a, ip));
      writer_newline(out);
      writer_instruction_prefix(out, ip);
      writer_put(out, 99);
      writer_put(out, 97);
      writer_put(out, 108);
      writer_put(out, 108);
      writer_space(out);
      writer_i64(out);
