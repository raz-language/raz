    }
    ip += 1;
  }
  if (block_terminated == 0) {
    if (raz_rt_stage1_arena_get(hir.function_returns_value, function_index) == 0) {
      writer_space(out);
      writer_space(out);
      writer_keyword_return(out);
      writer_newline(out);
    } else {
      i64 final_zero = writer_synthetic_register(13, function_index);

      writer_instruction_prefix(out, final_zero);
      writer_put(out, 99);
