                writer_instruction_prefix(out, ip);
                writer_literal(out, "load ");
                writer_scalar_type(out, value_type);
                writer_space(out);
                writer_register(out, reference);
                writer_newline(out);
            } else if (floating) {
                writer_instruction_prefix(out, ip);
                writer_literal(out, "call f64 ");
                writer_runtime_name(out, 11);
                writer_put(out, 40);
                writer_register(out, reference);
                writer_put(out, 41);
                writer_newline(out);
            } else if (primitive_type_width(value_type) > 0 && primitive_type_width(value_type) < 64) {
                i64 raw_register = writer_synthetic_register(26, ip);

                writer_instruction_prefix(out, raw_register);
                writer_literal(out, "call i64 ");
                writer_runtime_name(out, 6);
                writer_put(out, 40);
                writer_register(out, reference);
                writer_put(out, 41);
                writer_newline(out);
                writer_instruction_prefix(out, ip);
                writer_literal(out, "truncate ");
                writer_scalar_type(out, value_type);
                writer_space(out);
                writer_register(out, raw_register);
                writer_newline(out);
            } else {
                writer_instruction_prefix(out, ip);
                writer_literal(out, "call i64 ");
                writer_runtime_name(out, 6);
                writer_put(out, 40);
                writer_register(out, reference);
                writer_put(out, 41);
                writer_newline(out);
            }
        } else if (opcode == 27) {
            i64 reference = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 stored_register = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 stored_type = raz_compiler_rt_arena_get(mir.op_types, stored_register);
            bool floating = stored_type == 1;
            i64 reference_opcode = -1;
            i64 reference_type = 0;

            if (reference >= 0 && reference < mir.instruction_count) {
                reference_opcode = raz_compiler_rt_arena_get(mir.opcodes, reference);
                reference_type = raz_compiler_rt_arena_get(mir.op_types, reference);
            }
            bool native_pointer =
                reference_opcode == 40 &&
                (reference_type == 12 || reference_type == 13 || reference_type == 14);
            if (native_pointer) {
                writer_space(out);
                writer_space(out);
                writer_literal(out, "store ");
                writer_scalar_type(out, stored_type);
                writer_space(out);
                writer_register(out, stored_register);
                writer_space(out);
                writer_register(out, reference);
                writer_newline(out);
            } else {
                i64 runtime_value = stored_register;

                if (
                    !floating &&
                    primitive_type_width(stored_type) > 0 &&
                    primitive_type_width(stored_type) < 64
                ) {
                    runtime_value = writer_synthetic_register(27, ip);
                    writer_instruction_prefix(out, runtime_value);
                    if (primitive_type_is_unsigned(stored_type)) {
                        writer_literal(out, "zero_extend i64 ");
                    } else {
                        writer_literal(out, "sign_extend i64 ");
                    }
                    writer_register(out, stored_register);
                    writer_newline(out);
                }
                writer_space(out);
                writer_space(out);
                writer_literal(out, "call void ");
                if (floating) {
                    writer_runtime_name(out, 12);
                } else {
                    writer_runtime_name(out, 7);
                }
                writer_put(out, 40);
                writer_register(out, reference);
                writer_put(out, 44);
                writer_space(out);
                writer_register(out, runtime_value);
                writer_put(out, 41);
                writer_newline(out);
            }
            writer_instruction_prefix(out, ip);
            writer_literal(out, "copy ");
            writer_scalar_type(out, stored_type);
            writer_space(out);
            writer_register(out, stored_register);
            writer_newline(out);
        } else if (opcode == 28) {
            i64 value_type = raz_compiler_rt_arena_get(mir.op_types, ip);
            bool floating = value_type == 1;

            if (floating) {
                writer_instruction_prefix(out, ip);
                writer_literal(out, "call f64 ");
                writer_runtime_name(out, 8);
                writer_put(out, 40);
                writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_put(out, 44);
                writer_space(out);
                writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
                writer_put(out, 41);
                writer_newline(out);
            } else if (primitive_type_width(value_type) > 0 && primitive_type_width(value_type) < 64) {
                i64 raw_register = writer_synthetic_register(28, ip);

                writer_instruction_prefix(out, raw_register);
                writer_literal(out, "call i64 ");
                writer_runtime_name(out, 3);
                writer_put(out, 40);
                writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_put(out, 44);
                writer_space(out);
                writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
                writer_put(out, 41);
                writer_newline(out);
                writer_instruction_prefix(out, ip);
                writer_literal(out, "truncate ");
                writer_scalar_type(out, value_type);
                writer_space(out);
                writer_register(out, raw_register);
                writer_newline(out);
            } else {
                writer_instruction_prefix(out, ip);
                writer_literal(out, "call i64 ");
                writer_runtime_name(out, 3);
                writer_put(out, 40);
                writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_put(out, 44);
                writer_space(out);
                writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
                writer_put(out, 41);
                writer_newline(out);
            }
        } else if (opcode == 29) {
            i64 stored_register = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 stored_type = raz_compiler_rt_arena_get(mir.op_types, stored_register);
            bool floating = stored_type == 1;
            i64 runtime_value = stored_register;

            if (
                !floating &&
                primitive_type_width(stored_type) > 0 &&
                primitive_type_width(stored_type) < 64
            ) {
                runtime_value = writer_synthetic_register(29, ip);
                writer_instruction_prefix(out, runtime_value);
                if (primitive_type_is_unsigned(stored_type)) {
                    writer_literal(out, "zero_extend i64 ");
                } else {
                    writer_literal(out, "sign_extend i64 ");
                }
                writer_register(out, stored_register);
                writer_newline(out);
            }
            writer_space(out);
            writer_space(out);
            writer_literal(out, "call void ");
            if (floating) {
                writer_runtime_name(out, 9);
            } else {
                writer_runtime_name(out, 4);
            }
            writer_put(out, 40);
            writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_register(out, runtime_value);
            writer_put(out, 41);
            writer_newline(out);
            writer_instruction_prefix(out, ip);
            writer_literal(out, "copy ");
            writer_scalar_type(out, stored_type);
            writer_space(out);
            writer_register(out, stored_register);
            writer_newline(out);
        } else if (opcode == 30) {
            i64 allocation_count = writer_synthetic_register(12, ip);
            i64 aggregate_marker = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 element_type = raz_compiler_rt_arena_get(mir.op_d, ip);

            bool typed_array =
                aggregate_marker == 2 &&
                primitive_type_width(element_type) > 0 &&
                primitive_type_width(element_type) <= 64;
            i64 element_width = (primitive_type_width(element_type) + 7) / 8;

            writer_instruction_prefix(out, allocation_count);
            writer_put(out, 99);
            writer_put(out, 111);
            writer_put(out, 110);
            writer_put(out, 115);
            writer_put(out, 116);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(out);

            i64 width_register = writer_synthetic_register(13, ip);

            if (typed_array) {
                writer_instruction_prefix(out, width_register);
                writer_put(out, 99);
                writer_put(out, 111);
                writer_put(out, 110);
                writer_put(out, 115);
                writer_put(out, 116);
                writer_space(out);
                writer_i64(out);
                writer_space(out);
                writer_decimal(out, element_width);
                writer_newline(out);
            }
            writer_instruction_prefix(out, ip);
            writer_put(out, 99);
            writer_put(out, 97);
            writer_put(out, 108);
            writer_put(out, 108);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            if (typed_array) {
                writer_runtime_name(out, 17);
            } else {
                writer_runtime_name(out, 1);
            }
            writer_put(out, 40);
            writer_register(out, allocation_count);
            if (typed_array) {
                writer_put(out, 44);
                writer_space(out);
                writer_register(out, width_register);
            }
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 31) {
            writer_space(out);
            writer_space(out);
            writer_put(out, 99);
            writer_put(out, 97);
            writer_put(out, 108);
            writer_put(out, 108);
            writer_space(out);
            writer_put(out, 118);
            writer_put(out, 111);
            writer_put(out, 105);
            writer_put(out, 100);
            writer_space(out);
            writer_runtime_name(out, 2);
            writer_put(out, 40);
            writer_register(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 32 || opcode == 33) {} else {
            ForgeWriter diagnostic;

            writer_init(&mut diagnostic);
            writer_literal(&mut diagnostic, "error: Forge backend unsupported MIR opcode ");
            writer_decimal(&mut diagnostic, opcode);
            writer_literal(&mut diagnostic, " at instruction ");
            writer_decimal(&mut diagnostic, ip);
            writer_newline(&mut diagnostic);
            raz_compiler_rt_stdio_write_ascii(2, diagnostic.data, diagnostic.length);
            writer_destroy(&mut diagnostic);
            raz_compiler_rt_arena_destroy(local_registers);
            return false;
        }
        ip += 1;
    }
    if (block_terminated == 0) {
        if (raz_compiler_rt_arena_get(hir.function_returns_value, function_index) == 0) {
            writer_space(out);
            writer_space(out);
            writer_keyword_return(out);
            writer_newline(out);
        } else {
            i64 final_zero = writer_synthetic_register(13, function_index);

            writer_instruction_prefix(out, final_zero);
            writer_put(out, 99);
            writer_put(out, 111);
            writer_put(out, 110);
            writer_put(out, 115);
            writer_put(out, 116);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            writer_keyword_return(out);
            writer_space(out);
            writer_register(out, final_zero);
            writer_newline(out);
        }
    }
    writer_space(out);
    writer_space(out);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    raz_compiler_rt_arena_destroy(local_registers);
    return !out.failed;
}
