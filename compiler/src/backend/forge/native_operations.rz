namespace raz_compiler_backend_forge_native_operations;

public import raz_compiler_backend_forge_native_types;

fn forge_native_append_const(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    i64 result_register,
    i64 type_kind,
    i64 value,
) -> bool {
    forge_native_scratch_reset(result);
    writer_register(result, result_register);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 1);

    i64 operation = forge_native_append_operation(block, result, opcode, forge_native_type(type_kind));

    return operation != 0 && forge_native_add_literal_operand(block, operation, operand, value);
}

fn forge_native_append_mir_const(
    i64 block,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 image_pointer_values,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    i64 instruction,
) -> bool {
    i64 type_kind = forge_native_register_type_fast(
        hir,
        mir,
        function_index,
        instruction,
        image_pointer_values,
    );
    if (type_kind < 0) {
        type_kind = raz_compiler_rt_arena_get(mir.op_types, instruction);
    }
    forge_native_scratch_reset(result);
    writer_register(result, instruction);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 1);

    i64 operation = forge_native_append_operation(block, result, opcode, forge_native_type(type_kind));

    if (operation == 0) {
        return false;
    }
    forge_native_scratch_reset(operand);
    if (primitive_type_is_float(type_kind) && raz_compiler_rt_arena_get(mir.op_b, instruction) > 0) {
        writer_text(
            operand,
            source,
            raz_compiler_rt_arena_get(mir.op_a, instruction),
            raz_compiler_rt_arena_get(mir.op_b, instruction),
        );
    } else {
        writer_decimal(operand, raz_compiler_rt_arena_get(mir.op_a, instruction));
    }
    return raz_compiler_forge_operation_add_operand_i64(block, operation, operand.data, operand.length) != 0;
}

fn forge_native_append_binary(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    MirModule& mir,
    i64 instruction,
) -> bool {
    i64 type_kind = raz_compiler_rt_arena_get(mir.op_types, instruction);

    forge_native_scratch_reset(result);
    writer_register(result, instruction);
    forge_native_scratch_reset(opcode);
    writer_operator(opcode, raz_compiler_rt_arena_get(mir.opcodes, instruction), type_kind);

    i64 operation = forge_native_append_operation(block, result, opcode, forge_native_type(type_kind));

    return (
        operation != 0 &&
        forge_native_add_register_operand(
            block,
            operation,
            operand,
            raz_compiler_rt_arena_get(mir.op_a, instruction),
        ) &&
        forge_native_add_register_operand(
            block,
            operation,
            operand,
            raz_compiler_rt_arena_get(mir.op_b, instruction),
        )
    );
}

fn forge_native_append_compare(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    MirModule& mir,
    i64 instruction,
) -> bool {
    i64 compare_register = writer_synthetic_register(4, instruction);
    i64 type_kind = raz_compiler_rt_arena_get(mir.op_types, instruction);

    forge_native_scratch_reset(result);
    writer_register(result, compare_register);
    forge_native_scratch_reset(opcode);
    writer_compare(opcode, raz_compiler_rt_arena_get(mir.opcodes, instruction), type_kind);

    i64 compare = forge_native_append_operation(block, result, opcode, forge_native_type(type_kind));

    if (
        compare == 0 ||
        !forge_native_add_register_operand(
            block,
            compare,
            operand,
            raz_compiler_rt_arena_get(mir.op_a, instruction),
        ) ||
        !forge_native_add_register_operand(
            block,
            compare,
            operand,
            raz_compiler_rt_arena_get(mir.op_b, instruction),
        )
    ) {
        return false;
    }
    forge_native_scratch_reset(result);
    writer_register(result, instruction);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 4);

    i64 select = forge_native_append_operation(block, result, opcode, 5);

    return (
        select != 0 &&
        forge_native_add_register_operand(block, select, operand, compare_register) &&
        forge_native_add_register_operand(block, select, operand, 999998) &&
        forge_native_add_register_operand(block, select, operand, 999999)
    );
}

fn forge_native_append_logical_select(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    MirModule& mir,
    i64 instruction,
    bool invert,
) -> bool {
    i64 zero_register = writer_synthetic_register(5, instruction);
    i64 condition_register = writer_synthetic_register(6, instruction);

    if (invert) {
        zero_register = writer_synthetic_register(7, instruction);
        condition_register = writer_synthetic_register(8, instruction);
    }
    if (!forge_native_append_const(block, result, opcode, operand, zero_register, 0, 0)) {
        return false;
    }
    forge_native_scratch_reset(result);
    writer_register(result, condition_register);
    forge_native_scratch_reset(opcode);
    if (invert) {
        writer_compare(opcode, 11, 0);
    } else {
        writer_compare(opcode, 12, 0);
    }

    i64 compare = forge_native_append_operation(block, result, opcode, 5);

    if (
        compare == 0 ||
        !forge_native_add_register_operand(
            block,
            compare,
            operand,
            raz_compiler_rt_arena_get(mir.op_a, instruction),
        ) ||
        !forge_native_add_register_operand(block, compare, operand, zero_register)
    ) {
        return false;
    }
    forge_native_scratch_reset(result);
    writer_register(result, instruction);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 4);

    i64 select = forge_native_append_operation(block, result, opcode, 5);

    if (select == 0 || !forge_native_add_register_operand(block, select, operand, condition_register)) {
        return false;
    }
    if (invert) {
        return (
            forge_native_add_register_operand(block, select, operand, 999998) &&
            forge_native_add_register_operand(block, select, operand, 999999)
        );
    }
    return (
        forge_native_add_register_operand(
            block,
            select,
            operand,
            raz_compiler_rt_arena_get(mir.op_b, instruction),
        ) &&
        forge_native_add_register_operand(
            block,
            select,
            operand,
            raz_compiler_rt_arena_get(mir.op_c, instruction),
        )
    );
}

fn forge_native_append_global_address(
    i64 block,
    Source& source,
    HirModule& hir,
    i64 global_index,
    i64 address_register,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
) -> bool {
    forge_native_scratch_reset(result);
    writer_register(result, address_register);
    forge_native_scratch_reset(opcode);
    if (raz_compiler_rt_arena_get(hir.global_tls_flags, global_index) != 0) {
        forge_native_writer_word(opcode, 20);
    } else {
        forge_native_writer_word(opcode, 11);
    }

    i64 operation = forge_native_append_operation(block, result, opcode, 8);

    if (operation == 0) {
        return false;
    }
    forge_native_scratch_reset(operand);
    writer_module_global_name(operand, source, hir, global_index);
    return raz_compiler_forge_operation_add_operand_i64(block, operation, operand.data, operand.length) != 0;
}

fn forge_native_append_arena_address(
    i64 block,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 base_register,
    i64 index_register,
    i64 instruction,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
) -> i64 {
    if (!forge_native_register_is_pointer(hir, mir, function_index, base_register)) {
        return -1;
    }

    i64 structure = forge_native_register_structure_id(hir, mir, function_index, base_register, 0);

    if (structure >= 0) {
        i64 field_index = forge_native_constant_index(mir, index_register);

        if (field_index < 0 || field_index >= raz_compiler_rt_arena_get(hir.struct_field_counts, structure)) {
            return -1;
        }

        i64 address_register = writer_synthetic_register(243, instruction);

        forge_native_scratch_reset(result);
        writer_register(result, address_register);
        forge_native_scratch_reset(opcode);
        forge_native_writer_word(opcode, 14);

        i64 address = forge_native_append_operation(block, result, opcode, 8);

        if (address == 0 || !forge_native_add_register_operand(block, address, operand, base_register)) {
            return -1;
        }
        forge_native_scratch_reset(operand);
        // Forge textual aggregate operands are symbols (`@Type`), while the
        // stable C ABI stores aggregate metadata as bare names. Prefix the
        // symbol marker only at operation sites.
        writer_put(operand, 64);
        writer_structure_name(operand, source, hir, structure);
        if (
            raz_compiler_forge_operation_add_operand_i64(block, address, operand.data, operand.length) == 0 ||
            !forge_native_add_literal_operand(block, address, operand, field_index)
        ) {
            return -1;
        }
        return address_register;
    }

    i64 extent = -1;
    i64 element_type = -1;
    i64 element_structure = -1;

    if (
        forge_native_register_array_info(
            hir,
            mir,
            function_index,
            base_register,
            0,
            &mut extent,
            &mut element_type,
            &mut element_structure,
        )
    ) {
        i64 element_index = forge_native_constant_index(mir, index_register);

        if (element_index >= 0 && element_index < extent) {
            i64 address_register = writer_synthetic_register(243, instruction);

            forge_native_scratch_reset(result);
            writer_register(result, address_register);
            forge_native_scratch_reset(opcode);
            forge_native_writer_word(opcode, 15);

            i64 address = forge_native_append_operation(block, result, opcode, 8);

            if (address == 0 || !forge_native_add_register_operand(block, address, operand, base_register)) {
                return -1;
            }
            forge_native_scratch_reset(operand);
            forge_native_write_array_aggregate_name(operand, extent, element_type, element_structure);
            if (
                raz_compiler_forge_operation_add_operand_i64(
                    block,
                    address,
                    operand.data,
                    operand.length,
                ) == 0 ||
                !forge_native_add_literal_operand(block, address, operand, element_index)
            ) {
                return -1;
            }
            return address_register;
        }
        // Forge v13 accepts an SSA i64 index for named array element
        // addressing. Use it for native aggregate-element arrays as well as
        // scalar arrays so dynamic `items[i]` preserves the real element
        // stride and aggregate identity.
        if (forge_native_array_supported(hir, extent, element_type, element_structure)) {
            i64 address_register = writer_synthetic_register(243, instruction);

            forge_native_scratch_reset(result);
            writer_register(result, address_register);
            forge_native_scratch_reset(opcode);
            forge_native_writer_word(opcode, 15);

            i64 address = forge_native_append_operation(block, result, opcode, 8);

            if (address == 0 || !forge_native_add_register_operand(block, address, operand, base_register)) {
                return -1;
            }
            forge_native_scratch_reset(operand);
            forge_native_write_array_aggregate_name(operand, extent, element_type, element_structure);
            if (
                raz_compiler_forge_operation_add_operand_i64(
                    block,
                    address,
                    operand.data,
                    operand.length,
                ) == 0 ||
                !forge_native_add_register_operand(block, address, operand, index_register)
            ) {
                return -1;
            }
            return address_register;
        }
        return -1;
    }

    i64 scale_register = writer_synthetic_register(241, instruction);

    if (!forge_native_append_const(block, result, opcode, operand, scale_register, 0, 8)) {
        return -1;
    }

    i64 offset_register = writer_synthetic_register(242, instruction);

    forge_native_scratch_reset(result);
    writer_register(result, offset_register);
    forge_native_scratch_reset(opcode);
    writer_operator(opcode, 6, 0);

    i64 multiply = forge_native_append_operation(block, result, opcode, 5);

    if (
        multiply == 0 ||
        !forge_native_add_register_operand(block, multiply, operand, index_register) ||
        !forge_native_add_register_operand(block, multiply, operand, scale_register)
    ) {
        return -1;
    }

    i64 address_register = writer_synthetic_register(243, instruction);

    forge_native_scratch_reset(result);
    writer_register(result, address_register);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 12);

    i64 address = forge_native_append_operation(block, result, opcode, 8);

    if (
        address == 0 ||
        !forge_native_add_register_operand(block, address, operand, base_register) ||
        !forge_native_add_register_operand(block, address, operand, offset_register)
    ) {
        return -1;
    }
    return address_register;
}

fn forge_native_local_uses_callback_storage(
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 local_slot,
) -> bool {
    i64 instruction = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = instruction + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);

    while (instruction < end) {
        if (
            raz_compiler_rt_arena_get(mir.opcodes, instruction) == 9 &&
            raz_compiler_rt_arena_get(mir.op_a, instruction) == local_slot
        ) {
            i64 value = raz_compiler_rt_arena_get(mir.op_b, instruction);

            if (value >= 0 && value < mir.instruction_count) {
                i64 value_opcode = raz_compiler_rt_arena_get(mir.opcodes, value);

                if (value_opcode == 43 || forge_native_register_type(hir, mir, function_index, value) == 14) {
                    return true;
                }
            }
        }
        instruction += 1;
    }
    return false;
}

fn forge_native_module_uses_owned_callables(MirModule& mir) -> bool {
    i64 instruction = 0;

    while (instruction < mir.instruction_count) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, instruction);

        if (opcode == 50 || opcode == 51 || opcode == 52 || opcode == 53) {
            return true;
        }
        instruction += 1;
    }
    return false;
}

fn forge_native_callable_capture_blob_offset(HirModule& hir, i64 closure_function, i64 capture_index) -> i64 {
    i64 capture_count = raz_compiler_rt_arena_get(hir.function_closure_capture_counts, closure_function);

    i64 explicit_count = raz_compiler_rt_arena_get(
        hir.function_closure_explicit_parameter_counts,
        closure_function,
    );

    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, closure_function);
    i64 offset = capture_count * 8;
    i64 capture = 0;

    while (capture < capture_index) {
        i64 parameter_index = parameter_start + explicit_count + capture;
        i64 structure = raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index);

        if (structure >= 0) {
            offset += raz_compiler_rt_arena_get(hir.struct_field_counts, structure) * 8;
        }
        capture += 1;
    }
    return offset;
}

fn forge_native_callable_environment_size(HirModule& hir, i64 closure_function) -> i64 {
    i64 capture_count = raz_compiler_rt_arena_get(hir.function_closure_capture_counts, closure_function);
    i64 size = capture_count * 8;

    i64 explicit_count = raz_compiler_rt_arena_get(
        hir.function_closure_explicit_parameter_counts,
        closure_function,
    );

    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, closure_function);
    i64 capture = 0;

    while (capture < capture_count) {
        i64 structure = raz_compiler_rt_arena_get(
            hir.parameter_type_structs,
            parameter_start + explicit_count + capture,
        );
        if (structure >= 0) {
            size += raz_compiler_rt_arena_get(hir.struct_field_counts, structure) * 8;
        }
        capture += 1;
    }
    if (size <= 0) {
        return 1;
    }
    return size;
}

fn forge_native_callable_signature_result_size(HirModule& hir, i64 signature) -> i64 {
    i64 return_type = forge_native_function_type_return_type(hir, signature);

    if (return_type < 0) {
        return 0;
    }
    return 8;
}

fn forge_native_append_parameter_address(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    i64 result_register,
    i64 parameter,
    i64 byte_offset,
    i64 temp_seed,
) -> bool {
    if (byte_offset == 0) {
        forge_native_scratch_reset(result);
        writer_register(result, result_register);
        forge_native_scratch_reset(opcode);
        forge_native_writer_word(opcode, 2);

        i64 copy = forge_native_append_operation(block, result, opcode, 8);

        return copy != 0 && forge_native_add_parameter_operand(block, copy, operand, parameter);
    }

    i64 offset_register = writer_synthetic_register(700 + temp_seed, result_register);

    if (!forge_native_append_const(block, result, opcode, operand, offset_register, 0, byte_offset)) {
        return false;
    }
    forge_native_scratch_reset(result);
    writer_register(result, result_register);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 12);

    i64 address = forge_native_append_operation(block, result, opcode, 8);

    return (
        address != 0 &&
        forge_native_add_parameter_operand(block, address, operand, parameter) &&
        forge_native_add_register_operand(block, address, operand, offset_register)
    );
}

fn forge_native_append_register_address(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    i64 result_register,
    i64 base_register,
    i64 byte_offset,
    i64 temp_seed,
) -> bool {
    if (byte_offset == 0) {
        forge_native_scratch_reset(result);
        writer_register(result, result_register);
        forge_native_scratch_reset(opcode);
        forge_native_writer_word(opcode, 2);

        i64 copy = forge_native_append_operation(block, result, opcode, 8);

        return copy != 0 && forge_native_add_register_operand(block, copy, operand, base_register);
    }

    i64 offset_register = writer_synthetic_register(750 + temp_seed, result_register);

    if (!forge_native_append_const(block, result, opcode, operand, offset_register, 0, byte_offset)) {
        return false;
    }
    forge_native_scratch_reset(result);
    writer_register(result, result_register);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 12);

    i64 address = forge_native_append_operation(block, result, opcode, 8);

    return (
        address != 0 &&
        forge_native_add_register_operand(block, address, operand, base_register) &&
        forge_native_add_register_operand(block, address, operand, offset_register)
    );
}

fn forge_native_emit_callable_adapter(
    i64 session,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 closure_function,
    i64 instruction,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
) -> bool {
    i64 signature = raz_compiler_rt_arena_get(mir.op_d, instruction);

    i64 explicit_count = raz_compiler_rt_arena_get(
        hir.function_closure_explicit_parameter_counts,
        closure_function,
    );

    i64 capture_count = raz_compiler_rt_arena_get(hir.function_closure_capture_counts, closure_function);

    forge_native_scratch_reset(operand);
    forge_native_writer_callable_adapter_name(operand, closure_function, instruction, false);
    i64 function_handle = raz_compiler_forge_session_add_function_i64(
        session,
        operand.data,
        operand.length,
        4,
        0,
        0,
        0,
        0,
        0,
        -1,
        0,
        0,
    );
    if (function_handle == 0 || raz_compiler_forge_function_set_abi_i64(function_handle, 0, 0, 1, 0) == 0) {
        return false;
    }

    i64 parameter_types[5] = [8, 8, 5, 8, 5];
    i64 parameter = 0;

    while (parameter < 5) {
        forge_native_scratch_reset(operand);
        writer_parameter(operand, parameter);
        if (
            raz_compiler_forge_function_add_parameter_i64(
                function_handle,
                operand.data,
                operand.length,
                parameter_types[parameter],
                0,
                0,
                0,
                0,
                0,
                0,
                0,
            ) == 0
        ) {
            return false;
        }
        parameter += 1;
    }
    forge_native_scratch_reset(operand);

    

    writer_literal(operand, "entry");
    i64 block = raz_compiler_forge_session_add_block_i64(
        session,
        function_handle,
        operand.data,
        operand.length,
    );
    if (block == 0) {
        return false;
    }

    i64 callback_arguments = raz_compiler_rt_arena_create(explicit_count + capture_count + 1);

    if (callback_arguments == 0) {
        return false;
    }

    bool success = true;
    i64 signature_start = raz_compiler_rt_arena_get(hir.function_type_parameter_starts, signature);
    i64 argument = 0;

    while (success && argument < explicit_count) {
        i64 argument_address = writer_synthetic_register(800 + argument * 3, instruction);

        if (
            !forge_native_append_parameter_address(
                block,
                result,
                opcode,
                operand,
                argument_address,
                1,
                argument * 8,
                argument,
            )
        ) {
            success = false;
        } else {
            i64 value_register = writer_synthetic_register(801 + argument * 3, instruction);
            i64 argument_type = forge_native_function_type_parameter_type(hir, signature_start + argument);
            i64 alignment = forge_native_scalar_storage_size(argument_type);

            forge_native_scratch_reset(result);
            writer_register(result, value_register);
            forge_native_scratch_reset(opcode);
            forge_native_writer_word(opcode, 9);

            i64 load = forge_native_append_operation(block, result, opcode, forge_native_type(argument_type));

            if (
                load == 0 ||
                !forge_native_add_register_operand(block, load, operand, argument_address) ||
                raz_compiler_forge_operation_set_alignment_i64(block, load, alignment) == 0
            ) {
                success = false;
            } else {
                raz_compiler_rt_arena_set(callback_arguments, argument, value_register);
            }
        }
        argument += 1;
    }

    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, closure_function);
    i64 capture = 0;

    while (success && capture < capture_count) {
        i64 parameter_index = parameter_start + explicit_count + capture;
        i64 structure = raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index);
        i64 value_register = writer_synthetic_register(900 + capture * 4, instruction);

        if (structure >= 0) {
            i64 blob_offset = forge_native_callable_capture_blob_offset(hir, closure_function, capture);

            if (
                !forge_native_append_parameter_address(
                    block,
                    result,
                    opcode,
                    operand,
                    value_register,
                    0,
                    blob_offset,
                    50 + capture,
                )
            ) {
                success = false;
            }
        } else {
            i64 slot_address = writer_synthetic_register(901 + capture * 4, instruction);

            if (
                !forge_native_append_parameter_address(
                    block,
                    result,
                    opcode,
                    operand,
                    slot_address,
                    0,
                    capture * 8,
                    80 + capture,
                )
            ) {
                success = false;
            } else {
                i64 capture_type = forge_native_parameter_type(hir, parameter_index);
                i64 alignment = forge_native_scalar_storage_size(capture_type);

                forge_native_scratch_reset(result);
                writer_register(result, value_register);
                forge_native_scratch_reset(opcode);
                forge_native_writer_word(opcode, 9);
                i64 load = forge_native_append_operation(
                    block,
                    result,
                    opcode,
                    forge_native_type(capture_type),
                );
                if (
                    load == 0 ||
                    !forge_native_add_register_operand(block, load, operand, slot_address) ||
                    raz_compiler_forge_operation_set_alignment_i64(block, load, alignment) == 0
                ) {
                    success = false;
                }
            }
        }
        if (success) {
            raz_compiler_rt_arena_set(callback_arguments, explicit_count + capture, value_register);
        }
        capture += 1;
    }

    bool returns_value = raz_compiler_rt_arena_get(hir.function_returns_value, closure_function) != 0;
    i64 callback_result = writer_synthetic_register(980, instruction);

    if (success) {
        forge_native_scratch_reset(result);
        if (returns_value) {
            writer_register(result, callback_result);
        }
        forge_native_scratch_reset(opcode);
        forge_native_writer_word(opcode, 3);

        i64 return_type = 0;

        if (returns_value) {
            return_type = forge_native_type(forge_native_function_return_type(hir, closure_function));
        }

        i64 call = forge_native_append_operation(block, result, opcode, return_type);

        if (
            call == 0 ||
            !forge_native_add_function_operand(block, call, operand, source, hir, closure_function)
        ) {
            success = false;
        } else {
            i64 index = 0;

            while (success && index < explicit_count + capture_count) {
                if (
                    !forge_native_add_register_operand(
                        block,
                        call,
                        operand,
                        raz_compiler_rt_arena_get(callback_arguments, index),
                    )
                ) {
                    success = false;
                }
                index += 1;
            }
        }
    }
    if (success && returns_value) {
        forge_native_scratch_reset(result);
        forge_native_scratch_reset(opcode);
        forge_native_writer_word(opcode, 10);

        i64 value_type = forge_native_function_return_type(hir, closure_function);
        i64 store = forge_native_append_operation(block, result, opcode, forge_native_type(value_type));

        if (
            store == 0 ||
            !forge_native_add_register_operand(block, store, operand, callback_result) ||
            !forge_native_add_parameter_operand(block, store, operand, 3) ||
            raz_compiler_forge_operation_set_alignment_i64(
                block,
                store,
                forge_native_scalar_storage_size(value_type),
            ) == 0
        ) {
            success = false;
        }
    }

    i64 zero_result = writer_synthetic_register(990, instruction);

    if (success && !forge_native_append_const(block, result, opcode, operand, zero_result, 7, 0)) {
        success = false;
    }
    if (success) {
        forge_native_scratch_reset(result);
        forge_native_scratch_reset(opcode);
        forge_native_writer_word(opcode, 5);

        i64 ret = forge_native_append_operation(block, result, opcode, 0);

        if (ret == 0 || !forge_native_add_register_operand(block, ret, operand, zero_result)) {
            success = false;
        }
    }
    raz_compiler_rt_arena_destroy(callback_arguments);
    return success;
}

fn forge_native_callable_needs_drop_thunk(HirModule& hir, i64 closure_function) -> bool {
    i64 explicit_count = raz_compiler_rt_arena_get(
        hir.function_closure_explicit_parameter_counts,
        closure_function,
    );

    i64 capture_count = raz_compiler_rt_arena_get(hir.function_closure_capture_counts, closure_function);
    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, closure_function);
    i64 capture = 0;

    while (capture < capture_count) {
        i64 parameter_index = parameter_start + explicit_count + capture;

        if (raz_compiler_rt_arena_get(hir.parameter_references, parameter_index) == 0) {
            i64 structure = raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index);

            if (structure >= 0 && raz_compiler_rt_arena_get(hir.struct_drop_functions, structure) >= 0) {
                return true;
            }
        }
        capture += 1;
    }
    return false;
}

fn forge_native_emit_callable_drop_thunk(
    i64 session,
    Source& source,
    HirModule& hir,
    i64 closure_function,
    i64 instruction,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
) -> bool {
    forge_native_scratch_reset(operand);
    forge_native_writer_callable_drop_name(operand, closure_function, instruction, false);
    i64 function_handle = raz_compiler_forge_session_add_function_i64(
        session,
        operand.data,
        operand.length,
        0,
        0,
        0,
        0,
        0,
        0,
        -1,
        0,
        0,
    );
    if (function_handle == 0 || raz_compiler_forge_function_set_abi_i64(function_handle, 0, 0, 1, 0) == 0) {
        return false;
    }
    forge_native_scratch_reset(operand);
    writer_parameter(operand, 0);
    if (
        raz_compiler_forge_function_add_parameter_i64(
            function_handle,
            operand.data,
            operand.length,
            8,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
        ) == 0
    ) {
        return false;
    }
    forge_native_scratch_reset(operand);

    

    writer_literal(operand, "entry");
    i64 block = raz_compiler_forge_session_add_block_i64(
        session,
        function_handle,
        operand.data,
        operand.length,
    );
    if (block == 0) {
        return false;
    }
    i64 explicit_count = raz_compiler_rt_arena_get(
        hir.function_closure_explicit_parameter_counts,
        closure_function,
    );

    i64 capture_count = raz_compiler_rt_arena_get(hir.function_closure_capture_counts, closure_function);
    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, closure_function);
    i64 capture = capture_count;

    while (capture > 0) {
        capture -= 1;

        i64 parameter_index = parameter_start + explicit_count + capture;
        i64 structure = raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index);
        i64 drop_function = -1;

        if (structure >= 0 && raz_compiler_rt_arena_get(hir.parameter_references, parameter_index) == 0) {
            drop_function = raz_compiler_rt_arena_get(hir.struct_drop_functions, structure);
        }
        if (drop_function >= 0) {
            i64 address_register = writer_synthetic_register(1000 + capture * 2, instruction);

            if (
                !forge_native_append_parameter_address(
                    block,
                    result,
                    opcode,
                    operand,
                    address_register,
                    0,
                    forge_native_callable_capture_blob_offset(hir, closure_function, capture),
                    120 + capture,
                )
            ) {
                return false;
            }
            forge_native_scratch_reset(result);
            forge_native_scratch_reset(opcode);
            forge_native_writer_word(opcode, 3);

            i64 call = forge_native_append_operation(block, result, opcode, 0);

            if (
                call == 0 ||
                !forge_native_add_function_operand(block, call, operand, source, hir, drop_function) ||
                !forge_native_add_register_operand(block, call, operand, address_register)
            ) {
                return false;
            }
        }
    }
    forge_native_scratch_reset(result);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 3);

    i64 dealloc = forge_native_append_operation(block, result, opcode, 0);

    if (
        dealloc == 0 ||
        !forge_native_add_runtime_operand(block, dealloc, operand, 2) ||
        !forge_native_add_parameter_operand(block, dealloc, operand, 0)
    ) {
        return false;
    }
    forge_native_scratch_reset(result);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 5);
    return forge_native_append_operation(block, result, opcode, 0) != 0;
}

fn forge_native_append_callable_function_address(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    i64 result_register,
    i64 closure_function,
    i64 instruction,
    bool drop_thunk,
) -> bool {
    forge_native_scratch_reset(result);
    writer_register(result, result_register);
    forge_native_scratch_reset(opcode);

    

    writer_literal(opcode, "func.address");

    i64 operation = forge_native_append_operation(block, result, opcode, 8);

    if (operation == 0) {
        return false;
    }
    forge_native_scratch_reset(operand);
    if (drop_thunk) {
        forge_native_writer_callable_drop_name(operand, closure_function, instruction, true);
    } else {
        forge_native_writer_callable_adapter_name(operand, closure_function, instruction, true);
    }
    return raz_compiler_forge_operation_add_operand_i64(block, operation, operand.data, operand.length) != 0;
}

fn forge_native_append_runtime_function_address(
    i64 block,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
    i64 result_register,
    i64 runtime_kind,
) -> bool {
    forge_native_scratch_reset(result);
    writer_register(result, result_register);
    forge_native_scratch_reset(opcode);

    

    writer_literal(opcode, "func.address");

    i64 operation = forge_native_append_operation(block, result, opcode, 8);

    if (operation == 0) {
        return false;
    }
    return forge_native_add_runtime_operand(block, operation, operand, runtime_kind);
}

fn forge_native_append_callable_create(
    i64 block,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 instruction,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
) -> bool {
    i64 closure_function = raz_compiler_rt_arena_get(mir.op_a, instruction);
    i64 closure_kind = raz_compiler_rt_arena_get(mir.op_b, instruction);
    i64 argument_start = raz_compiler_rt_arena_get(mir.op_c, instruction);
    i64 signature = raz_compiler_rt_arena_get(mir.op_d, instruction);
    i64 capture_count = raz_compiler_rt_arena_get(hir.function_closure_capture_counts, closure_function);

    i64 explicit_count = raz_compiler_rt_arena_get(
        hir.function_closure_explicit_parameter_counts,
        closure_function,
    );

    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, closure_function);
    i64 environment_size = forge_native_callable_environment_size(hir, closure_function);

    // Allocate the erased closure environment.

    i64 size_register = writer_synthetic_register(1100, instruction);

    if (!forge_native_append_const(block, result, opcode, operand, size_register, 9, environment_size)) {
        return false;
    }

    i64 environment_register = writer_synthetic_register(1101, instruction);

    forge_native_scratch_reset(result);
    writer_register(result, environment_register);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 3);

    i64 allocation = forge_native_append_operation(block, result, opcode, 8);

    if (
        allocation == 0 ||
        !forge_native_add_runtime_operand(block, allocation, operand, 1) ||
        !forge_native_add_register_operand(block, allocation, operand, size_register)
    ) {
        return false;
    }
    // The first capture_count * 8 bytes are scalar capture slots. Aggregate
    // capture images are stored in the trailing typed blob area used by the
    // generated adapter/drop thunks.

    i64 capture = 0;

    while (capture < capture_count) {
        i64 capture_register = raz_compiler_rt_arena_get(mir.call_arguments, argument_start + capture);
        i64 parameter_index = parameter_start + explicit_count + capture;
        i64 structure = raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index);
        i64 capture_offset = capture * 8;

        if (structure >= 0) {
            capture_offset = forge_native_callable_capture_blob_offset(hir, closure_function, capture);
        }

        i64 address_register = writer_synthetic_register(1110 + capture * 4, instruction);

        if (
            !forge_native_append_register_address(
                block,
                result,
                opcode,
                operand,
                address_register,
                environment_register,
                capture_offset,
                210 + capture,
            )
        ) {
            return false;
        }
        if (structure >= 0) {
            i64 bytes = raz_compiler_rt_arena_get(hir.struct_field_counts, structure) * 8;
            i64 bytes_register = writer_synthetic_register(1111 + capture * 4, instruction);

            if (!forge_native_append_const(block, result, opcode, operand, bytes_register, 9, bytes)) {
                return false;
            }
            forge_native_scratch_reset(result);
            forge_native_scratch_reset(opcode);
            forge_native_writer_word(opcode, 3);

            i64 copy = forge_native_append_operation(block, result, opcode, 0);

            if (
                copy == 0 ||
                !forge_native_add_runtime_operand(block, copy, operand, 3) ||
                !forge_native_add_register_operand(block, copy, operand, address_register) ||
                !forge_native_add_register_operand(block, copy, operand, capture_register) ||
                !forge_native_add_register_operand(block, copy, operand, bytes_register)
            ) {
                return false;
            }
        } else {
            i64 capture_type = forge_native_parameter_type(hir, parameter_index);
            i64 alignment = forge_native_scalar_storage_size(capture_type);

            if (alignment <= 0) {
                alignment = 8;
            }
            forge_native_scratch_reset(result);
            forge_native_scratch_reset(opcode);
            forge_native_writer_word(opcode, 10);

            i64 store = forge_native_append_operation(block, result, opcode, forge_native_type(capture_type));

            if (
                store == 0 ||
                !forge_native_add_register_operand(block, store, operand, capture_register) ||
                !forge_native_add_register_operand(block, store, operand, address_register) ||
                raz_compiler_forge_operation_set_alignment_i64(block, store, alignment) == 0
            ) {
                return false;
            }
        }
        capture += 1;
    }

    i64 adapter_register = writer_synthetic_register(1180, instruction);

    if (
        !forge_native_append_callable_function_address(
            block,
            result,
            opcode,
            operand,
            adapter_register,
            closure_function,
            instruction,
            false,
        )
    ) {
        return false;
    }

    i64 null_register = writer_synthetic_register(1181, instruction);

    if (!forge_native_append_const(block, result, opcode, operand, null_register, 12, 0)) {
        return false;
    }

    i64 drop_register = writer_synthetic_register(1182, instruction);

    if (forge_native_callable_needs_drop_thunk(hir, closure_function)) {
        if (
            !forge_native_append_callable_function_address(
                block,
                result,
                opcode,
                operand,
                drop_register,
                closure_function,
                instruction,
                true,
            )
        ) {
            return false;
        }
    } else if (
        !forge_native_append_runtime_function_address(block, result, opcode, operand, drop_register, 2)
    ) {
        return false;
    }

    i64 kind_value = 0;

    if (closure_kind == 3) {
        kind_value = 1;
    } else if (closure_kind == 4) {
        kind_value = 2;
    }

    i64 kind_register = writer_synthetic_register(1183, instruction);

    if (!forge_native_append_const(block, result, opcode, operand, kind_register, 7, kind_value)) {
        return false;
    }

    i64 signature_register = writer_synthetic_register(1184, instruction);

    if (
        !forge_native_append_const(
            block,
            result,
            opcode,
            operand,
            signature_register,
            9,
            forge_native_canonical_signature(hir, signature),
        )
    ) {
        return false;
    }

    i64 argument_size_register = writer_synthetic_register(1185, instruction);

    if (
        !forge_native_append_const(
            block,
            result,
            opcode,
            operand,
            argument_size_register,
            9,
            explicit_count * 8,
        )
    ) {
        return false;
    }

    i64 result_size_register = writer_synthetic_register(1186, instruction);

    if (
        !forge_native_append_const(
            block,
            result,
            opcode,
            operand,
            result_size_register,
            9,
            forge_native_callable_signature_result_size(hir, signature),
        )
    ) {
        return false;
    }
    forge_native_scratch_reset(result);
    writer_register(result, instruction);
    forge_native_scratch_reset(opcode);
    forge_native_writer_word(opcode, 3);

    i64 create = forge_native_append_operation(block, result, opcode, 8);

    return (
        create != 0 &&
        forge_native_add_runtime_operand(block, create, operand, 4) &&
        forge_native_add_register_operand(block, create, operand, environment_register) &&
        forge_native_add_register_operand(block, create, operand, adapter_register) &&
        forge_native_add_register_operand(block, create, operand, null_register) &&
        forge_native_add_register_operand(block, create, operand, drop_register) &&
        forge_native_add_register_operand(block, create, operand, kind_register) &&
        forge_native_add_register_operand(block, create, operand, signature_register) &&
        forge_native_add_register_operand(block, create, operand, argument_size_register) &&
        forge_native_add_register_operand(block, create, operand, result_size_register)
    );
}

fn forge_native_emit_callable_support_functions(
    i64 session,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
) -> bool {
    i64 instruction = 0;

    while (instruction < mir.instruction_count) {
        if (raz_compiler_rt_arena_get(mir.opcodes, instruction) == 50) {
            i64 closure_function = raz_compiler_rt_arena_get(mir.op_a, instruction);

            if (
                !forge_native_emit_callable_adapter(
                    session,
                    source,
                    hir,
                    mir,
                    closure_function,
                    instruction,
                    result,
                    opcode,
                    operand,
                )
            ) {
                return false;
            }
            if (
                forge_native_callable_needs_drop_thunk(hir, closure_function) &&
                !forge_native_emit_callable_drop_thunk(
                    session,
                    source,
                    hir,
                    closure_function,
                    instruction,
                    result,
                    opcode,
                    operand,
                )
            ) {
                return false;
            }
        }
        instruction += 1;
    }
    return true;
}

fn forge_native_parameter_is_call_aggregate(HirModule& hir, i64 parameter_index) -> bool {
    if (raz_compiler_rt_arena_get(hir.parameter_references, parameter_index) != 0) {
        return false;
    }
    if (raz_compiler_rt_arena_get(hir.parameter_slices, parameter_index) != 0) {
        return true;
    }

    i64 structure = raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index);
    i64 extent = raz_compiler_rt_arena_get(hir.parameter_array_extents, parameter_index);

    if (extent >= 0) {
        return forge_native_parameter_array_supported(hir, parameter_index);
    }
    return structure >= 0 && forge_native_flat_return_structure_supported(hir, structure);
}

fn forge_native_call_aggregate_register(i64 call_instruction, i64 argument_index) -> i64 {
    return writer_synthetic_register(500 + argument_index, call_instruction);
}

fn forge_native_materialize_call_aggregate(
    i64 block,
    Source& source,
    HirModule& hir,
    i64 parameter_index,
    i64 source_register,
    i64 call_instruction,
    i64 argument_index,
    ForgeWriter&mut result,
    ForgeWriter&mut opcode,
    ForgeWriter&mut operand,
) -> bool {
    if (!forge_native_parameter_is_call_aggregate(hir, parameter_index)) {
        return true;
    }

    i64 destination_register = forge_native_call_aggregate_register(call_instruction, argument_index);
    bool slice = raz_compiler_rt_arena_get(hir.parameter_slices, parameter_index) != 0;
    i64 structure = raz_compiler_rt_arena_get(hir.parameter_type_structs, parameter_index);
    i64 extent = raz_compiler_rt_arena_get(hir.parameter_array_extents, parameter_index);
    bool array = !slice && extent >= 0;

    forge_native_scratch_reset(result);
    writer_register(result, destination_register);
    forge_native_scratch_reset(opcode);
    if (array) {
        

        writer_literal(opcode, "stack.alloc.array");
    } else {
        

        writer_literal(opcode, "stack.alloc.struct");
    }

    i64 allocation = forge_native_append_operation(block, result, opcode, 8);

    if (allocation == 0) {
        return false;
    }
    forge_native_scratch_reset(operand);
    if (slice) {
        forge_native_writer_slice_name(operand);
    } else if (array) {
        forge_native_write_array_aggregate_name(
            operand,
            extent,
            raz_compiler_rt_arena_get(hir.parameter_types, parameter_index),
            structure,
        );
    } else {
        writer_put(operand, 64);
        writer_structure_name(operand, source, hir, structure);
    }
    if (raz_compiler_forge_operation_add_operand_i64(block, allocation, operand.data, operand.length) == 0) {
        return false;
    }
    forge_native_scratch_reset(result);
    forge_native_scratch_reset(opcode);

    i64 copy_opcode = 16;

    if (array) {
        copy_opcode = 17;
    }
    forge_native_writer_word(opcode, copy_opcode);

    i64 copy = forge_native_append_operation(block, result, opcode, 0);

    if (
        copy == 0 ||
        !forge_native_add_register_operand(block, copy, operand, destination_register) ||
        !forge_native_add_register_operand(block, copy, operand, source_register)
    ) {
        return false;
    }
    forge_native_scratch_reset(operand);
    if (slice) {
        forge_native_writer_slice_name(operand);
    } else if (array) {
        forge_native_write_array_aggregate_name(
            operand,
            extent,
            raz_compiler_rt_arena_get(hir.parameter_types, parameter_index),
            structure,
        );
    } else {
        writer_put(operand, 64);
        writer_structure_name(operand, source, hir, structure);
    }
    return raz_compiler_forge_operation_add_operand_i64(block, copy, operand.data, operand.length) != 0;
}
