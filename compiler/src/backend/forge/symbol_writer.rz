namespace raz_compiler_backend_forge_symbol_writer;
public import raz_compiler_backend_forge_writer;
// Shared Forge symbol naming helpers. This module follows forge_writer.rz so
// writer primitives are declared before these helpers and precedes all backends.
// Module-global names are shared by textual and structured Forge lowering.
fn writer_module_global_needs_identity_suffix(Source& source, HirModule& hir, i64 global_index) -> bool {
  if (raz_compiler_rt_arena_get(hir.global_extern_flags, global_index) != 0) {
    return false;
  }

  i64 offset = raz_compiler_rt_arena_get(hir.global_name_offsets, global_index);
  i64 length = raz_compiler_rt_arena_get(hir.global_name_lengths, global_index);
  i64 index = 0;

  while (index < hir.global_count) {
    if (
    index != global_index &&
    raz_compiler_rt_arena_get(hir.global_extern_flags, index) == 0 &&
    token_same(
    source,
    offset,
    length,
    raz_compiler_rt_arena_get(hir.global_name_offsets, index),
    raz_compiler_rt_arena_get(hir.global_name_lengths, index),
    )
    ) {
      return true;
    }
    index += 1;
  }
  return false;
}

fn writer_module_global_name(ForgeWriter&mut out, Source& source, HirModule& hir, i64 global_index) {
  writer_put(out, 64);
  if (raz_compiler_rt_arena_get(hir.global_extern_flags, global_index) == 0) {
    i64 prefix[13] = [95, 95, 114, 97, 122, 95, 103, 108, 111, 98, 97, 108, 95];
    i64 index = 0;

    while (index < 13) {
      writer_put(out, prefix[index]);
      index += 1;
    }
  }
  writer_text(
  out,
  source,
  raz_compiler_rt_arena_get(hir.global_name_offsets, global_index),
  raz_compiler_rt_arena_get(hir.global_name_lengths, global_index),
  );
  if (writer_module_global_needs_identity_suffix(source, hir, global_index)) {
    writer_put(out, 95);
    writer_put(out, 103);
    writer_decimal(out, global_index);
  }
}
