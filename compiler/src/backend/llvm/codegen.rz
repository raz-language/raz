namespace raz_compiler_backend_llvm_codegen;

public import raz_compiler_backend_llvm_globals_codegen;

// LLVM MIR function/module emission. Frontend and MIR semantics remain backend-neutral.
fn llvm_string_global_name(ForgeWriter&mut out, i64 instruction) {
    i64 prefix[9] = [64, 46, 114, 97, 122, 46, 115, 116, 114];

    llvm_chars(out, &prefix, 9);
    writer_decimal(out, instruction);
}

fn llvm_emit_string_globals(ForgeWriter&mut out, Source& source, MirModule& mir) {
    i64 ip = 0;
    bool emitted = false;

    while (ip < mir.instruction_count) {
        if (raz_compiler_rt_arena_get(mir.opcodes, ip) == 42) {
            i64 offset = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 length = raz_compiler_rt_arena_get(mir.op_b, ip);

            llvm_string_global_name(out, ip);

            i64 head[29] = [32, 61, 32, 112, 114, 105, 118, 97, 116, 101, 32, 117, 110, 110, 97, 109, 101, 100, 95, 97, 100, 100, 114, 32, 99, 111, 110, 115, 116];

            llvm_chars(out, &head, 29);
            writer_space(out);
            writer_put(out, 91);
            writer_decimal(out, length + 1);

            i64 xtype[6] = [32, 120, 32, 105, 56, 93];

            llvm_chars(out, &xtype, 6);
            writer_space(out);
            writer_put(out, 91);

            i64 index = 0;

            while (index < length) {
                if (index > 0) {
                    writer_put(out, 44);
                    writer_space(out);
                }
                writer_put(out, 105);
                writer_put(out, 56);
                writer_space(out);
                writer_decimal(out, source_byte(source, offset + index));
                index += 1;
            }
            if (length > 0) {
                writer_put(out, 44);
                writer_space(out);
            }
            writer_put(out, 105);
            writer_put(out, 56);
            writer_space(out);
            writer_decimal(out, 0);
            writer_put(out, 93);
            writer_newline(out);
            emitted = true;
        }
        ip += 1;
    }
    if (emitted) {
        writer_newline(out);
    }
}

fn llvm_symbol_list_contains(
    Source& source,
    HirModule& hir,
    i64 function_index,
    i64 data,
    i64 offset,
    i64 length,
) -> bool {
    if (data == 0 || length <= 0) {
        return false;
    }

    i64 name_offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
    i64 name_length = raz_compiler_rt_arena_get(hir.function_name_lengths, function_index);
    i64 start = 0;
    i64 cursor = 0;

    while (cursor <= length) {
        bool end = cursor == length;
        bool separator = false;

        if (!end) {
            separator = raz_compiler_rt_arena_get(data, offset + cursor) == 44;
        }
        if (end || separator) {
            i64 item_length = cursor - start;

            if (item_length == name_length) {
                i64 i = 0;
                bool same = true;

                while (i < name_length && same) {
                    if (
                        raz_compiler_rt_arena_get(
                            data,
                            offset + start + i,
                        ) != source_byte(source, name_offset + i)
                    ) {
                        same = false;
                    }
                    i += 1;
                }
                if (same) {
                    return true;
                }
            }
            start = cursor + 1;
        }
        cursor += 1;
    }
    return false;
}

fn llvm_validate_symbol_options(Source& source, HirModule& hir, LlvmTargetOptions& options) -> bool {
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        bool is_import = llvm_symbol_list_contains(
            source,
            hir,
            function_index,
            options.import_arg,
            options.import_offset,
            options.import_length,
        );
        bool is_export = llvm_symbol_list_contains(
            source,
            hir,
            function_index,
            options.export_arg,
            options.export_offset,
            options.export_length,
        );
        bool is_weak = llvm_symbol_list_contains(
            source,
            hir,
            function_index,
            options.weak_arg,
            options.weak_offset,
            options.weak_length,
        );
        bool is_linkonce = llvm_symbol_list_contains(
            source,
            hir,
            function_index,
            options.linkonce_arg,
            options.linkonce_offset,
            options.linkonce_length,
        );

        bool declaration = raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0;

        if (is_import && (!declaration || is_export || is_weak || is_linkonce)) {
            return false;
        }
        if ((is_export || is_weak || is_linkonce) && declaration) {
            return false;
        }
        if (is_weak && is_linkonce) {
            return false;
        }
        function_index += 1;
    }
    return true;
}

fn llvm_emit_symbol_prefix(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    LlvmTargetOptions& options,
    i64 function_index,
    bool declaration,
    bool generated_helper,
) {
    if (generated_helper) {
        i64 internal_word[9] = [105, 110, 116, 101, 114, 110, 97, 108, 32];

        llvm_chars(out, &internal_word, 9);
        return;
    }
    bool is_import = llvm_symbol_list_contains(
        source,
        hir,
        function_index,
        options.import_arg,
        options.import_offset,
        options.import_length,
    );
    bool is_export = llvm_symbol_list_contains(
        source,
        hir,
        function_index,
        options.export_arg,
        options.export_offset,
        options.export_length,
    );
    bool is_weak = llvm_symbol_list_contains(
        source,
        hir,
        function_index,
        options.weak_arg,
        options.weak_offset,
        options.weak_length,
    );
    bool is_linkonce = llvm_symbol_list_contains(
        source,
        hir,
        function_index,
        options.linkonce_arg,
        options.linkonce_offset,
        options.linkonce_length,
    );
    if (is_linkonce && !declaration) {
        i64 word[13] = [108, 105, 110, 107, 111, 110, 99, 101, 95, 111, 100, 114, 32];

        llvm_chars(out, &word, 13);
    } else if (is_weak && !declaration) {
        i64 word[5] = [119, 101, 97, 107, 32];

        llvm_chars(out, &word, 5);
    }
    if (is_import && declaration) {
        i64 word[10] = [100, 108, 108, 105, 109, 112, 111, 114, 116, 32];

        llvm_chars(out, &word, 10);
    } else if (is_export && !declaration) {
        i64 word[10] = [100, 108, 108, 101, 120, 112, 111, 114, 116, 32];

        llvm_chars(out, &word, 10);
    } else if (options.visibility_kind == 1) {
        i64 word[7] = [104, 105, 100, 100, 101, 110, 32];

        llvm_chars(out, &word, 7);
    }
}

fn llvm_emit_function_header(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    LlvmTargetOptions& options,
    i64 function_index,
    bool declaration,
) {
    if (declaration) {
        i64 word[7] = [100, 101, 99, 108, 97, 114, 101];

        llvm_chars(out, &word, 7);
    } else {
        i64 word[6] = [100, 101, 102, 105, 110, 101];

        llvm_chars(out, &word, 6);
    }
    writer_space(out);
    llvm_emit_symbol_prefix(out, source, hir, options, function_index, declaration, false);

    i64 abi_kind = raz_compiler_rt_arena_get(hir.function_abi_kinds, function_index);

    if (abi_kind == 1) {
        i64 ccc[3] = [99, 99, 99];

        llvm_chars(out, &ccc, 3);
        writer_space(out);
    }
    llvm_function_return_type(out, hir, function_index);
    writer_space(out);
    llvm_function_name(out, source, hir, function_index);
    writer_put(out, 40);

    i64 parameter = 0;
    i64 count = raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index);

    while (parameter < count) {
        if (parameter > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        llvm_parameter_type(out, hir, function_index, parameter);
        if (!declaration) {
            writer_space(out);
            llvm_parameter(out, parameter);
        }
        parameter += 1;
    }
    writer_put(out, 41);

    i64 feature_length = raz_compiler_rt_arena_get(hir.function_target_feature_lengths, function_index);

    if (feature_length > 0) {
        i64 prefix[20] = [32, 34, 116, 97, 114, 103, 101, 116, 45, 102, 101, 97, 116, 117, 114, 101, 115, 34, 61, 34];

        llvm_chars(out, &prefix, 20);

        i64 feature_offset = raz_compiler_rt_arena_get(hir.function_target_feature_offsets, function_index);

        writer_text(out, source, feature_offset, feature_length);
        writer_put(out, 34);
    }
}

fn llvm_edge_source_block(MirModule& mir, i64 function_start, i64 edge_instruction) -> i64 {
    i64 cursor = function_start;
    i64 block = -1;

    while (cursor < edge_instruction) {
        if (raz_compiler_rt_arena_get(mir.opcodes, cursor) == 24) {
            block = cursor;
        }
        cursor += 1;
    }
    return block;
}

fn llvm_block_argument_type(MirModule& mir, i64 function_start, i64 function_end, i64 block) -> i64 {
    i64 cursor = function_start;

    while (cursor < function_end) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, cursor);

        if (
            opcode == 22 &&
            raz_compiler_rt_arena_get(mir.op_b, cursor) == block &&
            raz_compiler_rt_arena_get(mir.op_c, cursor) >= 0
        ) {
            return llvm_value_result_type(mir, raz_compiler_rt_arena_get(mir.op_c, cursor));
        }
        if (
            opcode == 23 &&
            (
                raz_compiler_rt_arena_get(mir.op_b, cursor) == block ||
                raz_compiler_rt_arena_get(mir.op_c, cursor) == block
            ) &&
            raz_compiler_rt_arena_get(mir.op_d, cursor) >= 0
        ) {
            return llvm_value_result_type(mir, raz_compiler_rt_arena_get(mir.op_d, cursor));
        }
        cursor += 1;
    }
    return 0;
}

fn llvm_emit_predecessor(ForgeWriter&mut out, i64 block) {
    writer_put(out, 37);
    if (block < 0) {
        i64 entry[5] = [101, 110, 116, 114, 121];

        llvm_chars(out, &entry, 5);
    } else {
        llvm_block(out, block);
    }
}

fn llvm_emit_block_phi(
    ForgeWriter&mut out,
    MirModule& mir,
    i64 function_start,
    i64 function_end,
    i64 block,
) -> bool {
    i64 type_kind = llvm_block_argument_type(mir, function_start, function_end, block);

    writer_space(out);
    writer_space(out);
    llvm_value(out, block);
    writer_space(out);
    writer_put(out, 61);
    writer_space(out);

    i64 phi[3] = [112, 104, 105];

    llvm_chars(out, &phi, 3);
    writer_space(out);
    llvm_type(out, type_kind);
    writer_space(out);

    i64 cursor = function_start;
    i64 incoming_count = 0;

    while (cursor < function_end) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, cursor);
        i64 value = -1;
        bool matches = false;

        if (opcode == 22 && raz_compiler_rt_arena_get(mir.op_b, cursor) == block) {
            value = raz_compiler_rt_arena_get(mir.op_c, cursor);
            matches = value >= 0;
        } else if (
            opcode == 23 &&
            (
                raz_compiler_rt_arena_get(mir.op_b, cursor) == block ||
                raz_compiler_rt_arena_get(mir.op_c, cursor) == block
            )
        ) {
            value = raz_compiler_rt_arena_get(mir.op_d, cursor);
            matches = value >= 0;
        }
        if (matches) {
            if (incoming_count > 0) {
                writer_put(out, 44);
                writer_space(out);
            }
            writer_put(out, 91);
            writer_space(out);
            llvm_value(out, value);
            writer_put(out, 44);
            writer_space(out);
            llvm_emit_predecessor(out, llvm_edge_source_block(mir, function_start, cursor));
            writer_space(out);
            writer_put(out, 93);
            incoming_count += 1;
        }
        cursor += 1;
    }
    writer_newline(out);
    return incoming_count > 0;
}

fn llvm_hir_local_index(HirModule& hir, i64 function_index, i64 local_slot) -> i64 {
    if (function_index < 0 || function_index >= hir.function_count || local_slot < 0) {
        return -1;
    }

    i64 declared_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);

    if (local_slot >= declared_count) {
        return -1;
    }

    i64 cursor = raz_compiler_rt_arena_get(hir.function_local_starts, function_index);

    while (cursor < hir.local_count) {
        if (
            raz_compiler_rt_arena_get(hir.local_function_indices, cursor) == function_index &&
            raz_compiler_rt_arena_get(hir.local_slots, cursor) == local_slot
        ) {
            return cursor;
        }
        cursor += 1;
    }
    return -1;
}

fn llvm_local_is_reference(HirModule& hir, i64 function_index, i64 local_slot) -> bool {
    i64 declared_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);

    if (local_slot >= 0 && local_slot < declared_count) {
        i64 local_index = llvm_hir_local_index(hir, function_index, local_slot);

        return local_index >= 0 && raz_compiler_rt_arena_get(hir.local_references, local_index) != 0;
    }

    i64 parameter = local_slot - declared_count;
    i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);

    if (parameter >= 0 && parameter < parameter_count) {
        i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);

        return raz_compiler_rt_arena_get(hir.parameter_references, parameter_start + parameter) != 0;
    }
    return false;
}

fn llvm_emit_local_store_word(ForgeWriter&mut out, i64 slot, i64 value) {
    writer_space(out);
    writer_space(out);

    i64 storeword[10] = [115, 116, 111, 114, 101, 32, 105, 54, 52, 32];

    llvm_chars(out, &storeword, 10);
    llvm_value(out, value);
    writer_put(out, 44);
    writer_space(out);

    i64 ptrword[4] = [112, 116, 114, 32];

    llvm_chars(out, &ptrword, 4);
    llvm_local(out, slot);
    writer_newline(out);
}

fn llvm_emit_local_store(ForgeWriter&mut out, i64 instruction, i64 slot, i64 value, i64 type_kind) {
    i64 raw = llvm_emit_value_to_raw(out, instruction, value, type_kind);

    writer_space(out);
    writer_space(out);

    i64 storeword[5] = [115, 116, 111, 114, 101];

    llvm_chars(out, &storeword, 5);
    writer_space(out);
    writer_i64(out);
    writer_space(out);
    if (raw >= 0) {
        llvm_value(out, raw);
    } else if (raw == -21) {
        llvm_temp(out, 21, instruction);
    } else {
        llvm_temp(out, 20, instruction);
    }
    writer_put(out, 44);
    writer_space(out);

    i64 ptrword[3] = [112, 116, 114];

    llvm_chars(out, &ptrword, 3);
    writer_space(out);
    llvm_local(out, slot);
    writer_newline(out);
}

// LLVM async lowering uses the same runtime frame ABI as Forge.  The source
// async function is a launcher returning an i64 future handle; execution lives
// in a generated poll function that resumes from explicit frame states.
fn llvm_async_label(ForgeWriter&mut out, i64 state, i64 kind) {
    i64 prefix[6] = [97, 115, 121, 110, 99, 46];

    llvm_chars(out, &prefix, 6);
    if (kind == 0) {
        i64 word[4] = [114, 117, 110, 46];

        llvm_chars(out, &word, 4);
    } else if (kind == 1) {
        i64 word[7] = [114, 101, 115, 117, 109, 101, 46];

        llvm_chars(out, &word, 7);
    } else if (kind == 2) {
        i64 word[5] = [99, 111, 110, 116, 46];

        llvm_chars(out, &word, 5);
    } else if (kind == 3) {
        i64 word[8] = [112, 101, 110, 100, 105, 110, 103, 46];

        llvm_chars(out, &word, 8);
    } else if (kind == 4) {
        i64 word[7] = [99, 104, 101, 99, 107, 46, 0];
        i64 i = 0;

        while (i < 6) {
            writer_put(out, word[i]);
            i += 1;
        }
    }
    writer_decimal(out, state);
}

fn llvm_async_temp(ForgeWriter&mut out, i64 category, i64 instruction) {
    writer_put(out, 37);
    writer_put(out, 97);
    writer_decimal(out, category);
    writer_put(out, 95);
    writer_decimal(out, instruction);
}

fn llvm_async_mir_supported(HirModule& hir, MirModule& mir, i64 function_index) -> bool {
    if (!async_mir_supported(hir, mir, function_index)) {
        return false;
    }
    // Pass 7 preserves owned structured locals with runtime-armed cleanup
    // thunks and lowers block arguments through async-frame merge slots. That
    // makes both ownership and CFG merges suspension-safe without LLVM-only
    // semantics leaking into MIR.
    return true;
}

fn llvm_async_emit_slot_load(ForgeWriter&mut out, i64 result, i64 slot) {
    llvm_emit_assignment(out, result);

    i64 prefix[37] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 108, 111, 116, 95, 108, 111, 97, 100, 40, 112, 116, 114, 32];

    llvm_chars(out, &prefix, 37);

    i64 frame[6] = [37, 102, 114, 97, 109, 101];

    llvm_chars(out, &frame, 6);

    i64 middle[6] = [44, 32, 105, 54, 52, 32];

    llvm_chars(out, &middle, 6);
    writer_decimal(out, slot);
    writer_put(out, 41);
    writer_newline(out);
}

fn llvm_async_emit_slot_store(ForgeWriter&mut out, i64 slot, i64 value) {
    i64 prefix[43] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 108, 111, 116, 95, 115, 116, 111, 114, 101, 40, 112, 116, 114, 32, 37, 102];

    llvm_chars(out, &prefix, 43);

    i64 rest[4] = [114, 97, 109, 101];

    llvm_chars(out, &rest, 4);

    i64 middle[6] = [44, 32, 105, 54, 52, 32];

    llvm_chars(out, &middle, 6);
    writer_decimal(out, slot);
    llvm_chars(out, &middle, 6);
    llvm_value(out, value);
    writer_put(out, 41);
    writer_newline(out);
}

fn llvm_async_block_argument_count(MirModule& mir, i64 function_index) -> i64 {
    i64 ip = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = ip + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 count = 0;

    while (ip < end) {
        if (
            raz_compiler_rt_arena_get(mir.opcodes, ip) == 24 &&
            raz_compiler_rt_arena_get(mir.op_a, ip) != 0
        ) {
            count += 1;
        }
        ip += 1;
    }
    return count;
}

fn llvm_async_block_argument_ordinal(MirModule& mir, i64 function_index, i64 block) -> i64 {
    i64 ip = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = ip + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 ordinal = 0;

    while (ip < end) {
        if (
            raz_compiler_rt_arena_get(mir.opcodes, ip) == 24 &&
            raz_compiler_rt_arena_get(mir.op_a, ip) != 0
        ) {
            if (ip == block) {
                return ordinal;
            }
            ordinal += 1;
        }
        ip += 1;
    }
    return -1;
}

fn llvm_async_cleanup_name(ForgeWriter&mut out, Source& source, HirModule& hir, i64 structure) {
    i64 prefix[20] = [64, 95, 95, 114, 97, 122, 95, 97, 115, 121, 110, 99, 95, 99, 108, 101, 97, 110, 117, 112];

    llvm_chars(out, &prefix, 20);
    writer_put(out, 95);
    writer_structure_name(out, source, hir, structure);
}

fn llvm_async_emit_slot_disarm(ForgeWriter&mut out, i64 slot) {
    i64 pre[46] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 108, 111, 116, 95, 100, 105, 115, 97, 114, 109, 40, 112, 116, 114, 32, 37, 102, 114, 97];

    llvm_chars(out, &pre, 46);

    i64 tail[12] = [109, 101, 44, 32, 105, 54, 52, 32, 0, 0, 0, 0];

    llvm_chars(out, &tail, 8);
    writer_decimal(out, slot);
    writer_put(out, 41);
    writer_newline(out);
}

fn llvm_async_emit_slot_store_owned(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    i64 structure,
    i64 slot,
    i64 value,
    i64 instruction,
) {
    llvm_async_emit_slot_disarm(out, slot);
    writer_space(out);
    writer_space(out);
    llvm_async_temp(out, 90, instruction);
    writer_space(out);
    writer_put(out, 61);
    writer_space(out);

    i64 ptoi[13] = [112, 116, 114, 116, 111, 105, 110, 116, 32, 112, 116, 114, 32];

    llvm_chars(out, &ptoi, 13);
    llvm_async_cleanup_name(out, source, hir, structure);

    i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

    llvm_chars(out, &toi64, 7);
    writer_newline(out);

    i64 pre[52] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 108, 111, 116, 95, 115, 116, 111, 114, 101, 95, 111, 119, 110, 101, 100, 40, 112, 116, 114, 32, 37, 102, 114, 97, 109];

    llvm_chars(out, &pre, 52);

    i64 mid[6] = [101, 44, 32, 105, 54, 52];

    llvm_chars(out, &mid, 6);
    writer_space(out);
    writer_decimal(out, slot);

    i64 mid2[6] = [44, 32, 105, 54, 52, 32];

    llvm_chars(out, &mid2, 6);
    llvm_value(out, value);
    llvm_chars(out, &mid2, 6);
    llvm_async_temp(out, 90, instruction);
    writer_put(out, 41);
    writer_newline(out);
}

fn llvm_async_disarm_owned_locals(ForgeWriter&mut out, HirModule& hir, i64 function_index) {
    i64 local_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);
    i64 local = 0;

    while (local < local_count) {
        i64 local_index = llvm_hir_local_index(hir, function_index, local);
        i64 structure = -1;

        if (local_index >= 0) {
            structure = raz_compiler_rt_arena_get(hir.local_type_structs, local_index);
        }
        if (structure >= 0 && hir_structure_needs_drop(hir, structure, 0)) {
            llvm_async_emit_slot_disarm(out, local);
        }
        local += 1;
    }
}

fn llvm_emit_async_structure_cleanup_function(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    i64 structure,
) -> bool {
    if (structure < 0 || !hir_structure_needs_drop(hir, structure, 0)) {
        return true;
    }

    i64 def[12] = [100, 101, 102, 105, 110, 101, 32, 118, 111, 105, 100, 32];

    llvm_chars(out, &def, 12);
    llvm_async_cleanup_name(out, source, hir, structure);

    i64 arg[13] = [40, 105, 54, 52, 32, 37, 118, 97, 108, 117, 101, 41, 32];

    llvm_chars(out, &arg, 13);
    writer_put(out, 123);
    writer_newline(out);

    i64 entry[7] = [101, 110, 116, 114, 121, 58, 10];

    llvm_chars(out, &entry, 7);

    i64 drop_function = raz_compiler_rt_arena_get(hir.struct_drop_functions, structure);

    if (drop_function >= 0) {
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 91, structure);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 call[9] = [99, 97, 108, 108, 32, 105, 54, 52, 32];

        llvm_chars(out, &call, 9);
        llvm_function_name(out, source, hir, drop_function);

        i64 open[5] = [40, 105, 54, 52, 32];

        llvm_chars(out, &open, 5);
        writer_put(out, 37);

        i64 value[5] = [118, 97, 108, 117, 101];

        llvm_chars(out, &value, 5);
        writer_put(out, 41);
        writer_newline(out);
    }

    i64 field_start = raz_compiler_rt_arena_get(hir.struct_field_starts, structure);
    i64 field_count = raz_compiler_rt_arena_get(hir.struct_field_counts, structure);
    i64 field = field_count;

    while (field > 0) {
        field -= 1;

        i64 metadata = field_start + field;
        i64 child = raz_compiler_rt_arena_get(hir.struct_field_type_structs, metadata);

        if (
            child >= 0 &&
            raz_compiler_rt_arena_get(hir.struct_field_references, metadata) == 0 &&
            hir_structure_needs_drop(hir, child, 0)
        ) {
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 92, structure * 256 + field);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 get[38] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 103, 101, 116, 40, 105, 54, 52, 32];

            llvm_chars(out, &get, 38);
            writer_put(out, 37);

            i64 value[5] = [118, 97, 108, 117, 101];

            llvm_chars(out, &value, 5);

            i64 comma[6] = [44, 32, 105, 54, 52, 32];

            llvm_chars(out, &comma, 6);
            writer_decimal(out, field);
            writer_put(out, 41);
            writer_newline(out);
            writer_space(out);
            writer_space(out);

            i64 callv[10] = [99, 97, 108, 108, 32, 118, 111, 105, 100, 32];

            llvm_chars(out, &callv, 10);
            llvm_async_cleanup_name(out, source, hir, child);

            i64 open2[5] = [40, 105, 54, 52, 32];

            llvm_chars(out, &open2, 5);
            llvm_async_temp(out, 92, structure * 256 + field);
            writer_put(out, 41);
            writer_newline(out);
        }
    }

    i64 destroy[45] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 100, 101, 115, 116, 114, 111, 121, 40, 105, 54, 52, 32];

    llvm_chars(out, &destroy, 45);
    writer_put(out, 37);

    i64 value2[5] = [118, 97, 108, 117, 101];

    llvm_chars(out, &value2, 5);
    writer_put(out, 41);
    writer_newline(out);

    i64 ret[10] = [32, 32, 114, 101, 116, 32, 118, 111, 105, 100];

    llvm_chars(out, &ret, 10);
    writer_newline(out);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    return !out.failed;
}

fn llvm_async_emit_state_store(ForgeWriter&mut out, i64 state) {
    i64 prefix[47] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 116, 97, 116, 101, 95, 115, 116, 111, 114, 101, 40, 112, 116, 114, 32, 37, 102, 114, 97, 109];

    llvm_chars(out, &prefix, 47);

    i64 tail[10] = [101, 44, 32, 105, 51, 50, 32, 0, 0, 0];

    writer_put(out, tail[0]);
    writer_put(out, tail[1]);
    writer_put(out, tail[2]);
    writer_put(out, tail[3]);
    writer_put(out, tail[4]);
    writer_put(out, tail[5]);
    writer_put(out, tail[6]);
    writer_decimal(out, state);
    writer_put(out, 41);
    writer_newline(out);
}

fn llvm_emit_async_scalar_instruction(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 ip,
) -> bool {
    i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);
    i64 type_kind = raz_compiler_rt_arena_get(mir.op_types, ip);
    i64 local_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);

    if (opcode == 1) {
        llvm_emit_assignment(out, ip);
        if (primitive_type_is_float(type_kind)) {
            i64 fadd[5] = [102, 97, 100, 100, 32];

            llvm_chars(out, &fadd, 5);
            llvm_type(out, type_kind);
            writer_space(out);
            if (raz_compiler_rt_arena_get(mir.op_b, ip) > 0) {
                writer_text(
                    out,
                    source,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                    raz_compiler_rt_arena_get(mir.op_b, ip),
                );
            } else {
                writer_put(out, 48);
                writer_put(out, 46);
                writer_put(out, 48);
            }
            writer_put(out, 44);
            writer_space(out);
            writer_put(out, 48);
            writer_put(out, 46);
            writer_put(out, 48);
        } else {
            i64 add[4] = [97, 100, 100, 32];

            llvm_chars(out, &add, 4);
            llvm_type(out, type_kind);
            writer_space(out);
            writer_decimal(out, 0);
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        }
        writer_newline(out);
        return true;
    }
    if (opcode == 2) {
        llvm_async_emit_slot_load(out, ip, local_count + raz_compiler_rt_arena_get(mir.op_a, ip));
        return true;
    }
    if (opcode == 3) {
        llvm_async_emit_slot_load(out, ip, raz_compiler_rt_arena_get(mir.op_a, ip));
        return true;
    }
    if ((opcode >= 4 && opcode <= 7) || (opcode >= 34 && opcode <= 39)) {
        llvm_emit_assignment(out, ip);
        if (!llvm_emit_binary_opcode(out, opcode, type_kind)) {
            return false;
        }
        writer_space(out);
        llvm_type(out, type_kind);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        return true;
    }
    if (opcode >= 11 && opcode <= 16) {
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 30, ip);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);
        if (primitive_type_is_float(type_kind)) {
            i64 cmp[5] = [102, 99, 109, 112, 32];

            llvm_chars(out, &cmp, 5);
        } else {
            i64 cmp[5] = [105, 99, 109, 112, 32];

            llvm_chars(out, &cmp, 5);
        }
        if (!llvm_emit_compare_predicate(out, opcode, type_kind)) {
            return false;
        }
        writer_space(out);
        llvm_type(out, type_kind);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        llvm_emit_assignment(out, ip);

        i64 zext[8] = [122, 101, 120, 116, 32, 105, 49, 32];

        llvm_chars(out, &zext, 8);
        llvm_async_temp(out, 30, ip);

        i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

        llvm_chars(out, &toi64, 7);
        writer_newline(out);
        return true;
    }
    if (opcode == 17) {
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 31, ip);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 cmp[8] = [105, 99, 109, 112, 32, 110, 101, 32];

        llvm_chars(out, &cmp, 8);
        writer_i64(out);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_decimal(out, 0);
        writer_newline(out);
        llvm_emit_assignment(out, ip);

        i64 sel[7] = [115, 101, 108, 101, 99, 116, 32];

        llvm_chars(out, &sel, 7);
        writer_put(out, 105);
        writer_put(out, 49);
        writer_space(out);
        llvm_async_temp(out, 31, ip);
        writer_put(out, 44);
        writer_space(out);
        llvm_type(out, type_kind);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_put(out, 44);
        writer_space(out);
        llvm_type(out, type_kind);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_c, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 18) {
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 32, ip);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 cmp[8] = [105, 99, 109, 112, 32, 101, 113, 32];

        llvm_chars(out, &cmp, 8);
        writer_i64(out);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_decimal(out, 0);
        writer_newline(out);
        llvm_emit_assignment(out, ip);

        i64 zext[8] = [122, 101, 120, 116, 32, 105, 49, 32];

        llvm_chars(out, &zext, 8);
        llvm_async_temp(out, 32, ip);

        i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

        llvm_chars(out, &toi64, 7);
        writer_newline(out);
        return true;
    }
    if (opcode == 19 || opcode == 20) {
        llvm_emit_assignment(out, ip);
        if (opcode == 19) {
            i64 w[3] = [97, 110, 100];

            llvm_chars(out, &w, 3);
        } else {
            i64 w[2] = [111, 114];

            llvm_chars(out, &w, 2);
        }
        writer_space(out);
        writer_i64(out);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 8) {
        i64 target = raz_compiler_rt_arena_get(mir.op_a, ip);

        if (raz_compiler_rt_arena_get(hir.function_returns_value, target) != 0) {
            llvm_emit_assignment(out, ip);
        } else {
            writer_space(out);
            writer_space(out);
        }

        i64 call[5] = [99, 97, 108, 108, 32];

        llvm_chars(out, &call, 5);
        llvm_function_return_type(out, hir, target);
        writer_space(out);
        llvm_function_name(out, source, hir, target);
        writer_put(out, 40);

        i64 first = raz_compiler_rt_arena_get(mir.op_b, ip);
        i64 count = raz_compiler_rt_arena_get(mir.op_c, ip);
        i64 a = 0;

        while (a < count) {
            if (a > 0) {
                writer_put(out, 44);
                writer_space(out);
            }
            llvm_parameter_type(out, hir, target, a);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.call_arguments, first + a));
            a += 1;
        }
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 44) {
        i64 signature = raz_compiler_rt_arena_get(mir.op_d, ip);

        llvm_emit_assignment(out, ip);

        i64 call[5] = [99, 97, 108, 108, 32];

        llvm_chars(out, &call, 5);
        llvm_function_type_return_type(out, hir, signature);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 40);

        i64 first = raz_compiler_rt_arena_get(mir.op_b, ip);
        i64 count = raz_compiler_rt_arena_get(mir.op_c, ip);
        i64 a = 0;

        while (a < count) {
            if (a > 0) {
                writer_put(out, 44);
                writer_space(out);
            }
            llvm_function_type_parameter_type(out, hir, signature, a);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.call_arguments, first + a));
            a += 1;
        }
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 47) {
        llvm_emit_assignment(out, ip);

        i64 loadword[5] = [108, 111, 97, 100, 32];

        llvm_chars(out, &loadword, 5);
        llvm_type(out, type_kind);
        writer_put(out, 44);
        writer_space(out);

        i64 ptrword[4] = [112, 116, 114, 32];

        llvm_chars(out, &ptrword, 4);
        llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 48) {
        writer_space(out);
        writer_space(out);

        i64 storeword[6] = [115, 116, 111, 114, 101, 32];

        llvm_chars(out, &storeword, 6);
        llvm_type(out, type_kind);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_put(out, 44);
        writer_space(out);

        i64 ptrword[4] = [112, 116, 114, 32];

        llvm_chars(out, &ptrword, 4);
        llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_newline(out);
        return true;
    }
    if (opcode == 49) {
        // Raz references use a machine-word ABI. Preserve the address of the
        // module object itself rather than loading its current scalar value.
        llvm_emit_assignment(out, ip);

        i64 ptrtoint[8] = [112, 116, 114, 116, 111, 105, 110, 116];

        llvm_chars(out, &ptrtoint, 8);
        writer_space(out);

        i64 ptrword[4] = [112, 116, 114, 32];

        llvm_chars(out, &ptrword, 4);
        llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));

        i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

        llvm_chars(out, &toi64, 7);
        writer_newline(out);
        return true;
    }
    if (opcode == 46) {
        llvm_emit_assignment(out, ip);

        i64 add[8] = [97, 100, 100, 32, 105, 54, 52, 32];

        llvm_chars(out, &add, 8);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_decimal(out, 0);
        writer_newline(out);
        return true;
    }
    if (opcode == 9) {
        i64 local_slot = raz_compiler_rt_arena_get(mir.op_a, ip);
        i64 structure = -1;

        if (
            local_slot >= 0 &&
            local_slot < raz_compiler_rt_arena_get(hir.function_local_counts, function_index)
        ) {
            i64 local_index = llvm_hir_local_index(hir, function_index, local_slot);

            if (local_index >= 0) {
                structure = raz_compiler_rt_arena_get(hir.local_type_structs, local_index);
            }
        }
        if (structure >= 0 && hir_structure_needs_drop(hir, structure, 0)) {
            llvm_async_emit_slot_store_owned(
                out,
                source,
                hir,
                structure,
                local_slot,
                raz_compiler_rt_arena_get(mir.op_b, ip),
                ip,
            );
        } else {
            llvm_async_emit_slot_store(out, local_slot, raz_compiler_rt_arena_get(mir.op_b, ip));
        }
        llvm_emit_assignment(out, ip);

        i64 add[8] = [97, 100, 100, 32, 105, 54, 52, 32];

        llvm_chars(out, &add, 8);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_decimal(out, 0);
        writer_newline(out);
        return true;
    }
    if (opcode == 28) {
        llvm_emit_assignment(out, ip);

        i64 pre[38] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 103, 101, 116, 40, 105, 54, 52, 32];

        llvm_chars(out, &pre, 38);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

        i64 mid[6] = [44, 32, 105, 54, 52, 32];

        llvm_chars(out, &mid, 6);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 29) {
        i64 pre[39] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 115, 101, 116, 40, 105, 54];

        llvm_chars(out, &pre, 39);
        writer_put(out, 52);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

        i64 mid[6] = [44, 32, 105, 54, 52, 32];

        llvm_chars(out, &mid, 6);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        llvm_chars(out, &mid, 6);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_c, ip));
        writer_put(out, 41);
        writer_newline(out);
        llvm_emit_assignment(out, ip);

        i64 add[8] = [97, 100, 100, 32, 105, 54, 52, 32];

        llvm_chars(out, &add, 8);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_c, ip));
        writer_put(out, 44);
        writer_space(out);
        writer_decimal(out, 0);
        writer_newline(out);
        return true;
    }
    if (opcode == 30) {
        llvm_emit_assignment(out, ip);

        i64 pre[41] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 99, 114, 101, 97, 116, 101, 40, 105, 54, 52, 32];

        llvm_chars(out, &pre, 41);
        writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 31) {
        i64 storage = raz_compiler_rt_arena_get(mir.op_a, ip);

        if (
            storage >= 0 &&
            storage < mir.instruction_count &&
            raz_compiler_rt_arena_get(mir.opcodes, storage) == 3
        ) {
            i64 slot = raz_compiler_rt_arena_get(mir.op_a, storage);

            if (slot >= 0 && slot < raz_compiler_rt_arena_get(hir.function_local_counts, function_index)) {
                i64 local_index = llvm_hir_local_index(hir, function_index, slot);
                i64 structure = -1;

                if (local_index >= 0) {
                    structure = raz_compiler_rt_arena_get(hir.local_type_structs, local_index);
                }
                if (structure >= 0 && hir_structure_needs_drop(hir, structure, 0)) {
                    llvm_async_emit_slot_disarm(out, slot);
                }
            }
        }

        i64 pre[43] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 100, 101, 115, 116, 114, 111, 121, 40, 105, 54];

        llvm_chars(out, &pre, 43);
        writer_put(out, 52);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        writer_put(out, 41);
        writer_newline(out);
        return true;
    }
    if (opcode == 32 || opcode == 33) {
        return true;
    }
    if (opcode == 40) {
        return llvm_emit_numeric_cast(
            out,
            ip,
            raz_compiler_rt_arena_get(mir.op_a, ip),
            raz_compiler_rt_arena_get(mir.op_b, ip),
            type_kind,
        );
    }
    // Aggregate element references need the same machine-word alias path as the
    // synchronous backend. The arena handle is the payload address.
    if (opcode == 45) {
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 53, ip);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 inttoptr[9] = [105, 110, 116, 116, 111, 112, 116, 114, 32];

        llvm_chars(out, &inttoptr, 9);
        writer_i64(out);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

        i64 toptr[7] = [32, 116, 111, 32, 112, 116, 114];

        llvm_chars(out, &toptr, 7);
        writer_newline(out);
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 54, ip);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 gep[14] = [103, 101, 116, 101, 108, 101, 109, 101, 110, 116, 112, 116, 114, 32];

        llvm_chars(out, &gep, 14);
        writer_i64(out);
        writer_put(out, 44);
        writer_space(out);

        i64 ptrsp[4] = [112, 116, 114, 32];

        llvm_chars(out, &ptrsp, 4);
        llvm_async_temp(out, 53, ip);
        writer_put(out, 44);
        writer_space(out);
        writer_i64(out);
        writer_space(out);
        llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
        writer_newline(out);
        llvm_emit_assignment(out, ip);

        i64 ptoi[9] = [112, 116, 114, 116, 111, 105, 110, 116, 32];

        llvm_chars(out, &ptoi, 9);

        i64 ptrsp2[4] = [112, 116, 114, 32];

        llvm_chars(out, &ptrsp2, 4);
        llvm_async_temp(out, 54, ip);

        i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

        llvm_chars(out, &toi64, 7);
        writer_newline(out);
        return true;
    }
    return false;
}

fn llvm_emit_async_function(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    LlvmTargetOptions& options,
    i64 function_index,
) -> bool {
    if (!llvm_async_mir_supported(hir, mir, function_index)) {
        return false;
    }

    i64 await_count = async_mir_await_count(hir, mir, function_index);
    i64 block_argument_count = llvm_async_block_argument_count(mir, function_index);
    i64 local_count = raz_compiler_rt_arena_get(hir.function_local_counts, function_index);
    i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);
    i64 completed_state = await_count + 1;
    i64 cancelled_state = await_count + 2;

    // Public launcher: create frame, expose its completion future, run initial poll.

    i64 define_word[7] = [100, 101, 102, 105, 110, 101, 32];

    llvm_chars(out, &define_word, 7);
    llvm_emit_symbol_prefix(out, source, hir, options, function_index, false, false);
    writer_i64(out);
    writer_space(out);
    llvm_function_name(out, source, hir, function_index);
    writer_put(out, 40);

    i64 p = 0;

    while (p < parameter_count) {
        if (p > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        writer_i64(out);
        writer_space(out);
        llvm_parameter(out, p);
        p += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);

    i64 entry[7] = [101, 110, 116, 114, 121, 58, 10];

    llvm_chars(out, &entry, 7);

    i64 fpre[16] = [32, 32, 37, 102, 114, 97, 109, 101, 32, 61, 32, 99, 97, 108, 108, 32];

    llvm_chars(out, &fpre, 16);
    writer_put(out, 112);
    writer_put(out, 116);
    writer_put(out, 114);
    writer_space(out);
    writer_async_function_name(out, source, hir, function_index, 1);
    writer_put(out, 40);
    p = 0;
    while (p < parameter_count) {
        if (p > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        writer_i64(out);
        writer_space(out);
        llvm_parameter(out, p);
        p += 1;
    }
    writer_put(out, 41);
    writer_newline(out);

    i64 futurepre[34] = [32, 32, 37, 102, 117, 116, 117, 114, 101, 32, 61, 32, 99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99];

    llvm_chars(out, &futurepre, 34);

    i64 futtail[24] = [95, 102, 114, 97, 109, 101, 95, 102, 117, 116, 117, 114, 101, 95, 105, 54, 52, 40, 112, 116, 114, 32, 37, 102];

    llvm_chars(out, &futtail, 24);

    i64 frametail[5] = [114, 97, 109, 101, 41];

    llvm_chars(out, &frametail, 5);
    writer_newline(out);

    i64 pollpre[17] = [32, 32, 37, 105, 110, 105, 116, 32, 61, 32, 99, 97, 108, 108, 32, 105, 51];

    llvm_chars(out, &pollpre, 17);
    writer_put(out, 50);
    writer_space(out);
    writer_async_function_name(out, source, hir, function_index, 2);

    i64 framearg[11] = [40, 112, 116, 114, 32, 37, 102, 114, 97, 109, 101];

    llvm_chars(out, &framearg, 11);
    writer_put(out, 41);
    writer_newline(out);

    i64 destroy[52] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 102, 114, 97, 109, 101, 95, 100, 101, 115, 116, 114, 111, 121, 40, 112, 116, 114, 32, 37, 102, 114, 97, 109, 101, 41, 10];

    llvm_chars(out, &destroy, 52);

    i64 retfuture[18] = [32, 32, 114, 101, 116, 32, 105, 54, 52, 32, 37, 102, 117, 116, 117, 114, 101, 10];

    llvm_chars(out, &retfuture, 18);
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    // Constructor.
    llvm_chars(out, &define_word, 7);
    llvm_emit_symbol_prefix(out, source, hir, options, function_index, false, true);

    i64 ptr_word[4] = [112, 116, 114, 32];

    llvm_chars(out, &ptr_word, 4);
    writer_async_function_name(out, source, hir, function_index, 1);
    writer_put(out, 40);
    p = 0;
    while (p < parameter_count) {
        if (p > 0) {
            writer_put(out, 44);
            writer_space(out);
        }
        writer_i64(out);
        writer_space(out);
        llvm_parameter(out, p);
        p += 1;
    }
    writer_put(out, 41);
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);
    llvm_chars(out, &entry, 7);

    i64 newpre[56] = [32, 32, 37, 102, 114, 97, 109, 101, 32, 61, 32, 99, 97, 108, 108, 32, 112, 116, 114, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 102, 114, 97, 109, 101, 95, 99, 114, 101, 97, 116, 101, 40, 105, 54, 52, 32, 0, 0, 0, 0, 0];

    llvm_chars(out, &newpre, 52);
    writer_decimal(out, local_count + parameter_count + await_count + block_argument_count);
    writer_put(out, 41);
    writer_newline(out);
    llvm_async_emit_state_store(out, 0);

    i64 setpoll[47] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 102, 114, 97, 109, 101, 95, 115, 101, 116, 95, 112, 111, 108, 108, 101, 114, 40, 112, 116, 114, 32];

    llvm_chars(out, &setpoll, 47);

    i64 fr[6] = [37, 102, 114, 97, 109, 101];

    llvm_chars(out, &fr, 6);

    i64 comma_ptr[6] = [44, 32, 112, 116, 114, 32];

    llvm_chars(out, &comma_ptr, 6);
    writer_async_function_name(out, source, hir, function_index, 2);
    writer_put(out, 41);
    writer_newline(out);
    // Constructor parameters are spilled directly into frame slots.
    p = 0;
    while (p < parameter_count) {
        i64 sp[43] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 108, 111, 116, 95, 115, 116, 111, 114, 101, 40, 112, 116, 114, 32, 37, 102];

        llvm_chars(out, &sp, 43);

        i64 frest[4] = [114, 97, 109, 101];

        llvm_chars(out, &frest, 4);

        i64 mid[6] = [44, 32, 105, 54, 52, 32];

        llvm_chars(out, &mid, 6);
        writer_decimal(out, local_count + p);
        llvm_chars(out, &mid, 6);
        llvm_parameter(out, p);
        writer_put(out, 41);
        writer_newline(out);
        p += 1;
    }

    i64 retframe[18] = [32, 32, 114, 101, 116, 32, 112, 116, 114, 32, 37, 102, 114, 97, 109, 101, 10, 125];

    llvm_chars(out, &retframe, 18);
    writer_newline(out);
    writer_newline(out);
    // Poll/resume state machine.
    llvm_chars(out, &define_word, 7);
    llvm_emit_symbol_prefix(out, source, hir, options, function_index, false, true);

    i64 i32_word[4] = [105, 51, 50, 32];

    llvm_chars(out, &i32_word, 4);
    writer_async_function_name(out, source, hir, function_index, 2);

    i64 pollargs[13] = [40, 112, 116, 114, 32, 37, 102, 114, 97, 109, 101, 41, 32];

    llvm_chars(out, &pollargs, 13);
    writer_put(out, 123);
    writer_newline(out);
    llvm_chars(out, &entry, 7);

    i64 statecall[49] = [32, 32, 37, 115, 116, 97, 116, 101, 32, 61, 32, 99, 97, 108, 108, 32, 105, 51, 50, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 116, 97, 116, 101, 95, 108, 111, 97, 100, 40, 112, 116, 114, 32];

    llvm_chars(out, &statecall, 49);
    llvm_chars(out, &fr, 6);
    writer_put(out, 41);
    writer_newline(out);

    i64 sw[35] = [32, 32, 115, 119, 105, 116, 99, 104, 32, 105, 51, 50, 32, 37, 115, 116, 97, 116, 101, 44, 32, 108, 97, 98, 101, 108, 32, 37, 97, 115, 121, 110, 99, 46, 105];

    llvm_chars(out, &sw, 35);

    i64 invalid[12] = [110, 118, 97, 108, 105, 100, 32, 91, 10, 32, 32, 32];

    llvm_chars(out, &invalid, 12);

    i64 state = 0;

    while (state <= cancelled_state) {
        i64 item[8] = [105, 51, 50, 32, 0, 0, 0, 0];

        llvm_chars(out, &item, 4);
        writer_decimal(out, state);

        i64 lab[9] = [44, 32, 108, 97, 98, 101, 108, 32, 37];

        llvm_chars(out, &lab, 9);
        if (state <= await_count) {
            llvm_async_label(out, state, 4);
        } else if (state == completed_state) {
            i64 c[15] = [97, 115, 121, 110, 99, 46, 99, 111, 109, 112, 108, 101, 116, 101, 100];

            llvm_chars(out, &c, 15);
        } else {
            i64 c[15] = [97, 115, 121, 110, 99, 46, 99, 97, 110, 99, 101, 108, 108, 101, 100];

            llvm_chars(out, &c, 15);
        }
        writer_newline(out);
        state += 1;
    }

    i64 close[4] = [32, 32, 93, 10];

    llvm_chars(out, &close, 4);
    // State entry checks and resume re-polls.
    state = 0;
    while (state <= await_count) {
        llvm_async_label(out, state, 4);
        writer_put(out, 58);
        writer_newline(out);
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 60, state);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 cancelcall[42] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 99, 97, 110, 99, 101, 108, 95, 114, 101, 113, 117, 101, 115, 116, 101, 100, 40, 112, 116];

        llvm_chars(out, &cancelcall, 42);

        i64 cr[8] = [114, 32, 37, 102, 114, 97, 109, 101];

        llvm_chars(out, &cr, 8);
        writer_put(out, 41);
        writer_newline(out);
        writer_space(out);
        writer_space(out);
        llvm_async_temp(out, 61, state);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 cmpne[12] = [105, 99, 109, 112, 32, 110, 101, 32, 105, 54, 52, 32];

        llvm_chars(out, &cmpne, 12);
        llvm_async_temp(out, 60, state);
        writer_put(out, 44);
        writer_space(out);
        writer_decimal(out, 0);
        writer_newline(out);
        writer_space(out);
        writer_space(out);

        i64 br[6] = [98, 114, 32, 105, 49, 32];

        llvm_chars(out, &br, 6);
        llvm_async_temp(out, 61, state);

        i64 lab[9] = [44, 32, 108, 97, 98, 101, 108, 32, 37];

        llvm_chars(out, &lab, 9);

        i64 cancelled[15] = [97, 115, 121, 110, 99, 46, 99, 97, 110, 99, 101, 108, 108, 101, 100];

        llvm_chars(out, &cancelled, 15);
        llvm_chars(out, &lab, 9);
        if (state == 0) {
            llvm_async_label(out, 0, 0);
        } else {
            llvm_async_label(out, state, 1);
        }
        writer_newline(out);
        if (state > 0) {
            llvm_async_label(out, state, 1);
            writer_put(out, 58);
            writer_newline(out);

            i64 reload = -(local_count + parameter_count + state);

            // marker only for unique temp category
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 62, state);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 slotpre[37] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 115, 108, 111, 116, 95, 108, 111, 97, 100, 40, 112, 116, 114, 32];

            llvm_chars(out, &slotpre, 37);
            llvm_chars(out, &fr, 6);

            i64 mid[6] = [44, 32, 105, 54, 52, 32];

            llvm_chars(out, &mid, 6);
            writer_decimal(out, local_count + parameter_count + state - 1);
            writer_put(out, 41);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 63, state);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 itp[16] = [105, 110, 116, 116, 111, 112, 116, 114, 32, 105, 54, 52, 32, 0, 0, 0];

            llvm_chars(out, &itp, 13);
            llvm_async_temp(out, 62, state);

            i64 toptr[7] = [32, 116, 111, 32, 112, 116, 114];

            llvm_chars(out, &toptr, 7);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 64, state);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 ap[44] = [99, 97, 108, 108, 32, 105, 51, 50, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 97, 119, 97, 105, 116, 95, 112, 111, 108, 108, 40, 112, 116, 114, 32, 37, 102, 114, 97, 109, 101];

            llvm_chars(out, &ap, 44);

            i64 mptr[6] = [44, 32, 112, 116, 114, 32];

            llvm_chars(out, &mptr, 6);
            llvm_async_temp(out, 63, state);

            i64 mi32[6] = [44, 32, 105, 51, 50, 32];

            llvm_chars(out, &mi32, 6);
            writer_decimal(out, state);
            writer_put(out, 41);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 65, state);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 eq[12] = [105, 99, 109, 112, 32, 101, 113, 32, 105, 51, 50, 32];

            llvm_chars(out, &eq, 12);
            llvm_async_temp(out, 64, state);
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 1);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_chars(out, &br, 6);
            llvm_async_temp(out, 65, state);
            llvm_chars(out, &lab, 9);
            llvm_async_label(out, state, 2);
            llvm_chars(out, &lab, 9);
            llvm_async_label(out, state, 3);
            writer_newline(out);
        }
        state += 1;
    }

    i64 comp[16] = [97, 115, 121, 110, 99, 46, 99, 111, 109, 112, 108, 101, 116, 101, 100, 58];

    llvm_chars(out, &comp, 16);
    writer_newline(out);

    i64 ret1[12] = [32, 32, 114, 101, 116, 32, 105, 51, 50, 32, 49, 10];

    llvm_chars(out, &ret1, 12);

    i64 canc[16] = [97, 115, 121, 110, 99, 46, 99, 97, 110, 99, 101, 108, 108, 101, 100, 58];

    llvm_chars(out, &canc, 16);
    writer_newline(out);

    i64 canccall[48] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 102, 114, 97, 109, 101, 95, 99, 97, 110, 99, 101, 108, 40, 112, 116, 114, 32, 37, 102, 114, 97, 109];

    llvm_chars(out, &canccall, 48);

    i64 ect[3] = [101, 41, 10];

    llvm_chars(out, &ect, 3);

    i64 retm1[13] = [32, 32, 114, 101, 116, 32, 105, 51, 50, 32, 45, 49, 10];

    llvm_chars(out, &retm1, 13);

    i64 invlab[14] = [97, 115, 121, 110, 99, 46, 105, 110, 118, 97, 108, 105, 100, 58];

    llvm_chars(out, &invlab, 14);
    writer_newline(out);
    llvm_chars(out, &retm1, 13);
    // Emit MIR segments. Each await terminates the current segment and creates
    // its ready continuation; state dispatch above re-polls before entering it.

    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = start + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 segment = 0;
    i64 ip = start;
    bool open = false;
    bool terminated = false;

    while (ip < end) {
        if (!open) {
            llvm_async_label(out, segment, 0);
            writer_put(out, 58);
            writer_newline(out);
            open = true;
            terminated = false;
        }

        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        if (opcode == 24) {
            if (!terminated) {
                writer_space(out);
                writer_space(out);

                i64 b[9] = [98, 114, 32, 108, 97, 98, 101, 108, 32];

                llvm_chars(out, &b, 9);
                writer_put(out, 37);
                llvm_block(out, ip);
                writer_newline(out);
            }
            llvm_block(out, ip);
            writer_put(out, 58);
            writer_newline(out);
            if (raz_compiler_rt_arena_get(mir.op_a, ip) != 0) {
                i64 ordinal = llvm_async_block_argument_ordinal(mir, function_index, ip);

                if (ordinal < 0) {
                    return false;
                }
                llvm_async_emit_slot_load(out, ip, local_count + parameter_count + await_count + ordinal);
            }
            terminated = false;
        } else if (terminated) {} else if (opcode == 22) {
            i64 target = raz_compiler_rt_arena_get(mir.op_b, ip);

            if (target < 0) {
                return false;
            }
            writer_space(out);
            writer_space(out);

            i64 b[9] = [98, 114, 32, 108, 97, 98, 101, 108, 32];

            llvm_chars(out, &b, 9);
            writer_put(out, 37);
            llvm_block(out, target);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 23) {
            i64 ft = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 tt = raz_compiler_rt_arena_get(mir.op_c, ip);

            if (ft < 0 || tt < 0) {
                return false;
            }

            i64 incoming = raz_compiler_rt_arena_get(mir.op_d, ip);

            if (incoming >= 0) {
                i64 fordinal = llvm_async_block_argument_ordinal(mir, function_index, ft);
                i64 tordinal = llvm_async_block_argument_ordinal(mir, function_index, tt);

                if (fordinal >= 0) {
                    llvm_async_emit_slot_store(
                        out,
                        local_count + parameter_count + await_count + fordinal,
                        incoming,
                    );
                }
                if (tordinal >= 0 && tordinal != fordinal) {
                    llvm_async_emit_slot_store(
                        out,
                        local_count + parameter_count + await_count + tordinal,
                        incoming,
                    );
                }
            }
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 70, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 cmp[12] = [105, 99, 109, 112, 32, 110, 101, 32, 105, 54, 52, 32];

            llvm_chars(out, &cmp, 12);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
            writer_space(out);
            writer_space(out);

            i64 br[6] = [98, 114, 32, 105, 49, 32];

            llvm_chars(out, &br, 6);
            llvm_async_temp(out, 70, ip);

            i64 lab[9] = [44, 32, 108, 97, 98, 101, 108, 32, 37];

            llvm_chars(out, &lab, 9);
            llvm_block(out, tt);
            llvm_chars(out, &lab, 9);
            llvm_block(out, ft);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 41) {
            i64 future = raz_compiler_rt_arena_get(mir.op_a, ip);

            llvm_async_emit_slot_store(out, local_count + parameter_count + segment, future);
            llvm_async_emit_state_store(out, segment + 1);
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 71, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 itp[13] = [105, 110, 116, 116, 111, 112, 116, 114, 32, 105, 54, 52, 32];

            llvm_chars(out, &itp, 13);
            llvm_value(out, future);

            i64 toptr[7] = [32, 116, 111, 32, 112, 116, 114];

            llvm_chars(out, &toptr, 7);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 72, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 ap[44] = [99, 97, 108, 108, 32, 105, 51, 50, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 97, 119, 97, 105, 116, 95, 112, 111, 108, 108, 40, 112, 116, 114, 32, 37, 102, 114, 97, 109, 101];

            llvm_chars(out, &ap, 44);

            i64 mptr[6] = [44, 32, 112, 116, 114, 32];

            llvm_chars(out, &mptr, 6);
            llvm_async_temp(out, 71, ip);

            i64 mi32[6] = [44, 32, 105, 51, 50, 32];

            llvm_chars(out, &mi32, 6);
            writer_decimal(out, segment + 1);
            writer_put(out, 41);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_async_temp(out, 73, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 eq[12] = [105, 99, 109, 112, 32, 101, 113, 32, 105, 51, 50, 32];

            llvm_chars(out, &eq, 12);
            llvm_async_temp(out, 72, ip);
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 1);
            writer_newline(out);
            writer_space(out);
            writer_space(out);

            i64 br[6] = [98, 114, 32, 105, 49, 32];

            llvm_chars(out, &br, 6);
            llvm_async_temp(out, 73, ip);

            i64 lab[9] = [44, 32, 108, 97, 98, 101, 108, 32, 37];

            llvm_chars(out, &lab, 9);
            llvm_async_label(out, segment + 1, 2);
            llvm_chars(out, &lab, 9);
            llvm_async_label(out, segment + 1, 3);
            writer_newline(out);
            llvm_async_label(out, segment + 1, 3);
            writer_put(out, 58);
            writer_newline(out);

            i64 ret0[12] = [32, 32, 114, 101, 116, 32, 105, 51, 50, 32, 48, 10];

            llvm_chars(out, &ret0, 12);
            llvm_async_label(out, segment + 1, 2);
            writer_put(out, 58);
            writer_newline(out);
            llvm_emit_assignment(out, ip);

            i64 ar[44] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 97, 119, 97, 105, 116, 95, 114, 101, 115, 117, 108, 116, 40, 112, 116, 114, 32, 37, 102, 114, 97];

            llvm_chars(out, &ar, 44);

            i64 met[4] = [109, 101, 41, 0];

            llvm_chars(out, &met, 3);
            writer_newline(out);
            segment += 1;
            open = true;
            terminated = false;
        } else if (opcode == 21) {
            llvm_async_disarm_owned_locals(out, hir, function_index);

            i64 zero_result[48] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 114, 101, 115, 117, 108, 116, 95, 115, 116, 111, 114, 101, 40, 112, 116, 114, 32, 37, 102, 114, 97, 109];

            llvm_chars(out, &zero_result, 48);

            i64 zero_tail[13] = [101, 44, 32, 105, 54, 52, 32, 48, 41, 10, 0, 0, 0];

            llvm_chars(out, &zero_tail, 10);
            llvm_async_emit_state_store(out, completed_state);

            i64 ret1[12] = [32, 32, 114, 101, 116, 32, 105, 51, 50, 32, 49, 10];

            llvm_chars(out, &ret1, 12);
            terminated = true;
            open = false;
        } else if (opcode == 10) {
            i64 result = raz_compiler_rt_arena_get(mir.op_a, ip);

            llvm_async_disarm_owned_locals(out, hir, function_index);

            i64 rs[41] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 97, 115, 121, 110, 99, 95, 114, 101, 115, 117, 108, 116, 95, 115, 116, 111, 114, 101, 40, 112, 116];

            llvm_chars(out, &rs, 41);

            i64 rr[8] = [114, 32, 37, 102, 114, 97, 109, 101];

            llvm_chars(out, &rr, 8);

            i64 mid[6] = [44, 32, 105, 54, 52, 32];

            llvm_chars(out, &mid, 6);
            llvm_value(out, result);
            writer_put(out, 41);
            writer_newline(out);
            llvm_async_emit_state_store(out, completed_state);

            i64 ret1[12] = [32, 32, 114, 101, 116, 32, 105, 51, 50, 32, 49, 10];

            llvm_chars(out, &ret1, 12);
            terminated = true;
            open = false;
        } else {
            if (!llvm_emit_async_scalar_instruction(out, source, hir, mir, function_index, ip)) {
                return false;
            }
        }
        ip += 1;
    }
    if (!terminated) {
        llvm_async_disarm_owned_locals(out, hir, function_index);
        llvm_async_emit_state_store(out, completed_state);

        i64 ret1[12] = [32, 32, 114, 101, 116, 32, 105, 51, 50, 32, 49, 10];

        llvm_chars(out, &ret1, 12);
    }
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    return !out.failed;
}

fn llvm_emit_function(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    LlvmTargetOptions& options,
    i64 function_index,
) -> bool {
    if (raz_compiler_rt_arena_get(hir.function_is_async, function_index) != 0) {
        return llvm_emit_async_function(out, source, hir, mir, options, function_index);
    }
    llvm_emit_function_header(out, source, hir, mir, options, function_index, false);
    writer_space(out);
    writer_put(out, 123);
    writer_newline(out);

    i64 entryword[6] = [101, 110, 116, 114, 121, 58];

    llvm_chars(out, &entryword, 6);
    writer_newline(out);
    // MIR locals are raw machine-sized slots. Keeping that representation in
    // LLVM preserves Raz's backend-neutral local/reference semantics.

    i64 local_count = raz_compiler_rt_arena_get(mir.function_local_counts, function_index);
    i64 local = 0;

    while (local < local_count) {
        writer_space(out);
        writer_space(out);
        llvm_local(out, local);
        writer_space(out);
        writer_put(out, 61);
        writer_space(out);

        i64 alloca_word[6] = [97, 108, 108, 111, 99, 97];

        llvm_chars(out, &alloca_word, 6);
        writer_space(out);
        writer_i64(out);
        writer_newline(out);
        writer_space(out);
        writer_space(out);

        i64 store_zero[10] = [115, 116, 111, 114, 101, 32, 105, 54, 52, 32];

        llvm_chars(out, &store_zero, 10);
        writer_decimal(out, 0);
        writer_put(out, 44);
        writer_space(out);

        i64 ptrword[4] = [112, 116, 114, 32];

        llvm_chars(out, &ptrword, 4);
        llvm_local(out, local);
        writer_newline(out);
        local += 1;
    }

    i64 function_start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 ip = function_start;
    i64 end = ip + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    bool terminated = false;

    while (ip < end) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);
        i64 type_kind = raz_compiler_rt_arena_get(mir.op_types, ip);

        if (opcode == 24) {
            if (!terminated) {
                writer_space(out);
                writer_space(out);

                i64 brword[9] = [98, 114, 32, 108, 97, 98, 101, 108, 32];

                llvm_chars(out, &brword, 9);
                writer_put(out, 37);
                llvm_block(out, ip);
                writer_newline(out);
            }
            llvm_block(out, ip);
            writer_put(out, 58);
            writer_newline(out);
            terminated = false;
            if (raz_compiler_rt_arena_get(mir.op_a, ip) != 0) {
                if (!llvm_emit_block_phi(out, mir, function_start, end, ip)) {
                    return false;
                }
            }
        } else if (terminated) {} else if (opcode == 1) {
            llvm_emit_assignment(out, ip);
            if (primitive_type_is_float(type_kind)) {
                i64 word[4] = [102, 97, 100, 100];

                llvm_chars(out, &word, 4);
                writer_space(out);
                llvm_type(out, type_kind);
                writer_space(out);
                if (raz_compiler_rt_arena_get(mir.op_b, ip) > 0) {
                    writer_text(
                        out,
                        source,
                        raz_compiler_rt_arena_get(mir.op_a, ip),
                        raz_compiler_rt_arena_get(mir.op_b, ip),
                    );
                } else {
                    writer_put(out, 48);
                    writer_put(out, 46);
                    writer_put(out, 48);
                }
                writer_put(out, 44);
                writer_space(out);
                writer_put(out, 48);
                writer_put(out, 46);
                writer_put(out, 48);
            } else {
                i64 word[3] = [97, 100, 100];

                llvm_chars(out, &word, 3);
                writer_space(out);
                llvm_type(out, type_kind);
                writer_space(out);
                writer_decimal(out, 0);
                writer_put(out, 44);
                writer_space(out);
                writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            }
            writer_newline(out);
        } else if (opcode == 2) {
            i64 parameter = raz_compiler_rt_arena_get(mir.op_a, ip);

            llvm_emit_assignment(out, ip);
            if (primitive_type_is_float(type_kind)) {
                i64 word[4] = [102, 97, 100, 100];

                llvm_chars(out, &word, 4);
                writer_space(out);
                llvm_parameter_type(out, hir, function_index, parameter);
                writer_space(out);
                llvm_parameter(out, parameter);
                writer_put(out, 44);
                writer_space(out);
                writer_put(out, 48);
                writer_put(out, 46);
                writer_put(out, 48);
            } else if (
                (type_kind == 12 || type_kind == 13 || type_kind == 14) &&
                raz_compiler_rt_arena_get(
                    hir.parameter_references,
                    raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index) + parameter,
                ) == 0
            ) {
                i64 gep[13] = [103, 101, 116, 101, 108, 101, 109, 101, 110, 116, 112, 116, 114];

                llvm_chars(out, &gep, 13);

                i64 tail[9] = [32, 105, 56, 44, 32, 112, 116, 114, 32];

                llvm_chars(out, &tail, 9);
                llvm_parameter(out, parameter);

                i64 zero[7] = [44, 32, 105, 54, 52, 32, 48];

                llvm_chars(out, &zero, 7);
            } else {
                i64 word[3] = [97, 100, 100];

                llvm_chars(out, &word, 3);
                writer_space(out);
                llvm_parameter_type(out, hir, function_index, parameter);
                writer_space(out);
                llvm_parameter(out, parameter);
                writer_put(out, 44);
                writer_space(out);
                writer_decimal(out, 0);
            }
            writer_newline(out);
        } else if (opcode == 3) {
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 10, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 loadword[4] = [108, 111, 97, 100];

            llvm_chars(out, &loadword, 4);
            writer_space(out);
            writer_i64(out);
            writer_put(out, 44);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_local(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(out);
            if (llvm_local_is_reference(hir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip))) {
                // References use the backend-neutral machine-word ABI. Keep a
                // loaded reference as i64; dereference opcodes perform the
                // explicit inttoptr conversion at the actual memory access.
                llvm_emit_assignment(out, ip);

                i64 addword[8] = [97, 100, 100, 32, 105, 54, 52, 32];

                llvm_chars(out, &addword, 8);
                llvm_temp(out, 10, ip);
                writer_put(out, 44);
                writer_space(out);
                writer_decimal(out, 0);
                writer_newline(out);
            } else {
                llvm_emit_raw_to_value(out, ip, 10, ip, type_kind);
            }
        } else if ((opcode >= 4 && opcode <= 7) || (opcode >= 34 && opcode <= 39)) {
            llvm_emit_assignment(out, ip);
            if (!llvm_emit_binary_opcode(out, opcode, type_kind)) {
                return false;
            }
            writer_space(out);
            llvm_type(out, type_kind);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_newline(out);
        } else if (opcode >= 11 && opcode <= 16) {
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 30, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);
            if (primitive_type_is_float(type_kind)) {
                i64 word[5] = [102, 99, 109, 112, 32];

                llvm_chars(out, &word, 5);
            } else {
                i64 word[5] = [105, 99, 109, 112, 32];

                llvm_chars(out, &word, 5);
            }
            if (!llvm_emit_compare_predicate(out, opcode, type_kind)) {
                return false;
            }
            writer_space(out);
            llvm_type(out, type_kind);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_newline(out);
            llvm_emit_assignment(out, ip);

            i64 zext[4] = [122, 101, 120, 116];

            llvm_chars(out, &zext, 4);

            i64 i1word[4] = [32, 105, 49, 32];

            llvm_chars(out, &i1word, 4);
            llvm_temp(out, 30, ip);

            i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

            llvm_chars(out, &toi64, 7);
            writer_newline(out);
        } else if (opcode == 17) {
            // MIR select uses Raz's integer boolean convention. Convert the
            // condition to LLVM i1, then select values without changing their
            // backend-neutral representation.
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 31, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 cmpword[8] = [105, 99, 109, 112, 32, 110, 101, 32];

            llvm_chars(out, &cmpword, 8);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
            llvm_emit_assignment(out, ip);

            i64 selectword[7] = [115, 101, 108, 101, 99, 116, 32];

            llvm_chars(out, &selectword, 7);
            writer_put(out, 105);
            writer_put(out, 49);
            writer_space(out);
            llvm_temp(out, 31, ip);
            writer_put(out, 44);
            writer_space(out);
            llvm_type(out, type_kind);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_put(out, 44);
            writer_space(out);
            llvm_type(out, type_kind);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_c, ip));
            writer_newline(out);
        } else if (opcode == 18) {
            // Logical not: compare the machine-word boolean with zero, then
            // normalize LLVM i1 back to Raz's i64 boolean representation.
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 32, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 cmpword[8] = [105, 99, 109, 112, 32, 101, 113, 32];

            llvm_chars(out, &cmpword, 8);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
            llvm_emit_assignment(out, ip);

            i64 zextword[8] = [122, 101, 120, 116, 32, 105, 49, 32];

            llvm_chars(out, &zextword, 8);
            llvm_temp(out, 32, ip);

            i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

            llvm_chars(out, &toi64, 7);
            writer_newline(out);
        } else if (opcode == 19 || opcode == 20) {
            // HIR short-circuit expressions normally lower through CFG. These
            // MIR opcodes also exist for already-materialized boolean values.
            llvm_emit_assignment(out, ip);
            if (opcode == 19) {
                i64 andword[3] = [97, 110, 100];

                llvm_chars(out, &andword, 3);
            } else {
                i64 orword[2] = [111, 114];

                llvm_chars(out, &orword, 2);
            }
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_newline(out);
        } else if (opcode == 40) {
            if (
                !llvm_emit_numeric_cast(
                    out,
                    ip,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                    raz_compiler_rt_arena_get(mir.op_b, ip),
                    type_kind,
                )
            ) {
                return false;
            }
        } else if (opcode == 8) {
            i64 target = raz_compiler_rt_arena_get(mir.op_a, ip);
            bool returns_value = raz_compiler_rt_arena_get(hir.function_returns_value, target) != 0;

            if (returns_value) {
                llvm_emit_assignment(out, ip);
            } else {
                writer_space(out);
                writer_space(out);
            }

            i64 callword[4] = [99, 97, 108, 108];

            llvm_chars(out, &callword, 4);
            writer_space(out);
            llvm_function_return_type(out, hir, target);
            writer_space(out);
            llvm_function_name(out, source, hir, target);
            writer_put(out, 40);

            i64 argument = 0;
            i64 count = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 argument_start = raz_compiler_rt_arena_get(mir.op_b, ip);

            while (argument < count) {
                if (argument > 0) {
                    writer_put(out, 44);
                    writer_space(out);
                }
                llvm_parameter_type(out, hir, target, argument);
                writer_space(out);
                llvm_value(out, raz_compiler_rt_arena_get(mir.call_arguments, argument_start + argument));
                argument += 1;
            }
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 9) {
            i64 local_slot = raz_compiler_rt_arena_get(mir.op_a, ip);
            i64 stored_value = raz_compiler_rt_arena_get(mir.op_b, ip);

            if (llvm_local_is_reference(hir, function_index, local_slot)) {
                llvm_emit_local_store_word(out, local_slot, stored_value);
            } else {
                llvm_emit_local_store(out, ip, local_slot, stored_value, type_kind);
            }
        } else if (opcode == 10) {
            writer_space(out);
            writer_space(out);

            i64 ret[3] = [114, 101, 116];

            llvm_chars(out, &ret, 3);
            writer_space(out);
            llvm_function_return_type(out, hir, function_index);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(out);
            terminated = true;
        } else if (opcode == 21) {
            writer_space(out);
            writer_space(out);

            i64 ret[8] = [114, 101, 116, 32, 118, 111, 105, 100];

            llvm_chars(out, &ret, 8);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 22) {
            i64 target = raz_compiler_rt_arena_get(mir.op_b, ip);

            if (target < 0) {
                return false;
            }
            writer_space(out);
            writer_space(out);

            i64 brword[9] = [98, 114, 32, 108, 97, 98, 101, 108, 32];

            llvm_chars(out, &brword, 9);
            writer_put(out, 37);
            llvm_block(out, target);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 23) {
            i64 false_target = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 true_target = raz_compiler_rt_arena_get(mir.op_c, ip);

            if (false_target < 0 || true_target < 0) {
                return false;
            }
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 31, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 cmpword[8] = [105, 99, 109, 112, 32, 110, 101, 32];

            llvm_chars(out, &cmpword, 8);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
            writer_space(out);
            writer_space(out);

            i64 brprefix[6] = [98, 114, 32, 105, 49, 32];

            llvm_chars(out, &brprefix, 6);
            llvm_temp(out, 31, ip);

            i64 labelword[8] = [44, 32, 108, 97, 98, 101, 108, 32];

            llvm_chars(out, &labelword, 8);
            writer_put(out, 37);
            llvm_block(out, true_target);
            llvm_chars(out, &labelword, 8);
            writer_put(out, 37);
            llvm_block(out, false_target);
            writer_newline(out);
            terminated = true;
        } else if (opcode == 25) {
            // LLVM references use Raz's machine-word ABI while carrying the
            // address of the actual stack slot. That makes local and aggregate
            // element borrows share the same dereference/store operations.
            llvm_emit_assignment(out, ip);

            i64 ptrtoint[8] = [112, 116, 114, 116, 111, 105, 110, 116];

            llvm_chars(out, &ptrtoint, 8);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_local(out, raz_compiler_rt_arena_get(mir.op_a, ip));

            i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

            llvm_chars(out, &toi64, 7);
            writer_newline(out);
        } else if (opcode == 26) {
            i64 reference = raz_compiler_rt_arena_get(mir.op_a, ip);

            writer_space(out);
            writer_space(out);
            llvm_temp(out, 51, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 inttoptr[8] = [105, 110, 116, 116, 111, 112, 116, 114];

            llvm_chars(out, &inttoptr, 8);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, reference);

            i64 toptr[7] = [32, 116, 111, 32, 112, 116, 114];

            llvm_chars(out, &toptr, 7);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 10, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 loadword[9] = [108, 111, 97, 100, 32, 105, 54, 52, 44];

            llvm_chars(out, &loadword, 9);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_temp(out, 51, ip);
            writer_newline(out);
            llvm_emit_raw_to_value(out, ip, 10, ip, type_kind);
        } else if (opcode == 27) {
            i64 value = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 raw = llvm_emit_value_to_raw(out, ip, value, type_kind);

            writer_space(out);
            writer_space(out);
            llvm_temp(out, 52, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 inttoptr[8] = [105, 110, 116, 116, 111, 112, 116, 114];

            llvm_chars(out, &inttoptr, 8);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

            i64 toptr[7] = [32, 116, 111, 32, 112, 116, 114];

            llvm_chars(out, &toptr, 7);
            writer_newline(out);
            writer_space(out);
            writer_space(out);

            i64 storeword[10] = [115, 116, 111, 114, 101, 32, 105, 54, 52, 32];

            llvm_chars(out, &storeword, 10);
            if (raw >= 0) {
                llvm_value(out, raw);
            } else if (raw == -21) {
                llvm_temp(out, 21, ip);
            } else {
                llvm_temp(out, 20, ip);
            }
            writer_put(out, 44);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_temp(out, 52, ip);
            writer_newline(out);
            llvm_emit_assignment(out, ip);

            i64 addword[8] = [97, 100, 100, 32, 105, 54, 52, 32];

            llvm_chars(out, &addword, 8);
            if (raw >= 0) {
                llvm_value(out, raw);
            } else if (raw == -21) {
                llvm_temp(out, 21, ip);
            } else {
                llvm_temp(out, 20, ip);
            }
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
        } else if (opcode == 28) {
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 41, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 callprefix[38] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 103, 101, 116, 40, 105, 54, 52, 32];

            llvm_chars(out, &callprefix, 38);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

            i64 middle[6] = [44, 32, 105, 54, 52, 32];

            llvm_chars(out, &middle, 6);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_put(out, 41);
            writer_newline(out);
            llvm_emit_raw_to_value(out, ip, 41, ip, type_kind);
        } else if (opcode == 29) {
            i64 value = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 raw = llvm_emit_value_to_raw(out, ip, value, llvm_value_result_type(mir, value));

            writer_space(out);
            writer_space(out);

            i64 callprefix[39] = [99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 115, 101, 116, 40, 105, 54, 52, 32];

            llvm_chars(out, &callprefix, 39);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

            i64 middle[6] = [44, 32, 105, 54, 52, 32];

            llvm_chars(out, &middle, 6);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            llvm_chars(out, &middle, 6);
            if (raw >= 0) {
                llvm_value(out, raw);
            } else if (raw == -21) {
                llvm_temp(out, 21, ip);
            } else {
                llvm_temp(out, 20, ip);
            }
            writer_put(out, 41);
            writer_newline(out);
            llvm_emit_assignment(out, ip);

            i64 addword[8] = [97, 100, 100, 32, 105, 54, 52, 32];

            llvm_chars(out, &addword, 8);
            if (raw >= 0) {
                llvm_value(out, raw);
            } else if (raw == -21) {
                llvm_temp(out, 21, ip);
            } else {
                llvm_temp(out, 20, ip);
            }
            writer_put(out, 44);
            writer_space(out);
            writer_decimal(out, 0);
            writer_newline(out);
        } else if (opcode == 30) {
            llvm_emit_assignment(out, ip);

            i64 callprefix[41] = [99, 97, 108, 108, 32, 105, 54, 52, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 99, 114, 101, 97, 116, 101, 40, 105, 54, 52, 32];

            llvm_chars(out, &callprefix, 41);
            writer_decimal(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 31) {
            writer_space(out);
            writer_space(out);

            i64 callprefix[43] = [99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 114, 97, 122, 95, 114, 116, 95, 115, 116, 97, 103, 101, 49, 95, 97, 114, 101, 110, 97, 95, 100, 101, 115, 116, 114, 111, 121, 40, 105, 54, 52, 32];

            llvm_chars(out, &callprefix, 43);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 44) {
            i64 signature = raz_compiler_rt_arena_get(mir.op_d, ip);

            llvm_emit_assignment(out, ip);

            i64 callword[4] = [99, 97, 108, 108];

            llvm_chars(out, &callword, 4);
            writer_space(out);
            llvm_function_type_return_type(out, hir, signature);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_put(out, 40);

            i64 argument_start = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 argument_count = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 argument = 0;

            while (argument < argument_count) {
                if (argument > 0) {
                    writer_put(out, 44);
                    writer_space(out);
                }
                llvm_function_type_parameter_type(out, hir, signature, argument);
                writer_space(out);
                llvm_value(out, raz_compiler_rt_arena_get(mir.call_arguments, argument_start + argument));
                argument += 1;
            }
            writer_put(out, 41);
            writer_newline(out);
        } else if (opcode == 47) {
            llvm_emit_assignment(out, ip);

            i64 loadword[5] = [108, 111, 97, 100, 32];

            llvm_chars(out, &loadword, 5);
            llvm_type(out, type_kind);
            writer_put(out, 44);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(out);
        } else if (opcode == 48) {
            writer_space(out);
            writer_space(out);

            i64 storeword[6] = [115, 116, 111, 114, 101, 32];

            llvm_chars(out, &storeword, 6);
            llvm_type(out, type_kind);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_put(out, 44);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));
            writer_newline(out);
        } else if (opcode == 49) {
            llvm_emit_assignment(out, ip);

            i64 ptrtoint[8] = [112, 116, 114, 116, 111, 105, 110, 116];

            llvm_chars(out, &ptrtoint, 8);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_module_global_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));

            i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

            llvm_chars(out, &toi64, 7);
            writer_newline(out);
        } else if (opcode == 46) {
            // Spawn remains visible as a distinct MIR effect. The source async
            // call already produced the future handle, so the synchronous LLVM
            // lowering preserves that handle exactly like Forge does.
            llvm_emit_assignment(out, ip);
            if (primitive_type_is_float(type_kind)) {
                i64 copyword[5] = [102, 97, 100, 100, 32];

                llvm_chars(out, &copyword, 5);
                llvm_type(out, type_kind);
                writer_space(out);
                llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_put(out, 44);
                writer_space(out);
                writer_put(out, 48);
                writer_put(out, 46);
                writer_put(out, 48);
            } else {
                i64 copyword[4] = [97, 100, 100, 32];

                llvm_chars(out, &copyword, 4);
                llvm_type(out, type_kind);
                writer_space(out);
                llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));
                writer_put(out, 44);
                writer_space(out);
                writer_decimal(out, 0);
            }
            writer_newline(out);
        } else if (opcode == 45) {
            // Arena element references are genuine aliases. The compiler arena
            // handle is the address of its i64 payload, so LLVM can form the
            // element address directly while keeping Raz references as i64.
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 53, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 inttoptr[8] = [105, 110, 116, 116, 111, 112, 116, 114];

            llvm_chars(out, &inttoptr, 8);
            writer_space(out);
            writer_i64(out);
            writer_space(out);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_a, ip));

            i64 toptr[7] = [32, 116, 111, 32, 112, 116, 114];

            llvm_chars(out, &toptr, 7);
            writer_newline(out);
            writer_space(out);
            writer_space(out);
            llvm_temp(out, 54, ip);
            writer_space(out);
            writer_put(out, 61);
            writer_space(out);

            i64 gep[13] = [103, 101, 116, 101, 108, 101, 109, 101, 110, 116, 112, 116, 114];

            llvm_chars(out, &gep, 13);
            writer_space(out);
            writer_i64(out);
            writer_put(out, 44);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_temp(out, 53, ip);

            i64 idxprefix[6] = [44, 32, 105, 54, 52, 32];

            llvm_chars(out, &idxprefix, 6);
            llvm_value(out, raz_compiler_rt_arena_get(mir.op_b, ip));
            writer_newline(out);
            llvm_emit_assignment(out, ip);

            i64 ptrtoint[8] = [112, 116, 114, 116, 111, 105, 110, 116];

            llvm_chars(out, &ptrtoint, 8);
            writer_space(out);

            i64 ptrword2[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword2, 4);
            llvm_temp(out, 54, ip);

            i64 toi64[7] = [32, 116, 111, 32, 105, 54, 52];

            llvm_chars(out, &toi64, 7);
            writer_newline(out);
        } else if (opcode == 42) {
            llvm_emit_assignment(out, ip);

            i64 gep[14] = [103, 101, 116, 101, 108, 101, 109, 101, 110, 116, 112, 116, 114, 32];

            llvm_chars(out, &gep, 14);
            writer_put(out, 91);
            writer_decimal(out, raz_compiler_rt_arena_get(mir.op_b, ip) + 1);

            i64 arraytype[7] = [32, 120, 32, 105, 56, 93, 44];

            llvm_chars(out, &arraytype, 7);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_string_global_name(out, ip);

            i64 zeros[14] = [44, 32, 105, 54, 52, 32, 48, 44, 32, 105, 54, 52, 32, 48];

            llvm_chars(out, &zeros, 14);
            writer_newline(out);
        } else if (opcode == 43) {
            llvm_emit_assignment(out, ip);

            i64 selectword[15] = [115, 101, 108, 101, 99, 116, 32, 105, 49, 32, 116, 114, 117, 101, 44];

            llvm_chars(out, &selectword, 15);
            writer_space(out);

            i64 ptrword[4] = [112, 116, 114, 32];

            llvm_chars(out, &ptrword, 4);
            llvm_function_name(out, source, hir, raz_compiler_rt_arena_get(mir.op_a, ip));

            i64 tail[10] = [44, 32, 112, 116, 114, 32, 110, 117, 108, 108];

            llvm_chars(out, &tail, 10);
            writer_newline(out);
        } else if (opcode == 32 || opcode == 33) {
            // Ownership markers are compile-time MIR effects; LLVM needs no code.
        } else {
            return false;
        }
        ip += 1;
    }
    if (!terminated) {
        if (raz_compiler_rt_arena_get(hir.function_returns_value, function_index) == 0) {
            writer_space(out);
            writer_space(out);

            i64 ret[8] = [114, 101, 116, 32, 118, 111, 105, 100];

            llvm_chars(out, &ret, 8);
            writer_newline(out);
        } else {
            writer_space(out);
            writer_space(out);

            i64 unreachable[11] = [117, 110, 114, 101, 97, 99, 104, 97, 98, 108, 101];

            llvm_chars(out, &unreachable, 11);
            writer_newline(out);
        }
    }
    writer_put(out, 125);
    writer_newline(out);
    writer_newline(out);
    return !out.failed;
}

fn write_llvm_output(ForgeWriter&mut writer, i64 output_path, i64 output_path_length) -> bool {
    i64 written = 0;

    if (output_path != 0 && output_path_length > 0) {
        written = raz_compiler_rt_write_ascii(output_path, output_path_length, writer.data, writer.length);
    } else {
        i64 path[16] = [115, 116, 97, 103, 101, 49, 45, 111, 117, 116, 112, 117, 116, 46, 108, 108];

        written = raz_rt_write_ascii_i64(&mut path[0], 16, writer.data, writer.length);
    }
    return written == writer.length;
}

fn llvm_extern_already_emitted(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 previous = 0;

    while (previous < function_index) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, previous) != 0 &&
            function_native_symbol_same(source, hir, previous, function_index)
        ) {
            return true;
        }
        previous += 1;
    }
    return false;
}

fn emit_llvm_module(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    LlvmTargetOptions& options,
    i64 output_path,
    i64 output_path_length,
) -> bool {
    if (!llvm_validate_symbol_options(source, hir, options)) {
        return false;
    }

    ForgeWriter writer;

    writer_init(&mut writer);

    i64 header[36] = [59, 32, 82, 97, 122, 32, 76, 76, 86, 77, 32, 98, 97, 99, 107, 101, 110, 100, 32, 45, 32, 103, 101, 110, 101, 114, 97, 116, 101, 100, 32, 73, 82, 10, 10, 10];

    llvm_chars(&mut writer, &header, 36);
    llvm_emit_target_metadata(&mut writer, options);
    llvm_emit_runtime_declarations(&mut writer);
    llvm_emit_module_globals(&mut writer, source, hir);
    llvm_emit_global_lifecycle(&mut writer, source, hir);
    llvm_emit_string_globals(&mut writer, source, mir);

    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0 &&
            !llvm_extern_already_emitted(source, hir, function_index)
        ) {
            llvm_emit_function_header(&mut writer, source, hir, mir, options, function_index, true);
            writer_newline(&mut writer);
        }
        function_index += 1;
    }
    writer_newline(&mut writer);

    i64 structure = 0;

    while (structure < hir.struct_count) {
        if (!llvm_emit_async_structure_cleanup_function(&mut writer, source, hir, structure)) {
            writer_destroy(&mut writer);
            return false;
        }
        structure += 1;
    }
    function_index = 0;
    while (function_index < hir.function_count) {
        if (raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0) {
            if (!llvm_emit_function(&mut writer, source, hir, mir, options, function_index)) {
                writer_destroy(&mut writer);
                return false;
            }
        }
        function_index += 1;
    }

    i64 main_index = find_main_function(hir, source);

    if (
        main_index < 0 ||
        raz_compiler_rt_arena_get(hir.function_parameter_counts, main_index) != 0 ||
        raz_compiler_rt_arena_get(hir.function_returns_value, main_index) == 0
    ) {
        writer_destroy(&mut writer);
        return false;
    }

    i64 wrapper[20] = [100, 101, 102, 105, 110, 101, 32, 105, 51, 50, 32, 64, 109, 97, 105, 110, 40, 41, 32, 123];

    llvm_chars(&mut writer, &wrapper, 20);
    writer_newline(&mut writer);
    if (llvm_has_aggregate_globals(hir)) {
        i64 init_call[34] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 95, 95, 114, 97, 122, 95, 103, 108, 111, 98, 97, 108, 115, 95, 105, 110, 105, 116, 40, 41, 10];

        llvm_chars(&mut writer, &init_call, 34);
    }

    i64 callprefix[11] = [37, 114, 97, 122, 109, 97, 105, 110, 32, 61, 32];

    llvm_chars(&mut writer, &callprefix, 11);

    i64 callword[5] = [99, 97, 108, 108, 32];

    llvm_chars(&mut writer, &callword, 5);
    llvm_function_return_type(&mut writer, hir, main_index);
    writer_space(&mut writer);
    llvm_function_name(&mut writer, source, hir, main_index);
    writer_put(&mut writer, 40);
    writer_put(&mut writer, 41);
    writer_newline(&mut writer);
    if (llvm_has_aggregate_globals(hir)) {
        i64 fini_call[34] = [32, 32, 99, 97, 108, 108, 32, 118, 111, 105, 100, 32, 64, 95, 95, 114, 97, 122, 95, 103, 108, 111, 98, 97, 108, 115, 95, 102, 105, 110, 105, 40, 41, 10];

        llvm_chars(&mut writer, &fini_call, 34);
    }

    i64 main_return_type = raz_compiler_rt_arena_get(hir.function_return_types, main_index);

    if (
        primitive_type_is_float(main_return_type) ||
        main_return_type == 12 ||
        main_return_type == 13 ||
        main_return_type == 14 ||
        hir_type_is_enum(main_return_type)
    ) {
        writer_destroy(&mut writer);
        return false;
    }
    writer_space(&mut writer);
    writer_space(&mut writer);

    i64 exitname[8] = [37, 101, 120, 105, 116, 32, 61, 32];

    llvm_chars(&mut writer, &exitname, 8);

    i64 main_width = primitive_type_width(main_return_type);

    if (main_width > 32) {
        i64 truncword[6] = [116, 114, 117, 110, 99, 32];

        llvm_chars(&mut writer, &truncword, 6);
        llvm_type(&mut writer, main_return_type);
        writer_space(&mut writer);

        i64 razmain[8] = [37, 114, 97, 122, 109, 97, 105, 110];

        llvm_chars(&mut writer, &razmain, 8);

        i64 toword[7] = [32, 116, 111, 32, 105, 51, 50];

        llvm_chars(&mut writer, &toword, 7);
    } else if (main_width < 32) {
        i64 zextword[5] = [122, 101, 120, 116, 32];

        llvm_chars(&mut writer, &zextword, 5);
        llvm_type(&mut writer, main_return_type);
        writer_space(&mut writer);

        i64 razmain[8] = [37, 114, 97, 122, 109, 97, 105, 110];

        llvm_chars(&mut writer, &razmain, 8);

        i64 toword[7] = [32, 116, 111, 32, 105, 51, 50];

        llvm_chars(&mut writer, &toword, 7);
    } else {
        i64 addword[8] = [97, 100, 100, 32, 105, 51, 50, 32];

        llvm_chars(&mut writer, &addword, 8);

        i64 razmain[8] = [37, 114, 97, 122, 109, 97, 105, 110];

        llvm_chars(&mut writer, &razmain, 8);
        writer_put(&mut writer, 44);
        writer_space(&mut writer);
        writer_decimal(&mut writer, 0);
    }
    writer_newline(&mut writer);

    i64 retline[15] = [32, 32, 114, 101, 116, 32, 105, 51, 50, 32, 37, 101, 120, 105, 116];

    llvm_chars(&mut writer, &retline, 15);
    writer_newline(&mut writer);
    writer_put(&mut writer, 125);
    writer_newline(&mut writer);
    if (writer.failed) {
        writer_destroy(&mut writer);
        return false;
    }

    bool success = write_llvm_output(&mut writer, output_path, output_path_length);

    writer_destroy(&mut writer);
    return success;
}
