    writer_text(
        out,
        source,
        raz_compiler_rt_arena_get(hir.global_name_offsets, global_index),
        raz_compiler_rt_arena_get(hir.global_name_lengths, global_index),
    );
    if (writer_module_global_needs_identity_suffix(source, hir, global_index)) {
        writer_put(out, 95);
        writer_put(out, 103);
        writer_decimal(out, global_index);
    }
}
