namespace raz_compiler_backend_llvm_target;
public import raz_compiler_backend_llvm_writer;
// LLVM target/toolchain configuration. Target selection and tool orchestration
// are implemented in Raz; process launch remains a permanent host ABI boundary.
public struct LlvmTargetOptions {
  i64 target_arg;
  i64 target_offset;
  i64 target_length;
  i64 data_layout_arg;
  i64 data_layout_offset;
  i64 data_layout_length;
  i64 cpu_arg;
  i64 cpu_offset;
  i64 cpu_length;
  i64 features_arg;
  i64 features_offset;
  i64 features_length;
  i64 runtime_arg;
  i64 runtime_offset;
  i64 runtime_length;
  i64 emit_kind;
  i64 optimization_kind;
  bool debug_info;
  i64 lto_kind;
  i64 library_path_arg;
  i64 library_path_offset;
  i64 library_path_length;
  i64 libraries_arg;
  i64 libraries_offset;
  i64 libraries_length;
  i64 linker_arg;
  i64 linker_offset;
  i64 linker_length;
  i64 link_args_arg;
  i64 link_args_offset;
  i64 link_args_length;
  i64 relocation_kind;
  i64 code_model_kind;
  i64 visibility_kind;
  i64 export_arg;
  i64 export_offset;
  i64 export_length;
  i64 import_arg;
  i64 import_offset;
  i64 import_length;
  i64 weak_arg;
  i64 weak_offset;
  i64 weak_length;
  i64 linkonce_arg;
  i64 linkonce_offset;
  i64 linkonce_length;
}

fn llvm_target_options_init(LlvmTargetOptions&mut out) {
  out.target_arg = 0;
  out.target_offset = 0;
  out.target_length = 0;
  out.data_layout_arg = 0;
  out.data_layout_offset = 0;
  out.data_layout_length = 0;
  out.cpu_arg = 0;
  out.cpu_offset = 0;
  out.cpu_length = 0;
  out.features_arg = 0;
  out.features_offset = 0;
  out.features_length = 0;
  out.runtime_arg = 0;
  out.runtime_offset = 0;
  out.runtime_length = 0;
  out.emit_kind = 0;
  out.optimization_kind = -1;
  out.debug_info = false;
  out.lto_kind = -1;
  out.library_path_arg = 0;
  out.library_path_offset = 0;
  out.library_path_length = 0;
  out.libraries_arg = 0;
  out.libraries_offset = 0;
  out.libraries_length = 0;
  out.linker_arg = 0;
  out.linker_offset = 0;
  out.linker_length = 0;
  out.link_args_arg = 0;
  out.link_args_offset = 0;
  out.link_args_length = 0;
  out.relocation_kind = -1;
  out.code_model_kind = -1;
  out.visibility_kind = -1;
  out.export_arg = 0;
  out.export_offset = 0;
  out.export_length = 0;
  out.import_arg = 0;
  out.import_offset = 0;
  out.import_length = 0;
  out.weak_arg = 0;
  out.weak_offset = 0;
  out.weak_length = 0;
  out.linkonce_arg = 0;
  out.linkonce_offset = 0;
  out.linkonce_length = 0;
}

fn llvm_option_prefix(i64 value, i64 length, i64[]prefix, i64 prefix_length) -> bool {
  if (value == 0 || length <= prefix_length) {
    return false;
  }

  i64 i = 0;

  while (i < prefix_length) {
    if (raz_rt_stage1_arena_get(value, i) != prefix[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

fn llvm_option_value_equals(i64 value, i64 offset, i64 length, i64[]expected, i64 expected_length) -> bool {
  if (length != expected_length) {
    return false;
  }

  i64 i = 0;

  while (i < expected_length) {
    if (raz_rt_stage1_arena_get(value, offset + i) != expected[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Returns 1 when consumed, 0 when this is not an LLVM option, -1 when invalid.
fn llvm_parse_target_option(LlvmTargetOptions&mut out, i64 value, i64 length) -> i64 {
  i64 target_prefix[9] = [45, 45, 116, 97, 114, 103, 101, 116, 61];

  if (llvm_option_prefix(value, length, &target_prefix, 9)) {
    out.target_arg = value;
    out.target_offset = 9;
    out.target_length = length - 9;
    return 1;
  }

  i64 layout_prefix[14] = [45, 45, 100, 97, 116, 97, 45, 108, 97, 121, 111, 117, 116, 61];

  if (llvm_option_prefix(value, length, &layout_prefix, 14)) {
    out.data_layout_arg = value;
    out.data_layout_offset = 14;
    out.data_layout_length = length - 14;
    return 1;
  }

  i64 cpu_prefix[6] = [45, 45, 99, 112, 117, 61];

  if (llvm_option_prefix(value, length, &cpu_prefix, 6)) {
    out.cpu_arg = value;
    out.cpu_offset = 6;
    out.cpu_length = length - 6;
    return 1;
  }

  i64 features_prefix[11] = [45, 45, 102, 101, 97, 116, 117, 114, 101, 115, 61];

  if (llvm_option_prefix(value, length, &features_prefix, 11)) {
    out.features_arg = value;
    out.features_offset = 11;
    out.features_length = length - 11;
    return 1;
  }

  i64 runtime_prefix[10] = [45, 45, 114, 117, 110, 116, 105, 109, 101, 61];

  if (llvm_option_prefix(value, length, &runtime_prefix, 10)) {
    out.runtime_arg = value;
    out.runtime_offset = 10;
    out.runtime_length = length - 10;
    return 1;
  }
  // --debug
  if (length == 7) {
    i64 debug_word[7] = [45, 45, 100, 101, 98, 117, 103];

    if (llvm_option_value_equals(value, 0, length, &debug_word, 7)) {
      out.debug_info = true;
      return 1;
    }
  }
  // --opt=0|1|2|3|s|z

  i64 opt_prefix[6] = [45, 45, 111, 112, 116, 61];

  if (llvm_option_prefix(value, length, &opt_prefix, 6)) {
    if (length != 7) {
      return -1;
    }

    i64 mode = raz_rt_stage1_arena_get(value, 6);

    if (mode == 48) {
      out.optimization_kind = 0;
      return 1;
    }
    if (mode == 49) {
      out.optimization_kind = 1;
      return 1;
    }
    if (mode == 50) {
      out.optimization_kind = 2;
      return 1;
    }
    if (mode == 51) {
      out.optimization_kind = 3;
      return 1;
    }
    if (mode == 115) {
      out.optimization_kind = 4;
      return 1;
    }
    if (mode == 122) {
      out.optimization_kind = 5;
      return 1;
    }
    return -1;
  }
  // --lto=none|thin|full

  i64 lto_prefix[6] = [45, 45, 108, 116, 111, 61];

  if (llvm_option_prefix(value, length, &lto_prefix, 6)) {
    i64 none[4] = [110, 111, 110, 101];
    i64 thin[4] = [116, 104, 105, 110];
    i64 full[4] = [102, 117, 108, 108];
    i64 value_length = length - 6;

    if (llvm_option_value_equals(value, 6, value_length, &none, 4)) {
      out.lto_kind = 0;
      return 1;
    }
    if (llvm_option_value_equals(value, 6, value_length, &thin, 4)) {
      out.lto_kind = 1;
      return 1;
    }
    if (llvm_option_value_equals(value, 6, value_length, &full, 4)) {
      out.lto_kind = 2;
      return 1;
    }
    return -1;
  }

  i64 library_path_prefix[15] = [45, 45, 108, 105, 98, 114, 97, 114, 121, 45, 112, 97, 116, 104, 61];

  if (llvm_option_prefix(value, length, &library_path_prefix, 15)) {
    out.library_path_arg = value;
    out.library_path_offset = 15;
    out.library_path_length = length - 15;
    return 1;
  }

  i64 lib_prefix[6] = [45, 45, 108, 105, 98, 61];

  if (llvm_option_prefix(value, length, &lib_prefix, 6)) {
    out.libraries_arg = value;
    out.libraries_offset = 6;
    out.libraries_length = length - 6;
    return 1;
  }

  i64 linker_prefix[9] = [45, 45, 108, 105, 110, 107, 101, 114, 61];

  if (llvm_option_prefix(value, length, &linker_prefix, 9)) {
    out.linker_arg = value;
    out.linker_offset = 9;
    out.linker_length = length - 9;
    return 1;
  }

  i64 link_arg_prefix[11] = [45, 45, 108, 105, 110, 107, 45, 97, 114, 103, 61];

  if (llvm_option_prefix(value, length, &link_arg_prefix, 11)) {
    out.link_args_arg = value;
    out.link_args_offset = 11;
    out.link_args_length = length - 11;
    return 1;
  }
  // --relocation=default|static|pic

  i64 relocation_prefix[13] = [45, 45, 114, 101, 108, 111, 99, 97, 116, 105, 111, 110, 61];

  if (llvm_option_prefix(value, length, &relocation_prefix, 13)) {
    i64 default_word[7] = [100, 101, 102, 97, 117, 108, 116];
    i64 static_word[6] = [115, 116, 97, 116, 105, 99];
    i64 pic_word[3] = [112, 105, 99];
    i64 value_length = length - 13;

    if (llvm_option_value_equals(value, 13, value_length, &default_word, 7)) {
      out.relocation_kind = 0;
      return 1;
    }
    if (llvm_option_value_equals(value, 13, value_length, &static_word, 6)) {
      out.relocation_kind = 1;
      return 1;
    }
    if (llvm_option_value_equals(value, 13, value_length, &pic_word, 3)) {
      out.relocation_kind = 2;
      return 1;
    }
    return -1;
  }
  // --visibility=default|hidden

  i64 visibility_prefix[13] = [45, 45, 118, 105, 115, 105, 98, 105, 108, 105, 116, 121, 61];

  if (llvm_option_prefix(value, length, &visibility_prefix, 13)) {
    i64 default_word[7] = [100, 101, 102, 97, 117, 108, 116];
    i64 hidden_word[6] = [104, 105, 100, 100, 101, 110];
    i64 value_length = length - 13;

    if (llvm_option_value_equals(value, 13, value_length, &default_word, 7)) {
      out.visibility_kind = 0;
      return 1;
    }
    if (llvm_option_value_equals(value, 13, value_length, &hidden_word, 6)) {
      out.visibility_kind = 1;
      return 1;
    }
    return -1;
  }

  i64 export_prefix[9] = [45, 45, 101, 120, 112, 111, 114, 116, 61];

  if (llvm_option_prefix(value, length, &export_prefix, 9)) {
    out.export_arg = value;
    out.export_offset = 9;
    out.export_length = length - 9;
    return 1;
  }

  i64 import_prefix[9] = [45, 45, 105, 109, 112, 111, 114, 116, 61];

  if (llvm_option_prefix(value, length, &import_prefix, 9)) {
    out.import_arg = value;
    out.import_offset = 9;
    out.import_length = length - 9;
    return 1;
  }

  i64 weak_prefix[7] = [45, 45, 119, 101, 97, 107, 61];

  if (llvm_option_prefix(value, length, &weak_prefix, 7)) {
    out.weak_arg = value;
    out.weak_offset = 7;
    out.weak_length = length - 7;
    return 1;
  }

  i64 linkonce_prefix[11] = [45, 45, 108, 105, 110, 107, 111, 110, 99, 101, 61];

  if (llvm_option_prefix(value, length, &linkonce_prefix, 11)) {
    out.linkonce_arg = value;
    out.linkonce_offset = 11;
    out.linkonce_length = length - 11;
    return 1;
  }
  // --code-model=default|small|medium|large

  i64 code_model_prefix[13] = [45, 45, 99, 111, 100, 101, 45, 109, 111, 100, 101, 108, 61];

  if (llvm_option_prefix(value, length, &code_model_prefix, 13)) {
    i64 default_word[7] = [100, 101, 102, 97, 117, 108, 116];
    i64 small_word[5] = [115, 109, 97, 108, 108];
    i64 medium_word[6] = [109, 101, 100, 105, 117, 109];
    i64 large_word[5] = [108, 97, 114, 103, 101];
    i64 value_length = length - 13;

    if (llvm_option_value_equals(value, 13, value_length, &default_word, 7)) {
      out.code_model_kind = 0;
      return 1;
    }
    if (llvm_option_value_equals(value, 13, value_length, &small_word, 5)) {
      out.code_model_kind = 1;
      return 1;
    }
    if (llvm_option_value_equals(value, 13, value_length, &medium_word, 6)) {
      out.code_model_kind = 2;
      return 1;
    }
    if (llvm_option_value_equals(value, 13, value_length, &large_word, 5)) {
      out.code_model_kind = 3;
      return 1;
    }
    return -1;
  }

  i64 emit_prefix[7] = [45, 45, 101, 109, 105, 116, 61];

  if (llvm_option_prefix(value, length, &emit_prefix, 7)) {
    i64 ir[4] = [108, 108, 118, 109];
    i64 obj[3] = [111, 98, 106];
    i64 exe[3] = [101, 120, 101];
    i64 value_length = length - 7;

    if (llvm_option_value_equals(value, 7, value_length, &ir, 4)) {
      out.emit_kind = 0;
      return 1;
    }
    if (llvm_option_value_equals(value, 7, value_length, &obj, 3)) {
      out.emit_kind = 1;
      return 1;
    }
    if (llvm_option_value_equals(value, 7, value_length, &exe, 3)) {
      out.emit_kind = 2;
      return 1;
    }
    return -1;
  }
  return 0;
}

fn llvm_target_options_active(LlvmTargetOptions& options) -> bool {
  return (
  options.target_length > 0 ||
  options.data_layout_length > 0 ||
  options.cpu_length > 0 ||
  options.features_length > 0 ||
  options.runtime_length > 0 ||
  options.emit_kind != 0 ||
  options.optimization_kind >= 0 ||
  options.debug_info ||
  options.lto_kind >= 0 ||
  options.library_path_length > 0 ||
  options.libraries_length > 0 ||
  options.linker_length > 0 ||
  options.link_args_length > 0 ||
  options.relocation_kind >= 0 ||
  options.code_model_kind >= 0 ||
  options.visibility_kind >= 0 ||
  options.export_length > 0 ||
  options.import_length > 0 ||
  options.weak_length > 0 ||
  options.linkonce_length > 0
  );
}

fn llvm_target_options_require_llvm(LlvmTargetOptions& options) -> bool {
  // Optimization level is a backend-neutral compiler setting. Every other
  // option in this structure controls LLVM-specific target/link behavior.
  return (
  options.target_length > 0 ||
  options.data_layout_length > 0 ||
  options.cpu_length > 0 ||
  options.features_length > 0 ||
  options.runtime_length > 0 ||
  options.emit_kind != 0 ||
  options.debug_info ||
  options.lto_kind >= 0 ||
  options.library_path_length > 0 ||
  options.libraries_length > 0 ||
  options.linker_length > 0 ||
  options.link_args_length > 0 ||
  options.relocation_kind >= 0 ||
  options.code_model_kind >= 0 ||
  options.visibility_kind >= 0 ||
  options.export_length > 0 ||
  options.import_length > 0 ||
  options.weak_length > 0 ||
  options.linkonce_length > 0
  );
}

fn llvm_writer_arena_range(ForgeWriter&mut out, i64 data, i64 offset, i64 length) {
  i64 i = 0;

  while (i < length) {
    writer_put(out, raz_rt_stage1_arena_get(data, offset + i));
    i += 1;
  }
}

fn llvm_emit_target_metadata(ForgeWriter&mut out, LlvmTargetOptions& options) {
  if (options.data_layout_length > 0) {
    i64 prefix[21] = [116, 97, 114, 103, 101, 116, 32, 100, 97, 116, 97, 108, 97, 121, 111, 117, 116, 32, 61, 32, 34];

    llvm_chars(out, &prefix, 21);
    llvm_writer_arena_range(
    out,
    options.data_layout_arg,
    options.data_layout_offset,
    options.data_layout_length,
    );
    writer_put(out, 34);
    writer_newline(out);
  }
  if (options.target_length > 0) {
    i64 prefix[17] = [116, 97, 114, 103, 101, 116, 32, 116, 114, 105, 112, 108, 101, 32, 61, 32, 34];

    llvm_chars(out, &prefix, 17);
    llvm_writer_arena_range(out, options.target_arg, options.target_offset, options.target_length);
    writer_put(out, 34);
    writer_newline(out);
  }
  if (options.data_layout_length > 0 || options.target_length > 0) {
    writer_newline(out);
  }
}

fn llvm_make_ir_sidecar(i64 output_path, i64 output_length) -> i64 {
  i64 path = raz_rt_stage1_arena_create(output_length + 4);

  if (path == 0) {
    return 0;
  }
  if (raz_rt_stage1_arena_copy(path, 0, output_path, 0, output_length) != output_length) {
    raz_rt_stage1_arena_destroy(path);
    return 0;
  }
  raz_rt_stage1_arena_set(path, output_length, 46);
  raz_rt_stage1_arena_set(path, output_length + 1, 108);
  raz_rt_stage1_arena_set(path, output_length + 2, 108);
  return path;
}

fn llvm_command_quote_range(ForgeWriter&mut out, i64 data, i64 offset, i64 length) {
  writer_put(out, 34);
  llvm_writer_arena_range(out, data, offset, length);
  writer_put(out, 34);
}

fn llvm_command_feature_flags(ForgeWriter&mut command, LlvmTargetOptions& options) {
  i64 start = 0;
  i64 cursor = 0;

  while (cursor <= options.features_length) {
    bool end = cursor == options.features_length;
    bool separator = false;

    if (!end) {
      separator = raz_rt_stage1_arena_get(options.features_arg, options.features_offset + cursor) == 44;
    }
    if (end || separator) {
      i64 feature_length = cursor - start;

      if (feature_length > 0) {
        i64 prefix[34] = [32, 45, 88, 99, 108, 97, 110, 103, 32, 45, 116, 97, 114, 103, 101, 116, 45, 102, 101, 97, 116, 117, 114, 101, 32, 45, 88, 99, 108, 97, 110, 103, 32, 34];

        llvm_chars(command, &prefix, 34);
        llvm_writer_arena_range(
        command,
        options.features_arg,
        options.features_offset + start,
        feature_length,
        );
        writer_put(command, 34);
      }
      start = cursor + 1;
    }
    cursor += 1;
  }
}

fn llvm_command_comma_list(ForgeWriter&mut command, i64 data, i64 offset, i64 length, i64 prefix_kind) {
  i64 start = 0;
  i64 cursor = 0;

  while (cursor <= length) {
    bool end = cursor == length;
    bool separator = false;

    if (!end) {
      separator = raz_rt_stage1_arena_get(data, offset + cursor) == 44;
    }
    if (end || separator) {
      i64 item_length = cursor - start;

      if (item_length > 0) {
        if (prefix_kind == 1) {
          i64 p[3] = [32, 45, 76];

          llvm_chars(command, &p, 3);
        } else if (prefix_kind == 2) {
          i64 p[3] = [32, 45, 108];

          llvm_chars(command, &p, 3);
        } else {
          writer_space(command);
        }
        llvm_command_quote_range(command, data, offset + start, item_length);
      }
      start = cursor + 1;
    }
    cursor += 1;
  }
}

fn llvm_command_optimization(ForgeWriter&mut command, LlvmTargetOptions& options) {
  if (options.optimization_kind == 0) {
    i64 flag[4] = [32, 45, 79, 48];

    llvm_chars(command, &flag, 4);
  } else if (options.optimization_kind == 1) {
    i64 flag[4] = [32, 45, 79, 49];

    llvm_chars(command, &flag, 4);
  } else if (options.optimization_kind == 2) {
    i64 flag[4] = [32, 45, 79, 50];

    llvm_chars(command, &flag, 4);
  } else if (options.optimization_kind == 3) {
    i64 flag[4] = [32, 45, 79, 51];

    llvm_chars(command, &flag, 4);
  } else if (options.optimization_kind == 4) {
    i64 flag[4] = [32, 45, 79, 115];

    llvm_chars(command, &flag, 4);
  } else if (options.optimization_kind == 5) {
    i64 flag[4] = [32, 45, 79, 122];

    llvm_chars(command, &flag, 4);
  }
}

fn llvm_finalize_native_output(
LlvmTargetOptions& options,
i64 ir_path,
i64 ir_length,
i64 output_path,
i64 output_length,
) -> bool {
  ForgeWriter command;

  writer_init(&mut command);
  if (options.emit_kind == 2) {
    // The Raz runtime is a C++ archive. Use the C++ driver for final links
    // so its standard-library dependencies are resolved portably.

    i64 clangxx_word[7] = [99, 108, 97, 110, 103, 43, 43];

    llvm_chars(&mut command, &clangxx_word, 7);
  } else {
    i64 clang_word[5] = [99, 108, 97, 110, 103];

    llvm_chars(&mut command, &clang_word, 5);
  }
  llvm_command_optimization(&mut command, options);
  // Clang assigns the selected driver target when lowering textual IR. Raz's
  // IR may intentionally omit a triple for host compilation, so suppress the
  // driver's benign module-retarget warning.

  i64 host_target_warning[21] = [32, 45, 87, 110, 111, 45, 111, 118, 101, 114, 114, 105, 100, 101, 45, 109, 111, 100, 117, 108, 101];

  llvm_chars(&mut command, &host_target_warning, 21);
  if (options.debug_info) {
    i64 debug_flag[3] = [32, 45, 103];

    llvm_chars(&mut command, &debug_flag, 3);
  }
  if (options.relocation_kind == 1) {
    i64 flag[9] = [32, 45, 102, 110, 111, 45, 112, 105, 99];

    llvm_chars(&mut command, &flag, 9);
  } else if (options.relocation_kind == 2) {
    i64 flag[6] = [32, 45, 102, 80, 73, 67];

    llvm_chars(&mut command, &flag, 6);
  }
  if (options.code_model_kind == 1) {
    i64 flag[15] = [32, 45, 109, 99, 109, 111, 100, 101, 108, 61, 115, 109, 97, 108, 108];

    llvm_chars(&mut command, &flag, 15);
  } else if (options.code_model_kind == 2) {
    i64 flag[16] = [32, 45, 109, 99, 109, 111, 100, 101, 108, 61, 109, 101, 100, 105, 117, 109];

    llvm_chars(&mut command, &flag, 16);
  } else if (options.code_model_kind == 3) {
    i64 flag[15] = [32, 45, 109, 99, 109, 111, 100, 101, 108, 61, 108, 97, 114, 103, 101];

    llvm_chars(&mut command, &flag, 15);
  }
  if (options.lto_kind == 1) {
    i64 thin_lto[10] = [32, 45, 102, 108, 116, 111, 61, 116, 104, 105];

    llvm_chars(&mut command, &thin_lto, 10);
    writer_put(&mut command, 110);
  } else if (options.lto_kind == 2) {
    i64 full_lto[6] = [32, 45, 102, 108, 116, 111];

    llvm_chars(&mut command, &full_lto, 6);
  }
  if (options.linker_length > 0) {
    i64 linker_flag[7] = [32, 45, 102, 117, 115, 101, 45];

    llvm_chars(&mut command, &linker_flag, 7);

    i64 lld_eq[4] = [108, 100, 61, 34];

    llvm_chars(&mut command, &lld_eq, 4);
    llvm_writer_arena_range(
    &mut command,
    options.linker_arg,
    options.linker_offset,
    options.linker_length,
    );
    writer_put(&mut command, 34);
  }
  if (options.target_length > 0) {
    i64 prefix[10] = [32, 45, 45, 116, 97, 114, 103, 101, 116, 61];

    llvm_chars(&mut command, &prefix, 10);
    llvm_writer_arena_range(
    &mut command,
    options.target_arg,
    options.target_offset,
    options.target_length,
    );
  }
  if (options.cpu_length > 0) {
    i64 prefix[30] = [32, 45, 88, 99, 108, 97, 110, 103, 32, 45, 116, 97, 114, 103, 101, 116, 45, 99, 112, 117, 32, 45, 88, 99, 108, 97, 110, 103, 32, 34];

    llvm_chars(&mut command, &prefix, 30);
    llvm_writer_arena_range(&mut command, options.cpu_arg, options.cpu_offset, options.cpu_length);
    writer_put(&mut command, 34);
  }
  if (options.features_length > 0) {
    llvm_command_feature_flags(&mut command, options);
  }
  if (options.emit_kind == 1) {
    i64 compile[11] = [32, 45, 99, 32, 45, 120, 32, 105, 114, 32, 32];

    llvm_chars(&mut command, &compile, 11);
  } else {
    i64 input_kind[7] = [32, 45, 120, 32, 105, 114, 32];

    llvm_chars(&mut command, &input_kind, 7);
  }
  llvm_command_quote_range(&mut command, ir_path, 0, ir_length);
  if (options.emit_kind == 2 && options.runtime_length > 0) {
    // `-x ir` is sticky in Clang. Reset it immediately before a runtime
    // archive/object so the following native input is not parsed as IR.

    i64 reset_language[8] = [32, 45, 120, 32, 110, 111, 110, 101];

    llvm_chars(&mut command, &reset_language, 8);
    writer_space(&mut command);
    llvm_command_quote_range(
    &mut command,
    options.runtime_arg,
    options.runtime_offset,
    options.runtime_length,
    );
  }
  if (options.emit_kind == 2 && options.library_path_length > 0) {
    llvm_command_comma_list(
    &mut command,
    options.library_path_arg,
    options.library_path_offset,
    options.library_path_length,
    1,
    );
  }
  if (options.emit_kind == 2 && options.libraries_length > 0) {
    llvm_command_comma_list(
    &mut command,
    options.libraries_arg,
    options.libraries_offset,
    options.libraries_length,
    2,
    );
  }
  if (options.emit_kind == 2 && options.link_args_length > 0) {
    llvm_command_comma_list(
    &mut command,
    options.link_args_arg,
    options.link_args_offset,
    options.link_args_length,
    0,
    );
  }

  i64 output_flag[4] = [32, 45, 111, 32];

  llvm_chars(&mut command, &output_flag, 4);
  llvm_command_quote_range(&mut command, output_path, 0, output_length);
  if (command.failed) {
    writer_destroy(&mut command);
    return false;
  }

  i64 status = raz_rt_stage1_process_run_ascii(command.data, command.length);

  writer_destroy(&mut command);
  return status == 0;
}
