    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_dir_close_body(ForgeWriter&mut section, Source& source, HirModule& hir) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 10);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 26);

    i64 dealloc_name[14] = [114, 97, 122, 95, 114, 116, 95, 100, 101, 97, 108, 108, 111, 99];
    i64 dealloc_function = wasm_wasi_find_named_function(source, hir, &dealloc_name, 14);

    if (dealloc_function >= 0) {
        wasm_local_get(&mut body, 0);
        wasm_u8(&mut body, 16);
        wasm_u32(&mut body, wasm_wasi_defined_function(dealloc_function));
    }
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_runtime_body(
    ForgeWriter&mut section,
    Source& source,
    HirModule& hir,
    i64 function_index,
) -> bool {
    if (wasm_wasi_stdio_write(source, hir, function_index)) {
        return wasm_wasi_emit_stdio_body(section, false);
    }
    if (wasm_wasi_stdio_read(source, hir, function_index)) {
        return wasm_wasi_emit_stdio_body(section, true);
    }
    if (wasm_wasi_stdio_flush(source, hir, function_index)) {
        return wasm_wasi_emit_constant_i64_body(section, 1);
    }
    if (wasm_wasi_stdio_is_terminal(source, hir, function_index)) {
        // Preview1 has no portable isatty primitive. Keep the stdlib contract
        // conservative; hosts can still provide terminal policy above WASI.
        return wasm_wasi_emit_constant_i64_body(section, 0);
    }
    if (wasm_wasi_stdio_set_binary(source, hir, function_index)) {
        // WASI streams are already byte-oriented, so binary mode is a no-op.
        return wasm_wasi_emit_constant_i64_body(section, 1);
    }
    if (wasm_wasi_process_argc(source, hir, function_index)) {
        return wasm_wasi_emit_process_argc_body(section);
    }
    if (wasm_wasi_process_arg(source, hir, function_index)) {
        return wasm_wasi_emit_process_arg_body(section);
    }
    if (wasm_wasi_env_get(source, hir, function_index)) {
        return wasm_wasi_emit_env_get_body(section);
    }
    if (wasm_wasi_last_error_code(source, hir, function_index)) {
        return wasm_wasi_emit_last_error_body(section);
    }
    if (wasm_wasi_env_set(source, hir, function_index) || wasm_wasi_env_remove(source, hir, function_index)) {
        return wasm_wasi_emit_unsupported_i64_body(section, 0);
    }
    if (wasm_wasi_process_id(source, hir, function_index)) {
        return wasm_wasi_emit_unsupported_i64_body(section, 0);
    }
    if (
        wasm_wasi_process_run(source, hir, function_index) ||
        wasm_wasi_process_run_argv(source, hir, function_index)
    ) {
        return wasm_wasi_emit_unsupported_i64_body(section, -1);
    }
    if (wasm_wasi_file_open(source, hir, function_index)) {
        return wasm_wasi_emit_file_open_body(section);
    }
    if (wasm_wasi_file_read(source, hir, function_index)) {
        return wasm_wasi_emit_stdio_body(section, true);
    }
    if (wasm_wasi_file_write(source, hir, function_index)) {
        return wasm_wasi_emit_stdio_body(section, false);
    }
    if (wasm_wasi_file_close(source, hir, function_index)) {
        return wasm_wasi_emit_file_close_body(section);
    }
    if (wasm_wasi_file_seek(source, hir, function_index)) {
        return wasm_wasi_emit_file_seek_body(section);
    }
    if (wasm_wasi_file_tell(source, hir, function_index)) {
        return wasm_wasi_emit_file_tell_body(section);
    }
    if (wasm_wasi_file_flush(source, hir, function_index)) {
        return wasm_wasi_emit_file_flush_body(section);
    }
    if (wasm_wasi_file_eof(source, hir, function_index)) {
        return wasm_wasi_emit_file_eof_body(section);
    }
    if (wasm_wasi_file_size(source, hir, function_index)) {
        return wasm_wasi_emit_path_filestat_body(section, 0);
    }
    if (wasm_wasi_path_is_file(source, hir, function_index)) {
        return wasm_wasi_emit_path_filestat_body(section, 1);
    }
    if (wasm_wasi_path_is_dir(source, hir, function_index)) {
        return wasm_wasi_emit_path_filestat_body(section, 2);
    }
    if (wasm_wasi_path_exists(source, hir, function_index)) {
        return wasm_wasi_emit_path_exists_body(section);
    }
    if (wasm_wasi_time_unix_millis(source, hir, function_index)) {
        return wasm_wasi_emit_clock_body(section, true);
    }
    if (wasm_wasi_time_monotonic_nanos(source, hir, function_index)) {
        return wasm_wasi_emit_clock_body(section, false);
    }
    if (wasm_wasi_random_fill(source, hir, function_index)) {
        return wasm_wasi_emit_random_fill_body(section);
    }
    if (wasm_wasi_random_seed(source, hir, function_index)) {
        return wasm_wasi_emit_random_seed_body(section);
    }
    if (wasm_wasi_sleep_millis(source, hir, function_index)) {
        return wasm_wasi_emit_sleep_millis_body(section);
    }
    if (wasm_wasi_current_dir(source, hir, function_index)) {
        return wasm_wasi_emit_current_dir_body(section);
    }
    if (wasm_wasi_dir_open(source, hir, function_index)) {
        return wasm_wasi_emit_dir_open_body(section, source, hir);
    }
    if (wasm_wasi_dir_next(source, hir, function_index)) {
        return wasm_wasi_emit_dir_next_body(section);
    }
    if (wasm_wasi_dir_close(source, hir, function_index)) {
