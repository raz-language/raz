    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 249);
    wasm_u8(&mut body, 45);
    wasm_u32(&mut body, 0);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 46);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 113);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 11);
