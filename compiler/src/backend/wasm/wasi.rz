    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 40);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
