fn wasm_wasi_main_function(Source& source, HirModule& hir) -> i64 {
    i64 name[4] = [109, 97, 105, 110];
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0 &&
            raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index) == 0 &&
            wasm_wasi_name_is(source, hir, function_index, &name, 4)
        ) {
            return function_index;
        }
        function_index += 1;
    }
    return -1;
}

fn wasm_wasi_start_count(Source& source, HirModule& hir) -> i64 {
    if (wasm_wasi_main_function(source, hir) >= 0) {
        return 1;
    }
    return 0;
}

