fn wasm_wasi_emit_copy_file_body(ForgeWriter&mut section, Source& source, HirModule& hir) -> bool {
    i64 open_name[16] = [114, 97, 122, 95, 114, 116, 95, 102, 105, 108, 101, 95, 111, 112, 101, 110];
    i64 read_name[16] = [114, 97, 122, 95, 114, 116, 95, 102, 105, 108, 101, 95, 114, 101, 97, 100];
    i64 write_name[17] = [114, 97, 122, 95, 114, 116, 95, 102, 105, 108, 101, 95, 119, 114, 105, 116, 101];
    i64 close_name[17] = [114, 97, 122, 95, 114, 116, 95, 102, 105, 108, 101, 95, 99, 108, 111, 115, 101];
    i64 exists_name[18] = [114, 97, 122, 95, 114, 116, 95, 112, 97, 116, 104, 95, 101, 120, 105, 115, 116, 115];
    i64 open_function = wasm_wasi_find_named_function(source, hir, &open_name, 16);
    i64 read_function = wasm_wasi_find_named_function(source, hir, &read_name, 16);
    i64 write_function = wasm_wasi_find_named_function(source, hir, &write_name, 17);
    i64 close_function = wasm_wasi_find_named_function(source, hir, &close_name, 17);
    i64 exists_function = wasm_wasi_find_named_function(source, hir, &exists_name, 18);

    if (
        open_function < 0 ||
        read_function < 0 ||
        write_function < 0 ||
        close_function < 0 ||
        exists_function < 0
    ) {
        return false;
    }

    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    // locals 5..10: source fd, destination fd, read count, written count,
    // write chunk, final status. Copy payload uses reserved WASI scratch 320..479.
    wasm_u32(&mut body, 1);
    wasm_u32(&mut body, 6);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_local_set(&mut body, 5);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_local_set(&mut body, 6);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 1);
    wasm_local_set(&mut body, 10);
    // One exit block guarantees both descriptors are closed on every path.
    wasm_u8(&mut body, 2);
    wasm_u8(&mut body, 64);
    // If overwrite is disabled, an existing destination is a clean false result.
    wasm_local_get(&mut body, 4);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 2);
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(exists_function));
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 81);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_local_set(&mut body, 10);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 2);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    // source = file_open(from, read).
    wasm_local_get(&mut body, 0);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(open_function));
    wasm_local_set(&mut body, 5);
    wasm_local_get(&mut body, 5);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_local_set(&mut body, 10);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 11);
    // destination = file_open(to, write|create|truncate).
    wasm_local_get(&mut body, 2);
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 26);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(open_function));
    wasm_local_set(&mut body, 6);
    wasm_local_get(&mut body, 6);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_local_set(&mut body, 10);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 11);
    // Chunked streaming copy.
    wasm_u8(&mut body, 3);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 5);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 320);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 160);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(read_function));
    wasm_local_set(&mut body, 7);
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 83);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_local_set(&mut body, 10);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 2);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 13);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_local_set(&mut body, 8);
    wasm_u8(&mut body, 3);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 8);
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 89);
    wasm_u8(&mut body, 13);
    wasm_u32(&mut body, 1);
    wasm_local_get(&mut body, 6);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 320);
    wasm_local_get(&mut body, 8);
    wasm_u8(&mut body, 124);
    wasm_local_get(&mut body, 7);
    wasm_local_get(&mut body, 8);
    wasm_u8(&mut body, 125);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(write_function));
    wasm_local_set(&mut body, 9);
    wasm_local_get(&mut body, 9);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 87);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_local_set(&mut body, 10);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 3);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 8);
    wasm_local_get(&mut body, 9);
    wasm_u8(&mut body, 124);
    wasm_local_set(&mut body, 8);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    // Close destination/source if they were opened.
    wasm_local_get(&mut body, 6);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 6);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(close_function));
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 5);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 5);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(close_function));
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 10);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_dir_open_body(ForgeWriter&mut section, Source& source, HirModule& hir) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    // local 2 = preopen fd (i32), local 3 = iterator-state pointer (i64).
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 127);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 126);
    wasm_wasi_emit_resolve_preopen(&mut body, 0, 1, 2, false);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // path_open(root, 0, path, len, OFLAGS_DIRECTORY=2,
    // rights=FD_READDIR|PATH_FILESTAT_GET, inheriting=0, fdflags=0, &fd@40).
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 2);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 278528);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 40);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 9);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);

    i64 alloc_name[12] = [114, 97, 122, 95, 114, 116, 95, 97, 108, 108, 111, 99];
    i64 alloc_function = wasm_wasi_find_named_function(source, hir, &alloc_name, 12);

    if (alloc_function >= 0) {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, 16);
        wasm_u8(&mut body, 16);
        wasm_u32(&mut body, wasm_wasi_defined_function(alloc_function));
        wasm_local_set(&mut body, 3);
    } else {
        // Minimal fallback for freestanding programs that did not link alloc.
        wasm_u8(&mut body, 35);
        wasm_u32(&mut body, 0);
        wasm_u8(&mut body, 173);
        wasm_local_set(&mut body, 3);
        wasm_u8(&mut body, 35);
        wasm_u32(&mut body, 0);
        wasm_u8(&mut body, 65);
        wasm_i64(&mut body, 16);
        wasm_u8(&mut body, 106);
        wasm_u8(&mut body, 36);
        wasm_u32(&mut body, 0);
        wasm_memory_emit_ensure_capacity(&mut body);
    }
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    // Allocation failed: close the directory descriptor and return 0.
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 40);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 10);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 26);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // state.fd = opened descriptor; state.cookie = 0.
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 167);
    wasm_wasi_emit_i32_load(&mut body, 40);
    wasm_u8(&mut body, 54);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 55);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 8);
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_dir_next_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    // i32 locals 5..9: fd, used, name_len, filetype, errno.
    // i64 locals 10..14: work_cookie, next_cookie, kind, size, modified_ms.
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 5);
    wasm_u8(&mut body, 127);
    wasm_u32(&mut body, 5);
    wasm_u8(&mut body, 126);
    // Validate handle, metadata pointer and six-slot metadata capacity.
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -2);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -2);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 4);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 6);
    wasm_u8(&mut body, 83);
    // i64.lt_s
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -2);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // Load fd and current cookie from iterator state.
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_local_set(&mut body, 5);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 8);
    wasm_local_set(&mut body, 10);
    // Skip dot entries without consuming the externally visible iterator cookie.
    wasm_u8(&mut body, 2);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 3);
    wasm_u8(&mut body, 64);
    // fd_readdir(fd, scratch@224, 288, cookie, &used@216)
    wasm_local_get(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 224);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 288);
    wasm_local_get(&mut body, 10);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 216);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 19);
    wasm_wasi_capture_errno(&mut body);
    wasm_local_set(&mut body, 9);
    wasm_local_get(&mut body, 9);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -2);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_wasi_emit_i32_load(&mut body, 216);
    wasm_local_set(&mut body, 6);
    wasm_local_get(&mut body, 6);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // Parse first __wasi_dirent_t: d_next@0, d_namlen@16, d_type@20, name@24.
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 224);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_local_set(&mut body, 11);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 240);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_local_set(&mut body, 7);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 244);
    wasm_u8(&mut body, 45);
    wasm_u32(&mut body, 0);
    wasm_u32(&mut body, 0);
    wasm_local_set(&mut body, 8);
    // Reject a truncated dirent rather than exposing partial UTF-8 names.
    wasm_local_get(&mut body, 6);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 24);
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 106);
    wasm_u8(&mut body, 73);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -2);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // Skip ".".
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 248);
    wasm_u8(&mut body, 45);
