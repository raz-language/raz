namespace raz_compiler_backend_wasm_wasi;

public import raz_compiler_backend_wasm_cfg;
public import raz_compiler_backend_wasm_memory;

// WASI preview1 is kept behind Raz's permanent runtime boundary.  User code
// continues to call std::io; the wasm backend synthesizes these tiny adapters.
fn wasm_wasi_import_count() -> i64 {
    return wasm_host_import_count();
}

fn wasm_wasi_defined_function(i64 function_index) -> i64 {
    return wasm_wasi_import_count() + function_index;
}

fn wasm_wasi_name_is(Source& source, HirModule& hir, i64 function_index, i64[]name, i64 length) -> bool {
    if (raz_compiler_rt_arena_get(hir.function_name_lengths, function_index) != length) {
        return false;
    }

    i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
    i64 i = 0;

    while (i < length) {
        if (source_byte(source, offset + i) != name[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn wasm_wasi_last_error_global() -> i64 {
    // Internal wasm global 1 is reserved by globals.rz for WASI errno.
    return 1;
}

fn wasm_wasi_capture_errno(ForgeWriter&mut body) {
    // Preserve the host errno and leave it on the operand stack so existing
    // success/failure tests keep their original shape.
    wasm_u8(body, 36);
    wasm_u32(body, wasm_wasi_last_error_global());
    wasm_u8(body, 35);
    wasm_u32(body, wasm_wasi_last_error_global());
}

fn wasm_wasi_set_last_error(ForgeWriter&mut body, i64 code) {
    wasm_u8(body, 65);
    wasm_i64(body, code);
    wasm_u8(body, 36);
    wasm_u32(body, wasm_wasi_last_error_global());
}

fn wasm_wasi_last_error_code(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 name[22] = [114, 97, 122, 95, 114, 116, 95, 108, 97, 115, 116, 95, 101, 114, 114, 111, 114, 95, 99, 111, 100, 101];

    return wasm_wasi_name_is(source, hir, function_index, &name, 22);
}

