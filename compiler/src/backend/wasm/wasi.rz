    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 7);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_random_seed_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 8);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 7);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
