    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 11);
    wasm_local_set(&mut body, 10);
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 2);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    // Skip "..".
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 2);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 248);
    wasm_u8(&mut body, 45);
    wasm_u32(&mut body, 0);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
