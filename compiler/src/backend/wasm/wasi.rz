    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 2);
    wasm_local_set(&mut body, 12);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 8);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 7);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 3);
    wasm_local_set(&mut body, 12);
