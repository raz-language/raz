fn wasm_wasi_find_named_function(Source& source, HirModule& hir, i64[]name, i64 length) -> i64 {
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (wasm_wasi_name_is(source, hir, function_index, name, length)) {
            return function_index;
        }
        function_index += 1;
    }
    return -1;
}

fn wasm_wasi_runtime_function_supported(Source& source, HirModule& hir, i64 function_index) -> bool {
    return (
        wasm_wasi_stdio_read(source, hir, function_index) ||
        wasm_wasi_stdio_write(source, hir, function_index) ||
        wasm_wasi_stdio_flush(source, hir, function_index) ||
        wasm_wasi_stdio_is_terminal(source, hir, function_index) ||
        wasm_wasi_stdio_set_binary(source, hir, function_index) ||
        wasm_wasi_process_argc(source, hir, function_index) ||
        wasm_wasi_process_arg(source, hir, function_index) ||
        wasm_wasi_process_id(source, hir, function_index) ||
        wasm_wasi_process_run(source, hir, function_index) ||
        wasm_wasi_process_run_argv(source, hir, function_index) ||
        wasm_wasi_env_get(source, hir, function_index) ||
        wasm_wasi_env_set(source, hir, function_index) ||
        wasm_wasi_env_remove(source, hir, function_index) ||
        wasm_wasi_last_error_code(source, hir, function_index) ||
        wasm_wasi_file_open(source, hir, function_index) ||
        wasm_wasi_file_read(source, hir, function_index) ||
        wasm_wasi_file_write(source, hir, function_index) ||
        wasm_wasi_file_close(source, hir, function_index) ||
        wasm_wasi_file_seek(source, hir, function_index) ||
        wasm_wasi_file_tell(source, hir, function_index) ||
        wasm_wasi_file_flush(source, hir, function_index) ||
        wasm_wasi_file_eof(source, hir, function_index) ||
        wasm_wasi_file_size(source, hir, function_index) ||
        wasm_wasi_path_exists(source, hir, function_index) ||
        wasm_wasi_path_is_file(source, hir, function_index) ||
        wasm_wasi_path_is_dir(source, hir, function_index) ||
        wasm_wasi_time_unix_millis(source, hir, function_index) ||
        wasm_wasi_time_monotonic_nanos(source, hir, function_index) ||
        wasm_wasi_random_fill(source, hir, function_index) ||
        wasm_wasi_random_seed(source, hir, function_index) ||
        wasm_wasi_sleep_millis(source, hir, function_index) ||
        wasm_wasi_current_dir(source, hir, function_index) ||
        wasm_wasi_dir_open(source, hir, function_index) ||
        wasm_wasi_dir_next(source, hir, function_index) ||
        wasm_wasi_dir_close(source, hir, function_index) ||
        wasm_wasi_fs_metadata(source, hir, function_index) ||
        wasm_wasi_create_dir_one(source, hir, function_index) ||
        wasm_wasi_remove_one(source, hir, function_index) ||
        wasm_wasi_rename_path(source, hir, function_index) ||
        wasm_wasi_copy_file(source, hir, function_index)
    );
}

fn wasm_wasi_emit_import(
    ForgeWriter&mut section,
    i64[]module_name,
    i64 module_length,
    i64[]name,
    i64 name_length,
    i64 type_index,
) {
    wasm_name(section, module_name, module_length);
    wasm_name(section, name, name_length);
    wasm_u8(section, 0);
    wasm_u32(section, type_index);
}

fn wasm_wasi_emit_import_section(ForgeWriter&mut module, HirModule& hir) -> bool {
    ForgeWriter section;

    writer_init(&mut section);
    if (section.failed) {
        return false;
    }
    wasm_u32(&mut section, wasm_wasi_import_count());

    i64 module_name[22] = [119, 97, 115, 105, 95, 115, 110, 97, 112, 115, 104, 111, 116, 95, 112, 114, 101, 118, 105, 101, 119, 49];
    i64 fd_write[8] = [102, 100, 95, 119, 114, 105, 116, 101];
    i64 fd_read[7] = [102, 100, 95, 114, 101, 97, 100];
    i64 args_sizes_get[14] = [97, 114, 103, 115, 95, 115, 105, 122, 101, 115, 95, 103, 101, 116];
    i64 args_get[8] = [97, 114, 103, 115, 95, 103, 101, 116];
    i64 environ_sizes_get[17] = [101, 110, 118, 105, 114, 111, 110, 95, 115, 105, 122, 101, 115, 95, 103, 101, 116];
    i64 environ_get[11] = [101, 110, 118, 105, 114, 111, 110, 95, 103, 101, 116];
    i64 clock_time_get[14] = [99, 108, 111, 99, 107, 95, 116, 105, 109, 101, 95, 103, 101, 116];
    i64 random_get[10] = [114, 97, 110, 100, 111, 109, 95, 103, 101, 116];
    i64 proc_exit[9] = [112, 114, 111, 99, 95, 101, 120, 105, 116];
    i64 path_open[9] = [112, 97, 116, 104, 95, 111, 112, 101, 110];
    i64 fd_close[8] = [102, 100, 95, 99, 108, 111, 115, 101];
    i64 path_filestat_get[17] = [112, 97, 116, 104, 95, 102, 105, 108, 101, 115, 116, 97, 116, 95, 103, 101, 116];
    i64 fd_seek[7] = [102, 100, 95, 115, 101, 101, 107];
    i64 fd_tell[7] = [102, 100, 95, 116, 101, 108, 108];
    i64 fd_sync[7] = [102, 100, 95, 115, 121, 110, 99];
    i64 fd_filestat_get[15] = [102, 100, 95, 102, 105, 108, 101, 115, 116, 97, 116, 95, 103, 101, 116];
    i64 poll_oneoff[11] = [112, 111, 108, 108, 95, 111, 110, 101, 111, 102, 102];
    i64 fd_prestat_get[14] = [102, 100, 95, 112, 114, 101, 115, 116, 97, 116, 95, 103, 101, 116];
    i64 fd_prestat_dir_name[19] = [102, 100, 95, 112, 114, 101, 115, 116, 97, 116, 95, 100, 105, 114, 95, 110, 97, 109, 101];
    i64 fd_readdir[10] = [102, 100, 95, 114, 101, 97, 100, 100, 105, 114];
    i64 path_create_directory[21] = [112, 97, 116, 104, 95, 99, 114, 101, 97, 116, 101, 95, 100, 105, 114, 101, 99, 116, 111, 114, 121];
    i64 path_unlink_file[16] = [112, 97, 116, 104, 95, 117, 110, 108, 105, 110, 107, 95, 102, 105, 108, 101];
    i64 path_remove_directory[21] = [112, 97, 116, 104, 95, 114, 101, 109, 111, 118, 101, 95, 100, 105, 114, 101, 99, 116, 111, 114, 121];
    i64 path_rename[11] = [112, 97, 116, 104, 95, 114, 101, 110, 97, 109, 101];
    i64 base = hir.function_count + hir.function_type_count * 2;

    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_write, 8, base);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_read, 7, base);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &args_sizes_get, 14, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &args_get, 8, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &environ_sizes_get, 17, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &environ_get, 11, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &clock_time_get, 14, base + 2);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &random_get, 10, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &proc_exit, 9, base + 3);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &path_open, 9, base + 4);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_close, 8, base + 5);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &path_filestat_get, 17, base + 6);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_seek, 7, base + 8);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_tell, 7, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_sync, 7, base + 5);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_filestat_get, 15, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &poll_oneoff, 11, base);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_prestat_get, 14, base + 1);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_prestat_dir_name, 19, base + 9);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &fd_readdir, 10, base + 10);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &path_create_directory, 21, base + 9);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &path_unlink_file, 16, base + 9);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &path_remove_directory, 21, base + 9);
    wasm_wasi_emit_import(&mut section, &module_name, 22, &path_rename, 11, base + 11);
    wasm_section(module, 2, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn wasm_wasi_emit_i32_store(ForgeWriter&mut body, i64 address, i64 local_index) {
    wasm_u8(body, 65);
    wasm_i64(body, address);
    wasm_local_get(body, local_index);
    wasm_u8(body, 167);
    wasm_u8(body, 54);
    wasm_u32(body, 2);
    wasm_u32(body, 0);
}

fn wasm_wasi_emit_stdio_body(ForgeWriter&mut section, bool read) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    // Reserved linear-memory scratch:
    // 16..23 = wasi iovec, 24..27 = bytes read/written.
    wasm_wasi_emit_i32_store(&mut body, 16, 1);
    wasm_wasi_emit_i32_store(&mut body, 20, 2);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 16);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 24);
    wasm_u8(&mut body, 16);
    if (read) {
        wasm_u32(&mut body, 1);
    } else {
        wasm_u32(&mut body, 0);
    }
    wasm_wasi_capture_errno(&mut body);
    // errno != 0 -> return -1.
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 24);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_constant_i64_body(ForgeWriter&mut section, i64 value) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, value);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_last_error_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 35);
    wasm_u32(&mut body, wasm_wasi_last_error_global());
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_unsupported_i64_body(ForgeWriter&mut section, i64 value) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    // WASI preview1 has no environment mutation or child-process spawn API.
    // Preserve Raz's fallible boundary contracts and expose ENOTSUP through
    // std::io::last_error instead of silently succeeding.
    wasm_wasi_set_last_error(&mut body, 58);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, value);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_process_argc_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 36);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 2);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_clock_body(ForgeWriter&mut section, bool realtime) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    if (realtime) {
        wasm_i64(&mut body, 0);
    } else {
        wasm_i64(&mut body, 1);
    }
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 6);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    if (realtime) {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, 1000000);
        wasm_u8(&mut body, 127);
    }
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_random_fill_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
