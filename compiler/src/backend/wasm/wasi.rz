fn wasm_wasi_emit_file_eof_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    // fd_tell(fd, &offset@40)
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 40);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 13);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 5);
    // fd_filestat_get(fd, &stat@64)
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 64);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 15);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 40);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 96);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 81);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_path_filestat_body(ForgeWriter&mut section, i64 mode) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 1);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 127);
    wasm_wasi_emit_resolve_preopen(&mut body, 0, 1, 2, false);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    if (mode == 0) {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, -1);
    } else {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, 0);
    }
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 64);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 11);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    if (mode == 0) {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, -1);
    } else {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, 0);
    }
    wasm_u8(&mut body, 5);
    if (mode == 0) {
        // __wasi_filestat_t.filesize is the u64 at byte offset 32.
        wasm_u8(&mut body, 65);
        wasm_i64(&mut body, 96);
        wasm_u8(&mut body, 41);
        wasm_u32(&mut body, 3);
        wasm_u32(&mut body, 0);
    } else {
        // __wasi_filestat_t.filetype is the byte at offset 16: directory=3, regular_file=4.
        wasm_u8(&mut body, 65);
        wasm_i64(&mut body, 80);
        wasm_u8(&mut body, 45);
        wasm_u32(&mut body, 0);
        wasm_u32(&mut body, 0);
        wasm_u8(&mut body, 65);
        if (mode == 1) {
            wasm_i64(&mut body, 4);
        } else {
            wasm_i64(&mut body, 3);
        }
        wasm_u8(&mut body, 70);
        wasm_u8(&mut body, 173);
    }
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_path_exists_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 1);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 127);
    wasm_wasi_emit_resolve_preopen(&mut body, 0, 1, 2, false);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 64);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 11);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_start_body(ForgeWriter&mut section, Source& source, HirModule& hir) -> bool {
    i64 main_function = wasm_wasi_main_function(source, hir);

    if (main_function < 0) {
        return false;
    }

    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, wasm_wasi_defined_function(main_function));
    if (raz_compiler_rt_arena_get(hir.function_returns_value, main_function) != 0) {
        wasm_u8(&mut body, 167);
    } else {
        wasm_u8(&mut body, 65);
        wasm_i64(&mut body, 0);
    }
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 8);
    wasm_u8(&mut body, 0);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

public fn wasm_wasi_emit_poll_delay(ForgeWriter&mut body, i64 milliseconds) {
    // One monotonic relative timer subscription. This is also used by the
    // generated async command executor to yield to the WASI host between polls.
    wasm_u8(body, 65);
    wasm_i64(body, 128);
    wasm_u8(body, 66);
    wasm_i64(body, 0);
    wasm_u8(body, 55);
    wasm_u32(body, 3);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 136);
    wasm_u8(body, 65);
    wasm_i64(body, 0);
    wasm_u8(body, 58);
    wasm_u32(body, 0);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 144);
    wasm_u8(body, 65);
    wasm_i64(body, 1);
    wasm_u8(body, 54);
    wasm_u32(body, 2);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 152);
    wasm_u8(body, 66);
    wasm_i64(body, milliseconds * 1000000);
    wasm_u8(body, 55);
    wasm_u32(body, 3);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 160);
    wasm_u8(body, 66);
    wasm_i64(body, 0);
    wasm_u8(body, 55);
    wasm_u32(body, 3);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 168);
    wasm_u8(body, 65);
    wasm_i64(body, 0);
    wasm_u8(body, 59);
    wasm_u32(body, 1);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 128);
    wasm_u8(body, 65);
    wasm_i64(body, 176);
    wasm_u8(body, 65);
    wasm_i64(body, 1);
    wasm_u8(body, 65);
    wasm_i64(body, 208);
    wasm_u8(body, 16);
    wasm_u32(body, 16);
    wasm_wasi_capture_errno(body);
    wasm_u8(body, 26);
}

public fn wasm_wasi_emit_poll_delay_local(ForgeWriter&mut body, i64 milliseconds_local) {
    // Dynamic variant used by the WASM future kernel. The subscription layout
    // is identical to wasm_wasi_emit_poll_delay; only the timeout is local.
    wasm_u8(body, 65);
    wasm_i64(body, 128);
    wasm_u8(body, 66);
    wasm_i64(body, 0);
    wasm_u8(body, 55);
    wasm_u32(body, 3);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 136);
    wasm_u8(body, 65);
    wasm_i64(body, 0);
    wasm_u8(body, 58);
    wasm_u32(body, 0);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 144);
    wasm_u8(body, 65);
    wasm_i64(body, 1);
    wasm_u8(body, 54);
    wasm_u32(body, 2);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 152);
    wasm_local_get(body, milliseconds_local);
    wasm_u8(body, 66);
    wasm_i64(body, 1000000);
    wasm_u8(body, 126);
    wasm_u8(body, 55);
    wasm_u32(body, 3);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 160);
    wasm_u8(body, 66);
    wasm_i64(body, 0);
    wasm_u8(body, 55);
    wasm_u32(body, 3);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 168);
    wasm_u8(body, 65);
    wasm_i64(body, 0);
    wasm_u8(body, 59);
    wasm_u32(body, 1);
    wasm_u32(body, 0);
    wasm_u8(body, 65);
    wasm_i64(body, 128);
    wasm_u8(body, 65);
    wasm_i64(body, 176);
    wasm_u8(body, 65);
    wasm_i64(body, 1);
    wasm_u8(body, 65);
    wasm_i64(body, 208);
    wasm_u8(body, 16);
    wasm_u32(body, 16);
    wasm_wasi_capture_errno(body);
    wasm_u8(body, 26);
}

fn wasm_wasi_emit_sleep_millis_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    // Non-positive sleeps are no-ops.
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 87);
    // i64.le_s
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // __wasi_subscription_t at 128: userdata=0, type=CLOCK(0),
    // clock.id=MONOTONIC(1), relative timeout=milliseconds*1e6,
    // precision=0, flags=0. Event output starts at 176; nevents at 208.
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 128);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 55);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 136);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 58);
    wasm_u32(&mut body, 0);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 144);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 54);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 152);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 1000000);
    wasm_u8(&mut body, 126);
    // i64.mul
    wasm_u8(&mut body, 55);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 160);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 55);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 168);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 59);
    wasm_u32(&mut body, 1);
    wasm_u32(&mut body, 0);
    // poll_oneoff(&subscription, &event, 1, &nevents)
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 128);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 176);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 208);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 16);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 26);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_current_dir_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    // local 2 = preopen name length, local 3 = bytes copied, local 4 = preopen fd.
    wasm_u32(&mut body, 1);
    wasm_u32(&mut body, 3);
    wasm_u8(&mut body, 127);
    wasm_wasi_emit_find_preopen(&mut body, 4);
    wasm_local_get(&mut body, 4);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // fd_prestat_get(discovered, &prestat@256)
    wasm_local_get(&mut body, 4);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 256);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 17);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // prestat.dir.pr_name_len at byte offset 4.
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 260);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_local_set(&mut body, 2);
    // Query mode: output==0 or capacity==0 returns required length.
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    // copied = min(name_len, capacity - 1).
    wasm_local_get(&mut body, 2);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 107);
    wasm_u8(&mut body, 73);
    // i32.lt_u
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 127);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 5);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 107);
    wasm_u8(&mut body, 11);
    wasm_local_set(&mut body, 3);
    // fd_prestat_dir_name(discovered, output, copied)
    wasm_local_get(&mut body, 4);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 3);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 18);
