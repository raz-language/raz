    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 2);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    // Non-dot entry found.
    wasm_u8(&mut body, 12);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    // Fetch stat relative to the opened directory descriptor.
    wasm_local_get(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 248);
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 64);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 11);
    wasm_wasi_capture_errno(&mut body);
    wasm_local_set(&mut body, 9);
    // Defaults if metadata lookup is unavailable for the entry.
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_local_set(&mut body, 13);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_local_set(&mut body, 14);
    wasm_local_get(&mut body, 9);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 80);
    wasm_u8(&mut body, 45);
    wasm_u32(&mut body, 0);
    wasm_u32(&mut body, 0);
    wasm_local_set(&mut body, 8);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 96);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_local_set(&mut body, 13);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 112);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 1000000);
    wasm_u8(&mut body, 127);
    wasm_local_set(&mut body, 14);
    wasm_u8(&mut body, 11);
    // Map WASI filetype to Raz metadata kind: file=1, dir=2, symlink=3, other=4.
    wasm_u8(&mut body, 66);
