    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 10);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 26);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

