namespace raz_compiler_backend_wasm_codegen;

public import raz_compiler_backend_wasm_cfg;
public import raz_compiler_backend_wasm_closures;
public import raz_compiler_backend_wasm_wasi;
public import raz_compiler_backend_wasm_float;
public import raz_compiler_backend_wasm_simd;
public import raz_compiler_backend_wasm_runtime_memory;
public import raz_compiler_backend_wasm_async;
public import raz_compiler_backend_wasm_runtime_future;

// Core WebAssembly backend. Backend validation is semantic: supported MIR is
// emitted directly, runtime-dependent families are rejected explicitly, and no
// operation falls back to another backend or silently changes Raz semantics.
fn wasm_signature_supported(Source& source, HirModule& hir, i64 function_index) -> bool {
    if (
        raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0 &&
        !wasm_wasi_runtime_function_supported(source, hir, function_index) &&
        !wasm_simd_runtime_function_supported(source, hir, function_index) &&
        !wasm_runtime_memory_function_supported(source, hir, function_index) &&
        !wasm_future_runtime_function_supported(source, hir, function_index)
    ) {
        return false;
    }
    // First-class callable parameters and returns already use the stable MIR i64
    // handle/table representation. No extra wasm signature restriction is needed.
    return true;
}

fn wasm_opcode_runtime_deferred(i64 opcode) -> bool {
    // All live MIR opcodes have a wasm lowering. Keep this helper as the explicit
    // classification hook for future MIR additions.
    return false;
}

fn wasm_opcode_supported(i64 opcode, i64 type_kind) -> bool {
    if (primitive_type_is_float(type_kind)) {
        return (
            (opcode >= 1 && opcode <= 17) ||
            opcode == 21 ||
            opcode == 22 ||
            opcode == 23 ||
            opcode == 24 ||
            opcode == 25 ||
            opcode == 26 ||
            opcode == 27 ||
            opcode == 28 ||
            opcode == 29 ||
            opcode == 30 ||
            opcode == 31 ||
            opcode == 40 ||
            opcode == 41 ||
            opcode == 45 ||
            opcode == 46 ||
            opcode == 47 ||
            opcode == 48 ||
            opcode == 49
        );
    }
    if (opcode >= 1 && opcode <= 20) {
        return true;
    }
    if (
        opcode == 21 ||
        opcode == 22 ||
        opcode == 23 ||
        opcode == 24 ||
        opcode == 25 ||
        opcode == 26 ||
        opcode == 27 ||
        opcode == 28 ||
        opcode == 29 ||
        opcode == 30 ||
        opcode == 31 ||
        opcode == 32 ||
        opcode == 33 ||
        opcode == 40 ||
        opcode == 41 ||
        opcode == 42 ||
        opcode == 43 ||
        opcode == 44 ||
        opcode == 45 ||
        opcode == 46 ||
        opcode == 47 ||
        opcode == 48 ||
        opcode == 49 ||
        opcode == 50 ||
        opcode == 51
    ) {
        return true;
    }
    if (opcode >= 34 && opcode <= 39) {
        return true;
    }
    return false;
}

fn wasm_validate_module(Source& source, HirModule& hir, MirModule& mir) -> bool {
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (!wasm_signature_supported(source, hir, function_index)) {
            return false;
        }

        i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
        i64 count = raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
        i64 ip = start;

        if (raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0) {
            function_index += 1;
            continue;
        }
        while (ip < start + count) {
            i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);
            i64 type_kind = raz_compiler_rt_arena_get(mir.op_types, ip);

            if (opcode == 41 && raz_compiler_rt_arena_get(hir.function_is_async, function_index) == 0) {
                return false;
            }
            if (wasm_opcode_runtime_deferred(opcode) || !wasm_opcode_supported(opcode, type_kind)) {
                return false;
            }
            if (opcode == 8) {
                i64 target = raz_compiler_rt_arena_get(mir.op_a, ip);

                if (target < 0 || target >= hir.function_count) {
                    return false;
                }
            }
            if (opcode == 22) {
                if (wasm_block_for_target(mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip)) < 0) {
                    return false;
                }
            }
            if (opcode == 23) {
                if (
                    wasm_block_for_target(mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip)) < 0 ||
                    wasm_block_for_target(mir, function_index, raz_compiler_rt_arena_get(mir.op_c, ip)) < 0
                ) {
                    return false;
                }
            }
            ip += 1;
        }
        function_index += 1;
    }
    return true;
}

fn wasm_register_local(MirModule& mir, i64 function_index, i64 ip) -> i64 {
    i64 parameters = raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index);
    i64 locals = raz_compiler_rt_arena_get(mir.function_local_counts, function_index);

    return parameters + locals + wasm_register_ordinal(mir, function_index, ip);
}

fn wasm_frame_local(MirModule& mir, i64 function_index, i64 slot) -> i64 {
    return raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index) + slot;
}

fn wasm_dispatch_local(MirModule& mir, i64 function_index) -> i64 {
    return (raz_compiler_rt_arena_get(mir.function_parameter_counts, function_index) + raz_compiler_rt_arena_get(mir.function_local_counts, function_index) + wasm_function_register_count(mir, function_index));
}

fn wasm_edge_value_local(MirModule& mir, i64 function_index) -> i64 {
    return wasm_dispatch_local(mir, function_index) + 1;
}

fn wasm_emit_dispatch_set(ForgeWriter&mut out, MirModule& mir, i64 function_index, i64 block) {
    wasm_u8(out, 66);
    wasm_i64(out, block);
    wasm_local_set(out, wasm_dispatch_local(mir, function_index));
}

fn wasm_emit_edge_value(ForgeWriter&mut out, MirModule& mir, i64 function_index, i64 value) {
    if (value >= 0) {
        wasm_emit_register_get(out, mir, function_index, value);
        wasm_local_set(out, wasm_edge_value_local(mir, function_index));
    }
}

fn wasm_emit_register_get(ForgeWriter&mut out, MirModule& mir, i64 function_index, i64 instruction) {
    wasm_local_get(out, wasm_register_local(mir, function_index, instruction));
}

fn wasm_emit_register_set(ForgeWriter&mut out, MirModule& mir, i64 function_index, i64 instruction) {
    wasm_local_set(out, wasm_register_local(mir, function_index, instruction));
}

fn wasm_emit_compare(ForgeWriter&mut out, i64 opcode, i64 type_kind) -> bool {
    bool unsigned_value = primitive_type_is_unsigned(type_kind);

    if (opcode == 11) {
        wasm_u8(out, 81);
    } else if (opcode == 12) {
        wasm_u8(out, 82);
    } else if (opcode == 13) {
        if (unsigned_value) {
            wasm_u8(out, 84);
        } else {
            wasm_u8(out, 83);
        }
    } else if (opcode == 14) {
        if (unsigned_value) {
            wasm_u8(out, 88);
        } else {
            wasm_u8(out, 87);
        }
    } else if (opcode == 15) {
        if (unsigned_value) {
            wasm_u8(out, 86);
        } else {
            wasm_u8(out, 85);
        }
    } else if (opcode == 16) {
        if (unsigned_value) {
            wasm_u8(out, 90);
        } else {
            wasm_u8(out, 89);
        }
    } else {
        return false;
    }
    // Raz booleans are represented in scalar MIR as machine integers.
    wasm_u8(out, 173);
    // i64.extend_i32_u
    return true;
}

fn wasm_emit_binary(ForgeWriter&mut out, i64 opcode, i64 type_kind) -> bool {
    bool unsigned_value = primitive_type_is_unsigned(type_kind);

    if (opcode == 4) {
        wasm_u8(out, 124);
        // i64.add
    } else if (opcode == 5) {
        wasm_u8(out, 125);
        // i64.sub
    } else if (opcode == 6) {
        wasm_u8(out, 126);
        // i64.mul
    } else if (opcode == 7) {
        if (unsigned_value) {
            wasm_u8(out, 128);
        } else {
            wasm_u8(out, 127);
        }
        // div_u/div_s
    } else if (opcode == 34) {
        if (unsigned_value) {
            wasm_u8(out, 130);
        } else {
            wasm_u8(out, 129);
        }
        // rem_u/rem_s
    } else if (opcode == 35) {
        wasm_u8(out, 131);
    } else if (opcode == 36) {
        wasm_u8(out, 132);
    } else if (opcode == 37) {
        wasm_u8(out, 133);
    } else if (opcode == 38) {
        wasm_u8(out, 134);
    } else if (opcode == 39) {
        if (unsigned_value) {
            wasm_u8(out, 136);
        } else {
            wasm_u8(out, 135);
        }
        // shr_u/shr_s
    } else {
        return false;
    }
    return true;
}

fn wasm_emit_instruction(
    ForgeWriter&mut out,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 ip,
) -> bool {
    i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);
    i64 type_kind = raz_compiler_rt_arena_get(mir.op_types, ip);

    if (opcode == 1) {
        if (primitive_type_is_float(type_kind)) {
            if (
                !wasm_float_emit_literal(
                    out,
                    source,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                    raz_compiler_rt_arena_get(mir.op_b, ip),
                    type_kind,
                )
            ) {
                return false;
            }
            wasm_float_emit_value_to_bits(out, type_kind);
        } else {
            wasm_u8(out, 66);
            // i64.const
            wasm_i64(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        }
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 2) {
        i64 parameter = raz_compiler_rt_arena_get(mir.op_a, ip);

        wasm_local_get(out, parameter);

        i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);
        i64 parameter_type = raz_compiler_rt_arena_get(hir.parameter_types, parameter_start + parameter);

        if (primitive_type_is_float(parameter_type)) {
            wasm_float_emit_value_to_bits(out, parameter_type);
        }
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 3) {
        wasm_local_get(out, wasm_frame_local(mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip)));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if ((opcode >= 4 && opcode <= 7) || (opcode >= 34 && opcode <= 39)) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        if (primitive_type_is_float(type_kind)) {
            wasm_float_emit_bits_to_value(out, type_kind);
        }
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));
        if (primitive_type_is_float(type_kind)) {
            wasm_float_emit_bits_to_value(out, type_kind);
            if (!wasm_float_emit_binary(out, opcode, type_kind)) {
                return false;
            }
            wasm_float_emit_value_to_bits(out, type_kind);
        } else if (!wasm_emit_binary(out, opcode, type_kind)) {
            return false;
        }
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 8) {
        i64 argument_start = raz_compiler_rt_arena_get(mir.op_b, ip);
        i64 argument_count = raz_compiler_rt_arena_get(mir.op_c, ip);
        i64 argument = 0;
        i64 target_function = raz_compiler_rt_arena_get(mir.op_a, ip);

        i64 target_parameter_start = raz_compiler_rt_arena_get(
            hir.function_parameter_starts,
            target_function
        );
        while (argument < argument_count) {
            wasm_emit_register_get(
                out,
                mir,
                function_index,
                raz_compiler_rt_arena_get(mir.call_arguments, argument_start + argument),
            );
            i64 argument_type = raz_compiler_rt_arena_get(
                hir.parameter_types,
                target_parameter_start + argument,
            );
            if (primitive_type_is_float(argument_type)) {
                wasm_float_emit_bits_to_value(out, argument_type);
            }
            argument += 1;
        }
        wasm_u8(out, 16);
        // call
        wasm_u32(out, wasm_wasi_defined_function(raz_compiler_rt_arena_get(mir.op_a, ip)));

        bool target_async = raz_compiler_rt_arena_get(hir.function_is_async, target_function) != 0;

        if (target_async || raz_compiler_rt_arena_get(hir.function_returns_value, target_function) != 0) {
            i64 return_type = raz_compiler_rt_arena_get(hir.function_return_types, target_function);

            // Public async functions return an i64 future/frame handle regardless
            // of their eventual source-level result type.
            if (!target_async && primitive_type_is_float(return_type)) {
                wasm_float_emit_value_to_bits(out, return_type);
            }
            wasm_emit_register_set(out, mir, function_index, ip);
        }
        return true;
    }
    if (opcode == 9) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));
        wasm_local_set(out, wasm_frame_local(mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip)));
        return true;
    }
    if (opcode == 10) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));

        i64 return_type = raz_compiler_rt_arena_get(hir.function_return_types, function_index);

        if (primitive_type_is_float(return_type)) {
            wasm_float_emit_bits_to_value(out, return_type);
        }
        wasm_u8(out, 15);
        // return
        return true;
    }
    if (opcode >= 11 && opcode <= 16) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        if (primitive_type_is_float(type_kind)) {
            wasm_float_emit_bits_to_value(out, type_kind);
        }
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));
        if (primitive_type_is_float(type_kind)) {
            wasm_float_emit_bits_to_value(out, type_kind);
            if (!wasm_float_emit_compare(out, opcode, type_kind)) {
                return false;
            }
        } else if (!wasm_emit_compare(out, opcode, type_kind)) {
            return false;
        }
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 17) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_c, ip));
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_u8(out, 80);
        // i64.eqz
        wasm_u8(out, 69);
        // i32.eqz => condition != 0
        wasm_u8(out, 27);
        // select
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 18) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_u8(out, 80);
        // i64.eqz
        wasm_u8(out, 173);
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 19 || opcode == 20) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_u8(out, 80);
        wasm_u8(out, 69);
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));
        wasm_u8(out, 80);
        wasm_u8(out, 69);
        if (opcode == 19) {
            wasm_u8(out, 113);
        } else {
            wasm_u8(out, 114);
        }
        // i32.and / i32.or
        wasm_u8(out, 173);
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 21) {
        wasm_u8(out, 15);
        return true;
    }
    if (opcode == 24) {
        if (raz_compiler_rt_arena_get(mir.op_a, ip) != 0) {
            wasm_local_get(out, wasm_edge_value_local(mir, function_index));
        } else {
            wasm_u8(out, 66);
            wasm_i64(out, ip);
        }
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 25) {
        wasm_memory_emit_local_reference(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 26) {
        wasm_memory_emit_reference_load(
            out,
            mir,
            function_index,
            raz_compiler_rt_arena_get(mir.op_a, ip),
            ip
        );
        return true;
    }
    if (opcode == 27) {
        wasm_memory_emit_reference_store(
            out,
            mir,
            function_index,
            raz_compiler_rt_arena_get(mir.op_a, ip),
            raz_compiler_rt_arena_get(mir.op_b, ip),
        );
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 28) {
        if (primitive_type_is_float(type_kind)) {
            wasm_memory_emit_address(
                out,
                mir,
                function_index,
                raz_compiler_rt_arena_get(mir.op_a, ip),
                raz_compiler_rt_arena_get(mir.op_b, ip),
            );
            wasm_float_emit_memory_load(out, type_kind);
        } else {
            wasm_memory_emit_load(
                out,
                mir,
                function_index,
                raz_compiler_rt_arena_get(mir.op_a, ip),
                raz_compiler_rt_arena_get(mir.op_b, ip),
            );
        }
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 29) {
        i64 value_instruction = raz_compiler_rt_arena_get(mir.op_c, ip);
        i64 value_type = raz_compiler_rt_arena_get(mir.op_types, value_instruction);

        if (primitive_type_is_float(value_type)) {
            wasm_memory_emit_address(
                out,
                mir,
                function_index,
                raz_compiler_rt_arena_get(mir.op_a, ip),
                raz_compiler_rt_arena_get(mir.op_b, ip),
            );
            wasm_emit_register_get(out, mir, function_index, value_instruction);
            wasm_float_emit_memory_store(out, value_type);
        } else {
            wasm_memory_emit_store(
                out,
                mir,
                function_index,
                raz_compiler_rt_arena_get(mir.op_a, ip),
                raz_compiler_rt_arena_get(mir.op_b, ip),
                value_instruction,
            );
        }
        // MIR aggregate stores evaluate to the stored value. Preserve that result
        // even when the current frontend only consumes it for ownership/path data.
        wasm_emit_register_get(out, mir, function_index, value_instruction);
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 30) {
        return wasm_memory_emit_allocate(
            out,
            mir,
            function_index,
            ip,
            raz_compiler_rt_arena_get(mir.op_a, ip)
        );
    }
    if (opcode == 31) {
        // The phase-3 wasm allocator is monotonic. Ownership semantics remain
        // explicit in MIR, while individual frees become deterministic no-ops.
        wasm_u8(out, 66);
        wasm_i64(out, 0);
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 32 || opcode == 33) {
        wasm_u8(out, 66);
        wasm_i64(out, 0);
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 43) {
        wasm_u8(out, 66);
        wasm_i64(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 44) {
        i64 argument_start = raz_compiler_rt_arena_get(mir.op_b, ip);
        i64 argument_count = raz_compiler_rt_arena_get(mir.op_c, ip);
        i64 argument = 0;
        i64 signature = raz_compiler_rt_arena_get(mir.op_d, ip);

        i64 signature_parameter_start = raz_compiler_rt_arena_get(
            hir.function_type_parameter_starts,
            signature,
        );
        while (argument < argument_count) {
            wasm_emit_register_get(
                out,
                mir,
                function_index,
                raz_compiler_rt_arena_get(mir.call_arguments, argument_start + argument),
            );
            i64 argument_type = raz_compiler_rt_arena_get(
                hir.function_type_parameter_types,
                signature_parameter_start + argument,
            );
            if (primitive_type_is_float(argument_type)) {
                wasm_float_emit_bits_to_value(out, argument_type);
            }
            argument += 1;
        }
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_u8(out, 167);
        // i32.wrap_i64
        wasm_u8(out, 17);
        // call_indirect
        wasm_u32(out, hir.function_count + raz_compiler_rt_arena_get(mir.op_d, ip));
        wasm_u32(out, 0);

        i64 indirect_return_type = raz_compiler_rt_arena_get(hir.function_type_return_types, signature);

        if (indirect_return_type != 15) {
            if (primitive_type_is_float(indirect_return_type)) {
                wasm_float_emit_value_to_bits(out, indirect_return_type);
            }
            wasm_emit_register_set(out, mir, function_index, ip);
        }
        return true;
    }
    if (opcode == 50) {
        return wasm_closure_emit_create(out, hir, mir, function_index, ip);
    }
    if (opcode == 51) {
        return wasm_closure_emit_call(out, hir, mir, function_index, ip);
    }
    if (opcode == 47) {
        wasm_globals_emit_get(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 48) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));
        wasm_globals_emit_set(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        return true;
    }
    if (opcode == 49) {
        wasm_globals_emit_reference(out, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 40) {
        i64 source_type = raz_compiler_rt_arena_get(mir.op_b, ip);

        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        if (!wasm_float_emit_numeric_cast(out, source_type, type_kind)) {
            return false;
        }
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 46) {
        wasm_emit_register_get(out, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 42) {
        wasm_u8(out, 66);
        wasm_i64(out, wasm_memory_string_address(source, mir, ip));
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    if (opcode == 45) {
        wasm_memory_emit_element_reference(
            out,
            mir,
            function_index,
            raz_compiler_rt_arena_get(mir.op_a, ip),
            raz_compiler_rt_arena_get(mir.op_b, ip),
        );
        wasm_emit_register_set(out, mir, function_index, ip);
        return true;
    }
    return false;
}

fn wasm_emit_type_section(ForgeWriter&mut module, HirModule& hir) -> bool {
    ForgeWriter section;

    writer_init(&mut section);
    if (section.failed) {
        return false;
    }

    i64 async_type_count = 0;

    if (wasm_async_count(hir) != 0) {
        async_type_count = 1;
    }
    wasm_u32(&mut section, hir.function_count + hir.function_type_count * 2 + 12 + async_type_count);

    i64 function_index = 0;

    while (function_index < hir.function_count) {
        wasm_u8(&mut section, 96);
        // functype

        i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);

        wasm_u32(&mut section, parameter_count);

        i64 parameter = 0;
        i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);

        while (parameter < parameter_count) {
            i64 parameter_type = raz_compiler_rt_arena_get(hir.parameter_types, parameter_start + parameter);

            if (primitive_type_is_float(parameter_type)) {
                wasm_u8(&mut section, wasm_float_valtype(parameter_type));
            } else {
                wasm_u8(&mut section, 126);
            }
            parameter += 1;
        }
        if (raz_compiler_rt_arena_get(hir.function_is_async, function_index) != 0) {
            // The source result is produced when the future completes. The public
            // async call itself always returns the i64 future/frame handle.
            wasm_u32(&mut section, 1);
            wasm_u8(&mut section, 126);
        } else if (raz_compiler_rt_arena_get(hir.function_returns_value, function_index) != 0) {
            wasm_u32(&mut section, 1);

            i64 return_type = raz_compiler_rt_arena_get(hir.function_return_types, function_index);

            if (primitive_type_is_float(return_type)) {
                wasm_u8(&mut section, wasm_float_valtype(return_type));
            } else {
                wasm_u8(&mut section, 126);
            }
        } else {
            wasm_u32(&mut section, 0);
        }
        function_index += 1;
    }

    i64 signature = 0;

    while (signature < hir.function_type_count) {
        wasm_u8(&mut section, 96);

        i64 parameter_count = raz_compiler_rt_arena_get(hir.function_type_parameter_counts, signature);

        wasm_u32(&mut section, parameter_count);

        i64 parameter = 0;
        i64 parameter_start = raz_compiler_rt_arena_get(hir.function_type_parameter_starts, signature);

        while (parameter < parameter_count) {
            i64 parameter_type = raz_compiler_rt_arena_get(
                hir.function_type_parameter_types,
                parameter_start + parameter,
            );
            if (primitive_type_is_float(parameter_type)) {
                wasm_u8(&mut section, wasm_float_valtype(parameter_type));
            } else {
                wasm_u8(&mut section, 126);
            }
            parameter += 1;
        }

        i64 return_type = raz_compiler_rt_arena_get(hir.function_type_return_types, signature);

        if (return_type != 15) {
            wasm_u32(&mut section, 1);
            if (primitive_type_is_float(return_type)) {
                wasm_u8(&mut section, wasm_float_valtype(return_type));
            } else {
                wasm_u8(&mut section, 126);
            }
        } else {
            wasm_u32(&mut section, 0);
        }
        signature += 1;
    }
    signature = 0;
    while (signature < hir.function_type_count) {
        wasm_u8(&mut section, 96);

        i64 parameter_count = raz_compiler_rt_arena_get(hir.function_type_parameter_counts, signature);

        wasm_u32(&mut section, parameter_count + 1);

        i64 parameter = 0;
        i64 parameter_start = raz_compiler_rt_arena_get(hir.function_type_parameter_starts, signature);

        while (parameter < parameter_count) {
            i64 parameter_type = raz_compiler_rt_arena_get(
                hir.function_type_parameter_types,
                parameter_start + parameter,
            );
            if (primitive_type_is_float(parameter_type)) {
                wasm_u8(&mut section, wasm_float_valtype(parameter_type));
            } else {
                wasm_u8(&mut section, 126);
            }
            parameter += 1;
        }
        wasm_u8(&mut section, 126);

        i64 return_type = raz_compiler_rt_arena_get(hir.function_type_return_types, signature);

        if (return_type != 15) {
            wasm_u32(&mut section, 1);
            if (primitive_type_is_float(return_type)) {
                wasm_u8(&mut section, wasm_float_valtype(return_type));
            } else {
                wasm_u8(&mut section, 126);
            }
        } else {
            wasm_u32(&mut section, 0);
        }
        signature += 1;
    }
    // WASI preview1 host signatures.
    // 0: fd_read/fd_write (i32, i32, i32, i32) -> i32
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 4);

    i64 wasi_parameter = 0;

    while (wasi_parameter < 4) {
        wasm_u8(&mut section, 127);
        wasi_parameter += 1;
    }
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 1: args/env/random pair (i32, i32) -> i32
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 2);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 2: clock_time_get (i32, i64, i32) -> i32
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 3);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 126);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 3: proc_exit (i32) -> void
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 0);
    // 4: path_open (i32,i32,i32,i32,i32,i64,i64,i32,i32) -> i32.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 9);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 126);
    wasm_u8(&mut section, 126);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 5: fd_close (i32) -> i32.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 6: path_filestat_get (i32,i32,i32,i32,i32) -> i32.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 5);

    i64 stat_parameter = 0;

    while (stat_parameter < 5) {
        wasm_u8(&mut section, 127);
        stat_parameter += 1;
    }
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 7: synthesized WASI command _start () -> void.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 0);
    wasm_u32(&mut section, 0);
    // 8: fd_seek (i32, i64, i32, i32) -> i32.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 4);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 126);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 9: fd_prestat_dir_name (i32, i32, i32) -> i32.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 3);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 10: fd_readdir (i32, i32, i32, i64, i32) -> i32.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 5);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 127);
    wasm_u8(&mut section, 126);
    wasm_u8(&mut section, 127);
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    // 11: path_rename (i32, i32, i32, i32, i32, i32) -> i32.
    wasm_u8(&mut section, 96);
    wasm_u32(&mut section, 6);

    i64 rename_parameter = 0;

    while (rename_parameter < 6) {
        wasm_u8(&mut section, 127);
        rename_parameter += 1;
    }
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 127);
    if (wasm_async_count(hir) != 0) {
        // Cooperative async poller: () -> i64 status.
        wasm_u8(&mut section, 96);
        wasm_u32(&mut section, 0);
        wasm_u32(&mut section, 1);
        wasm_u8(&mut section, 126);
    }
    wasm_section(module, 1, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn wasm_emit_function_section(
    ForgeWriter&mut module,
    Source& source,
    HirModule& hir,
    MirModule& mir,
) -> bool {
    ForgeWriter section;

    writer_init(&mut section);
    if (section.failed) {
        return false;
    }
    wasm_u32(
        &mut section,
        hir.function_count + wasm_closure_count(
            mir,
        ) + wasm_async_count(hir) + wasm_wasi_start_count(source, hir),
    );

    i64 function_index = 0;

    while (function_index < hir.function_count) {
        wasm_u32(&mut section, function_index);
        function_index += 1;
    }

    i64 ip = 0;

    while (ip < mir.instruction_count) {
        if (raz_compiler_rt_arena_get(mir.opcodes, ip) == 50) {
            wasm_u32(&mut section, wasm_closure_adapter_type(hir, raz_compiler_rt_arena_get(mir.op_d, ip)));
        }
        ip += 1;
    }

    i64 async_index = 0;

    while (async_index < wasm_async_count(hir)) {
        wasm_u32(&mut section, wasm_async_poll_type_index(hir));
        async_index += 1;
    }
    if (wasm_wasi_start_count(source, hir) != 0) {
        wasm_u32(&mut section, hir.function_count + hir.function_type_count * 2 + 7);
    }
    wasm_section(module, 3, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn wasm_emit_table_section(ForgeWriter&mut module, HirModule& hir, MirModule& mir) -> bool {
    if (!wasm_module_needs_table(hir, mir)) {
        return true;
    }

    ForgeWriter section;

    writer_init(&mut section);
    if (section.failed) {
        return false;
    }
    wasm_u32(&mut section, 1);
    wasm_u8(&mut section, 112);
    // funcref
    wasm_u32(&mut section, 0);
    wasm_u32(&mut section, hir.function_count + wasm_closure_count(mir) + wasm_async_count(hir));
    wasm_section(module, 4, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn wasm_emit_element_section(ForgeWriter&mut module, HirModule& hir, MirModule& mir) -> bool {
    if (!wasm_module_needs_table(hir, mir)) {
        return true;
    }

    ForgeWriter section;

    writer_init(&mut section);
    if (section.failed) {
        return false;
    }
    wasm_u32(&mut section, 1);
    wasm_u32(&mut section, 0);
    // active segment, table 0
    wasm_u8(&mut section, 65);
    wasm_i64(&mut section, 0);
    wasm_u8(&mut section, 11);
    wasm_u32(&mut section, hir.function_count + wasm_closure_count(mir) + wasm_async_count(hir));

    i64 function_index = 0;

    while (function_index < hir.function_count + wasm_closure_count(mir) + wasm_async_count(hir)) {
        wasm_u32(&mut section, wasm_wasi_defined_function(function_index));
        function_index += 1;
    }
    wasm_section(module, 9, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn wasm_emit_export_section(ForgeWriter&mut module, Source& source, HirModule& hir, MirModule& mir) -> bool {
    ForgeWriter section;

    writer_init(&mut section);
    if (section.failed) {
        return false;
    }
    // Export user-defined Raz functions, never internal extern/runtime boundary
    // wrappers. This keeps the module surface stable and avoids publishing the
    // implementation plumbing used by stdlib lowering.

    i64 export_function_count = 0;
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0) {
            export_function_count += 1;
        }
        function_index += 1;
    }
    wasm_u32(&mut section, export_function_count + 1 + wasm_wasi_start_count(source, hir));
    function_index = 0;
    while (function_index < hir.function_count) {
        if (raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0) {
            wasm_source_name(
                &mut section,
                source,
                raz_compiler_rt_arena_get(hir.function_name_offsets, function_index),
                raz_compiler_rt_arena_get(hir.function_name_lengths, function_index),
            );
            wasm_u8(&mut section, 0);
            // function export
            wasm_u32(&mut section, wasm_wasi_defined_function(function_index));
        }
        function_index += 1;
    }

    i64 memory_name[6] = [109, 101, 109, 111, 114, 121];

    wasm_name(&mut section, &memory_name, 6);
    wasm_u8(&mut section, 2);
    // memory export
    wasm_u32(&mut section, 0);
    if (wasm_wasi_start_count(source, hir) != 0) {
        i64 start_name[6] = [95, 115, 116, 97, 114, 116];

        wasm_name(&mut section, &start_name, 6);
        wasm_u8(&mut section, 0);
        wasm_u32(
            &mut section,
            wasm_wasi_import_count() + hir.function_count + wasm_closure_count(mir) + wasm_async_count(hir),
        );
    }
    wasm_section(module, 7, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn wasm_emit_branch_terminator(ForgeWriter&mut body, MirModule& mir, i64 function_index, i64 ip) -> bool {
    i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

    if (opcode == 22) {
        wasm_emit_edge_value(body, mir, function_index, raz_compiler_rt_arena_get(mir.op_c, ip));

        i64 target = wasm_block_for_target(mir, function_index, raz_compiler_rt_arena_get(mir.op_b, ip));

        if (target < 0) {
            return false;
        }
        wasm_emit_dispatch_set(body, mir, function_index, target);
        wasm_u8(body, 12);
        wasm_u32(body, 1);
        // br 1: leave the block-dispatch if and continue the enclosing loop.
        return true;
    }
    if (opcode == 23) {
        wasm_emit_edge_value(body, mir, function_index, raz_compiler_rt_arena_get(mir.op_d, ip));
        i64 false_target = wasm_block_for_target(
            mir,
            function_index,
            raz_compiler_rt_arena_get(mir.op_b, ip)
        );

        i64 true_target = wasm_block_for_target(mir, function_index, raz_compiler_rt_arena_get(mir.op_c, ip));

        if (false_target < 0 || true_target < 0) {
            return false;
        }
        wasm_emit_register_get(body, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
        wasm_u8(body, 80);
        // i64.eqz: false Raz condition selects the false edge.
        wasm_u8(body, 4);
        wasm_u8(body, 64);
        // if void
        wasm_emit_dispatch_set(body, mir, function_index, false_target);
        wasm_u8(body, 5);
        // else
        wasm_emit_dispatch_set(body, mir, function_index, true_target);
        wasm_u8(body, 11);
        // end if
        wasm_u8(body, 12);
        wasm_u32(body, 1);
        return true;
    }
    return false;
}

fn wasm_emit_dispatch_block(
    ForgeWriter&mut body,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 block,
    i64 block_count,
) -> bool {
    i64 start = wasm_block_start(mir, function_index, block);
    i64 end = wasm_block_end(mir, function_index, block);

    if (start < 0 || end < start) {
        return false;
    }
    wasm_local_get(body, wasm_dispatch_local(mir, function_index));
    wasm_u8(body, 66);
    wasm_i64(body, block);
    wasm_u8(body, 81);
    // i64.eq
    wasm_u8(body, 4);
    wasm_u8(body, 64);
    // if void

    i64 ip = start;

    while (ip < end) {
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        if (opcode == 22 || opcode == 23) {
            if (!wasm_emit_branch_terminator(body, mir, function_index, ip)) {
                return false;
            }
        } else {
            if (!wasm_emit_instruction(body, source, hir, mir, function_index, ip)) {
                return false;
            }
        }
        ip += 1;
    }
    if (!wasm_block_ends_in_terminator(mir, function_index, block)) {
        if (block + 1 < block_count) {
            wasm_emit_dispatch_set(body, mir, function_index, block + 1);
            wasm_u8(body, 12);
            wasm_u32(body, 1);
        } else {
            // A final non-terminated block falls out of the dispatcher.  This is
            // valid only for void MIR functions; value functions are verified to
            // return before backend emission.
            wasm_u8(body, 12);
            wasm_u32(body, 2);
        }
    }
    wasm_u8(body, 11);
    // end dispatch if
    return true;
}

fn wasm_async_poll_frame_local(MirModule& mir, i64 function_index) -> i64 {
    return wasm_edge_value_local(mir, function_index) + 1;
}

fn wasm_async_emit_spill_register(
    ForgeWriter&mut body,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 ip,
    i64 frame_local,
) {
    wasm_async_store_spill_local(
        body,
        frame_local,
        wasm_async_register_slot(hir, mir, function_index, ip),
        wasm_register_local(mir, function_index, ip),
    );
}

fn wasm_async_emit_spill_declared_local(
    ForgeWriter&mut body,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 local_slot,
    i64 frame_local,
) {
    wasm_async_store_spill_local(
        body,
        frame_local,
        wasm_async_local_slot(local_slot),
        wasm_frame_local(mir, function_index, local_slot),
    );
}

fn wasm_async_emit_edge_target(
    ForgeWriter&mut body,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 target,
    i64 incoming,
    i64 frame_local,
) -> bool {
    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = start + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);

    if (target < start || target >= end) {
        return false;
    }
    if (
        incoming >= 0 &&
        raz_compiler_rt_arena_get(mir.opcodes, target) == 24 &&
        raz_compiler_rt_arena_get(mir.op_a, target) != 0
    ) {
        wasm_emit_register_get(body, mir, function_index, incoming);
        wasm_emit_register_set(body, mir, function_index, target);
        wasm_async_emit_spill_register(body, hir, mir, function_index, target, frame_local);
    }
    return true;
}

fn wasm_async_emit_set_pc(ForgeWriter&mut body, MirModule& mir, i64 function_index, i64 frame_local, i64 pc) {
    wasm_emit_dispatch_set(body, mir, function_index, pc);
    wasm_async_store_frame_state(body, frame_local, pc);
}

fn wasm_async_emit_complete(
    ForgeWriter&mut body,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 frame_local,
    i64 result_instruction,
) {
    if (result_instruction >= 0) {
        wasm_async_i64_store_local(
            body,
            frame_local,
            wasm_async_frame_result_offset(),
            wasm_register_local(mir, function_index, result_instruction),
        );
    } else {
        wasm_async_i64_store_const(body, frame_local, wasm_async_frame_result_offset(), 0);
    }
    wasm_async_store_frame_status(body, frame_local, 1);
    wasm_u8(body, 66);
    wasm_i64(body, 1);
    wasm_u8(body, 15);
}

fn wasm_async_emit_cancel(ForgeWriter&mut body, i64 frame_local) {
    wasm_async_store_frame_status(body, frame_local, -1);
    wasm_u8(body, 66);
    wasm_i64(body, -1);
    wasm_u8(body, 15);
}

fn wasm_async_emit_await(
    ForgeWriter&mut body,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 ip,
    i64 frame_local,
    i64 closure_count,
) -> bool {
    i64 future_instruction = raz_compiler_rt_arena_get(mir.op_a, ip);
    i64 future_local = wasm_register_local(mir, function_index, future_instruction);
    i64 result_local = wasm_register_local(mir, function_index, ip);
    i64 next_pc = ip - raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index) + 1;

    // Null futures are invalid/cancelled, never silently ready.
    wasm_local_get(body, future_local);
    wasm_u8(body, 80);
    wasm_u8(body, 4);
    wasm_u8(body, 64);
    wasm_async_emit_cancel(body, frame_local);
    wasm_u8(body, 11);
    // If the child is pending and owns a poller, cooperatively drive it once.
    wasm_async_load_frame_status(body, future_local);
    wasm_u8(body, 80);
    wasm_u8(body, 4);
    wasm_u8(body, 64);
    wasm_async_load_frame_poll(body, future_local);
    wasm_u8(body, 66);
    wasm_i64(body, 0);
    wasm_u8(body, 89);
    // i64.ge_s
    wasm_u8(body, 4);
    wasm_u8(body, 64);
    wasm_local_get(body, future_local);
    wasm_u8(body, 36);
    wasm_u32(body, wasm_async_current_frame_global(mir));
    wasm_async_load_frame_poll(body, future_local);
    wasm_u8(body, 167);
    wasm_u8(body, 17);
    // call_indirect () -> i64
    wasm_u32(body, wasm_async_poll_type_index(hir));
    wasm_u32(body, 0);
    wasm_u8(body, 26);
    wasm_local_get(body, frame_local);
    wasm_u8(body, 36);
    wasm_u32(body, wasm_async_current_frame_global(mir));
    wasm_u8(body, 11);
    wasm_u8(body, 11);
    // Ready: copy result bits into the await MIR register and continue.
    wasm_async_load_frame_status(body, future_local);
    wasm_u8(body, 66);
    wasm_i64(body, 1);
    wasm_u8(body, 81);
    wasm_u8(body, 4);
    wasm_u8(body, 64);
    wasm_async_load_frame_result(body, future_local);
    wasm_local_set(body, result_local);
    wasm_async_emit_spill_register(body, hir, mir, function_index, ip, frame_local);
    wasm_async_emit_set_pc(body, mir, function_index, frame_local, next_pc);
    wasm_u8(body, 12);
    wasm_u32(body, 1);
    wasm_u8(body, 11);
    // Cancelled child propagates cancellation to the parent.
    wasm_async_load_frame_status(body, future_local);
    wasm_u8(body, 66);
    wasm_i64(body, 0);
    wasm_u8(body, 83);
    // i64.lt_s
    wasm_u8(body, 4);
    wasm_u8(body, 64);
    wasm_async_emit_cancel(body, frame_local);
    wasm_u8(body, 11);
    // Still pending: preserve this exact MIR pc and yield to the caller.
    wasm_async_store_frame_state(
        body,
        frame_local,
        ip - raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index),
    );
    wasm_u8(body, 66);
    wasm_i64(body, 0);
    wasm_u8(body, 15);
    return true;
}

fn wasm_async_emit_poll_body(
    ForgeWriter&mut section,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
    i64 closure_count,
) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }

    i64 parameter_count = raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index);
    i64 parameter_start = raz_compiler_rt_arena_get(hir.function_parameter_starts, function_index);
    i64 declared_locals = raz_compiler_rt_arena_get(mir.function_local_counts, function_index);
    i64 register_locals = wasm_function_register_count(mir, function_index);
    i64 frame_local = wasm_async_poll_frame_local(mir, function_index);
    i64 remaining_locals = declared_locals + register_locals + 3;

    // Poll has no wasm parameters. Declare synthetic source-parameter locals in
    // their native valtypes so the ordinary MIR parameter lowering remains valid.
    wasm_u32(&mut body, parameter_count + 1);

    i64 parameter = 0;

    while (parameter < parameter_count) {
        wasm_u32(&mut body, 1);

        i64 parameter_type = raz_compiler_rt_arena_get(hir.parameter_types, parameter_start + parameter);

        if (primitive_type_is_float(parameter_type)) {
            wasm_u8(&mut body, wasm_float_valtype(parameter_type));
        } else {
            wasm_u8(&mut body, 126);
        }
        parameter += 1;
    }
    wasm_u32(&mut body, remaining_locals);
    wasm_u8(&mut body, 126);
    // Resolve the current frame once and reload every spill. Poll resumption is
    // therefore independent of the wasm engine's transient locals.
    wasm_u8(&mut body, 35);
    wasm_u32(&mut body, wasm_async_current_frame_global(mir));
    wasm_local_set(&mut body, frame_local);
    // Terminal frames are idempotent polls.
    wasm_async_load_frame_status(&mut body, frame_local);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 69);
    // status != 0
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_async_load_frame_status(&mut body, frame_local);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    parameter = 0;
    while (parameter < parameter_count) {
        wasm_async_load_spill(
            &mut body,
            frame_local,
            wasm_async_parameter_slot(hir, function_index, parameter),
        );

        i64 parameter_type = raz_compiler_rt_arena_get(hir.parameter_types, parameter_start + parameter);

        if (primitive_type_is_float(parameter_type)) {
            wasm_float_emit_bits_to_value(&mut body, parameter_type);
        }
        wasm_local_set(&mut body, parameter);
        parameter += 1;
    }

    i64 local = 0;

    while (local < declared_locals) {
        wasm_async_load_spill(&mut body, frame_local, wasm_async_local_slot(local));
        wasm_local_set(&mut body, wasm_frame_local(mir, function_index, local));
        local += 1;
    }

    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 end = start + raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 restore_ip = start;

    while (restore_ip < end) {
        wasm_async_load_spill(
            &mut body,
            frame_local,
            wasm_async_register_slot(hir, mir, function_index, restore_ip),
        );
        wasm_emit_register_set(&mut body, mir, function_index, restore_ip);
        restore_ip += 1;
    }
    wasm_async_i64_load(&mut body, frame_local, wasm_async_frame_state_offset());
    wasm_local_set(&mut body, wasm_dispatch_local(mir, function_index));
    wasm_u8(&mut body, 2);
    wasm_u8(&mut body, 64);
    // block exit
    wasm_u8(&mut body, 3);
    wasm_u8(&mut body, 64);
    // loop dispatch

    i64 ip = start;

    while (ip < end) {
        i64 pc = ip - start;
        i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, ip);

        wasm_local_get(&mut body, wasm_dispatch_local(mir, function_index));
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, pc);
        wasm_u8(&mut body, 81);
        wasm_u8(&mut body, 4);
        wasm_u8(&mut body, 64);
        if (opcode == 10) {
            wasm_async_emit_complete(
                &mut body,
                hir,
                mir,
                function_index,
                frame_local,
                raz_compiler_rt_arena_get(mir.op_a, ip),
            );
        } else if (opcode == 21) {
            wasm_async_emit_complete(&mut body, hir, mir, function_index, frame_local, -1);
        } else if (opcode == 22) {
            i64 target = raz_compiler_rt_arena_get(mir.op_b, ip);

            if (
                !wasm_async_emit_edge_target(
                    &mut body,
                    hir,
                    mir,
                    function_index,
                    target,
                    raz_compiler_rt_arena_get(mir.op_c, ip),
                    frame_local,
                )
            ) {
                writer_destroy(&mut body);
                return false;
            }
            wasm_async_emit_set_pc(&mut body, mir, function_index, frame_local, target - start);
            wasm_u8(&mut body, 12);
            wasm_u32(&mut body, 1);
        } else if (opcode == 23) {
            i64 false_target = raz_compiler_rt_arena_get(mir.op_b, ip);
            i64 true_target = raz_compiler_rt_arena_get(mir.op_c, ip);
            i64 incoming = raz_compiler_rt_arena_get(mir.op_d, ip);

            if (
                !wasm_async_emit_edge_target(
                    &mut body,
                    hir,
                    mir,
                    function_index,
                    false_target,
                    incoming,
                    frame_local,
                ) ||
                !wasm_async_emit_edge_target(
                    &mut body,
                    hir,
                    mir,
                    function_index,
                    true_target,
                    incoming,
                    frame_local,
                )
            ) {
                writer_destroy(&mut body);
                return false;
            }
            wasm_emit_register_get(&mut body, mir, function_index, raz_compiler_rt_arena_get(mir.op_a, ip));
            wasm_u8(&mut body, 80);
            wasm_u8(&mut body, 4);
            wasm_u8(&mut body, 64);
            wasm_async_emit_set_pc(&mut body, mir, function_index, frame_local, false_target - start);
            wasm_u8(&mut body, 5);
            wasm_async_emit_set_pc(&mut body, mir, function_index, frame_local, true_target - start);
            wasm_u8(&mut body, 11);
            wasm_u8(&mut body, 12);
            wasm_u32(&mut body, 1);
        } else if (opcode == 24) {
            if (raz_compiler_rt_arena_get(mir.op_a, ip) == 0) {
                wasm_u8(&mut body, 66);
                wasm_i64(&mut body, ip);
                wasm_emit_register_set(&mut body, mir, function_index, ip);
                wasm_async_emit_spill_register(&mut body, hir, mir, function_index, ip, frame_local);
            }
            wasm_async_emit_set_pc(&mut body, mir, function_index, frame_local, pc + 1);
            wasm_u8(&mut body, 12);
            wasm_u32(&mut body, 1);
        } else if (opcode == 41) {
            if (!wasm_async_emit_await(&mut body, hir, mir, function_index, ip, frame_local, closure_count)) {
                writer_destroy(&mut body);
                return false;
            }
        } else {
            if (!wasm_emit_instruction(&mut body, source, hir, mir, function_index, ip)) {
                writer_destroy(&mut body);
                return false;
            }
            wasm_async_emit_spill_register(&mut body, hir, mir, function_index, ip, frame_local);
            if (opcode == 9) {
                wasm_async_emit_spill_declared_local(
                    &mut body,
                    hir,
                    mir,
                    function_index,
                    raz_compiler_rt_arena_get(mir.op_a, ip),
                    frame_local,
                );
            }
            wasm_async_emit_set_pc(&mut body, mir, function_index, frame_local, pc + 1);
            wasm_u8(&mut body, 12);
            wasm_u32(&mut body, 1);
        }
        wasm_u8(&mut body, 11);
        // end state if
        ip += 1;
    }
    // Invalid pc is a failed future rather than an infinite dispatcher loop.
    wasm_async_emit_cancel(&mut body, frame_local);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_emit_function_body(
    ForgeWriter&mut section,
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 function_index,
) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }

    i64 declared_locals = raz_compiler_rt_arena_get(mir.function_local_counts, function_index);
    i64 register_locals = wasm_function_register_count(mir, function_index);
    bool linear = wasm_function_can_emit_linear(mir, function_index);
    i64 control_locals = 2;

    if (linear) {
        control_locals = 0;
    }

    i64 total_locals = declared_locals + register_locals + control_locals;

    if (total_locals > 0) {
        wasm_u32(&mut body, 1);
        wasm_u32(&mut body, total_locals);
        wasm_u8(&mut body, 126);
        // All scalar MIR values and dispatcher metadata use i64 locals.
    } else {
        wasm_u32(&mut body, 0);
    }

    i64 block_count = wasm_function_block_count(mir, function_index);

    if (linear) {
        i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
        i64 count = raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
        i64 ip = start;

        while (ip < start + count) {
            if (!wasm_emit_instruction(&mut body, source, hir, mir, function_index, ip)) {
                writer_destroy(&mut body);
                return false;
            }
            ip += 1;
        }
    } else if (block_count > 0) {
        wasm_emit_dispatch_set(&mut body, mir, function_index, 0);
        wasm_u8(&mut body, 2);
        wasm_u8(&mut body, 64);
        // block $exit
        wasm_u8(&mut body, 3);
        wasm_u8(&mut body, 64);
        // loop $dispatch

        i64 block = 0;

        while (block < block_count) {
            if (!wasm_emit_dispatch_block(&mut body, source, hir, mir, function_index, block, block_count)) {
                writer_destroy(&mut body);
                return false;
            }
            block += 1;
        }
        // Unknown dispatcher state exits rather than spinning forever.
        wasm_u8(&mut body, 12);
        wasm_u32(&mut body, 1);
        wasm_u8(&mut body, 11);
        // end loop
        wasm_u8(&mut body, 11);
        // end exit block
        if (raz_compiler_rt_arena_get(hir.function_returns_value, function_index) != 0) {
            // Valid MIR value functions return on every semantic path. The
            // defensive unknown-dispatch-state path is not provably unreachable
            // to wasm validation, so terminate that impossible path explicitly.
            wasm_u8(&mut body, 0);
            // unreachable
        }
    }
    wasm_u8(&mut body, 11);
    // function expression end
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_emit_code_section(ForgeWriter&mut module, Source& source, HirModule& hir, MirModule& mir) -> bool {
    ForgeWriter section;

    writer_init(&mut section);
    if (section.failed) {
        return false;
    }
    wasm_u32(
        &mut section,
        hir.function_count + wasm_closure_count(
            mir,
        ) + wasm_async_count(hir) + wasm_wasi_start_count(source, hir),
    );

    i64 function_index = 0;

    while (function_index < hir.function_count) {
        bool emitted = false;

        if (raz_compiler_rt_arena_get(hir.function_is_extern, function_index) != 0) {
            if (wasm_simd_runtime_function_supported(source, hir, function_index)) {
                emitted = wasm_simd_emit_runtime_body(&mut section, source, hir, function_index);
            } else if (wasm_runtime_memory_function_supported(source, hir, function_index)) {
                emitted = wasm_runtime_memory_emit_body(&mut section, source, hir, mir, function_index);
            } else if (wasm_future_runtime_function_supported(source, hir, function_index)) {
                emitted = wasm_future_runtime_emit_body(&mut section, source, hir, function_index);
            } else {
                emitted = wasm_wasi_emit_runtime_body(&mut section, source, hir, function_index);
            }
        } else if (raz_compiler_rt_arena_get(hir.function_is_async, function_index) != 0) {
            emitted = wasm_async_emit_wrapper_body(
                &mut section,
                hir,
                mir,
                function_index,
                wasm_closure_count(mir),
            );
        } else {
            emitted = wasm_emit_function_body(&mut section, source, hir, mir, function_index);
        }
        if (!emitted) {
            writer_destroy(&mut section);
            return false;
        }
        function_index += 1;
    }

    i64 ip = 0;

    while (ip < mir.instruction_count) {
        if (raz_compiler_rt_arena_get(mir.opcodes, ip) == 50) {
            if (!wasm_closure_emit_adapter_body(&mut section, hir, mir, ip)) {
                writer_destroy(&mut section);
                return false;
            }
        }
        ip += 1;
    }
    function_index = 0;
    while (function_index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_async, function_index) != 0 &&
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0
        ) {
            if (
                !wasm_async_emit_poll_body(
                    &mut section,
                    source,
                    hir,
                    mir,
                    function_index,
                    wasm_closure_count(mir),
                )
            ) {
                writer_destroy(&mut section);
                return false;
            }
        }
        function_index += 1;
    }
    if (wasm_wasi_start_count(source, hir) != 0) {
        i64 main_function = wasm_wasi_main_function(source, hir);
        bool start_emitted = false;

        if (main_function >= 0 && raz_compiler_rt_arena_get(hir.function_is_async, main_function) != 0) {
            start_emitted = wasm_async_emit_wasi_start_body(
                &mut section,
                hir,
                mir,
                main_function,
                wasm_closure_count(mir),
            );
        } else {
            start_emitted = wasm_wasi_emit_start_body(&mut section, source, hir);
        }
        if (!start_emitted) {
            writer_destroy(&mut section);
            return false;
        }
    }
    wasm_section(module, 10, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn emit_wasm_module(
    Source& source,
    HirModule& hir,
    MirModule& mir,
    i64 output_path,
    i64 output_path_length,
) -> bool {
    if (output_path == 0 || output_path_length <= 0 || !wasm_validate_module(source, hir, mir)) {
        return false;
    }

    ForgeWriter module;

    writer_init(&mut module);
    if (module.failed) {
        return false;
    }

    i64 header[8] = [0, 97, 115, 109, 1, 0, 0, 0];

    wasm_bytes(&mut module, &header, 8);
    bool success =
        wasm_emit_type_section(&mut module, hir) &&
        wasm_wasi_emit_import_section(&mut module, hir) &&
        wasm_emit_function_section(&mut module, source, hir, mir) &&
        wasm_emit_table_section(&mut module, hir, mir) &&
        wasm_emit_memory_section(&mut module, source, mir) &&
        wasm_emit_global_section(&mut module, source, hir, mir) &&
        wasm_emit_export_section(&mut module, source, hir, mir) &&
        wasm_emit_element_section(&mut module, hir, mir) &&
        wasm_emit_code_section(&mut module, source, hir, mir) &&
        wasm_emit_data_section(&mut module, source, mir);
    if (success) {
        success = raz_compiler_rt_write_ascii(
            output_path,
            output_path_length,
            module.data,
            module.length,
        ) == module.length;
    }
    writer_destroy(&mut module);
    return success;
}
