fn wasm_simd_emit_runtime_body(
    ForgeWriter&mut section,
    Source& source,
    HirModule& hir,
    i64 function_index,
) -> bool {
    if (wasm_simd_i64_add(source, hir, function_index)) {
        return wasm_simd_emit_binary_body(section, 206, true);
    }
    if (wasm_simd_i64_sub(source, hir, function_index)) {
        return wasm_simd_emit_binary_body(section, 209, true);
    }
    if (wasm_simd_i64_mul(source, hir, function_index)) {
        return wasm_simd_emit_binary_body(section, 213, true);
    }
    if (wasm_simd_i64_min(source, hir, function_index)) {
        return wasm_simd_emit_select_body(section, 216, true);
    }
    if (wasm_simd_i64_max(source, hir, function_index)) {
