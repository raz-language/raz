    wasm_u8(&mut body, 67);

    i64 zero = 0;

    wasm_float_emit_fixed_bits(&mut body, zero, 4);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_simd_load(&mut body, 0, 0);
    wasm_simd_op(&mut body, 31);
    wasm_u8(&mut body, 0);

    i64 lane = 1;

    while (lane < 4) {
        wasm_simd_load(&mut body, 0, 0);
        wasm_simd_op(&mut body, 31);
        wasm_u8(&mut body, lane);
        wasm_u8(&mut body, 146);
        lane += 1;
    }

    bool success = wasm_simd_finish_body(section, &mut body);

    writer_destroy(&mut body);
    return success;
}

