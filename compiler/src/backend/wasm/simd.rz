namespace raz_compiler_backend_wasm_simd;

public import raz_compiler_backend_wasm_float;

// WebAssembly SIMD128 lowering for Raz's existing core::simd permanent runtime
// boundary. Vectors remain ordinary fixed arrays in Raz linear memory; the
// backend replaces these extern calls with native v128 loads, operations and
// stores, so no host SIMD shim is required for .wasm artifacts.
fn wasm_simd_name_is(Source& source, HirModule& hir, i64 function_index, i64[]name, i64 length) -> bool {
    if (raz_compiler_rt_arena_get(hir.function_name_lengths, function_index) != length) {
        return false;
    }

    i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
    i64 i = 0;

    while (i < length) {
        if (source_byte(source, offset + i) != name[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn wasm_simd_i64_add(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 name[16] = [114, 97, 122, 95, 114, 116, 95, 105, 54, 52, 120, 52, 95, 97, 100, 100];

    return wasm_simd_name_is(source, hir, function_index, &name, 16);
}

fn wasm_simd_i64_sub(Source& source, HirModule& hir, i64 function_index) -> bool {
    i64 name[16] = [114, 97, 122, 95, 114, 116, 95, 105, 54, 52, 120, 52, 95, 115, 117, 98];

    return wasm_simd_name_is(source, hir, function_index, &name, 16);
}

