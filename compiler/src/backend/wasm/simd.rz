        wasm_simd_i8x16_shr_s(source, hir, function_index) ||
        wasm_simd_i8x16_shr_u(source, hir, function_index) ||
        wasm_simd_i16x8_add(source, hir, function_index) ||
        wasm_simd_i16x8_sub(source, hir, function_index) ||
        wasm_simd_i16x8_mul(source, hir, function_index) ||
        wasm_simd_i16x8_min(source, hir, function_index) ||
        wasm_simd_i16x8_max(source, hir, function_index) ||
        wasm_simd_i16x8_equal(source, hir, function_index) ||
        wasm_simd_i16x8_splat(source, hir, function_index) ||
        wasm_simd_i16x8_all_true(source, hir, function_index) ||
        wasm_simd_i16x8_bitmask(source, hir, function_index) ||
        wasm_simd_i16x8_shl(source, hir, function_index) ||
        wasm_simd_i16x8_shr_s(source, hir, function_index) ||
        wasm_simd_i16x8_shr_u(source, hir, function_index) ||
        wasm_simd_i32x4_shl(source, hir, function_index) ||
        wasm_simd_i32x4_shr_s(source, hir, function_index) ||
        wasm_simd_i32x4_shr_u(source, hir, function_index)
    );
}

fn wasm_simd_op(ForgeWriter&mut out, i64 opcode) {
    wasm_u8(out, 253);
    wasm_u32(out, opcode);
}

fn wasm_simd_load(ForgeWriter&mut body, i64 parameter, i64 offset) {
    wasm_local_get(body, parameter);
    wasm_u8(body, 167);
    // i32.wrap_i64
    wasm_simd_op(body, 0);
    // v128.load
    wasm_u32(body, 4);
    // 16-byte alignment
    wasm_u32(body, offset);
}

fn wasm_simd_output_address_parameter(ForgeWriter&mut body, i64 parameter, i64 offset) {
    wasm_local_get(body, parameter);
    wasm_u8(body, 167);
    if (offset != 0) {
        wasm_u8(body, 65);
        wasm_i64(body, offset);
        wasm_u8(body, 106);
    }
}

fn wasm_simd_output_address(ForgeWriter&mut body, i64 offset) {
    wasm_simd_output_address_parameter(body, 2, offset);
}

fn wasm_simd_store(ForgeWriter&mut body) {
    wasm_simd_op(body, 11);
    // v128.store
    wasm_u32(body, 4);
    wasm_u32(body, 0);
}

fn wasm_simd_null_return_void(ForgeWriter&mut body, i64 parameter) {
    wasm_local_get(body, parameter);
    wasm_u8(body, 80);
    // i64.eqz
    wasm_u8(body, 4);
    wasm_u8(body, 64);
    wasm_u8(body, 15);
    wasm_u8(body, 11);
}

fn wasm_simd_finish_body(ForgeWriter&mut section, ForgeWriter&mut body) -> bool {
    wasm_u8(body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, body);
    return !body.failed && !section.failed;
}

fn wasm_simd_emit_binary_half(ForgeWriter&mut body, i64 offset, i64 opcode) {
    wasm_simd_output_address(body, offset);
    wasm_simd_load(body, 0, offset);
    wasm_simd_load(body, 1, offset);
    wasm_simd_op(body, opcode);
    wasm_simd_store(body);
}

fn wasm_simd_emit_select_half(ForgeWriter&mut body, i64 offset, i64 compare_opcode) {
    wasm_simd_output_address(body, offset);
    wasm_simd_load(body, 0, offset);
    wasm_simd_load(body, 1, offset);
    wasm_simd_load(body, 0, offset);
    wasm_simd_load(body, 1, offset);
    wasm_simd_op(body, compare_opcode);
    wasm_simd_op(body, 82);
    // v128.bitselect(lhs, rhs, mask)
    wasm_simd_store(body);
}

fn wasm_simd_emit_binary_body(ForgeWriter&mut section, i64 opcode, bool wide_i64) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_simd_null_return_void(&mut body, 0);
    wasm_simd_null_return_void(&mut body, 1);
    wasm_simd_null_return_void(&mut body, 2);
    wasm_simd_emit_binary_half(&mut body, 0, opcode);
    if (wide_i64) {
        wasm_simd_emit_binary_half(&mut body, 16, opcode);
    }

    bool success = wasm_simd_finish_body(section, &mut body);

    writer_destroy(&mut body);
    return success;
}

fn wasm_simd_emit_select_body(ForgeWriter&mut section, i64 compare_opcode, bool wide_i64) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_simd_null_return_void(&mut body, 0);
    wasm_simd_null_return_void(&mut body, 1);
    wasm_simd_null_return_void(&mut body, 2);
    wasm_simd_emit_select_half(&mut body, 0, compare_opcode);
    if (wide_i64) {
        wasm_simd_emit_select_half(&mut body, 16, compare_opcode);
    }

    bool success = wasm_simd_finish_body(section, &mut body);

    writer_destroy(&mut body);
    return success;
}

fn wasm_simd_emit_i64_equal_body(ForgeWriter&mut section) -> bool {
    return wasm_simd_emit_binary_body(section, 214, true);
}

fn wasm_simd_emit_i64_reduce_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_simd_load(&mut body, 0, 0);
    wasm_simd_op(&mut body, 29);
    wasm_u8(&mut body, 0);
    wasm_simd_load(&mut body, 0, 0);
    wasm_simd_op(&mut body, 29);
    wasm_u8(&mut body, 1);
    wasm_u8(&mut body, 124);
    wasm_simd_load(&mut body, 0, 16);
    wasm_simd_op(&mut body, 29);
    wasm_u8(&mut body, 0);
    wasm_u8(&mut body, 124);
    wasm_simd_load(&mut body, 0, 16);
    wasm_simd_op(&mut body, 29);
    wasm_u8(&mut body, 1);
    wasm_u8(&mut body, 124);

    bool success = wasm_simd_finish_body(section, &mut body);

    writer_destroy(&mut body);
    return success;
}

fn wasm_simd_emit_f64_reduce_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 68);

    i64 zero = 0;

    wasm_float_emit_fixed_bits(&mut body, zero, 8);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_simd_load(&mut body, 0, 0);
    wasm_simd_op(&mut body, 33);
    wasm_u8(&mut body, 0);
    wasm_simd_load(&mut body, 0, 0);
    wasm_simd_op(&mut body, 33);
    wasm_u8(&mut body, 1);
    wasm_u8(&mut body, 160);
    // f64.add

    bool success = wasm_simd_finish_body(section, &mut body);

    writer_destroy(&mut body);
    return success;
}

