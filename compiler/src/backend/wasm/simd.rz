fn wasm_simd_emit_i32_reduce_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init(&mut body);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_simd_load(&mut body, 0, 0);
    wasm_simd_op(&mut body, 27);
    wasm_u8(&mut body, 0);

    i64 lane = 1;

    while (lane < 4) {
        wasm_simd_load(&mut body, 0, 0);
        wasm_simd_op(&mut body, 27);
        wasm_u8(&mut body, lane);
        wasm_u8(&mut body, 106);
        lane += 1;
    }

    bool success = wasm_simd_finish_body(section, &mut body);

    writer_destroy(&mut body);
    return success;
}

