fn wasm_simd_runtime_function_supported(Source& source, HirModule& hir, i64 function_index) -> bool {
    return (
        wasm_simd_i64_add(source, hir, function_index) ||
        wasm_simd_i64_sub(source, hir, function_index) ||
        wasm_simd_i64_mul(source, hir, function_index) ||
        wasm_simd_i64_min(source, hir, function_index) ||
        wasm_simd_i64_max(source, hir, function_index) ||
        wasm_simd_i64_equal(source, hir, function_index) ||
        wasm_simd_i64_reduce_add(source, hir, function_index) ||
        wasm_simd_f64_add(source, hir, function_index) ||
        wasm_simd_f64_sub(source, hir, function_index) ||
        wasm_simd_f64_mul(source, hir, function_index) ||
        wasm_simd_f64_div(source, hir, function_index) ||
        wasm_simd_f64_min(source, hir, function_index) ||
        wasm_simd_f64_max(source, hir, function_index) ||
        wasm_simd_f64_reduce_add(source, hir, function_index) ||
        wasm_simd_i32x4_add(source, hir, function_index) ||
        wasm_simd_i32x4_sub(source, hir, function_index) ||
        wasm_simd_i32x4_mul(source, hir, function_index) ||
        wasm_simd_i32x4_min(source, hir, function_index) ||
        wasm_simd_i32x4_max(source, hir, function_index) ||
        wasm_simd_i32x4_equal(source, hir, function_index) ||
        wasm_simd_i32x4_splat(source, hir, function_index) ||
        wasm_simd_i32x4_neg(source, hir, function_index) ||
        wasm_simd_i32x4_reduce_add(source, hir, function_index) ||
        wasm_simd_i32x4_all_true(source, hir, function_index) ||
        wasm_simd_i32x4_bitmask(source, hir, function_index) ||
        wasm_simd_f32x4_add(source, hir, function_index) ||
        wasm_simd_f32x4_sub(source, hir, function_index) ||
        wasm_simd_f32x4_mul(source, hir, function_index) ||
        wasm_simd_f32x4_div(source, hir, function_index) ||
        wasm_simd_f32x4_min(source, hir, function_index) ||
        wasm_simd_f32x4_max(source, hir, function_index) ||
        wasm_simd_f32x4_equal(source, hir, function_index) ||
        wasm_simd_f32x4_splat(source, hir, function_index) ||
        wasm_simd_f32x4_abs(source, hir, function_index) ||
        wasm_simd_f32x4_neg(source, hir, function_index) ||
        wasm_simd_f32x4_sqrt(source, hir, function_index) ||
        wasm_simd_f32x4_reduce_add(source, hir, function_index) ||
        wasm_simd_i32x4_less(source, hir, function_index) ||
        wasm_simd_i32x4_greater(source, hir, function_index) ||
        wasm_simd_i32x4_and(source, hir, function_index) ||
        wasm_simd_i32x4_or(source, hir, function_index) ||
        wasm_simd_i32x4_xor(source, hir, function_index) ||
        wasm_simd_i32x4_not(source, hir, function_index) ||
        wasm_simd_f32x4_less(source, hir, function_index) ||
        wasm_simd_f32x4_greater(source, hir, function_index) ||
        wasm_simd_f32x4_ceil(source, hir, function_index) ||
        wasm_simd_f32x4_floor(source, hir, function_index) ||
        wasm_simd_f32x4_trunc(source, hir, function_index) ||
        wasm_simd_f32x4_nearest(source, hir, function_index) ||
        wasm_simd_f32x4_from_i32x4(source, hir, function_index) ||
        wasm_simd_i32x4_from_f32x4_sat(source, hir, function_index) ||
        wasm_simd_i8x16_swizzle(source, hir, function_index) ||
        wasm_simd_i8x16_splat(source, hir, function_index) ||
        wasm_simd_i8x16_bitmask(source, hir, function_index) ||
        wasm_simd_i8x16_any_true(source, hir, function_index) ||
        wasm_simd_i8x16_add(source, hir, function_index) ||
