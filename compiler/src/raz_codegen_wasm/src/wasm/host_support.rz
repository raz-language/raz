namespace raz_codegen_wasm::host_support;

public import raz_codegen_wasm::cfg;

fn wasm_host_name_is_literal(Source& source, HirModule& hir, i64 function_index, string name) -> bool {
    i64 length = compiler_literal_length(name);

    if (raz_compiler_rt_arena_get(hir.function_name_lengths, function_index) != length) {
        return false;
    }

    i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
    i64 i = 0;

    while (i < length) {
        if (source_byte(source, offset + i) != compiler_literal_byte(name, i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn wasm_host_name_has_literal_prefix(
    Source& source,
    HirModule& hir,
    i64 function_index,
    string prefix
) -> bool {
    i64 prefix_length = compiler_literal_length(prefix);

    if (raz_compiler_rt_arena_get(hir.function_name_lengths, function_index) < prefix_length) {
        return false;
    }

    i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
    i64 i = 0;

    while (i < prefix_length) {
        if (source_byte(source, offset + i) != compiler_literal_byte(prefix, i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn wasm_host_name_is(Source& source, HirModule& hir, i64 function_index, i64[]name, i64 length) -> bool {
    if (raz_compiler_rt_arena_get(hir.function_name_lengths, function_index) != length) {
        return false;
    }

    i64 offset = raz_compiler_rt_arena_get(hir.function_name_offsets, function_index);
    i64 i = 0;

    while (i < length) {
        if (source_byte(source, offset + i) != name[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}
