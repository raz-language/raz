fn wasm_browser_logical_import(Source& source, HirModule& hir, i64 function_index) -> i64 {
    if (wasm_browser_dom_set_text(source, hir, function_index)) { return 24; }
    if (wasm_browser_dom_set_text_i64(source, hir, function_index)) { return 25; }
    if (wasm_browser_dom_toggle_class(source, hir, function_index)) { return 26; }
    if (wasm_browser_dom_set_text_ptr(source, hir, function_index)) { return 27; }
    if (wasm_browser_dom_set_text_i64_ptr(source, hir, function_index)) { return 28; }
    if (wasm_browser_dom_toggle_class_ptr(source, hir, function_index)) { return 29; }
    if (wasm_browser_event_value_length(source, hir, function_index)) { return 30; }
    if (wasm_browser_event_value_write(source, hir, function_index)) { return 31; }
    if (wasm_browser_event_key_length(source, hir, function_index)) { return 32; }
    if (wasm_browser_event_key_write(source, hir, function_index)) { return 33; }
    if (wasm_browser_event_checked(source, hir, function_index)) { return 34; }
    if (wasm_browser_event_prevent_default(source, hir, function_index)) { return 35; }
    if (wasm_browser_dom_set_attribute(source, hir, function_index)) { return 36; }
    if (wasm_browser_dom_remove_attribute(source, hir, function_index)) { return 37; }
    if (wasm_browser_dom_add_class(source, hir, function_index)) { return 38; }
    if (wasm_browser_dom_remove_class(source, hir, function_index)) { return 39; }
    if (wasm_browser_dom_focus(source, hir, function_index)) { return 40; }
    if (wasm_browser_storage_set(source, hir, function_index)) { return 41; }
    if (wasm_browser_storage_remove(source, hir, function_index)) { return 42; }
    if (wasm_browser_storage_clear(source, hir, function_index)) { return 43; }
    if (wasm_browser_storage_value_length(source, hir, function_index)) { return 44; }
    if (wasm_browser_storage_value_write(source, hir, function_index)) { return 45; }
    if (wasm_browser_location_href_length(source, hir, function_index)) { return 46; }
    if (wasm_browser_location_href_write(source, hir, function_index)) { return 47; }
    if (wasm_browser_location_assign(source, hir, function_index)) { return 48; }
    if (wasm_browser_location_replace(source, hir, function_index)) { return 49; }
    if (wasm_browser_location_reload(source, hir, function_index)) { return 50; }
    if (wasm_browser_history_push(source, hir, function_index)) { return 51; }
    if (wasm_browser_history_replace(source, hir, function_index)) { return 52; }
    if (wasm_browser_history_back(source, hir, function_index)) { return 53; }
    if (wasm_browser_history_forward(source, hir, function_index)) { return 54; }
    if (wasm_browser_clipboard_write(source, hir, function_index)) { return 55; }
    if (wasm_browser_event_code_length(source, hir, function_index)) { return 56; }
    if (wasm_browser_event_code_write(source, hir, function_index)) { return 57; }
    if (wasm_browser_event_repeat(source, hir, function_index)) { return 58; }
    if (wasm_browser_event_alt_key(source, hir, function_index)) { return 59; }
    if (wasm_browser_event_ctrl_key(source, hir, function_index)) { return 60; }
    if (wasm_browser_event_shift_key(source, hir, function_index)) { return 61; }
    if (wasm_browser_event_meta_key(source, hir, function_index)) { return 62; }
    if (wasm_browser_event_button(source, hir, function_index)) { return 63; }
    if (wasm_browser_event_client_x(source, hir, function_index)) { return 64; }
    if (wasm_browser_event_client_y(source, hir, function_index)) { return 65; }
    if (wasm_browser_event_stop_propagation(source, hir, function_index)) { return 66; }
    if (wasm_browser_dom_set_value(source, hir, function_index)) { return 67; }
    if (wasm_browser_dom_blur(source, hir, function_index)) { return 68; }
    if (wasm_browser_dom_click(source, hir, function_index)) { return 69; }
    if (wasm_browser_dom_exists(source, hir, function_index)) { return 70; }
    if (wasm_browser_timer_set_timeout(source, hir, function_index)) { return 71; }
    if (wasm_browser_timer_clear_timeout(source, hir, function_index)) { return 72; }
    return -1;
}

fn wasm_wasi_main_function(Source& source, HirModule& hir) -> i64 {
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (
            raz_compiler_rt_arena_get(hir.function_is_extern, function_index) == 0 &&
            raz_compiler_rt_arena_get(hir.function_parameter_counts, function_index) == 0 &&
            wasm_wasi_name_is_literal(source, hir, function_index, "main")
        ) {
            return function_index;
        }
        function_index += 1;
    }
    return -1;
}

fn wasm_wasi_start_count(Source& source, HirModule& hir) -> i64 {
    if (wasm_wasi_main_function(source, hir) >= 0) {
        return 1;
    }
    return 0;
}

