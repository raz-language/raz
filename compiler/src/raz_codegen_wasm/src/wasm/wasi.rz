fn wasm_wasi_dir_open(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_dir_open");
}

fn wasm_wasi_dir_next(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_dir_next");
}

fn wasm_wasi_dir_close(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_dir_close");
}

fn wasm_wasi_fs_metadata(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_fs_metadata");
}

fn wasm_wasi_create_dir_one(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_create_dir_one");
}

fn wasm_wasi_remove_one(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_remove_one");
}

fn wasm_wasi_rename_path(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_rename_path");
}

fn wasm_wasi_copy_file(Source& source, HirModule& hir, i64 function_index) -> bool {
    return wasm_wasi_name_is_literal(source, hir, function_index, "raz_rt_copy_file");
}

fn wasm_wasi_find_named_function_literal(Source& source, HirModule& hir, string name) -> i64 {
    i64 function_index = 0;
    while (function_index < hir.function_count) {
        if (wasm_wasi_name_is_literal(source, hir, function_index, name)) { return function_index; }
        function_index += 1;
    }
    return -1;
}

fn wasm_wasi_find_named_function(Source& source, HirModule& hir, i64[]name, i64 length) -> i64 {
    i64 function_index = 0;

    while (function_index < hir.function_count) {
        if (wasm_wasi_name_is(source, hir, function_index, name, length)) {
            return function_index;
        }
        function_index += 1;
    }
    return -1;
}

fn wasm_wasi_runtime_function_supported(Source& source, HirModule& hir, i64 function_index) -> bool {
    return (
        wasm_wasi_stdio_read(source, hir, function_index) ||
        wasm_wasi_stdio_write(source, hir, function_index) ||
        wasm_wasi_stdio_flush(source, hir, function_index) ||
        wasm_wasi_stdio_is_terminal(source, hir, function_index) ||
        wasm_wasi_stdio_set_binary(source, hir, function_index) ||
        wasm_wasi_process_argc(source, hir, function_index) ||
        wasm_wasi_process_arg(source, hir, function_index) ||
        wasm_wasi_process_id(source, hir, function_index) ||
        wasm_wasi_process_run(source, hir, function_index) ||
        wasm_wasi_process_run_argv(source, hir, function_index) ||
        wasm_wasi_env_get(source, hir, function_index) ||
        wasm_wasi_env_set(source, hir, function_index) ||
        wasm_wasi_env_remove(source, hir, function_index) ||
        wasm_wasi_last_error_code(source, hir, function_index) ||
        wasm_wasi_file_open(source, hir, function_index) ||
        wasm_wasi_file_read(source, hir, function_index) ||
        wasm_wasi_file_write(source, hir, function_index) ||
        wasm_wasi_file_close(source, hir, function_index) ||
        wasm_wasi_file_seek(source, hir, function_index) ||
        wasm_wasi_file_tell(source, hir, function_index) ||
        wasm_wasi_file_flush(source, hir, function_index) ||
        wasm_wasi_file_eof(source, hir, function_index) ||
        wasm_wasi_file_size(source, hir, function_index) ||
        wasm_wasi_path_exists(source, hir, function_index) ||
        wasm_wasi_path_is_file(source, hir, function_index) ||
        wasm_wasi_path_is_dir(source, hir, function_index) ||
        wasm_wasi_time_unix_millis(source, hir, function_index) ||
        wasm_wasi_time_monotonic_nanos(source, hir, function_index) ||
        wasm_wasi_random_fill(source, hir, function_index) ||
        wasm_wasi_random_seed(source, hir, function_index) ||
        wasm_wasi_sleep_millis(source, hir, function_index) ||
        wasm_wasi_current_dir(source, hir, function_index) ||
        wasm_wasi_dir_open(source, hir, function_index) ||
        wasm_wasi_dir_next(source, hir, function_index) ||
        wasm_wasi_dir_close(source, hir, function_index) ||
        wasm_wasi_fs_metadata(source, hir, function_index) ||
        wasm_wasi_create_dir_one(source, hir, function_index) ||
        wasm_wasi_remove_one(source, hir, function_index) ||
        wasm_wasi_rename_path(source, hir, function_index) ||
        wasm_wasi_copy_file(source, hir, function_index) ||
        (wasm_browser_mode() && (
            wasm_browser_dom_set_text(source, hir, function_index) ||
            wasm_browser_dom_set_text_i64(source, hir, function_index) ||
            wasm_browser_dom_toggle_class(source, hir, function_index) ||
            wasm_browser_dom_set_text_ptr(source, hir, function_index) ||
            wasm_browser_dom_set_text_i64_ptr(source, hir, function_index) ||
            wasm_browser_dom_toggle_class_ptr(source, hir, function_index) ||
            wasm_browser_event_value_length(source, hir, function_index) ||
            wasm_browser_event_value_write(source, hir, function_index) ||
            wasm_browser_event_key_length(source, hir, function_index) ||
            wasm_browser_event_key_write(source, hir, function_index) ||
            wasm_browser_event_checked(source, hir, function_index) ||
            wasm_browser_event_prevent_default(source, hir, function_index) ||
            wasm_browser_dom_set_attribute(source, hir, function_index) ||
            wasm_browser_dom_remove_attribute(source, hir, function_index) ||
            wasm_browser_dom_add_class(source, hir, function_index) ||
            wasm_browser_dom_remove_class(source, hir, function_index) ||
            wasm_browser_dom_focus(source, hir, function_index) ||
            wasm_browser_storage_set(source, hir, function_index) ||
            wasm_browser_storage_remove(source, hir, function_index) ||
            wasm_browser_storage_clear(source, hir, function_index) ||
            wasm_browser_storage_value_length(source, hir, function_index) ||
            wasm_browser_storage_value_write(source, hir, function_index) ||
            wasm_browser_location_href_length(source, hir, function_index) ||
            wasm_browser_location_href_write(source, hir, function_index) ||
            wasm_browser_location_assign(source, hir, function_index) ||
            wasm_browser_location_replace(source, hir, function_index) ||
            wasm_browser_location_reload(source, hir, function_index) ||
            wasm_browser_history_push(source, hir, function_index) ||
            wasm_browser_history_replace(source, hir, function_index) ||
            wasm_browser_history_back(source, hir, function_index) ||
            wasm_browser_history_forward(source, hir, function_index) ||
            wasm_browser_clipboard_write(source, hir, function_index) ||
            wasm_browser_event_code_length(source, hir, function_index) ||
            wasm_browser_event_code_write(source, hir, function_index) ||
            wasm_browser_event_repeat(source, hir, function_index) ||
            wasm_browser_event_alt_key(source, hir, function_index) ||
            wasm_browser_event_ctrl_key(source, hir, function_index) ||
            wasm_browser_event_shift_key(source, hir, function_index) ||
            wasm_browser_event_meta_key(source, hir, function_index) ||
            wasm_browser_event_button(source, hir, function_index) ||
            wasm_browser_event_client_x(source, hir, function_index) ||
            wasm_browser_event_client_y(source, hir, function_index) ||
            wasm_browser_event_stop_propagation(source, hir, function_index) ||
            wasm_browser_dom_set_value(source, hir, function_index) ||
            wasm_browser_dom_blur(source, hir, function_index) ||
            wasm_browser_dom_click(source, hir, function_index) ||
            wasm_browser_dom_exists(source, hir, function_index) ||
            wasm_browser_timer_set_timeout(source, hir, function_index) ||
            wasm_browser_timer_clear_timeout(source, hir, function_index)
        ))
    );
}

fn wasm_wasi_emit_import_literal(ForgeWriter&mut section, string module_name, string name, i64 type_index) {
    wasm_name_literal(section, module_name);
    wasm_name_literal(section, name);
    wasm_u8(section, 0);
    wasm_u32(section, type_index);
}

fn wasm_wasi_emit_import(
    ForgeWriter&mut section,
    i64[]module_name,
    i64 module_length,
    i64[]name,
    i64 name_length,
    i64 type_index,
) {
    wasm_name(section, module_name, module_length);
    wasm_name(section, name, name_length);
    wasm_u8(section, 0);
    wasm_u32(section, type_index);
}

fn wasm_wasi_emit_import_section(ForgeWriter&mut module, HirModule& hir) -> bool {
    ForgeWriter section;

    writer_init_capacity(&mut section, 65536);
    if (section.failed) {
        return false;
    }
    wasm_u32(&mut section, wasm_wasi_import_count());
    i64 base = hir.function_count + hir.function_type_count * 2;

    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_write", base);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_read", base);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "args_sizes_get", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "args_get", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "environ_sizes_get", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "environ_get", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "clock_time_get", base + 2);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "random_get", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "proc_exit", base + 3);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "path_open", base + 4);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_close", base + 5);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "path_filestat_get", base + 6);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_seek", base + 8);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_tell", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_sync", base + 5);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_filestat_get", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "poll_oneoff", base);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_prestat_get", base + 1);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_prestat_dir_name", base + 9);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "fd_readdir", base + 10);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "path_create_directory", base + 9);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "path_unlink_file", base + 9);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "path_remove_directory", base + 9);
    wasm_wasi_emit_import_literal(&mut section, "wasi_snapshot_preview1", "path_rename", base + 11);
    if (wasm_browser_mode()) {
        if (wasm_browser_import_enabled(24)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_set_text", base + 12); }
        if (wasm_browser_import_enabled(25)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_set_text_i64", base + 12); }
        if (wasm_browser_import_enabled(26)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_toggle_class", base + 12); }
        if (wasm_browser_import_enabled(27)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_set_text_ptr", base + 12); }
        if (wasm_browser_import_enabled(28)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_set_text_i64_ptr", base + 12); }
        if (wasm_browser_import_enabled(29)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_toggle_class_ptr", base + 12); }
        if (wasm_browser_import_enabled(30)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_value_length", base + 13); }
        if (wasm_browser_import_enabled(31)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_value_write", base + 12); }
        if (wasm_browser_import_enabled(32)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_key_length", base + 13); }
        if (wasm_browser_import_enabled(33)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_key_write", base + 12); }
        if (wasm_browser_import_enabled(34)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_checked", base + 13); }
        if (wasm_browser_import_enabled(35)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_prevent_default", base + 13); }
        if (wasm_browser_import_enabled(36)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_set_attribute", base + 15); }
        if (wasm_browser_import_enabled(37)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_remove_attribute", base + 12); }
        if (wasm_browser_import_enabled(38)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_add_class", base + 12); }
        if (wasm_browser_import_enabled(39)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_remove_class", base + 12); }
        if (wasm_browser_import_enabled(40)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_focus", base + 14); }
        if (wasm_browser_import_enabled(41)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "storage_set", base + 12); }
        if (wasm_browser_import_enabled(42)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "storage_remove", base + 14); }
        if (wasm_browser_import_enabled(43)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "storage_clear", base + 13); }
        if (wasm_browser_import_enabled(44)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "storage_value_length", base + 14); }
        if (wasm_browser_import_enabled(45)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "storage_value_write", base + 15); }
        if (wasm_browser_import_enabled(46)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "location_href_length", base + 13); }
        if (wasm_browser_import_enabled(47)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "location_href_write", base + 12); }
        if (wasm_browser_import_enabled(48)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "location_assign", base + 14); }
        if (wasm_browser_import_enabled(49)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "location_replace", base + 14); }
        if (wasm_browser_import_enabled(50)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "location_reload", base + 13); }
        if (wasm_browser_import_enabled(51)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "history_push", base + 14); }
        if (wasm_browser_import_enabled(52)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "history_replace", base + 14); }
        if (wasm_browser_import_enabled(53)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "history_back", base + 13); }
        if (wasm_browser_import_enabled(54)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "history_forward", base + 13); }
        if (wasm_browser_import_enabled(55)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "clipboard_write", base + 14); }
        if (wasm_browser_import_enabled(56)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_code_length", base + 13); }
        if (wasm_browser_import_enabled(57)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_code_write", base + 12); }
        if (wasm_browser_import_enabled(58)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_repeat", base + 13); }
        if (wasm_browser_import_enabled(59)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_alt_key", base + 13); }
        if (wasm_browser_import_enabled(60)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_ctrl_key", base + 13); }
        if (wasm_browser_import_enabled(61)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_shift_key", base + 13); }
        if (wasm_browser_import_enabled(62)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_meta_key", base + 13); }
        if (wasm_browser_import_enabled(63)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_button", base + 13); }
        if (wasm_browser_import_enabled(64)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_client_x", base + 13); }
        if (wasm_browser_import_enabled(65)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_client_y", base + 13); }
        if (wasm_browser_import_enabled(66)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "event_stop_propagation", base + 13); }
        if (wasm_browser_import_enabled(67)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_set_value", base + 12); }
        if (wasm_browser_import_enabled(68)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_blur", base + 14); }
        if (wasm_browser_import_enabled(69)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_click", base + 14); }
        if (wasm_browser_import_enabled(70)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "dom_exists", base + 14); }
        if (wasm_browser_import_enabled(71)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "timer_set_timeout", base + 12); }
        if (wasm_browser_import_enabled(72)) { wasm_wasi_emit_import_literal(&mut section, "raz_web", "timer_clear_timeout", base + 14); }
    }
    wasm_section(module, 2, &section);

    bool success = !section.failed && !module.failed;

    writer_destroy(&mut section);
    return success;
}

fn wasm_wasi_emit_i32_store(ForgeWriter&mut body, i64 address, i64 local_index) {
    wasm_u8(body, 65);
    wasm_i64(body, address);
    wasm_local_get(body, local_index);
    wasm_u8(body, 167);
    wasm_u8(body, 54);
    wasm_u32(body, 2);
    wasm_u32(body, 0);
}

fn wasm_wasi_emit_stdio_body(ForgeWriter&mut section, bool read) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    // Reserved linear-memory scratch:
    // 16..23 = wasi iovec, 24..27 = bytes read/written.
    wasm_wasi_emit_i32_store(&mut body, 16, 1);
    wasm_wasi_emit_i32_store(&mut body, 20, 2);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 16);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 24);
    wasm_u8(&mut body, 16);
    if (read) {
        wasm_u32(&mut body, 1);
    } else {
        wasm_u32(&mut body, 0);
    }
    wasm_wasi_capture_errno(&mut body);
    // errno != 0 -> return -1.
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 24);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_constant_i64_body(ForgeWriter&mut section, i64 value) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, value);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_last_error_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 35);
    wasm_u32(&mut body, wasm_wasi_last_error_global());
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_unsupported_i64_body(ForgeWriter&mut section, i64 value) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    // WASI preview1 has no environment mutation or child-process spawn API.
    // Preserve Raz's fallible boundary contracts and expose ENOTSUP through
    // std::io::last_error instead of silently succeeding.
    wasm_wasi_set_last_error(&mut body, 58);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, value);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_process_argc_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 36);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 2);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_clock_body(ForgeWriter&mut section, bool realtime) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    if (realtime) {
        wasm_i64(&mut body, 0);
    } else {
        wasm_i64(&mut body, 1);
    }
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 1);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 6);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
    if (realtime) {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, 1000000);
        wasm_u8(&mut body, 127);
    }
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_random_fill_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 7);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 69);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_random_seed_body(ForgeWriter&mut section) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 8);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 7);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    wasm_u8(&mut body, 66);
    wasm_i64(&mut body, 0);
    wasm_u8(&mut body, 5);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 32);
    wasm_u8(&mut body, 41);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 0);
