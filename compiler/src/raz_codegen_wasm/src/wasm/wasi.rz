    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 11);
    wasm_u8(&mut body, 55);
    wasm_u32(&mut body, 3);
    wasm_u32(&mut body, 8);
    wasm_local_get(&mut body, 7);
    wasm_u8(&mut body, 173);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_wasi_emit_dir_close_body(ForgeWriter&mut section, Source& source, HirModule& hir) -> bool {
    ForgeWriter body;

    writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 80);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 64);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 40);
    wasm_u32(&mut body, 2);
    wasm_u32(&mut body, 0);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 10);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 26);
    i64 dealloc_function = wasm_wasi_find_named_function_literal(source, hir, "raz_rt_dealloc");

    if (dealloc_function >= 0) {
        wasm_local_get(&mut body, 0);
        wasm_u8(&mut body, 16);
        wasm_u32(&mut body, wasm_wasi_defined_function(dealloc_function));
    }
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    writer_destroy(&mut body);
    return success;
}

fn wasm_browser_emit_import_wrapper(ForgeWriter&mut section, i64 host_import) -> bool {
    ForgeWriter body;
    writer_init_capacity(&mut body, 4096);
    if (body.failed) { return false; }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, host_import);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);
    bool success = !body.failed && !section.failed;
    writer_destroy(&mut body);
    return success;
}

