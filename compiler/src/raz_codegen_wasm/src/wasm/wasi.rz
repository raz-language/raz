fn wasm_wasi_emit_runtime_body(
    ForgeWriter&mut section,
    Source& source,
    HirModule& hir,
    i64 function_index,
) -> bool {
    if (wasm_browser_dom_set_text(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(24)); }
    if (wasm_browser_dom_set_text_i64(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(25)); }
    if (wasm_browser_dom_toggle_class(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(26)); }
    if (wasm_browser_dom_set_text_ptr(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(27)); }
    if (wasm_browser_dom_set_text_i64_ptr(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(28)); }
    if (wasm_browser_dom_toggle_class_ptr(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(29)); }
    if (wasm_browser_event_value_length(source, hir, function_index)) { return wasm_browser_emit_import_wrapper0(section, wasm_browser_import_index(30)); }
    if (wasm_browser_event_value_write(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(31)); }
    if (wasm_browser_event_key_length(source, hir, function_index)) { return wasm_browser_emit_import_wrapper0(section, wasm_browser_import_index(32)); }
    if (wasm_browser_event_key_write(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(33)); }
    if (wasm_browser_event_checked(source, hir, function_index)) { return wasm_browser_emit_import_wrapper0(section, wasm_browser_import_index(34)); }
    if (wasm_browser_event_prevent_default(source, hir, function_index)) { return wasm_browser_emit_import_wrapper0(section, wasm_browser_import_index(35)); }
    if (wasm_browser_dom_set_attribute(source, hir, function_index)) { return wasm_browser_emit_import_wrapper3(section, wasm_browser_import_index(36)); }
    if (wasm_browser_dom_remove_attribute(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(37)); }
    if (wasm_browser_dom_add_class(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(38)); }
    if (wasm_browser_dom_remove_class(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(39)); }
    if (wasm_browser_dom_focus(source, hir, function_index)) { return wasm_browser_emit_import_wrapper1(section, wasm_browser_import_index(40)); }
    if (wasm_browser_storage_set(source, hir, function_index)) { return wasm_browser_emit_import_wrapper(section, wasm_browser_import_index(41)); }
    if (wasm_browser_storage_remove(source, hir, function_index)) { return wasm_browser_emit_import_wrapper1(section, wasm_browser_import_index(42)); }
    if (wasm_browser_storage_clear(source, hir, function_index)) { return wasm_browser_emit_import_wrapper0(section, wasm_browser_import_index(43)); }
    if (wasm_browser_storage_value_length(source, hir, function_index)) { return wasm_browser_emit_import_wrapper1(section, wasm_browser_import_index(44)); }
    if (wasm_browser_storage_value_write(source, hir, function_index)) { return wasm_browser_emit_import_wrapper3(section, wasm_browser_import_index(45)); }
