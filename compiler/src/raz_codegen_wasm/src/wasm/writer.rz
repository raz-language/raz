namespace raz_codegen_wasm::writer;

public import llvm::codegen;

public global mut i64 wasm_browser_mode_enabled = 0;
public global mut i64 wasm_browser_import_mask = 0;
public global mut i64 wasm_browser_import_count_cached = 0;

fn wasm_browser_mode() -> bool { return wasm_browser_mode_enabled != 0; }

fn wasm_browser_import_enabled(i64 logical_import) -> bool {
    if (!wasm_browser_mode() || logical_import < 24 || logical_import > 72) { return false; }
    i64 bit = logical_import - 24;
    return (wasm_browser_import_mask & (1 << bit)) != 0;
}

fn wasm_browser_import_index(i64 logical_import) -> i64 {
    if (logical_import < 24) { return logical_import; }
    i64 index = 24;
    i64 current = 24;
    while (current < logical_import) {
        if (wasm_browser_import_enabled(current)) { index += 1; }
        current += 1;
    }
    return index;
}

fn wasm_host_import_count() -> i64 {
    if (wasm_browser_mode()) { return 24 + wasm_browser_import_count_cached; }
    return 24;
}

fn wasm_instruction_has_register(MirModule& mir, i64 instruction) -> bool {
    i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, instruction);

    // Return and CFG branch instructions are control-only MIR nodes. Every
    // other live opcode owns a scalar/handle result slot, including block
    // markers and stores whose result is part of the MIR contract.
    return opcode != 21 && opcode != 22 && opcode != 23;
}

fn wasm_register_ordinal(MirModule& mir, i64 function_index, i64 instruction) -> i64 {
    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 ordinal = 0;
    i64 ip = start;

    while (ip < instruction) {
        if (wasm_instruction_has_register(mir, ip)) {
            ordinal += 1;
        }
        ip += 1;
    }
    return ordinal;
}

fn wasm_function_register_count(MirModule& mir, i64 function_index) -> i64 {
    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 count = raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 registers = 0;
    i64 ip = start;

    while (ip < start + count) {
        if (wasm_instruction_has_register(mir, ip)) {
            registers += 1;
        }
        ip += 1;
    }
    return registers;
}

// Deterministic WebAssembly binary writer.  The backend emits the core wasm
// binary format directly; no LLVM, Clang, wabt, or host linker is involved.
fn wasm_u8(ForgeWriter&mut out, i64 value) {
    writer_put(out, value & 255);
}

fn wasm_u32(ForgeWriter&mut out, i64 value) {
    i64 remaining = value;

    while (remaining >= 128) {
        wasm_u8(out, (remaining & 127) | 128);
        remaining = remaining >> 7;
    }
    wasm_u8(out, remaining);
}

fn wasm_i64(ForgeWriter&mut out, i64 value) {
    i64 remaining = value;
    bool more = true;

    while (more) {
        i64 byte = remaining & 127;

        remaining = remaining >> 7;

        bool sign = (byte & 64) != 0;

        more = !((remaining == 0 && !sign) || (remaining == -1 && sign));
        if (more) {
            byte = byte | 128;
        }
        wasm_u8(out, byte);
    }
}

fn wasm_bytes(ForgeWriter&mut out, i64[]bytes, i64 length) {
    i64 i = 0;

    while (i < length) {
        wasm_u8(out, bytes[i]);
        i += 1;
    }
}

fn wasm_writer_copy(ForgeWriter&mut out, ForgeWriter& section) {
    i64 i = 0;

    while (i < section.length) {
        wasm_u8(out, raz_compiler_rt_arena_get(section.data, i));
        i += 1;
    }
}

fn wasm_section(ForgeWriter&mut out, i64 id, ForgeWriter& section) {
    wasm_u8(out, id);
    wasm_u32(out, section.length);
    wasm_writer_copy(out, section);
}

fn wasm_name_literal(ForgeWriter&mut out, string name) {
    i64 length = compiler_literal_length(name);
    wasm_u32(out, length);
    i64 i = 0;
    while (i < length) {
        wasm_u8(out, compiler_literal_byte(name, i));
        i += 1;
    }
}

public fn wasm_name(ForgeWriter&mut out, i64[]name, i64 length) {
    wasm_u32(out, length);
    wasm_bytes(out, name, length);
}

fn wasm_source_name(ForgeWriter&mut out, Source& source, i64 offset, i64 length) {
    wasm_u32(out, length);

    i64 i = 0;

    while (i < length) {
        wasm_u8(out, source_byte(source, offset + i));
        i += 1;
    }
}

fn wasm_local_get(ForgeWriter&mut out, i64 index) {
    wasm_u8(out, 32);
    wasm_u32(out, index);
}

fn wasm_local_set(ForgeWriter&mut out, i64 index) {
    wasm_u8(out, 33);
    wasm_u32(out, index);
}
