namespace raz_codegen_wasm::writer;

public import common::writer;

public global mut i64 wasm_browser_mode_enabled = 0;
public global mut i64 wasm_browser_import_mask = 0;
public global mut i64 wasm_browser_import_mask_high = 0;
public global mut i64 wasm_browser_import_count_cached = 0;

// Browser modules use a compact physical function layout. These maps retain the
// stable HIR/MIR indices used by the rest of the compiler while allowing the
// emitted Wasm module to contain only browser-reachable definitions. Arena map
// entries store ordinal + 1 so zero remains the untracked/unreachable sentinel.
public global mut i64 wasm_browser_reachable_functions = 0;
public global mut i64 wasm_browser_function_map = 0;
public global mut i64 wasm_browser_closure_map = 0;
public global mut i64 wasm_browser_async_map = 0;
public global mut i64 wasm_browser_original_function_count = 0;
public global mut i64 wasm_browser_original_closure_count = 0;
public global mut i64 wasm_browser_original_async_count = 0;
public global mut i64 wasm_browser_function_count_cached = 0;
public global mut i64 wasm_browser_closure_count_cached = 0;
public global mut i64 wasm_browser_async_count_cached = 0;

fn wasm_browser_mode() -> bool {
    return wasm_browser_mode_enabled != 0;
}

fn wasm_browser_layout_ready() -> bool {
    return wasm_browser_mode() && wasm_browser_reachable_functions != 0 && wasm_browser_function_map != 0;
}

fn wasm_browser_function_reachable(i64 function_index) -> bool {
    if (!wasm_browser_layout_ready()) {
        return !wasm_browser_mode();
    }
    if (function_index < 0 || function_index >= wasm_browser_original_function_count) {
        return false;
    }
    return raz_compiler_rt_arena_get(wasm_browser_reachable_functions, function_index) != 0;
}

fn wasm_browser_function_ordinal(i64 function_index) -> i64 {
    if (!wasm_browser_mode()) {
        return function_index;
    }
    if (wasm_browser_function_map == 0 || function_index < 0 || function_index >= wasm_browser_original_function_count) {
        return -1;
    }
    i64 encoded = raz_compiler_rt_arena_get(wasm_browser_function_map, function_index);
    if (encoded == 0) {
        return -1;
    }
    return encoded - 1;
}

fn wasm_browser_emitted_function_count(i64 normal_count) -> i64 {
    if (wasm_browser_mode()) {
        return wasm_browser_function_count_cached;
    }
    return normal_count;
}

fn wasm_browser_emitted_defined_count(i64 normal_count) -> i64 {
    if (wasm_browser_mode()) {
        return wasm_browser_function_count_cached + wasm_browser_closure_count_cached + wasm_browser_async_count_cached;
    }
    return normal_count;
}

fn wasm_browser_closure_ordinal(i64 old_ordinal) -> i64 {
    if (!wasm_browser_mode()) {
        return old_ordinal;
    }
    if (wasm_browser_closure_map == 0 || old_ordinal < 0 || old_ordinal >= wasm_browser_original_closure_count) {
        return -1;
    }
    i64 encoded = raz_compiler_rt_arena_get(wasm_browser_closure_map, old_ordinal);
    if (encoded == 0) {
        return -1;
    }
    return encoded - 1;
}

fn wasm_browser_async_ordinal(i64 old_ordinal) -> i64 {
    if (!wasm_browser_mode()) {
        return old_ordinal;
    }
    if (wasm_browser_async_map == 0 || old_ordinal < 0 || old_ordinal >= wasm_browser_original_async_count) {
        return -1;
    }
    i64 encoded = raz_compiler_rt_arena_get(wasm_browser_async_map, old_ordinal);
    if (encoded == 0) {
        return -1;
    }
    return encoded - 1;
}

fn wasm_browser_defined_ordinal(i64 old_defined_index) -> i64 {
    if (!wasm_browser_mode()) {
        return old_defined_index;
    }
    if (old_defined_index < wasm_browser_original_function_count) {
        return wasm_browser_function_ordinal(old_defined_index);
    }

    i64 closure_base = wasm_browser_original_function_count;
    i64 async_base = closure_base + wasm_browser_original_closure_count;

    if (old_defined_index < async_base) {
        i64 closure = wasm_browser_closure_ordinal(old_defined_index - closure_base);
        if (closure < 0) {
            return -1;
        }
        return wasm_browser_function_count_cached + closure;
    }
    i64 async_ordinal = wasm_browser_async_ordinal(old_defined_index - async_base);
    if (async_ordinal < 0) {
        return -1;
    }
    return wasm_browser_function_count_cached + wasm_browser_closure_count_cached + async_ordinal;
}

fn wasm_browser_release_layout() {
    if (wasm_browser_reachable_functions != 0) {
        raz_compiler_rt_arena_destroy(wasm_browser_reachable_functions);
    }
    if (wasm_browser_function_map != 0) {
        raz_compiler_rt_arena_destroy(wasm_browser_function_map);
    }
    if (wasm_browser_closure_map != 0) {
        raz_compiler_rt_arena_destroy(wasm_browser_closure_map);
    }
    if (wasm_browser_async_map != 0) {
        raz_compiler_rt_arena_destroy(wasm_browser_async_map);
    }
    wasm_browser_reachable_functions = 0;
    wasm_browser_function_map = 0;
    wasm_browser_closure_map = 0;
    wasm_browser_async_map = 0;
    wasm_browser_original_function_count = 0;
    wasm_browser_original_closure_count = 0;
    wasm_browser_original_async_count = 0;
    wasm_browser_function_count_cached = 0;
    wasm_browser_closure_count_cached = 0;
    wasm_browser_async_count_cached = 0;
}

fn wasm_browser_import_enabled(i64 logical_import) -> bool {
    if (!wasm_browser_mode() || logical_import < 24 || logical_import > 100) {
        return false;
    }

    i64 bit = logical_import - 24;

    if (bit < 48) {
        return (wasm_browser_import_mask & (1 << bit)) != 0;
    }
    bit -= 48;
    return (wasm_browser_import_mask_high & (1 << bit)) != 0;
}

fn wasm_browser_enable_import(i64 logical_import) -> bool {
    if (logical_import < 24 || logical_import > 100) {
        return false;
    }

    i64 bit = logical_import - 24;

    if (bit < 48) {
        i64 flag = 1 << bit;

        if ((wasm_browser_import_mask & flag) != 0) {
            return false;
        }
        wasm_browser_import_mask = wasm_browser_import_mask | flag;
        return true;
    }
    bit -= 48;

    i64 flag = 1 << bit;

    if ((wasm_browser_import_mask_high & flag) != 0) {
        return false;
    }
    wasm_browser_import_mask_high = wasm_browser_import_mask_high | flag;
    return true;
}

fn wasm_browser_import_index(i64 logical_import) -> i64 {
    if (logical_import < 24) {
        return logical_import;
    }
    // Browser modules do not carry the 24-command WASI prefix. Logical import
    // ids remain stable for the compiler ABI, while physical function indices
    // are packed from zero using only the reachable Raz Web imports.

    i64 index = 0;
    i64 current = 24;

    while (current < logical_import) {
        if (wasm_browser_import_enabled(current)) {
            index += 1;
        }
        current += 1;
    }
    return index;
}

fn wasm_host_import_count() -> i64 {
    if (wasm_browser_mode()) {
        return wasm_browser_import_count_cached;
    }
    return 24;
}

fn wasm_defined_function_index(i64 old_defined_index) -> i64 {
    i64 ordinal = old_defined_index;
    if (wasm_browser_mode()) {
        ordinal = wasm_browser_defined_ordinal(old_defined_index);
    }
    return wasm_host_import_count() + ordinal;
}

fn wasm_defined_table_index(i64 old_defined_index) -> i64 {
    if (wasm_browser_mode()) {
        return wasm_browser_defined_ordinal(old_defined_index);
    }
    return old_defined_index;
}

fn wasm_instruction_has_register(MirModule& mir, i64 instruction) -> bool {
    i64 opcode = raz_compiler_rt_arena_get(mir.opcodes, instruction);

    // Return and CFG branch instructions are control-only MIR nodes. Every
    // other live opcode owns a scalar/handle result slot, including block
    // markers and stores whose result is part of the MIR contract.
    return opcode != 21 && opcode != 22 && opcode != 23;
}

fn wasm_register_ordinal(MirModule& mir, i64 function_index, i64 instruction) -> i64 {
    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 ordinal = 0;
    i64 ip = start;

    while (ip < instruction) {
        if (wasm_instruction_has_register(mir, ip)) {
            ordinal += 1;
        }
        ip += 1;
    }
    return ordinal;
}

fn wasm_function_register_count(MirModule& mir, i64 function_index) -> i64 {
    i64 start = raz_compiler_rt_arena_get(mir.function_instruction_starts, function_index);
    i64 count = raz_compiler_rt_arena_get(mir.function_instruction_counts, function_index);
    i64 registers = 0;
    i64 ip = start;

    while (ip < start + count) {
        if (wasm_instruction_has_register(mir, ip)) {
            registers += 1;
        }
        ip += 1;
    }
    return registers;
}

// Deterministic WebAssembly binary writer.  The backend emits the core wasm
// binary format directly; no LLVM, Clang, wabt, or host linker is involved.
fn wasm_u8(CodegenWriter&mut out, i64 value) {
    codegen_writer_put(out, value & 255);
}

fn wasm_u32(CodegenWriter&mut out, i64 value) {
    i64 remaining = value;

    while (remaining >= 128) {
        wasm_u8(out, (remaining & 127) | 128);
        remaining = remaining >> 7;
    }
    wasm_u8(out, remaining);
}

fn wasm_i64(CodegenWriter&mut out, i64 value) {
    i64 remaining = value;
    bool more = true;

    while (more) {
        i64 byte = remaining & 127;

        remaining = remaining >> 7;

        bool sign = (byte & 64) != 0;

        more = !((remaining == 0 && !sign) || (remaining == -1 && sign));
        if (more) {
            byte = byte | 128;
        }
        wasm_u8(out, byte);
    }
}

fn wasm_bytes(CodegenWriter&mut out, i64[]bytes, i64 length) {
    i64 i = 0;

    while (i < length) {
        wasm_u8(out, bytes[i]);
        i += 1;
    }
}

fn wasm_writer_copy(CodegenWriter&mut out, CodegenWriter& section) {
    // Sections and function bodies are already byte-normalized. Reserve the
    // complete range before copying so a large code section cannot reallocate
    // the destination halfway through a nested writer-to-writer transfer.
    codegen_writer_append(out, section);
}

fn wasm_section(CodegenWriter&mut out, i64 id, CodegenWriter& section) {
    // Reserve the whole section plus the id/LEB length prefix before writing
    // anything. Large browser code sections therefore cross capacity only at a
    // stable section boundary, never while another writer is being copied.
    if (!codegen_writer_reserve(out, section.length + 16)) { return; }
    wasm_u8(out, id);
    wasm_u32(out, section.length);
    wasm_writer_copy(out, section);
}

fn wasm_name_literal(CodegenWriter&mut out, string name) {
    i64 length = compiler_literal_length(name);

    wasm_u32(out, length);

    i64 i = 0;

    while (i < length) {
        wasm_u8(out, compiler_literal_byte(name, i));
        i += 1;
    }
}

public fn wasm_name(CodegenWriter&mut out, i64[]name, i64 length) {
    wasm_u32(out, length);
    wasm_bytes(out, name, length);
}

fn wasm_source_name(CodegenWriter&mut out, Source& source, i64 offset, i64 length) {
    wasm_u32(out, length);

    i64 i = 0;

    while (i < length) {
        wasm_u8(out, source_byte(source, offset + i));
        i += 1;
    }
}

fn wasm_local_get(CodegenWriter&mut out, i64 index) {
    wasm_u8(out, 32);
    wasm_u32(out, index);
}

fn wasm_local_set(CodegenWriter&mut out, i64 index) {
    wasm_u8(out, 33);
    wasm_u32(out, index);
}
