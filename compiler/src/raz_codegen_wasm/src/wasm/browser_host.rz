    }
    return -1;
}

fn wasm_browser_runtime_function_supported(Source& source, HirModule& hir, i64 function_index) -> bool {
    if (!wasm_browser_mode()) {
        return false;
    }
    return wasm_browser_logical_import(source, hir, function_index) >= 24;
}

fn wasm_browser_emit_import_literal(CodegenWriter&mut section, string name, i64 type_index) {
