fn wasm_browser_emit_import_wrapper(CodegenWriter&mut section, i64 host_import) -> bool {
    CodegenWriter body;

    codegen_writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, host_import);
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    codegen_writer_destroy(&mut body);
    return success;
}

