namespace raz_codegen_wasm::wasi_support;

public import raz_codegen_wasm::cfg;
public import raz_codegen_wasm::writer;

fn wasm_wasi_last_error_global() -> i64 {
    // Internal wasm global 1 is reserved by globals.rz for WASI errno.
    return 1;
}

fn wasm_wasi_capture_errno(CodegenWriter&mut body) {
    // Preserve the host errno and leave it on the operand stack so existing
    // success/failure tests keep their original shape.
    wasm_u8(body, 36);
    wasm_u32(body, wasm_wasi_last_error_global());
    wasm_u8(body, 35);
    wasm_u32(body, wasm_wasi_last_error_global());
}

fn wasm_wasi_set_last_error(CodegenWriter&mut body, i64 code) {
    wasm_u8(body, 65);
    wasm_i64(body, code);
    wasm_u8(body, 36);
    wasm_u32(body, wasm_wasi_last_error_global());
}

fn wasm_wasi_emit_i32_load(CodegenWriter&mut body, i64 address) {
    wasm_u8(body, 65);
    wasm_i64(body, address);
    wasm_u8(body, 40);
    wasm_u32(body, 2);
    wasm_u32(body, 0);
}

