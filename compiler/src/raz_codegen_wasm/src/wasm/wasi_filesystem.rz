fn wasm_wasi_emit_path_filestat_body(CodegenWriter&mut section, i64 mode) -> bool {
    CodegenWriter body;

    codegen_writer_init_capacity(&mut body, 4096);
    if (body.failed) {
        return false;
    }
    wasm_u32(&mut body, 1);
    wasm_u32(&mut body, 1);
    wasm_u8(&mut body, 127);
    wasm_wasi_emit_resolve_preopen(&mut body, 0, 1, 2, false);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, -1);
    wasm_u8(&mut body, 70);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    if (mode == 0) {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, -1);
    } else {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, 0);
    }
    wasm_u8(&mut body, 15);
    wasm_u8(&mut body, 11);
    wasm_local_get(&mut body, 2);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 0);
    wasm_local_get(&mut body, 0);
    wasm_u8(&mut body, 167);
    wasm_local_get(&mut body, 1);
    wasm_u8(&mut body, 167);
    wasm_u8(&mut body, 65);
    wasm_i64(&mut body, 64);
    wasm_u8(&mut body, 16);
    wasm_u32(&mut body, 11);
    wasm_wasi_capture_errno(&mut body);
    wasm_u8(&mut body, 4);
    wasm_u8(&mut body, 126);
    if (mode == 0) {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, -1);
    } else {
        wasm_u8(&mut body, 66);
        wasm_i64(&mut body, 0);
    }
    wasm_u8(&mut body, 5);
    if (mode == 0) {
        // __wasi_filestat_t.filesize is the u64 at byte offset 32.
        wasm_u8(&mut body, 65);
        wasm_i64(&mut body, 96);
        wasm_u8(&mut body, 41);
        wasm_u32(&mut body, 3);
        wasm_u32(&mut body, 0);
    } else {
        // __wasi_filestat_t.filetype is the byte at offset 16: directory=3, regular_file=4.
        wasm_u8(&mut body, 65);
        wasm_i64(&mut body, 80);
        wasm_u8(&mut body, 45);
        wasm_u32(&mut body, 0);
        wasm_u32(&mut body, 0);
        wasm_u8(&mut body, 65);
        if (mode == 1) {
            wasm_i64(&mut body, 4);
        } else {
            wasm_i64(&mut body, 3);
        }
        wasm_u8(&mut body, 70);
        wasm_u8(&mut body, 173);
    }
    wasm_u8(&mut body, 11);
    wasm_u8(&mut body, 11);
    wasm_u32(section, body.length);
    wasm_writer_copy(section, &body);

    bool success = !body.failed && !section.failed;

    codegen_writer_destroy(&mut body);
    return success;
}

