fn rxe_disassemble_module(RxeModule& module, CodegenWriter&mut out) -> bool {
    codegen_writer_put(out, 114);
    codegen_writer_put(out, 120);
    codegen_writer_put(out, 101);
    codegen_writer_space(out);
    // rxe
    codegen_writer_put(out, 102);
    codegen_writer_put(out, 112);
    codegen_writer_put(out, 61);
    codegen_writer_decimal(out, module.module_fingerprint_hi);
    codegen_writer_put(out, 58);
    codegen_writer_decimal(out, module.module_fingerprint_lo);
    codegen_writer_space(out);
    codegen_writer_put(out, 102);
    codegen_writer_put(out, 101);
    codegen_writer_put(out, 97);
    codegen_writer_put(out, 116);
    codegen_writer_put(out, 117);
    codegen_writer_put(out, 114);
    codegen_writer_put(out, 101);
    codegen_writer_put(out, 115);
    codegen_writer_put(out, 61);
    codegen_writer_decimal(out, module.feature_flags);
    codegen_writer_space(out);
    codegen_writer_put(out, 101);
    codegen_writer_put(out, 120);
    codegen_writer_put(out, 112);
    codegen_writer_put(out, 111);
    codegen_writer_put(out, 114);
    codegen_writer_put(out, 116);
    codegen_writer_put(out, 115);
    codegen_writer_put(out, 61);
    codegen_writer_decimal(out, module.export_count);
    codegen_writer_newline(out);

    i64 function_index = 0;

    while (function_index < module.function_count) {
        codegen_writer_put(out, 102);
        codegen_writer_put(out, 110);
        codegen_writer_put(out, 32);
        // "fn "
        codegen_writer_decimal(out, function_index);
        codegen_writer_put(out, 32);
        codegen_writer_put(out, 104);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 104);
        codegen_writer_put(out, 61);
        codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.function_name_hashes, function_index));
        codegen_writer_put(out, 32);
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 101);
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 61);
        codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.function_selector_hi, function_index));
        codegen_writer_put(out, 58);
        codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.function_selector_lo, function_index));
        codegen_writer_put(out, 32);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 98);
        codegen_writer_put(out, 105);
        codegen_writer_put(out, 61);
        codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.function_abi_kinds, function_index));
        codegen_writer_put(out, 32);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 103);
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 61);
        codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.function_argument_counts, function_index));
        codegen_writer_put(out, 32);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 101);
        codegen_writer_put(out, 103);
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 61);
        codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.function_register_counts, function_index));
        codegen_writer_put(out, 32);
        codegen_writer_put(out, 102);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 109);
        codegen_writer_put(out, 101);
        codegen_writer_put(out, 61);
        codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.function_frame_slots, function_index));
        codegen_writer_put(out, 58);
        codegen_writer_newline(out);

        i64 ip = raz_compiler_rt_arena_get(module.function_code_starts, function_index);
        i64 end = ip + raz_compiler_rt_arena_get(module.function_code_counts, function_index);

        while (ip < end) {
            codegen_writer_space(out);
            codegen_writer_space(out);
            codegen_writer_decimal(out, ip);
            codegen_writer_space(out);

            i64 opcode = raz_compiler_rt_arena_get(module.opcodes, ip);

            rxe_disasm_opcode_name(out, opcode);
            codegen_writer_space(out);
            codegen_writer_put(out, 114);
            codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.dst, ip));
            codegen_writer_put(out, 44);
            codegen_writer_space(out);
            codegen_writer_put(out, 114);
            codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.src0, ip));
            codegen_writer_put(out, 44);
            codegen_writer_space(out);
            codegen_writer_put(out, 114);
            codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.src1, ip));
            codegen_writer_put(out, 44);
            codegen_writer_space(out);
            codegen_writer_decimal(out, raz_compiler_rt_arena_get(module.immediates, ip));
            codegen_writer_newline(out);
            ip += 1;
        }
        function_index += 1;
    }
    return !out.failed;
}

fn rxe_write_disassembly(RxeModule& module, i64 output_path, i64 output_path_length) -> bool {
    CodegenWriter out;

    codegen_writer_init(&mut out);

    bool ok = rxe_disassemble_module(module, &mut out);

    if (ok) {
        i64 written = raz_compiler_rt_write_ascii(output_path, output_path_length, out.data, out.length);

        ok = written == out.length;
    }
    codegen_writer_destroy(&mut out);
    return ok;
}
