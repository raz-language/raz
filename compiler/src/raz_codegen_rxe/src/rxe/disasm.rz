namespace raz_codegen_rxe::disasm;

public import raz_codegen_rxe::verify;

// Stable named RXE assembly dump used by backend tests and VM bring-up. Mnemonics
// are tooling text only; numeric opcode values remain the canonical binary ISA.
fn rxe_disasm_opcode_name(CodegenWriter&mut out, i64 opcode) {
    if (opcode == rxe_op_nop()) {
        codegen_writer_put(out, 110);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 112);
    } else if (opcode == rxe_op_movi()) {
        codegen_writer_put(out, 109);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 118);
        codegen_writer_put(out, 105);
    } else if (opcode == rxe_op_ldc64()) {
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 100);
        codegen_writer_put(out, 99);
        codegen_writer_put(out, 54);
        codegen_writer_put(out, 52);
    } else if (opcode == rxe_op_mov()) {
        codegen_writer_put(out, 109);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 118);
    } else if (opcode == rxe_op_load_arg()) {
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 100);
        codegen_writer_put(out, 46);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 103);
    } else if (opcode == rxe_op_load_slot()) {
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 100);
        codegen_writer_put(out, 46);
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 116);
    } else if (opcode == rxe_op_store_slot()) {
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 116);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 114);
        codegen_writer_put(out, 101);
        codegen_writer_put(out, 46);
        codegen_writer_put(out, 115);
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 116);
    } else if (opcode == rxe_op_load_local()) {
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 100);
        codegen_writer_put(out, 46);
        codegen_writer_put(out, 108);
        codegen_writer_put(out, 111);
        codegen_writer_put(out, 99);
        codegen_writer_put(out, 97);
        codegen_writer_put(out, 108);
    } else if (opcode == rxe_op_store_local()) {
