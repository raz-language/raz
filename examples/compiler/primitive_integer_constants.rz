fn checked_digit_threshold(i64 digit, i64 radix) -> i64 {
    if (radix <= 0) {
        return -1;
    }
    return (i64::MAX - digit) / radix;
}

fn main() -> i64 {
    if (i8::MAX != 127) {
        return 1;
    }
    if (i8::MIN != -128) {
        return 2;
    }
    if (u8::MAX != 255) {
        return 3;
    }
    if (u8::MIN != 0) {
        return 4;
    }
    if (i16::MAX != 32767) {
        return 5;
    }
    if (i32::MAX != 2147483647) {
        return 6;
    }
    if (i64::MAX != 9223372036854775807) {
        return 7;
    }
    if (checked_digit_threshold(7, 10) != 922337203685477580) {
        return 8;
    }
    return 0;
}
