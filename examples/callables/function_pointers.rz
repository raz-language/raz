fn add(i64 left, i64 right) -> i64 {
    return left + right;
}

fn apply(fn(i64, i64) -> i64 operation, i64 left, i64 right) -> i64 {
    return operation(left, right);
}

fn main() -> i64 {
    fn(i64, i64) -> i64 operation = add;
    return apply(operation, 20, 22);
}
