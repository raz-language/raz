trait Provider {
    type Item;

    fn get(Self& self) -> Item;
    fn doubled(Self& self) -> i64 {
        return self.get() * 2;
    }
}

struct Box<T> {
    T value;
}

impl<T: Copy> Provider for Box<T> {
    type Item = T;

    fn get(Box<T>& self) -> T {
        return self.value;
    }
}

fn main() -> i64 {
    Box<i64> value;

    value.value = 21;
    return value.get() + value.doubled() - 63;
}
