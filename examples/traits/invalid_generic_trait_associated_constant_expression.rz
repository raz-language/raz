trait Capacity {
    const WIDTH: usize;
}

struct Buffer<T, const usize N> {
    T values[N];
}

impl<T: Copy, const usize N> Capacity for Buffer<T, N> {
    const WIDTH: usize = M + N;
}

fn main() -> i64 {
    Buffer<i64, 4> buffer;

    return 0;
}
