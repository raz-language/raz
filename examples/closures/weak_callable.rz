fn invoke(Fn(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn main() -> i64 {
    i64 amount = 40;

    auto strong = fn(i64 value) -> i64 {
        return amount + value;
    };

    auto observer = weak(strong);
    auto duplicate = clone(observer);
    auto restored = upgrade(duplicate);
    bool live = !expired(observer);

    if (live) {
        return invoke(restored, 2);
    }
    return 0;
}
