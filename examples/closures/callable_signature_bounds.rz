fn invoke_once(FnOnce(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn invoke_mut(FnMut(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn invoke_shared(Fn(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn main() -> i64 {
    i64 factor = 2;

    i64 first = invoke_shared(fn(i64 value) -> i64 {
        return value * factor;
    }, 10);
    i64 second = invoke_mut(mut fn(i64 value) -> i64 {
        *factor += 1;
        return value * *factor;
    }, 5);
    i64 third = invoke_once(move fn(i64 value) -> i64 {
        return value + factor;
    }, 2);
    return first + second + third;
}
