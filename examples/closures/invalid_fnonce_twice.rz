struct Resource {
    i64 handle;
}

fn invalid() -> i64 {
    Resource resource = Resource {
        handle: 7
    };
    auto consume = move fn() -> i64 {
        return resource.handle;
    };

    i64 first = consume();

    return first + consume();
}
