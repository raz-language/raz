const usize BASE = 2;
const usize WIDTH = BASE * 4;

struct Buffer<T, const usize N> {
    T values[N * 2];
}

fn first<const usize N>(i64[N * 2]values) -> i64 {
    return values[0];
}

fn main() -> i64 {
    Buffer<i64, BASE + 2> buffer;
    i64 values[8] = [1, 2, 3, 4, 5, 6, 7, 8];

    buffer.values[0] = first<2 + 2>(values);
    return buffer.values[0];
}
