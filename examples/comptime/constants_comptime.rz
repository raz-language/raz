const i64 BASE = 40 + 2;
const i64 MASK = (1 << 4) - 1;
comptime {
    assert(BASE == 42);
    assert(MASK == 15);
    const i64 CHECK = BASE + MASK;
    assert(CHECK == 57);
}

fn answer() -> i64 {
    const i64 LOCAL = BASE + 1;
    return LOCAL;
}
