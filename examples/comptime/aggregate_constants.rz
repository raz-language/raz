const fn choose(bool second) -> i64 {
    if (second) {
        return[10, 20, 30, 40][2];
    }
    return[10, 20, 30, 40][0];
}

const i64 SELECTED = choose(true);
comptime {
    const i64[3]left = [1, 2, 3];
    const i64[3]right = [1, 2, 3];
    const(i64, bool, string)metadata = (left[1], left == right, "ready");
    assert(metadata.0 == 2);
    assert(metadata.1);
    assert(metadata.2 == "ready");
    assert(SELECTED == 30);
}

fn result() -> i64 {
    return SELECTED;
}
