struct Point {
    i64 x;
    i64 y;
}

enum Message {
    Empty,
    Number(i64),
    Pair(Point, bool),
}

const Point ORIGIN = Point {
    x: 3,
    y: 4
};
const i64[3]VALUES = [10, 20, 30];
const(i64, bool)META = (7, true);
const Message NUMBER = Message::Number(41);
const Message PAIR = Message::Pair(Point {
    x: 8,
    y: 9
}, true);

fn point_sum() -> i64 {
    Point point = ORIGIN;

    return point.x + point.y;
}

fn array_sum() -> i64 {
    i64[3]values = VALUES;
    return values[0] + values[1] + values[2];
}

fn tuple_first() -> i64 {
    (i64, bool)meta = META;
    return meta.0;
}

fn number_payload() -> i64 {
    Message value = NUMBER;

    match value {
        Message::Number(number) => {
            return number;
        },
        _ => {
            return 0;
        },
    }
}

fn pair_payload() -> i64 {
    Message value = PAIR;

    match value {
        Message::Pair(point, enabled) => {
            if (enabled) {
                return point.x + point.y;
            }
            return 0;
        },
        _ => {
            return 0;
        },
    }
}
