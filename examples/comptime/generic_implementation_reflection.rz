trait Provider {
    type Item;

    const WIDTH: usize;
}

struct Box<T> {
    T value;
}

impl<T: Copy> Provider for Box<T> {
    type Item = T;

    const WIDTH: usize = 16;
}

comptime {
    assert(implements_trait<Box<i64>, Provider>());
    assert(impl_associated_type_count<Box<i64>, Provider>() == 1);
    assert(impl_associated_type_name<Box<i64>, Provider>(0) == "Item");
    assert(impl_associated_type_binding_name<Box<i64>, Provider>(0) == "i64");
    assert(impl_associated_const_count<Box<i64>, Provider>() == 1);
    assert(impl_associated_const_name<Box<i64>, Provider>(0) == "WIDTH");
    assert(impl_associated_const_type_name<Box<i64>, Provider>(0) == "usize");
    assert(impl_associated_const_value<Box<i64>, Provider>(0) == 16);
}

fn main() -> i64 {
    return 0;
}
