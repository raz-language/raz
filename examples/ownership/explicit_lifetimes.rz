fn choose<'a>(bool first, i64&'a left, i64& 'a right) -> i64&'a {
    if (first) {
        return left;
    }
    return right;
}

fn relay<'a>(i64&'a value) -> i64& 'a {
    return choose(true, value, value);
}

fn main() -> i64 {
    i64 value = 42;
    i64& result = relay(&value);

    return *result;
}
