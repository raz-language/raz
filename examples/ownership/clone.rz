struct Resource {
    i64 handle;
}

impl Clone for Resource {
    fn clone(Resource& self) -> Resource {
        return Resource {
            handle: 99
        };
    }
}

fn duplicate() -> i64 {
    Resource first = Resource {
        handle: 7
    };

    Resource second = clone(first);

    return first.handle + second.handle;
}
