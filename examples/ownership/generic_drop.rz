struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

struct Box<T> {
    T value;
}

impl<T: Drop> Drop for Box<T> {
    fn drop(Box<T>&mut self) {
        self;
    }
}

fn main() -> i64 {
    Box<Resource> boxed;

    boxed.value.handle = 7;
    return 0;
}
