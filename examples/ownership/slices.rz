fn sum(i64[]values) -> i64 {
    i64 total = 0;
    i64 index = 0;

    while (index < values.length) {
        total += values[index];
        index += 1;
    }
    return total;
}

fn increment_first(i64[]mut values) {
    values[0] += 10;
}

fn main() -> i64 {
    i64 values[4] = [1, 2, 3, 4];

    i64[]view = &values;

    i64 total = sum(view);

    i64[]mut edit = &mut values;
    increment_first(edit);
    return total + values[0];
}
