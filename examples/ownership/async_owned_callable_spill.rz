fn make_adder(i64 amount) -> FnOnce(i64) -> i64 {
    return move fn(i64 value) -> i64 {
        return value + amount;
    };
}

async fn child() -> i64 {
    return 2;
}

async fn pipeline(i64 amount) -> i64 {
    auto adder = make_adder(amount);
    i64 task = spawn child();
    i64 ready = await task;

    return adder(ready);
}

fn main() -> i64 {
    return 0;
}
