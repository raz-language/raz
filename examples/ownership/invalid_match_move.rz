enum Choice {
    First,
    Second,
}

struct Box {
    i64 value;
}

fn invalid(Choice choice) -> i64 {
    Box value = Box {
        value: 1
    };
    match choice {
        Choice::First => {
            Box consumed = move value;
        },
        Choice::Second => {},
    }
    return value.value;
}
