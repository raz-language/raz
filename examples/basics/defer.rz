fn cleanup(i64 input) -> i64 {
    i64 value = input;

    defer value += 1;
    {
        defer value *= 2;
        value += 3;
    }
    return value;
}

fn loop_cleanup(i64 count) -> i64 {
    i64 value = 0;

    while (value < count) {
        defer value += 10;
        value += 1;
        break;
    }
    return value;
}
