trait Iterator {
    type Item;

    fn next(Self&mut self) -> bool;
    fn current(Self& self) -> Item;
}

trait IntoIterator {
    type Item;
    type IntoIter;

    fn into_iter(Self&mut self) -> IntoIter;
}

struct Counter {
    i64 current_value;
    i64 end;
}

impl Iterator for Counter {
    type Item = i64;

    fn next(Counter&mut self) -> bool {
        if (self.current_value < self.end) {
            self.current_value += 1;
            return true;
        }
        return false;
    }
    fn current(Counter& self) -> i64 {
        return self.current_value - 1;
    }
}

struct Numbers {
    i64 end;
}

impl IntoIterator for Numbers {
    type Item = i64;
    type IntoIter = Counter;

    fn into_iter(Numbers&mut self) -> Counter {
        return Counter {
            current_value: 0,
            end: self.end
        };
    }
}

fn count_items<T: IntoIterator>(T&mut values) -> i64 {
    i64 count = 0;

    for value in*values {
        value;
        count += 1;
    }
    return count;
}

fn projected_identity<T: IntoIterator>(T::IntoIterator::Item value) -> T::IntoIterator::Item {
    return value;
}

fn main() -> i64 {
    Numbers numbers = Numbers {
        end: 4
    };

    i64 count = count_items<Numbers>(&mut numbers);

    return projected_identity<Numbers>(count);
}
