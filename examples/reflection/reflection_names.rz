@repr(C)struct Header {
    u8 kind;
    u32 length;
}

enum Message {
    Empty,
    Number(i64),
    Pair(i64, bool),
}

comptime {
    assert(field_name<Header>(0) == "kind");
    assert(field_type_name<Header>(1) == "u32");
    assert(attribute_name<Header>(0) == "repr(C)");
    assert(variant_name<Message>(1) == "Number");
    assert(variant_payload_count<Message>(2) == 2);
    assert(variant_payload_type_name<Message>(2, 1) == "bool");
}

fn main() {}
