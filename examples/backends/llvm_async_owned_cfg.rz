struct Resource {
    i64 handle;
}

impl Drop for Resource {
    fn drop(Resource&mut self) {
        self;
    }
}

struct Bundle {
    Resource first;
    Resource second;
}

async fn next(i64 value) -> i64 {
    return value + 1;
}

async fn owned_branch(i64 input) -> i64 {
    Bundle bundle = Bundle {
        first: Resource {
            handle: 20
        },
        second: Resource {
            handle: 22
        }
    };

    i64 value = input;

    while (value < 3) {
        i64 task = spawn next(value);
        i64 ready = await task;

        if (ready > value) {
            value = ready;
        } else {
            value += 1;
        }
    }
    return bundle.first.handle + bundle.second.handle + value;
}

fn main() -> i64 {
    i64 future = owned_branch(0);

    return 0;
}
