fn choose(bool left, i64 a, i64 b) -> i64 {
    i64 value = 5;
    if (left) {
        value = value + a;
    } else {
        value = value + b;
    }
    return value * 2;
}

fn main() -> i64 {
    return choose(true, 7, 9);
}
