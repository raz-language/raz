fn apply(fn(i64) -> i64 operation, i64 value) -> i64 {
    return operation(value);
}

fn main() -> i64 {
    i64 values[4] = [10, 20, 30, 40];

    fn(i64) -> i64 increment = fn(i64 value) -> i64 {
        return value + 1;
    };

    i64 total = 0;

    for value in & values {
        total += apply(increment, *value);
    }
    return total;
}
